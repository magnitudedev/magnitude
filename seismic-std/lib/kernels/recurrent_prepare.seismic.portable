# Recurrent input preparation for one row. Per channel: convolve the window of the C - 1
# previous inputs and the new one, apply silu, and shift the window. Per head: queries
# (heads 0..NK) and keys (NK..2NK) are L2-normalized with epsilon, queries with gain
# 1/sqrt(W); values pass through. Per value head: beta = sigmoid(beta_in) and
# decay = exp(rate * softplus(alpha + dt_bias)).
fn recurrent_prepare[NK, NV, W, C](projected: tensor[1, (2 * NK + NV) * W] bf16, conv: tensor[(2 * NK + NV) * W, C] bf16,
                                   window: tensor[C - 1, (2 * NK + NV) * W] bf16,
                                   alpha: tensor[1, NV] bf16, beta_in: tensor[1, NV] bf16,
                                   rate: tensor[NV] f32, dt_bias: tensor[NV] f32, eps: f32,
                                   qkv: tensor[2 * NK + NV, W] bf16, beta: tensor[NV] bf16, decay: tensor[NV] f32):
  for h in parallel:
    x = load(projected[0, h * W : (h + 1) * W])
    win = load(window[0 : C - 1, h * W : (h + 1) * W])
    wt = load(conv[h * W : (h + 1) * W, 0 : C])
    y = tile[W] f32
    for i in owned(y):
      s = f32(wt[i, C - 1]) * f32(x[i])
      for j in range(C - 1):
        s = fma(f32(wt[i, j]), f32(win[j, i]), s)
      y[i] = s / (1.0 + exp(-s))
    nw = tile[C - 1, W] f32
    for j, i in owned(nw):
      if j < C - 2:
        nw[j, i] = f32(win[j + 1, i])
      else:
        nw[j, i] = f32(x[i])
    store(nw, window[0 : C - 1, h * W : (h + 1) * W])
    inv = 1.0
    if h < 2 * NK:
      sq = tile[W] f32
      for i in owned(sq): sq[i] = y[i] * y[i]
      ss = reduce(sq, 0, sum)
      inv = rsqrt(ss + eps)
      if h < NK:
        inv = inv * rsqrt(f32(W))
    z = tile[W] f32
    for i in owned(z): z[i] = y[i] * inv
    store(z, qkv[h])
  for hv in parallel:
    b = tile[1] f32
    d = tile[1] f32
    for i in owned(b):
      b[i] = 1.0 / (1.0 + exp(-f32(beta_in[0, hv])))
    for i in owned(d):
      sh = f32(alpha[0, hv]) + dt_bias[hv]
      d[i] = exp(rate[hv] * (max(sh, 0.0) + log(1.0 + exp(-abs(sh)))))
    store(b, beta[hv : hv + 1])
    store(d, decay[hv : hv + 1])
