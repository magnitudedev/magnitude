<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Magnitude</vendor>
  <vendor_url>https://magnitude.dev</vendor_url>
  <action id="dev.magnitude.update">
    <description>Install a Magnitude update</description>
    <message>Authentication is required to install a Magnitude update</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/magnitude-desktop/resources/magnitude</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">_install-application-update</annotate>
  </action>
</policyconfig>
