# Inert until `magnitude server setup` creates the magnitude user and enables this unit.
[Unit]
Description=Magnitude server
Documentation=https://docs.magnitude.dev/remote-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=magnitude
Group=magnitude
# Started through a bin_t program so SELinux (Fedora) runs it as unconfined_service_t; the CLI
# itself is labeled lib_t, and the init_t domain it would otherwise keep cannot reach its engine.
ExecStart=/usr/bin/env /usr/lib/magnitude-desktop/resources/magnitude serve
Restart=always
RestartSec=3
KillMode=control-group
UMask=0007

[Install]
WantedBy=multi-user.target
