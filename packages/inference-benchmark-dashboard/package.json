{
  "name": "@magnitudedev/inference-benchmark-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dashboard": "concurrently --kill-others-on-fail \"bunx vite\" \"bun run src/server.ts\"",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "@magnitudedev/inference-benchmark": "workspace:*",
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.4",
    "@types/bun": "latest",
    "concurrently": "^9.1.2",
    "svelte": "^5.28.2",
    "svelte-check": "^4.2.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
