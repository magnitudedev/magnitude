{%- for msg in messages %}
  {%- set raw_reason = "" %}
  {%- set txt = render_content(msg.content, false) | trim %}
  {%- if (msg.role == 'user' and reasoning_tag in txt) %}
  {%- set after_tag = txt.split(reasoning_tag) %}
  {%- set candidate = after_tag[1].split(reasoning_tag_del)[0] %}
  {%- set candidate_key = candidate[1:] if candidate.startswith(reasoning_tag_instruct) else candidate %}
  {%- if candidate and candidate_key in reason_mods %}
    {%- set raw_reason = candidate %}
    {%- set tag = reasoning_tag ~ raw_reason ~ reasoning_tag_del %}
    {%- set clean_txt = txt.replace(tag, "") | trim %}
    {%- set store.messages = store.messages + [{"role": msg.role, "content": clean_txt}] %}
    {%- else %}
    {%- set store.messages = store.messages + [msg] %}
    {%- endif %}
  {%- else %}
    {%- set store.messages = store.messages + [msg] %}
  {%- endif %}
  {%- if raw_reason %}
    {%- if raw_reason.startswith(reasoning_tag_instruct) %}
      {%- set store.reasoning_effort = raw_reason[1:] %}
      {%- set store.enable_thinking = false %}
    {%- else %}
      {%- set store.reasoning_effort = raw_reason %}
      {%- set store.enable_thinking = true %}
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- set messages = store.messages %}
{%- if store.reasoning_effort %}
  {%- set reasoning_effort = store.reasoning_effort %}
  {%- set enable_thinking = store.enable_thinking %}
{%- endif %}
{#---- REASONING ACTIVATION: Setting, additional patch(es) for final ---- #}
{%- if enable_thinking is undefined or enable_thinking is true %}
    {%- set resolved_reasoning_effort = reasoning_effort|default(default_effort) %}
    {%- if resolved_reasoning_effort not in reason_mods %}
        {{- raise_exception('Unexpected reasoning effort ' ~ reasoning_effort ~ '. Supported types are ' ~ allowed_levels | join(', ') ~ '.') }}
    {%- endif %}
    {%- set ns = namespace(reasoning_instructions='') %}
    {%- for effort, instruction in instruction_map.items() %}
        {%- if resolved_reasoning_effort == effort %}
            {%- set ns.reasoning_instructions = instruction %}
        {%- endif %}
    {%- endfor %}
    {%- set reasoning_instructions = ns.reasoning_instructions %}
{%- endif %}
{%- if enable_thinking is false %}
    {%- set resolved_reasoning_effort = reasoning_effort|default(default_effort_instruct) %}
    {%- if resolved_reasoning_effort not in reason_mods %}
        {{- raise_exception('Unexpected reasoning effort ' ~ reasoning_effort ~ '. Supported types are ' ~ allowed_levels | join(', ') ~ '.') }}
    {%- endif %}
    {%- set ns = namespace(reasoning_instructions='') %}
    {%- for effort, instruction in instruction_map.items() %}
        {%- if resolved_reasoning_effort == effort %}
            {%- set ns.reasoning_instructions = instruction %}
        {%- endif %}
    {%- endfor %}
    {%- set reasoning_instructions = ns.reasoning_instructions %}
{%- endif %}
{#---- ----------------------------------------------------------------------------- ---- #}
{#---- END MAIN PATCHS // SYSTEMS ---- #}
{#---- ----------------------------------------------------------------------------- ---- #}

{%- set ns = namespace(system_prompt="", last_user_index=-1) -%}
{%- if messages and messages[0]["role"] == "system" -%}
    {%- if messages[0].get("content") -%}
        {%- set ns.system_prompt = parse_content(messages[0]["content"]) -%}
    {%- endif -%}
    {%- set messages = messages[1:] -%}
{%- endif -%}
{%- set ns.system_prompt = (reasoning_instructions + '\n\n' if reasoning_instructions else '') + ns.system_prompt -%}
{%- if tools -%}
    {%- set ns.system_prompt = ns.system_prompt + ("\n\n" if ns.system_prompt else "") + "Today's date: " + strftime_now("%Y-%m-%d") + "\n\nList of tools: " + (tools | tojson) -%}
{%- endif -%}
{%- if ns.system_prompt -%}
    {{- "<|im_start|>system\n" + ns.system_prompt + "<|im_end|>\n" -}}
{%- endif -%}
{%- for message in messages -%}
    {%- if message["role"] == "user" -%}
        {%- set ns.last_user_index = loop.index0 -%}
    {%- endif -%}
{%- endfor -%}
{%- for message in messages -%}
    {{- "<|im_start|>" + message.role + "\n" -}}
    {%- if message.role == "assistant" -%}
        {%- generation -%}
        {%- if message.thinking is defined and (preserve_thinking or loop.index0 > ns.last_user_index) -%}
            {{- "<think>" + message.thinking + "</think>" -}}
        {%- endif -%}
        {%- set _cfm_tag = "CONTINUE_FINAL_MESSAGE_TAG " -%}
        {%- set _has_cfm = false -%}
        {%- if message.content is defined -%}
            {%- set content = parse_content(message.content) -%}
            {%- if not (preserve_thinking or loop.index0 > ns.last_user_index) -%}
                {%- if "</think>" in content -%}
                    {%- set content = content.split("</think>")[-1] | trim -%}
                {%- endif -%}
            {%- endif -%}
            {%- if message.tool_calls is defined and content.endswith(_cfm_tag) -%}
                {%- set _has_cfm = true -%}
                {%- set _trunc_len = (content | length) - (_cfm_tag | length) -%}
                {{- content[:_trunc_len] -}}
            {%- else -%}
                {{- content -}}
            {%- endif -%}
        {%- endif -%}
        {%- if message.tool_calls is defined -%}
            {{- render_tool_calls(message.tool_calls) -}}
        {%- endif -%}
        {%- if _has_cfm -%}
            {{- _cfm_tag -}}
        {%- endif -%}
        {{- "<|im_end|>\n" -}}
        {%- endgeneration -%}
    {%- else %}
        {%- if message.get("content") -%}
            {{- parse_content(message["content"]) -}}
        {%- endif -%}
        {{- "<|im_end|>\n" -}}
    {%- endif %}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<|im_start|>assistant\n' -}}
    {{- '<think>\n' -}}
{%- endif -%}