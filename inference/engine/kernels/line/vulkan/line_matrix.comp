// line_matrix: 16x16x16 f16 cooperative-matrix multiply-adds into f32 (a
// device that has them, `SEISMIC_HAS_MATRIX`), the product of the
// projection GEMMs' fragments: S multiply-adds an invocation (a product is
// 4096 / SEISMIC_SUBGROUP_LANES an invocation), in UNROLL independent
// accumulators seeded apart, the operands each subgroup's first `x` in f16;
// it writes `x` back (line.seismic). A subgroup runs whole or not at all.
#include "../../kernels/vulkan/lib/core/matrix.glsl"

void line_matrix() {
#if SEISMIC_HAS_MATRIX
    const uint UNROLL = SEISMIC_TUNE_UNROLL;
    const uint PRODUCTS = SEISMIC_STATIC_S / (4096u / SEISMIC_SUBGROUP_LANES);
    const uint64_t lane = uint64_t(gl_WorkGroupID.x) * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    const uint64_t first = lane - gl_SubgroupInvocationID;
    if (first >= SEISMIC_DIM_N)
        return;
    seismic_f32 xs = seismic_f32(SEISMIC_PTR(SEISMIC_BUFFER_X));
    const float16_t value = float16_t(xs[uint(first * SEISMIC_X_STRIDE_0)].v);
    const MATRIX_FRAGMENT_A a = MATRIX_FRAGMENT_A(value);
    const MATRIX_FRAGMENT_B b = MATRIX_FRAGMENT_B(value);
    MATRIX_FRAGMENT_C d[UNROLL];
    [[unroll]] for (uint k = 0u; k < UNROLL; ++k)
        d[k] = MATRIX_FRAGMENT_C(float(k));
    for (uint step = 0u; step < PRODUCTS / UNROLL; ++step) {
        [[unroll]] for (uint k = 0u; k < UNROLL; ++k)
            d[k] = coopMatMulAdd(a, b, d[k]);
    }
    float total = 0.0;
    [[unroll]] for (uint k = 0u; k < UNROLL; ++k)
        total += d[k][0];
    if (lane < SEISMIC_DIM_N)
        seismic_f32(SEISMIC_PTR(SEISMIC_BUFFER_OUT))[uint(lane * SEISMIC_OUT_STRIDE_0)].v =
            xs[uint(lane * SEISMIC_X_STRIDE_0)].v + (floatBitsToUint(total) == 0xFFFFFFFFu ? 1.0 : 0.0);
#endif
}
