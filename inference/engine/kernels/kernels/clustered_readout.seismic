        threadgroups (M, 1, 1)
        threads_per_threadgroup (64, 1, 1)
        shared_bytes (1536)
native select_compact_rows for cpu from "cpu/select_compact_rows.rs":
    launch select_compact_rows:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
