# Packed target feed-forward stages. The portable bodies are the semantic
# oracles. Both entries operate on the `out_rows` rows of the residual: a
# block that advances every row binds the identity, the final block binds
# the rows with feature or logit demand.
#
# Native Metal: `dense_expand` and `dense_output` take the `dense` projection
# (`dense.seismic`), which owns and documents their forms (GEMV row
# classes, the batched and matrix GEMVs, the GEMM tiles, TALL, INT8 and PACK);
# the other entries here restate the same forms until they move onto it. An
# entry keeps its prologue: `dense_expand` the RMS norm of its `out_rows`,
# in-threadgroup in the GEMV and a pre-pass into `normalized` from
# BATCH_FROM rows (in the tall GEMM's fragment order where TALL runs);
# `dense_output` the NVFP4 operands of its product rows (`staged`), where its
# weight takes them.
# Native CUDA: the K1 projection library's row bands (`dense.seismic`) over
# the O `out_rows` rows. `dense_up` and `dense_output` share one KSPLIT
# between their two GEMV launches, so every row of the band has its O = 1
# bits. Their 1..8-row GEMV states its grid and takes RESIDENCY (tuned; no
# arithmetic): up to how many of its blocks over streaming weights share an
# SM (`projection::GemvResidency`), one where a block per SM draws the
# device's memory rate, two where it does not; a records weight's GEMV
# (`form(W, GEMV_RECORDS)`) takes its blocks per SM from its grid instead,
# and `where` holds its RESIDENCY at 1. `dense_up` and `dense_output` are
# programmatic launches: a GEMV warp issues its first weight loads before it
# waits for the previous launch, so a shared expert's down projection
# streams under its expansion's last blocks (Nemotron 3.5 Bolt decode on
# GB10: 33.6 -> 25.0 us).
# `activation` is the gate's function code (`functions.seismic`: 0 SiLU,
# 1 GELU-tanh); the product is the `glu` of gate and up, clamped at the
# limit whose F32 bits are LB (0 for none, which no limit takes): `glu_limit`
# holds no values, and its extent LB is static on every GPU backend, which
# compiles the clamp in only where LB > 0; the CPU reads LB at run time.

fn dense_expand[M, O, H, F, GS, US, GB, UB, LB](residual: &tensor[M, H] f32, norm: &tensor[H] NW,
    gate_weight: &tensor[F, H] GW, up_weight: &tensor[F, H] UW,
    out_rows: &tensor[O] i32, eps: f32, activation: i32,
    gate_scale: &tensor[GS] f32, up_scale: &tensor[US] f32, gate_bound: &tensor[GB] f32,
    up_bound: &tensor[UB] f32, glu_limit: &host tensor[0, LB] i32) -> tensor[O, F] A where LB >= 0 and GS >= 0 and US >= 0 and GS <= 1 and US <= 1 and GB >= 0 and UB >= 0 and (GB == 0 or H % GB == 0) and (UB == 0 or H % UB == 0) and operands(GW) == operands(UW):
    let mut selected = tensor[O, H] f32
    parallel for row in 0..O:
        parallel for col in 0..H:
            selected[row, col] = residual[out_rows[row], col]
    let mut normalized = tensor[O, H] A
    let mut gate_sum = tensor[O, F] f32
    let mut up_sum = tensor[O, F] f32
    let mut gate = tensor[O, F] A
    let mut up = tensor[O, F] A
    let mut product = tensor[O, F] A
    rms_norm(selected, norm, normalized, eps)
    linear(normalized, gate_weight, gate_sum)
    linear(normalized, up_weight, up_sum)
    scale_rows(gate_sum, gate_scale, gate)
    scale_rows(up_sum, up_scale, up)
    let mut limit = f32(inf)
    if LB > 0:
        limit = bitcast_f32(u32(LB))
    glu(gate, up, product, activation, limit)
    return product

native dense_expand for metal from "metal/dense_expand.metal":
    static (H, F, GS, US, GB, UB, LB)
    where GS <= 1 and US <= 1
    scratch normalized bytes ((O + TALL * (ceil_div(O, 64) * 64 - O)) * H * 2) when O >= BATCH_FROM
    project dense paired (gate_weight, up_weight)
    launch dense_expand_normalize before gemv when O >= BATCH_FROM and (O <= 64 or TALL == 0 or INT8 == 1 or PACK == 1):
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_expand_normalize_tall before tall when O > 64 and TALL == 1 and INT8 == 0 and PACK == 0:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the K1 projection library (`vulkan/common/projection.glsl`). Output
# rows O <= 8 run the GEMV (SIMDGROUPS x ROWS lane groups of LANES lanes per
# workgroup, each owning weight rows; LANES sets the reduction order, so it is
# arithmetic), applying the norm prologue in-workgroup, as one launch per
# activation-row bound (`gemv1`, `gemv2`, `gemv4` for 3-4 rows, `gemv8` for
# 5-8): one bound per pipeline, since the driver's pipeline creation is
# superlinear in the unrolled body (every Vulkan GEMV entry splits so); larger
# classes a stage launch that writes the normalized rows to scratch, then the
# paired gate/up GEMM over TILE_M x TILE_N tiles (cooperative-matrix f16
# multiplies under SEISMIC_HAS_MATRIX, F32 FMAs otherwise).
native dense_expand for vulkan from "vulkan/dense_expand.comp":
    static (H, F, GS, US, LB)
    params (SIMDGROUPS in [16, 8, 4, 2, 32] default 16, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32] default 16,
            TILE_M in [128, 64, 32] default 64, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    let GEMV_GROUPS = ceil_div(F, SIMDGROUPS * ROWS * 32 / LANES)
    let GEMV_THREADS = SIMDGROUPS * 32
    let GEMV_SHARED = 256 + 32 * operands(GW) + min(8 * ceil_div(H, 32), 288) * 72
    where SUB_M <= TILE_M and SUB_N <= TILE_N and GS <= 1 and US <= 1
    scratch normalized bytes (O * H * 2) when O > 8
    launch dense_expand_stage when O > 8:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch dense_expand_gemv1 when O <= 1:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_expand_gemv2 when O == 2:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_expand_gemv4 when O >= 3 and O <= 4:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_expand_gemv8 when O >= 5 and O <= 8:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_expand_gemm when O > 8:
        threadgroups (ceil_div(F, TILE_N / 2), ceil_div(O, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

native dense_expand for cuda from "cuda/dense_expand.cu":
    static (H, F, GS, US, LB)
    params (arithmetic INT8 in [0, 1] default 0, arithmetic OPERAND in [0, 1] default 0)
    where H % 64 == 0 and GS <= 1 and US <= 1 and (OPERAND == 0 or INT8 == 0) and (INT8 == 0 or (form(GW, INT8) == 1 and form(UW, INT8) == 1))
    scratch staged bytes (O * H * 2) when O > 1
    scratch groups bytes (O * H / 4) when INT8 == 1 and O > 16
    launch dense_expand_stage when O > 1:
        reads (INT8, OPERAND)
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_expand_gemv when O <= 8:
        params (arithmetic KSPLIT in [4, 2, 8] default 4)
        threadgroups (ceil_div(ceil_div(F, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, O - 1)) * H * 2)
    launch dense_expand_gemv16 when O > 8 and O <= 16:
        params (arithmetic KSPLIT in [4, 2, 8] default 4)
        threadgroups (ceil_div(ceil_div(F, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_expand_gemm_small when O > 16 and O <= 64:
        reads (INT8, OPERAND)
        threadgroups (ceil_div(ceil_div(F, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 2 * 10240) + 2 * 2048)
    launch dense_expand_gemm when O > 64:
        params (ROTATE in [2, 1, 4] default 2)
        reads (INT8, OPERAND)
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(O, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 2 * 10240) + 2 * 2048)

# CPU: the CPU projection library (`cpu/lib/projection/projection.rs`). A
# stage launch writes each normalized (expand) or product (output) row as F32
# to scratch; the row launch gives each work item ROWS weight rows, projected
# against every staged row through the weight representation's dot component.
native dense_expand for cpu from "cpu/dense_expand.rs":
    static (GS, US)
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where GS <= 1 and US <= 1 and (INT8 == 0 or form(GW, INT8) == 1 or form(UW, INT8) == 1)
    scratch quantized bytes (ceil_div(O, Q8_ROWS) * Q8_ROWS * ceil_div(H, Q8_VALUES) * Q8_BYTES)
    scratch normalized bytes (O * H * 4)
    launch dense_expand_normalize:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch dense_expand_rows:
        threadgroups (ceil_div(F, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)


fn dense_output[M, O, H, F, DS, DB](residual: &tensor[M, H] f32,
    product: &tensor[O, F] A, down_weight: &tensor[H, F] DW,
    out_rows: &tensor[O] i32, down_scale: &tensor[DS] f32,
    down_bound: &tensor[DB] f32) -> tensor[O, H] f32 where DS >= 0 and DS <= 1 and DB >= 0 and (DB == 0 or F % DB == 0):
    let mut down_sum = tensor[O, H] f32
    let mut projected = tensor[O, H] A
    let mut result = tensor[O, H] f32
    linear(product, down_weight, down_sum)
    scale_rows(down_sum, down_scale, projected)
    parallel for row in 0..O:
        parallel for col in 0..H:
            result[row, col] = residual[out_rows[row], col] + f32(projected[row, col])
    return result

native dense_output for metal from "metal/dense_output.metal":
    static (H, F, DS, DB)
    where DS <= 1
    project dense single (down_weight)
    scratch staged bytes (O * F * 2) when O >= BATCH_FROM and operands(DW) == 1
    launch dense_output_stage before batch when O >= BATCH_FROM and operands(DW) == 1:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the K1 projection (see `dense_expand`): GEMV to 8 rows, GEMM
# beyond with SPLIT-way split-K summed in order by `finalize`. Over NVFP4
# down weights the stage launch forms the product rows' operands into
# `staged`, which the GEMM reads.
native dense_output for vulkan from "vulkan/dense_output.comp":
    static (H, F, DS)
    params (SIMDGROUPS in [16, 8, 4, 2, 32] default 16, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32] default 16,
            TILE_M in [128, 64, 32] default 64, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32,
            arithmetic SPLIT in [1, 2, 4] default 1)
    let GEMV_GROUPS = ceil_div(H, SIMDGROUPS * ROWS * 32 / LANES)
    let GEMV_THREADS = SIMDGROUPS * 32
    let GEMV_SHARED = 256 + 32 * operands(DW) + min(8 * ceil_div(F, 32), 288) * 72
    where SUB_M <= TILE_M and SUB_N <= TILE_N and DS <= 1
    scratch partials bytes (SPLIT * O * H * 4) when O > 8 and SPLIT > 1
    scratch staged bytes (O * F * 2) when O > 8 and operands(DW) == 1
    launch dense_output_stage when O > 8 and operands(DW) == 1:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch dense_output_gemv1 when O <= 1:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_output_gemv2 when O == 2:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_output_gemv4 when O >= 3 and O <= 4:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_output_gemv8 when O >= 5 and O <= 8:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch dense_output_gemm when O > 8:
        threadgroups (ceil_div(H, TILE_N), ceil_div(O, TILE_M), SPLIT)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch dense_output_finalize when O > 8 and SPLIT > 1:
        threadgroups (ceil_div(O * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

