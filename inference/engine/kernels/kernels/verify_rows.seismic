# The rows of the widest draft verification step (the anchor and the most
# drafts; the executor's `MAX_DRAFT_PROPOSALS` is this minus one), and so the
# row count every decode form serves. The routed and progressive decode forms,
# the decode attention, and the executor's decode classes all read it.
const VERIFY_ROWS = 16

# The widest row count served by the Metal, Vulkan, and ordered-projection GEMV
# classes (`M <= 8`). Beyond `PROJECTION_GEMV_MAX_M`, Metal routes 9..=16 rows
# through its batched matrix-unit launch (`batch`) and Vulkan/ordered-projection
# route through GEMM, keeping `M = 1..=8` bit-identical with zero register-array
# growth.
const PROJECTION_GEMV_MAX_M = 8
