# Recurrent (gated delta net) block execution: a normed projection, and the
# state advance publishing the gated output rows. The output projection is a
# plain residual projection (`attention_output` over [M, NV, W]).
#
# Projection column contract, consumed by the state entries:
# `qkv (CH) | z (NV * W) | alpha (NV) | beta (NV)` with
# CH = (2 * NK + NV) * W and qkv channels ordered q heads, k heads, v heads.
#
# State contract (engine E3): each recurrent layer owns three arenas,
# `window[S, C - 1 + T, CH] A` (raw pre-convolution inputs),
# `delta[S, NV, W, W] f32` (state rows by value coordinate, columns by key
# coordinate) and `tape[S, T, NV * W + NK * W + NV] f32` (T >= 0, the planned
# speculative width). A bank holds a state and the tape of up to T rows past
# it; a version is (bank, j <= T): the bank's state advanced by its first j
# tape rows. Tape row i is (u [NV, W], k [NK, W], d [NV]) of one row: the
# innovation u = beta (v - d S k), the L2-normalized key and the decay, so
# S <- d S + u k^T replays it (the step's own update). The bank's window
# holds the C - 1 raw rows before its state, then the raw rows of its tape.
#
# Slot `b` reads version (`previous_bank[b]`, `previous_tape[b]`) and
# publishes its successor to bank `following_bank[b]`; an entry never writes
# a `previous_bank` row or bank 0, and successors are distinct. `segments`
# partitions a prefix of the rows into ascending contiguous slots.
# `stop[b]` (0 <= stop <= rows of the slot) chooses which state is published:
# the state after the slot's first `stop[b]` rows, the C - 1 raw rows before
# it, and the tape of the next t = min(T, rows - stop) rows (window rows past
# C - 1 + t and tape rows past t are not written). A verify that accepts a
# rows commits version (following, a - stop). Outputs are produced for every
# row of the slot regardless of `stop`.
#
# Output contract: `gated[M, NV, W] A`. The raw recurrent output `S q` per row
# and value head is rounded to A (zero on rows outside every slot), then
# RMS-normalized over the head with `epsilon`, scaled by `recurrent_norm`
# (rounded to A), and multiplied by SiLU(z) (rounded to A); the product is
# rounded to A. The raw output is internal to the entry: each native keeps it
# in its `mixed` scratch, in A on the GPUs (sized for elements of up to four
# bytes) and as F32 values rounded to A on the CPU.

fn gated_delta_project[M, H, NK, NV, W](hidden: &tensor[M, H] f32,
    input_norm: &tensor[H] NW, qkv_weight: &tensor[(2 * NK + NV) * W, H] QW,
    gate_weight: &tensor[NV * W, H] GW, alpha_weight: &tensor[NV, H] AW,
    beta_weight: &tensor[NV, H] BW, epsilon: f32)
    -> tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A:
    let mut normalized = tensor[M, H] A
    rms_norm(hidden, input_norm, normalized, epsilon)
    let mut projection = tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A
    for row in 0..M:
        for column in 0..(2 * NK + NV) * W + NV * W + 2 * NV:
            projection[row, column] = 0.0
    for row in 0..M:
        for output in 0..(2 * NK + NV) * W:
            let mut sum = f32(0.0)
            for source in 0..H:
                sum = fma(f32(normalized[row, source]), f32(qkv_weight[output, source]), sum)
            projection[row, output] = sum
        for output in 0..NV * W:
            let mut sum = f32(0.0)
            for source in 0..H:
                sum = fma(f32(normalized[row, source]), f32(gate_weight[output, source]), sum)
            projection[row, (2 * NK + NV) * W + output] = sum
        for output in 0..NV:
            let mut alpha = f32(0.0)
            let mut beta = f32(0.0)
            for source in 0..H:
                let value = f32(normalized[row, source])
                alpha = fma(value, f32(alpha_weight[output, source]), alpha)
                beta = fma(value, f32(beta_weight[output, source]), beta)
            projection[row, (2 * NK + NV) * W + NV * W + output] = alpha
            projection[row, (2 * NK + NV) * W + NV * W + NV + output] = beta
    return projection

# Both backends: one segmented K1 projection qkv | z | alpha | beta (see
# `dense.seismic` for the projection library's launches on each backend;
# segments enumerate their tile groups or block columns in segment order).
# Metal: GEMV below BATCH_FROM rows, batched GEMV to 16, each normalizing
# in-threadgroup; larger classes stage the normalized rows, then the GEMM
# (17..64 rows at the fixed small-row geometry `_gemm_small`, 32 x 64 tiles;
# beyond over tuned TILE_M x TILE_N tiles, or under TALL the tall GEMM over
# rows staged in its order).
# (CUDA: GEMV to 16 rows, no batched class, GEMM row bands; see below.)
native gated_delta_project for metal from "metal/gated_delta_project.metal":
    static (H, NK, NV, W)
    params (arithmetic BATCH_FROM in [5, 3, 9], form TALL in [1, 0])
    where TALL == 0 or H % 128 == 0
    scratch normalized bytes ((M + TALL * (ceil_div(M, 64) * 64 - M)) * H * 2) when M > 16
    launch gated_delta_project_stage when M > 16 and (M <= 64 or TALL == 0):
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch gated_delta_project_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div((2 * NK + NV) * W, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(NV * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(NV, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch gated_delta_project_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div((2 * NK + NV) * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + ceil_div(NV * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8) + 2 * ceil_div(NV, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch gated_delta_project_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div((2 * NK + NV) * W, 64)
            + ceil_div(NV * W, 64) + 2 * ceil_div(NV, 64), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch gated_delta_project_gemm when M > 64 and TALL == 0:
        params (code TILE_M in [64, 128, 32], code TILE_N in [64, 128])
        threadgroups (ceil_div((2 * NK + NV) * W, TILE_N)
            + ceil_div(NV * W, TILE_N) + 2 * ceil_div(NV, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch gated_delta_project_stage_tall when M > 64 and TALL == 1:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch gated_delta_project_tall when M > 64 and TALL == 1:
        params (code TALL_M in [128, 256, 512], code TALL_K in [64, 128], code STAGERS in [2, 1])
        threadgroups (ceil_div((2 * NK + NV) * W, 32)
            + ceil_div(NV * W, 32) + 2 * ceil_div(NV, 32), ceil_div(M, TALL_M), 1)
        threads_per_threadgroup ((TALL_M / 32 + STAGERS) * 32, 1, 1)

# CUDA: GEMV to 16 rows (`gemv` to 8, `gemv16` beyond; at M = 1 the block
# forms its A row in shared memory), GEMM beyond in the K1 row bands
# (`gemm_small` to 64 rows with the INT8 candidate, `gemm` beyond; see
# `cuda_dense.seismic`); `stage` forms the A rows for M > 1, `stage_s8` the
# q8_1 rows for the INT8 GEMM. (Metal: batched GEMV class, no INT8 path.)
native gated_delta_project for cuda from "cuda/gated_delta_project.cu":
    static (H, NK, NV, W)
    params (code arithmetic INT8 in [0, 1])
    where H % 64 == 0
    scratch staged bytes (M * H * 2) when M > 1
    scratch groups bytes (M * H / 4) when INT8 == 1 and M > 16 and M <= 64
    launch gated_delta_project_stage when M > 1 and (M <= 16 or M > 64 or INT8 == 0):
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch gated_delta_project_stage_s8 when INT8 == 1 and M > 16 and M <= 64:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch gated_delta_project_gemv when M <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div((2 * NK + NV) * W, 16)
            + ceil_div(NV * W, 16) + 2 * ceil_div(NV, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, M - 1)) * H * 2)
    launch gated_delta_project_gemv16 when M > 8 and M <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div((2 * NK + NV) * W, 16)
            + ceil_div(NV * W, 16) + 2 * ceil_div(NV, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch gated_delta_project_gemm_small when M > 16 and M <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div((2 * NK + NV) * W, 16), 8)
            + ceil_div(ceil_div(NV * W, 16), 8) + 2 * ceil_div(ceil_div(NV, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch gated_delta_project_gemm when M > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div((2 * NK + NV) * W, 16), 8)
            + ceil_div(ceil_div(NV * W, 16), 8) + 2 * ceil_div(ceil_div(NV, 16), 8), ceil_div(M, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)

# Vulkan: the K1 projection library (`vulkan/common/projection.glsl`). Rows
# M <= 8 run the GEMV launch (SIMDGROUPS x ROWS lane groups of LANES lanes
# per workgroup, each owning weight rows; LANES sets the reduction order, so
# it is arithmetic) with the norm prologue in-workgroup; larger classes a
# stage launch writing the normalized rows to scratch, then the GEMM over
# TILE_M x TILE_N tiles (cooperative-matrix f16 multiplies under
# SEISMIC_HAS_MATRIX, F32 FMAs otherwise).
native gated_delta_project for vulkan from "vulkan/gated_delta_project.comp":
    static (H, NK, NV, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            TILE_M in [128, 64, 32], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64])
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch normalized bytes (M * H * 2) when M > 8
    launch gated_delta_project_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch gated_delta_project_gemv when M <= 8:
        threadgroups (ceil_div((2 * NK + NV) * W, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(NV * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(NV, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(H, 32), 288) * 72)
    launch gated_delta_project_gemm when M > 8:
        threadgroups (ceil_div((2 * NK + NV) * W, TILE_N) + ceil_div(NV * W, TILE_N) + 2 * ceil_div(NV, TILE_N),
            ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# CPU: the CPU projection library (`cpu/lib/projection/projection.rs`). A
# normalize launch writes each normalized row as F32 to scratch; the row
# launch enumerates the segments qkv | z | alpha | beta, ROWS weight rows per
# work item, projected against every normalized row.
native gated_delta_project for cpu from "cpu/gated_delta_project.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch normalized bytes (M * H * 4)
    launch gated_delta_project_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch gated_delta_project_rows:
        threadgroups (ceil_div((2 * NK + NV) * W, ROWS) + ceil_div(NV * W, ROWS) + 2 * ceil_div(NV, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)


# The sequential semantic oracle shared by the state entries, in two parts.
#
# `gated_delta_convolve`: the causal depthwise convolution of each slot row's
# q | k | v channels over its version's window rows and the slot's earlier
# rows, then SiLU, in F32 (zero on rows outside every slot); and the
# successor's window. The CH channels are the first columns of the
# projection rows.
fn gated_delta_convolve[M, B, S, P, CH, C, T](projection: &tensor[M, P] A,
    convolution: &tensor[CH, C] f32,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    window: &mut tensor[S, C - 1 + T, CH] A) -> tensor[M, CH] f32 where T >= 0 and P >= CH:
    let mut convolved = tensor[M, CH] f32
    for row in 0..M:
        for channel in 0..CH:
            convolved[row, channel] = 0.0
    for slot in 0..B:
        let lo = segments[slot, 0]
        let hi = segments[slot, 1]
        let source = previous_bank[slot]
        let taped = previous_tape[slot]
        let target = following_bank[slot]
        let publish = lo + stop[slot]
        for row in 0..M:
            if row >= lo and row < hi:
                let local = row - lo
                for channel in 0..CH:
                    let mut sum = convolution[channel, C - 1] * f32(projection[row, channel])
                    for tap in 0..C - 1:
                        let mut previous = f32(0.0)
                        if local + tap < C - 1:
                            previous = f32(window[source, taped + local + tap, channel])
                        else:
                            previous = f32(projection[lo + local + tap - (C - 1), channel])
                        sum = fma(convolution[channel, tap], previous, sum)
                    convolved[row, channel] = sum / (1.0 + exp(-sum))
        for tap in 0..C - 1 + T:
            if tap < C - 1 or publish + tap - (C - 1) < hi:
                for channel in 0..CH:
                    if stop[slot] + tap < C - 1:
                        window[target, tap, channel] = window[source, taped + stop[slot] + tap, channel]
                    else:
                        window[target, tap, channel] = projection[publish + tap - (C - 1), channel]
    return convolved

# `gated_delta_advance`: per slot, rows advance in order from their convolved
# channels: L2-normalized q (scaled by W^-1/2) and k, beta = sigmoid(b),
# decay = exp(rate * softplus(alpha + time_bias)), then the delta rule
# S <- decay S + beta (v - decay S k) k^T and output S q. The slot starts from
# its version's state (the bank's state advanced by its first `previous_tape`
# tape rows); the rows after `stop` (up to T) are recorded in the successor's
# tape. Each row's raw outputs are then gated: per value head, RMS-normalized,
# scaled by the recurrent norm and multiplied by SiLU(z).
fn gated_delta_advance[M, B, S, NK, NV, W, T](
    projection: &tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A,
    convolved: &tensor[M, (2 * NK + NV) * W] f32,
    rate: &tensor[NV] f32, time_bias: &tensor[NV] f32, recurrent_norm: &tensor[W] RN,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    delta: &mut tensor[S, NV, W, W] f32,
    tape: &mut tensor[S, T, NV * W + NK * W + NV] f32,
    norm_epsilon: f32, epsilon: f32, grouped: bool) -> tensor[M, NV, W] A where T >= 0:
    let mut mixed = tensor[M, NV, W] A
    for row in 0..M:
        for head in 0..NV:
            for column in 0..W:
                mixed[row, head, column] = 0.0
    for slot in 0..B:
        let lo = segments[slot, 0]
        let hi = segments[slot, 1]
        let source = previous_bank[slot]
        let taped = previous_tape[slot]
        let target = following_bank[slot]
        let publish = lo + stop[slot]
        let mut state = tensor[NV, W, W] f32
        for head in 0..NV:
            for state_row in 0..W:
                for column in 0..W:
                    state[head, state_row, column] = delta[source, head, state_row, column]
        for entry in 0..T:
            if entry < taped:
                for head in 0..NV:
                    let mut key_head = head % NK
                    if grouped:
                        key_head = head * NK / NV
                    let factor = tape[source, entry, NV * W + NK * W + head]
                    for state_row in 0..W:
                        let innovation = tape[source, entry, head * W + state_row]
                        for column in 0..W:
                            state[head, state_row, column] = fma(innovation,
                                tape[source, entry, NV * W + key_head * W + column],
                                state[head, state_row, column] * factor)
        if publish == lo:
            for head in 0..NV:
                for state_row in 0..W:
                    for column in 0..W:
                        delta[target, head, state_row, column] = state[head, state_row, column]
        for row in 0..M:
            if row >= lo and row < hi:
                let mut prepared = tensor[2 * NK + NV, W] f32
                for head in 0..2 * NK + NV:
                    let mut squares = f32(0.0)
                    for column in 0..W:
                        let value = convolved[row, head * W + column]
                        prepared[head, column] = value
                        squares = fma(value, value, squares)
                    let mut inverse = f32(1.0)
                    if head < 2 * NK:
                        inverse = rsqrt(squares + norm_epsilon)
                        if head < NK:
                            inverse = inverse * rsqrt(f32(W))
                    for column in 0..W:
                        prepared[head, column] = prepared[head, column] * inverse
                for value_head in 0..NV:
                    let mut key_head = value_head % NK
                    if grouped:
                        key_head = value_head * NK / NV
                    let alpha = f32(projection[row, (2 * NK + NV) * W + NV * W + value_head])
                    let beta_input = f32(projection[row, (2 * NK + NV) * W + NV * W + NV + value_head])
                    let beta = 1.0 / (1.0 + exp(-beta_input))
                    let shifted = alpha + time_bias[value_head]
                    let softplus = max(shifted, 0.0) + log(1.0 + exp(-abs(shifted)))
                    let factor = exp(rate[value_head] * softplus)
                    if row >= publish and row - publish < T:
                        tape[target, row - publish, NV * W + NK * W + value_head] = factor
                    for state_row in 0..W:
                        let mut remembered = f32(0.0)
                        for column in 0..W:
                            remembered = fma(state[value_head, state_row, column] * factor,
                                prepared[NK + key_head, column], remembered)
                        let residual = (prepared[2 * NK + value_head, state_row] - remembered) * beta
                        if row >= publish and row - publish < T:
                            tape[target, row - publish, value_head * W + state_row] = residual
                        let mut output = f32(0.0)
                        for column in 0..W:
                            state[value_head, state_row, column] = fma(residual,
                                prepared[NK + key_head, column],
                                state[value_head, state_row, column] * factor)
                            output = fma(state[value_head, state_row, column],
                                prepared[key_head, column], output)
                        mixed[row, value_head, state_row] = output
                if row >= publish and row - publish < T:
                    for key_head in 0..NK:
                        for column in 0..W:
                            tape[target, row - publish, NV * W + key_head * W + column] = prepared[NK + key_head, column]
                if row + 1 == publish:
                    for head in 0..NV:
                        for state_row in 0..W:
                            for column in 0..W:
                                delta[target, head, state_row, column] = state[head, state_row, column]
    let mut gated = tensor[M, NV, W] A
    let mut normalized = tensor[M, NV, W] A
    let mut activated = tensor[M, NV, W] A
    for row in 0..M:
        for head in 0..NV:
            for column in 0..W:
                gated[row, head, column] = 0.0
                normalized[row, head, column] = 0.0
                activated[row, head, column] = 0.0
    for row in 0..M:
        for value_head in 0..NV:
            let mut squares = f32(0.0)
            for column in 0..W:
                squares = fma(f32(mixed[row, value_head, column]), f32(mixed[row, value_head, column]), squares)
            let inverse = rsqrt(squares / f32(W) + epsilon)
            for column in 0..W:
                let gate = f32(projection[row, (2 * NK + NV) * W + value_head * W + column])
                normalized[row, value_head, column] = f32(mixed[row, value_head, column]) * inverse * f32(recurrent_norm[column])
                activated[row, value_head, column] = gate / (1.0 + exp(-gate))
                gated[row, value_head, column] = f32(normalized[row, value_head, column]) * f32(activated[row, value_head, column])
    return gated

# The whole oracle: the convolution, then the advance.
fn gated_delta_rows[M, B, S, NK, NV, W, C, T](
    projection: &tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A,
    convolution: &tensor[(2 * NK + NV) * W, C] f32,
    rate: &tensor[NV] f32, time_bias: &tensor[NV] f32, recurrent_norm: &tensor[W] RN,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    window: &mut tensor[S, C - 1 + T, (2 * NK + NV) * W] A,
    delta: &mut tensor[S, NV, W, W] f32,
    tape: &mut tensor[S, T, NV * W + NK * W + NV] f32,
    norm_epsilon: f32, epsilon: f32, grouped: bool) -> tensor[M, NV, W] A where T >= 0:
    let convolved = gated_delta_convolve(projection, convolution, segments, stop, previous_bank,
        previous_tape, following_bank, window)
    return gated_delta_advance(projection, convolved, rate, time_bias, recurrent_norm, segments, stop,
        previous_bank, previous_tape, following_bank, delta, tape, norm_epsilon, epsilon, grouped)


# Row-sequential state advance for small row classes. Each threadgroup owns
# one value head, `ROWS` state rows, and one slot; it stages the prologue of
# a block of rows in threadgroup memory, then each of its four simdgroups
# advances ROWS / 4 state rows, W / 32 columns per lane. `ROWS` never changes
# result bits.
fn gated_delta_step[M, B, S, NK, NV, W, C, T](
    projection: &tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A,
    convolution: &tensor[(2 * NK + NV) * W, C] f32,
    rate: &tensor[NV] f32, time_bias: &tensor[NV] f32, recurrent_norm: &tensor[W] RN,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    window: &mut tensor[S, C - 1 + T, (2 * NK + NV) * W] A,
    delta: &mut tensor[S, NV, W, W] f32,
    tape: &mut tensor[S, T, NV * W + NK * W + NV] f32,
    norm_epsilon: f32, epsilon: f32, grouped: bool, slab_banks: u32) -> tensor[M, NV, W] A where T >= 0:
    return gated_delta_rows(projection, convolution, rate, time_bias, recurrent_norm, segments, stop,
        previous_bank, previous_tape, following_bank, window, delta, tape, norm_epsilon, epsilon, grouped)

# Metal: each threadgroup stores its raw outputs to `mixed`; the last of a
# value head's threadgroups to arrive (`arrivals`, one counter per head)
# gates the head's rows, W / 8 lanes per row and head, each summing the
# squares of eight columns in order, then a butterfly over the lanes (the
# lane grouping of the projection GEMV staging).
native gated_delta_step for metal from "metal/gated_delta_step.metal":
    static (NK, NV, W, C)
    params (ROWS in [32, 16, 64])
    where W % 32 == 0 and W <= 256 and ROWS <= W and W % ROWS == 0
    scratch mixed bytes (M * NV * W * 4)
    scratch arrivals bytes (NV * 4) sync
    launch gated_delta_step:
        threadgroups (NV, W / ROWS, B)
        threads_per_threadgroup (128, 1, 1)

# CUDA: warp per state row, each warp owning ROWS state rows (W / 32 float
# columns per lane) for the whole slot; grid z adds one layer that zeroes the
# raw rows no slot covers. The last block of a value head to arrive
# (`arrivals`, one counter per head) gates the head's rows (one warp per row:
# lanes stride the head's columns, then a warp sum). (Metal: lanes advance
# four rows in flight; the uncovered rows are zeroed by the slot layer.)
native gated_delta_step for cuda from "cuda/gated_delta_step.cu":
    static (NK, NV, W, C)
    where W % 32 == 0 and NV % 4 == 0
    scratch mixed bytes (M * NV * W * 4)
    scratch arrivals bytes (NV * 4) sync
    launch gated_delta_step:
        params (code ROWS in [2, 4], code WARPS in [4, 8])
        threadgroups (NV, W / (ROWS * WARPS), B + 1)
        threads_per_threadgroup (WARPS * 32, 1, 1)

# Vulkan: the CUDA step. Workgroup (value head, state-row block, slot), grid
# z = B zeroes the raw rows no slot covers; each subgroup holds ROWS state
# rows in registers for the whole slot. ROWS and WARPS never change result
# bits. Shared: a span's prepared q | k | v channels and gates. `gate` forms
# each (head, row): to 8 rows W / 8 lanes each sum eight columns' squares in
# order, then a butterfly; beyond, lanes stride the columns, then a subgroup
# sum.
native gated_delta_step for vulkan from "vulkan/gated_delta_step.comp":
    static (NK, NV, W, C)
    params (ROWS in [2, 4], WARPS in [4, 8])
    where W % 32 == 0 and W <= 256 and W % (ROWS * WARPS) == 0 and C <= 8
    scratch mixed bytes (M * NV * W * 4)
    launch gated_delta_step:
        threadgroups (NV, W / (ROWS * WARPS), B + 1)
        threads_per_threadgroup (WARPS * 32, 1, 1)
        shared_bytes ((8 * (2 * W + ROWS * WARPS) + 16) * 4)
    launch gated_delta_step_gate:
        threadgroups (NV, M, 1)
        threads_per_threadgroup (32, 1, 1)
        shared_bytes (128)

# CPU: a work item per (value head, ROWS state rows, slot) holds its state
# rows privately for the whole slot and computes each row's prologue itself;
# grid z = B zeroes the raw rows no slot covers. ROWS never changes result
# bits. Private bytes: the state rows, the key head's q and k, the rows' v.
# `gate` then forms each row (one work item per row).
native gated_delta_step for cpu from "cpu/gated_delta_step.rs":
    params (ROWS in [32, 16, 64, 128])
    scratch mixed bytes (M * NV * W * 4)
    launch gated_delta_step:
        threadgroups (NV, ceil_div(W, ROWS), B + 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((min(ROWS, W) * W + 2 * W + min(ROWS, W)) * 4)
    launch gated_delta_step_gate:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (W * 8)


# The convolved decode form, for the row classes of `gated_delta_step` on a
# backend that declares it: the projection launch also convolves, so no step
# threadgroup repeats a q/k convolution. `gated_delta_project_convolved` is
# `gated_delta_project` followed by `gated_delta_convolve`: it returns the
# projection and each slot row's convolved q | k | v channels (F32, after
# SiLU), and publishes every slot's successor window, so it binds the slot
# tables and the window arena. `gated_delta_step_convolved` is
# `gated_delta_advance` over those channels and binds no window. Every slot
# has at least one row. With equal projection parameters the two give
# `gated_delta_project` and `gated_delta_step`'s bits: the channels are the
# F32 values the step convolves, from the projection values rounded to A.
fn gated_delta_project_convolved[M, B, S, H, NK, NV, W, C, T](hidden: &tensor[M, H] f32,
    input_norm: &tensor[H] NW, qkv_weight: &tensor[(2 * NK + NV) * W, H] QW,
    gate_weight: &tensor[NV * W, H] GW, alpha_weight: &tensor[NV, H] AW,
    beta_weight: &tensor[NV, H] BW, convolution: &tensor[(2 * NK + NV) * W, C] f32,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    window: &mut tensor[S, C - 1 + T, (2 * NK + NV) * W] A, epsilon: f32, slab_banks: u32)
    -> (tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A, tensor[M, (2 * NK + NV) * W] f32) where T >= 0:
    let projection = gated_delta_project(hidden, input_norm, qkv_weight, gate_weight, alpha_weight,
        beta_weight, epsilon)
    let convolved = gated_delta_convolve(projection, convolution, segments, stop, previous_bank,
        previous_tape, following_bank, window)
    return (projection, convolved)

# Metal: `gated_delta_project`'s GEMV and batched GEMV launches with its
# parameters, the GEMV launched as `gemv` for one row, `gemv_pair` for two and
# `gemv_rows` for more (see `dense_rows.seismic`). The qkv segment's epilogue receives every row's sum of its
# channel (a GEMV lane group holds them all; the batched class gathers them
# from the matrix fragment's lanes). For each row it publishes, it convolves
# the channel over the slot's earlier rows (rounded to A, as published) and
# the source window's rows with `gated_delta_step`'s F32 tap chain and SiLU,
# and writes the row's raw value to the successor window when the window keeps
# it; the owner of a slot's first row also copies the source window rows the
# successor keeps.
native gated_delta_project_convolved for metal from "metal/gated_delta_project_convolved.metal":
    static (H, NK, NV, W, C)
    params (arithmetic BATCH_FROM in [5, 3, 9])
    launch gated_delta_project_convolved_gemv when M < 2:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32, 8])
        threadgroups (ceil_div((2 * NK + NV) * W, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(NV * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(NV, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch gated_delta_project_convolved_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div((2 * NK + NV) * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + ceil_div(NV * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8) + 2 * ceil_div(NV, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch gated_delta_project_convolved_gemv_rows when M >= 3 and M < BATCH_FROM:
        params (SIMDGROUPS in [8, 16, 4, 2, 32], code ROWS in [2, 1, 4], code arithmetic LANES in [8, 16, 32])
        threadgroups (ceil_div((2 * NK + NV) * W, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(NV * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(NV, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch gated_delta_project_convolved_gemv_pair when M == 2 and M < BATCH_FROM:
        params (SIMDGROUPS in [8, 16, 4, 2, 32], code ROWS in [2, 1, 4], code arithmetic LANES in [8, 16, 32])
        threadgroups (ceil_div((2 * NK + NV) * W, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(NV * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(NV, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)

fn gated_delta_step_convolved[M, B, S, NK, NV, W, T](
    projection: &tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A,
    convolved: &tensor[M, (2 * NK + NV) * W] f32,
    rate: &tensor[NV] f32, time_bias: &tensor[NV] f32, recurrent_norm: &tensor[W] RN,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    delta: &mut tensor[S, NV, W, W] f32,
    tape: &mut tensor[S, T, NV * W + NK * W + NV] f32,
    norm_epsilon: f32, epsilon: f32, grouped: bool, slab_banks: u32) -> tensor[M, NV, W] A where T >= 0:
    return gated_delta_advance(projection, convolved, rate, time_bias, recurrent_norm, segments, stop,
        previous_bank, previous_tape, following_bank, delta, tape, norm_epsilon, epsilon, grouped)

# Metal: `gated_delta_step`'s launch and arithmetic, whose prologue loads the
# convolved channels: a simdgroup L2-normalizes a q or k row with one
# simd_sum, and the value channels are loaded as they are.
native gated_delta_step_convolved for metal from "metal/gated_delta_step_convolved.metal":
    static (NK, NV, W)
    params (ROWS in [32, 16, 64])
    where W % 32 == 0 and W <= 256 and ROWS <= W and W % ROWS == 0
    scratch mixed bytes (M * NV * W * 4)
    scratch arrivals bytes (NV * 4) sync
    launch gated_delta_step_convolved:
        threadgroups (NV, W / ROWS, B)
        threads_per_threadgroup (128, 1, 1)


# Chunked state advance for large row classes: the same contract as
# `gated_delta_step`, computed in the WY form over pieces of at most 8 rows
# (a piece boundary at the stop row). The inputs launch convolves each row of
# every slot once into the `inputs` scratch (L2-normalized q and k, v, log
# decay and beta). In the scan launch a threadgroup owns (`ROWS` state rows,
# value head, slot), each simdgroup 16 state rows in registers; per piece it
# stages the piece's inputs in threadgroup memory; then, with gamma the
# cumulative decay, X = K S^T and Y = Q S^T, U = (I + A)^-1 diag(beta) (V - diag(gamma) X)
# with A_ij = beta_i (gamma_i / gamma_j) k_i . k_j (j < i), outputs
# diag(gamma) Y + (QK^T o D) U, S <- gamma_last S + U^T diag(gamma_last / gamma) K.
# Slots of at most 16 rows (MTP verify) are not chunked: the scan advances them
# row-sequentially with `gated_delta_step`'s bits; in a longer slot only
# the rows before `stop` are chunked and the rows after it (whose innovations
# feed the tape) advance row-sequentially from the published state. `ROWS`
# never changes result bits.
fn gated_delta_chunk[M, B, S, NK, NV, W, C, T](
    projection: &tensor[M, (2 * NK + NV) * W + NV * W + 2 * NV] A,
    convolution: &tensor[(2 * NK + NV) * W, C] f32,
    rate: &tensor[NV] f32, time_bias: &tensor[NV] f32, recurrent_norm: &tensor[W] RN,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    window: &mut tensor[S, C - 1 + T, (2 * NK + NV) * W] A,
    delta: &mut tensor[S, NV, W, W] f32,
    tape: &mut tensor[S, T, NV * W + NK * W + NV] f32,
    norm_epsilon: f32, epsilon: f32, grouped: bool, slab_banks: u32) -> tensor[M, NV, W] A where T >= 0:
    return gated_delta_rows(projection, convolution, rate, time_bias, recurrent_norm, segments, stop,
        previous_bank, previous_tape, following_bank, window, delta, tape, norm_epsilon, epsilon, grouped)

# Metal: `inputs` convolves every row once into scratch, and the scan builds
# each piece's system in threadgroup memory and stores the raw outputs to
# `mixed`; `gate` forms each (row, head), one simdgroup whose lanes stride the
# head's columns, then a simd sum. (CUDA: `prepare` convolves and forms the
# systems on tensor cores, then the scan.)
native gated_delta_chunk for metal from "metal/gated_delta_chunk.metal":
    static (NK, NV, W, C)
    params (ROWS in [128, 64, 32])
    where W % 32 == 0 and W <= 256 and W % ROWS == 0
    scratch inputs bytes (M * ((2 * NK + NV) * W + 2 * NV) * 4)
    scratch mixed bytes (M * NV * W * 4)
    launch gated_delta_chunk_inputs:
        threadgroups (M, ceil_div(2 * NK + NV, 4), 1)
        threads_per_threadgroup (128, 1, 1)
    launch gated_delta_chunk_scan:
        threadgroups (W / ROWS, NV, B)
        threads_per_threadgroup (2 * ROWS, 1, 1)
    launch gated_delta_chunk_gate:
        threadgroups (M * NV, 1, 1)
        threads_per_threadgroup (32, 1, 1)

# CUDA: pieces of 16 rows. `prepare` (per piece and key head) convolves the
# piece's q, k and v rows once and forms, per value head, the decayed K K^T
# system's inverse and Q K^T; the scan (per ROWS state rows, value head, slot)
# keeps the state in tensor-core accumulators and applies the slot's pieces in
# order on f16 m16n8k16 operands (state and key as high + low pairs). Slots of
# at most 16 rows have no pieces, and the rows after a stop row none either:
# they advance row-sequentially in the scan with the step's bits. The scan
# stores the raw outputs to `mixed`, and `gate` forms each row as the step's
# does. Every scan ROWS divides W. (Metal: an `inputs` convolution launch; the
# systems are built in its scan.)
native gated_delta_chunk for cuda from "cuda/gated_delta_chunk.cu":
    static (NK, NV, W, C)
    where W % 128 == 0 and W <= 256 and NV % NK == 0 and NV / NK <= 8 and NV % 4 == 0
    scratch pieces bytes ((ceil_div(M, 16) + B) * (NK * 96 * W + NV * (32 * W + 1168)))
    scratch mixed bytes (M * NV * W * 4)
    launch gated_delta_chunk_prepare:
        threadgroups (ceil_div(M, 16) + B, NK, 1)
        threads_per_threadgroup (256, 1, 1)
    launch gated_delta_chunk_scan:
        params (code ROWS in [128, 64, 32])
        threadgroups (W / ROWS, NV, B + 1)
        threads_per_threadgroup (2 * ROWS, 1, 1)
        shared_bytes (3 * (96 * W + 32 * ROWS + 1680) + ROWS / 16 * 16 * 17 * 4)
    launch gated_delta_chunk_gate:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: `inputs` convolves and normalizes every chunked row once into
# scratch with the step's arithmetic; the scan keeps the step's workgroup
# geometry with each state row on 32 / ROWS lanes, so a row's dot products are
# short per-lane chains and a group butterfly. Slots of at most 16 rows (MTP
# verify) and zero-stop slots get the step's bits; the rows after a stop row
# advance row-sequentially from the published state. The scan stores the raw
# outputs to `mixed`, and `gate` forms each (head, row) as the step's does
# beyond 8 rows.
native gated_delta_chunk for vulkan from "vulkan/gated_delta_chunk.comp":
    static (NK, NV, W, C)
    params (ROWS in [4, 2], WARPS in [8, 4])
    where W % 32 == 0 and W <= 256 and W % (ROWS * WARPS) == 0 and C <= 8
    scratch inputs bytes (M * ((2 * NK + NV) * W + 2 * NV) * 4)
    scratch mixed bytes (M * NV * W * 4)
    launch gated_delta_chunk_inputs:
        threadgroups (M, ceil_div(2 * NK + NV, 4), 1)
        threads_per_threadgroup (128, 1, 1)
    launch gated_delta_chunk_scan:
        threadgroups (NV, W / (ROWS * WARPS), B + 1)
        threads_per_threadgroup (WARPS * 32, 1, 1)
        shared_bytes ((8 * (2 * W + ROWS * WARPS) + 16) * 4)
    launch gated_delta_chunk_gate:
        threadgroups (NV, M, 1)
        threads_per_threadgroup (32, 1, 1)
        shared_bytes (128)

# CPU: `inputs` convolves and normalizes each slot row once into scratch (one
# work item per row), with the step's arithmetic; the scan advances every
# slot row-sequentially from the staged rows, a work item per (value head,
# ROWS state rows, slot) with private state rows, so every slot gets the
# step's bits (no WY form: on the CPU the sequential rule is the cheaper
# schedule). Grid z = B zeroes the raw rows no slot covers, and `gate` forms
# each row as the step's does.
native gated_delta_chunk for cpu from "cpu/gated_delta_chunk.rs":
    params (ROWS in [64, 32, 128])
    scratch inputs bytes (M * ((2 * NK + NV) * W + 2 * NV) * 4)
    scratch mixed bytes (M * NV * W * 4)
    launch gated_delta_chunk_inputs:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch gated_delta_chunk_scan:
        threadgroups (NV, ceil_div(W, ROWS), B + 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (min(ROWS, W) * W * 4)
    launch gated_delta_chunk_gate:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (W * 8)
