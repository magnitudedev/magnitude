    launch routed_experts_up_stage when OPERAND == 1 or operands(EUW) == 1:
        reads (OPERAND)
        threadgroups (M, 1, 1)
        grid (stage_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_up_expand:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(T, 32), B)
        grid (expand_grid)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 10240) + 4096)
    launch routed_experts_up_quantize when operands(EDW) == 1:
        reads (OPERAND)
        threadgroups (B * T, 1, 1)
        grid (quantize_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_up_down:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(T, 32), B)
        grid (down_grid)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 10240) + 4096)

native routed_experts_up for vulkan from "vulkan/routed_experts_up.comp":
    static (H, F, US)
    params (TILE_M in [32, 64] default 32, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    records (expert_up, expert_down, records_up, records_down)
