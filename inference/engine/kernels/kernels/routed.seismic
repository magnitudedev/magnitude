# Decode output, as `routed_output` without the shared expert. Metal runs the
# K choices side by side, one simdgroup each, over (32 / LANES) * ROWS
# output channels per threadgroup; the projections meet in threadgroup
# memory, and one thread per channel carries the slot-order sum. (CUDA: the
# storing lane carries each channel's running sum across the choices in
# registers.)
native routed_down for metal from "metal/routed_down.metal":
    static (H, K, F)
    params (ROWS in [2, 1, 4, 8] default 2, arithmetic LANES in [16, 32] default 16)
    records (expert_down, tier_down)
    where K <= 32 and ceil_div(F, 32 * LANES) * ROWS <= 8
    launch routed_down when XS > 0:
        threadgroups (ceil_div(H, ROWS * 32 / LANES), M, 1)
        unless (policy[POLICY_WHOLE])
        threads_per_threadgroup (32 * K, 1, 1)
    # PLAIN, of one value, scopes the launches' parameters, so each launch
    # forms its own source: the whole one with plain record loads.
    launch routed_down_whole when XS > 0:
        params (PLAIN in [1] default 1)
        threadgroups (ceil_div(H, ROWS * 32 / LANES), M, 1)
        if (policy[POLICY_WHOLE])
        threads_per_threadgroup (32 * K, 1, 1)
    launch routed_down_whole when XS == 0:
        params (PLAIN in [1] default 1)
        threadgroups (ceil_div(H, ROWS * 32 / LANES), M, 1)
        threads_per_threadgroup (32 * K, 1, 1)

# CUDA: the choices' projections in parallel blocks, A-rounded into
# `projected`, then the slot-order combine, which adds the sum to the base.
native routed_down for cuda from "cuda/routed_down.cu":
    static (H, K, F)
    params (TPW in [1, 2] default 1, arithmetic KSPLIT in [1, 2, 4] default 1)
    where F % 64 == 0
    scratch projected bytes (M * K * H * 2)
    scratch operands bytes (M * K * F * 2) when M > 1 and operands(EDW) == 1
    launch routed_down when M == 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M * K, 1)
        threads_per_threadgroup (128, 1, 1)
        shared_bytes (operands(EDW) * F * 2)
    launch routed_down_stage when M > 1 and operands(EDW) == 1:
        threadgroups (M * K, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_down_gathered when M > 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M * K, 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_down_combine:
        threadgroups (ceil_div(H, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the choices' weighted projections in slot order, in one launch
# (`lib/routed/down.glsl`, `down_sum.glsl`). A tier-served choice reads its
# tier record in place, over the link.
native routed_down for vulkan from "vulkan/routed_down.comp":
    static (H, K, F)
    params (SIMDGROUPS in [2, 4, 8] default 2, ROWS in [1, 2, 4] default 1)
    records (expert_down, tier_down)
    launch routed_down:
        threadgroups (ceil_div(H, SIMDGROUPS * ROWS), M, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * operands(EDW) + min(ceil_div(F, 32), 288) * 72)

# CPU: work item (x, m) owns ROWS output channels of row m: the choices'
# weighted projections in slot order.
native routed_down for cpu from "cpu/routed_down.rs":
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where (INT8 == 0 or form(EDW, INT8) == 1)
    scratch quantized bytes (M * K * ceil_div(F, Q8_VALUES) * Q8_BYTES)
    scratch staged bytes (M * K * F * 4)
    launch routed_down_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_down_rows:
        threadgroups (ceil_div(H, ROWS), M, 1)
        threads_per_threadgroup (1, 1, 1)

# Prefill, up-only experts: the `routed_experts` GEMMs with one expanding
# weight (Metal TILE_M x TILE_N simdgroup-matrix tiles; CUDA 32 x 128
# mma.sync tiles; Vulkan the Metal form; CPU ROWS features per work item).
native routed_experts_up for metal from "metal/routed_experts_up.metal":
    static (H, F, US)
    params (TILE_M in [32, 64] default 32, TILE_N in [128, 64] default 128)
    records (expert_up, expert_down, records_up, records_down)
    scratch staged bytes (M * H * 2) when operands(EUW) == 1
    scratch product bytes (B * T * F * 2)
    scratch stage_grid bytes (12)
    scratch expand_grid bytes (12)
    scratch quantize_grid bytes (12)
    scratch down_grid bytes (12)
    launch routed_experts_up_grids:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_up_stage when operands(EUW) == 1:
        threadgroups (M, 1, 1)
        grid (stage_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_up_expand:
        threadgroups (ceil_div(F, TILE_N), B * ceil_div(T, TILE_M), 1)
        grid (expand_grid)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_experts_up_quantize when operands(EDW) == 1:
        threadgroups (B * T, 1, 1)
        grid (quantize_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_up_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        grid (down_grid)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

native routed_experts_up for cuda from "cuda/routed_experts_up.cu":
    static (H, F, US)
    params (arithmetic OPERAND in [0, 1] default 0)
    where H % 64 == 0 and F % 64 == 0
    scratch staged bytes (M * H * 2) when OPERAND == 1 or operands(EUW) == 1
    scratch product bytes (B * T * F * 2)
    scratch stage_grid bytes (12)
    scratch expand_grid bytes (12)
    scratch quantize_grid bytes (12)
    scratch down_grid bytes (12)
