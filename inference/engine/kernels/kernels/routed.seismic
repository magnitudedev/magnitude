# Routed (mixture-of-experts) feed-forward entries.
#
# Routing contract: probabilities are the softmax of the router logits over
# every expert, computed once. The K winners are ranked by descending
# probability, a NaN as -inf, with ties to the higher expert index
# (`rank_experts`, functions.seismic, the order of every expert selection);
# rank r is stored at slot K - 1 - r (ascending-probability slot order) with
# its ranked probability. With `normalize` the K scores are divided by their
# slot-order sum. The shared expert's coefficient is
# sigmoid(normalized . shared_router).
#
# Per-expert scale ports (every routed entry; `dense_rows.seismic` defines
# the convention): a stacked expert weight's second-level scales (NVFP4
# `.scale`, one F32 per expert matrix) are `[S] f32`, S static on every
# backend: 0 is no scale (the port is never read and the natives compile the
# scaling out), else the layer's expert count, indexed by expert (an entry
# whose E counts the layer's experts constrains S to it; the projections' E
# may count qualification's one expert, or a streamed layer's bank slots,
# instead).
#   - `expert_scale` (ES): each choice's combine weight is multiplied by its
#     expert's, after the normalization (the down weight's scale, folded
#     into the weight; the general form's stored output scales the same).
#   - `gate_scale` (GS), `up_scale` (US): the expansions' F32 accumulators,
#     as `scale_rows` scales a dense one, before the expansion's `glu`
#     (functions.seismic, the one gate/up formula of every expansion).
#
# Decode (and small row classes): route -> expand -> output; on a backend
# that declares `routed_route_shared`, route_shared -> gate_up -> output.
# Prefill: route -> group -> experts, the shared gate/up as a dense expansion,
# then combine. Each expert's projection is published (rounded to the
# activation dtype) before it is weighted; weighted choices accumulate in
# slot order, then the shared expert, then the residual.

# The decode row bound: the largest row class the routed decode forms (the
# route and select GEMVs, the expansion and output, the bank-served
# streamed decode) serve, and the decode rows their natives size their
# per-row memory by. The executor's decode classes are the classes up to it
# (`constants::DECODE_ROWS`).
const DECODE_ROWS = 8

fn routed_route[M, H, PT, NM, E, K, ES](residual: &tensor[M, PT * H] f32, norm: &tensor[NM] NW,
    router: &tensor[E, H] RW, shared_router: &tensor[H] f32,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, K] f32,
    eps: f32, normalize: i32, expert_scale: &tensor[ES] f32) -> (tensor[M, H] A, tensor[M] f32)
    where NM >= 0 and ((NM == H and PT == 1) or (NM == 0 and PT >= 1)) and ES >= 0 and (ES == 0 or ES == E) and operands(RW) == 0:
    let mut normalized = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    let mut coefficient = tensor[M] f32
    form_input(residual, norm, normalized, eps)
    linear(normalized, router, logits)
    rank_choices(logits, routes, scores)
    for row in 0..M:
        if normalize != 0:
            let denominator = reduce(f32(scores[row]), 0, sum)
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] / denominator
        if ES > 0:
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] * expert_scale[routes[row, choice]]
        let gate = reduce(f32(normalized[row]) * f32(shared_router), 0, sum)
        coefficient[row] = 1.0 / (1.0 + exp(-gate))
    return (normalized, coefficient)

# Both backends: rows <= DECODE_ROWS form the router logits as a GEMV (one simdgroup or
# warp per logit column); larger classes normalize once per row (`stage`),
# then a tiled GEMM (Metal 64 x 32, CUDA 32 x 32; edge tiles guarded);
# selection with one
# simdgroup or warp per row, ceil(E / 32) experts per lane (lanes at or past
# E % 32 exclude their last register). SIMDGROUPS (columns per GEMV
# threadgroup) never changes result bits.
#
# Metal: the GEMV is the K1 GEMV body (32-lane groups, dense rows loaded a
# whole packet at a time) over the normalized rows each threadgroup stages,
# plus one threadgroup for the shared-expert gate row; F32 activations,
# which the GEMV body does not stage, run one simdgroup per column that
# normalizes on the fly, in the same sum order. The last GEMV threadgroup to
# arrive (`arrivals`, sync scratch) selects every row, so rows <= DECODE_ROWS route in
# one launch. The GEMM forms 64 x 32 tiles on 8x8 F32 simdgroup matrices
# (128 threads, `metal/lib/routed/logits.h`).
# (CUDA: the GEMV normalizes on the fly; scalar FMAs over shared tiles, 256
# threads; a separate selection launch.)
native routed_route for metal from "metal/routed_route.metal":
    static (H, PT, NM, E, K, ES)
    params (SIMDGROUPS in [8, 16, 4, 2] default 8)
    where H % 32 == 0 and E <= 1024
    scratch logits bytes (M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_stage when M > DECODE_ROWS:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_route_gemv when M <= DECODE_ROWS:
        threadgroups (ceil_div(E, SIMDGROUPS) + 1, 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch routed_route_gemm when M > DECODE_ROWS:
        threadgroups (ceil_div(E + 1, 32), ceil_div(M, 64), 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_route_select when M > DECODE_ROWS:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: decode rows (M <= DECODE_ROWS) form the logits in one GEMV launch whose last
# block to arrive selects. Larger classes run the GEMM: scalar FMAs over
# 32 x 32 shared tiles (256 threads), split over the hidden axis into SPLIT
# partial planes that the selection launch sums in order (SPLIT changes the
# logit summation order, so it is arithmetic). (Metal: F32 simdgroup
# matrices, unsplit.)
native routed_route for cuda from "cuda/routed_route.cu":
    static (H, PT, NM, E, K, ES)
    params (SIMDGROUPS in [8, 4, 2] default 8, arithmetic SPLIT in [8, 4, 16] default 8)
    where H % 32 == 0 and E <= 1024
    scratch logits bytes (SPLIT * M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_stage when M > DECODE_ROWS:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_route_gemv when M <= DECODE_ROWS:
        threadgroups (ceil_div(E + 1, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
    launch routed_route_gemm when M > DECODE_ROWS:
        threadgroups (ceil_div(E + 1, 32), ceil_div(M, 32), SPLIT)
        threads_per_threadgroup (256, 1, 1)
    launch routed_route_select when M > DECODE_ROWS:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the Metal form over `vulkan/common/{projection,routed}.glsl`. Rows
# <= DECODE_ROWS form the router logits as a GEMV (one subgroup per logit column,
# normalizing in the workgroup, workgroup 0 publishing the normalized rows);
# larger classes stage the normalized rows once, then a 32 x 32 F32 tile
# GEMM; selection with one subgroup per row. SIMDGROUPS never changes bits.
native routed_route for vulkan from "vulkan/routed_route.comp":
    static (H, PT, NM, E, K, ES)
    params (SIMDGROUPS in [8, 4, 2] default 8)
    where H % 32 == 0 and E <= 1024
    scratch logits bytes (M * (E + 1) * 4)
    launch routed_route_stage when M > DECODE_ROWS:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (32)
    launch routed_route_gemv when M <= DECODE_ROWS:
        threadgroups (ceil_div(E + 1, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (4 * DECODE_ROWS * (8 + 1))
    launch routed_route_gemm when M > DECODE_ROWS:
        threadgroups (ceil_div(E + 1, 32), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
        shared_bytes (9216)
    launch routed_route_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: each row normalized once (F32 in scratch); ROWS router rows per work
# item against every row; one row's selection per work item (its E
# probabilities, then a sort of its E experts). ROWS never changes result
# bits.
native routed_route for cpu from "cpu/routed_route.rs":
    params (ROWS in [8, 4, 2, 1] default 8)
    scratch normalized bytes (M * H * 4)
    scratch logits bytes (M * E * 4)
    launch routed_route_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch routed_route_logits:
        threadgroups (ceil_div(E, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_route_select:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (E * 8)


# Decode routing with the shared expert's expansion (M <= DECODE_ROWS): `routed_route`,
# then the shared half of `routed_expand` over the normalized rows. The
# shared expert does not depend on the routes, so a backend that declares
# this entry expands it in the router's launch and the choices alone with
# `routed_gate_up` (SiLU); the others run `routed_route`, then
# `routed_expand`.
fn routed_route_shared[M, H, PT, NM, E, K, S, ES](residual: &tensor[M, PT * H] f32,
    norm: &tensor[NM] NW, router: &tensor[E, H] RW, shared_router: &tensor[H] f32,
    shared_gate: &tensor[S, H] SGW, shared_up: &tensor[S, H] SUW,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, K] f32,
    eps: f32, normalize: i32, expert_scale: &tensor[ES] f32)
    -> (tensor[M, H] A, tensor[M] f32, tensor[M, S] A)
    where NM >= 0 and ((NM == H and PT == 1) or (NM == 0 and PT >= 1)) and ES >= 0 and (ES == 0 or ES == E) and operands(RW) == 0 and operands(SGW) == operands(SUW):
    let mut normalized = tensor[M, H] A
    let mut coefficient = tensor[M] f32
    let mut shared_product = tensor[M, S] A
    route_shared(residual, norm, router, shared_router, shared_gate, shared_up, eps,
        normalize, expert_scale, routes, scores, normalized, coefficient, shared_product)
    return (normalized, coefficient, shared_product)

# Metal: the `routed_route` GEMV threadgroups
# (`metal/lib/routed/route.h`: the logits, the shared-expert gate column, the
# selection in the last of them to arrive), followed by the shared expert's
# gate/up threadgroups. A shared threadgroup forms the normalized rows as a
# router threadgroup does (the published `normalized` bits), then runs the
# rows16 paired GEMV of `routed_expand`'s shared row: ROWS weight rows per
# lane group of LANES lanes (LANES sets the reduction order, so it is
# arithmetic), SIMDGROUPS x 32 / LANES lane groups. For equal LANES,
# `shared_product` carries `routed_expand`'s bits.
native routed_route_shared for metal from "metal/routed_route_shared.metal":
    static (H, PT, NM, E, K, S, ES)
    params (SIMDGROUPS in [8, 16, 4, 2] default 8, ROWS in [1, 2, 4] default 1, arithmetic LANES in [32, 16] default 32)
    where H % 32 == 0 and E <= 1024
    scratch logits bytes (M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_shared:
        threadgroups (ceil_div(E, SIMDGROUPS) + 1 + ceil_div(S, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)

# CUDA: the `routed_route` GEMV blocks (`cuda/lib/routed/route.cuh`: a warp a
# logit column, the shared-expert gate column in the last block, the
# selection in the last of them to arrive), followed by the shared expert's
# blocks. A shared block forms the decode rows in its shared memory as a
# router block forms them (the published `normalized` bits, or their NVFP4
# operands as `routed_expand`'s stage launch forms them), then runs
# `routed_expand`'s shared row (`cuda/lib/routed/shared.cuh`): the swap-AB
# GEMV, TPW tiles per warp group, KSPLIT splitting K across a group's warps
# (KSPLIT sets the reduction order, so it is arithmetic), SIMDGROUPS / KSPLIT
# groups a block. For equal KSPLIT, `shared_product` carries
# `routed_expand`'s bits. The first configuration is `routed_route`'s and
# `routed_expand`'s, so the decode form keeps their bits at their defaults.
native routed_route_shared for cuda from "cuda/routed_route_shared.cu":
    static (H, PT, NM, E, K, S, ES)
    params (SIMDGROUPS in [8, 4, 2] default 8, TPW in [1, 2] default 1, arithmetic KSPLIT in [1, 2, 4] default 1)
    where H % 64 == 0 and E <= 1024 and SIMDGROUPS % KSPLIT == 0
    scratch logits bytes (M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_shared:
        threadgroups (ceil_div(E + 1, SIMDGROUPS) + ceil_div(ceil_div(ceil_div(S, 16), TPW), SIMDGROUPS / KSPLIT), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (M * H * 2)


# Decode expansion (M <= DECODE_ROWS): each choice's expert gate/up and the shared
# expert's gate/up, each the SiLU `glu`; the choices' accumulators carry
# their experts' `gate_scale` and `up_scale`.
fn routed_expand[M, H, E, K, F, S, GS, US](normalized: &tensor[M, H] A,
    routes: &tensor[M, K] i32, expert_gate: &tensor[E, F, H] EGW,
    expert_up: &tensor[E, F, H] EUW, shared_gate: &tensor[S, H] SGW,
    shared_up: &tensor[S, H] SUW, gate_scale: &tensor[GS] f32,
    up_scale: &tensor[US] f32) -> (tensor[M, K, F] A, tensor[M, S] A)
    where GS >= 0 and US >= 0 and operands(EGW) == operands(EUW) and operands(SGW) == operands(SUW):
    let mut expert_product = tensor[M, K, F] A
    let mut shared_product = tensor[M, S] A
    let mut shared_gates = tensor[M, S] A
    let mut shared_ups = tensor[M, S] A
    let mut gate_rows = tensor[M, H] f32
    let mut up_rows = tensor[M, H] f32
    let mut shared_gate_rows = tensor[M, H] f32
    let mut shared_up_rows = tensor[M, H] f32
    operand_rows(normalized, operands(expert_gate), gate_rows)
    operand_rows(normalized, operands(expert_up), up_rows)
    operand_rows(normalized, operands(shared_gate), shared_gate_rows)
    operand_rows(normalized, operands(shared_up), shared_up_rows)
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            let mut gate_factor = f32(1.0)
            let mut up_factor = f32(1.0)
            if GS > 0:
                gate_factor = gate_scale[expert]
            if US > 0:
                up_factor = up_scale[expert]
            let mut gate = tensor[1, F] A
            let mut up = tensor[1, F] A
            let mut product = tensor[1, F] A
            for feature in 0..F:
                let mut g = f32(0.0)
                let mut u = f32(0.0)
                for source in 0..H:
                    g = fma(gate_rows[row, source], f32(expert_gate[expert, feature, source]), g)
                    u = fma(up_rows[row, source], f32(expert_up[expert, feature, source]), u)
                gate[0, feature] = g * gate_factor
                up[0, feature] = u * up_factor
            glu(gate, up, product, 0)
            for feature in 0..F:
                expert_product[row, choice, feature] = product[0, feature]
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(shared_gate_rows[row, source], f32(shared_gate[feature, source]), gate)
                up = fma(shared_up_rows[row, source], f32(shared_up[feature, source]), up)
            shared_gates[row, feature] = gate
            shared_ups[row, feature] = up
    glu(shared_gates, shared_ups, shared_product, 0)
    return (expert_product, shared_product)

# Metal: the rows16 GEMV, SIMDGROUPS x 32 / LANES lane groups of ROWS weight
# rows per threadgroup (LANES sets the reduction order, so it is arithmetic);
# row y < M * K is choice (m, k), row M * K the shared expert. (CUDA: the mma16
# swap-AB GEMV, TPW tiles per warp group, KSPLIT-way K split.)
native routed_expand for metal from "metal/routed_expand.metal":
    static (H, K, F, S, GS, US)
    records (expert_gate, expert_up)
    launch routed_expand:
        params (SIMDGROUPS in [2, 4, 8, 16] default 2, ROWS in [1, 2, 4] default 1, arithmetic LANES in [32, 16] default 32)
        threadgroups (ceil_div(max(F, S), SIMDGROUPS * ROWS * 32 / LANES), M * K + 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)

# CUDA: the swap-AB GEMV (TPW tiles per warp group; KSPLIT splits K across
# the warps of a group and reduces in part order). Several rows run the
# gathered form: a choice's blocks run only for its expert's first choice,
# over the rows of every choice of that expert, so a step streams each chosen
# expert once; one row has nothing to share and runs the per-choice form.
# Both forms share TPW and KSPLIT, so a choice's product has its one-row bits
# in either. (Metal: the rows16 GEMV.)
native routed_expand for cuda from "cuda/routed_expand.cu":
    static (H, K, F, S, GS, US)
    params (TPW in [1, 2] default 1, arithmetic KSPLIT in [1, 2, 4] default 1)
    scratch operands bytes (M * H * 2) when operands(EGW) + operands(SGW) > 0
    launch routed_expand_stage when operands(EGW) + operands(SGW) > 0:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_expand when M == 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(max(F, S), 16), TPW), 4 / KSPLIT), M * K + 1, 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_expand_gathered when M > 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(max(F, S), 16), TPW), 4 / KSPLIT), M * K + 1, 1)
        threads_per_threadgroup (128, 1, 1)

# Vulkan: the Metal form; decode lane groups are whole subgroups. One launch
# per activation-row bound of the shared expert's GEMV (see `dense_expand`).
native routed_expand for vulkan from "vulkan/routed_expand.comp":
    static (H, K, F, S, GS, US)
    params (SIMDGROUPS in [2, 4, 8] default 2, ROWS in [1, 2, 4] default 1)
    records (expert_gate, expert_up)
    let GEMV_GROUPS = ceil_div(max(F, S), SIMDGROUPS * ROWS)
    let GEMV_GROUPS_Y = M * K + 1
    let GEMV_THREADS = 32 * SIMDGROUPS
    let GEMV_SHARED = 256 + 32 * max(operands(EGW), operands(SGW)) + min(8 * ceil_div(H, 32), 288) * 72
    launch routed_expand1 when M <= 1:
        threadgroups (GEMV_GROUPS, GEMV_GROUPS_Y, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch routed_expand2 when M == 2:
        threadgroups (GEMV_GROUPS, GEMV_GROUPS_Y, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch routed_expand4 when M >= 3 and M <= 4:
        threadgroups (GEMV_GROUPS, GEMV_GROUPS_Y, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch routed_expand8 when M >= 5:
        threadgroups (GEMV_GROUPS, GEMV_GROUPS_Y, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)

# CPU: the normalized rows staged once as F32; work item (x, y) expands ROWS
# features of choice y < M * K, or of the shared expert (y = M * K) for
# every row.
native routed_expand for cpu from "cpu/routed_expand.rs":
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where (INT8 == 0 or form(EGW, INT8) == 1 or form(EUW, INT8) == 1 or form(SGW, INT8) == 1 or form(SUW, INT8) == 1)
    scratch quantized bytes (M * ceil_div(H, Q8_VALUES) * Q8_BYTES)
    scratch staged bytes (M * H * 4)
    scratch operands bytes (M * H * 4) when operands(EGW) + operands(SGW) > 0
    launch routed_expand_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_expand_rows:
        threadgroups (ceil_div(max(F, S), ROWS), M * K + 1, 1)
        threads_per_threadgroup (1, 1, 1)


# Decode output (M <= DECODE_ROWS): each choice's down projection, published in A,
# weighted by its score in slot order; then the shared expert's down
# projection times its coefficient; then the residual. Each choice's down
# weights are read where `decode_source` names.
fn routed_output[M, H, SN, IN, E, K, F, S, XS, TR](residual: &tensor[M, SN * H] f32,
    inject: &tensor[M, IN] f32,
    expert_product: &tensor[M, K, F] A, shared_product: &tensor[M, S] A,
    routes: &tensor[M, K] i32, sources: &tensor[XS, M, K] i32, scores: &tensor[M, K] f32,
    coefficient: &tensor[M] f32, expert_down: &tensor[E, H, F] EDW,
    tier_down: &tensor[TR, H, F] EDW, shared_down: &tensor[H, S] SDW) -> tensor[M, SN * H] f32
    where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1)) and XS >= 0 and (XS == 0 or XS == SOURCE_ROWS) and TR >= 0 and (TR == 0 or XS > 0):
    let mut value = tensor[M, SN * H] f32
    let mut published = tensor[M, K + 1, H] A
    decode_output_published(expert_product, shared_product, routes, sources, expert_down, tier_down, shared_down,
        published)
    let unanswered = tensor[0, DECODE_ROWS, H] f32
    decode_output_join(residual, inject, published, scores, coefficient, unanswered, 0, false, value)
    return value

# The fused form's published projections: each choice's down projection in
# A (`decode_down`) at rows [0, K), the shared expert's at row K.
fn decode_output_published[M, H, E, K, F, S, XS, TR](expert_product: &tensor[M, K, F] A,
    shared_product: &tensor[M, S] A, routes: &tensor[M, K] i32, sources: &tensor[XS, M, K] i32,
    expert_down: &tensor[E, H, F] EDW, tier_down: &tensor[TR, H, F] EDW, shared_down: &tensor[H, S] SDW,
    published: &mut tensor[M, K + 1, H] A) where XS >= 0 and (XS == 0 or XS == SOURCE_ROWS) and TR >= 0:
    let mut rounded = tensor[M, K, H] A
    let mut shared = tensor[M, H] A
    linear(shared_product, shared_down, shared)
    decode_down(expert_product, routes, sources, expert_down, tier_down, rounded)
    for row in 0..M:
        for column in 0..H:
            for choice in 0..K:
                published[row, choice, column] = rounded[row, choice, column]
            published[row, K, column] = shared[row, column]

# `routed_output`'s sum into `value` over its published projections, the
# CPU's answer `output[flight]` added where `answered` (`decode_selected`).
fn decode_output_join[M, H, SN, IN, K, SF, R](residual: &tensor[M, SN * H] f32,
    inject: &tensor[M, IN] f32, published: &tensor[M, K + 1, H] A,
    scores: &tensor[M, K] f32, coefficient: &tensor[M] f32, output: &tensor[SF, R, H] f32,
    flight: i32, answered: bool, value: &mut tensor[M, SN * H] f32)
    where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1)) and SF >= 0 and (SF == 0 or R >= M):
    for row in 0..M:
        for column in 0..H:
            let selected = decode_selected(scores, published, output, flight, answered, i32(row), i32(column))
            let shared_value = f32(published[row, K, column]) * coefficient[row]
            # One stream: residual + selected + shared, in that order;
            # streams: residual[s] + (selected + shared) · inject[s].
            for stream in 0..SN:
                let at = stream * H + column
                if stream < IN:
                    value[row, at] = residual[row, at] + (selected + shared_value) * inject[row, stream]
                else:
                    value[row, at] = residual[row, at] + selected + shared_value

# Metal: the K choices and the shared expert project side by side, one
# simdgroup each, over a tile of (32 / LANES) * ROWS output channels; each
# lane group of LANES lanes owns ROWS channels and issues all their packet
# loads at once, reading the product straight from device memory. The
# projections are the rows16 GEMV's sums for the same LANES (so LANES is
# arithmetic); they meet in threadgroup memory, and one thread per channel
# carries the slot-order sum. A lane holds ROWS * ceil(F / (32 LANES))
# weight packets in registers (at most 8: more spill). (CUDA: the mma16
# swap-AB GEMV per choice in slot order.)
native routed_output for metal from "metal/routed_output.metal":
    static (H, SN, IN, K, F, S)
    records (expert_down, tier_down)
    where K < 32 and ceil_div(max(F, S), 32 * LANES) * ROWS <= 8
    launch routed_output:
        params (ROWS in [2, 1, 4, 8] default 2, arithmetic LANES in [16, 32] default 16)
        threadgroups (ceil_div(H, ROWS * 32 / LANES), M, 1)
        threads_per_threadgroup (32 * (K + 1), 1, 1)

# CUDA: the swap-AB GEMV (TPW, KSPLIT as in the expansion), the choices and
# the shared expert in separate blocks publishing A-rounded channels per
# (row, slot); the last block of a channel tile to arrive combines them in
# slot order. Several rows run the gathered form: each chosen expert once
# over the rows of its choices and the shared expert once over every row;
# one row runs one block per slot; both forms share TPW and KSPLIT. (Metal:
# the side-by-side form.) A tier-served choice's blocks read its tier record
# in place, over the link.
native routed_output for cuda from "cuda/routed_output.cu":
    static (H, SN, IN, K, F, S)
    params (TPW in [1, 2] default 1, arithmetic KSPLIT in [1, 2, 4] default 1)
    scratch published bytes (M * (K + 1) * H * 2)
    scratch arrivals bytes (ceil_div(H, 16) * 4) sync
    scratch expert_operands bytes (M * K * F * 2) when operands(EDW) == 1
    scratch shared_operands bytes (M * S * 2) when operands(SDW) == 1
    launch routed_output_stage when operands(EDW) + operands(SDW) > 0:
        threadgroups (M * (K + 1), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_output when M == 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M * (K + 1), 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_output_gathered when M > 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M * (K + 1), 1)
        threads_per_threadgroup (128, 1, 1)

# Vulkan: project the expert choices and shared expert in separate workgroups,
# then combine their A-rounded outputs in choice order. Decode lane groups
# are whole subgroups. A tier-served choice's workgroups read its tier record
# in place, over the link.
native routed_output for vulkan from "vulkan/routed_output.comp":
    static (H, SN, IN, K, F, S)
    params (SIMDGROUPS in [2, 4, 8] default 2, ROWS in [1, 2, 4] default 1)
    records (expert_down, tier_down)
    scratch projected bytes (M * (K + 1) * H * 2)
    launch routed_output_project:
        threadgroups (ceil_div(H, SIMDGROUPS * ROWS), M * (K + 1), 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * max(operands(EDW), operands(SDW)) + min(ceil_div(max(F, S), 32), 288) * 72)
    launch routed_output_combine:
        threadgroups (ceil_div(H, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: the products staged once as F32; work item (x, m) owns ROWS output
# channels of row m and carries their running sum across the choices.
native routed_output for cpu from "cpu/routed_output.rs":
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where (INT8 == 0 or form(EDW, INT8) == 1 or form(SDW, INT8) == 1)
    scratch expert_q8 bytes (M * K * ceil_div(F, Q8_VALUES) * Q8_BYTES)
    scratch shared_q8 bytes (M * ceil_div(S, Q8_VALUES) * Q8_BYTES)
    scratch expert bytes (M * K * F * 4)
    scratch shared bytes (M * S * 4)
    launch routed_output_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_output_rows:
        threadgroups (ceil_div(H, ROWS), M, 1)
        threads_per_threadgroup (1, 1, 1)


# Groups the choices of the `rows[0]` rows from row `first[0]` of the M rows
# (a graph sealed at a capacity of M rows grouping a range of them: a merge
# set's; `first[0] + rows[0]` at most M) by expert for the tiled expert
# projections. `used[0]` is the number of blocks the choices fill;
# of a block b below it, `order[b, t]` is the source row of tile row t (-1
# for padding) and `blocks[b]` its expert (blocks at or past `used` are left
# as they were: the expert passes dispatch only `used`). `inverse[m, k]` is
# the flat tile position (b * T + t) of choice k of a grouped row m.
# `counts[e]` is the number of choices routed to expert e. Within an expert,
# choices keep their flat (row, choice) order; the tables depend on the
# grouped rows' routes alone, never on M. B must be at least
# ceil((M * K + min(E, M * K) * (T - 1)) / T), which holds every expert's
# tiles: at most min(E, M * K) experts receive a choice, each padding its last
# tile by at most T - 1 rows (the expert-count-aware bound; with E = 512 the
# plain E * (T - 1) padding would dominate every moderate M).
fn routed_group[M, E, K, B, T](first: &tensor[1] i32, rows: &tensor[1] i32, routes: &tensor[M, K] i32,
    counts: &mut tensor[E] i32, order: &mut tensor[B, T] i32,
    inverse: &mut tensor[M, K] i32, blocks: &mut tensor[B] i32, used: &mut tensor[1] i32):
    let mut block = i32(0)
    for expert in 0..E:
        let mut lane = i32(0)
        let mut count = i32(0)
        for row in 0..M:
            if row >= first[0] and row < first[0] + rows[0]:
                for choice in 0..K:
                    if routes[row, choice] == i32(expert):
                        if lane == 0:
                            blocks[block] = i32(expert)
                        order[block, lane] = i32(row)
                        inverse[row, choice] = block * i32(T) + lane
                        lane = lane + 1
                        count = count + 1
                        if lane == i32(T):
                            lane = 0
                            block = block + 1
        counts[expert] = count
        if lane > 0:
            for padding in 0..T:
                if i32(padding) >= lane:
                    order[block, padding] = -1
            block = block + 1
    used[0] = block

# The choices one grouping threadgroup or workgroup places (`routed_group`'s
# natives): staged as 16-bit experts, GROUP_CHOICES * 2 bytes of its memory,
# within Metal's 32 KiB beside its per-thread counts (4 KiB) and per-expert
# words (E <= 1024: 4 KiB). Prefill chunks of 512 rows (K <= 16) are one.
const GROUP_CHOICES = 8192

# Metal and CUDA: `routed_group_count` counts each chunk of GROUP_CHOICES
# choices by expert (`partials[chunk, e]`); `routed_group_place` places each
# chunk's choices after the earlier chunks' of their expert, and its first
# threadgroup writes the per-expert tables and `used`. No launch is bounded
# by the row count, and chunks past the grouped rows exit.
native routed_group for metal from "metal/routed_group.metal":
    static (E, K)
    where E <= 1024
    scratch partials bytes (ceil_div(M * K, GROUP_CHOICES) * E * 4)
    launch routed_group_count:
        threadgroups (ceil_div(M * K, GROUP_CHOICES), 1, 1)
        threads_per_threadgroup (1024, 1, 1)
        shared_bytes (E * 4)
    launch routed_group_place:
        threadgroups (ceil_div(M * K, GROUP_CHOICES), 1, 1)
        threads_per_threadgroup (E * (1024 / E), 1, 1)
        shared_bytes (GROUP_CHOICES * 2 + E * (1024 / E) * 4 + E * 4 + 128 + 16)

native routed_group for cuda from "cuda/routed_group.cu":
    static (E, K)
    where E <= 1024
    scratch partials bytes (ceil_div(M * K, GROUP_CHOICES) * E * 4)
    launch routed_group_count:
        threadgroups (ceil_div(M * K, GROUP_CHOICES), 1, 1)
        threads_per_threadgroup (1024, 1, 1)
        shared_bytes (E * 4)
    launch routed_group_place:
        threadgroups (ceil_div(M * K, GROUP_CHOICES), 1, 1)
        threads_per_threadgroup (E * (1024 / E), 1, 1)
        shared_bytes (GROUP_CHOICES * 2 + E * (1024 / E) * 4 + E * 4 + 128 + 16)

# Vulkan: the same two launches, without atomics; each workgroup walks its
# chunk's choices in global memory, PARTS slices per expert.
native routed_group for vulkan from "vulkan/routed_group.comp":
    static (E, K)
    params (PARTS in [1, 2, 4] default 1)
    where E * PARTS <= 1024
    scratch partials bytes (ceil_div(M * K, GROUP_CHOICES) * E * 4)
    launch routed_group_count:
        threadgroups (ceil_div(M * K, GROUP_CHOICES), 1, 1)
        threads_per_threadgroup (E * PARTS, 1, 1)
        shared_bytes (E * PARTS * 4)
    launch routed_group_place:
        threadgroups (ceil_div(M * K, GROUP_CHOICES), 1, 1)
        threads_per_threadgroup (E * PARTS, 1, 1)
        shared_bytes (E * PARTS * 4 + E * 4 * 2)

# CPU: one work item counts, places the tiles and walks the grouped choices
# in flat order.
native routed_group for cpu from "cpu/routed_group.rs":
    launch routed_group:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)


# Per-expert tile projections over the blocks `routed_group` filled (the
# first `used[0]`, over the `rows[0]` rows it grouped from row `first[0]`): the `glu` of gate/up
# (`activation`: 0 SiLU, 1 GELU-tanh), then down. Expert e's weights are
# where the layer's map places it for the step: `records_*[r]` while it
# holds a record r for the step (`held`, `step` its step pair), else
# `expert_*[e]` (the resident stack, or the scratch tier of a streamed
# layer); without a map (X = 0, QS = 0) every expert reads `expert_*[e]`. Its scales are `gate_scale[e]`, `up_scale[e]` wherever it
# lives. Rows of blocks past `used` and padding rows carry no contract; the
# combine reads only the positions `inverse` names.
fn routed_experts[M, H, E, F, B, T, GS, US, X, QS, R](first: &tensor[1] i32, rows: &tensor[1] i32,
    normalized: &tensor[M, H] A, order: &tensor[B, T] i32, blocks: &tensor[B] i32,
    used: &tensor[1] i32, expert_gate: &tensor[E, F, H] EGW, expert_up: &tensor[E, F, H] EUW,
    expert_down: &tensor[E, H, F] EDW, map: &tensor[X, MAP_WORDS] i32, step: &tensor[QS] i32,
    records_gate: &tensor[R, F, H] EGW, records_up: &tensor[R, F, H] EUW,
    records_down: &tensor[R, H, F] EDW, activation: i32, gate_scale: &tensor[GS] f32,
    up_scale: &tensor[US] f32) -> tensor[B, T, H] A
    where GS >= 0 and US >= 0 and operands(EGW) == operands(EUW) and X >= 0 and QS >= 0 and ((X == 0 and QS == 0) or (X == E and QS == STEP_WORDS)):
    let mut output = tensor[B, T, H] A
    let mut gate = tensor[1, F] A
    let mut up = tensor[1, F] A
    let mut product = tensor[1, F] A
    let mut gate_rows = tensor[M, H] f32
    let mut up_rows = tensor[M, H] f32
    let mut down_row = tensor[F] f32
    operand_rows(normalized, operands(expert_gate), gate_rows)
    operand_rows(normalized, operands(expert_up), up_rows)
    for block in 0..B:
        let expert = blocks[block]
        for lane in 0..T:
            for column in 0..H:
                output[block, lane, column] = 0.0
            let row = order[block, lane]
            if i32(block) < used[0] and row >= 0:
                let mut slot = i32(-1)
                if X > 0 and QS == STEP_WORDS:
                    slot = held(map, expert, (u64(u32(step[STEP_HIGH])) << u64(32)) | u64(u32(step[STEP_LOW])))
                let mut gate_factor = f32(1.0)
                let mut up_factor = f32(1.0)
                if GS > 0:
                    gate_factor = gate_scale[expert]
                if US > 0:
                    up_factor = up_scale[expert]
                for feature in 0..F:
                    let mut g = f32(0.0)
                    let mut u = f32(0.0)
                    for source in 0..H:
                        if slot >= 0:
                            g = fma(gate_rows[row, source], f32(records_gate[slot, feature, source]), g)
                            u = fma(up_rows[row, source], f32(records_up[slot, feature, source]), u)
                        else:
                            g = fma(gate_rows[row, source], f32(expert_gate[expert, feature, source]), g)
                            u = fma(up_rows[row, source], f32(expert_up[expert, feature, source]), u)
                    gate[0, feature] = g * gate_factor
                    up[0, feature] = u * up_factor
                glu(gate, up, product, activation)
                operand_row(product[0], operands(expert_down), down_row)
                for column in 0..H:
                    let mut projected = f32(0.0)
                    for feature in 0..F:
                        if slot >= 0:
                            projected = fma(down_row[feature], f32(records_down[slot, column, feature]), projected)
                        else:
                            projected = fma(down_row[feature], f32(expert_down[expert, column, feature]), projected)
                    output[block, lane, column] = projected
    return output

# Every backend: a first one-thread launch writes the other launches' grids
# into scratch from `rows` and `used` (`stage_grid` the grouped rows, which
# the stage launch takes from row `first[0]`,
# `expand_grid` and `down_grid` the used blocks' tiles, `quantize_grid` the
# used blocks' rows); each launch's declared groups are its grid's bound.
# Metal: the paired gate/up GEMM, then the down GEMM, over each block's live
# rows in TILE_M x TILE_N simdgroup-matrix tiles. (CUDA: fixed 32 x 128
# mma.sync tiles, 3 cp.async stages.)
native routed_experts for metal from "metal/routed_experts.metal":
    static (H, F, GS, US)
    params (TILE_M in [32, 64] default 32, TILE_N in [128, 64] default 128)
    records (expert_gate, expert_up, expert_down, records_gate, records_up, records_down)
    scratch staged bytes (M * H * 2) when operands(EGW) + operands(EUW) > 0
    scratch product bytes (B * T * F * 2)
    scratch stage_grid bytes (12)
    scratch expand_grid bytes (12)
    scratch quantize_grid bytes (12)
    scratch down_grid bytes (12)
    launch routed_experts_grids:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_stage when operands(EGW) + operands(EUW) > 0:
        threadgroups (M, 1, 1)
        grid (stage_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_expand:
        threadgroups (ceil_div(F * 2, TILE_N), B * ceil_div(T, TILE_M), 1)
        grid (expand_grid)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_experts_quantize when operands(EDW) == 1:
        threadgroups (B * T, 1, 1)
        grid (quantize_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        grid (down_grid)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

# CUDA: 32-row x 128-column block tiles over mma16 weights. (Metal: tunable
# simdgroup-matrix tiles.)
native routed_experts for cuda from "cuda/routed_experts.cu":
    static (H, F, GS, US)
    params (arithmetic OPERAND in [0, 1] default 0)
    scratch staged bytes (M * H * 2) when OPERAND == 1 or operands(EGW) + operands(EUW) > 0
    scratch product bytes (B * T * F * 2)
    scratch stage_grid bytes (12)
    scratch expand_grid bytes (12)
    scratch quantize_grid bytes (12)
    scratch down_grid bytes (12)
    launch routed_experts_grids:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_stage when OPERAND == 1 or operands(EGW) + operands(EUW) > 0:
        reads (OPERAND)
        threadgroups (M, 1, 1)
        grid (stage_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_expand:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(T, 32), B)
        grid (expand_grid)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 2 * 10240) + 2 * 4096)
    launch routed_experts_quantize when operands(EDW) == 1:
        reads (OPERAND)
        threadgroups (B * T, 1, 1)
        grid (quantize_grid)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_down:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(T, 32), B)
        grid (down_grid)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 10240) + 4096)

# Vulkan: the Metal form on the projection library's GEMM (paired gate/up
# tiles, then the down tiles; over NVFP4 weights the stage launch forms the
# normalized rows' operands, the quantize launch the products' in place).
native routed_experts for vulkan from "vulkan/routed_experts.comp":
    static (H, F, GS, US)
    params (TILE_M in [32, 64] default 32, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    records (expert_gate, expert_up, expert_down, records_gate, records_up, records_down)
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch staged bytes (M * H * 2) when operands(EGW) + operands(EUW) > 0
    scratch product bytes (B * T * F * 2)
    scratch stage_grid bytes (12)
    scratch expand_grid bytes (12)
    scratch quantize_grid bytes (12)
    scratch down_grid bytes (12)
    launch routed_experts_grids:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_stage when operands(EGW) + operands(EUW) > 0:
        threadgroups (M, 1, 1)
        grid (stage_grid)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch routed_experts_expand:
        threadgroups (ceil_div(F * 2, TILE_N), B * ceil_div(T, TILE_M), 1)
        grid (expand_grid)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_experts_quantize when operands(EDW) == 1:
        threadgroups (B * T, 1, 1)
        grid (quantize_grid)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch routed_experts_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        grid (down_grid)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# CPU: the normalized rows staged once as F32; work item (x, b) owns ROWS
# features (then ROWS output channels) of block b across its live rows, with
# the products as F32 in scratch.
native routed_experts for cpu from "cpu/routed_experts.rs":
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where (INT8 == 0 or form(EGW, INT8) == 1 or form(EUW, INT8) == 1 or form(EDW, INT8) == 1)
    scratch quantized bytes (M * ceil_div(H, Q8_VALUES) * Q8_BYTES)
    scratch product_q8 bytes (B * T * ceil_div(F, Q8_VALUES) * Q8_BYTES)
    scratch staged bytes (M * H * 4)
    scratch product bytes (B * T * F * 4)
    scratch stage_grid bytes (12)
    scratch expand_grid bytes (12)
    scratch quantize_grid bytes (12)
    scratch down_grid bytes (12)
    launch routed_experts_grids:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_stage:
        threadgroups (M, 1, 1)
        grid (stage_grid)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_expand:
        threadgroups (ceil_div(F, ROWS), B, 1)
        grid (expand_grid)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_quantize when INT8 == 1 or operands(EDW) == 1:
        threadgroups (B * T, 1, 1)
        grid (quantize_grid)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_down:
        threadgroups (ceil_div(H, ROWS), B, 1)
        grid (down_grid)
        threads_per_threadgroup (1, 1, 1)


# The shared expert over every row (the SiLU `glu` of gate/up, then down), and
# the grouped expert outputs unpermuted in slot order: publishes
# residual + selected + round_A(shared) * coefficient.
fn routed_combine[M, H, SN, IN, K, B, T, S](residual: &tensor[M, SN * H] f32,
    inject: &tensor[M, IN] f32,
    expert_output: &tensor[B, T, H] A, inverse: &tensor[M, K] i32,
    scores: &tensor[M, K] f32, normalized: &tensor[M, H] A,
    coefficient: &tensor[M] f32, shared_gate: &tensor[S, H] SGW,
    shared_up: &tensor[S, H] SUW, shared_down: &tensor[H, S] SDW)
    -> tensor[M, SN * H] f32 where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1)) and operands(SGW) == 0 and operands(SUW) == 0 and operands(SDW) == 0:
    let mut shared_product = tensor[M, S] A
    let mut shared_gates = tensor[M, S] A
    let mut shared_ups = tensor[M, S] A
    let mut shared = tensor[M, H] A
    let mut value = tensor[M, SN * H] f32
    let mut gate_rows = tensor[M, H] f32
    let mut up_rows = tensor[M, H] f32
    operand_rows(normalized, operands(shared_gate), gate_rows)
    operand_rows(normalized, operands(shared_up), up_rows)
    for row in 0..M:
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(gate_rows[row, source], f32(shared_gate[feature, source]), gate)
                up = fma(up_rows[row, source], f32(shared_up[feature, source]), up)
            shared_gates[row, feature] = gate
            shared_ups[row, feature] = up
    glu(shared_gates, shared_ups, shared_product, 0)
    linear(shared_product, shared_down, shared)
    for row in 0..M:
        for column in 0..H:
            let mut selected = f32(0.0)
            for choice in 0..K:
                let position = inverse[row, choice]
                selected = fma(scores[row, choice], f32(expert_output[position / i32(T), position % i32(T), column]), selected)
            let shared_value = f32(shared[row, column]) * coefficient[row]
            for stream in 0..SN:
                let at = stream * H + column
                if stream < IN:
                    value[row, at] = residual[row, at] + (selected + shared_value) * inject[row, stream]
                else:
                    value[row, at] = residual[row, at] + selected + shared_value
    return value

# Metal: the shared gate/up GEMM, the shared down GEMM into scratch
# (`combine_down`), then an unpermuting pass (3 launches). (CUDA: the down
# GEMM's epilogue unpermutes, 2 launches.)
native routed_combine for metal from "metal/routed_combine.metal":
    static (H, SN, IN, K, S)
    params (TILE_M in [64, 128, 32] default 64, TILE_N in [64, 128] default 64)
    scratch shared_product bytes (M * S * 2)
    scratch shared_output bytes (M * H * 2)
    launch routed_combine_shared:
        threadgroups (ceil_div(S * 2, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_combine_down:
        threadgroups (ceil_div(H, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_combine:
        threadgroups (ceil_div(H, 2048), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: the shared gate/up GEMM, then the shared down GEMM whose epilogue
# unpermutes the grouped expert outputs (2 launches). (Metal: 3 launches.)
native routed_combine for cuda from "cuda/routed_combine.cu":
    static (H, SN, IN, K, S)
    params (arithmetic OPERAND in [0, 1] default 0)
    scratch staged bytes (M * H * 2) when OPERAND == 1
    scratch shared_product bytes (M * S * 2)
    launch routed_combine_stage when OPERAND == 1:
        reads (OPERAND)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_combine_shared:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(S, 16), 8), ceil_div(M, 64), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 2 * 10240) + 2 * 4096)
    launch routed_combine:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(M, 64), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 4096)

# Vulkan: the Metal form (3 launches): the shared expert's paired GEMM, its
# down GEMM, then the unpermuting combine.
native routed_combine for vulkan from "vulkan/routed_combine.comp":
    static (H, SN, IN, K, S)
    params (TILE_M in [128, 64, 32] default 64, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch shared_product bytes (M * S * 2)
    scratch shared_output bytes (M * H * 2)
    launch routed_combine_shared:
        threadgroups (ceil_div(S * 2, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_combine_down:
        threadgroups (ceil_div(H, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_combine:
        threadgroups (ceil_div(H, 2048), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: the normalized rows staged once as F32; ROWS shared features per work
# item against every row (F32 products in scratch); then ROWS output channels
# per work item: the shared down projection and the unpermuting combine.
native routed_combine for cpu from "cpu/routed_combine.rs":
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where (INT8 == 0 or form(SGW, INT8) == 1 or form(SUW, INT8) == 1 or form(SDW, INT8) == 1)
    scratch quantized bytes (M * ceil_div(H, Q8_VALUES) * Q8_BYTES)
    scratch shared_q8 bytes (M * ceil_div(S, Q8_VALUES) * Q8_BYTES)
    scratch staged bytes (M * H * 4)
    scratch shared_product bytes (M * S * 4)
    launch routed_combine_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_combine_shared:
        threadgroups (ceil_div(S, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_combine_quantize when INT8 == 1 or operands(SDW) == 1:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_combine:
        threadgroups (ceil_div(H, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)


# ---------------------------------------------------------------------------
# The general routed feed-forward (every family but Qwen's gated shared
# expert, which the fused entries above keep): no shared expert inside. A
# shared expert is a dense feed-forward of the same normalized input whose
# output projection adds to the residual first; the routed sum then adds to
# that `base`. A branch whose routed sum is normalized alone (Gemma's
# `moe_tail`) binds a zero `base`.
#
# Decode (M <= DECODE_ROWS): select -> gate_up | up -> down.
# Prefill: select -> group -> experts | experts_up -> scatter.
#
# Selection contract (`routed_select`):
#   the choices of `select_experts` (functions.seismic, the form's one
#   selection order, which its hints share): scores s[e] = score(logit[e]),
#   0 softmax over all E, 1 sigmoid, 2 sqrt(softplus) (DS4, deferred:
#   defined there, not yet qualified), ranked on s[e] + bias[e] (the
#   selection-only bias; a family without one binds zeros) by `rank_experts`
#   (a NaN as -inf, ties to the higher expert index); rank r goes to slot
#   K - 1 - r (ascending slot order, as `routed_route`).
#   weight w = s[winner] (unbiased), normalized over the slot-order sum d by
#   `normalization`: 0 none, 1 w / d, 2 w / (d + eps), 3 w / max(d, eps)
#   (llama.cpp's clamp, eps 2^-14), then w * scale, times expert_scale[winner]
#   where the port is present (ES = E: per-expert output scales, stored or
#   the down weight's second-level scales, folded into the combine weight).
# The logits read `router_input` = A(rms(residual) * router_norm); the
# experts read `normalized` = A(rms(residual) * norm) (the same inverse;
# one tensor bound to both norms when the router reads the sublayer input).
fn routed_select[M, H, E, K, ES](residual: &tensor[M, H] f32, norm: &tensor[H] NW,
    router_norm: &tensor[H] RNW, router: &tensor[E, H] RW, bias: &tensor[E] f32,
    expert_scale: &tensor[ES] f32, routes: &mut tensor[M, K] i32,
    weights: &mut tensor[M, K] f32, epsilon: f32, score: i32, normalization: i32,
    normalization_epsilon: f32, scale: f32) -> tensor[M, H] A
    where ES >= 0 and (ES == 0 or ES == E) and operands(RW) == 0:
    let mut normalized = tensor[M, H] A
    let mut router_input = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    rms_norm(residual, norm, normalized, epsilon)
    rms_norm(residual, router_norm, router_input, epsilon)
    linear(router_input, router, logits)
    let mut scores = tensor[M, E] f32
    select_experts(logits, bias, score, routes, scores)
    for row in 0..M:
        for choice in 0..K:
            weights[row, choice] = scores[row, routes[row, choice]]
        let denominator = reduce(f32(weights[row]), 0, sum)
        for choice in 0..K:
            let mut w = weights[row, choice]
            if normalization == 1:
                w = w / denominator
            if normalization == 2:
                w = w / (denominator + normalization_epsilon)
            if normalization == 3:
                w = w / max(denominator, normalization_epsilon)
            w = w * scale
            if ES > 0:
                w = w * expert_scale[routes[row, choice]]
            weights[row, choice] = w
    return normalized

# All backends: the `routed_route` launch structure over E logit columns:
# rows <= DECODE_ROWS form the logits as a GEMV (Metal, Vulkan: one simdgroup or warp
# per column, forming the router input on the fly, threadgroup 0 publishing
# `normalized`; CUDA: below); larger classes stage both normalized forms once, then a
# tiled GEMM over the router input (Metal 64 x 32, else 32 x 32; edge tiles
# guarded); the
# selection with one simdgroup or warp per row sorts each lane's
# ceil(E / 32) candidates once (lanes at or past E % 32 pad their last
# register with an excluded entry), then takes K single-argmax rounds over
# the lane heads (the single-pass top-K).
# Metal's GEMV is `routed_route`'s (`metal/lib/routed/router.h`): the K1 GEMV
# body over the router input each threadgroup stages; its GEMM is
# `routed_route`'s tiles (`metal/lib/routed/logits.h`).
native routed_select for metal from "metal/routed_select.metal":
    static (H, E, K, ES)
    params (SIMDGROUPS in [8, 16, 4, 2] default 8)
    where H % 32 == 0 and E <= 1024 and K <= E
    scratch logits bytes (M * E * 4)
    scratch router_rows bytes (M * H * 4) when M > DECODE_ROWS
    launch routed_select_stage when M > DECODE_ROWS:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_select_gemv when M <= DECODE_ROWS:
        threadgroups (ceil_div(E, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch routed_select_gemm when M > DECODE_ROWS:
        threadgroups (ceil_div(E, 32), ceil_div(M, 64), 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_select_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: the GEMV (one warp per logit column over a hidden share whose router
# input rows each threadgroup forms in shared memory) and the GEMM split the
# hidden axis into SPLIT partial planes that the selection sums in order
# (SPLIT is arithmetic).
native routed_select for cuda from "cuda/routed_select.cu":
    static (H, E, K, ES)
    params (SIMDGROUPS in [8, 4, 2] default 8, arithmetic SPLIT in [8, 4, 16] default 8)
    where H % 32 == 0 and E <= 1024 and K <= E
    scratch logits bytes (SPLIT * M * E * 4)
    scratch router_rows bytes (M * H * 4) when M > DECODE_ROWS
    launch routed_select_stage when M > DECODE_ROWS:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_select_gemv when M <= DECODE_ROWS:
        threadgroups (ceil_div(E, SIMDGROUPS), 1, SPLIT)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
    launch routed_select_gemm when M > DECODE_ROWS:
        threadgroups (ceil_div(E, 32), ceil_div(M, 32), SPLIT)
        threads_per_threadgroup (256, 1, 1)
    launch routed_select_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native routed_select for vulkan from "vulkan/routed_select.comp":
    static (H, E, K, ES)
    params (SIMDGROUPS in [8, 4, 2] default 8)
    where H % 32 == 0 and E <= 1024 and K <= E
    scratch logits bytes (M * E * 4)
    scratch router_rows bytes (M * H * 4) when M > DECODE_ROWS
    launch routed_select_stage when M > DECODE_ROWS:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (32)
    launch routed_select_gemv when M <= DECODE_ROWS:
        threadgroups (ceil_div(E, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (4 * DECODE_ROWS * (8 + 1))
    launch routed_select_gemm when M > DECODE_ROWS:
        threadgroups (ceil_div(E, 32), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
        shared_bytes (9216)
    launch routed_select_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: each row normalized once (the router input as F32 in scratch); ROWS
# router rows per work item against every row; one row's selection per work
# item (a sort of its E experts).
native routed_select for cpu from "cpu/routed_select.rs":
    params (ROWS in [8, 4, 2, 1] default 8)
    scratch router_rows bytes (M * H * 4)
    scratch logits bytes (M * E * 4)
    launch routed_select_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 12)
    launch routed_select_logits:
        threadgroups (ceil_div(E, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_select_select:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (E * 8)


# The record a decode expert entry reads choice (row, choice)'s weights
# from, of expert `expert`: without sources (XS = 0, a resident layer) the
# expert itself, its stacks' row; else the source the step's route resolved
# (`sources`, `resolve`'s snapshot, which every entry of the layer reads and
# none rereads the maps for): a record of the bank (>= 0), a record t of the
# group's host tier as -2 - t, read in place over the link, or -1 for none:
# a choice the CPU computes (its answer is added to the sum,
# `decode_selected`), or one whose read or step failed (the rows that named
# it are failed, their outputs never read). The entries read no record for
# it, and it contributes nothing to their sum (a zero product, a zero
# projection).
fn decode_source[XS, M, K](sources: &tensor[XS, M, K] i32, row: i32, choice: i32, expert: i32) -> i32
    where XS >= 0:
    let mut source = expert
    if XS > 0:
        source = sources[SOURCE_RECORD, row, choice]
    return source

# Decode expansion (M <= DECODE_ROWS), gated experts: per choice, the `glu` of the
# expert's gate and up projections (`activation`: 0 SiLU, 1 GELU-tanh; the
# scales the choice's expert's), its weights read where `decode_source`
# names: a bank record of `expert_*`, or a record of the host tier's
# `tier_*` (TR of them, 0 without a tier).
fn routed_gate_up[M, H, E, K, F, GS, US, XS, TR](normalized: &tensor[M, H] A,
    routes: &tensor[M, K] i32, sources: &tensor[XS, M, K] i32, expert_gate: &tensor[E, F, H] EGW,
    expert_up: &tensor[E, F, H] EUW, tier_gate: &tensor[TR, F, H] EGW, tier_up: &tensor[TR, F, H] EUW,
    activation: i32, gate_scale: &tensor[GS] f32, up_scale: &tensor[US] f32) -> tensor[M, K, F] A
    where GS >= 0 and US >= 0 and XS >= 0 and (XS == 0 or XS == SOURCE_ROWS) and TR >= 0 and (TR == 0 or XS > 0) and operands(EGW) == operands(EUW):
    let mut product = tensor[M, K, F] A
    let mut gate_rows = tensor[M, H] f32
    let mut up_rows = tensor[M, H] f32
    operand_rows(normalized, operands(expert_gate), gate_rows)
    operand_rows(normalized, operands(expert_up), up_rows)
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            let record = decode_source(sources, i32(row), i32(choice), expert)
            let mut gate_factor = f32(1.0)
            let mut up_factor = f32(1.0)
            if GS > 0:
                gate_factor = gate_scale[expert]
            if US > 0:
                up_factor = up_scale[expert]
            if record == -1:
                for feature in 0..F:
                    product[row, choice, feature] = 0.0
            else:
                let mut gate = tensor[1, F] A
                let mut up = tensor[1, F] A
                let mut gated = tensor[1, F] A
                for feature in 0..F:
                    let mut g = f32(0.0)
                    let mut u = f32(0.0)
                    for source in 0..H:
                        if record >= 0:
                            g = fma(gate_rows[row, source], f32(expert_gate[record, feature, source]), g)
                            u = fma(up_rows[row, source], f32(expert_up[record, feature, source]), u)
                        else:
                            g = fma(gate_rows[row, source], f32(tier_gate[-2 - record, feature, source]), g)
                            u = fma(up_rows[row, source], f32(tier_up[-2 - record, feature, source]), u)
                    gate[0, feature] = g * gate_factor
                    up[0, feature] = u * up_factor
                glu(gate, up, gated, activation)
                for feature in 0..F:
                    product[row, choice, feature] = gated[0, feature]
    return product


# Decode expansion (M <= DECODE_ROWS), up-only experts: per choice,
# A(act(A(us * up))) (`activation`: 2 ReLU²; `us` the choice's expert's
# `up_scale`), its weights read where `decode_source` names.
fn routed_up[M, H, E, K, F, US, XS, TR](normalized: &tensor[M, H] A,
    routes: &tensor[M, K] i32, sources: &tensor[XS, M, K] i32, expert_up: &tensor[E, F, H] EUW,
    tier_up: &tensor[TR, F, H] EUW, up_scale: &tensor[US] f32, activation: i32) -> tensor[M, K, F] A
    where US >= 0 and XS >= 0 and (XS == 0 or XS == SOURCE_ROWS) and TR >= 0 and (TR == 0 or XS > 0):
    let mut product = tensor[M, K, F] A
    let mut up_rows = tensor[M, H] f32
    operand_rows(normalized, operands(expert_up), up_rows)
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            let record = decode_source(sources, i32(row), i32(choice), expert)
            let mut up_factor = f32(1.0)
            if US > 0:
                up_factor = up_scale[expert]
            if record == -1:
                for feature in 0..F:
                    product[row, choice, feature] = 0.0
            else:
                let mut up = tensor[1, F] A
                let mut activated = tensor[1, F] A
                for feature in 0..F:
                    let mut u = f32(0.0)
                    for source in 0..H:
                        if record >= 0:
                            u = fma(up_rows[row, source], f32(expert_up[record, feature, source]), u)
                        else:
                            u = fma(up_rows[row, source], f32(tier_up[-2 - record, feature, source]), u)
                    up[0, feature] = u * up_factor
                activate(up, activated, activation)
                for feature in 0..F:
                    product[row, choice, feature] = activated[0, feature]
    return product


# A decode step's down projection of each choice (`routed_output`,
# `routed_down`): its weights read where `decode_source` names, published
# in A, zero for a choice with no record.
fn decode_down[M, E, K, F, H, XS, TR](product: &tensor[M, K, F] A, routes: &tensor[M, K] i32,
    sources: &tensor[XS, M, K] i32, expert_down: &tensor[E, H, F] EDW, tier_down: &tensor[TR, H, F] EDW,
    published: &mut tensor[M, K, H] A) where XS >= 0 and (XS == 0 or XS == SOURCE_ROWS) and TR >= 0:
    for row in 0..M:
        for choice in 0..K:
            let record = decode_source(sources, i32(row), i32(choice), routes[row, choice])
            let mut down_row = tensor[F] f32
            operand_row(product[row, choice], operands(expert_down), down_row)
            for column in 0..H:
                let mut projected = f32(0.0)
                for feature in 0..F:
                    if record >= 0:
                        projected = fma(down_row[feature], f32(expert_down[record, column, feature]), projected)
                    if record <= -2:
                        projected = fma(down_row[feature], f32(tier_down[-2 - record, column, feature]), projected)
                published[row, choice, column] = projected


# Decode output (M <= DECODE_ROWS): each choice's down projection, published in A,
# weighted in slot order, then added to `base`, published in R:
#   R(base + sum_k w_k * A(down_k))
# R is F32 where `base` is the residual (plus a shared expert's output); A for
# a latent feed-forward, whose zero-based sum is the latent-up projection's
# input (Nemotron Super). Each choice's down weights are read where
# `decode_source` names.
# `policy` is a streamed layer's words, by which a backend may launch a form
# of a whole layer; a resident layer's are zero and read by none.
fn routed_down[M, H, E, K, F, XS, TR](base: &tensor[M, H] f32,
    product: &tensor[M, K, F] A, routes: &tensor[M, K] i32, sources: &tensor[XS, M, K] i32,
    weights: &tensor[M, K] f32, expert_down: &tensor[E, H, F] EDW, tier_down: &tensor[TR, H, F] EDW,
    policy: &tensor[POLICY_WORDS] i32) -> tensor[M, H] R
    where XS >= 0 and (XS == 0 or XS == SOURCE_ROWS) and TR >= 0 and (TR == 0 or XS > 0):
    let mut value = tensor[M, H] R
    let mut published = tensor[M, K, H] A
    decode_down(product, routes, sources, expert_down, tier_down, published)
    let unanswered = tensor[0, DECODE_ROWS, H] f32
    decode_join(base, published, weights, unanswered, 0, false, value)
    return value

# `routed_down`'s sum into `value`: base + the published projections
# weighted in slot order, plus the CPU's answer `output[flight]` where
# `answered` (`decode_selected`).
fn decode_join[M, H, K, SF, RS](base: &tensor[M, H] f32, published: &tensor[M, K, H] A,
    weights: &tensor[M, K] f32, output: &tensor[SF, RS, H] f32, flight: i32, answered: bool,
    value: &mut tensor[M, H] R)
    where SF >= 0 and (SF == 0 or RS >= M):
    for row in 0..M:
        for column in 0..H:
            value[row, column] = base[row, column] + decode_selected(weights, published, output, flight, answered, i32(row), i32(column))

# A decode row's weighted choices at output channel `column`, in slot
# order, sum_k w_k * A(down_k), `published` holding each down_k in A (row k
# of KP >= K; the fused form's row K is its shared expert's; a choice the
# CPU computes is zero there), then, where `answered` (the CPU answered the
# step), the CPU's weighted sum of its choices (`output[flight, row,
# column]`, the site's `site_output`).
fn decode_selected[M, K, KP, H, SF, RS](weights: &tensor[M, K] f32, published: &tensor[M, KP, H] A,
    output: &tensor[SF, RS, H] f32, flight: i32, answered: bool, row: i32, column: i32) -> f32
    where KP >= K and SF >= 0 and (SF == 0 or RS >= M):
    let mut selected = f32(0.0)
    for choice in 0..K:
        selected = fma(weights[row, choice], f32(published[row, choice, column]), selected)
    if answered:
        selected = selected + output[flight, row, column]
    return selected


# Prefill, up-only experts: per used block, A(act(A(us * up))) then the down
# projection (`routed_experts` is the gated form, and states the grids, the
# weights' places and the scales; `us` the block's expert's `up_scale`).
fn routed_experts_up[M, H, E, F, B, T, US, X, QS, R](first: &tensor[1] i32, rows: &tensor[1] i32,
    normalized: &tensor[M, H] A, order: &tensor[B, T] i32, blocks: &tensor[B] i32,
    used: &tensor[1] i32, expert_up: &tensor[E, F, H] EUW, expert_down: &tensor[E, H, F] EDW,
    map: &tensor[X, MAP_WORDS] i32, step: &tensor[QS] i32, records_up: &tensor[R, F, H] EUW,
    records_down: &tensor[R, H, F] EDW, up_scale: &tensor[US] f32, activation: i32)
    -> tensor[B, T, H] A
    where US >= 0 and X >= 0 and QS >= 0 and ((X == 0 and QS == 0) or (X == E and QS == STEP_WORDS)):
    let mut output = tensor[B, T, H] A
    let mut up = tensor[1, F] A
    let mut activated = tensor[1, F] A
    let mut up_rows = tensor[M, H] f32
    let mut down_row = tensor[F] f32
    operand_rows(normalized, operands(expert_up), up_rows)
    for block in 0..B:
        let expert = blocks[block]
        for lane in 0..T:
            for column in 0..H:
                output[block, lane, column] = 0.0
            let row = order[block, lane]
            if i32(block) < used[0] and row >= 0:
                let mut slot = i32(-1)
                if X > 0 and QS == STEP_WORDS:
                    slot = held(map, expert, (u64(u32(step[STEP_HIGH])) << u64(32)) | u64(u32(step[STEP_LOW])))
                let mut up_factor = f32(1.0)
                if US > 0:
                    up_factor = up_scale[expert]
                for feature in 0..F:
                    let mut u = f32(0.0)
                    for source in 0..H:
                        if slot >= 0:
                            u = fma(up_rows[row, source], f32(records_up[slot, feature, source]), u)
                        else:
                            u = fma(up_rows[row, source], f32(expert_up[expert, feature, source]), u)
                    up[0, feature] = u * up_factor
                activate(up, activated, activation)
                operand_row(activated[0], operands(expert_down), down_row)
                for column in 0..H:
                    let mut projected = f32(0.0)
                    for feature in 0..F:
                        if slot >= 0:
                            projected = fma(down_row[feature], f32(records_down[slot, column, feature]), projected)
                        else:
                            projected = fma(down_row[feature], f32(expert_down[expert, column, feature]), projected)
                    output[block, lane, column] = projected
    return output


# Prefill output: the grouped expert outputs unpermuted and weighted in slot
# order, added to `base`, published in R (as `routed_down`):
#   R(base + sum_k w_k * expert_output[inverse[m, k]])
fn routed_scatter[M, H, K, B, T](base: &tensor[M, H] f32,
    expert_output: &tensor[B, T, H] A, inverse: &tensor[M, K] i32,
    weights: &tensor[M, K] f32) -> tensor[M, H] R:
    let mut value = tensor[M, H] R
    for row in 0..M:
        for column in 0..H:
            let mut selected = f32(0.0)
            for choice in 0..K:
                let position = inverse[row, choice]
                selected = fma(weights[row, choice], f32(expert_output[position / i32(T), position % i32(T), column]), selected)
            value[row, column] = base[row, column] + selected
    return value


# Natives of the general routed entries: the `routed_expand`,
# `routed_output`, `routed_experts` and `routed_combine` launch structures
# without the shared expert.
#
# Decode expansion. Metal: the rows16 GEMV, SIMDGROUPS x 32 / LANES lane
# groups of ROWS weight rows per threadgroup (LANES sets the reduction order,
# so it is arithmetic), row y = choice (m, k). CUDA: the mma16 swap-AB GEMV
# (TPW tiles per warp group, KSPLIT-way K split). Vulkan: the Metal form with
# whole-subgroup lane groups, per choice or, as CUDA's, gathered (GATHERED: a
# one-workgroup launch tables each expert's choices, then each expert's first
# choice runs over the rows of all its choices, one launch per activation-row
# bound); a row's bits are its one-row bits in either form, since a lane
# reduces the same packets in the same order whatever the rows staged. CPU: the normalized rows staged once as F32;
# work item (x, y) expands ROWS features of choice y.
# Defaults SIMDGROUPS 8, LANES 16 (M4 Pro): Qwen3.6 35B's recorded search
# chose 8 x 16 for its Q4_K and Q5_K experts (at their best; the old 2 x 32
# default ran 1.38x and 1.89x).
native routed_gate_up for metal from "metal/routed_gate_up.metal":
    static (H, K, F, GS, US)
    records (expert_gate, expert_up, tier_gate, tier_up)
    launch routed_gate_up:
        params (SIMDGROUPS in [2, 4, 8, 16] default 8, ROWS in [1, 2, 4] default 1, arithmetic LANES in [32, 16] default 16)
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS * 32 / LANES), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32), 448) * 64)

native routed_gate_up for cuda from "cuda/routed_gate_up.cu":
    static (H, K, F, GS, US)
    params (TPW in [1, 2] default 1, arithmetic KSPLIT in [1, 2, 4] default 1, form GATHERED in [0, 1] default 0)
    where H % 64 == 0
    scratch operands bytes (M * H * 2) when GATHERED == 1 and operands(EGW) == 1
    launch routed_gate_up when GATHERED == 0:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(F, 16), TPW), 4 / KSPLIT), M * K, 1)
        threads_per_threadgroup (128, 1, 1)
        shared_bytes (operands(EGW) * H * 2)
    launch routed_gate_up_stage when GATHERED == 1 and operands(EGW) == 1:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_gate_up_gathered when GATHERED == 1:
        reads (TPW, KSPLIT)
        threadgroups (ceil_div(ceil_div(ceil_div(F, 16), TPW), 4 / KSPLIT), M * K, 1)
        threads_per_threadgroup (128, 1, 1)

native routed_gate_up for vulkan from "vulkan/routed_gate_up.comp":
    static (H, K, F, GS, US)
    params (SIMDGROUPS in [2, 4, 8] default 2, ROWS in [1, 2, 4] default 1, form GATHERED in [0, 1] default 0)
    records (expert_gate, expert_up, tier_gate, tier_up)
    scratch gathered bytes (M * K * (1 + 2 * DECODE_ROWS) * 4) when GATHERED == 1
    launch routed_gate_up when GATHERED == 0:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * operands(EGW) + min(8 * ceil_div(H, 32), 288) * 72)
    launch routed_gate_up_gather when GATHERED == 1:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_gate_up_gathered1 when GATHERED == 1 and M <= 1:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * operands(EGW) + min(8 * ceil_div(H, 32), 288) * 72)
    launch routed_gate_up_gathered2 when GATHERED == 1 and M == 2:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * operands(EGW) + min(8 * ceil_div(H, 32), 288) * 72)
    launch routed_gate_up_gathered4 when GATHERED == 1 and M >= 3 and M <= 4:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * operands(EGW) + min(8 * ceil_div(H, 32), 288) * 72)
    launch routed_gate_up_gathered8 when GATHERED == 1 and M >= 5:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + 32 * operands(EGW) + min(8 * ceil_div(H, 32), 288) * 72)

native routed_gate_up for cpu from "cpu/routed_gate_up.rs":
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where (INT8 == 0 or form(EGW, INT8) == 1 or form(EUW, INT8) == 1)
    scratch quantized bytes (M * ceil_div(H, Q8_VALUES) * Q8_BYTES)
    scratch staged bytes (M * H * 4)
    launch routed_gate_up_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_gate_up_rows:
        threadgroups (ceil_div(F, ROWS), M * K, 1)
        threads_per_threadgroup (1, 1, 1)

