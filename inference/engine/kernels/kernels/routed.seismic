# Routed (mixture-of-experts) feed-forward entries.
#
# Routing contract: probabilities are the softmax of the router logits over
# every expert, computed once. The K winners are ranked by descending
# probability with ties to the higher expert index; rank r is stored at slot
# K - 1 - r (ascending-probability slot order). With `normalize` the K scores
# are divided by their slot-order sum. The shared expert's coefficient is
# sigmoid(normalized . shared_router).
#
# Decode (and small row classes): route -> expand -> output; on a backend
# that declares `routed_route_shared`, route_shared -> gate_up -> output.
# Prefill: route -> group -> experts, the shared gate/up as a dense expansion,
# then combine. Each expert's projection is published (rounded to the
# activation dtype) before it is weighted; weighted choices accumulate in
# slot order, then the shared expert, then the residual.

fn routed_route[M, H, PT, NM, E, K](residual: &tensor[M, PT * H] f32, norm: &tensor[NM] NW,
    router: &tensor[E, H] RW, shared_router: &tensor[H] f32,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, K] f32,
    eps: f32, normalize: i32) -> (tensor[M, H] A, tensor[M] f32)
    where NM >= 0 and ((NM == H and PT == 1) or (NM == 0 and PT >= 1)):
    let mut normalized = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    let mut coefficient = tensor[M] f32
    form_input(residual, norm, normalized, eps)
    linear(normalized, router, logits)
    for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let mut probabilities = exp(values - maximum)
        let total = reduce(probabilities, 0, sum)
        probabilities = probabilities / total
        for rank in 0..K:
            let best = reduce(probabilities, 0, max)
            let mut candidates = tensor[E] i32
            for expert in 0..E:
                candidates[expert] = -1
                if probabilities[expert] == best:
                    candidates[expert] = i32(expert)
            let winner = reduce(i32(candidates), 0, max)
            routes[row, K - 1 - rank] = winner
            scores[row, K - 1 - rank] = best
            # Only a selected expert is excluded from the next rank.
            for expert in 0..E:
                if i32(expert) == winner:
                    probabilities[expert] = -inf
        if normalize != 0:
            let denominator = reduce(f32(scores[row]), 0, sum)
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] / denominator
        let gate = reduce(f32(normalized[row]) * f32(shared_router), 0, sum)
        coefficient[row] = 1.0 / (1.0 + exp(-gate))
    return (normalized, coefficient)

# Both backends: rows <= 8 form the router logits as a GEMV (one simdgroup or
# warp per logit column); larger classes normalize once per row (`stage`),
# then a 32 x 32 tiled GEMM; selection with one simdgroup or warp per row.
# SIMDGROUPS (columns per GEMV threadgroup) never changes result bits.
#
# Metal: the GEMV is the K1 GEMV body (32-lane groups, dense rows loaded a
# whole packet at a time) over the normalized rows each threadgroup stages,
# plus one threadgroup for the shared-expert gate row; F32 activations,
# which the GEMV body does not stage, run one simdgroup per column that
# normalizes on the fly, in the same sum order. The last GEMV threadgroup to
# arrive (`arrivals`, sync scratch) selects every row, so rows <= 8 route in
# one launch. The GEMM runs on 8x8 F32 simdgroup matrices (128 threads).
# (CUDA: the GEMV normalizes on the fly; scalar FMAs over shared tiles, 256
# threads; a separate selection launch.)
native routed_route for metal from "metal/routed_route.metal":
    static (H, PT, NM, E, K)
    params (SIMDGROUPS in [8, 16, 4, 2])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024
    scratch logits bytes (M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_route_gemv when M <= 8:
        threadgroups (ceil_div(E, SIMDGROUPS) + 1, 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch routed_route_gemm when M > 8:
        threadgroups (ceil_div(E + 1, 32), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_route_select when M > 8:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: decode rows (M <= 8) form the logits in one GEMV launch whose last
# block to arrive selects. Larger classes run the GEMM: scalar FMAs over
# 32 x 32 shared tiles (256 threads), split over the hidden axis into SPLIT
# partial planes that the selection launch sums in order (SPLIT changes the
# logit summation order, so it is arithmetic). (Metal: F32 simdgroup
# matrices, unsplit.)
native routed_route for cuda from "cuda/routed_route.cu":
    static (H, PT, NM, E, K)
    params (SIMDGROUPS in [8, 4, 2], arithmetic SPLIT in [8, 4, 16])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024
    scratch logits bytes (SPLIT * M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_route_gemv when M <= 8:
        threadgroups (ceil_div(E + 1, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
    launch routed_route_gemm when M > 8:
        threadgroups (ceil_div(E + 1, 32), ceil_div(M, 32), SPLIT)
        threads_per_threadgroup (256, 1, 1)
    launch routed_route_select when M > 8:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the Metal form over `vulkan/common/{projection,routed}.glsl`. Rows
# <= 8 form the router logits as a GEMV (one subgroup per logit column,
# normalizing in the workgroup, workgroup 0 publishing the normalized rows);
# larger classes stage the normalized rows once, then a 32 x 32 F32 tile
# GEMM; selection with one subgroup per row. SIMDGROUPS never changes bits.
native routed_route for vulkan from "vulkan/routed_route.comp":
    static (H, PT, NM, E, K)
    params (SIMDGROUPS in [8, 4, 2])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024
    scratch logits bytes (M * (E + 1) * 4)
    launch routed_route_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (32)
    launch routed_route_gemv when M <= 8:
        threadgroups (ceil_div(E + 1, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (288)
    launch routed_route_gemm when M > 8:
        threadgroups (ceil_div(E + 1, 32), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
        shared_bytes (9216)
    launch routed_route_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: each row normalized once (F32 in scratch); ROWS router rows per work
# item against every row; one row's selection per work item. ROWS never
# changes result bits.
native routed_route for cpu from "cpu/routed_route.rs":
    params (ROWS in [8, 4, 2, 1])
    scratch normalized bytes (M * H * 4)
    scratch logits bytes (M * E * 4)
    launch routed_route_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch routed_route_logits:
        threadgroups (ceil_div(E, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_route_select:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (E * 4)


# Decode routing with the shared expert's expansion (M <= 8): `routed_route`,
# then the shared half of `routed_expand` over the normalized rows. The
# shared expert does not depend on the routes, so a backend that declares
# this entry expands it in the router's launch and the choices alone with
# `routed_gate_up` (SiLU); the others run `routed_route`, then
# `routed_expand`.
fn routed_route_shared[M, H, PT, NM, E, K, S](residual: &tensor[M, PT * H] f32,
    norm: &tensor[NM] NW, router: &tensor[E, H] RW, shared_router: &tensor[H] f32,
    shared_gate: &tensor[S, H] SGW, shared_up: &tensor[S, H] SUW,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, K] f32,
    eps: f32, normalize: i32) -> (tensor[M, H] A, tensor[M] f32, tensor[M, S] A)
    where NM >= 0 and ((NM == H and PT == 1) or (NM == 0 and PT >= 1)):
    let mut normalized = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    let mut coefficient = tensor[M] f32
    let mut shared_product = tensor[M, S] A
    form_input(residual, norm, normalized, eps)
    linear(normalized, router, logits)
    for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let mut probabilities = exp(values - maximum)
        let total = reduce(probabilities, 0, sum)
        probabilities = probabilities / total
        for rank in 0..K:
            let best = reduce(probabilities, 0, max)
            let mut candidates = tensor[E] i32
            for expert in 0..E:
                candidates[expert] = -1
                if probabilities[expert] == best:
                    candidates[expert] = i32(expert)
            let winner = reduce(i32(candidates), 0, max)
            routes[row, K - 1 - rank] = winner
            scores[row, K - 1 - rank] = best
            # Only a selected expert is excluded from the next rank.
            for expert in 0..E:
                if i32(expert) == winner:
                    probabilities[expert] = -inf
        if normalize != 0:
            let denominator = reduce(f32(scores[row]), 0, sum)
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] / denominator
        let shared_logit = reduce(f32(normalized[row]) * f32(shared_router), 0, sum)
        coefficient[row] = 1.0 / (1.0 + exp(-shared_logit))
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(f32(normalized[row, source]), f32(shared_gate[feature, source]), gate)
                up = fma(f32(normalized[row, source]), f32(shared_up[feature, source]), up)
            shared_product[row, feature] = (gate / (1.0 + exp(-gate))) * up
    return (normalized, coefficient, shared_product)

# Metal only (Qwen's decode rows): the `routed_route` GEMV threadgroups
# (`metal/lib/routed/route.h`: the logits, the shared-expert gate column, the
# selection in the last of them to arrive), followed by the shared expert's
# gate/up threadgroups. A shared threadgroup forms the normalized rows as a
# router threadgroup does (the published `normalized` bits), then runs the
# rows16 paired GEMV of `routed_expand`'s shared row: ROWS weight rows per
# lane group of LANES lanes (LANES sets the reduction order, so it is
# arithmetic), SIMDGROUPS x 32 / LANES lane groups. For equal LANES,
# `shared_product` carries `routed_expand`'s bits.
native routed_route_shared for metal from "metal/routed_route_shared.metal":
    static (H, PT, NM, E, K, S)
    params (SIMDGROUPS in [8, 16, 4, 2], ROWS in [1, 2, 4], arithmetic LANES in [32, 16])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024
    scratch logits bytes (M * (E + 1) * 4)
    scratch arrivals bytes (4) sync
    launch routed_route_shared:
        threadgroups (ceil_div(E, SIMDGROUPS) + 1 + ceil_div(S, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)


# Decode expansion (M <= 8): each choice's expert gate/up and the shared
# expert's gate/up, each with SiLU . mul.
fn routed_expand[M, H, E, K, F, S](normalized: &tensor[M, H] A,
    routes: &tensor[M, K] i32, expert_gate: &tensor[E, F, H] EGW,
    expert_up: &tensor[E, F, H] EUW, shared_gate: &tensor[S, H] SGW,
    shared_up: &tensor[S, H] SUW) -> (tensor[M, K, F] A, tensor[M, S] A):
    let mut expert_product = tensor[M, K, F] A
    let mut shared_product = tensor[M, S] A
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            for feature in 0..F:
                let mut gate = f32(0.0)
                let mut up = f32(0.0)
                for source in 0..H:
                    gate = fma(f32(normalized[row, source]), f32(expert_gate[expert, feature, source]), gate)
                    up = fma(f32(normalized[row, source]), f32(expert_up[expert, feature, source]), up)
                expert_product[row, choice, feature] = (gate / (1.0 + exp(-gate))) * up
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(f32(normalized[row, source]), f32(shared_gate[feature, source]), gate)
                up = fma(f32(normalized[row, source]), f32(shared_up[feature, source]), up)
            shared_product[row, feature] = (gate / (1.0 + exp(-gate))) * up
    return (expert_product, shared_product)

# Metal: the rows16 GEMV, SIMDGROUPS x 32 / LANES lane groups of ROWS weight
# rows per threadgroup (LANES sets the reduction order, so it is arithmetic);
# row y < M * K is choice (m, k), row M * K the shared expert. (CUDA: the mma16
# swap-AB GEMV, TPW tiles per warp group, KSPLIT-way K split.)
native routed_expand for metal from "metal/routed_expand.metal":
    static (H, K, F, S)
    launch routed_expand:
        params (SIMDGROUPS in [2, 4, 8, 16], code ROWS in [1, 2, 4], code arithmetic LANES in [32, 16])
        threadgroups (ceil_div(max(F, S), SIMDGROUPS * ROWS * 32 / LANES), M * K + 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)

# CUDA: the swap-AB GEMV (TPW tiles per warp group; KSPLIT splits K across
# the warps of a group and reduces in part order). Several rows run the
# gathered form: a choice's blocks run only for its expert's first choice,
# over the rows of every choice of that expert, so a step streams each chosen
# expert once; one row has nothing to share and runs the per-choice form.
# (Metal: the rows16 GEMV.)
native routed_expand for cuda from "cuda/routed_expand.cu":
    static (H, K, F, S)
    launch routed_expand when M == 1:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(max(F, S), 16), TPW), 4 / KSPLIT), M * K + 1, 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_expand_gathered when M > 1:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(max(F, S), 16), TPW), 4 / KSPLIT), M * K + 1, 1)
        threads_per_threadgroup (128, 1, 1)

# Vulkan: the Metal form; decode lane groups are whole subgroups.
native routed_expand for vulkan from "vulkan/routed_expand.comp":
    static (H, K, F, S)
    params (SIMDGROUPS in [2, 4, 8], ROWS in [1, 2, 4])
    launch routed_expand:
        threadgroups (ceil_div(max(F, S), SIMDGROUPS * ROWS), M * K + 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(H, 32), 288) * 72)

# CPU: the normalized rows staged once as F32; work item (x, y) expands ROWS
# features of choice y < M * K, or of the shared expert (y = M * K) for
# every row.
native routed_expand for cpu from "cpu/routed_expand.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch staged bytes (M * H * 4)
    launch routed_expand_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_expand_rows:
        threadgroups (ceil_div(max(F, S), ROWS), M * K + 1, 1)
        threads_per_threadgroup (1, 1, 1)


# Decode output (M <= 8): each choice's down projection, published in A,
# weighted by its score in slot order; then the shared expert's down
# projection times its coefficient; then the residual.
fn routed_output[M, H, SN, IN, E, K, F, S](residual: &tensor[M, SN * H] f32,
    inject: &tensor[M, IN] f32,
    expert_product: &tensor[M, K, F] A, shared_product: &tensor[M, S] A,
    routes: &tensor[M, K] i32, scores: &tensor[M, K] f32,
    coefficient: &tensor[M] f32, expert_down: &tensor[E, H, F] EDW,
    shared_down: &tensor[H, S] SDW) -> tensor[M, SN * H] f32
    where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1)):
    let mut published = tensor[M, K, H] A
    let mut shared = tensor[M, H] A
    let mut value = tensor[M, SN * H] f32
    linear(shared_product, shared_down, shared)
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            for column in 0..H:
                let mut projected = f32(0.0)
                for feature in 0..F:
                    projected = fma(f32(expert_product[row, choice, feature]), f32(expert_down[expert, column, feature]), projected)
                published[row, choice, column] = projected
        for column in 0..H:
            let mut selected = f32(0.0)
            for choice in 0..K:
                selected = fma(scores[row, choice], f32(published[row, choice, column]), selected)
            let shared_value = f32(shared[row, column]) * coefficient[row]
            # One stream: residual + selected + shared, in that order;
            # streams: residual[s] + (selected + shared) · inject[s].
            for stream in 0..SN:
                let at = stream * H + column
                if stream < IN:
                    value[row, at] = residual[row, at] + (selected + shared_value) * inject[row, stream]
                else:
                    value[row, at] = residual[row, at] + selected + shared_value
    return value

# Metal: the K choices and the shared expert project side by side, one
# simdgroup each, over a tile of (32 / LANES) * ROWS output channels; each
# lane group of LANES lanes owns ROWS channels and issues all their packet
# loads at once, reading the product straight from device memory. The
# projections are the rows16 GEMV's sums for the same LANES (so LANES is
# arithmetic); they meet in threadgroup memory, and one thread per channel
# carries the slot-order sum. A lane holds ROWS * ceil(F / (32 LANES))
# weight packets in registers (at most 8: more spill). (CUDA: the mma16
# swap-AB GEMV per choice in slot order.)
native routed_output for metal from "metal/routed_output.metal":
    static (H, SN, IN, K, F, S)
    where K < 32 and ceil_div(max(F, S), 32 * LANES) * ROWS <= 8
    launch routed_output:
        params (code ROWS in [2, 1, 4, 8], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(H, ROWS * 32 / LANES), M, 1)
        threads_per_threadgroup (32 * (K + 1), 1, 1)

# CUDA: the swap-AB GEMV (TPW, KSPLIT as in the expansion), the choices and
# the shared expert in separate blocks publishing A-rounded channels per
# (row, slot); the last block of a channel tile to arrive combines them in
# slot order. Several rows run the gathered form: each chosen expert once
# over the rows of its choices and the shared expert once over every row;
# one row runs one block per slot. (Metal: the side-by-side form.)
native routed_output for cuda from "cuda/routed_output.cu":
    static (H, SN, IN, K, F, S)
    scratch published bytes (M * (K + 1) * H * 4)
    scratch arrivals bytes (ceil_div(H, 16) * 4) sync
    launch routed_output when M == 1:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M * (K + 1), 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_output_gathered when M > 1:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M * (K + 1), 1)
        threads_per_threadgroup (128, 1, 1)

# Vulkan: project the expert choices and shared expert in separate workgroups,
# then combine their A-rounded outputs in choice order. Decode lane groups
# are whole subgroups.
native routed_output for vulkan from "vulkan/routed_output.comp":
    static (H, SN, IN, K, F, S)
    params (SIMDGROUPS in [2, 4, 8], ROWS in [1, 2, 4])
    scratch projected bytes (M * (K + 1) * H * 2)
    launch routed_output_project:
        threadgroups (ceil_div(H, SIMDGROUPS * ROWS), M * (K + 1), 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + min(ceil_div(max(F, S), 32), 288) * 72)
    launch routed_output_combine:
        threadgroups (ceil_div(H, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: the products staged once as F32; work item (x, m) owns ROWS output
# channels of row m and carries their running sum across the choices.
native routed_output for cpu from "cpu/routed_output.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch expert_q8 bytes (M * K * ceil_div(F, 256) * 292)
    scratch shared_q8 bytes (M * ceil_div(S, 256) * 292)
    scratch expert bytes (M * K * F * 4)
    scratch shared bytes (M * S * 4)
    launch routed_output_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_output_rows:
        threadgroups (ceil_div(H, ROWS), M, 1)
        threads_per_threadgroup (1, 1, 1)


# Groups the M x K choices by expert for the tiled expert projections.
# `order[b, t]` is the source row of tile row t of block b (-1 for padding),
# `blocks[b]` the expert of block b (-1 for an unused block), and
# `inverse[m, k]` the flat tile position (b * T + t) of choice k of row m.
# `counts[e]` is the number of choices routed to expert e. Within an expert,
# choices keep their flat (row, choice) order. B must be at least
# ceil((M * K + min(E, M * K) * (T - 1)) / T), which holds every expert's
# tiles: at most min(E, M * K) experts receive a choice, each padding its last
# tile by at most T - 1 rows (the expert-count-aware bound; with E = 512 the
# plain E * (T - 1) padding would dominate every moderate M).
fn routed_group[M, E, K, B, T](routes: &tensor[M, K] i32,
    counts: &mut tensor[E] i32, order: &mut tensor[B, T] i32,
    inverse: &mut tensor[M, K] i32, blocks: &mut tensor[B] i32):
    for block in 0..B:
        blocks[block] = -1
        for lane in 0..T:
            order[block, lane] = -1
    let mut block = i32(0)
    for expert in 0..E:
        let mut lane = i32(0)
        let mut count = i32(0)
        for row in 0..M:
            for choice in 0..K:
                if routes[row, choice] == i32(expert):
                    if lane == 0:
                        blocks[block] = i32(expert)
                    order[block, lane] = i32(row)
                    inverse[row, choice] = block * i32(T) + lane
                    lane = lane + 1
                    count = count + 1
                    if lane == i32(T):
                        lane = 0
                        block = block + 1
        counts[expert] = count
        if lane > 0:
            block = block + 1

native routed_group for metal from "metal/routed_group.metal":
    static (E, K)
    where E <= 1024
    launch routed_group:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (E * (1024 / E), 1, 1)
        shared_bytes (ceil_div(M * K, 8) * 16 + E * (1024 / E) * 4 + E * 4 + 128 + 16)

native routed_group for cuda from "cuda/routed_group.cu":
    static (E, K)
    where E <= 1024
    launch routed_group:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (E * (1024 / E), 1, 1)
        shared_bytes (ceil_div(M * K, 8) * 16 + E * (1024 / E) * 4 + E * 4 + 128 + 16)

# Vulkan: the earlier Metal form (per-expert counts, then the ordered walk).
native routed_group for vulkan from "vulkan/routed_group.comp":
    static (E, K)
    params (PARTS in [1, 2, 4])
    where E * PARTS <= 1024
    launch routed_group:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (E * PARTS, 1, 1)
        shared_bytes (E * PARTS * 4 + E * 4 + 16)

# CPU: one work item counts, places the tiles and walks the choices in flat
# order.
native routed_group for cpu from "cpu/routed_group.rs":
    launch routed_group:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)


# Per-expert tile projections over grouped rows: gate/up with act . mul
# (`activation`: 0 SiLU, 1 GELU-tanh), then down. Rows of unused blocks and
# padding rows carry no contract; the combine reads only the positions
# `inverse` names.
fn routed_experts[M, H, E, F, B, T](normalized: &tensor[M, H] A,
    order: &tensor[B, T] i32, blocks: &tensor[B] i32,
    expert_gate: &tensor[E, F, H] EGW, expert_up: &tensor[E, F, H] EUW,
    expert_down: &tensor[E, H, F] EDW, activation: i32) -> tensor[B, T, H] A:
    let mut output = tensor[B, T, H] A
    let mut product = tensor[F] A
    for block in 0..B:
        let expert = blocks[block]
        for lane in 0..T:
            let row = order[block, lane]
            for column in 0..H:
                output[block, lane, column] = 0.0
            if expert >= 0 and row >= 0:
                for feature in 0..F:
                    let mut gate = f32(0.0)
                    let mut up = f32(0.0)
                    for source in 0..H:
                        gate = fma(f32(normalized[row, source]), f32(expert_gate[expert, feature, source]), gate)
                        up = fma(f32(normalized[row, source]), f32(expert_up[expert, feature, source]), up)
                    let mut activated = gate / (1.0 + exp(-gate))
                    if activation == 1:
                        let u = 0.7978845608028654 * (gate + 0.044715 * (gate * gate * gate))
                        activated = gate / (1.0 + exp(-2.0 * u))
                    product[feature] = activated * up
                for column in 0..H:
                    let mut projected = f32(0.0)
                    for feature in 0..F:
                        projected = fma(f32(product[feature]), f32(expert_down[expert, column, feature]), projected)
                    output[block, lane, column] = projected
    return output

# Both backends: the paired gate/up GEMM, then the down GEMM, over each
# block's live rows. Metal: TILE_M x TILE_N simdgroup-matrix tiles. (CUDA:
# fixed 32 x 128 mma.sync tiles, 3 cp.async stages.)
native routed_experts for metal from "metal/routed_experts.metal":
    static (H, F)
    params (TILE_M in [32, 64], TILE_N in [128, 64])
    scratch product bytes (B * T * F * 2)
    launch routed_experts_expand:
        threadgroups (ceil_div(F * 2, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_experts_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

# CUDA: 32-row x 128-column block tiles over mma16 weights. (Metal: tunable
# simdgroup-matrix tiles.)
native routed_experts for cuda from "cuda/routed_experts.cu":
    static (H, F)
    params (code arithmetic OPERAND in [0, 1])
    scratch staged bytes (M * H * 2) when OPERAND == 1
    scratch product bytes (B * T * F * 2)
    launch routed_experts_stage when OPERAND == 1:
        reads (OPERAND)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_expand:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(T, 32), B)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 2 * 10240) + 2 * 4096)
    launch routed_experts_down:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(T, 32), B)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 10240) + 4096)

# Vulkan: the Metal form on the projection library's GEMM (paired gate/up
# tiles, then the down tiles).
native routed_experts for vulkan from "vulkan/routed_experts.comp":
    static (H, F)
    params (TILE_M in [32, 64], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64])
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch product bytes (B * T * F * 2)
    launch routed_experts_expand:
        threadgroups (ceil_div(F * 2, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_experts_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# CPU: the normalized rows staged once as F32; work item (x, b) owns ROWS
# features (then ROWS output channels) of block b across its live rows, with
# the products as F32 in scratch.
native routed_experts for cpu from "cpu/routed_experts.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch product_q8 bytes (B * T * ceil_div(F, 256) * 292)
    scratch staged bytes (M * H * 4)
    scratch product bytes (B * T * F * 4)
    launch routed_experts_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_expand:
        threadgroups (ceil_div(F, ROWS), B, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_quantize when INT8 == 1:
        threadgroups (B * T, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_down:
        threadgroups (ceil_div(H, ROWS), B, 1)
        threads_per_threadgroup (1, 1, 1)


# The shared expert over every row (gate/up with SiLU . mul, then down), and
# the grouped expert outputs unpermuted in slot order: publishes
# residual + selected + round_A(shared) * coefficient.
fn routed_combine[M, H, SN, IN, K, B, T, S](residual: &tensor[M, SN * H] f32,
    inject: &tensor[M, IN] f32,
    expert_output: &tensor[B, T, H] A, inverse: &tensor[M, K] i32,
    scores: &tensor[M, K] f32, normalized: &tensor[M, H] A,
    coefficient: &tensor[M] f32, shared_gate: &tensor[S, H] SGW,
    shared_up: &tensor[S, H] SUW, shared_down: &tensor[H, S] SDW)
    -> tensor[M, SN * H] f32 where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1)):
    let mut shared_product = tensor[M, S] A
    let mut shared = tensor[M, H] A
    let mut value = tensor[M, SN * H] f32
    for row in 0..M:
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(f32(normalized[row, source]), f32(shared_gate[feature, source]), gate)
                up = fma(f32(normalized[row, source]), f32(shared_up[feature, source]), up)
            shared_product[row, feature] = (gate / (1.0 + exp(-gate))) * up
    linear(shared_product, shared_down, shared)
    for row in 0..M:
        for column in 0..H:
            let mut selected = f32(0.0)
            for choice in 0..K:
                let position = inverse[row, choice]
                selected = fma(scores[row, choice], f32(expert_output[position / i32(T), position % i32(T), column]), selected)
            let shared_value = f32(shared[row, column]) * coefficient[row]
            for stream in 0..SN:
                let at = stream * H + column
                if stream < IN:
                    value[row, at] = residual[row, at] + (selected + shared_value) * inject[row, stream]
                else:
                    value[row, at] = residual[row, at] + selected + shared_value
    return value

# Metal: the shared gate/up GEMM, the shared down GEMM into scratch
# (`combine_down`), then an unpermuting pass (3 launches). (CUDA: the down
# GEMM's epilogue unpermutes, 2 launches.)
native routed_combine for metal from "metal/routed_combine.metal":
    static (H, SN, IN, K, S)
    params (TILE_M in [64, 128, 32], TILE_N in [64, 128])
    scratch shared_product bytes (M * S * 2)
    scratch shared_output bytes (M * H * 2)
    launch routed_combine_shared:
        threadgroups (ceil_div(S * 2, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_combine_down:
        threadgroups (ceil_div(H, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_combine:
        threadgroups (ceil_div(H, 2048), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: the shared gate/up GEMM, then the shared down GEMM whose epilogue
# unpermutes the grouped expert outputs (2 launches). (Metal: 3 launches.)
native routed_combine for cuda from "cuda/routed_combine.cu":
    static (H, SN, IN, K, S)
    params (code arithmetic OPERAND in [0, 1])
    scratch staged bytes (M * H * 2) when OPERAND == 1
    scratch shared_product bytes (M * S * 2)
    launch routed_combine_stage when OPERAND == 1:
        reads (OPERAND)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_combine_shared:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(S, 16), 8), ceil_div(M, 64), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 2 * 10240) + 2 * 4096)
    launch routed_combine:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(M, 64), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 4096)

# Vulkan: the Metal form (3 launches): the shared expert's paired GEMM, its
# down GEMM, then the unpermuting combine.
native routed_combine for vulkan from "vulkan/routed_combine.comp":
    static (H, SN, IN, K, S)
    params (TILE_M in [128, 64, 32], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64])
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch shared_product bytes (M * S * 2)
    scratch shared_output bytes (M * H * 2)
    launch routed_combine_shared:
        threadgroups (ceil_div(S * 2, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_combine_down:
        threadgroups (ceil_div(H, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_combine:
        threadgroups (ceil_div(H, 2048), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: the normalized rows staged once as F32; ROWS shared features per work
# item against every row (F32 products in scratch); then ROWS output channels
# per work item: the shared down projection and the unpermuting combine.
native routed_combine for cpu from "cpu/routed_combine.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch shared_q8 bytes (M * ceil_div(S, 256) * 292)
    scratch staged bytes (M * H * 4)
    scratch shared_product bytes (M * S * 4)
    launch routed_combine_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_combine_shared:
        threadgroups (ceil_div(S, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_combine_quantize when INT8 == 1:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_combine:
        threadgroups (ceil_div(H, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)


# ---------------------------------------------------------------------------
# The general routed feed-forward (every family but Qwen's gated shared
# expert, which the fused entries above keep): no shared expert inside. A
# shared expert is a dense feed-forward of the same normalized input whose
# output projection adds to the residual first; the routed sum then adds to
# that `base`. A branch whose routed sum is normalized alone (Gemma's
# `moe_tail`) binds a zero `base`.
#
# Decode (M <= 8): select -> gate_up | up -> down.
# Prefill: select -> group -> experts | experts_up -> scatter.
#
# Selection contract (`routed_select`):
#   scores s[e] = score(logit[e]): 0 softmax over all E, 1 sigmoid,
#                 2 sqrt(softplus) (DS4, deferred: defined here, not yet
#                 qualified)
#   rank on s[e] + bias[e] (the selection-only bias; a family without one
#   binds zeros), ties to the higher expert index; rank r goes to slot
#   K - 1 - r (ascending slot order, as `routed_route`).
#   weight w = s[winner] (unbiased), normalized over the slot-order sum d by
#   `normalization`: 0 none, 1 w / d, 2 w / (d + eps), 3 w / max(d, eps)
#   (llama.cpp's clamp, eps 2^-14), then w * scale * expert_scale[winner]
#   (`expert_scale`: per-expert output scales folded into the combine
#   weight; ones when absent).
# The logits read `router_input` = A(rms(residual) * router_norm); the
# experts read `normalized` = A(rms(residual) * norm) (the same inverse;
# one tensor bound to both norms when the router reads the sublayer input).
fn routed_select[M, H, E, K](residual: &tensor[M, H] f32, norm: &tensor[H] NW,
    router_norm: &tensor[H] RNW, router: &tensor[E, H] RW, bias: &tensor[E] f32,
    expert_scale: &tensor[E] f32, routes: &mut tensor[M, K] i32,
    weights: &mut tensor[M, K] f32, epsilon: f32, score: i32, normalization: i32,
    normalization_epsilon: f32, scale: f32) -> tensor[M, H] A:
    let mut normalized = tensor[M, H] A
    let mut router_input = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    rms_norm(residual, norm, normalized, epsilon)
    rms_norm(residual, router_norm, router_input, epsilon)
    linear(router_input, router, logits)
    for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let exponentials = exp(values - maximum)
        let total = reduce(exponentials, 0, sum)
        let mut scores = tensor[E] f32
        let mut ranked = tensor[E] f32
        for expert in 0..E:
            let logit = logits[row, expert]
            let mut s = exponentials[expert] / total
            if score == 1:
                s = 1.0 / (1.0 + exp(-logit))
            if score == 2:
                s = sqrt(max(logit, 0.0) + log(1.0 + exp(-abs(logit))))
            scores[expert] = s
            ranked[expert] = s + bias[expert]
        for rank in 0..K:
            let best = reduce(ranked, 0, max)
            let mut candidates = tensor[E] i32
            for expert in 0..E:
                candidates[expert] = -1
                if ranked[expert] == best:
                    candidates[expert] = i32(expert)
            let winner = reduce(i32(candidates), 0, max)
            routes[row, K - 1 - rank] = winner
            # An empty selection (no expert matched the maximum) carries no weight.
            weights[row, K - 1 - rank] = 0.0
            for expert in 0..E:
                if i32(expert) == winner:
                    weights[row, K - 1 - rank] = scores[expert]
                    ranked[expert] = -inf
        let denominator = reduce(f32(weights[row]), 0, sum)
        for choice in 0..K:
            let mut w = weights[row, choice]
            if normalization == 1:
                w = w / denominator
            if normalization == 2:
                w = w / (denominator + normalization_epsilon)
            if normalization == 3:
                w = w / max(denominator, normalization_epsilon)
            weights[row, choice] = w * scale * expert_scale[routes[row, choice]]
    return normalized

# All backends: the `routed_route` launch structure over E logit columns:
# rows <= 8 form the logits as a GEMV (one simdgroup or warp per column,
# forming the router input on the fly, threadgroup 0 publishing
# `normalized`); larger classes stage both normalized forms once, then a
# 32 x 32 tiled GEMM over the router input; the selection with one
# simdgroup or warp per row sorts each lane's E / 32 candidates once, then
# takes K single-argmax rounds over the lane heads (the single-pass top-K).
# Metal's GEMV is `routed_route`'s (`metal/lib/routed/router.h`): the K1 GEMV
# body over the router input each threadgroup stages.
native routed_select for metal from "metal/routed_select.metal":
    static (H, E, K)
    params (SIMDGROUPS in [8, 16, 4, 2])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024 and K <= E
    scratch logits bytes (M * E * 4)
    scratch router_rows bytes (M * H * 4) when M > 8
    launch routed_select_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_select_gemv when M <= 8:
        threadgroups (ceil_div(E, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch routed_select_gemm when M > 8:
        threadgroups (ceil_div(E, 32), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch routed_select_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: the GEMM splits the hidden axis into SPLIT partial planes that the
# selection sums in order (SPLIT is arithmetic).
native routed_select for cuda from "cuda/routed_select.cu":
    static (H, E, K)
    params (SIMDGROUPS in [8, 4, 2], arithmetic SPLIT in [8, 4, 16])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024 and K <= E
    scratch logits bytes (SPLIT * M * E * 4)
    scratch router_rows bytes (M * H * 4) when M > 8
    launch routed_select_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_select_gemv when M <= 8:
        threadgroups (ceil_div(E, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
    launch routed_select_gemm when M > 8:
        threadgroups (ceil_div(E, 32), ceil_div(M, 32), SPLIT)
        threads_per_threadgroup (256, 1, 1)
    launch routed_select_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native routed_select for vulkan from "vulkan/routed_select.comp":
    static (H, E, K)
    params (SIMDGROUPS in [8, 4, 2])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024 and K <= E
    scratch logits bytes (M * E * 4)
    scratch router_rows bytes (M * H * 4) when M > 8
    launch routed_select_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (32)
    launch routed_select_gemv when M <= 8:
        threadgroups (ceil_div(E, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (288)
    launch routed_select_gemm when M > 8:
        threadgroups (ceil_div(E, 32), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
        shared_bytes (9216)
    launch routed_select_select:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: each row normalized once (the router input as F32 in scratch); ROWS
# router rows per work item against every row; one row's selection per work
# item (a stable sort of its E candidates).
native routed_select for cpu from "cpu/routed_select.rs":
    params (ROWS in [8, 4, 2, 1])
    scratch router_rows bytes (M * H * 4)
    scratch logits bytes (M * E * 4)
    launch routed_select_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 12)
    launch routed_select_logits:
        threadgroups (ceil_div(E, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_select_select:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (E * 8)


# Decode expansion (M <= 8), gated experts: per choice, the GLU of the
# expert's gate and up projections, A(A(act(A(gate))) * A(up)) (`activation`:
# 0 SiLU, 1 GELU-tanh).
fn routed_gate_up[M, H, E, K, F](normalized: &tensor[M, H] A,
    routes: &tensor[M, K] i32, expert_gate: &tensor[E, F, H] EGW,
    expert_up: &tensor[E, F, H] EUW, activation: i32) -> tensor[M, K, F] A:
    let mut product = tensor[M, K, F] A
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            let mut gate = tensor[1, F] A
            let mut up = tensor[1, F] A
            let mut activated = tensor[1, F] A
            for feature in 0..F:
                let mut g = f32(0.0)
                let mut u = f32(0.0)
                for source in 0..H:
                    g = fma(f32(normalized[row, source]), f32(expert_gate[expert, feature, source]), g)
                    u = fma(f32(normalized[row, source]), f32(expert_up[expert, feature, source]), u)
                gate[0, feature] = g
                up[0, feature] = u
            activate(gate, activated, activation)
            for feature in 0..F:
                product[row, choice, feature] = f32(activated[0, feature]) * f32(up[0, feature])
    return product


# Decode expansion (M <= 8), up-only experts: per choice,
# A(act(A(up_scale[e] * up))) (`activation`: 2 ReLU²). `up_scale` is each
# expert's second-level up-weight scale on the F32 accumulator (NVFP4
# `.scale`; ones otherwise).
fn routed_up[M, H, E, K, F](normalized: &tensor[M, H] A,
    routes: &tensor[M, K] i32, expert_up: &tensor[E, F, H] EUW,
    up_scale: &tensor[E] f32, activation: i32) -> tensor[M, K, F] A:
    let mut product = tensor[M, K, F] A
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            let mut up = tensor[1, F] A
            let mut activated = tensor[1, F] A
            for feature in 0..F:
                let mut u = f32(0.0)
                for source in 0..H:
                    u = fma(f32(normalized[row, source]), f32(expert_up[expert, feature, source]), u)
                up[0, feature] = u * up_scale[expert]
            activate(up, activated, activation)
            for feature in 0..F:
                product[row, choice, feature] = activated[0, feature]
    return product


# Decode output (M <= 8): each choice's down projection, published in A,
# weighted in slot order, then added to `base`, published in R:
#   R(base + sum_k w_k * A(down_k))
# R is F32 where `base` is the residual (plus a shared expert's output); A for
# a latent feed-forward, whose zero-based sum is the latent-up projection's
# input (Nemotron Super).
fn routed_down[M, H, E, K, F](base: &tensor[M, H] f32,
    product: &tensor[M, K, F] A, routes: &tensor[M, K] i32,
    weights: &tensor[M, K] f32, expert_down: &tensor[E, H, F] EDW) -> tensor[M, H] R:
    let mut published = tensor[M, K, H] A
    let mut value = tensor[M, H] R
    for row in 0..M:
        for choice in 0..K:
            let expert = routes[row, choice]
            for column in 0..H:
                let mut projected = f32(0.0)
                for feature in 0..F:
                    projected = fma(f32(product[row, choice, feature]), f32(expert_down[expert, column, feature]), projected)
                published[row, choice, column] = projected
        for column in 0..H:
            let mut selected = f32(0.0)
            for choice in 0..K:
                selected = fma(weights[row, choice], f32(published[row, choice, column]), selected)
            value[row, column] = base[row, column] + selected
    return value


# Prefill, up-only experts: per grouped block, A(act(A(up_scale[e] * up)))
# then the down projection (`routed_experts` is the gated form; `up_scale`
# as `routed_up`).
fn routed_experts_up[M, H, E, F, B, T](normalized: &tensor[M, H] A,
    order: &tensor[B, T] i32, blocks: &tensor[B] i32,
    expert_up: &tensor[E, F, H] EUW, expert_down: &tensor[E, H, F] EDW,
    up_scale: &tensor[E] f32, activation: i32) -> tensor[B, T, H] A:
    let mut output = tensor[B, T, H] A
    let mut up = tensor[1, F] A
    let mut activated = tensor[1, F] A
    for block in 0..B:
        let expert = blocks[block]
        for lane in 0..T:
            let row = order[block, lane]
            for column in 0..H:
                output[block, lane, column] = 0.0
            if expert >= 0 and row >= 0:
                for feature in 0..F:
                    let mut u = f32(0.0)
                    for source in 0..H:
                        u = fma(f32(normalized[row, source]), f32(expert_up[expert, feature, source]), u)
                    up[0, feature] = u * up_scale[expert]
                activate(up, activated, activation)
                for column in 0..H:
                    let mut projected = f32(0.0)
                    for feature in 0..F:
                        projected = fma(f32(activated[0, feature]), f32(expert_down[expert, column, feature]), projected)
                    output[block, lane, column] = projected
    return output


# Prefill output: the grouped expert outputs unpermuted and weighted in slot
# order, added to `base`, published in R (as `routed_down`):
#   R(base + sum_k w_k * expert_output[inverse[m, k]])
fn routed_scatter[M, H, K, B, T](base: &tensor[M, H] f32,
    expert_output: &tensor[B, T, H] A, inverse: &tensor[M, K] i32,
    weights: &tensor[M, K] f32) -> tensor[M, H] R:
    let mut value = tensor[M, H] R
    for row in 0..M:
        for column in 0..H:
            let mut selected = f32(0.0)
            for choice in 0..K:
                let position = inverse[row, choice]
                selected = fma(weights[row, choice], f32(expert_output[position / i32(T), position % i32(T), column]), selected)
            value[row, column] = base[row, column] + selected
    return value


# Natives of the general routed entries: the `routed_expand`,
# `routed_output`, `routed_experts` and `routed_combine` launch structures
# without the shared expert.
#
# Decode expansion. Metal: the rows16 GEMV, SIMDGROUPS x 32 / LANES lane
# groups of ROWS weight rows per threadgroup (LANES sets the reduction order,
# so it is arithmetic), row y = choice (m, k). CUDA: the mma16 swap-AB GEMV
# (TPW tiles per warp group, KSPLIT-way K split). Vulkan: the Metal form with
# whole-subgroup lane groups. CPU: the normalized rows staged once as F32;
# work item (x, y) expands ROWS features of choice y.
native routed_gate_up for metal from "metal/routed_gate_up.metal":
    static (H, K, F)
    launch routed_gate_up:
        params (SIMDGROUPS in [2, 4, 8, 16], code ROWS in [1, 2, 4], code arithmetic LANES in [32, 16])
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS * 32 / LANES), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32), 448) * 64)

native routed_gate_up for cuda from "cuda/routed_gate_up.cu":
    static (H, K, F)
    where H % 64 == 0
    launch routed_gate_up:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(F, 16), TPW), 4 / KSPLIT), M * K, 1)
        threads_per_threadgroup (128, 1, 1)

native routed_gate_up for vulkan from "vulkan/routed_gate_up.comp":
    static (H, K, F)
    params (SIMDGROUPS in [2, 4, 8], ROWS in [1, 2, 4])
    launch routed_gate_up:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(H, 32), 288) * 72)

native routed_gate_up for cpu from "cpu/routed_gate_up.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch staged bytes (M * H * 4)
    launch routed_gate_up_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_gate_up_rows:
        threadgroups (ceil_div(F, ROWS), M * K, 1)
        threads_per_threadgroup (1, 1, 1)

native routed_up for metal from "metal/routed_up.metal":
    static (H, K, F)
    launch routed_up:
        params (SIMDGROUPS in [2, 4, 8, 16], code ROWS in [1, 2, 4], code arithmetic LANES in [32, 16])
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS * 32 / LANES), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32), 448) * 64)

native routed_up for cuda from "cuda/routed_up.cu":
    static (H, K, F)
    where H % 64 == 0
    launch routed_up:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(F, 16), TPW), 4 / KSPLIT), M * K, 1)
        threads_per_threadgroup (128, 1, 1)

native routed_up for vulkan from "vulkan/routed_up.comp":
    static (H, K, F)
    params (SIMDGROUPS in [2, 4, 8], ROWS in [1, 2, 4])
    launch routed_up:
        threadgroups (ceil_div(F, SIMDGROUPS * ROWS), M * K, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(H, 32), 288) * 72)

native routed_up for cpu from "cpu/routed_up.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch staged bytes (M * H * 4)
    launch routed_up_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_up_rows:
        threadgroups (ceil_div(F, ROWS), M * K, 1)
        threads_per_threadgroup (1, 1, 1)

# Decode output, as `routed_output` without the shared expert. Metal runs the
# K choices side by side, one simdgroup each, over (32 / LANES) * ROWS
# output channels per threadgroup; the projections meet in threadgroup
# memory, and one thread per channel carries the slot-order sum. (CUDA: the
# storing lane carries each channel's running sum across the choices in
# registers.)
native routed_down for metal from "metal/routed_down.metal":
    static (H, K, F)
    where K <= 32 and ceil_div(F, 32 * LANES) * ROWS <= 8
    launch routed_down:
        params (code ROWS in [2, 1, 4, 8], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(H, ROWS * 32 / LANES), M, 1)
        threads_per_threadgroup (32 * K, 1, 1)

native routed_down for cuda from "cuda/routed_down.cu":
    static (H, K, F)
    where F % 64 == 0
    launch routed_down:
        params (code TPW in [1, 2], code arithmetic KSPLIT in [1, 2, 4])
        threadgroups (ceil_div(ceil_div(ceil_div(H, 16), TPW), 4 / KSPLIT), M, 1)
        threads_per_threadgroup (128, 1, 1)

native routed_down for vulkan from "vulkan/routed_down.comp":
    static (H, K, F)
    params (SIMDGROUPS in [2, 4, 8], ROWS in [1, 2, 4])
    launch routed_down:
        threadgroups (ceil_div(H, SIMDGROUPS * ROWS), M, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (256 + min(ceil_div(F, 32), 288) * 72)

native routed_down for cpu from "cpu/routed_down.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * K * ceil_div(F, 256) * 292)
    scratch staged bytes (M * K * F * 4)
    launch routed_down_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_down_rows:
        threadgroups (ceil_div(H, ROWS), M, 1)
        threads_per_threadgroup (1, 1, 1)

# Prefill, up-only experts: the `routed_experts` GEMMs with one expanding
# weight (Metal TILE_M x TILE_N simdgroup-matrix tiles; CUDA 32 x 128
# mma.sync tiles; Vulkan the Metal form; CPU ROWS features per work item).
native routed_experts_up for metal from "metal/routed_experts_up.metal":
    static (H, F)
    params (TILE_M in [32, 64], TILE_N in [128, 64])
    scratch product bytes (B * T * F * 2)
    launch routed_experts_up_expand:
        threadgroups (ceil_div(F, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch routed_experts_up_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

native routed_experts_up for cuda from "cuda/routed_experts_up.cu":
    static (H, F)
    params (code arithmetic OPERAND in [0, 1])
    where H % 64 == 0 and F % 64 == 0
    scratch staged bytes (M * H * 2) when OPERAND == 1
    scratch product bytes (B * T * F * 2)
    launch routed_experts_up_stage when OPERAND == 1:
        reads (OPERAND)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch routed_experts_up_expand:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(T, 32), B)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 10240) + 4096)
    launch routed_experts_up_down:
        reads (OPERAND)
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(T, 32), B)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (32 * 144 + 10240) + 4096)

native routed_experts_up for vulkan from "vulkan/routed_experts_up.comp":
    static (H, F)
    params (TILE_M in [32, 64], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64])
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch product bytes (B * T * F * 2)
    launch routed_experts_up_expand:
        threadgroups (ceil_div(F, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch routed_experts_up_down:
        threadgroups (ceil_div(H, TILE_N), B * ceil_div(T, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

native routed_experts_up for cpu from "cpu/routed_experts_up.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(H, 256) * 292)
    scratch product_q8 bytes (B * T * ceil_div(F, 256) * 292)
    scratch staged bytes (M * H * 4)
    scratch product bytes (B * T * F * 4)
    launch routed_experts_up_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_up_expand:
        threadgroups (ceil_div(F, ROWS), B, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_up_quantize when INT8 == 1:
        threadgroups (B * T, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch routed_experts_up_down:
        threadgroups (ceil_div(H, ROWS), B, 1)
        threads_per_threadgroup (1, 1, 1)

# Prefill output. Metal and Vulkan: a thread owns 8 consecutive columns of a
# row (one 16-byte gather per choice). CUDA: a thread per column. CPU: a work
# item per row.
native routed_scatter for metal from "metal/routed_scatter.metal":
    launch routed_scatter:
        threadgroups (ceil_div(H, 2048), M, 1)
        threads_per_threadgroup (256, 1, 1)

native routed_scatter for cuda from "cuda/routed_scatter.cu":
    launch routed_scatter:
        threadgroups (ceil_div(H, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

native routed_scatter for vulkan from "vulkan/routed_scatter.comp":
    launch routed_scatter:
        threadgroups (ceil_div(H, 2048), M, 1)
        threads_per_threadgroup (256, 1, 1)

native routed_scatter for cpu from "cpu/routed_scatter.rs":
    launch routed_scatter:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 8)

# ---------------------------------------------------------------------------
# Expert streaming: a decode class's choices through a bank of S < E slots
# (specs/26-10-11/expert-streaming.md 4.6).
#
# `slot_map[e]` is the slot holding expert e, or -1; the host writes it.
# `stamps[s]` is the step sequence that last read slot s; the host reads it
# to choose victims. `step[0]` is this step's sequence.
#
# `control` is the layer's request region, in system-coherent memory:
#   [0] request sequence (device), [1] acknowledged sequence (host),
#   [2] failure (host), [3] choice count, [4..4 + M * K) routed experts.
#
# Routing order, grouping and combining keep the expert index; only weight
# addresses use the slot.

# Steps 1 and 2 (4.6, 4.7): `routed_route_shared`'s routing, then
#   - resolve: `slots`, the slot of every choice, -1 for an absent one, and
#     the stamp of every slot read. When any choice is absent the native
#     implementation publishes the request (it does not wait); the reference
#     has no host and only looks up.
#   - the prefetch hints of the first `ahead` of the two layers ahead (near,
#     one layer on; far, two): layer j's experts predicted from this layer's
#     residual through layer j's own norm and router, the K largest logits
#     per row (ties to the higher expert), `rms_norm(r_l) ⊙ g_j · R_j`. Each
#     predicted expert absent from layer j's slot map is published once, in
#     row then rank order, to this layer's ring for that distance, which the
#     host reads while the step runs:
#       [0] step sequence, [1] count, [2..2 + count) experts.
#     The tensors of a distance past `ahead` are not read. A hint never
#     changes a bank, a slot map or an output (rule 7).
# BANK is the bank's slots, C the request region's words, RING a ring's.
fn routed_route_streamed[M, H, PT, NM, E, K, S, BANK, C, RING](residual: &tensor[M, PT * H] f32,
    norm: &tensor[NM] NW, router: &tensor[E, H] RW, shared_router: &tensor[H] f32,
    shared_gate: &tensor[S, H] SGW, shared_up: &tensor[S, H] SUW,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, K] f32,
    slot_map: &tensor[E] i32, stamps: &mut tensor[BANK] i32, step: &tensor[1] i32,
    control: &mut tensor[C] i32,
    near_norm: &tensor[NM] NW, near_router: &tensor[E, H] RW, near_map: &tensor[E] i32,
    far_norm: &tensor[NM] NW, far_router: &tensor[E, H] RW, far_map: &tensor[E] i32,
    near_ring: &mut tensor[RING] i32, far_ring: &mut tensor[RING] i32,
    eps: f32, normalize: i32, ahead: i32)
    -> (tensor[M, H] A, tensor[M] f32, tensor[M, S] A, tensor[M, K] i32)
    where NM >= 0 and ((NM == H and PT == 1) or (NM == 0 and PT >= 1)):
    let mut normalized = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    let mut coefficient = tensor[M] f32
    let mut shared_product = tensor[M, S] A
    let mut slots = tensor[M, K] i32
    form_input(residual, norm, normalized, eps)
    linear(normalized, router, logits)
    for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let mut probabilities = exp(values - maximum)
        let total = reduce(probabilities, 0, sum)
        probabilities = probabilities / total
        for rank in 0..K:
            let best = reduce(probabilities, 0, max)
            let mut candidates = tensor[E] i32
            for expert in 0..E:
                candidates[expert] = -1
                if probabilities[expert] == best:
                    candidates[expert] = i32(expert)
            let winner = reduce(i32(candidates), 0, max)
            routes[row, K - 1 - rank] = winner
            scores[row, K - 1 - rank] = best
            # Only a selected expert is excluded from the next rank.
            for expert in 0..E:
                if i32(expert) == winner:
                    probabilities[expert] = -inf
        if normalize != 0:
            let denominator = reduce(f32(scores[row]), 0, sum)
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] / denominator
        let shared_logit = reduce(f32(normalized[row]) * f32(shared_router), 0, sum)
        coefficient[row] = 1.0 / (1.0 + exp(-shared_logit))
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(f32(normalized[row, source]), f32(shared_gate[feature, source]), gate)
                up = fma(f32(normalized[row, source]), f32(shared_up[feature, source]), up)
            shared_product[row, feature] = (gate / (1.0 + exp(-gate))) * up
    for row in 0..M:
        for choice in 0..K:
            let slot = slot_map[routes[row, choice]]
            slots[row, choice] = slot
            if slot >= 0:
                stamps[slot] = step[0]

    if ahead >= 1:
        let mut near_input = tensor[M, H] A
        let mut near_logits = tensor[M, E] f32
        let mut near_routes = tensor[M, K] i32
        form_input(residual, near_norm, near_input, eps)
        linear(near_input, near_router, near_logits)
        for row in 0..M:
            let mut values = f32(near_logits[row])
            for rank in 0..K:
                let best = reduce(values, 0, max)
                let mut candidates = tensor[E] i32
                for expert in 0..E:
                    candidates[expert] = -1
                    if values[expert] == best:
                        candidates[expert] = i32(expert)
                let winner = reduce(i32(candidates), 0, max)
                near_routes[row, rank] = winner
                for expert in 0..E:
                    if i32(expert) == winner:
                        values[expert] = -inf
        let mut count = 0
        for row in 0..M:
            for rank in 0..K:
                let expert = near_routes[row, rank]
                if near_map[expert] < 0:
                    let mut seen = 0
                    for earlier_row in 0..M:
                        for earlier_rank in 0..K:
                            if earlier_row * K + earlier_rank < row * K + rank:
                                if near_routes[earlier_row, earlier_rank] == expert:
                                    seen = 1
                    if seen == 0:
                        near_ring[2 + count] = expert
                        count = count + 1
        if RING >= 2:
            near_ring[1] = count
            near_ring[0] = step[0]

    if ahead >= 2:
        let mut far_input = tensor[M, H] A
        let mut far_logits = tensor[M, E] f32
        let mut far_routes = tensor[M, K] i32
        form_input(residual, far_norm, far_input, eps)
        linear(far_input, far_router, far_logits)
        for row in 0..M:
            let mut values = f32(far_logits[row])
            for rank in 0..K:
                let best = reduce(values, 0, max)
                let mut candidates = tensor[E] i32
                for expert in 0..E:
                    candidates[expert] = -1
                    if values[expert] == best:
                        candidates[expert] = i32(expert)
                let winner = reduce(i32(candidates), 0, max)
                far_routes[row, rank] = winner
                for expert in 0..E:
                    if i32(expert) == winner:
                        values[expert] = -inf
        let mut count = 0
        for row in 0..M:
            for rank in 0..K:
                let expert = far_routes[row, rank]
                if far_map[expert] < 0:
                    let mut seen = 0
                    for earlier_row in 0..M:
                        for earlier_rank in 0..K:
                            if earlier_row * K + earlier_rank < row * K + rank:
                                if far_routes[earlier_row, earlier_rank] == expert:
                                    seen = 1
                    if seen == 0:
                        far_ring[2 + count] = expert
                        count = count + 1
        if RING >= 2:
            far_ring[1] = count
            far_ring[0] = step[0]
    return (normalized, coefficient, shared_product, slots)

# Metal (Qwen's decode rows): `routed_route_shared`'s threadgroups (the
# router GEMV, the shared-expert gate column, the shared expert's gate/up),
# their parameters pinned to the resident entry's so every routing bit is
# the same, then ceil_div(E, SIMDGROUPS) router threadgroups per distance
# ahead over the same normalized rows, with that layer's norm. Three groups
# of threadgroups arrive separately (`arrive::last`): the last router
# threadgroup selects, then resolves, publishing the request under
# system-scope fences when a choice is absent; the last of each distance
# selects its predictions and publishes the absent ones (one thread checks
# each choice's map entry), then, after one system-scope fence, the
# sequence. Stamps are system-coherent stores.
native routed_route_streamed for metal from "metal/routed_route_streamed.metal":
    static (H, PT, NM, E, K, S, BANK, C, RING)
    params (SIMDGROUPS in [8, 16, 4, 2], ROWS in [1, 2, 4], arithmetic LANES in [32, 16])
    where H % 32 == 0 and E % 32 == 0 and E <= 1024 and K <= 32 and C >= 4 + 8 * K and RING >= 2 + 8 * K
    scratch logits bytes (3 * M * (E + 1) * 4)
    scratch arrivals bytes (12) sync
    launch routed_route_streamed:
        threadgroups (ceil_div(E, SIMDGROUPS) + 1 + ceil_div(S, SIMDGROUPS * ROWS * 32 / LANES) + 2 * ceil_div(E, SIMDGROUPS), 1, 1)
        threads_per_threadgroup (32 * SIMDGROUPS, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)

# A scratch fill round's convert (4.9): the round's listed staging records
# into their scratch slots, by the registered GGUF -> resident conversion:
# `list[0]` is the step sequence the list was written for and `list[1]` the
# count n; record i < n is staging record list[2 + 2 i] into slot
# list[3 + 2 i]. A list written for another step converts nothing. A record
# below R is the pool's own; one at or past R is the conveyor's record r - R,
# a view of the bank records a prompt borrows (4.9). L bounds n: a round
# lists at most L records.
fn routed_convert_wide[R, C, L, S, N, K](source: &tensor[R, N, K] E,
    conveyor: &tensor[C, N, K] E,
    list: &tensor[2 + 2 * L] i32, step: &tensor[1] i32,
    destination: &mut tensor[S, N, K] U):
    if list[0] == step[0]:
        for record in 0..L:
            if record < list[1]:
                if list[2 + 2 * record] < R:
                    destination[list[3 + 2 * record], :, :] = repack[U = U](source[list[2 + 2 * record], :, :])
                else:
                    destination[list[3 + 2 * record], :, :] = repack[U = U](conveyor[list[2 + 2 * record] - R, :, :])

native routed_convert_wide for metal from "metal/routed_convert_wide.metal":
    launch routed_convert_wide:
        threadgroups (ceil_div(N, 32) * 2, L, 1)
        threads_per_threadgroup (256, 1, 1)

# Expert streaming, the step sequence (4.3): a bank-served step sets it to its
# own sequence, the host's count of the step (`sequence`, a word the host
# wrote before submitting the step), before any of its entries read it. A
# step sets it at its first streamed layer; a scratch-served step at each of
# its streamed layers, since a layer-major prompt group interleaves its
# chunks' layers on the device.
fn routed_step(step: &mut tensor[1] i32, sequence: &tensor[1] i32):
    step[0] = sequence[0]

native routed_step for metal from "metal/routed_step.metal":
    launch routed_step:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (32, 1, 1)

# ---------------------------------------------------------------------------
# Expert streaming, a scratch-served step (4.9): the launch's experts fill the
# layer's scratch bank, slot e holding expert e, in parked rounds. `flags[e]`
# is 1 when the launch routes to expert e. The layer's scratch request region
# (every layer of a step requests under the step's one sequence, so each has
# its own):
#   [0] request sequence (device), [1] layer (device), [2] failure (host),
#   [3] reserved, then each round's acknowledgement (host) and each round's
#   arrival (device), at word indices the graph passes to
#   `routed_scratch_wait`.

# The routed experts' flags, then the layer, then the step's sequence. It
# does not wait.
fn routed_scratch_request[M, K, E, C](routes: &tensor[M, K] i32,
    step: &tensor[1] i32, flags: &mut tensor[E] i32, control: &mut tensor[C] i32,
    layer: i32):
    for expert in 0..E:
        flags[expert] = 0
    for row in 0..M:
        for choice in 0..K:
            flags[routes[row, choice]] = 1
    if C >= 4:
        control[1] = layer
        control[0] = step[0]

# Metal: one threadgroup; the flags cleared, then set by every choice, then
# the layer and the sequence, under system-scope fences.
native routed_scratch_request for metal from "metal/routed_scratch_request.metal":
    static (K, E, C)
    where E <= 1024 and C >= 4
    launch routed_scratch_request:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1024, 1, 1)

# One round's park: publishes the step's sequence at word `arrival`, then
# waits for it at word `acknowledgement` or the failure word (the host
# enforces the one-second bound). The reference has no host and only
# arrives.
fn routed_scratch_wait[C](step: &tensor[1] i32, control: &mut tensor[C] i32,
    heartbeat: &tensor[1] i32, acknowledgement: i32, arrival: i32):
    if arrival >= 0:
        if arrival < C:
            control[arrival] = step[0]

native routed_scratch_wait for metal from "metal/routed_scratch_wait.metal":
    static (C)
    launch routed_scratch_wait:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (32, 1, 1)

# Steps 2 to 5 (4.6): a streamed layer's absent experts, between its route
# and the resident `routed_gate_up` and `routed_output`, which then compute
# every choice from the bank slot `bound` names. `slots` is the route's
# resolve: a hit's slot, or -1 for a choice the route requested.
# `control` is the layer's request region (`routed_route_streamed`); for a
# requested choice c of the decode rows' P, `placement[0, c]` is its slot,
# `placement[1 + kind, c]` its staging record per routed tensor (gate, up,
# down; -1 when the slot already holds the expert) and `placement[4, c]` its
# acknowledgement, which the host writes after the placement. A choice with
# staging records is converted into its slot by the registered GGUF ->
# resident conversion, the slot stamped with the step, and, when the request
# was acknowledged for this step and did not fail, committed: the expert's
# map entry names the slot and `commits[slot]` the step.
fn routed_bank_fill[M, H, K, F, BANK, T, X, C, P](slots: &tensor[M, K] i32,
    stamps: &mut tensor[BANK] i32, step: &tensor[1] i32, control: &mut tensor[C] i32,
    placement: &tensor[5, P] i32, heartbeat: &tensor[1] i32,
    staged_gate: &tensor[T, F, H] SG, staged_up: &tensor[T, F, H] SU,
    staged_down: &tensor[T, H, F] SD, expert_gate: &mut tensor[BANK, F, H] EGW,
    expert_up: &mut tensor[BANK, F, H] EUW, expert_down: &mut tensor[BANK, H, F] EDW,
    slot_map: &mut tensor[X] i32, commits: &mut tensor[BANK] i32) -> tensor[M, K] i32
    where C >= 4 and P > 0:
    let mut bound = tensor[M, K] i32
    for row in 0..M:
        for choice in 0..K:
            let c = row * K + choice
            bound[row, choice] = slots[row, choice]
            if slots[row, choice] < 0 and c < P:
                let slot = placement[0, c]
                bound[row, choice] = slot
                if placement[1, c] >= 0:
                    expert_gate[slot, :, :] = repack[U = EGW](staged_gate[placement[1, c], :, :])
                    expert_up[slot, :, :] = repack[U = EUW](staged_up[placement[2, c], :, :])
                    expert_down[slot, :, :] = repack[U = EDW](staged_down[placement[3, c], :, :])
                    stamps[slot] = step[0]
                    if control[0] == step[0] and control[1] == step[0] and control[2] != step[0] and 4 + c < C:
                        let expert = control[4 + c]
                        if expert >= 0 and expert < X:
                            slot_map[expert] = slot
                            commits[slot] = step[0]
    return bound

# Metal: threadgroup row y is choice y; a hit binds its slot and returns,
# so a step that requested nothing costs one small launch. A requested
# choice's 32 threadgroups wait for its acknowledgement (one thread, under
# system-scope fences, watching the heartbeat); only the first requested
# choice of each placed expert converts it, its threadgroups striding over
# the gate, up and down records' items by windows (`lib/streaming/window.h`).
# After a failure a requested choice binds slot 0, keeping later addresses in
# bounds; the host fails the step (rule 6). The commit waits for the request's
# acknowledgement and publishes under system-scope fences.
native routed_bank_fill for metal from "metal/routed_bank_fill.metal":
    static (H, K, F, T, C, P)
    where K <= 32 and C >= 4 + 8 * K and P >= 8 * K
    launch routed_bank_fill:
        threadgroups (32, M * K, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (16384)

# Listed records of `source` into `destination`, byte for byte: `list[0]`
# is the step sequence the list was written for and `list[1]` the count n;
# entry i < n copies source record list[2 + 2 i] to destination record
# list[3 + 2 i]. A list written for another step copies nothing. A scratch
# fill copies its bank hits into the scratch bank, and seeds the bank with the
# experts it converted by copying them from the scratch bank into the bank
# slots placed for them.
fn routed_copy[S, D, E, N, K](source: &tensor[S, N, K] U, list: &tensor[2 + 2 * E] i32,
    step: &tensor[1] i32, destination: &mut tensor[D, N, K] U):
    if list[0] == step[0]:
        for entry in 0..E:
            if entry < list[1]:
                destination[list[3 + 2 * entry], :, :] = source[list[2 + 2 * entry], :, :]

# Metal: 8 threadgroup rows stride over the list entries; 64 threadgroups
# of 256 threads stride over each matrix's bytes in 16-byte vectors.
native routed_copy for metal from "metal/routed_copy.metal":
    launch routed_copy:
        threadgroups (64, 8, 1)
        threads_per_threadgroup (256, 1, 1)

# A scratch fill's seeding (spec 4.9): once `routed_copy` placed the experts
# it converted for the launch into their bank slots, each listed (expert,
# slot) pair's slot is stamped with the step and, when the step has not
# failed (`control` is the layer's scratch request region), committed: the
# expert's map entry names the slot and `commits[slot]` the step. The bank
# then holds what the prompt read, as a decode step's fill leaves it.
fn routed_seed_commit[E, X, BANK, C](list: &tensor[2 + 2 * E] i32, step: &tensor[1] i32,
    control: &tensor[C] i32, slot_map: &mut tensor[X] i32, stamps: &mut tensor[BANK] i32,
    commits: &mut tensor[BANK] i32)
    where C >= 4:
    if list[0] == step[0] and control[2] != step[0]:
        for entry in 0..E:
            if entry < list[1]:
                let expert = list[2 + 2 * entry]
                let slot = list[3 + 2 * entry]
                if expert >= 0 and expert < X and slot >= 0 and slot < BANK:
                    stamps[slot] = step[0]
                    slot_map[expert] = slot
                    commits[slot] = step[0]

# Metal: one threadgroup strides over the list, publishing every map entry
# under a system-scope fence before any commit.
native routed_seed_commit for metal from "metal/routed_seed_commit.metal":
    launch routed_seed_commit:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (256, 1, 1)
