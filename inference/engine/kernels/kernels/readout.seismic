    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (O * ceil_div(D, 256) * 292)
    scratch normalized bytes (O * D * 4)
    launch readout_selected_rows_normalize:
