    launch readout_selected_rows_gemv when O < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(Sv, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(D, 32) * (min(O, 2) + 2 * min(O / 3, 1) + 4 * min(O / 5, 1)), 448) * 64)
    launch readout_selected_rows_batch when O >= BATCH_FROM and O <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div(Sv, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch readout_selected_rows_gemm when O > 16:
        params (code TILE_M in [64, 128, 32], code TILE_N in [64, 128])
        threadgroups (ceil_div(Sv, TILE_N), ceil_div(O, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

# CUDA: `stage` writes the final RMS rows as A to scratch; `logits` (one
