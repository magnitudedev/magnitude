# Packed target readout. Every entry reads the `out_rows` rows of the final
# hidden rows directly, so a mixed launch never publishes state-only rows and
# no identity copy or gather precedes the readout. Features, logits and
# selected-vocabulary logits are separate entries: feature-only work never
# touches the vocabulary projection.
#
# The head and selected-vocabulary entries are K1 projections (see
# `dense.seismic` for the projection library's launches and parameters on
# each backend).

# The features of the `out_rows` rows. Its rows are read through a
# `[M, PT, D]` view of the `[M, PT * D]` input (as the progressive levels'
# are): no other input carries D linearly.
fn readout_features_rows[M, O, D, PT, NM](hidden: &tensor[M, PT, D] f32,
    norm: &tensor[NM] NW, out_rows: &tensor[O] i32,
    epsilon: f32) -> tensor[O, D] A where NM >= 0 and ((NM == D and PT == 1) or (NM == 0 and PT >= 1)):
    let mut selected = tensor[O, PT * D] f32
    let mut features = tensor[O, D] A
    parallel for row in 0..O:
        parallel for part in 0..PT:
            parallel for col in 0..D:
                selected[row, part * D + col] = hidden[out_rows[row], part, col]
    form_input(selected, norm, features, epsilon)
    return features

native readout_features_rows for metal from "metal/readout_features_rows.metal":
    static (D, PT, NM)
    launch readout_features_rows:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native readout_features_rows for cuda from "cuda/readout_features_rows.cu":
    static (D, PT, NM)
    launch readout_features_rows:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native readout_features_rows for vulkan from "vulkan/readout_features_rows.comp":
    static (D, PT, NM)
    launch readout_features_rows:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)

# CPU: one work item per output row.
native readout_features_rows for cpu from "cpu/readout_features_rows.rs":
    launch readout_features_rows:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (D * 8 + PT * D * 4)


# The head (K1 projection): final RMS prologue over the `out_rows` rows, then
# the vocabulary projection into F32 logits. The weight's second-level scale
# (`weight_scale`, `functions.seismic`'s `scale_rows` port; WS = 0 without
# one) scales the F32 projection first. With `softcap` > 0 each logit is
# capped in F32 from the projection, softcap * tanh(z / softcap), written
# through the sigmoid identity tanh(y) = 2 / (1 + exp(-2y)) - 1 (no tanh
# primitive); 0 publishes the projection unchanged.
fn readout_head_rows[M, O, V, D, PT, NM, WS](hidden: &tensor[M, PT * D] f32,
    norm: &tensor[NM] NW, weight: &tensor[V, D] OW,
    out_rows: &tensor[O] i32, epsilon: f32, softcap: f32,
    weight_scale: &tensor[WS] f32) -> tensor[O, V] f32
    where WS >= 0 and WS <= 1 and NM >= 0 and ((NM == D and PT == 1) or (NM == 0 and PT >= 1)):
    let mut selected = tensor[O, PT * D] f32
    let mut features = tensor[O, D] A
    let mut sums = tensor[O, V] f32
    let mut logits = tensor[O, V] f32
    parallel for row in 0..O:
        parallel for col in 0..PT * D:
            selected[row, col] = hidden[out_rows[row], col]
    form_input(selected, norm, features, epsilon)
    linear(features, weight, sums)
    scale_rows(sums, weight_scale, logits)
    parallel for row in 0..O:
        parallel for col in 0..V:
            logits[row, col] = cap_logit(logits[row, col], softcap)
    return logits

# Metal: the `dense` projection (`dense.seismic`), single, over the
# selected rows under the norm prologue: the GEMV row classes apply it as
# they stage, and from VERIFY_ROWS rows `stage` normalizes once into
# `normalized`, which every other form reads.
native readout_head_rows for metal from "metal/readout_head_rows.metal":
    static (V, D, PT, NM, WS)
    where WS <= 1
    project dense single (weight)
    scratch normalized bytes (O * D * 2) when O > VERIFY_ROWS
    launch readout_head_rows_stage before batch when O > VERIFY_ROWS:
        staging
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: the `dense` projection (`dense.seismic`), single, over the rows under
# the norm prologue: at O = 1 the GEMV block forms its normalized row in
# shared memory, else `stage` forms the rows.
native readout_head_rows for cuda from "cuda/readout_head_rows.cu":
    static (V, D, PT, NM, WS)
    where WS <= 1
    project dense single (weight) rows rms
    restate arithmetic SPLIT in [1, 2] default 1

# Vulkan: the `dense` projection (single) over the normalized rows. The
# vocabulary GEMV grid must stay within the 65535-group floor.
native readout_head_rows for vulkan from "vulkan/readout_head_rows.comp":
    static (V, D, PT, NM, WS)
    where ceil_div(V, SIMDGROUPS * ROWS * 32 / LANES) <= 65535 and WS <= 1
    project dense single (weight) rows rms

# CPU: the CPU projection library (`cpu/lib/projection/projection.rs`). The
# normalized hidden rows are the projection's operand, formed by the
# operator's `form` launch; the row launch gives each work item ROWS
# vocabulary weight rows, projected against every operand row.
native readout_head_rows for cpu from "cpu/readout_head_rows.rs":
    static (WS)
    where WS <= 1
    project quantized tiled (OW) over (O, D) operand (hidden at (out_rows) normed (norm, epsilon))
    launch readout_head_rows_rows:
        threadgroups (ceil_div(V, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)


# The head projection restricted to the `selected` vocabulary rows, with the
# head's softcap (`readout_head_rows`).
fn readout_selected_rows[M, O, V, D, PT, NM, Sv](hidden: &tensor[M, PT * D] f32,
    norm: &tensor[NM] NW, weight: &tensor[V, D] OW,
    out_rows: &tensor[O] i32, selected: &tensor[Sv] i32,
    epsilon: f32, softcap: f32) -> tensor[O, Sv] f32
    where NM >= 0 and ((NM == D and PT == 1) or (NM == 0 and PT >= 1)):
    let mut demanded = tensor[O, PT * D] f32
    let mut features = tensor[O, D] A
    let mut logits = tensor[O, Sv] f32
    parallel for row in 0..O:
        parallel for col in 0..PT * D:
            demanded[row, col] = hidden[out_rows[row], col]
    form_input(demanded, norm, features, epsilon)
    let mut rows = tensor[O, D] A
    operand_rows(features, operands(weight), rows)
    parallel for row in 0..O:
        parallel for col in 0..Sv:
            let acc = matmul(
                rows[row : row + 1],
                f32(weight[selected[col] : selected[col] + 1]),
                zeros_like(logits[row : row + 1, col : col + 1], dtype=f32),
            )
            logits[row, col] = acc[0, 0]
    parallel for row in 0..O:
        parallel for col in 0..Sv:
            logits[row, col] = cap_logit(logits[row, col], softcap)
    return logits

# Metal: the `dense` projection (`dense.seismic`), single, over the selected
# rows under the norm prologue, the weight rows gathered by `selected` (as
# `readout_head_rows`, with one tile mapping for every GEMV row count; the
# forms that stage or code whole weight rows, which a gather does not serve,
# the projection admits for no gathered entry). From
# VERIFY_ROWS rows `stage` normalizes once into `normalized`, which every
# other form reads. (CUDA: a custom per-vocabulary-row kernel.)
native readout_selected_rows for metal from "metal/readout_selected_rows.metal":
    static (V, D, PT, NM)
    project dense single (weight) gathered selected
    restate single_gemv
    scratch normalized bytes (O * D * 2) when O > VERIFY_ROWS
    launch readout_selected_rows_stage before batch when O > VERIFY_ROWS:
        staging
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: `stage` writes the final RMS rows as A to scratch; `logits` (one
# block per selected vocabulary row) decodes that weight row once per feature
# row (mma16 lane chunks) and sums the products in a fixed thread order.
# (Metal: the K1 projection.)
native readout_selected_rows for cuda from "cuda/readout_selected_rows.cu":
    static (V, D, PT, NM)
    where D % 64 == 0
    scratch features bytes (O * D * 2)
    launch readout_selected_rows_stage:
        staging
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch readout_selected_rows_logits:
        threadgroups (Sv, 1, 1)
        threads_per_threadgroup (128, 1, 1)

# Vulkan: the `dense` projection over the selected rows (as
# `readout_head_rows`).
native readout_selected_rows for vulkan from "vulkan/readout_selected_rows.comp":
    static (V, D, PT, NM)
    project dense single (weight) gathered selected rows rms

# CPU: as `readout_head_rows`, each work item owning ROWS selected vocabulary
# rows (not adjacent: each row against every output row in its own call).
native readout_selected_rows for cpu from "cpu/readout_selected_rows.rs":
    project quantized tiled (OW) over (O, D) operand (hidden at (out_rows) normed (norm, epsilon))
    launch readout_selected_rows_rows:
        threadgroups (ceil_div(Sv, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Progressive head readout. The head is stored once in significance-ordered
# bit planes of its Q8_0 codes, offset to `u = c + 128` (value `s · (u − 128)`,
# `s` the f16 scale of each 32 values):
#   top[v, w]       bits 7..4 of codes 8w..8w+7, code 8w + i in bits 4i..4i+3;
#   bit3[v, g]      bit 3 of codes 32g..32g+31, code 32g + 8q + e in bit 4e + q;
#   rest[v, g, j]   bit 2 − j of the same codes, placed as in bit3;
#   scales[v, g]    the f16 scale of codes 32g..32g+31.
# (A plane word shifted right by q and masked to 0x11111111 holds the bits of
# codes 32g + 8q..8q+7 in the nibbles `top` holds their high bits in.)
# A view of the top b bits takes each code's missing low bits at their
# midpoint: the 4-bit view is `s · (16·H − 120.5)`, the 5-bit view
# `s · (16·H + 8·b3 − 124.5)`. `radius[v, 0]` and `radius[v, 1]` bound
# |exact − view| of row v per unit length of the normalized row, F32 rounding
# of both products included.
#
# A certified selection runs the views in turn. A selection row scores a
# vocabulary row as `logit / temperature + noise` (`gumbel_rows`: the
# sampler's own noise, zero for greedy rows); a row competes when its row is
# unconstrained or its mask bit is set. Each level bounds every surviving
# score, keeps the rows whose upper bound reaches the row's threshold (the
# largest lower bound so far), and hands them to the next view; the last level
# is exact. Every row whose exact score can be the largest survives every
# level, so sampling the exact level's logits (−inf elsewhere) draws what
# sampling the full readout draws.

# The sampler's Gumbel noise of every (row, token): Philox4x32-10 on counter
# (token, draws[3], draws[4], draws[5]) and key (draws[1], draws[2]),
# `−log(−log u)` with `u = ((x >> 9) + 0.5) · 2⁻²³`; zero where draws[0] != 1
# (`sample_rows`).
fn gumbel_rows[O, V](draws: &tensor[O, 6] u32, noise: &mut tensor[O, V] f32):
    parallel for row in 0..O:
        parallel for token in 0..V:
            let mut value = f32(0.0)
            if draws[row, 0] == 1:
                let mut c0 = u32(token)
                let mut c1 = draws[row, 3]
                let mut c2 = draws[row, 4]
                let mut c3 = draws[row, 5]
                let mut k0 = draws[row, 1]
                let mut k1 = draws[row, 2]
                for round in 0..10:
                    let a0 = u32(3528531795)
                    let a1 = u32(3449720151)
                    let p00 = (a0 & 65535) * (c0 & 65535)
                    let p01 = (a0 >> 16) * (c0 & 65535)
                    let p02 = (a0 & 65535) * (c0 >> 16)
                    let p03 = (a0 >> 16) * (c0 >> 16)
                    let middle0 = (p00 >> 16) + (p01 & 65535) + (p02 & 65535)
                    let hi0 = p03 + (p01 >> 16) + (p02 >> 16) + (middle0 >> 16)
                    let lo0 = (middle0 << 16) | (p00 & 65535)
                    let p10 = (a1 & 65535) * (c2 & 65535)
                    let p11 = (a1 >> 16) * (c2 & 65535)
                    let p12 = (a1 & 65535) * (c2 >> 16)
                    let p13 = (a1 >> 16) * (c2 >> 16)
                    let middle1 = (p10 >> 16) + (p11 & 65535) + (p12 & 65535)
                    let hi1 = p13 + (p11 >> 16) + (p12 >> 16) + (middle1 >> 16)
                    let lo1 = (middle1 << 16) | (p10 & 65535)
                    let next0 = hi1 ^ c1 ^ k0
                    let next2 = hi0 ^ c3 ^ k1
                    c0 = next0
                    c1 = lo1
                    c2 = next2
                    c3 = lo0
                    k0 = k0 + u32(2654435769)
                    k1 = k1 + u32(3144134277)
                let uniform = (f32(c0 >> 9) + 0.5) * 0.00000011920928955078125
                value = -log(-log(uniform))
            noise[row, token] = value

# The head rows of the view of the top `bits` bits (4, 5 or 8) as F32 values.
fn progressive_view[V, D, P](top: &tensor[V, (D + 31) / 32, P + 1] u32, bit3: &tensor[V, (D + 31) / 32] u32,
    rest: &tensor[V, (D + 31) / 32, P] u32, scales: &tensor[V, (D + 31) / 32] f16, bits: i32,
    view: &mut tensor[V, D] f32) where D % 32 == 0 and P >= 1 and P <= 3 and P % 2 == 1:
    parallel for v in 0..V:
        parallel for k in 0..D:
            let shift = u32(4 * (k % 8) + (k % 32) / 8)
            let coarse_bits = P + 1
            let missing_scale = u32(1) << u32(coarse_bits)
            let mut high = u32(0)
            if P == 1:
                high = (top[v, k / 32, (k % 32) / 16] >> u32(2 * (k % 16))) & 3
            if P == 3:
                high = (top[v, k / 32, (k % 32) / 8] >> u32(4 * (k % 8))) & 15
            let mut code = f32(high * missing_scale) + f32(missing_scale - 1) * 0.5
            if bits >= i32(P + 2):
                code = code - f32(u32(1) << u32(P - 1)) + f32((bit3[v, k / 32] >> shift) & 1) * f32(u32(1) << u32(P))
            if bits == i32(2 * (P + 1)):
                let mut low = u32(0)
                for plane in 0..P:
                    low = low | (((rest[v, k / 32, plane] >> shift) & 1) << u32(P - 1 - plane))
                code = code - f32((u32(1) << u32(P)) - 1) * 0.5 + f32(low)
            view[v, k] = f32(scales[v, k / 32]) * (code - f32(u32(1) << u32(2 * P + 1)))

# One certified level: each competing row's score bounds from its `view`
# logits and `radius`, the rows whose upper bound reaches the threshold (the
# largest of `floor` and the lower bounds), and their logits; −inf elsewhere.
fn certify_level[O, V](view: &tensor[O, V] f32, radius: &tensor[V] f32, length: &tensor[O] f32,
    temperature: &tensor[O] f32, noise: &tensor[O, V] f32, mask: &tensor[O, (V + 31) / 32] u32,
    constrained: &tensor[O] i32, floor: &tensor[O] f32, kept: &mut tensor[O, V] f32,
    threshold: &mut tensor[O] f32, softcap: f32):
    for row in 0..O:
        let mut lowest = tensor[V] f32
        for token in 0..V:
            let competes = (constrained[row] == 0 or ((mask[row, token / 32] >> u32(token % 32)) & 1) != 0) and view[row, token] > -inf
            lowest[token] = -inf
            if competes:
                lowest[token] = cap_logit(view[row, token] - radius[token] * length[row], softcap) / temperature[row] + noise[row, token]
        threshold[row] = max(floor[row], reduce(lowest, 0, max))
        if length[row] == inf or length[row] != length[row]:
            threshold[row] = -inf
        for token in 0..V:
            let competes = (constrained[row] == 0 or ((mask[row, token / 32] >> u32(token % 32)) & 1) != 0) and view[row, token] > -inf
            kept[row, token] = -inf
            if competes and cap_logit(view[row, token] + radius[token] * length[row], softcap) / temperature[row] + noise[row, token] >= threshold[row]:
                kept[row, token] = view[row, token]

# Level one: the final norm of the `out_rows` rows (`features`, in A, and their
# Euclidean lengths), their 4-bit-view logits of every vocabulary row, and
# each row's threshold. `temperature` divides scores (1 for greedy rows). A
# selection is of at most 8 rows.
# Its rows are read through a `[M, PT, D]` view of the `[M, PT * D]` input
# (as `readout_planes_rows`' are): no other input carries D linearly.
fn readout_top_rows[M, O, V, D, PT, NM, P](hidden: &tensor[M, PT, D] f32, norm: &tensor[NM] NW,
    top: &tensor[V, (D + 31) / 32, P + 1] u32, bit3: &tensor[V, (D + 31) / 32] u32, rest: &tensor[V, (D + 31) / 32, P] u32,
    scales: &tensor[V, (D + 31) / 32] f16, radius: &tensor[V, 2] f32, out_rows: &tensor[O] i32,
    draws: &tensor[O, 6] u32, temperature: &tensor[O] f32, mask: &tensor[O, (V + 31) / 32] u32,
    constrained: &tensor[O] i32, epsilon: f32, softcap: f32)
    -> (tensor[O, V] f32, tensor[O] f32, tensor[O, D] A, tensor[O] f32)
    where O <= 8 and D % 32 == 0 and P >= 1 and P <= 3 and P % 2 == 1 and NM >= 0 and ((NM == D and PT == 1) or (NM == 0 and PT >= 1)):
    let mut selected = tensor[O, PT * D] f32
    let mut features = tensor[O, D] A
    let mut view = tensor[V, D] f32
    let mut logits = tensor[O, V] f32
    let mut length = tensor[O] f32
    let mut noise = tensor[O, V] f32
    let mut floor = tensor[O] f32
    let mut radius4 = tensor[V] f32
    let mut kept = tensor[O, V] f32
    let mut threshold = tensor[O] f32
    parallel for row in 0..O:
        parallel for part in 0..PT:
            parallel for col in 0..D:
                selected[row, part * D + col] = hidden[out_rows[row], part, col]
    form_input(selected, norm, features, epsilon)
    progressive_view(top, bit3, rest, scales, i32(P + 1), view)
    linear(features, view, logits)
    for row in 0..O:
        let values = f32(features[row])
        length[row] = sqrt(reduce(values * values, 0, sum))
        floor[row] = -inf
    parallel for token in 0..V:
        radius4[token] = radius[token, 0]
    gumbel_rows(draws, noise)
    certify_level(logits, radius4, length, temperature, noise, mask, constrained, floor, kept, threshold, softcap)
    return (logits, threshold, features, length)

# Level two: the 5-bit-view logits of the rows level one keeps (`top`'s logits
# and threshold), −inf elsewhere, and the raised threshold.
fn readout_refine_rows[O, V, D, P](features: &tensor[O, D] A, top: &tensor[V, (D + 31) / 32, P + 1] u32,
    bit3: &tensor[V, (D + 31) / 32] u32, rest: &tensor[V, (D + 31) / 32, P] u32, scales: &tensor[V, (D + 31) / 32] f16,
    radius: &tensor[V, 2] f32, coarse: &tensor[O, V] f32, floor: &tensor[O] f32,
    length: &tensor[O] f32, draws: &tensor[O, 6] u32, temperature: &tensor[O] f32,
    mask: &tensor[O, (V + 31) / 32] u32, constrained: &tensor[O] i32, softcap: f32) -> (tensor[O, V] f32, tensor[O] f32) where D % 32 == 0 and P >= 1 and P <= 3 and P % 2 == 1:
    let mut noise = tensor[O, V] f32
    let mut radius4 = tensor[V] f32
    let mut radius5 = tensor[V] f32
    let mut survivors = tensor[O, V] f32
    let mut unused = tensor[O] f32
    let mut view = tensor[V, D] f32
    let mut finer = tensor[O, V] f32
    let mut kept = tensor[O, V] f32
    let mut threshold = tensor[O] f32
    parallel for token in 0..V:
        radius4[token] = radius[token, 0]
        radius5[token] = radius[token, 1]
    gumbel_rows(draws, noise)
    certify_level(coarse, radius4, length, temperature, noise, mask, constrained, floor, survivors, unused, softcap)
    progressive_view(top, bit3, rest, scales, i32(P + 2), view)
    linear(features, view, finer)
    parallel for row in 0..O:
        parallel for token in 0..V:
            if survivors[row, token] == -inf:
                finer[row, token] = -inf
    certify_level(finer, radius5, length, temperature, noise, mask, constrained, floor, kept, threshold, softcap)
    return (finer, threshold)

# Level three: the exact logits of the rows level two keeps (`refine`'s logits
# and threshold), −inf elsewhere: the selection's logits.
fn readout_exact_rows[O, V, D, P](features: &tensor[O, D] A, top: &tensor[V, (D + 31) / 32, P + 1] u32,
    bit3: &tensor[V, (D + 31) / 32] u32, rest: &tensor[V, (D + 31) / 32, P] u32, scales: &tensor[V, (D + 31) / 32] f16,
    radius: &tensor[V, 2] f32, fine: &tensor[O, V] f32, floor: &tensor[O] f32,
    length: &tensor[O] f32, draws: &tensor[O, 6] u32, temperature: &tensor[O] f32,
    mask: &tensor[O, (V + 31) / 32] u32, constrained: &tensor[O] i32, softcap: f32) -> tensor[O, V] f32 where D % 32 == 0 and P >= 1 and P <= 3 and P % 2 == 1:
    let mut noise = tensor[O, V] f32
    let mut radius5 = tensor[V] f32
    let mut survivors = tensor[O, V] f32
    let mut unused = tensor[O] f32
    let mut view = tensor[V, D] f32
    let mut logits = tensor[O, V] f32
    parallel for token in 0..V:
        radius5[token] = radius[token, 1]
    gumbel_rows(draws, noise)
    certify_level(fine, radius5, length, temperature, noise, mask, constrained, floor, survivors, unused, softcap)
    progressive_view(top, bit3, rest, scales, i32(2 * (P + 1)), view)
    linear(features, view, logits)
    parallel for row in 0..O:
        parallel for token in 0..V:
            if survivors[row, token] == -inf:
                logits[row, token] = -inf
            else:
                logits[row, token] = cap_logit(logits[row, token], softcap)
    return logits

# The exact head logits of the `out_rows` rows from the planes (the readout of
# rows that read every logit: `readout_head_rows` of the progressive head).
fn readout_planes_rows[M, O, V, D, PT, NM, P](hidden: &tensor[M, PT, D] f32, norm: &tensor[NM] NW,
    top: &tensor[V, (D + 31) / 32, P + 1] u32, bit3: &tensor[V, (D + 31) / 32] u32, rest: &tensor[V, (D + 31) / 32, P] u32,
    scales: &tensor[V, (D + 31) / 32] f16, out_rows: &tensor[O] i32, epsilon: f32, softcap: f32) -> tensor[O, V] f32
    where D % 32 == 0 and P >= 1 and P <= 3 and P % 2 == 1 and NM >= 0 and ((NM == D and PT == 1) or (NM == 0 and PT >= 1)):
    let mut selected = tensor[O, PT * D] f32
    let mut features = tensor[O, D] A
    let mut view = tensor[V, D] f32
    let mut logits = tensor[O, V] f32
    parallel for row in 0..O:
        parallel for part in 0..PT:
            parallel for col in 0..D:
                selected[row, part * D + col] = hidden[out_rows[row], part, col]
    form_input(selected, norm, features, epsilon)
    progressive_view(top, bit3, rest, scales, i32(2 * (P + 1)), view)
    linear(features, view, logits)
    parallel for row in 0..O:
        parallel for token in 0..V:
            logits[row, token] = cap_logit(logits[row, token], softcap)
    return logits

# Metal: the `dense` projection (`dense.seismic`), single, over the 4-bit
# view's packets, each threadgroup normalizing its rows in place, with the
# bound epilogue: each row's threshold rises over `bounds` (sync scratch:
# eight keys, then the arrival counter). Its forms are a plane set's (the
# projection's rule): the GEMV below VERIFY_ROWS rows and the batched rows
# above it; the entry keeps one tile mapping for every GEMV row count
# (SIMDGROUPS, ROWS and LANES entry-wide).
native readout_top_rows for metal from "metal/readout_top_rows.metal":
    static (V, D, PT, NM, P)
    project dense single (planes (top, bit3, rest, scales) over (V, D))
    restate batch arithmetic BATCH_PARTS in [2] default 2
    restate SIMDGROUPS in [16, 8, 4, 2, 32] default 16
    restate ROWS in [1, 2, 4] default 1
    restate arithmetic LANES in [16, 32] default 16
    scratch bounds bytes (36) sync

# Metal, O <= VERIFY_ROWS: one simdgroup per 32 vocabulary rows; only the survivors'
# bit-3 words are read.
native readout_refine_rows for metal from "metal/readout_refine_rows.metal":
    static (V, D, P)
    scratch bounds bytes (4 * (VERIFY_ROWS + 1)) sync
    launch readout_refine_rows_gather when O <= VERIFY_ROWS:
        params (SIMDGROUPS in [8, 4, 16] default 8)
        threadgroups (ceil_div(V, SIMDGROUPS * 32), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(O * D * 2, 16384))

# Metal, O <= VERIFY_ROWS: as `readout_refine_rows`, over every plane of the survivors.
native readout_exact_rows for metal from "metal/readout_exact_rows.metal":
    static (V, D, P)
    launch readout_exact_rows_gather when O <= VERIFY_ROWS:
        params (SIMDGROUPS in [8, 4, 16] default 8)
        threadgroups (ceil_div(V, SIMDGROUPS * 32), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(O * D * 2, 16384))

# Metal: the `dense` projection (`dense.seismic`), single, over the packets
# of the exact view: at the GEMV's rows the exact view's recipe, which the
# exact level's gather shares, so the full pass and a certified selection
# project a row alike bit for bit; each threadgroup normalizes its rows in
# place below 17 rows, and past 16 `stage` normalizes them once into
# `normalized`, which the staged tiles read. Batched from three rows: the
# GEMV assembles every code from its five planes once a row, so its cost
# grows with the rows, where the batched GEMV decodes each code once for all
# of them (`gemv_batch_quarters`). Its forms are a plane set's (the
# projection's rule): the batched rows to 16 rows and one unsplit GEMM past
# them; the entry keeps one tile mapping for every GEMV row count
# (SIMDGROUPS, ROWS and LANES entry-wide).
native readout_planes_rows for metal from "metal/readout_planes_rows.metal":
    static (V, D, PT, NM, P)
    project dense single (planes (top, bit3, rest, scales) over (V, D))
    restate batch arithmetic BATCH_PARTS in [2] default 2
    restate SIMDGROUPS in [16, 8, 4, 2, 32] default 16
    restate ROWS in [1, 2, 4] default 1
    restate arithmetic LANES in [16, 32] default 16
    scratch normalized bytes (O * D * 2) when O > 16
    launch readout_planes_rows_stage before gemm when O > 16:
        staging
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: the `dense` projection's `planes` form (`dense.seismic`), single,
# onto the 4-bit view, with the bound epilogue (as on Metal). The stage
# launch forms the rows into `features` with their lengths and their group
# sums (`groups`), which the view reads.
native readout_top_rows for cuda from "cuda/readout_top_rows.cu":
    static (V, D, PT, NM, P)
    project dense single (planes (top, bit3, rest, scales) over (V, D)) rows rms
    restate planes ROWS in [1, 2, 4] default 1
    scratch groups bytes (O * D / 8)
    scratch bounds bytes (36) sync

native readout_refine_rows for cuda from "cuda/readout_refine_rows.cu":
    static (V, D, P)
    scratch bounds bytes (4 * (VERIFY_ROWS + 1)) sync
    launch readout_refine_rows_gather when O <= VERIFY_ROWS:
        params (WARPS in [8, 4, 2] default 8)
        threadgroups (ceil_div(V, WARPS * 32), 1, 1)
        threads_per_threadgroup (WARPS * 32, 1, 1)

native readout_exact_rows for cuda from "cuda/readout_exact_rows.cu":
    static (V, D, P)
    launch readout_exact_rows_gather when O <= VERIFY_ROWS:
        params (WARPS in [8, 4, 2] default 8)
        threadgroups (ceil_div(V, WARPS * 32), 1, 1)
        threads_per_threadgroup (WARPS * 32, 1, 1)

# CUDA: the `dense` projection's `planes` form (`dense.seismic`), single,
# onto the exact codes, by the routine the exact level's gather shares.
native readout_planes_rows for cuda from "cuda/readout_planes_rows.cu":
    static (V, D, PT, NM, P)
    project dense single (planes (top, bit3, rest, scales) over (V, D)) rows rms
