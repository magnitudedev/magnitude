# CUDA implementations of the dense feed-forward entries (K1 projection
# family, `cuda/common/projection.cuh`) over the O `out_rows` rows.
#
# Every K1 CUDA entry runs the GEMV to 16 rows and the GEMM beyond, in two row
# bands. The GEMV is the 16-bit path (the A-rounded activation in bf16/f16
# MMAs against exact codes, rows independent of O, so each row matches O = 1
# bit for bit): `gemv` to 8 rows, `gemv16` (two 8-row column blocks) from 9 to
# 16; 8 warps per block in groups of KSPLIT that split K and reduce in part
# order. The small-band GEMM (`gemm_small`, 17 to 64 rows: 64-row block tiles,
# 3 cp.async stages) has two operand paths: the 16-bit path (weights
# dequantized to A) and the INT8 candidate (arithmetic INT8 = 1: activations
# quantized per 32 codes as q8_1 does, s8 MMAs); the tuner keeps INT8 only
# where it is faster within tolerance. The large-band GEMM (`gemm`, beyond 64
# rows: 128-row block tiles, 2 stages) is the 16-bit path; each stage's copies
# are issued by one of ROTATE rotating warp sets (the launch parameter ROTATE,
# tuned: its best value depends on the weight representation, and the
# arithmetic does not, so every value gives the same bits; likewise in the
# `gemm` launches of `attention`, `recurrent`, `readout` and `draft`). Entries
# with few output columns split either band over K up to 128 rows (grid z: 2
# shares of partials that `finalize` sums in part order). Measured on GB10 (17
# to 512 rows, both paths, split 1/2/4, tiles 32/64/128): up to 64 rows want
# the 64-row tiles, beyond them the 128-row ones, the few-column entries the
# split up to 128 rows. Staging launches form the rows a launch does not read in
# place: `stage` a normalized input's A rows (at O = 1 the GEMV block forms
# its row in its shared memory instead), `stage_s8` the INT8 candidate's q8_1
# rows plus (d, d * sum q) groups.

native dense_expand for cuda from "cuda/dense_expand.cu":
    static (H, F, GS, US)
    params (code arithmetic INT8 in [0, 1])
    where H % 64 == 0 and GS <= 1 and US <= 1
    scratch staged bytes (O * H * 2) when O > 1
    scratch groups bytes (O * H / 4) when INT8 == 1 and O > 16 and O <= 64
    launch dense_expand_stage when O > 1 and (O <= 16 or O > 64 or INT8 == 0):
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_expand_stage_s8 when INT8 == 1 and O > 16 and O <= 64:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_expand_gemv when O <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(F, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, O - 1)) * H * 2)
    launch dense_expand_gemv16 when O > 8 and O <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(F, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_expand_gemm_small when O > 16 and O <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div(F, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 2 * 10240) + 2 * 2048)
    launch dense_expand_gemm when O > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(O, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 2 * 10240) + 2 * 2048)

# `dense_expand`'s bands with one weight stream.
native dense_up for cuda from "cuda/dense_up.cu":
    static (H, F, US)
    params (code arithmetic INT8 in [0, 1])
    where H % 64 == 0 and US <= 1
    scratch staged bytes (O * H * 2) when O > 1
    scratch groups bytes (O * H / 4) when INT8 == 1 and O > 16 and O <= 64
    launch dense_up_stage when O > 1 and (O <= 16 or O > 64 or INT8 == 0):
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_up_stage_s8 when INT8 == 1 and O > 16 and O <= 64:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_up_gemv when O <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(F, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, O - 1)) * H * 2)
    launch dense_up_gemv16 when O > 8 and O <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(F, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_up_gemm_small when O > 16 and O <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div(F, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch dense_up_gemm when O > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div(F, 16), 8), ceil_div(O, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)

# `dense_expand`'s bands over two segments along x: u (the B and X streams
# paired) then C (one stream).
native short_conv_project for cuda from "cuda/short_conv_project.cu":
    static (H, CH, BS, CS, XS)
    params (code arithmetic INT8 in [0, 1])
    where H % 64 == 0 and BS <= 1 and CS <= 1 and XS <= 1
    scratch staged bytes (M * H * 2) when M > 1
    scratch groups bytes (M * H / 4) when INT8 == 1 and M > 16 and M <= 64
    launch short_conv_project_stage when M > 1 and (M <= 16 or M > 64 or INT8 == 0):
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch short_conv_project_stage_s8 when INT8 == 1 and M > 16 and M <= 64:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch short_conv_project_gemv when M <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(2 * ceil_div(CH, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, M - 1)) * H * 2)
    launch short_conv_project_gemv16 when M > 8 and M <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(2 * ceil_div(CH, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch short_conv_project_gemm_small when M > 16 and M <= 64:
        reads (INT8)
        threadgroups (2 * ceil_div(ceil_div(CH, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 2 * 10240) + 2 * 2048)
    launch short_conv_project_gemm when M > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (2 * ceil_div(ceil_div(CH, 16), 8), ceil_div(M, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 2 * 10240) + 2 * 2048)

# A stage launch rounds the hidden rows to A (`stage_s8` also forms the INT8
# candidate's q8_1 rows, for the rows whose GEMM reads them), then
# `project_rows`' bands over them.
native per_layer_gate for cuda from "cuda/per_layer_gate.cu":
    static (D, L, P, GS)
    params (code arithmetic INT8 in [0, 1])
    where D % 64 == 0 and GS <= 1
    scratch rounded bytes (M * D * 2)
    scratch staged bytes (M * D) when INT8 == 1 and M > 16 and M <= 64
    scratch groups bytes (M * D / 4) when INT8 == 1 and M > 16 and M <= 64
    launch per_layer_gate_stage when M <= 16 or M > 64 or INT8 == 0:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch per_layer_gate_stage_s8 when INT8 == 1 and M > 16 and M <= 64:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch per_layer_gate_gemv when M <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(P, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch per_layer_gate_gemv16 when M > 8 and M <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(P, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch per_layer_gate_gemm_small when M > 16 and M <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div(P, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch per_layer_gate_gemm when M > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div(P, 16), 8), ceil_div(M, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)

# `attention_output`'s bands (GEMV to 16 rows reading the rows in place, the
# INT8 candidate on the small GEMM, split-K to 128 rows) with a store
# epilogue in Y.
native project_rows for cuda from "cuda/project_rows.cu":
    static (K, N, WS)
    params (code arithmetic INT8 in [0, 1])
    where K % 64 == 0 and WS <= 1
    scratch staged bytes (M * K) when INT8 == 1 and M > 16 and M <= 64
    scratch groups bytes (M * K / 4) when INT8 == 1 and M > 16 and M <= 64
    scratch partials bytes (2 * M * N * 4) when M > 16 and M <= 128
    launch project_rows_stage_s8 when INT8 == 1 and M > 16 and M <= 64:
        reads (INT8)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch project_rows_gemv when M <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(N, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch project_rows_gemv16 when M > 8 and M <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(N, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch project_rows_gemm_small when M > 16 and M <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div(N, 16), 8), 1, 1 + min(1, 128 / M))
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch project_rows_gemm when M > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div(N, 16), 8), ceil_div(M, 128), 1 + min(1, 128 / M))
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)
    launch project_rows_finalize when M > 16 and M <= 128:
        threadgroups (ceil_div(M * N, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native dense_output for cuda from "cuda/dense_output.cu":
    static (H, F, DS)
    params (code arithmetic INT8 in [0, 1])
    where F % 64 == 0 and DS <= 1
    scratch staged bytes (O * F) when INT8 == 1 and O > 16 and O <= 64
    scratch groups bytes (O * F / 4) when INT8 == 1 and O > 16 and O <= 64
    scratch partials bytes (2 * O * H * 4) when O > 16 and O <= 128
    launch dense_output_stage_s8 when INT8 == 1 and O > 16 and O <= 64:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_output_gemv when O <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(H, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_output_gemv16 when O > 8 and O <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(H, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch dense_output_gemm_small when O > 16 and O <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div(H, 16), 8), 1, 1 + min(1, 128 / O))
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch dense_output_gemm when O > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div(H, 16), 8), ceil_div(O, 128), 1 + min(1, 128 / O))
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)
    launch dense_output_finalize when O > 16 and O <= 128:
        threadgroups (ceil_div(O * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
