// kimi_delta_step (decode, MTP verify and small row classes): the
// row-sequential Kimi Delta rule with its preparation fused, each key column
// decayed by its own factor. `gated_delta_step`'s workgroups over
// `lib/recurrent/kimi.glsl`.
//
// One workgroup per (value head, state-row block, slot); each subgroup owns
// ROWS state rows, a lane W / 32 columns of each, held in registers for the
// whole slot. The raw outputs go to the `mixed` scratch; grid z = B zeroes
// the raw rows no slot covers. `kimi_delta_step_gate` then gates each
// (head, row) from the gate operand (`recurrent_gate`: the GEMV staging's lane
// order to 8 rows, the staging launch's order beyond). ROWS and WARPS never
// change result bits.
#include "lib/recurrent/kimi.glsl"

#if SEISMIC_TUNE_ROWS > RECURRENT_MAX_ROWS
#error "kimi_delta_step holds at most RECURRENT_MAX_ROWS state rows per subgroup"
#endif

void kimi_delta_step() {
    recurrent_sequential(SEISMIC_TUNE_ROWS);
}

void kimi_delta_step_gate() {
    recurrent_gate(SEISMIC_DIM_M <= 8ul);
}
