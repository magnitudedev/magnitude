// indexer_select on Vulkan (contract and portable body in indexer.seismic),
// the Metal launches (`metal/indexer_select.metal`):
//
// append:   workgroup per row; its raw key (widened to F32) and coordinates
//           to the window planes.
// complete: one subgroup per row that completes a block; the mean of its SB
//           raw keys (F32, members in order: the last SB - 1 rows of its
//           window spans, then its own), RMS-normed and rotated at the
//           coordinates stored with the first, stored in the F32 block plane.
//           The span of the first member is located by a subgroup scan of
//           the span extents, and a cursor walks on from it.
// score:    workgroup per (tile of 8 * INDEXER_BATCH blocks, row); the query
//           heads prepared into group memory, each subgroup scores
//           INDEXER_BATCH blocks, their key loads in flight together, from the
//           block span holding its first, located the same way.
// select:   workgroup of 256 invocations per row. A radix select over the
//           scores' bits (4 passes of 8 bits) finds the K-th best score T:
//           each pass's histogram takes one atomic per distinct digit of a
//           subgroup, and the digit is the bin whose workgroup scan of the
//           counts above it brackets the remaining rank. Blocks above T and
//           the first equal ones in block order (ranked by a scan of each
//           invocation's equal count) are marked, with every block from the
//           tail on, as the row's bitmap. With C > 0 it then emits the runs:
//           the row's span offsets are scanned into scratch, each
//           invocation counts the runs starting in its share of the keys, and
//           a scan of the counts places each run.
#include <seismic/element.glsl>
#include <seismic/slab.glsl>
#include "lib/core/activation.glsl"
#include "lib/core/reduce.glsl"
#include "lib/core/rotary.glsl"

#define INDEXER_W uint(2ul * SEISMIC_DIM_P + SEISMIC_DIM_S)
#define INDEXER_E (INDEXER_W / 32u)
#define INDEXER_P uint(SEISMIC_DIM_P)
#define INDEXER_H uint(SEISMIC_DIM_H)
#define INDEXER_SB uint(SEISMIC_DIM_SB)
// A projected query head's or raw key's bytes (activation element), and a
// stored raw or block key's (F32).
#define INDEXER_ROW_BYTES (uint64_t(INDEXER_W) * uint64_t(ELEMENT_BYTES(ELEMENT_ACT)))
#define INDEXER_KEY_BYTES (uint64_t(INDEXER_W) * 4ul)
// Bitmap words per row, 32 blocks each.
#define INDEXER_WORDS uint(SEISMIC_DIM_B)
#define INDEXER_BLOCKS (32ul * SEISMIC_DIM_B)

// Lane `lane`'s E columns of one head row, RMS-normed with `norm` (F32) and
// its first 2P columns rotated at `coordinates`: the portable `head_rotary`,
// unrounded. The whole subgroup calls it.
void indexer_norm_rotary(inout float x[INDEXER_E], uint64_t norm, uint64_t coordinates, float epsilon, uint lane) {
    float squares = 0.0;
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
        squares = seismic_fma_rn(x[i], x[i], squares);
    squares = seismic_subgroup_sum_f32(squares);
    const float inverse = inversesqrt(seismic_div_rn(squares, float(INDEXER_W)) + epsilon);
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
        x[i] = x[i] * inverse * element_f32_at(norm + uint64_t(lane * INDEXER_E + i) * 4ul);
    if (INDEXER_P == 0u)
        return;
    const uint64_t components = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_COMPONENTS);
    const uint64_t frequencies = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_FREQUENCIES);
    const uint64_t amplitudes = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_AMPLITUDES);
    const uint half_lanes = INDEXER_P / INDEXER_E;
    const uint partner_lane = lane < half_lanes ? lane + half_lanes : (lane < 2u * half_lanes ? lane - half_lanes : lane);
    float partner[INDEXER_E];
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
        partner[i] = seismic_shuffle(x[i], partner_lane);
    if (lane >= 2u * half_lanes)
        return;
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i) {
        const uint column = lane * INDEXER_E + i;
        const uint pair = column % max(INDEXER_P, 1u);
        float c;
        const int axis = element_i32_at(components + uint64_t(pair) * 4ul);
        const float angle = float(element_i32_at(coordinates + uint64_t(axis) * 4ul))
            * element_f32_at(frequencies + uint64_t(pair) * 4ul);
        float s = rotary_sincos(angle, c);
        const float amplitude = element_f32_at(amplitudes + uint64_t(pair) * 4ul);
        c *= amplitude;
        s *= amplitude;
        x[i] = column < INDEXER_P ? x[i] * c - partner[i] * s : x[i] * c + partner[i] * s;
    }
}

// The rows of [lo, hi) span `span` at `spans` (none past `count`).
uint indexer_span_extent(uint64_t spans, uint64_t count, uint64_t span) {
    if (span >= count)
        return 0u;
    const int lo = element_i32_at(spans + span * 8ul);
    const int hi = element_i32_at(spans + span * 8ul + 4ul);
    return hi > lo ? uint(hi - lo) : 0u;
}

// The rows of `count` spans at `spans`. Lane l sums spans l, l + 32, ...; the
// whole subgroup calls it.
uint indexer_span_rows(uint64_t spans, uint64_t count) {
    uint total = 0u;
    for (uint64_t span = SEISMIC_LANE; span < count; span += 32ul)
        total += indexer_span_extent(spans, count, span);
    return seismic_subgroup_add(total);
}

// A position in the rows of `count` spans, in order: span `span` (`count`
// past them), its first ordinal, its first row and its rows.
struct indexer_cursor {
    uint64_t span;
    uint first;
    int lo;
    uint extent;
};

// The cursor on the span holding row `ordinal` of those spans (past them
// when there is none). The whole subgroup calls it, 32 spans at a time.
indexer_cursor indexer_locate(uint64_t spans, uint64_t count, uint ordinal) {
    uint carried = 0u;
    for (uint64_t base = 0ul; base < count; base += 32ul) {
        uint found;
        if (reduce_lanes_locate(indexer_span_extent(spans, count, base + SEISMIC_LANE), ordinal, carried, found)) {
            const uint64_t span = base + found;
            return indexer_cursor(span, carried, element_i32_at(spans + span * 8ul),
                indexer_span_extent(spans, count, span));
        }
    }
    return indexer_cursor(count, carried, 0, 0u);
}

// The physical row of row `ordinal` of those spans, then of `own` (the row's
// own, after them), advancing `cursor` to it; ordinals never decrease.
int indexer_span_row(uint64_t spans, uint64_t count, inout indexer_cursor cursor, uint ordinal, int own) {
    while (cursor.span < count && ordinal >= cursor.first + cursor.extent) {
        cursor.first += cursor.extent;
        ++cursor.span;
        cursor.lo = cursor.span < count ? element_i32_at(spans + cursor.span * 8ul) : 0;
        cursor.extent = indexer_span_extent(spans, count, cursor.span);
    }
    return cursor.span < count ? cursor.lo + int(ordinal - cursor.first) : own;
}

// Row `row`'s block spans, and its own block (or -1).
uint64_t indexer_block_spans(uint64_t row) {
    return SEISMIC_PTR(SEISMIC_BUFFER_BLOCK_VISIBLE) + row * SEISMIC_DIM_R * 8ul;
}

int indexer_own_block(uint64_t row) {
    return element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_BLOCK_DESTINATIONS) + row * 4ul);
}

// Row `row`'s complete blocks: those of its block spans, then its own. The
// whole subgroup calls it.
uint indexer_complete(uint64_t row) {
    return indexer_span_rows(indexer_block_spans(row), SEISMIC_DIM_R) + (indexer_own_block(row) >= 0 ? 1u : 0u);
}

// Row `row`'s visible spans.
uint64_t indexer_key_spans(uint64_t row) {
    return SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE) + row * SEISMIC_DIM_R * 8ul;
}

void indexer_select_append() {
    const uint64_t row = gl_WorkGroupID.x;
    const int destination = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_DESTINATIONS) + row * 4ul);
    if (destination < 0)
        return;
    const uint64_t target = slab_row(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_KEYS), uint(destination),
        uint(SEISMIC_PARAM_WINDOW_SLAB_ROWS), INDEXER_KEY_BYTES);
    const uint64_t key = SEISMIC_PTR(SEISMIC_BUFFER_KEY) + row * INDEXER_ROW_BYTES;
    for (uint column = gl_LocalInvocationIndex; column < INDEXER_W; column += gl_WorkGroupSize.x)
        element_f32_put(target + uint64_t(column) * 4ul, element_at(ELEMENT_ACT, key, column));
    if (gl_LocalInvocationIndex < 4u) {
        const uint64_t stored = slab_row(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_COORDINATES), uint(destination),
            uint(SEISMIC_PARAM_WINDOW_SLAB_ROWS), 16ul);
        element_i32_put(stored + uint64_t(gl_LocalInvocationIndex) * 4ul,
            element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES) + (row * 4ul + gl_LocalInvocationIndex) * 4ul));
    }
}

void indexer_select_complete() {
    const uint64_t row = gl_WorkGroupID.x;
    const uint lane = SEISMIC_LANE;
    const int destination = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_BLOCK_DESTINATIONS) + row * 4ul);
    if (destination < 0)
        return;
    // The block's raw keys: the last SB - 1 rows of the window spans, then
    // the row's own.
    const uint64_t spans = SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_VISIBLE) + row * SEISMIC_DIM_R * 8ul;
    const int own = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_DESTINATIONS) + row * 4ul);
    const uint earlier = indexer_span_rows(spans, SEISMIC_DIM_R);
    const uint skipped = earlier > INDEXER_SB - 1u ? earlier - (INDEXER_SB - 1u) : 0u;
    indexer_cursor cursor = indexer_locate(spans, SEISMIC_DIM_R, skipped);
    int first_member = own;
    float sum[INDEXER_E];
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
        sum[i] = 0.0;
    for (uint member = 0u; member < INDEXER_SB; ++member) {
        const int at =
            member + 1u < INDEXER_SB ? indexer_span_row(spans, SEISMIC_DIM_R, cursor, skipped + member, own) : own;
        if (member == 0u)
            first_member = at;
        const uint64_t raw = slab_row(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_KEYS), uint(at),
            uint(SEISMIC_PARAM_WINDOW_SLAB_ROWS), INDEXER_KEY_BYTES);
        [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
            sum[i] = seismic_add_rn(sum[i], element_f32_at(raw + uint64_t(lane * INDEXER_E + i) * 4ul));
    }
    float x[INDEXER_E];
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
        x[i] = seismic_div_rn(sum[i], float(INDEXER_SB));
    indexer_norm_rotary(x, SEISMIC_PTR(SEISMIC_BUFFER_KEY_NORM),
        slab_row(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_COORDINATES), uint(first_member),
            uint(SEISMIC_PARAM_WINDOW_SLAB_ROWS), 16ul),
        element_word_f32(SEISMIC_PARAM_EPSILON), lane);
    const uint64_t target = slab_row(SEISMIC_PTR(SEISMIC_BUFFER_BLOCK_KEYS), uint(destination),
        uint(SEISMIC_PARAM_BLOCK_SLAB_ROWS), INDEXER_KEY_BYTES);
    [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
        element_f32_put(target + uint64_t(lane * INDEXER_E + i) * 4ul, x[i]);
}

// Shared: the prepared query heads [H][W] F32.
// Blocks a score subgroup takes, their key loads in flight together.
#define INDEXER_BATCH 4u

void indexer_select_score() {
    const uint64_t row = gl_WorkGroupID.y;
    const uint lane = SEISMIC_LANE;
    const uint simd = SEISMIC_SUBGROUP;
    const uint complete = indexer_complete(row);
    const uint first = gl_WorkGroupID.x * (8u * INDEXER_BATCH);
    if (first >= complete)
        return;
    for (uint head = simd; head < INDEXER_H; head += SEISMIC_SUBGROUPS) {
        float x[INDEXER_E];
        const uint64_t raw = SEISMIC_PTR(SEISMIC_BUFFER_QUERY) + (row * uint64_t(INDEXER_H) + head) * INDEXER_ROW_BYTES;
        [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
            x[i] = element_at(ELEMENT_ACT, raw, lane * INDEXER_E + i);
        indexer_norm_rotary(x, SEISMIC_PTR(SEISMIC_BUFFER_QUERY_NORM), SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES) + row * 16ul,
            element_word_f32(SEISMIC_PARAM_EPSILON), lane);
        [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
            seismic_shared_f32[head * INDEXER_W + lane * INDEXER_E + i] = x[i];
    }
    barrier();
    const float root = sqrt(float(INDEXER_W));
    const uint begin = first + simd * INDEXER_BATCH;
    const uint end = min(begin + INDEXER_BATCH, complete);
    if (begin >= end)
        return;
    // The subgroup's blocks from the block span holding its first.
    const uint64_t spans = indexer_block_spans(row);
    const int own = indexer_own_block(row);
    indexer_cursor cursor = indexer_locate(spans, SEISMIC_DIM_R, begin);
    float kx[INDEXER_BATCH][INDEXER_E];
    [[unroll]] for (uint j = 0u; j < INDEXER_BATCH; ++j) {
        // A block past the row's last repeats the last: its score is not stored.
        const int at = indexer_span_row(spans, SEISMIC_DIM_R, cursor, min(begin + j, end - 1u), own);
        const uint64_t k = slab_row(SEISMIC_PTR(SEISMIC_BUFFER_BLOCK_KEYS), uint(at),
            uint(SEISMIC_PARAM_BLOCK_SLAB_ROWS), INDEXER_KEY_BYTES);
        [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
            kx[j][i] = element_f32_at(k + uint64_t(lane * INDEXER_E + i) * 4ul);
    }
    [[unroll]] for (uint j = 0u; j < INDEXER_BATCH; ++j) {
        float score = 0.0;
        for (uint head = 0u; head < INDEXER_H; ++head) {
            float dot = 0.0;
            [[unroll]] for (uint i = 0u; i < INDEXER_E; ++i)
                dot = seismic_fma_rn(seismic_shared_f32[head * INDEXER_W + lane * INDEXER_E + i], kx[j][i], dot);
            score = seismic_add_rn(score, max(seismic_subgroup_sum_f32(dot), 0.0));
        }
        const float value = seismic_div_rn(score, root);
        // Scores are >= 0; a zero is stored as +0 so its bits order first.
        if (lane == 0u && begin + j < end)
            element_u32_put(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_SCORES) + (row * INDEXER_BLOCKS + begin + j) * 4ul,
                value == 0.0 ? 0u : floatBitsToUint(value));
    }
}

// The select workgroup's invocations and its group memory (u32 offsets): the
// histogram bins [256], the scan words [8] (the subgroup totals of each
// workgroup scan) and the select state [4] (prefix, remaining).
#define INDEXER_THREADS 256u

// The row's span offsets [R + 1] in scratch: the keys before each span, then
// the row's.
uint indexer_offset(uint64_t row, uint span) {
    return element_u32_at(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_SPANS) + (row * (SEISMIC_DIM_R + 1ul) + span) * 4ul);
}
void indexer_set_offset(uint64_t row, uint span, uint value) {
    element_u32_put(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_SPANS) + (row * (SEISMIC_DIM_R + 1ul) + span) * 4ul, value);
}
#define INDEXER_BINS 0u
#define INDEXER_SCAN 256u
#define INDEXER_STATE 264u

// Run `index` of row `row`'s segments gets bound `bound` (start or end) when
// it is one of the C.
void indexer_put_bound(uint64_t row, int index, uint bound, int value) {
    if (index >= 0 && index < int(SEISMIC_DIM_C))
        element_i32_put(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER)
            + ((row * SEISMIC_DIM_C + uint64_t(index)) * 2ul + bound) * 4ul, value);
}

// The runs of row `row`'s read keys starting in keys [k0, k1) of its `total`
// (keys in span order, the span offsets in scratch). Key k is read when
// its block k / SB is marked in `bitmap` or lies past its 32 B blocks, and is
// stored at its span's first row plus its place in the span. A run starts at
// a read key unless the previous key is read, stored one row before it, and
// the key does not start a slab. Returns the runs starting in the keys; with `emit`,
// writes them from index `opened` + 1 (`opened` is the run open at k0, begun
// before it): each start at its run's first key, each end at its last, which
// the next key (read beyond k1 when it exists) decides.
uint indexer_runs(uint64_t row, uint64_t bitmap, uint total, uint k0, uint k1, const bool emit, int opened) {
    if (k0 >= k1)
        return 0u;
    const uint r = uint(SEISMIC_DIM_R);
    const uint slab_rows = uint(SEISMIC_PARAM_SLAB_ROWS);
    const uint64_t spans = indexer_key_spans(row);
    // The span holding the key before k0 (or k0 itself), found by bisection
    // as the last span whose offset is at most it: a non-empty span.
    const uint kstart = k0 > 0u ? k0 - 1u : 0u;
    uint span = 0u;
    for (uint high = r - 1u; span < high;) {
        const uint middle = (span + high + 1u) / 2u;
        if (indexer_offset(row, middle) <= kstart)
            span = middle;
        else
            high = middle - 1u;
    }
    uint span_first = indexer_offset(row, span);
    uint span_next = indexer_offset(row, span + 1u);
    int span_lo = element_i32_at(spans + uint64_t(span) * 8ul);
    uint block = 0xffffffffu;
    bool block_read = false;
    bool previous_read = false;
    int previous_stored = 0;
    uint starts = 0u;
    int index = opened;
    const uint kend = min(k1 + 1u, total);
    for (uint k = kstart; k < kend; ++k) {
        if (k / INDEXER_SB != block) {
            block = k / INDEXER_SB;
            block_read = block >= uint(INDEXER_BLOCKS)
                || ((element_u32_at(bitmap + uint64_t(block / 32u) * 4ul) >> (block % 32u)) & 1u) != 0u;
        }
        if (!block_read) {
            // The run through the previous key ends there; the block's other
            // keys are unread too.
            if (emit && k > k0 && previous_read)
                indexer_put_bound(row, index, 1u, previous_stored + 1);
            previous_read = false;
            k = min((block + 1u) * INDEXER_SB, kend) - 1u;
            continue;
        }
        while (k >= span_next) {
            ++span;
            span_first = span_next;
            span_next = indexer_offset(row, span + 1u);
            span_lo = element_i32_at(spans + uint64_t(span) * 8ul);
        }
        const int stored = span_lo + int(k - span_first);
        const bool continues = previous_read && previous_stored + 1 == stored && stored % int(slab_rows) != 0;
        if (emit && k > k0 && previous_read && !continues)
            indexer_put_bound(row, index, 1u, previous_stored + 1);
        if (k >= k0 && k < k1 && !continues) {
            ++starts;
            ++index;
            if (emit)
                indexer_put_bound(row, index, 0u, stored);
        }
        previous_read = true;
        previous_stored = stored;
    }
    // The row's last key ends its run.
    if (emit && k1 == total && previous_read)
        indexer_put_bound(row, index, 1u, previous_stored + 1);
    return starts;
}

void indexer_select_select() {
    const uint thread = SEISMIC_SUBGROUP * 32u + SEISMIC_LANE;
    const uint64_t row = gl_WorkGroupID.x;
    const uint complete = indexer_complete(row);
    const uint written = INDEXER_WORDS;
    const uint64_t bitmap = SEISMIC_PTR(SEISMIC_RESULT_1_BUFFER) + row * uint64_t(written) * 4ul;
    const uint64_t bits = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_SCORES) + row * INDEXER_BLOCKS * 4ul;
    const uint selected = uint(max(int(SEISMIC_PARAM_SELECTED), 0));
    if (complete <= selected) {
        for (uint word = thread; word < written; word += INDEXER_THREADS)
            element_u32_put(bitmap + uint64_t(word) * 4ul, 0xffffffffu);
    } else {
        if (thread == 0u) {
            seismic_shared_u32[INDEXER_STATE] = 0u;
            seismic_shared_u32[INDEXER_STATE + 1u] = selected;
        }
        uint mask = 0u;
        for (int digit = 3; digit >= 0; --digit) {
            seismic_shared_u32[INDEXER_BINS + thread] = 0u;
            barrier();
            const uint prefix = seismic_shared_u32[INDEXER_STATE];
            const uint remaining = seismic_shared_u32[INDEXER_STATE + 1u];
            const uint shift = uint(digit) * 8u;
            for (uint base = 0u; base < complete; base += INDEXER_THREADS) {
                const uint block = base + thread;
                const uint u = block < complete ? element_u32_at(bits + uint64_t(block) * 4ul) : 0u;
                bool pending = block < complete && (u & mask) == prefix;
                const uint value = (u >> shift) & 255u;
                // One atomic per distinct digit of the subgroup: the first
                // pending lane's digit, counted over the lanes holding it.
                for (uint lanes = reduce_lanes_ballot(pending); lanes != 0u; lanes = reduce_lanes_ballot(pending)) {
                    const uint leader = uint(findLSB(lanes));
                    const uint chosen = seismic_shuffle(value, leader);
                    const uint holding = reduce_lanes_ballot(pending && value == chosen);
                    if (SEISMIC_LANE == leader)
                        atomicAdd(seismic_shared_u32[INDEXER_BINS + chosen], uint(bitCount(holding)));
                    pending = pending && value != chosen;
                }
            }
            barrier();
            // Invocation t takes bin 255 - t: the scan gives the candidates
            // in the bins above it, and the bin holding the remaining rank
            // fixes the digit (bin 255 when nothing remains: no score
            // exceeds the threshold and no equal one is taken).
            const uint bin = 255u - thread;
            const uint count = seismic_shared_u32[INDEXER_BINS + bin];
            uint candidates;
            const uint above = reduce_group_exclusive_add(count, INDEXER_SCAN, candidates);
            if (remaining <= above + count && (thread == 0u || above < remaining)) {
                seismic_shared_u32[INDEXER_STATE] = prefix | (bin << shift);
                seismic_shared_u32[INDEXER_STATE + 1u] = remaining - above;
            }
            mask |= 255u << shift;
            barrier();
        }
        const uint threshold = seismic_shared_u32[INDEXER_STATE];
        const uint take = seismic_shared_u32[INDEXER_STATE + 1u];
        // Each invocation marks a run of whole words; the scores equal to the
        // threshold are taken in block order, ranked by a scan of each
        // invocation's count.
        const uint per = (written + INDEXER_THREADS - 1u) / INDEXER_THREADS;
        const uint word_lo = min(thread * per, written);
        const uint word_hi = min(word_lo + per, written);
        uint equals = 0u;
        for (uint block = word_lo * 32u; block < min(word_hi * 32u, complete); ++block)
            equals += element_u32_at(bits + uint64_t(block) * 4ul) == threshold ? 1u : 0u;
        uint all_equal;
        uint rank = reduce_group_exclusive_add(equals, INDEXER_SCAN, all_equal);
        for (uint word = word_lo; word < word_hi; ++word) {
            uint value = 0u;
            for (uint bit = 0u; bit < 32u; ++bit) {
                const uint block = word * 32u + bit;
                bool read = block >= complete;
                if (!read) {
                    const uint u = element_u32_at(bits + uint64_t(block) * 4ul);
                    if (u > threshold) {
                        read = true;
                    } else if (u == threshold) {
                        read = rank < take;
                        ++rank;
                    }
                }
                value |= read ? (1u << bit) : 0u;
            }
            element_u32_put(bitmap + uint64_t(word) * 4ul, value);
        }
    }
    if (SEISMIC_DIM_C == 0ul)
        return;

    // The runs of the row's keys in its R visible spans (its fresh rows, its
    // tail, attention reads itself), from the bitmap this workgroup wrote.
    memoryBarrierBuffer();
    barrier();
    const uint r = uint(SEISMIC_DIM_R);
    const uint64_t spans = indexer_key_spans(row);
    // The span offsets [R + 1], 256 spans per scan.
    uint total = 0u;
    for (uint base = 0u; base < r; base += INDEXER_THREADS) {
        const uint span = base + thread;
        uint chunk;
        const uint before = reduce_group_exclusive_add(indexer_span_extent(spans, r, span), INDEXER_SCAN, chunk);
        if (span < r)
            indexer_set_offset(row, span, total + before);
        total += chunk;
    }
    if (thread == 0u)
        indexer_set_offset(row, r, total);
    memoryBarrierBuffer();
    barrier();
    // Invocation t's share of the keys; the scan of the runs starting in
    // each share places them.
    const uint share = (total + INDEXER_THREADS - 1u) / INDEXER_THREADS;
    const uint k0 = min(thread * share, total);
    const uint k1 = min(k0 + share, total);
    uint runs;
    const uint first_run = reduce_group_exclusive_add(indexer_runs(row, bitmap, total, k0, k1, false, 0), INDEXER_SCAN,
        runs);
    indexer_runs(row, bitmap, total, k0, k1, true, int(first_run) - 1);
    for (uint entry = runs + thread; entry < uint(SEISMIC_DIM_C); entry += INDEXER_THREADS) {
        indexer_put_bound(row, int(entry), 0u, 0);
        indexer_put_bound(row, int(entry), 1u, 0);
    }
}
