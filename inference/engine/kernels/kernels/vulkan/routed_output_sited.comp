// The CPU's join of a streamed layer of Qwen's fused decode output
// (`routed_output_sited` in routed.seismic): `routed_output`'s join
// (`lib/routed/output_sum.glsl`) over `routed_output_project`'s published
// projections, invocation 0 reading the CPU's answer when a choice is the
// CPU's (`lib/routed/sited.glsl`).
#include "lib/core/activation.glsl"
#include "lib/streaming/control.glsl"
#include "../streaming/site.hpp"
#include "lib/routed/sited.glsl"
#include "lib/projection/projection.glsl"
#define ROUTED_PROJECTED_KIND ELEMENT_ACT
#define ROUTED_PROJECTED_BASE SEISMIC_PTR(SEISMIC_BUFFER_PUBLISHED)
#define ROUTED_PROJECTED_INDEX(m, k, n) \
    ((m) * SEISMIC_PUBLISHED_STRIDE_0 + (k) * SEISMIC_PUBLISHED_STRIDE_1 + (n) * SEISMIC_PUBLISHED_STRIDE_2)
#include "lib/routed/output_sum.glsl"

void routed_output_combine() {
    const uint64_t q = streaming_step(SEISMIC_PTR(SEISMIC_BUFFER_STEP), SEISMIC_STEP_STRIDE_0);
    const uint64_t slot = q % uint64_t(SEISMIC_DIM_FLIGHT);
    routed_output_join(routed_site_answered(q, slot), slot);
}
