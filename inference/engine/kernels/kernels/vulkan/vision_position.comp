// vision_position: four contiguous columns per grid-stride iteration: the
// source plus the four table corners scaled by their coefficients, summed in
// order, with row-constant indices and coefficients hoisted once per quad.
#include <seismic/element.glsl>

#define TABLE_KIND ELEMENT_OF(SEISMIC_TABLE)

vec4 vision_position_load4(uint64_t base, uint64_t index) {
    if (TABLE_KIND == ELEMENT_F32)
        return element_vec4_at(base + index * 4ul);
    const uvec2 words = element_uvec2_at(base + index * 2ul);
    return vec4(element_unpack2(TABLE_KIND, words.x), element_unpack2(TABLE_KIND, words.y));
}

void vision_position() {
    const uint64_t columns = SEISMIC_DIM_H;
    const uint64_t vecs = (columns + 3ul) >> 2;
    const uint64_t total = SEISMIC_DIM_M * vecs;
    const uint64_t indices_base = SEISMIC_PTR(SEISMIC_BUFFER_INDICES);
    const uint64_t coeff_base = SEISMIC_PTR(SEISMIC_BUFFER_COEFFICIENTS);
    const uint64_t source_base = SEISMIC_PTR(SEISMIC_BUFFER_SOURCE);
    const uint64_t table_base = SEISMIC_PTR(SEISMIC_BUFFER_TABLE);
    const Out result = SEISMIC_RESULT_0_OUT;
    const uint64_t table_bytes = uint64_t(ELEMENT_BYTES(TABLE_KIND));
    const uint64_t table_align_mask = table_bytes * 4ul - 1ul;
    const bool unit_strides = SEISMIC_SOURCE_STRIDE_1 == 1ul
        && SEISMIC_TABLE_STRIDE_1 == 1ul
        && SEISMIC_RESULT_0_STRIDE_1 == 1ul;
    for (seismic_walk at = seismic_walk_grid(total, u64vec3(1ul, 1ul, vecs)); at.index < total; seismic_walk_next(at)) {
        const uint64_t row = at.axes.x;
        const uint64_t col = at.axes.w << 2;
        const uint64_t indices_addr = indices_base + row * SEISMIC_INDICES_STRIDE_0 * 4ul;
        ivec4 corners;
        if (SEISMIC_INDICES_STRIDE_1 == 1ul && (indices_addr & 15ul) == 0ul) {
            corners = ivec4(element_uvec4_at(indices_addr));
        } else {
            corners = ivec4(
                element_i32_at(indices_addr),
                element_i32_at(indices_addr + SEISMIC_INDICES_STRIDE_1 * 4ul),
                element_i32_at(indices_addr + 2ul * SEISMIC_INDICES_STRIDE_1 * 4ul),
                element_i32_at(indices_addr + 3ul * SEISMIC_INDICES_STRIDE_1 * 4ul));
        }
        const uint64_t coeff_addr = coeff_base + row * SEISMIC_COEFFICIENTS_STRIDE_0 * 4ul;
        vec4 coeffs;
        if (SEISMIC_COEFFICIENTS_STRIDE_1 == 1ul && (coeff_addr & 15ul) == 0ul) {
            coeffs = element_vec4_at(coeff_addr);
        } else {
            coeffs = vec4(
                element_f32_at(coeff_addr),
                element_f32_at(coeff_addr + SEISMIC_COEFFICIENTS_STRIDE_1 * 4ul),
                element_f32_at(coeff_addr + 2ul * SEISMIC_COEFFICIENTS_STRIDE_1 * 4ul),
                element_f32_at(coeff_addr + 3ul * SEISMIC_COEFFICIENTS_STRIDE_1 * 4ul));
        }
        const uint64_t t0 = uint64_t(corners.x) * SEISMIC_TABLE_STRIDE_0;
        const uint64_t t1 = uint64_t(corners.y) * SEISMIC_TABLE_STRIDE_0;
        const uint64_t t2 = uint64_t(corners.z) * SEISMIC_TABLE_STRIDE_0;
        const uint64_t t3 = uint64_t(corners.w) * SEISMIC_TABLE_STRIDE_0;
        const uint64_t table_bits =
            (table_base + t0 * table_bytes) | (table_base + t1 * table_bytes) |
            (table_base + t2 * table_bytes) | (table_base + t3 * table_bytes);
        const uint64_t src_row = row * SEISMIC_SOURCE_STRIDE_0;
        const uint64_t out_row = row * SEISMIC_RESULT_0_STRIDE_0;
        if (unit_strides && col + 4ul <= columns
            && ((source_base + src_row * 4ul) & 15ul) == 0ul
            && (table_bits & table_align_mask) == 0ul) {
            vec4 blended = vec4(0.0);
            blended += vision_position_load4(table_base, t0 + col) * coeffs.x;
            blended += vision_position_load4(table_base, t1 + col) * coeffs.y;
            blended += vision_position_load4(table_base, t2 + col) * coeffs.z;
            blended += vision_position_load4(table_base, t3 + col) * coeffs.w;
            const vec4 out_v = element_vec4_at(source_base + (src_row + col) * 4ul) + blended;
            out_put2(result, out_row + col, out_v.x, out_v.y);
            out_put2(result, out_row + col + 2ul, out_v.z, out_v.w);
        } else {
            const uint64_t limit = col + 4ul < columns ? col + 4ul : columns;
            for (uint64_t c = col; c < limit; ++c) {
                const uint64_t tc = c * SEISMIC_TABLE_STRIDE_1;
                float blended = 0.0;
                blended += element_at(TABLE_KIND, table_base, t0 + tc) * coeffs.x;
                blended += element_at(TABLE_KIND, table_base, t1 + tc) * coeffs.y;
                blended += element_at(TABLE_KIND, table_base, t2 + tc) * coeffs.z;
                blended += element_at(TABLE_KIND, table_base, t3 + tc) * coeffs.w;
                out_put(result, out_row + c * SEISMIC_RESULT_0_STRIDE_1,
                    element_f32_at(source_base + (src_row + c * SEISMIC_SOURCE_STRIDE_1) * 4ul) + blended);
            }
        }
    }
}
