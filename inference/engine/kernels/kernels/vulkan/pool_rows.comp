// pool_rows on Vulkan (contract and portable body in pooled.seismic), the
// CUDA launches (`cuda/pool_rows.cu`):
//
// Two rows a workgroup of 64, a logical subgroup each (`pool_slot`).
// append:   a logical subgroup per row, lane l holding columns [l E, (l + 1) E);
//           its u (LayerNorm-ed when TN = 1, then g) and coordinates to the
//           window planes.
// complete: a logical subgroup per row, lane l holding columns
//           [l E, (l + 1) E); a completing row gathers its group (the last
//           RATE - 1 rows of its window spans, then its own inputs, normed as
//           append's; its gates plus their place terms), pools it, RMS-norms
//           it with `norm` when TN = 0 (the latent, published), rotates it
//           at the coordinates stored with the group's first token
//           (`rotary_lane_rotate`), rounds it (`rounding_lanes`; a rounded
//           row held in A after its pooling, norm and rotation) and stores it
//           in the block plane, publishing the latent, its block row and the
//           origin coordinates. Other rows publish a zero latent, block row -1
//           and zero coordinates.
#define KERNEL_A SEISMIC_ELEMENT_A
#include <seismic/element.glsl>
#include <seismic/slab.glsl>
#include "lib/core/activation.glsl"
#include "lib/core/precise.glsl"

#define POOL_W uint(2ul * SEISMIC_DIM_P + SEISMIC_DIM_S)
#define LANE_E (POOL_W / 32u)
#define POOL_RATE uint(SEISMIC_DIM_RATE)
#define POOL_GATED (SEISMIC_DIM_GT != 0)
#define POOL_TOKEN_NORM (SEISMIC_DIM_TN != 0)
#define POOL_PLACES uint(SEISMIC_DIM_PR)
// A window row: u, then (gated) g.
#define POOL_WIDTH ((POOL_GATED ? 2u : 1u) * POOL_W)

#include "lib/core/head.glsl"
#include "lib/core/norm.glsl"
#include "lib/core/rotary.glsl"
#include "lib/core/rounding.glsl"
#include "lib/indexer/indexer.glsl"

// The rotated pairs: P of them over the leading columns, or the trailing ones
// (RT = 1, from S); half-split, or adjacent (RA = 1).
#define POOL_ROTARY \
    rotary_layout(uint(SEISMIC_DIM_P), SEISMIC_DIM_RT != 0 ? uint(SEISMIC_DIM_S) : 0u, SEISMIC_DIM_RA != 0)

// Loads lane's contiguous columns [col_base, col_base + LANE_E) from an F32
// buffer at `base` (stepping by `stride`), using 128-bit vec4 loads when
// stride == 1 and 16-byte aligned, with scalar tail.
void pool_load_f32_lane(out float values[LANE_E], uint64_t base, uint64_t stride, uint col_base) {
    if (LANE_E >= 4u && stride == 1ul && ((base + uint64_t(col_base) * 4ul) & 15ul) == 0ul) {
        const uint64_t at = base + uint64_t(col_base) * 4ul;
        [[unroll]] for (uint k = 0u; k < (LANE_E & ~3u); k += 4u) {
            const vec4 v = element_vec4_at(at + uint64_t(k) * 4ul);
            values[k] = v.x;
            values[k + 1u] = v.y;
            values[k + 2u] = v.z;
            values[k + 3u] = v.w;
        }
        [[unroll]] for (uint k = (LANE_E & ~3u); k < LANE_E; ++k)
            values[k] = element_f32_at(at + uint64_t(k) * 4ul);
        return;
    }
    [[unroll]] for (uint k = 0u; k < LANE_E; ++k)
        values[k] = element_f32_at(base + uint64_t(col_base + k) * stride * 4ul);
}

// Loads lane's contiguous columns [col_base, col_base + LANE_E) from an F32
// `Out` handle, using 128-bit vec4 loads when 16-byte aligned, with scalar tail.
void pool_load_out_f32_lane(out float values[LANE_E], Out source, uint col_base) {
    const Stored view = out_stored(source, uint64_t(col_base));
    if (LANE_E >= 4u && stored_aligned16(view)) {
        [[unroll]] for (uint k = 0u; k < (LANE_E & ~3u); k += 4u) {
            const vec4 v = stored_vec4_at(view, uint64_t(k));
            values[k] = v.x;
            values[k + 1u] = v.y;
            values[k + 2u] = v.z;
            values[k + 3u] = v.w;
        }
        [[unroll]] for (uint k = (LANE_E & ~3u); k < LANE_E; ++k)
            values[k] = stored_at(view, uint64_t(k));
        return;
    }
    [[unroll]] for (uint k = 0u; k < LANE_E; ++k)
        values[k] = stored_at(view, uint64_t(k));
}

// Stores lane's contiguous columns [col_base, col_base + LANE_E) into `target`
// (stepping by `stride`), using 128-bit `out_put8` when stride == 1 and
// 16-byte aligned, falling back to `out_put2` / `out_put` for tails or
// smaller `LANE_E`.
void pool_out_put_lane(Out target, uint col_base, uint64_t stride, float values[LANE_E]) {
    if (LANE_E >= 8u && stride == 1ul && stored_aligned16(out_stored(target, uint64_t(col_base)))) {
        [[unroll]] for (uint k = 0u; k < (LANE_E & ~7u); k += 8u) {
            out_put8(target, uint64_t(col_base + k),
                vec4(values[k], values[k + 2u], values[k + 4u], values[k + 6u]),
                vec4(values[k + 1u], values[k + 3u], values[k + 5u], values[k + 7u]));
        }
        [[unroll]] for (uint k = (LANE_E & ~7u); k < (LANE_E & ~1u); k += 2u)
            out_put2(target, uint64_t(col_base + k), values[k], values[k + 1u]);
        [[unroll]] for (uint k = (LANE_E & ~1u); k < LANE_E; ++k)
            out_put(target, uint64_t(col_base + k), values[k]);
        return;
    }
    if (stride == 1ul) {
        [[unroll]] for (uint k = 0u; k < (LANE_E & ~1u); k += 2u)
            out_put2(target, uint64_t(col_base + k), values[k], values[k + 1u]);
        [[unroll]] for (uint k = (LANE_E & ~1u); k < LANE_E; ++k)
            out_put(target, uint64_t(col_base + k), values[k]);
        return;
    }
    [[unroll]] for (uint k = 0u; k < LANE_E; ++k)
        out_put(target, uint64_t(col_base + k) * stride, values[k]);
}

// Row `row`'s own u, the lane holding contiguous columns [lane * LANE_E,
// (lane + 1) * LANE_E) in x[k], LayerNorm-ed per token with `norm` and
// `bias` when TN = 1 (`token_norm`): `norm_*`'s arithmetic over the logical
// subgroup's partials.
void pool_own_row(inout float x[LANE_E], uint64_t row, uint lane) {
    const uint lane_base = lane * LANE_E;
    const uint64_t u = SEISMIC_PTR(SEISMIC_BUFFER_U) + row * SEISMIC_U_STRIDE_0 * 4ul;
    pool_load_f32_lane(x, u, SEISMIC_U_STRIDE_1, lane_base);
    if (POOL_TOKEN_NORM) {
        float sum = 0.0;
        [[unroll]] for (uint k = 0u; k < LANE_E; ++k)
            sum += x[k];
        const float mean = norm_mean(seismic_subgroup_sum_f32(sum), POOL_W);
        float squares = 0.0;
        [[unroll]] for (uint k = 0u; k < LANE_E; ++k) {
            x[k] -= mean;
            squares = norm_square(x[k], squares);
        }
        const float inverse = norm_inverse(seismic_subgroup_sum_f32(squares), POOL_W,
            element_word_f32(SEISMIC_PARAM_EPSILON));
        float w[LANE_E], b[LANE_E];
        pool_load_f32_lane(w, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_1, lane_base);
        pool_load_f32_lane(b, SEISMIC_PTR(SEISMIC_BUFFER_BIAS), SEISMIC_BIAS_STRIDE_1, lane_base);
        [[unroll]] for (uint k = 0u; k < LANE_E; ++k)
            x[k] = norm_apply(x[k], inverse, true, w[k], true, b[k]);
    }
}

// Each launch's workgroup holds two rows, one per logical subgroup: row
// 2 g + s of workgroup g's logical subgroup s. On 64-lane hardware both rows
// share a hardware subgroup, so a row that stores nothing (past M, or with
// nothing to store) runs its subgroup operations alongside the other on
// row M - 1's or its own inputs, its stores guarded, unless both store
// nothing (`seismic_steer`). On 32-lane hardware it is the row's own return.
uint64_t pool_slot() {
    return uint64_t(gl_WorkGroupID.x) * 2ul + uint64_t(SEISMIC_SUBGROUP);
}

void pool_rows_append() {
    const uint64_t slot = pool_slot();
    bool present;
    if (!seismic_steer(present, slot < SEISMIC_DIM_M))
        return;
    const uint64_t row = present ? slot : SEISMIC_DIM_M - 1ul;
    const uint lane = SEISMIC_LANE;
    const uint lane_base = lane * LANE_E;
    const int destination = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_DESTINATIONS)
        + row * SEISMIC_WINDOW_DESTINATIONS_STRIDE_0 * 4ul);
    bool live;
    if (!seismic_steer(live, present && destination >= 0))
        return;
    const uint slab_rows = uint(SEISMIC_PARAM_WINDOW_SLAB_ROWS);
    // A row that stores nothing addresses window row 0, which it never stores.
    const Out target = slab_out_row(SEISMIC_OUT_WINDOW_ROWS, uint(live ? destination : 0), slab_rows,
        uint64_t(POOL_WIDTH));
    float x[LANE_E];
    pool_own_row(x, row, lane);
    if (live) {
        pool_out_put_lane(target, lane_base, 1ul, x);
        if (POOL_GATED) {
            const uint64_t g_row = SEISMIC_PTR(SEISMIC_BUFFER_G) + row * SEISMIC_G_STRIDE_0 * 4ul;
            float g_vals[LANE_E];
            pool_load_f32_lane(g_vals, g_row, SEISMIC_G_STRIDE_1, lane_base);
            pool_out_put_lane(target, POOL_W + lane_base, 1ul, g_vals);
        }
        if (lane < 4u) {
            const uint64_t stored = slab_row(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_COORDINATES), uint(destination), slab_rows, 16ul);
            element_i32_put(stored + uint64_t(lane) * 4ul, element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES)
                + (row * SEISMIC_COORDINATES_STRIDE_0 + uint64_t(lane) * SEISMIC_COORDINATES_STRIDE_1) * 4ul));
        }
    }
}

#if SEISMIC_SUBGROUP_LANES == 64
// The plane rows of the window spans' ordinals first, first + 1, ... (the
// group's members, at least the first), -1 past the spans: one pass over
// the R spans, the same trip count for both rows of a hardware subgroup,
// where `indexer_span_row`'s search leaves at each row's own span.
void pool_member_rows(uint64_t spans, uint first, out int rows[16]) {
    [[unroll]] for (uint member = 0u; member < 16u; ++member)
        rows[member] = -1;
    uint before = 0u;
    for (uint64_t span = 0ul; span < SEISMIC_DIM_R; ++span) {
        const uint64_t at = spans + span * SEISMIC_WINDOW_VISIBLE_STRIDE_1 * 4ul;
        const int lo = element_i32_at(at);
        const uint length = indexer_span_length(lo, element_i32_at(at + SEISMIC_WINDOW_VISIBLE_STRIDE_2 * 4ul));
        [[unroll]] for (uint member = 0u; member < 16u; ++member) {
            const uint ordinal = first + member;
            if (member < max(POOL_RATE - 1u, 1u) && ordinal >= before && ordinal - before < length)
                rows[member] = lo + int(ordinal - before);
        }
        before += length;
    }
}
#endif

void pool_rows_complete() {
    const uint64_t slot = pool_slot();
    bool present;
    if (!seismic_steer(present, slot < SEISMIC_DIM_M))
        return;
    const uint64_t row = present ? slot : SEISMIC_DIM_M - 1ul;
    const uint lane = SEISMIC_LANE;
    const uint lane_base = lane * LANE_E;
    const int destination = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_BLOCK_DESTINATIONS)
        + row * SEISMIC_BLOCK_DESTINATIONS_STRIDE_0 * 4ul);
    const Out published = out_offset(SEISMIC_RESULT_0_OUT, row * SEISMIC_RESULT_0_STRIDE_0);
    const uint64_t latent_rows = SEISMIC_PTR(SEISMIC_RESULT_1_BUFFER);
    const uint64_t latent_coordinates = SEISMIC_PTR(SEISMIC_RESULT_2_BUFFER) + row * SEISMIC_RESULT_2_STRIDE_0 * 4ul;
    if (present && destination < 0) {
        float zeros[LANE_E];
        [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
            zeros[i] = 0.0;
        pool_out_put_lane(published, lane_base, SEISMIC_RESULT_0_STRIDE_1, zeros);
        if (lane == 0u)
            element_i32_put(latent_rows + row * SEISMIC_RESULT_1_STRIDE_0 * 4ul, -1);
        if (lane < 4u)
            element_i32_put(latent_coordinates + uint64_t(lane) * SEISMIC_RESULT_2_STRIDE_1 * 4ul, 0);
    }
    bool completing;
    if (!seismic_steer(completing, present && destination >= 0))
        return;
    const uint window_slab_rows = uint(SEISMIC_PARAM_WINDOW_SLAB_ROWS);
    // The group's earlier tokens: the last RATE - 1 rows of the window spans.
    const uint64_t spans = SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_VISIBLE) + row * SEISMIC_WINDOW_VISIBLE_STRIDE_0 * 4ul;
    const uint earlier = indexer_span_rows(spans, SEISMIC_DIM_R, SEISMIC_WINDOW_VISIBLE_STRIDE_1,
        SEISMIC_WINDOW_VISIBLE_STRIDE_2);
    // A completing row's window spans hold its group's earlier tokens.
    const uint first_member = earlier - (POOL_RATE - 1u);
    // The plane row of the group's member `member`: on 32-lane hardware the
    // row's own search (its loop the hardware subgroup's), on 64-lane
    // hardware one pass for both rows (`pool_member_rows`).
#if SEISMIC_SUBGROUP_LANES == 32
#define POOL_MEMBER_ROW(member) indexer_span_row(spans, SEISMIC_DIM_R, SEISMIC_WINDOW_VISIBLE_STRIDE_1, \
    SEISMIC_WINDOW_VISIBLE_STRIDE_2, first_member + (member))
#else
    int member_rows[16];
    pool_member_rows(spans, first_member, member_rows);
#define POOL_MEMBER_ROW(member) member_rows[member]
#endif
    // A row that completes nothing addresses window row 0, which it never reads.
    Out members[16];
    [[unroll]] for (uint member = 0u; member + 1u < POOL_RATE; ++member)
        members[member] = slab_out_row(SEISMIC_OUT_WINDOW_ROWS, completing ? uint(POOL_MEMBER_ROW(member)) : 0u,
            window_slab_rows, uint64_t(POOL_WIDTH));
    float own[LANE_E];
    pool_own_row(own, row, lane);
    float x[LANE_E];
    if (POOL_GATED) {
        const uint64_t g_row = SEISMIC_PTR(SEISMIC_BUFFER_G) + row * SEISMIC_G_STRIDE_0 * 4ul;
        float top[LANE_E], total[LANE_E];
        [[unroll]] for (uint i = 0u; i < LANE_E; ++i) {
            top[i] = -uintBitsToFloat(0x7f800000u);
            total[i] = 0.0;
            x[i] = 0.0;
        }
        float scores[POOL_RATE][LANE_E];
        [[unroll]] for (uint member = 0u; member < POOL_RATE; ++member) {
            float gate_vals[LANE_E];
            if (completing && member + 1u < POOL_RATE) {
                pool_load_out_f32_lane(gate_vals, members[member], POOL_W + lane_base);
            } else {
                pool_load_f32_lane(gate_vals, g_row, SEISMIC_G_STRIDE_1, lane_base);
            }
            if (member < POOL_PLACES) {
                float place[LANE_E];
                pool_load_f32_lane(place,
                    SEISMIC_PTR(SEISMIC_BUFFER_POSITION) + uint64_t(member) * SEISMIC_POSITION_STRIDE_0 * 4ul,
                    SEISMIC_POSITION_STRIDE_1, lane_base);
                [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
                    gate_vals[i] += place[i];
            }
            [[unroll]] for (uint i = 0u; i < LANE_E; ++i) {
                scores[member][i] = gate_vals[i];
                top[i] = max(top[i], gate_vals[i]);
            }
        }
        [[unroll]] for (uint member = 0u; member < POOL_RATE; ++member) {
            [[unroll]] for (uint i = 0u; i < LANE_E; ++i) {
                const float w = precise_exp(scores[member][i] - top[i]);
                scores[member][i] = w;
                total[i] += w;
            }
        }
        [[unroll]] for (uint member = 0u; member < POOL_RATE; ++member) {
            float val[LANE_E];
            if (completing && member + 1u < POOL_RATE) {
                pool_load_out_f32_lane(val, members[member], lane_base);
            } else {
                [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
                    val[i] = own[i];
            }
            [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
                x[i] += seismic_div_rn(scores[member][i], total[i]) * val[i];
        }
    } else {
        [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
            x[i] = 0.0;
        [[unroll]] for (uint member = 0u; member < POOL_RATE; ++member) {
            if (completing && member + 1u < POOL_RATE) {
                float val[LANE_E];
                pool_load_out_f32_lane(val, members[member], lane_base);
                [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
                    x[i] += val[i];
            } else {
                [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
                    x[i] += own[i];
            }
        }
        [[unroll]] for (uint i = 0u; i < LANE_E; ++i)
            x[i] = seismic_div_rn(x[i], float(POOL_RATE));
    }
    // A rounded row is rounded from values held in A: the pooled row, the
    // latent and the rotated row (`pooled.seismic`).
    const rounding_t trained =
        rounding_of(SEISMIC_PARAM_BLOCK, SEISMIC_PARAM_ELEMENT, SEISMIC_PARAM_SCALE, SEISMIC_PARAM_AMAX_FLOOR);
    rounding_hold_lanes(x, trained);
    // The latent: RMS-normed with `norm` (TN = 0); a token-normed row's is the
    // pooled row.
    if (!POOL_TOKEN_NORM) {
        head_rms_norm(x, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_1,
            element_word_f32(SEISMIC_PARAM_EPSILON), lane);
        rounding_hold_lanes(x, trained);
    }
    if (completing) {
        pool_out_put_lane(published, lane_base, SEISMIC_RESULT_0_STRIDE_1, x);
        if (lane == 0u)
            element_i32_put(latent_rows + row * SEISMIC_RESULT_1_STRIDE_0 * 4ul, destination);
    }
    // Rotated at the group's first token (a row that completes nothing at its
    // own coordinates, never stored), rounded, stored.
    const uint64_t origin = completing
        ? slab_row(SEISMIC_PTR(SEISMIC_BUFFER_WINDOW_COORDINATES), uint(POOL_MEMBER_ROW(0u)), window_slab_rows, 16ul)
        : SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES) + row * SEISMIC_COORDINATES_STRIDE_0 * 4ul;
    const uint64_t origin_stride = completing ? 1ul : SEISMIC_COORDINATES_STRIDE_1;
    if (completing && lane < 4u)
        element_i32_put(latent_coordinates + uint64_t(lane) * SEISMIC_RESULT_2_STRIDE_1 * 4ul,
            element_i32_at(origin + uint64_t(lane) * 4ul));
    const rotary_turns turns = rotary_lane_turns(origin, origin_stride, SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_COMPONENTS),
        SEISMIC_ROTARY_COMPONENTS_STRIDE_0, SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_FREQUENCIES),
        SEISMIC_ROTARY_FREQUENCIES_STRIDE_0, SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_AMPLITUDES),
        SEISMIC_ROTARY_AMPLITUDES_STRIDE_0, POOL_ROTARY, lane);
    rotary_lane_rotate(x, turns, POOL_ROTARY, lane);
    rounding_hold_lanes(x, trained);
    rounding_lanes(x, trained);
    // Stored in the row element Y (A holds every rounded value; F32 keys hold every value).
    if (completing) {
        const Out target = slab_out_row(SEISMIC_OUT_BLOCK_ROWS, uint(destination),
            uint(SEISMIC_PARAM_BLOCK_SLAB_ROWS), uint64_t(POOL_W));
        pool_out_put_lane(target, lane_base, 1ul, x);
    }
}
