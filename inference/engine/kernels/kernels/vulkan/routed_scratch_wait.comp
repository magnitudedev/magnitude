// Expert streaming, one round of a scratch fill (`routed_scratch_wait` in
// routed.seismic); the Vulkan form of `metal/routed_scratch_wait.metal`:
// invocation 0 requests the round's lane of the step's slot of the layer's
// scratch table (which the host requested already, as the device reached
// the park before the call), then reads its answer (streaming/round.hpp).
#include "lib/streaming/control.glsl"
#include "../streaming/round.hpp"

void routed_scratch_wait() {
    if (gl_LocalInvocationIndex != 0u)
        return;
    streaming_round_wait(streaming_step(SEISMIC_PTR(SEISMIC_BUFFER_STEP), SEISMIC_STEP_STRIDE_0),
        uint64_t(SEISMIC_PARAM_ROUND), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH));
}
