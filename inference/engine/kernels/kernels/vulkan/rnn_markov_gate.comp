// rnn_markov_gate: fused DSpark MarkovHead::RnnHidden recurrent gate step.
// Publishes (h_next [S, R] f32, h_next_a [S, R] A, latent [S, R] A).
#define KERNEL_A SEISMIC_ELEMENT_A
#include "lib/core/activation.glsl"
#include "lib/core/precise.glsl"

void rnn_markov_gate() {
    const uint64_t r = uint64_t(gl_WorkGroupID.x) * uint64_t(gl_WorkGroupSize.x) + uint64_t(gl_LocalInvocationIndex);
    const uint64_t r_dim = SEISMIC_DIM_R;
    if (r >= r_dim)
        return;
    const uint64_t r1 = r + r_dim;
    const uint64_t r2 = r + 2ul * r_dim;

    const uint64_t h_prev = SEISMIC_PTR(SEISMIC_BUFFER_H_PREV);
    const uint64_t base_frnn = SEISMIC_PTR(SEISMIC_BUFFER_BASE_FRNN);
    const uint64_t base_x = SEISMIC_PTR(SEISMIC_BUFFER_BASE_X);
    const uint64_t he_h = SEISMIC_PTR(SEISMIC_BUFFER_HE_H);
    const uint64_t he_e = SEISMIC_PTR(SEISMIC_BUFFER_HE_E);

    const Out h_next = SEISMIC_RESULT_0_OUT;
    const Out h_next_a = SEISMIC_RESULT_1_OUT;
    const Out latent = SEISMIC_RESULT_2_OUT;

    for (uint64_t s = uint64_t(gl_WorkGroupID.y); s < SEISMIC_DIM_S; s += uint64_t(gl_NumWorkGroups.y)) {
        const uint64_t bf_row = s * SEISMIC_BASE_FRNN_STRIDE_0;
        const uint64_t bx_row = s * SEISMIC_BASE_X_STRIDE_0;
        const uint64_t hh_row = s * SEISMIC_HE_H_STRIDE_0;
        const uint64_t he_row = s * SEISMIC_HE_E_STRIDE_0;

        const float g0 = element_f32_at(base_frnn + (bf_row + r * SEISMIC_BASE_FRNN_STRIDE_1) * 4ul)
                       + element_f32_at(base_x + (bx_row + r * SEISMIC_BASE_X_STRIDE_1) * 4ul)
                       + element_f32_at(he_h + (hh_row + r * SEISMIC_HE_H_STRIDE_1) * 4ul)
                       + element_f32_at(he_e + (he_row + r * SEISMIC_HE_E_STRIDE_1) * 4ul);
        const float g1 = element_f32_at(base_frnn + (bf_row + r1 * SEISMIC_BASE_FRNN_STRIDE_1) * 4ul)
                       + element_f32_at(base_x + (bx_row + r1 * SEISMIC_BASE_X_STRIDE_1) * 4ul)
                       + element_f32_at(he_h + (hh_row + r1 * SEISMIC_HE_H_STRIDE_1) * 4ul)
                       + element_f32_at(he_e + (he_row + r1 * SEISMIC_HE_E_STRIDE_1) * 4ul);
        const float g2 = element_f32_at(base_frnn + (bf_row + r2 * SEISMIC_BASE_FRNN_STRIDE_1) * 4ul)
                       + element_f32_at(base_x + (bx_row + r2 * SEISMIC_BASE_X_STRIDE_1) * 4ul)
                       + element_f32_at(he_h + (hh_row + r2 * SEISMIC_HE_H_STRIDE_1) * 4ul)
                       + element_f32_at(he_e + (he_row + r2 * SEISMIC_HE_E_STRIDE_1) * 4ul);

        const float hp = element_f32_at(h_prev + (s * SEISMIC_H_PREV_STRIDE_0 + r * SEISMIC_H_PREV_STRIDE_1) * 4ul);
        const float gate = seismic_div_rn(1.0, 1.0 + precise_exp(-g0));
        const float cand = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * g1)) - 1.0;
        const float next = gate * hp + (1.0 - gate) * cand;
        const float lat = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * g2)) - 1.0;

        out_put(h_next, s * SEISMIC_RESULT_0_STRIDE_0 + r * SEISMIC_RESULT_0_STRIDE_1, next);
        out_put(h_next_a, s * SEISMIC_RESULT_1_STRIDE_0 + r * SEISMIC_RESULT_1_STRIDE_1, next);
        out_put(latent, s * SEISMIC_RESULT_2_STRIDE_0 + r * SEISMIC_RESULT_2_STRIDE_1, lat);
    }
}
