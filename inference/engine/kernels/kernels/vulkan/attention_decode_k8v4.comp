#define ATTENTION_AFFINE_HISTORY 1
#define ATTENTION_KEY_CODE_WORDS SEISMIC_DIM_KC
#define ATTENTION_VALUE_CODE_WORDS SEISMIC_DIM_VC
#define ATTENTION_KEY_COEFFICIENTS SEISMIC_DIM_KP
#define ATTENTION_QUERY_GROUP SEISMIC_DIM_G
// attention_decode_k8v4: split-KV decode attention over affine K8/V4 history.
// The Vulkan form of `metal/attention_decode_k8v4.metal`: the partitioning,
// subgroup walk and merge of `attention_decode`.
//
// L1: workgroup (kv head, partition, row). History keys score as the sum over
// groups of scale * (q . code) + zero * sum(q). In the vector form each lane
// holds W / 32 columns of every key, and values accumulate (p * scale) * code
// plus the carried bias sum(p * zero) of each lane's group
// (`history_absorb_affine`), so no history element is decoded. In the keywise
// form (KEYWISE, `history_keywise_absorb`) lane t scores key t of each 32-key
// batch over the whole width, so a score needs no subgroup reduction, and
// each lane decodes its value columns (code * scale + zero) as it accumulates
// them. A key has one value, the one history will hold: the fresh span's
// keys (prepared, rounded to A) and values are encoded in registers
// (`history_quantize`) and absorbed by the same path as history's, in the
// keywise form through the staging tile (`history_keywise_fresh_*`). The
// bias joins the output once, after the walk. Partition 0 of a layer with
// fresh rows appends the row's key and value encoded (`history_hold`).
//
// Both the vector and keywise forms read a key group's keys through its cursor
// (`attention_cursor`) in batches at fixed positions of the row's sequence
// across slab edges, spans and the fresh edge, and the matrix form puts every
// tile row on its own key grid, so under one specialization a row's result is
// bit for bit the same whatever rows share its launch and whichever of its
// keys are still fresh.
//
// Shared words: the subgroup states [SIMDS][G / SLICES][2] (floats), then the
// prepared queries: in the vector form [ceil(G / 2)][W] (two activation-dtype
// heads per word, as `attention_decode`); in the keywise form, from a 16-byte
// boundary, [G][W] (floats), the subgroups' weights [SIMDS][32][G / SLICES]
// (floats), the query group sums [G][W / 32] (floats) and, from a 16-byte
// boundary, the subgroups' staging tiles [SIMDS][32][HISTORY_STAGE_PITCH]
// (uvec4). The merge columns [SIMDS][W] (floats) alias them: every subgroup
// has finished its walk before the publication's first barrier.
#define ATTENTION_HEADS uint(SEISMIC_DIM_G / SEISMIC_TUNE_SLICES)
#define ATTENTION_I uint(SEISMIC_DIM_I)
#define ATTENTION_U uint(SEISMIC_DIM_U)
#define ATTENTION_FRESH (SEISMIC_DIM_F != 0)
#define ATTENTION_QUERY_NORM (SEISMIC_DIM_NQ != 0)
#define ATTENTION_NORM (SEISMIC_DIM_N != 0)
#define ATTENTION_STORED_KEY (SEISMIC_DIM_VK != 0)
#define ATTENTION_KEY_ROUNDING rounding_none()
#define ATTENTION_VALUE_NORM (SEISMIC_DIM_NV != 0)
#define ATTENTION_SOFTPLUS (SEISMIC_PARAM_GATE_FUNCTION != 0)
#define ATTENTION_QUERY_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_QUERY)
#define ATTENTION_GATE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_GATE)
#define ATTENTION_AMPLITUDE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_AMPLITUDES)
#define ATTENTION_VALUE_NORM_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_VALUE_NORM)
// The query heads' sink logits (SK = 1), joined at every normalization.
#define ATTENTION_SINKS (SEISMIC_DIM_SK != 0)
#define ATTENTION_SINK_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SINKS)
// Both forms' shared code (an entry's includes expand once, whatever the
// branch).
#include "lib/attention/history.glsl"

#if SEISMIC_TUNE_MATRIX
// The grouped-query matrix form: the prefill body's L2 over decode rows
// (`lib/attention/prefill.glsl`, PREFILL_DECODE), 16 matrix rows per
// subgroup; history tiles are staged as f16, fresh tiles from their encoding
// decoded the same way (`history_hold`), and the products are cooperative
// matrices.
#define PREFILL_DECODE
#define PREFILL_ROWS (16u * uint(SEISMIC_TUNE_SIMDS))
#define PREFILL_PARTS uint(SEISMIC_TUNE_PARTS)
#define PREFILL_SPAN SEISMIC_TUNE_SPAN
#include "lib/attention/prefill.glsl"

void attention_decode_k8v4_partial() {
    prefill_attend(attention_affine_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY_CODES),
        SEISMIC_OUT_HISTORY_KEY_COEFFICIENTS, SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE_CODES),
        SEISMIC_OUT_HISTORY_VALUE_COEFFICIENTS),
        prefill_scratch(0ul, 0ul, 0ul, 0ul, 0ul));
}

void attention_decode_k8v4_merge() { prefill_decode_merge(); }

#else

// The prepared queries pack two activation elements per shared word.
#if !defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) && !defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#error "attention_decode_k8v4 requires a bf16 or f16 activation"
#endif

#define DECODE_KEYWISE (SEISMIC_TUNE_KEYWISE != 0)

// That row as history holds it: this lane's codes and its group's (scale,
// zero) pair (`history_quantize`, as `history_hold` encodes the row it appends).
void decode_fresh_codes(const bool is_key, uint64_t token, uint kv_head, out uint w[HISTORY_LANE_WORDS],
    out vec2 sz) {
    float x[ATTENTION_E];
    history_fresh_row(is_key, token, kv_head, SEISMIC_LANE, x);
    history_quantize(is_key ? HISTORY_KEY_BITS : HISTORY_VALUE_BITS, x, w, sz);
}

// A key group's planes: its cursor's slab's key and value code rows and
// (scale, zero) pair rows, from the cursor's kv head.
struct decode_planes {
    uint64_t key_rows;
    uint64_t value_rows;
    Stored key_pairs;
    Stored value_pairs;
};

// Moves `c` onto historical key `position` (< fresh_first) of `row`'s
// sequence, updating `p` when its slab changes, sets `first` to that key's
// four plane sources for `kv_head`, and returns how many consecutive keys
// from `position` up to `end` lie in the same span and slab (`decode_step`).
uint decode_historical_run(inout attention_cursor c, inout decode_planes p, attention_history h, uint64_t row,
    uint kv_head, uint position, uint end, out history_source first) {
    const uint64_t key_bytes = uint64_t(history_row_words(HISTORY_KEY_BITS)) * 4ul;
    const uint64_t value_bytes = uint64_t(history_row_words(HISTORY_VALUE_BITS)) * 4ul;
    const uint64_t pair_elements = 2ul * uint64_t(HISTORY_PAIRS);
    bool moved;
    const uint64_t index = attention_cursor_seek(c, SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE),
        SEISMIC_PTR(SEISMIC_BUFFER_FRESH), row, SEISMIC_DIM_R, 0u, h.slab_rows, position, moved);
    if (moved)
        p = decode_planes(slab_region(h.key_codes, c.slab) + uint64_t(kv_head) * key_bytes,
            slab_region(h.value_codes, c.slab) + uint64_t(kv_head) * value_bytes,
            out_stored(slab_out_region(h.key_coefficients, c.slab), uint64_t(kv_head) * pair_elements),
            out_stored(slab_out_region(h.value_coefficients, c.slab), uint64_t(kv_head) * pair_elements));
    const uint64_t step = (index - c.slab_lo) * uint64_t(ATTENTION_KV);
    first = history_source(p.key_rows + step * key_bytes, stored_offset(p.key_pairs, step * pair_elements),
        p.value_rows + step * value_bytes, stored_offset(p.value_pairs, step * pair_elements));
    const uint span_run = min(c.offset + c.count, end) - position;
    return uint(min(uint64_t(span_run), c.slab_hi - index));
}

history_source decode_step(history_source s, uint i) {
    const uint64_t vectors = uint64_t(i) * ATTENTION_KV;
    const uint64_t key_bytes = uint64_t(history_row_words(HISTORY_KEY_BITS)) * 4ul;
    const uint64_t value_bytes = uint64_t(history_row_words(HISTORY_VALUE_BITS)) * 4ul;
    const uint64_t pair_elements = 2ul * uint64_t(HISTORY_PAIRS);
    return history_source(s.key_row + vectors * key_bytes, stored_offset(s.key_pairs, vectors * pair_elements),
        s.value_row + vectors * value_bytes, stored_offset(s.value_pairs, vectors * pair_elements));
}

// Resolves `hist_n` historical keys [position, position + hist_n) for a
// keywise subgroup (`fallback` when `hist_n` is 0): true when all lie in one
// span and slab from `first`, else lane t's key (repeating the last) in
// `own_source`.
bool decode_keywise_history(inout attention_cursor c, inout decode_planes p, inout history_source fallback,
    attention_history h, uint64_t row, uint kv_head, uint position, uint hist_n, out history_source first,
    out history_source own_source) {
    if (hist_n == 0u) {
        first = fallback;
        own_source = fallback;
        return true;
    }
    const uint run = decode_historical_run(c, p, h, row, kv_head, position, position + hist_n, first);
    fallback = first;
    own_source = first;
    if (run == hist_n)
        return true;
    const uint own = position + min(SEISMIC_LANE, hist_n - 1u);
    if (own < position + run)
        own_source = decode_step(first, own - position);
    for (uint at = position + run; at < position + hist_n;) {
        history_source next_part;
        const uint next_run = decode_historical_run(c, p, h, row, kv_head, at, position + hist_n, next_part);
        if (own >= at && own < at + next_run)
            own_source = decode_step(next_part, own - at);
        at += next_run;
    }
    return false;
}

// Key `position` of `row`'s sequence (at or past the cursor's,
// `attention_cursor`) for `kv_head`, as this lane's codes and its group's
// (scale, zero) pair: a history row as stored, from the cursor's slab's
// planes `p` (resolved again only when the cursor's slab moves), or a fresh
// row as its append encodes it (`decode_fresh_codes`). The whole subgroup
// calls it.
void decode_read_codes(inout attention_cursor c, inout decode_planes p, attention_history h, uint64_t row,
    uint kv_head, uint position, out uint k[HISTORY_LANE_WORDS], out vec2 kc, out uint v[HISTORY_LANE_WORDS],
    out vec2 vc) {
    bool moved;
    const uint64_t index = attention_cursor_seek(c, SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE),
        SEISMIC_PTR(SEISMIC_BUFFER_FRESH), row, SEISMIC_DIM_R, 0u, h.slab_rows, position, moved);
    if (c.span < SEISMIC_DIM_R) {
        const uint64_t key_bytes = uint64_t(history_row_words(HISTORY_KEY_BITS)) * 4ul;
        const uint64_t value_bytes = uint64_t(history_row_words(HISTORY_VALUE_BITS)) * 4ul;
        const uint64_t pair_elements = 2ul * uint64_t(HISTORY_PAIRS);
        if (moved)
            p = decode_planes(slab_region(h.key_codes, c.slab) + uint64_t(kv_head) * key_bytes,
                slab_region(h.value_codes, c.slab) + uint64_t(kv_head) * value_bytes,
                out_stored(slab_out_region(h.key_coefficients, c.slab), uint64_t(kv_head) * pair_elements),
                out_stored(slab_out_region(h.value_coefficients, c.slab), uint64_t(kv_head) * pair_elements));
        const uint64_t step = (index - c.slab_lo) * uint64_t(ATTENTION_KV);
        const uint64_t pair = 2ul * (step * uint64_t(HISTORY_PAIRS) + uint64_t(SEISMIC_LANE / HISTORY_PAIR_LANES));
        history_lane_load(HISTORY_KEY_BITS, p.key_rows + step * key_bytes, SEISMIC_LANE, k);
        history_lane_load(HISTORY_VALUE_BITS, p.value_rows + step * value_bytes, SEISMIC_LANE, v);
        kc = stored_at2(p.key_pairs, pair);
        vc = stored_at2(p.value_pairs, pair);
        return;
    }
    decode_fresh_codes(true, index, kv_head, k, kc);
    decode_fresh_codes(false, index, kv_head, v, vc);
}

void attention_decode_k8v4_partial() {
    const uint64_t amplitudes = ATTENTION_AMPLITUDE_BUFFER;
    const uint64_t query_norm = SEISMIC_PTR(SEISMIC_BUFFER_QUERY_NORM);
    const uint64_t components = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_COMPONENTS);
    const uint64_t frequencies = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_FREQUENCIES);
    const uint64_t coordinates = SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES);
    const uint64_t visible = SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE);
    const uint64_t fresh = SEISMIC_PTR(SEISMIC_BUFFER_FRESH);
    const uint64_t destinations = SEISMIC_PTR(SEISMIC_BUFFER_DESTINATIONS);
    const attention_history h = attention_affine_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY_CODES),
        SEISMIC_OUT_HISTORY_KEY_COEFFICIENTS, SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE_CODES),
        SEISMIC_OUT_HISTORY_VALUE_COEFFICIENTS);
    const uint W = ATTENTION_W, E = ATTENTION_E, KV = ATTENTION_KV, G = ATTENTION_G;
    const uint simds = SEISMIC_SUBGROUPS, sg = SEISMIC_SUBGROUP, lane = SEISMIC_LANE;
    const uint64_t spans = SEISMIC_DIM_R;
    const uint kv_head = gl_WorkGroupID.x;
    const uint part = gl_WorkGroupID.y;
    const uint64_t row = gl_WorkGroupID.z;
    const float epsilon = element_word_f32(SEISMIC_PARAM_EPSILON);
    const float scale = element_word_f32(SEISMIC_PARAM_SCALE);
    const uint64_t row_coordinates = coordinates + row * 16ul;
    const uint64_t key_bytes = uint64_t(history_row_words(HISTORY_KEY_BITS)) * 4ul;
    const uint64_t value_bytes = uint64_t(history_row_words(HISTORY_VALUE_BITS)) * 4ul;
    const uint64_t pair_elements = 2ul * uint64_t(HISTORY_PAIRS);

    // Plane 0 (the key) and plane 1 (the value) append from subgroups 0 and 1,
    // or both from a workgroup's one subgroup.
    if (ATTENTION_FRESH && part == 0u) {
        const int destination = element_i32_at(destinations + row * 4ul);
        for (uint plane = sg; destination >= 0 && plane < 2u; plane += simds) {
            float x[ATTENTION_E];
            history_fresh_row(plane == 0u, row, kv_head, lane, x);
            history_hold(h, plane == 0u, destination, kv_head, lane, false, x);
        }
    }

    const uint total = attention_visible_total(visible, fresh, row, spans);
    const uint span_keys = attention_partition_span(total, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
    const uint partition_lo = part * span_keys;
    if (partition_lo >= total)
        return;
    const uint partition_hi = min(partition_lo + span_keys, total);

    const uint states = 0u;
    const uint columns = states + simds * ATTENTION_HEADS * 2u;
    // Keywise queries are read as vec4: 16-byte aligned.
    const uint prepared = DECODE_KEYWISE ? (columns + 3u) & ~3u : columns;
    const uint weights = prepared + G * W + sg * ATTENTION_KEYS * ATTENTION_HEADS;
    const uint sums = prepared + G * W + simds * ATTENTION_KEYS * ATTENTION_HEADS;
    // This subgroup's staging tile (a uvec4 index).
    const uint staging = (sums + G * HISTORY_PAIRS + 3u) / 4u + sg * ATTENTION_KEYS * HISTORY_STAGE_PITCH;
    const float query_scale = scale * ATTENTION_LOG2E;
    const uint64_t act_bytes = uint64_t(ELEMENT_BYTES(ELEMENT_ACT));
    if (DECODE_KEYWISE) {
        // Each head's prepared queries as F32, and their group sums.
        for (uint head = sg; head < G; head += simds) {
            float x[ATTENTION_E];
            attention_prepare(ATTENTION_QUERY_BUFFER + ((row * KV * G + kv_head * G + head)
                * ATTENTION_QUERY_STRIDE) * act_bytes, ATTENTION_QUERY_NORM, query_norm,
                row_coordinates, components, frequencies, amplitudes, epsilon, lane, rounding_none(), x);
            float sum = 0.0;
            [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i) {
                const float q = element_round(ELEMENT_ACT, x[i]) * query_scale;
                seismic_shared_f32[prepared + head * W + lane * E + i] = q;
                sum += q;
            }
            // The group's HISTORY_PAIR_LANES neighbouring lanes.
            [[unroll]] for (uint offset = 1u; offset < 32u; offset *= 2u)
                if (offset < HISTORY_PAIR_LANES)
                    sum += subgroupShuffleXor(sum, offset);
            if (lane % HISTORY_PAIR_LANES == 0u)
                seismic_shared_f32[sums + head * HISTORY_PAIRS + lane / HISTORY_PAIR_LANES] = sum;
        }
    } else {
        // Head pair p's prepared queries share words: head 2p in the low
        // half, head 2p + 1 in the high half.
        for (uint pair = sg; pair < (G + 1u) / 2u; pair += simds) {
            float low[ATTENTION_E];
            float high[ATTENTION_E];
            attention_prepare(ATTENTION_QUERY_BUFFER + ((row * KV * G + kv_head * G + 2u * pair)
                * ATTENTION_QUERY_STRIDE) * act_bytes, ATTENTION_QUERY_NORM, query_norm,
                row_coordinates, components, frequencies, amplitudes, epsilon, lane, rounding_none(), low);
            if (2u * pair + 1u < G)
                attention_prepare(ATTENTION_QUERY_BUFFER + ((row * KV * G + kv_head * G + 2u * pair + 1u)
                    * ATTENTION_QUERY_STRIDE) * act_bytes, ATTENTION_QUERY_NORM, query_norm,
                    row_coordinates, components, frequencies, amplitudes, epsilon, lane, rounding_none(), high);
            else
                [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
                    high[i] = 0.0;
            [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
                seismic_shared_u32[prepared + pair * W + lane * E + i] =
                    element_store(ELEMENT_ACT, low[i]) | (element_store(ELEMENT_ACT, high[i]) << 16u);
        }
    }
    barrier();
    const uint head0 = attention_slice(sg) * ATTENTION_HEADS;
    // The vector form holds the queries in registers throughout.
    float q[ATTENTION_HEADS][ATTENTION_E];
    float qsum[ATTENTION_HEADS];
    float maximum[ATTENTION_HEADS];
    float denominator[ATTENTION_HEADS];
    float result[ATTENTION_HEADS][ATTENTION_E];
    float bias[ATTENTION_HEADS];
    [[unroll]] for (uint g = 0u; g < ATTENTION_HEADS; ++g) {
        const uint head = head0 + g;
        float sum = 0.0;
        [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i) {
            if (!DECODE_KEYWISE) {
                const uint word = seismic_shared_u32[prepared + (head / 2u) * W + lane * E + i];
                q[g][i] = element_load(ELEMENT_ACT, (word >> (16u * (head % 2u))) & 0xffffu) * query_scale;
                sum += q[g][i];
            }
            result[g][i] = 0.0;
        }
        qsum[g] = sum;
        maximum[g] = -ATTENTION_INF;
        denominator[g] = 0.0;
        bias[g] = 0.0;
    }

    // Each key group walks its contiguous sub-range of the partition in
    // batches at fixed positions from its first key: every subgroup in a
    // keywise workgroup runs the busiest group's batch count and the same
    // workgroup-uniform fresh-step count so all subgroups pass identical
    // subgroup barriers (NVIDIA 570 miscompiles subgroup-divergent barrier
    // counts).
    const uvec2 range = attention_key_range(partition_lo, partition_hi, attention_key_group(sg));
    if (DECODE_KEYWISE) {
        int fresh_lo, fresh_hi;
        attention_span(visible, fresh, row, spans, spans, fresh_lo, fresh_hi);
        const uint fresh_first = total - uint(max(fresh_hi - fresh_lo, 0));
        const bool has_history = partition_lo < fresh_first;
        uint busiest = 0u;
        for (uint group = 0u; group < attention_key_groups(); ++group) {
            const uvec2 keys = attention_key_range(partition_lo, partition_hi, group);
            busiest = max(busiest, (keys.y - keys.x + ATTENTION_KEYS - 1u) / ATTENTION_KEYS);
        }
        const uint hist_end = min(range.y, fresh_first);
        const bool sg_has_history = range.x < hist_end;
        attention_cursor c =
            attention_cursor_at(visible, fresh, row, spans, 0u, sg_has_history ? range.x : partition_lo);
        const Stored empty_pairs = stored_at_buffer(ELEMENT_F16, 0ul);
        decode_planes planes = decode_planes(0ul, 0ul, empty_pairs, empty_pairs);
        history_source fallback = history_source(0ul, empty_pairs, 0ul, empty_pairs);
        if (has_history && !sg_has_history)
            decode_historical_run(c, planes, h, row, kv_head, partition_lo, partition_lo + 1u, fallback);
        const uint64_t key_stride = uint64_t(KV) * key_bytes;
        const uint64_t value_stride = uint64_t(KV) * value_bytes;
        const uint64_t pair_stride = uint64_t(KV) * pair_elements;
        for (uint batch = 0u; batch < busiest; ++batch) {
            const uint position = range.x + batch * ATTENTION_KEYS;
            const uint n = position < range.y ? min(ATTENTION_KEYS, range.y - position) : 0u;
            const uint hist_n = position < hist_end ? min(ATTENTION_KEYS, hist_end - position) : 0u;
            uint batch_fresh_steps = 0u;
            if (ATTENTION_FRESH && partition_hi > fresh_first) {
                uint max_fresh = 0u;
                for (uint group = 0u; group < attention_key_groups(); ++group) {
                    const uvec2 keys = attention_key_range(partition_lo, partition_hi, group);
                    const uint b_lo = keys.x + batch * ATTENTION_KEYS;
                    const uint b_hi = min(keys.y, b_lo + ATTENTION_KEYS);
                    if (b_lo < b_hi && b_hi > fresh_first)
                        max_fresh = max(max_fresh, b_hi - max(b_lo, fresh_first));
                }
                batch_fresh_steps = (max_fresh + HISTORY_FRESH_KEYS - 1u) / HISTORY_FRESH_KEYS;
            }
            if (batch_fresh_steps == 0u) {
                history_source first, own_source;
                const bool contiguous =
                    decode_keywise_history(c, planes, fallback, h, row, kv_head, position, hist_n, first, own_source);
                history_keywise_absorb(n, contiguous, own_source, first.key_row, first.key_pairs, key_stride,
                    first.value_row, first.value_pairs, value_stride, pair_stride, staging, prepared, sums, head0,
                    weights, maximum, denominator, result);
            } else {
                const uint fresh_n = n - hist_n;
                const uint64_t fresh_row0 =
                    uint64_t(fresh_lo) + uint(fresh_n > 0u ? position + hist_n - fresh_first : 0u);
                const uint hist_last = max(hist_n, 1u) - 1u;
                history_source first = fallback, own_source = fallback;
                bool contiguous = true;
                float score[ATTENTION_HEADS];
                [[unroll]] for (uint g = 0u; g < ATTENTION_HEADS; ++g)
                    score[g] = 0.0;
                if (has_history) {
                    contiguous = decode_keywise_history(
                        c, planes, fallback, h, row, kv_head, position, hist_n, first, own_source);
                    history_keywise_score(hist_last, contiguous, own_source, first.key_row, key_stride,
                        stored_offset(first.key_pairs, uint64_t(min(lane, hist_last)) * pair_stride), staging,
                        prepared, sums, head0, score);
                }
                for (uint step = 0u; step < batch_fresh_steps; ++step) {
                    const uint step_base = step * HISTORY_FRESH_KEYS;
                    const uint step_n = fresh_n > step_base ? min(HISTORY_FRESH_KEYS, fresh_n - step_base) : 0u;
                    subgroupBarrier();
                    for (uint j = 0u; j < step_n; ++j) {
                        uint w[HISTORY_LANE_WORDS];
                        vec2 sz;
                        decode_fresh_codes(true, fresh_row0 + step_base + j, kv_head, w, sz);
                        history_keywise_fresh_key(j, w, sz, staging);
                    }
                    subgroupMemoryBarrierShared();
                    subgroupBarrier();
                    if (lane >= hist_n + step_base && lane < hist_n + step_base + step_n)
                        history_keywise_fresh_score(lane - hist_n - step_base, staging, prepared, sums, head0, score);
                }
                attention_keywise_softmax(n, score, weights, maximum, denominator, result);
                if (has_history) {
                    if (ATTENTION_W < 512u) {
                        uvec4 codes[HISTORY_VALUE_PIECES];
                        uint coefficients[HISTORY_PAIRS];
                        history_keywise_value_load(hist_last, contiguous, own_source, first.value_row, value_stride,
                            first.value_pairs, pair_stride, codes, coefficients);
                        history_keywise_value_store(contiguous, codes, coefficients, staging);
                    } else {
                        history_keywise_value_stage(hist_last, contiguous, own_source, first.value_row, value_stride,
                            first.value_pairs, pair_stride, staging);
                    }
                }
                for (uint j = 0u; j < fresh_n; ++j) {
                    uint w[HISTORY_LANE_WORDS];
                    vec2 sz;
                    decode_fresh_codes(false, fresh_row0 + j, kv_head, w, sz);
                    history_keywise_fresh_value(hist_n + j, w, sz, staging);
                }
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                history_keywise_values(n, staging, weights, result);
            }
        }
    } else {
        // The vector form takes the group's keys in batches of HISTORY_BATCH
        // at fixed positions range.x + i * HISTORY_BATCH of the row's
        // sequence (the last batch the rest), each read through its cursor:
        // history rows as stored, fresh rows as their append encodes them, so
        // a row's reduction order is set by its keys' positions alone.
        attention_cursor c = attention_cursor_at(visible, fresh, row, spans, 0u, range.x);
        const Stored empty_pairs = stored_at_buffer(ELEMENT_F16, 0ul);
        decode_planes planes = decode_planes(0ul, 0ul, empty_pairs, empty_pairs);
        for (uint position = range.x; position < range.y;) {
            const uint n = min(HISTORY_BATCH, range.y - position);
            uint k[HISTORY_BATCH][HISTORY_LANE_WORDS];
            uint v[HISTORY_BATCH][HISTORY_LANE_WORDS];
            vec2 kc[HISTORY_BATCH];
            vec2 vc[HISTORY_BATCH];
            [[unroll]] for (uint j = 0u; j < HISTORY_BATCH; ++j)
                if (j < n)
                    decode_read_codes(c, planes, h, row, kv_head, position + j, k[j], kc[j], v[j], vc[j]);
            history_absorb_affine(n, q, qsum, k, kc, v, vc, maximum, denominator, result, bias);
            position += n;
        }
    }
    [[unroll]] for (uint g = 0u; g < ATTENTION_HEADS; ++g)
        [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
            result[g][i] += bias[g];

    attention_publish(maximum, denominator, result, states, columns, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS), (row * KV + kv_head) * G * SEISMIC_TUNE_PARTS + part,
        SEISMIC_TUNE_PARTS);
}

// L2: workgroup (query head, row), one invocation per column: the
// fixed-order merge of the row's partitions and the output gate.
void attention_decode_k8v4_merge() {
    attention_decode_gate(ATTENTION_QUERY_BUFFER, ATTENTION_GATE_BUFFER, SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE),
        SEISMIC_PTR(SEISMIC_BUFFER_FRESH), SEISMIC_RESULT_0_OUT,
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS), SEISMIC_DIM_R,
        0u, gl_WorkGroupID.x, gl_WorkGroupID.y, gl_LocalInvocationIndex, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
}

