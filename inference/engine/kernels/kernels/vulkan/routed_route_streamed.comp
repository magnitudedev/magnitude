ROUTE_NUMERICAL
// Each lead's router GEMV (workgroup row y: 0 one layer ahead, 1 two).
void hint_routed_route_gemv() {
    if (gl_WorkGroupID.y == 0u)
        hint_route_gemv();
    else
        after_route_gemv();
}

// Each lead's ranking and hints (workgroup row y), into the lead's ring row.
void routed_route_hint() {
    const uint lead = gl_WorkGroupID.y;
    const uint64_t row = SEISMIC_SUBGROUP;
    if (row < SEISMIC_DIM_M) {
        float chosen[ROUTE_K];
        int winners[ROUTE_K];
        if (lead == 0u)
            hint_route_rank(row, chosen, winners);
        else
            after_route_rank(row, chosen, winners);
        if (SEISMIC_LANE == 0u)
            for (uint rank = 0u; rank < ROUTE_K; ++rank)
                seismic_shared_i32[uint(row) * ROUTE_K + rank] = winners[rank];
    }
    routed_hint_publish(lead);
}
