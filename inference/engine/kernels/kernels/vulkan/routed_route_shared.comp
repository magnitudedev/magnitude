// Decode routing with the shared expert's gate/up expansion (`routed_route_shared`)
// on the `dense` projection operator, segmented over
// `(router, shared_router, (shared_gate, shared_up))`.
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_ROUTER
#define KERNEL_W1 SEISMIC_SHARED_ROUTER
#define KERNEL_W2 SEISMIC_SHARED_GATE
#define KERNEL_W3 SEISMIC_SHARED_UP
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"
#include "lib/projection/projection.glsl"
#define ROUTE_E uint(SEISMIC_DIM_E)
#define ROUTE_STRIDE (uint(SEISMIC_DIM_E) + 1u)
#include "lib/routed/route.glsl"

#define ROUTE_NORM ELEMENT_OF(SEISMIC_NORM)

#if PACKETS_OPERANDS_NVFP4(SEISMIC_SHARED_GATE)
#define SHARED_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define SHARED_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif

#define ROUTE_H uint(SEISMIC_DIM_H)

projection_prologue projected_input(uint g) {
    return projection_ordered_input(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL),
        SEISMIC_RESIDUAL_STRIDE_0, SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM),
        SEISMIC_NORM_STRIDE_0, ROUTE_NORM, element_word_f32(SEISMIC_PARAM_EPS), ROUTE_H, 0ul,
        uint(SEISMIC_DIM_NM), uint(SEISMIC_DIM_PT));
}

projection_prologue projected_rows(uint g) {
    return projection_plain(ACTIVATION_A, out_stored(SEISMIC_RESULT_0_OUT, 0ul),
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, ROUTE_H, 0ul);
}

projection_prologue routed_segment_input(const uint s) {
    return s == 2u ? projection_operands(projected_input(0u), SHARED_OPERANDS) : projected_input(0u);
}

#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_K ROUTE_H
#define PROJECTION_NORM PROJECTION_NORM_SHARED
#define PROJECTION_ORDERED_PUBLISH true
#define PROJECTION_ORDERED_PUB_OUT SEISMIC_RESULT_0_OUT
#define PROJECTION_ORDERED_PUB_S0 SEISMIC_RESULT_0_STRIDE_0
#define PROJECTION_ORDERED_PUB_S1 SEISMIC_RESULT_0_STRIDE_1
#define PROJECTION_SEGMENT_INPUT(s) routed_segment_input(uint(s))
#define PROJECTION_N0 uint(SEISMIC_DIM_E)
#define PROJECTION_N1 1u
#define PROJECTION_N2 uint(SEISMIC_DIM_S)
#define PROJECTION_KIND2 PACKETS_W2
#define PROJECTION_PARTNER2 projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_UP), PACKETS_W3_ROWS, ROUTE_H, 0ul, 1ul, 0u)
#define PROJECTION_PARTNER_KIND2 PACKETS_W3
#define PROJECTION_WEIGHT0 projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_ROUTER), PACKETS_W0_ROWS, ROUTE_H, 0ul, 1ul, 0u)
#define PROJECTION_WEIGHT1 projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_ROUTER), PACKETS_W1_ROWS, ROUTE_H, 0ul, 1ul, 0u)
#define PROJECTION_WEIGHT2 projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_GATE), PACKETS_W2_ROWS, ROUTE_H, 0ul, 1ul, 0u)
#define PROJECTION_OUTPUT0 projection_store(out_over_scratch(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS)), SEISMIC_DIM_E + 1ul, 1ul, 0ul)
#define PROJECTION_OUTPUT1 projection_store(out_over_scratch(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS)), SEISMIC_DIM_E + 1ul, 1ul, SEISMIC_DIM_E)
#define PROJECTION_OUTPUT2 projection_silu_mul(ACTIVATION_A, SEISMIC_RESULT_2_OUT, SEISMIC_RESULT_2_STRIDE_0, SEISMIC_RESULT_2_STRIDE_1)
#include "lib/projection/ordered.glsl"

void routed_route_shared_ordered_gemv1() { projection_segmented_ordered_gemv_mixed(1u, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES); }
void routed_route_shared_ordered_gemv2() { projection_segmented_ordered_gemv_mixed(2u, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES); }
void routed_route_shared_ordered_gemv4() { projection_segmented_ordered_gemv_mixed(4u, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES); }
void routed_route_shared_ordered_gemv8() { projection_segmented_ordered_gemv_mixed(8u, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES); }

void routed_route_select() {
    const uint64_t row = uint64_t(gl_WorkGroupID.x) * SEISMIC_SUBGROUPS + SEISMIC_SUBGROUP;
    if (row < SEISMIC_DIM_M)
        route_select_row(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS), row);
}
