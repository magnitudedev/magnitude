// state_space_gate (contract and portable body in state_space.seismic): the
// state-space output rows, y * SiLU(z) RMS-normalized over each group of U
// heads and scaled by the state norm. The Vulkan form of
// `cuda/state_space_gate.cu`: a workgroup of 256 invocations per (row,
// group), strided lane chains, a logical-subgroup reduction, then the
// subgroup sums in order.
#include "lib/core/activation.glsl"

// The gated value of `channel` (in the row's flat head-major order).
float ssg_gated_value(uint64_t row, uint64_t channel) {
    const uint64_t head = channel / SEISMIC_DIM_P;
    const float gate = element_at(ELEMENT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_PROJECTION),
        row * SEISMIC_PROJECTION_STRIDE_0 + channel * SEISMIC_PROJECTION_STRIDE_1);
    const float value = element_at(ELEMENT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_MIXED),
        row * SEISMIC_MIXED_STRIDE_0 + head * SEISMIC_MIXED_STRIDE_1 + (channel % SEISMIC_DIM_P) * SEISMIC_MIXED_STRIDE_2);
    return seismic_mul_rn(value, seismic_div_rn(gate, 1.0 + exp(-gate)));
}

void state_space_gate() {
    const uint64_t state_norm = SEISMIC_PTR(SEISMIC_BUFFER_STATE_NORM);
    const uint64_t normalized = SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER);
    const uint64_t row = gl_WorkGroupID.x;
    const uint64_t width = SEISMIC_DIM_U * SEISMIC_DIM_P;
    const uint64_t first = uint64_t(gl_WorkGroupID.y) * width;
    const float epsilon = element_word_f32(SEISMIC_PARAM_EPSILON);
    float squares = 0.0;
    for (uint64_t column = gl_LocalInvocationIndex; column < width; column += gl_WorkGroupSize.x) {
        const float value = ssg_gated_value(row, first + column);
        squares = seismic_fma_rn(value, value, squares);
    }
    const float total = seismic_subgroup_sum_f32(squares);
    if (SEISMIC_LANE == 0u)
        seismic_shared_f32[SEISMIC_SUBGROUP] = total;
    barrier();
    float sum = 0.0;
    for (uint index = 0u; index < gl_WorkGroupSize.x / 32u; ++index)
        sum = seismic_add_rn(sum, seismic_shared_f32[index]);
    const float inverse = inversesqrt(seismic_div_rn(sum, float(width)) + epsilon);
    for (uint64_t column = gl_LocalInvocationIndex; column < width; column += gl_WorkGroupSize.x) {
        const uint64_t channel = first + column;
        const float weight = element_f32_at(state_norm + (uint64_t(gl_WorkGroupID.y) * SEISMIC_STATE_NORM_STRIDE_0
            + (column / SEISMIC_DIM_P) * SEISMIC_STATE_NORM_STRIDE_1 + (column % SEISMIC_DIM_P) * SEISMIC_STATE_NORM_STRIDE_2) * 4ul);
        const float value = ssg_gated_value(row, channel);
        element_put(ELEMENT_ACT, normalized,
            row * SEISMIC_RESULT_0_STRIDE_0 + (channel / SEISMIC_DIM_P) * SEISMIC_RESULT_0_STRIDE_1
                + (channel % SEISMIC_DIM_P) * SEISMIC_RESULT_0_STRIDE_2,
            seismic_mul_rn(seismic_mul_rn(value, inverse), weight));
    }
}
