#define ATTENTION_QUERY_GROUP SEISMIC_DIM_G
// attention_decode: split-KV decode attention over dense history. The Vulkan
// form of `metal/attention_decode.metal` over `lib/attention/attention.glsl`.
// A workgroup's query heads: one of the vector form's GROUPS groups of the
// kv head's G (all G at GROUPS 1); SLICES slices of them, one a subgroup.
#define ATTENTION_HEAD_GROUP uint(SEISMIC_DIM_G / SEISMIC_TUNE_GROUPS)
#define ATTENTION_HEADS (ATTENTION_HEAD_GROUP / uint(SEISMIC_TUNE_SLICES))
#define ATTENTION_I uint(SEISMIC_DIM_I)
#define ATTENTION_U uint(SEISMIC_DIM_U)
#define ATTENTION_FRESH (SEISMIC_DIM_F != 0)
#define ATTENTION_QUERY_NORM (SEISMIC_DIM_NQ != 0)
#define ATTENTION_NORM (SEISMIC_DIM_N != 0)
#define ATTENTION_STORED_KEY (SEISMIC_DIM_VK != 0)
#define ATTENTION_KEY_ROUNDING                                                                                 \
    (SEISMIC_DIM_KR != 0 ? rounding_of(SEISMIC_PARAM_KEY_BLOCK, SEISMIC_PARAM_KEY_ELEMENT, SEISMIC_PARAM_KEY_SCALE, \
                               SEISMIC_PARAM_KEY_AMAX_FLOOR)                                                    \
                         : rounding_none())
#define ATTENTION_VALUE_NORM (SEISMIC_DIM_NV != 0)
#define ATTENTION_SOFTPLUS (SEISMIC_PARAM_GATE_FUNCTION != 0)
#define ATTENTION_QUERY_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_QUERY)
#define ATTENTION_GATE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_GATE)
#define ATTENTION_AMPLITUDE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_AMPLITUDES)
#define ATTENTION_VALUE_NORM_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_VALUE_NORM)
// The query heads' sink logits (SK = 1), joined at every normalization.
#define ATTENTION_SINKS (SEISMIC_DIM_SK != 0)
#define ATTENTION_SINK_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SINKS)
// Both forms' shared code (an entry's includes expand once, whatever the
// branch).
#include "lib/attention/history.glsl"

attention_history decode_history() {
    return attention_dense_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY), SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE));
}

#if SEISMIC_TUNE_MATRIX
// The grouped-query matrix form: the prefill body's L2 over decode rows
// (`lib/attention/prefill.glsl`, PREFILL_DECODE), 16 matrix rows per
// subgroup; history tiles are staged as f16 and the products are cooperative
// matrices. A group whose prepared queries exceed the shared bytes takes
// them, and its fresh rows, from the prefill's L1 (PREFILL_PREPARED,
// `attention_decode_prepare`).
#define PREFILL_DECODE
#define PREFILL_ROWS (16u * uint(SEISMIC_TUNE_SIMDS))
#define PREFILL_PARTS uint(SEISMIC_TUNE_PARTS)
#define PREFILL_PREPARED (SEISMIC_STATIC_G * (2 * SEISMIC_STATIC_P + SEISMIC_STATIC_S) * 2 > 32768)
// A row's index-list picks (KS > 0), the last key tiles of its sequence.
#define PREFILL_PICKS (SEISMIC_DIM_KS != 0)
#define PREFILL_PICK_ROWS SEISMIC_PTR(SEISMIC_BUFFER_SELECTED_ROWS)
#define PREFILL_PICK_COUNT uint(SEISMIC_DIM_KS)
#define PREFILL_PICK_PLANE SEISMIC_PTR(SEISMIC_BUFFER_SELECTED)
#define PREFILL_PICK_SLAB_ROWS uint64_t(SEISMIC_PARAM_SELECTED_SLAB_ROWS)
#include "lib/attention/prefill.glsl"

// L1's planes (`attention_decode_prepare`, which runs only where
// PREFILL_PREPARED): the queries, the fresh keys and values, the queries'
// factors.
prefill_scratch decode_scratch() {
    return prefill_scratch(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_QUERIES), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_KEYS),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_VALUES), 0ul, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_QUERY_FACTORS));
}

void attention_decode_prepare() { prefill_prepare(decode_history(), decode_scratch()); }

void attention_decode_partial() { prefill_attend(decode_history(), decode_scratch()); }

void attention_decode_merge() { prefill_decode_merge(); }

#else
#include "lib/attention/vector.glsl"

// A row's index-list picks (KS), the last keys of its sequence.
#define DECODE_PICKS uint(SEISMIC_DIM_KS)

// L1: workgroup (kv head and head group, partition, row): the vector form's
// partial (`vector_partial`) over the kv head's GROUPS head groups.
void attention_decode_partial() {
    const uint groups = ATTENTION_G / ATTENTION_HEAD_GROUP;
    vector_partial(decode_history(), gl_WorkGroupID.x / groups, gl_WorkGroupID.x % groups, gl_WorkGroupID.y,
        gl_WorkGroupID.z, DECODE_PICKS, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
}

// L2: workgroup (query head, row), one invocation per column: the
// fixed-order merge of the row's partitions (of its visible keys and picks;
// with the head's sink when SK = 1) and the output gate.
void attention_decode_merge() {
    attention_decode_gate(ATTENTION_QUERY_BUFFER, ATTENTION_GATE_BUFFER, SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE),
        SEISMIC_PTR(SEISMIC_BUFFER_FRESH), SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS), SEISMIC_DIM_R,
        DECODE_PICKS, gl_WorkGroupID.x, gl_WorkGroupID.y, gl_LocalInvocationIndex, SEISMIC_TUNE_SPAN,
        SEISMIC_TUNE_PARTS);
}

// The vector form takes its queries in its own launch (its `where` and the
// prepare launch's `when`), so its specializations never launch L1.
void attention_decode_prepare() {}

#endif

void attention_decode_rotate() {
    attention_rotate_output(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES),
        SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_COMPONENTS), SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_FREQUENCIES),
        ATTENTION_AMPLITUDE_BUFFER);
}
