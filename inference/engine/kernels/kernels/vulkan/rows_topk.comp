// rows_topk on Vulkan (contract and portable body in indexer.seismic), as
// CUDA's (`cuda/rows_topk.cu`) and Metal's (`metal/rows_topk.metal`):
//
// A workgroup of TOPK_THREADS (1024) invocations per row (TOPK_ITEMS = 8,
// TOPK_CHUNK = 8192). The row's listed rows (the sum of its spans' lengths,
// scanned over chunks of 1024 spans) bound its scored ordinals, the first
// min(N, listed). A row that reads a prefix (dense, complete <= K, or with at
// most K scored ordinals) picks the first min(K, scored). A selecting row
// finds its K-th best score T by a radix select over the scores' order keys
// (`order_key`: a < b exactly when their keys are, -0.0 and 0.0 one key), a
// byte a pass from the top: each pass's histogram takes one atomic per
// distinct digit of a subgroup, and the digit is found by a scan of the bins.
// It picks every ordinal above T and the first equal ones in ordinal order
// (ranked by a scan of each invocation's count of equal ones): the K best,
// ties to the lower ordinal. The rest of the row's K picks are -1.
//
// When `scored <= TOPK_CHUNK` (8192), each invocation loads its contiguous
// share of TOPK_ITEMS (8) keys ONCE (vectorized `vec4` when unit-stride and
// 16-byte aligned) into registers and reuses them across all 4 radix passes
// and the final emit pass (1 global pass instead of 5). When
// `scored > TOPK_CHUNK`, the radix passes walk coalesced strided chunks of
// TOPK_CHUNK ordinals and the emit pass walks contiguous chunks with
// vectorized loads, carrying `ranked` and `placed` across chunks.
//
// The workgroup scans are `reduce_group_exclusive_add`. Group memory (u32):
// the bins [256], the scans' 32 subgroup sums, the select state [4] and one
// chunk's span offsets [1024], whatever R is (when R <= 1024 the initial scan
// populates all span offsets once; larger R re-scans in chunks of 1024):
// nothing the row's spans give is exchanged through device memory.
#include <seismic/element.glsl>
#include "lib/core/order.glsl"
#include "lib/core/reduce.glsl"
#include "lib/indexer/indexer.glsl"

#define TOPK_THREADS 1024u
#define TOPK_ITEMS 8u
#define TOPK_CHUNK (TOPK_THREADS * TOPK_ITEMS)
#define TOPK_BINS 0u
#define TOPK_SCAN 256u
#define TOPK_STATE 288u
#define TOPK_OFFSETS 292u

uint64_t topk_scores;

uint topk_key(uint ordinal) {
    return order_key(element_f32_at(topk_scores + uint64_t(ordinal) * SEISMIC_SCORES_STRIDE_1 * 4ul));
}

void topk_load_contiguous_keys(bool vec4_aligned, uint lo, uint scored, out uint keys[TOPK_ITEMS]) {
    if (vec4_aligned && lo < scored && scored - lo >= TOPK_ITEMS) {
        const vec4 v0 = element_vec4_at(topk_scores + uint64_t(lo) * 4ul);
        const vec4 v1 = element_vec4_at(topk_scores + uint64_t(lo + 4u) * 4ul);
        keys[0] = order_key(v0.x);
        keys[1] = order_key(v0.y);
        keys[2] = order_key(v0.z);
        keys[3] = order_key(v0.w);
        keys[4] = order_key(v1.x);
        keys[5] = order_key(v1.y);
        keys[6] = order_key(v1.z);
        keys[7] = order_key(v1.w);
    } else {
        [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i)
            keys[i] = lo + i < scored ? topk_key(lo + i) : 0u;
    }
}

// One group-memory atomic per distinct digit of the subgroup: the first
// pending lane's digit, counted over the lanes holding it. The rounds are
// steered while any lane of the hardware subgroup is pending, so its logical
// subgroups (two on 64-lane hardware) leave together; one with none pending
// adds nothing.
void topk_subgroup_histogram_add(uint key, uint shift, bool pending) {
    const uint value = (key >> shift) & 255u;
    bool counting;
    for (uint lanes = seismic_ballot(pending); seismic_steer(counting, lanes != 0u);
            lanes = seismic_ballot(pending)) {
        const uint leader = counting ? uint(findLSB(lanes)) : 0u;
        const uint chosen = seismic_shuffle(value, leader);
        const uint holding = seismic_ballot(pending && value == chosen);
        if (counting && SEISMIC_LANE == leader)
            atomicAdd(seismic_shared_u32[TOPK_BINS + chosen], uint(bitCount(holding)));
        pending = pending && value != chosen;
    }
}

void rows_topk() {
    const uint64_t row = gl_WorkGroupID.x;
    const uint thread = SEISMIC_THREAD;
    const uint n = uint(SEISMIC_DIM_N);
    const uint k = uint(SEISMIC_DIM_K);
    const uint r = uint(SEISMIC_DIM_R);
    if (k == 0u)
        return;
    const uint64_t spans = SEISMIC_PTR(SEISMIC_BUFFER_SPANS) + row * SEISMIC_SPANS_STRIDE_0 * 4ul;
    const uint64_t span_stride = SEISMIC_SPANS_STRIDE_1;
    const uint64_t bound_stride = SEISMIC_SPANS_STRIDE_2;
    topk_scores = SEISMIC_PTR(SEISMIC_BUFFER_SCORES) + row * SEISMIC_SCORES_STRIDE_0 * 4ul;
    const bool vec4_aligned = SEISMIC_SCORES_STRIDE_1 == 1ul && (topk_scores & 15ul) == 0ul;
    const uint64_t result = SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER) + row * SEISMIC_RESULT_0_STRIDE_0 * 4ul;
    const uint64_t result_stride = SEISMIC_RESULT_0_STRIDE_1 * 4ul;
    uint total = 0u;

    // The select's first bins and state, here so that no group-memory store
    // follows a scan's reads before a barrier: every invocation reads the
    // listed rows alike.
    if (thread < 256u)
        seismic_shared_u32[TOPK_BINS + thread] = 0u;
    if (thread == 0u) {
        seismic_shared_u32[TOPK_STATE] = 0u;
        seismic_shared_u32[TOPK_STATE + 1u] = k;
    }

    // The row's listed rows: its spans' lengths, summed over chunks of 1024.
    uint listed = 0u;
    uint first_offset = 0u;
    for (uint base = 0u; base < r; base += TOPK_THREADS) {
        const uint span = base + thread;
        const uint length = span < r ? indexer_span_length_at(spans, span_stride, bound_stride, span) : 0u;
        uint chunk;
        const uint offset = reduce_group_exclusive_add(length, TOPK_SCAN, chunk);
        if (base == 0u)
            first_offset = offset;
        listed += chunk;
    }
    const uint scored = min(listed, n);

    // When all spans fit in one chunk, keep their offsets in group memory so
    // the emit pass bisects them directly without re-scanning `spans`. The
    // barrier keeps the store out of the scan's read interval.
    if (r <= TOPK_THREADS) {
        barrier();
        seismic_shared_u32[TOPK_OFFSETS + thread] = first_offset;
    }

    // A prefix row picks its first `limit` ordinals; a selecting row those
    // above `threshold` and the first `take` equal to it.
    const int complete = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_COMPLETE) + row * SEISMIC_COMPLETE_STRIDE_0 * 4ul);
    const bool prefix = complete <= int(k) || scored <= k;
    const uint limit = min(scored, k);
    const bool single_chunk = scored <= TOPK_CHUNK;
    uint keys[TOPK_ITEMS];
    if (single_chunk && !prefix)
        topk_load_contiguous_keys(vec4_aligned, thread * TOPK_ITEMS, scored, keys);
    uint threshold = 0u;
    uint take = 0u;
    if (!prefix) {
        uint mask = 0u;
        for (int digit = 3; digit >= 0; --digit) {
            barrier();
            const uint prefix_bits = seismic_shared_u32[TOPK_STATE];
            const uint remaining = seismic_shared_u32[TOPK_STATE + 1u];
            const uint shift = uint(digit) * 8u;
            if (single_chunk) {
                const uint lo = thread * TOPK_ITEMS;
                [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i) {
                    const bool pending = lo + i < scored && (keys[i] & mask) == prefix_bits;
                    topk_subgroup_histogram_add(keys[i], shift, pending);
                }
            } else {
                for (uint base = 0u; base < scored; base += TOPK_CHUNK) {
                    [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i) {
                        const uint ordinal = base + i * TOPK_THREADS + thread;
                        keys[i] = ordinal < scored ? topk_key(ordinal) : 0u;
                    }
                    [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i) {
                        const uint ordinal = base + i * TOPK_THREADS + thread;
                        const bool pending = ordinal < scored && (keys[i] & mask) == prefix_bits;
                        topk_subgroup_histogram_add(keys[i], shift, pending);
                    }
                }
            }
            barrier();
            // Invocation t < 256 holds bin 255 - t: the candidates above it are
            // the scan of the bins before it. The bin holding the
            // `remaining`-th best takes the digit.
            const uint bin = thread < 256u ? 255u - thread : 0u;
            const uint count = thread < 256u ? seismic_shared_u32[TOPK_BINS + bin] : 0u;
            const uint above = reduce_group_exclusive_add(count, TOPK_SCAN, total);
            const bool pick = thread < 256u && above < remaining && remaining <= above + count;
            barrier();
            if (pick) {
                seismic_shared_u32[TOPK_STATE] = prefix_bits | (bin << shift);
                seismic_shared_u32[TOPK_STATE + 1u] = remaining - above;
            }
            // The next pass's bins, read past this one's.
            if (digit > 0 && thread < 256u)
                seismic_shared_u32[TOPK_BINS + thread] = 0u;
            mask |= 255u << shift;
        }
        barrier();
        threshold = seismic_shared_u32[TOPK_STATE];
        take = seismic_shared_u32[TOPK_STATE + 1u];
    }

    // The picks, a chunk at a time: invocation t's share of the chunk [lo, hi);
    // `ranked` equal ones and `placed` picks before the chunk.
    uint ranked = 0u;
    uint placed = 0u;
    for (uint base = 0u; base < scored; base += TOPK_CHUNK) {
        const uint lo = min(base + thread * TOPK_ITEMS, scored);
        const uint hi = min(lo + TOPK_ITEMS, scored);
        if (!prefix && !single_chunk)
            topk_load_contiguous_keys(vec4_aligned, base + thread * TOPK_ITEMS, scored, keys);
        // The rank among the ordinals equal to T of the share's first.
        uint rank = 0u;
        if (!prefix) {
            uint equal = 0u;
            [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i)
                equal += lo + i < hi && keys[i] == threshold ? 1u : 0u;
            uint chunk_equal;
            rank = ranked + reduce_group_exclusive_add(equal, TOPK_SCAN, chunk_equal);
            ranked += chunk_equal;
        }
        uint picked_mask = 0u;
        uint picks = 0u;
        [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i) {
            const uint ordinal = lo + i;
            const bool picked = ordinal < hi
                && (prefix ? ordinal < limit
                           : keys[i] > threshold || (keys[i] == threshold && rank++ < take));
            if (picked) {
                picked_mask |= 1u << i;
                ++picks;
            }
        }
        uint chunk_picks;
        uint position = placed + reduce_group_exclusive_add(picks, TOPK_SCAN, chunk_picks);
        placed += chunk_picks;

        // The span holding `lo` and the listed rows before it: the last whose
        // offset is at most `lo`.
        uint span = 0u;
        uint begin = 0u;
        if (r <= TOPK_THREADS) {
            if (picks > 0u) {
                uint local = 0u;
                for (uint high = r - 1u; local < high;) {
                    const uint middle = (local + high + 1u) >> 1;
                    if (seismic_shared_u32[TOPK_OFFSETS + middle] <= lo)
                        local = middle;
                    else
                        high = middle - 1u;
                }
                span = local;
                begin = seismic_shared_u32[TOPK_OFFSETS + local];
            }
        } else {
            uint before = 0u;
            for (uint sbase = 0u; sbase < r; sbase += TOPK_THREADS) {
                const uint at = sbase + thread;
                const uint length = at < r ? indexer_span_length_at(spans, span_stride, bound_stride, at) : 0u;
                uint chunk;
                const uint offset = reduce_group_exclusive_add(length, TOPK_SCAN, chunk);
                barrier();
                seismic_shared_u32[TOPK_OFFSETS + thread] = before + offset;
                barrier();
                if (picks > 0u && lo >= before && lo < before + chunk) {
                    uint local = 0u;
                    for (uint high = min(TOPK_THREADS, r - sbase) - 1u; local < high;) {
                        const uint middle = (local + high + 1u) >> 1;
                        if (seismic_shared_u32[TOPK_OFFSETS + middle] <= lo)
                            local = middle;
                        else
                            high = middle - 1u;
                    }
                    span = sbase + local;
                    begin = seismic_shared_u32[TOPK_OFFSETS + local];
                }
                barrier();
                before += chunk;
            }
        }
        if (picks > 0u) {
            uint end = begin + indexer_span_length_at(spans, span_stride, bound_stride, span);
            [[unroll]] for (uint i = 0u; i < TOPK_ITEMS; ++i) {
                const uint ordinal = lo + i;
                if (ordinal >= hi)
                    break;
                while (ordinal >= end) {
                    begin = end;
                    ++span;
                    end = begin + indexer_span_length_at(spans, span_stride, bound_stride, span);
                }
                if (((picked_mask >> i) & 1u) != 0u && position < k) {
                    element_i32_put(result + uint64_t(position++) * result_stride,
                        element_i32_at(spans + uint64_t(span) * span_stride * 4ul) + int(ordinal - begin));
                }
            }
        }
    }
    for (uint pick = placed + thread; pick < k; pick += TOPK_THREADS)
        element_i32_put(result + uint64_t(pick) * result_stride, -1);
}
