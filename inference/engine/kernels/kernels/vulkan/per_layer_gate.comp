// per_layer_gate: `stage` rounds the F32 hidden rows to A in scratch (as the
// gate weight's operand rows: NVFP4 operands over NVFP4 gate rows); the
// projection launches project them through the gate rows with the
// activated-product epilogue A(A(act(A(gate))) * inputs[m, layer, p]). The
// Vulkan form of `metal/per_layer_gate.metal`.
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_GATE_WEIGHT
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_GS != 0
#define PROJECTION_SCALED
#endif
#include "lib/projection/projection.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "per_layer_gate requires a bf16 or f16 activation"
#endif
#define GATE_ACT ACTIVATION_A


#define GATE_D uint(SEISMIC_DIM_D)

#define PROJECTION_SINGLE
#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_N uint(SEISMIC_DIM_P)
#define PROJECTION_K GATE_D
#define PROJECTION_G 1
#define PROJECTION_NORM PROJECTION_NORM_NONE
#define PROJECTION_STAGED SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED)
#define PROJECTION_SPLIT SEISMIC_TUNE_SPLIT
#define PROJECTION_PARTIALS SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS)

// The rows `stage` rounded, read by every form.
projection_prologue projected_input(uint g) {
    return projection_plain(GATE_ACT, PROJECTION_STAGED, SEISMIC_DIM_D, 1ul, GATE_D, 0ul);
}

projection_prologue projected_rows(uint g) { return projected_input(g); }

projection_epilogue projected_output(uint g) {
    const uint64_t inputs = SEISMIC_PTR(SEISMIC_BUFFER_INPUTS)
        + uint64_t(int(SEISMIC_PARAM_LAYER)) * SEISMIC_INPUTS_STRIDE_1 * 4ul;
    return projection_scaled(projection_activated_mul(GATE_ACT, SEISMIC_RESULT_0_OUT, SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, inputs, SEISMIC_INPUTS_STRIDE_0, SEISMIC_INPUTS_STRIDE_2,
        int(SEISMIC_PARAM_ACTIVATION)),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_GATE_SCALE), SEISMIC_DIM_GS, 0ul, 0ul), 1.0);
}

projection_weights projected_weight(uint g) {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_GATE_WEIGHT), PACKETS_W0_ROWS, GATE_D, 0ul, 1ul, 0u);
}

// The `staged` rows: the F32 hidden rows rounded to A (as the gate weight's
// NVFP4 operands over NVFP4 gate rows), one row a workgroup.
void per_layer_gate_rows() {
#if PACKETS_OPERANDS_NVFP4(SEISMIC_GATE_WEIGHT)
    // The hidden rows rounded to A (one part, no norm) as the gate weight's
    // NVFP4 operands.
    projection_stage(projection_operands(projection_summed(GATE_ACT, SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN),
        SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_1, GATE_D, 0ul, 1u), PROJECTION_OPERANDS_NVFP4),
        gl_WorkGroupID.x, PROJECTION_STAGED, GATE_D);
#else
    const uint64_t m = uint64_t(gl_WorkGroupID.x);
    const uint64_t src_row = SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN) + m * SEISMIC_HIDDEN_STRIDE_0 * 4ul;
    const uint64_t dst_row = PROJECTION_STAGED + m * SEISMIC_DIM_D * 2ul;
    if (SEISMIC_HIDDEN_STRIDE_1 == 1ul && (src_row & 15ul) == 0ul && (dst_row & 7ul) == 0ul) {
        const uint vec_end = GATE_D & ~3u;
        for (uint i = gl_LocalInvocationID.x * 4u; i < vec_end; i += 1024u) {
            const vec4 v = element_vec4_at(src_row + uint64_t(i) * 4ul);
            element_uvec2_put(dst_row + uint64_t(i) * 2ul,
                uvec2(element_pack2(GATE_ACT, v.x, v.y), element_pack2(GATE_ACT, v.z, v.w)));
        }
        const uint tail = vec_end + gl_LocalInvocationID.x;
        if (tail < GATE_D)
            element_put(GATE_ACT, PROJECTION_STAGED, m * SEISMIC_DIM_D + uint64_t(tail),
                element_f32_at(src_row + uint64_t(tail) * 4ul));
    } else {
        for (uint i = gl_LocalInvocationID.x; i < GATE_D; i += 256u)
            element_put(GATE_ACT, PROJECTION_STAGED, m * SEISMIC_DIM_D + uint64_t(i),
                element_f32_at(src_row + uint64_t(i) * SEISMIC_HIDDEN_STRIDE_1 * 4ul));
    }
#endif
}

#include "lib/projection/operator.glsl"

// The `dense` projection's launches (`lib/projection/operator.glsl`).
void per_layer_gate_stage() { per_layer_gate_rows(); }
void per_layer_gate_gemv1() { projection_single_gemv(1u); }
void per_layer_gate_gemv2() { projection_single_gemv(2u); }
void per_layer_gate_gemv4() { projection_single_gemv(4u); }
void per_layer_gate_gemv8() { projection_single_gemv(8u); }
void per_layer_gate_gemm() { projection_single_gemm(); }
void per_layer_gate_finalize() { projection_single_finalize(); }
