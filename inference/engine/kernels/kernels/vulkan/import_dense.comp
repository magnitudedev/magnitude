// Dense weight import over the [B, N, K] view; one invocation per element in
// row-major order, over a grid-stride loop (the grid is capped below the
// 65535-group floor). The Vulkan form of `metal/import_dense.metal`. The
// result is a record port (bank records, chunked, import through it): its
// handle is the records' address table, matrix b written through its own
// record's region.
#include <seismic/slab.glsl>

#define IMPORT_SOURCE_KIND ELEMENT_OF(SEISMIC_ELEMENT_E)

#define IMPORT_DESTINATION_KIND ELEMENT_OF(SEISMIC_ELEMENT_U)

void import_dense() {
    const uint64_t source = SEISMIC_PTR(SEISMIC_BUFFER_SOURCE);
    const SlabOut destination = SEISMIC_RESULT_0_OUT;
    const uint64_t count = SEISMIC_DIM_B * SEISMIC_DIM_N * SEISMIC_DIM_K;
    for (seismic_walk at = seismic_walk_grid(count, u64vec3(1ul, SEISMIC_DIM_N, SEISMIC_DIM_K)); at.index < count;
            seismic_walk_next(at)) {
        const uint64_t b = at.axes.x, n = at.axes.z, k = at.axes.w;
        out_put(slab_out_region(destination, b),
            n * SEISMIC_RESULT_0_STRIDE_1 + k * SEISMIC_RESULT_0_STRIDE_2,
            element_at(IMPORT_SOURCE_KIND, source,
                b * SEISMIC_SOURCE_STRIDE_0 + n * SEISMIC_SOURCE_STRIDE_1 + k * SEISMIC_SOURCE_STRIDE_2));
    }
}
