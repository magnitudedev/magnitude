// Dense weight import over the [B, N, K] view; four elements per thread along
// K with a 3D grid (ceil_div(ceil_div(K, 4), 256), min(N, 65535), min(B, 65535))
// and grid-stride loops over y and z. The Vulkan form of `cuda/import_dense.cu`.
// The result is a record port (bank records, chunked, import through it): its
// handle is the records' address table, matrix b written through its own
// record's region.
#include <seismic/slab.glsl>

#define IMPORT_SOURCE_KIND ELEMENT_OF(SEISMIC_ELEMENT_E)

void import_dense() {
    const uint64_t source = SEISMIC_PTR(SEISMIC_BUFFER_SOURCE);
    const SlabOut destination = SEISMIC_RESULT_0_OUT;
    const uint64_t k0 = uint64_t(gl_GlobalInvocationID.x) * 4ul;
    if (k0 >= SEISMIC_DIM_K)
        return;

    const bool full_vec = (SEISMIC_SOURCE_STRIDE_2 == 1ul)
        && (SEISMIC_RESULT_0_STRIDE_2 == 1ul)
        && (k0 + 4ul <= SEISMIC_DIM_K);
    const uint64_t count = (k0 + 4ul <= SEISMIC_DIM_K) ? 4ul : (SEISMIC_DIM_K - k0);
    const uint64_t src_elem_bytes = uint64_t(ELEMENT_BYTES(IMPORT_SOURCE_KIND));
    const uint64_t src_vec_mask = 4ul * src_elem_bytes - 1ul;

    for (uint64_t b = uint64_t(gl_WorkGroupID.z); b < SEISMIC_DIM_B; b += uint64_t(gl_NumWorkGroups.z)) {
        const Out dst_region = slab_out_region(destination, b);
        const uint64_t src_b = b * SEISMIC_SOURCE_STRIDE_0;
        for (uint64_t n = uint64_t(gl_WorkGroupID.y); n < SEISMIC_DIM_N; n += uint64_t(gl_NumWorkGroups.y)) {
            const uint64_t src_base = src_b + n * SEISMIC_SOURCE_STRIDE_1;
            const uint64_t dst_base = n * SEISMIC_RESULT_0_STRIDE_1;
            if (full_vec) {
                const uint64_t src_offset = src_base + k0;
                const uint64_t src_addr = source + src_offset * src_elem_bytes;
                if ((src_addr & src_vec_mask) == 0ul) {
                    vec4 values;
                    if (IMPORT_SOURCE_KIND == ELEMENT_F32) {
                        values = element_vec4_at(src_addr);
                    } else {
                        const uvec2 packed = element_uvec2_at(src_addr);
                        values = vec4(
                            element_unpack2(IMPORT_SOURCE_KIND, packed.x),
                            element_unpack2(IMPORT_SOURCE_KIND, packed.y));
                    }
                    const uint64_t dst_offset = dst_base + k0;
                    out_put2(dst_region, dst_offset, values.x, values.y);
                    out_put2(dst_region, dst_offset + 2ul, values.z, values.w);
                    continue;
                }
            }
            for (uint64_t i = 0ul; i < count; ++i) {
                const uint64_t k = k0 + i;
                out_put(dst_region, dst_base + k * SEISMIC_RESULT_0_STRIDE_2,
                    element_at(IMPORT_SOURCE_KIND, source, src_base + k * SEISMIC_SOURCE_STRIDE_2));
            }
        }
    }
}
