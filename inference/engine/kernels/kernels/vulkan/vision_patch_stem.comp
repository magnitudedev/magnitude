// vision_patch_stem: the patch projection as one GEMM per frame over the
// projection library (K = C * P * P each). The Vulkan form of
// `metal/vision_patch_stem.metal`, with the CUDA form's conversion launch:
// L1 converts the F32 pixels to f16 rows [M][1 + S][Kp] (the GEMM's A
// operand; Kp = K rounded up to pieces of 8, the pad zero), L2 (two frames)
// stores the first frame's F32 product, L3 adds it, the bias and the
// bilinear position-table blend (`lib/vision/vision.glsl`, the Stem epilogue)
// into the F32 result.
#define KERNEL_W0 SEISMIC_FRAME_WEIGHT
#define KERNEL_W1 SEISMIC_NEXT_FRAME_WEIGHT
#include "lib/vision/vision.glsl"



#define BIAS_KIND ELEMENT_OF(SEISMIC_BIAS)

#define TABLE_KIND ELEMENT_OF(SEISMIC_TABLE)

#define STEM_FRAMES (1u + uint(SEISMIC_DIM_S))
#define STEM_AREA uint(SEISMIC_DIM_P * SEISMIC_DIM_P)
#define STEM_K (uint(SEISMIC_DIM_C) * STEM_AREA)
#define STEM_KP ((STEM_K + 7u) / 8u * 8u)

vec4 stem_load4(uint64_t row_pixels, uint frame, uint col, inout uint channel, inout uint within) {
    if (col >= STEM_K)
        return vec4(0.0);
    if (within + 4u <= STEM_AREA) {
        const uint64_t src = row_pixels
            + ((uint64_t(channel) * STEM_FRAMES + frame) * STEM_AREA + within) * 4ul;
        within += 4u;
        if (within == STEM_AREA) {
            within = 0u;
            ++channel;
        }
        if ((src & 15ul) == 0ul)
            return element_vec4_at(src);
        return vec4(element_f32_at(src), element_f32_at(src + 4ul),
            element_f32_at(src + 8ul), element_f32_at(src + 12ul));
    }
    float v[4] = float[4](0.0, 0.0, 0.0, 0.0);
    const uint count = min(4u, STEM_K - col);
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
        if (i < count) {
            v[i] = element_f32_at(row_pixels
                + ((uint64_t(channel) * STEM_FRAMES + frame) * STEM_AREA + within) * 4ul);
            if (++within == STEM_AREA) {
                within = 0u;
                ++channel;
            }
        }
    }
    return vec4(v[0], v[1], v[2], v[3]);
}

// L1: grid-stride over pieces of 8 converted values.
void vision_patch_stem_convert() {
    const uint64_t pixels = SEISMIC_PTR(SEISMIC_BUFFER_PIXELS);
    const uint64_t converted = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_CONVERTED);
    const uint64_t pieces = SEISMIC_DIM_M * uint64_t(STEM_FRAMES) * (STEM_KP / 8u);
    // STEM_KP is a multiple of 8: a piece's row, frame and k are the walk's axes over (1, frames, STEM_KP / 8).
    for (seismic_walk at = seismic_walk_grid(pieces, u64vec3(1ul, uint64_t(STEM_FRAMES), uint64_t(STEM_KP / 8u)));
            at.index < pieces; seismic_walk_next(at)) {
        const uint64_t index = at.index * 8ul;
        const uint64_t row = at.axes.x;
        const uint frame = uint(at.axes.z);
        const uint k = uint(at.axes.w) * 8u;
        vec4 lo = vec4(0.0), hi = vec4(0.0);
        if (k < STEM_K) {
            const uint64_t row_pixels = pixels + row * SEISMIC_PIXELS_STRIDE_0 * 4ul;
            uint channel = k / STEM_AREA;
            uint within = k % STEM_AREA;
            lo = stem_load4(row_pixels, frame, k, channel, within);
            hi = stem_load4(row_pixels, frame, k + 4u, channel, within);
        }
        element_uvec4_put(converted + index * 2ul,
            element_pack8(ELEMENT_F16, vec4(lo.x, lo.z, hi.x, hi.z), vec4(lo.y, lo.w, hi.y, hi.w)));
    }
}

projection_prologue stem_frame(uint frame) {
    return projection_plain(ELEMENT_F16, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_CONVERTED) + uint64_t(frame) * STEM_KP * 2ul,
        uint64_t(STEM_FRAMES) * STEM_KP, 1ul, STEM_K, 0ul);
}

// L2 (two frames): the first frame's F32 product into the partial [M, H].
void vision_patch_stem_first() {
    const uint h = uint(SEISMIC_DIM_H);
    const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_FRAME_WEIGHT), PACKETS_W0_ROWS, STEM_K);
    const projection_epilogue out_ = projection_store(
        out_over_scratch(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIAL)), uint64_t(h), 1ul, 0ul);
    projection_gemm(PACKETS_W0, stem_frame(0u), out_, w, uint(SEISMIC_DIM_M), h,
        STEM_K, gl_WorkGroupID.y, gl_WorkGroupID.x, uint(SEISMIC_DIM_M));
}

// L3: the last frame, the partial (two frames), the bias and the position
// blend.
void vision_patch_stem_last() {
    const uint h = uint(SEISMIC_DIM_H);
    const bool two = SEISMIC_DIM_S == 1;
    const vision_epilogue out_ = vision_stem(SEISMIC_RESULT_0_OUT, SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_DIM_NB == 1, SEISMIC_PTR(SEISMIC_BUFFER_BIAS), BIAS_KIND,
        two ? SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIAL) : 0ul, uint64_t(h),
        SEISMIC_DIM_NT == 1 ? SEISMIC_PTR(SEISMIC_BUFFER_TABLE) : 0ul,
        TABLE_KIND, SEISMIC_PTR(SEISMIC_BUFFER_INDICES), SEISMIC_PTR(SEISMIC_BUFFER_COEFFICIENTS));
    if (two) {
        const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_NEXT_FRAME_WEIGHT),
            PACKETS_W1_STACKED_ROWS, STEM_K);
        vision_gemm(PACKETS_W1, stem_frame(1u), out_, w, uint(SEISMIC_DIM_M), h, STEM_K, gl_WorkGroupID.y,
            gl_WorkGroupID.x);
    } else {
        const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_FRAME_WEIGHT), PACKETS_W0_ROWS, STEM_K);
        vision_gemm(PACKETS_W0, stem_frame(0u), out_, w, uint(SEISMIC_DIM_M), h, STEM_K, gl_WorkGroupID.y,
            gl_WorkGroupID.x);
    }
}
