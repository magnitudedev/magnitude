// vision_patch_stem: the patch projection as one GEMM per frame over the
// projection library (K = C * P * P each). The Vulkan form of
// `metal/vision_patch_stem.metal`, with the CUDA form's conversion launch:
// L1 converts the F32 pixels to f16 rows [M][1 + S][Kp] (the GEMM's A
// operand; Kp = K rounded up to pieces of 8, the pad zero), L2 (two frames)
// stores the first frame's F32 product, L3 adds it, the bias and the
// bilinear position-table blend (`lib/vision/vision.glsl`, the Stem epilogue)
// into the F32 result.
#include "lib/vision/vision.glsl"

#if defined(SEISMIC_FRAME_WEIGHT_REPRESENTATION_BF16)
#define WEIGHT_0_KIND PACKETS_BF16
#define WEIGHT_0_BYTES 2
#elif defined(SEISMIC_FRAME_WEIGHT_REPRESENTATION_F16)
#define WEIGHT_0_KIND PACKETS_F16
#define WEIGHT_0_BYTES 2
#elif defined(SEISMIC_FRAME_WEIGHT_REPRESENTATION_F32)
#define WEIGHT_0_KIND PACKETS_F32
#define WEIGHT_0_BYTES 4
#else
#error "unsupported vision_patch_stem frame_weight representation"
#endif

#if defined(SEISMIC_NEXT_FRAME_WEIGHT_REPRESENTATION_BF16)
#define WEIGHT_1_KIND PACKETS_BF16
#define WEIGHT_1_BYTES 2
#elif defined(SEISMIC_NEXT_FRAME_WEIGHT_REPRESENTATION_F16)
#define WEIGHT_1_KIND PACKETS_F16
#define WEIGHT_1_BYTES 2
#elif defined(SEISMIC_NEXT_FRAME_WEIGHT_REPRESENTATION_F32)
#define WEIGHT_1_KIND PACKETS_F32
#define WEIGHT_1_BYTES 4
#else
#error "unsupported vision_patch_stem next_frame_weight representation"
#endif

#if defined(SEISMIC_BIAS_REPRESENTATION_BF16)
#define BIAS_KIND ELEMENT_BF16
#elif defined(SEISMIC_BIAS_REPRESENTATION_F16)
#define BIAS_KIND ELEMENT_F16
#elif defined(SEISMIC_BIAS_REPRESENTATION_F32)
#define BIAS_KIND ELEMENT_F32
#else
#error "unsupported vision_patch_stem bias representation"
#endif

#if defined(SEISMIC_TABLE_REPRESENTATION_BF16)
#define TABLE_KIND ELEMENT_BF16
#elif defined(SEISMIC_TABLE_REPRESENTATION_F16)
#define TABLE_KIND ELEMENT_F16
#elif defined(SEISMIC_TABLE_REPRESENTATION_F32)
#define TABLE_KIND ELEMENT_F32
#else
#error "unsupported vision_patch_stem table representation"
#endif

#define STEM_FRAMES (1u + uint(SEISMIC_DIM_S))
#define STEM_AREA uint(SEISMIC_DIM_P * SEISMIC_DIM_P)
#define STEM_K (uint(SEISMIC_DIM_C) * STEM_AREA)
#define STEM_KP ((STEM_K + 7u) / 8u * 8u)

// L1: grid-stride over pieces of 8 converted values.
void vision_patch_stem_convert() {
    const uint64_t pixels = SEISMIC_PTR(SEISMIC_BUFFER_PIXELS);
    const uint64_t converted = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_CONVERTED);
    const uint64_t pieces = SEISMIC_DIM_M * uint64_t(STEM_FRAMES) * STEM_KP / 8ul;
    const uint64_t step = uint64_t(gl_NumWorkGroups.x) * gl_WorkGroupSize.x;
    for (uint64_t piece = gl_GlobalInvocationID.x; piece < pieces; piece += step) {
        const uint64_t index = piece * 8ul;
        const uint64_t row = index / (uint64_t(STEM_FRAMES) * STEM_KP);
        const uint frame = uint((index / STEM_KP) % STEM_FRAMES);
        const uint k = uint(index % STEM_KP);
        float v[8];
        [[unroll]] for (uint i = 0u; i < 8u; ++i) {
            const uint channel = (k + i) / STEM_AREA, within = (k + i) % STEM_AREA;
            v[i] = k + i < STEM_K ? element_f32_at(pixels
                + (row * SEISMIC_PIXELS_STRIDE_0 + (uint64_t(channel) * STEM_FRAMES + frame) * STEM_AREA + within) * 4ul)
                : 0.0;
        }
        element_uvec4_put(converted + index * 2ul,
            element_pack8(ELEMENT_F16, vec4(v[0], v[2], v[4], v[6]), vec4(v[1], v[3], v[5], v[7])));
    }
}

projection_prologue stem_frame(uint frame) {
    return projection_plain(ELEMENT_F16, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_CONVERTED) + uint64_t(frame) * STEM_KP * 2ul,
        uint64_t(STEM_FRAMES) * STEM_KP, 1ul, STEM_K, 0ul);
}

// L2 (two frames): the first frame's F32 product into the partial [M, H].
void vision_patch_stem_first() {
    const uint h = uint(SEISMIC_DIM_H);
    const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_FRAME_WEIGHT),
        SEISMIC_FRAME_WEIGHT_STRIDE_0, WEIGHT_0_BYTES, STEM_K);
    const projection_epilogue out_ = projection_store(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIAL),
        uint64_t(h), 1ul, 0ul);
    projection_gemm(WEIGHT_0_KIND, VISION_TILE_M, VISION_TILE_N, VISION_SUB, VISION_SUB, stem_frame(0u), out_, w, uint(SEISMIC_DIM_M), h,
        STEM_K, gl_WorkGroupID.y, gl_WorkGroupID.x, uint(SEISMIC_DIM_M));
}

// L3: the last frame, the partial (two frames), the bias and the position
// blend.
void vision_patch_stem_last() {
    const uint h = uint(SEISMIC_DIM_H);
    const bool two = SEISMIC_DIM_S == 1;
    const vision_epilogue out_ = vision_stem(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_DIM_NB == 1, SEISMIC_PTR(SEISMIC_BUFFER_BIAS), BIAS_KIND,
        two ? SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIAL) : 0ul, uint64_t(h), SEISMIC_PTR(SEISMIC_BUFFER_TABLE),
        TABLE_KIND, SEISMIC_PTR(SEISMIC_BUFFER_INDICES), SEISMIC_PTR(SEISMIC_BUFFER_COEFFICIENTS));
    if (two) {
        const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_NEXT_FRAME_WEIGHT),
            SEISMIC_NEXT_FRAME_WEIGHT_STRIDE_1, WEIGHT_1_BYTES, STEM_K);
        vision_gemm(WEIGHT_1_KIND, stem_frame(1u), out_, w, uint(SEISMIC_DIM_M), h, STEM_K, gl_WorkGroupID.y,
            gl_WorkGroupID.x);
    } else {
        const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_FRAME_WEIGHT),
            SEISMIC_FRAME_WEIGHT_STRIDE_0, WEIGHT_0_BYTES, STEM_K);
        vision_gemm(WEIGHT_0_KIND, stem_frame(0u), out_, w, uint(SEISMIC_DIM_M), h, STEM_K, gl_WorkGroupID.y,
            gl_WorkGroupID.x);
    }
}
