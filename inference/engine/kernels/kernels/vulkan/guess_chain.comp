// guess_chain (guess.seismic): each chaining row's next guesses and each
// continuing row's token row and kind, by one invocation
// (two_row/guess.hpp).
#include "lib/two_row/guess.glsl"

void guess_chain() {
    if (gl_LocalInvocationIndex != 0u)
        return;
    guess_chain_rows(SEISMIC_PTR(SEISMIC_BUFFER_TOKENS), SEISMIC_TOKENS_STRIDE_0, SEISMIC_TOKENS_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_CHAINING), SEISMIC_CHAINING_STRIDE_0, SEISMIC_CHAINING_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_SELECTED), SEISMIC_SELECTED_STRIDE_0, SEISMIC_SELECTED_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_DRAFTED), SEISMIC_DRAFTED_STRIDE_0, SEISMIC_DRAFTED_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_CONTINUING), SEISMIC_CONTINUING_STRIDE_0, SEISMIC_CONTINUING_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_GUESSES), SEISMIC_GUESSES_STRIDE_0, SEISMIC_GUESSES_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_NEXT_SELECTED), SEISMIC_NEXT_SELECTED_STRIDE_0, SEISMIC_NEXT_SELECTED_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_NEXT_GUESSES), SEISMIC_NEXT_GUESSES_STRIDE_0, SEISMIC_NEXT_GUESSES_STRIDE_1,
        uint(SEISMIC_DIM_S), uint(SEISMIC_DIM_M), uint(SEISMIC_DIM_N));
}
