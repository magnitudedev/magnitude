#define ATTENTION_QUERY_GROUP SEISMIC_DIM_G
// attention_prefill: streaming attention for prefill rows over dense history.
// The body (three launches) is `lib/attention/prefill.glsl`.
#define ATTENTION_I uint(SEISMIC_DIM_I)
#define ATTENTION_U uint(SEISMIC_DIM_U)
#define ATTENTION_FRESH (SEISMIC_DIM_F != 0)
#define ATTENTION_NORM (SEISMIC_DIM_N != 0)
#define ATTENTION_VALUE_NORM (SEISMIC_DIM_NV != 0)
#define ATTENTION_SOFTPLUS (SEISMIC_PARAM_GATE_FUNCTION != 0)
#define ATTENTION_QUERY_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_QUERY)
#define ATTENTION_GATE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_GATE)
#define ATTENTION_AMPLITUDE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_AMPLITUDES)
#define ATTENTION_VALUE_NORM_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_VALUE_NORM)
#define PREFILL_ROWS uint(SEISMIC_TUNE_ROWS)
// The WorkList selection (B > 0) and the list launch's scratch.
#define PREFILL_SELECTED (SEISMIC_DIM_B != 0)
#define PREFILL_SELECTION_WORDS uint(SEISMIC_DIM_B)
#define PREFILL_BLOCK_ROWS int(SEISMIC_DIM_BR)
#define PREFILL_SELECTION_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SELECTION)
// A query tile's rows each read at most the bitmap's 32 * B * BR keys, in at
// most R + 1 runs.
#define PREFILL_LIST_CAPACITY uint(uint64_t(PREFILL_QT) * ((32ul * SEISMIC_DIM_B * SEISMIC_DIM_BR + FLASH_KEYS - 1ul) / FLASH_KEYS + SEISMIC_DIM_R + 1ul))
// The worklist scratch: the query tiles' (span, first) lists, their counts,
// then the rows' span ordinals.
#define PREFILL_LIST_TILES ((SEISMIC_DIM_M + uint64_t(PREFILL_QT) - 1ul) / uint64_t(PREFILL_QT))
#define PREFILL_LISTS_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_WORKLIST)
#define PREFILL_LISTED_BUFFER (PREFILL_LISTS_BUFFER + PREFILL_LIST_TILES * uint64_t(PREFILL_LIST_CAPACITY) * 8ul)
#define PREFILL_BASES_BUFFER (PREFILL_LISTED_BUFFER + PREFILL_LIST_TILES * 4ul)
#include "lib/attention/prefill.glsl"

attention_history prefill_history() {
    return attention_dense_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY), SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE));
}

prefill_scratch prefill_scratch_planes() {
    return prefill_scratch(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_QUERIES), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_KEYS),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_VALUES), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_COUNTS));
}

void attention_prefill_prepare() { prefill_prepare(prefill_history(), prefill_scratch_planes()); }
void attention_prefill_attend() { prefill_attend(prefill_history(), prefill_scratch_planes()); }
void attention_prefill_merge() { prefill_merge(prefill_scratch_planes()); }
void attention_prefill_list() { prefill_list(); }
