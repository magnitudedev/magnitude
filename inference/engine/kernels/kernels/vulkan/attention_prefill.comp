#define ATTENTION_QUERY_GROUP SEISMIC_DIM_G
// attention_prefill: streaming attention for prefill rows over dense history.
// Two forms (MATRIX): the vector form (0, the canonical default), whose
// partial launch is `lib/attention/vector.glsl`'s, the decode entry's vector
// body, over every prefill row, with F32 products over activation-element
// operands; and the matrix form (1), `lib/attention/prefill.glsl`'s launches,
// whose cooperative-matrix products stage their operands in F16.
#if !SEISMIC_TUNE_MATRIX
// The vector form splits a kv head's G query heads into SLICES workgroups of
// G / SLICES heads, each held by every subgroup of its workgroup.
#define ATTENTION_HEAD_GROUP (uint(SEISMIC_DIM_G) / uint(SEISMIC_TUNE_SLICES))
#define ATTENTION_HEADS ATTENTION_HEAD_GROUP
#endif
#define ATTENTION_I uint(SEISMIC_DIM_I)
#define ATTENTION_U uint(SEISMIC_DIM_U)
#define ATTENTION_FRESH (SEISMIC_DIM_F != 0)
#define ATTENTION_QUERY_NORM (SEISMIC_DIM_NQ != 0)
#define ATTENTION_NORM (SEISMIC_DIM_N != 0)
#define ATTENTION_STORED_KEY (SEISMIC_DIM_VK != 0)
#define ATTENTION_KEY_ROUNDING                                                                                 \
    (SEISMIC_DIM_KR != 0 ? rounding_of(SEISMIC_PARAM_KEY_BLOCK, SEISMIC_PARAM_KEY_ELEMENT, SEISMIC_PARAM_KEY_SCALE, \
                               SEISMIC_PARAM_KEY_AMAX_FLOOR)                                                    \
                         : rounding_none())
#define ATTENTION_VALUE_NORM (SEISMIC_DIM_NV != 0)
#define ATTENTION_SOFTPLUS (SEISMIC_PARAM_GATE_FUNCTION != 0)
#define ATTENTION_QUERY_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_QUERY)
#define ATTENTION_GATE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_GATE)
#define ATTENTION_AMPLITUDE_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_AMPLITUDES)
#define ATTENTION_VALUE_NORM_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_VALUE_NORM)
// The query heads' sink logits (SK = 1), joined at every normalization.
#define ATTENTION_SINKS (SEISMIC_DIM_SK != 0)
#define ATTENTION_SINK_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SINKS)
#define PREFILL_ROWS uint(SEISMIC_TUNE_ROWS)
// The WorkList selection (B > 0) and the list launch's scratch.
#define PREFILL_SELECTED (SEISMIC_DIM_B != 0)
#define PREFILL_SELECTION_WORDS uint(SEISMIC_DIM_B)
#define PREFILL_BLOCK_ROWS int(SEISMIC_DIM_BR)
#define PREFILL_SELECTION_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SELECTION)
// A query tile's rows each read at most the bitmap's 32 * B * BR keys, in at
// most R + 1 runs.
#define PREFILL_LIST_CAPACITY uint(uint64_t(PREFILL_QT) * ((32ul * SEISMIC_DIM_B * SEISMIC_DIM_BR + FLASH_KEYS - 1ul) / FLASH_KEYS + SEISMIC_DIM_R + 1ul))
// The worklist scratch: the query tiles' (span, first) lists, their counts,
// then the rows' span ordinals.
#define PREFILL_LIST_TILES ((SEISMIC_DIM_M + uint64_t(PREFILL_QT) - 1ul) / uint64_t(PREFILL_QT))
#define PREFILL_LISTS_BUFFER SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_WORKLIST)
#define PREFILL_LISTED_BUFFER (PREFILL_LISTS_BUFFER + PREFILL_LIST_TILES * uint64_t(PREFILL_LIST_CAPACITY) * 8ul)
#define PREFILL_BASES_BUFFER (PREFILL_LISTED_BUFFER + PREFILL_LIST_TILES * 4ul)
// The index-list source (KS > 0): its state follows the attend grid's key
// partitions (its z extent) in the partials and statistics scratch.
#define PREFILL_PICKS (SEISMIC_DIM_KS != 0)
#define PREFILL_KEY_PARTS                                                                                   \
    max(1ul, (uint64_t(SEISMIC_TUNE_SPLIT_GROUPS) + PREFILL_LIST_TILES * SEISMIC_DIM_KV - 1ul)              \
            / (PREFILL_LIST_TILES * SEISMIC_DIM_KV))
#include "lib/attention/prefill.glsl"

attention_history prefill_history() {
    return attention_dense_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY), SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE));
}

prefill_scratch prefill_scratch_planes() {
    return prefill_scratch(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_QUERIES), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_KEYS),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_VALUES), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_COUNTS),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_QUERY_FACTORS));
}

prefill_picked prefill_picked_planes() {
    if (!PREFILL_PICKS)
        return prefill_picked(0ul, 0ul);
    const uint64_t states = PREFILL_KEY_PARTS * SEISMIC_DIM_M * uint64_t(ATTENTION_KV * ATTENTION_G);
    return prefill_picked(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS) + states * uint64_t(ATTENTION_W) * 4ul,
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS) + states * 8ul);
}

#if !SEISMIC_TUNE_MATRIX
#include "lib/attention/vector.glsl"

// Workgroup (kv head * SLICES + slice, partition, row).
void attention_prefill_vector() {
    const uint slices = uint(SEISMIC_TUNE_SLICES);
    vector_partial(prefill_history(), gl_WorkGroupID.x / slices, gl_WorkGroupID.x % slices, gl_WorkGroupID.y,
        gl_WorkGroupID.z, 0u, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
}

// Workgroup (query head, row), one invocation per column: the fixed-order
// merge of the row's partitions and the output gate.
void attention_prefill_gate() {
    attention_decode_gate(ATTENTION_QUERY_BUFFER, ATTENTION_GATE_BUFFER, SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE),
        SEISMIC_PTR(SEISMIC_BUFFER_FRESH), SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS), SEISMIC_DIM_R,
        0u, gl_WorkGroupID.x, gl_WorkGroupID.y, gl_LocalInvocationIndex, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
}
#endif

void attention_prefill_prepare() { prefill_prepare(prefill_history(), prefill_scratch_planes()); }
void attention_prefill_attend() { prefill_attend(prefill_history(), prefill_scratch_planes()); }
void attention_prefill_picks() {
    prefill_picks(prefill_scratch_planes(), prefill_picked_planes(), SEISMIC_PTR(SEISMIC_BUFFER_SELECTED_ROWS),
        uint(SEISMIC_DIM_KS), SEISMIC_PTR(SEISMIC_BUFFER_SELECTED), uint64_t(SEISMIC_PARAM_SELECTED_SLAB_ROWS));
}
void attention_prefill_merge() { prefill_merge(prefill_scratch_planes(), prefill_picked_planes()); }
void attention_prefill_rotate() {
    attention_rotate_output(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES),
        SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_COMPONENTS), SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_FREQUENCIES),
        ATTENTION_AMPLITUDE_BUFFER);
}
void attention_prefill_list() { prefill_list(); }
