// Decode output of the general routed feed-forward (M <= 8): workgroup
// (x, m) owns output channels of tile x for row m. The Vulkan form of
// `metal/routed_down.metal`. It runs the K1 GEMV sums of each choice's down
// projection in slot order, weighting each published (A-rounded) projection
// by its weight, and publishes base + selected in R. Every lane of a lane group (a
// whole subgroup) receives each channel's total, so the running selection
// lives in every lane's registers and one lane stores the channel.
#include "lib/core/activation.glsl"
#include "lib/routed/routed.glsl"
#include "lib/routed/expert_down.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define ROUTED_ACT ELEMENT_ACT
#else
#error "routed_down requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_ELEMENT_R_REPRESENTATION_F32)
#define ROUTED_PUBLISHED ELEMENT_F32
#elif defined(SEISMIC_ELEMENT_R_REPRESENTATION_BF16)
#define ROUTED_PUBLISHED ELEMENT_BF16
#elif defined(SEISMIC_ELEMENT_R_REPRESENTATION_F16)
#define ROUTED_PUBLISHED ELEMENT_F16
#else
#error "routed_down requires a dense published element"
#endif

#define DOWN_R SEISMIC_TUNE_ROWS

void routed_down() {
    const uint tile = gl_WorkGroupID.x;
    const uint64_t m = gl_WorkGroupID.y;
    const uint hidden = uint(SEISMIC_DIM_H);
    const uint first = projection_gemv_first_row(DOWN_R, 32u, tile);
    const uint bytes = ELEMENT_BYTES(ROUTED_ACT);
    float selected[PROJECTION_GEMV_MAX_R];
    [[unroll]] for (uint r = 0u; r < PROJECTION_GEMV_MAX_R; ++r)
        selected[r] = 0.0;
    float totals[PROJECTION_GEMV_SUMS], unused[PROJECTION_GEMV_SUMS];
    for (uint64_t k = 0ul; k < SEISMIC_DIM_K; ++k) {
        const uint64_t expert = uint64_t(element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_ROUTES)
            + (m * SEISMIC_ROUTES_STRIDE_0 + k * SEISMIC_ROUTES_STRIDE_1) * 4ul));
        const projection_prologue x = projection_plain(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_PRODUCT)
                + (m * SEISMIC_PRODUCT_STRIDE_0 + k * SEISMIC_PRODUCT_STRIDE_1) * uint64_t(bytes),
            0ul, SEISMIC_PRODUCT_STRIDE_2, uint(SEISMIC_DIM_F), 0ul);
        const projection_weights down = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_DOWN), ED_GEOMETRY,
            routed_expert_row(expert, SEISMIC_DIM_H), uint(SEISMIC_DIM_F));
        projection_gemv_sums(ED_KIND, ED_KIND, false, DOWN_R, 32u, 1u, PROJECTION_NORM_NONE, x, down, down, 1u,
            hidden, uint(SEISMIC_DIM_F), tile, totals, unused);
        const float weight = element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHTS)
            + (m * SEISMIC_WEIGHTS_STRIDE_0 + k * SEISMIC_WEIGHTS_STRIDE_1) * 4ul);
        [[unroll]] for (uint r = 0u; r < PROJECTION_GEMV_MAX_R; ++r)
            if (r < DOWN_R)
                selected[r] = seismic_fma_rn(weight, element_round(ROUTED_ACT, totals[r * PROJECTION_GEMV_MAX_M]), selected[r]);
    }
    [[unroll]] for (uint r = 0u; r < PROJECTION_GEMV_MAX_R; ++r) {
        const uint n = first + r;
        if (r < DOWN_R && n < hidden && SEISMIC_LANE == r) {
            const float base = element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_BASE)
                + (m * SEISMIC_BASE_STRIDE_0 + uint64_t(n) * SEISMIC_BASE_STRIDE_1) * 4ul);
            element_put(ROUTED_PUBLISHED, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
                m * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(n) * SEISMIC_RESULT_0_STRIDE_1, base + selected[r]);
        }
    }
}
