// Decode output of the general routed feed-forward (M <= VERIFY_ROWS): the
// down projections (`lib/routed/down.glsl`) weighted in slot order, then
// base + selected published in R (`lib/routed/down_sum.glsl`), in one
// launch. The Vulkan form of `metal/routed_down.metal`. Each lane with
// `SEISMIC_LANE % DOWN_LANES < DOWN_R` accumulates its single channel in one
// scalar register and stores it after the K-choice loop.
#define ROUTED_SOURCE_ROWS SEISMIC_DIM_XS
#define ROUTED_PROJECTED_KIND ROUTED_ACT
#define ROUTED_PROJECTED_BASE SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PROJECTED)
#define ROUTED_PROJECTED_INDEX(m, k, n) (((m) * SEISMIC_DIM_K + (k)) * SEISMIC_DIM_H + (n))
#define ROUTED_PROJECTED_PUT(m, k, n, value) \
    out_put(out_over_scratch(ROUTED_PROJECTED_KIND, ROUTED_PROJECTED_BASE), ROUTED_PROJECTED_INDEX(m, k, n), value)
#define KERNEL_A SEISMIC_ELEMENT_A
#include "lib/routed/down.glsl"
#include "lib/routed/down_sum.glsl"

void routed_down_summed() {
    const uint tile = gl_WorkGroupID.x;
    const uint64_t m = gl_WorkGroupID.y;
    const uint my_r = SEISMIC_LANE % DOWN_LANES;
    float selected = 0.0;
    float totals[PROJECTION_GEMV_SUMS];
    // A 32-bit counter: see `streaming/contract.hpp`.
    for (uint k = 0u; k < uint(SEISMIC_DIM_K); ++k) {
        routed_down_choice(m, uint64_t(k), tile, totals);
        const float weight = routed_down_weight_subgroup(
            routed_down_weight_row(m) + uint64_t(k) * SEISMIC_WEIGHTS_STRIDE_1 * 4ul);
        if (my_r < DOWN_R) {
            float projected = 0.0;
            [[unroll]] for (uint r = 0u; r < PROJECTION_GEMV_MAX_R; ++r)
                if (r < DOWN_R && r == my_r)
                    projected = totals[r * PROJECTION_GEMV_MAX_M];
            selected = routed_down_term_weighted(selected, weight, element_round(ROUTED_ACT, projected));
        }
    }
    const uint n = projection_gemv_first_row(DOWN_R, DOWN_LANES, tile) + my_r;
    if (my_r < DOWN_R && n < uint(SEISMIC_DIM_H))
        routed_down_put(m, uint64_t(n), selected);
}

void routed_down_gather() { routed_down_gather_worklist(); }
void routed_down_gathered2() { routed_down_gathered_bounded(2u); }
void routed_down_gathered4() { routed_down_gathered_bounded(4u); }
void routed_down_gathered8() { routed_down_gathered_bounded(8u); }
void routed_down_combine() { routed_down_sum_channel(false, 0ul); }
