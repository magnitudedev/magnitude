// dense_up: RMS prologue over the `out_rows` residual rows, the up
// projection, and A(act(A(scale * up)) * product_scale). The Vulkan form of `metal/dense_up.metal`
// over `lib/projection/projection.glsl`.
#define KERNEL_W0 SEISMIC_UP_WEIGHT
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_US != 0
#define PROJECTION_SCALED
#endif
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define DENSE_ACT ELEMENT_ACT
#else
#error "dense_up requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define DENSE_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define DENSE_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define DENSE_NORM ELEMENT_BF16
#else
#error "dense_up requires a dense norm"
#endif


projection_prologue dense_up_input() {
    return projection_rms(DENSE_ACT, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL), SEISMIC_RESIDUAL_STRIDE_0,
        SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_0, DENSE_NORM,
        element_word_f32(SEISMIC_PARAM_EPS), uint(SEISMIC_DIM_H), SEISMIC_PTR(SEISMIC_BUFFER_OUT_ROWS));
}

projection_epilogue dense_up_output() {
    return projection_scaled(projection_activated(DENSE_ACT, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, int(SEISMIC_PARAM_ACTIVATION)),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_UP_SCALE), SEISMIC_DIM_US, 0ul, 0ul), 1.0);
}

projection_weights dense_up_weight() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_UP_WEIGHT), PACKETS_W0_ROWS, uint(SEISMIC_DIM_H), 0ul, 1ul);
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void dense_up_gemv_bounded(const uint maxm) {
    const projection_weights w = dense_up_weight();
    projection_gemv(PACKETS_W0, PACKETS_W0, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_SHARED,
        dense_up_input(), dense_up_output(), w, w, uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_F), uint(SEISMIC_DIM_H),
        gl_WorkGroupID.x);
}

void dense_up_gemv1() { dense_up_gemv_bounded(1u); }
void dense_up_gemv2() { dense_up_gemv_bounded(2u); }
void dense_up_gemv4() { dense_up_gemv_bounded(4u); }
void dense_up_gemv8() { dense_up_gemv_bounded(8u); }

void dense_up_stage() {
    projection_stage(dense_up_input(), gl_WorkGroupID.x, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        uint(SEISMIC_DIM_H));
}

void dense_up_gemm() {
    const projection_prologue x = projection_plain(DENSE_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        SEISMIC_DIM_H, 1ul, uint(SEISMIC_DIM_H), 0ul);
    projection_gemm(PACKETS_W0, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N, x,
        dense_up_output(), dense_up_weight(), uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_F), uint(SEISMIC_DIM_H),
        gl_WorkGroupID.y, gl_WorkGroupID.x, 0xffffffffu);
}
