// dense_up: RMS prologue over the `out_rows` residual rows, the up
// projection, and A(act(A(scale * up)) * product_scale). The Vulkan form of `metal/dense_up.metal`
// on the `dense` projection (`lib/projection/operator.glsl`).
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_UP_WEIGHT
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_US != 0
#define PROJECTION_SCALED
#endif
#include "lib/projection/projection.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "dense_up requires a bf16 or f16 activation"
#endif
#define DENSE_ACT ACTIVATION_A
#define DENSE_NORM ELEMENT_OF(SEISMIC_NORM)
// The up weight's operand rows (the normalized rows, or NVFP4 operands): the
// GEMV forms them while staging, the stage launch into the GEMM's scratch.
#if PACKETS_OPERANDS_NVFP4(SEISMIC_UP_WEIGHT)
#define DENSE_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define DENSE_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif


#define PROJECTION_SINGLE
#define PROJECTION_M uint(SEISMIC_DIM_O)
#define PROJECTION_N uint(SEISMIC_DIM_F)
#define PROJECTION_K uint(SEISMIC_DIM_H)
#define PROJECTION_G 1
#define PROJECTION_NORM PROJECTION_NORM_SHARED
#define PROJECTION_STAGED SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED)
#define PROJECTION_SPLIT SEISMIC_TUNE_SPLIT
#define PROJECTION_PARTIALS SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS)

projection_prologue projected_input(uint g) {
    return projection_operands(projection_rms(DENSE_ACT, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL), SEISMIC_RESIDUAL_STRIDE_0,
        SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_0, DENSE_NORM,
        element_word_f32(SEISMIC_PARAM_EPS), uint(SEISMIC_DIM_H), SEISMIC_PTR(SEISMIC_BUFFER_OUT_ROWS)),
        DENSE_OPERANDS);
}

// The normalized rows the stage launch formed.
projection_prologue projected_rows(uint g) {
    return projection_plain(DENSE_ACT, PROJECTION_STAGED, SEISMIC_DIM_H, 1ul, uint(SEISMIC_DIM_H), 0ul);
}

projection_epilogue projected_output(uint g) {
    return projection_scaled(projection_activated(DENSE_ACT, SEISMIC_RESULT_0_OUT,
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, int(SEISMIC_PARAM_ACTIVATION)),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_UP_SCALE), SEISMIC_DIM_US, 0ul, 0ul), 1.0);
}

projection_weights projected_weight(uint g) {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_UP_WEIGHT), PACKETS_W0_ROWS, uint(SEISMIC_DIM_H), 0ul, 1ul, 0u);
}

#include "lib/projection/operator.glsl"

// The `dense` projection's launches (`lib/projection/operator.glsl`).
void dense_up_stage() { projection_dense_stage(); }
void dense_up_gemv1() { projection_single_gemv(1u); }
void dense_up_gemv2() { projection_single_gemv(2u); }
void dense_up_gemv4() { projection_single_gemv(4u); }
void dense_up_gemv8() { projection_single_gemv(8u); }
void dense_up_gemm() { projection_single_gemm(); }
void dense_up_finalize() { projection_single_finalize(); }
