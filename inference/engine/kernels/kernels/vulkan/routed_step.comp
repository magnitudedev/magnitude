// Expert streaming, the step's words (`routed_step` in routed.seismic); the
// Vulkan form of `metal/routed_step.metal`: one invocation writes them
// (streaming/step.hpp). Every later entry of the step reads them in order on
// the same queue.
#include "lib/streaming/control.glsl"
#include "../streaming/step.hpp"

void routed_step() {
    if (gl_LocalInvocationIndex != 0u)
        return;
    streaming_step_words(SEISMIC_PTR(SEISMIC_BUFFER_STEP), SEISMIC_STEP_STRIDE_0, SEISMIC_PTR(SEISMIC_BUFFER_SEQUENCE),
        SEISMIC_SEQUENCE_STRIDE_0, SEISMIC_PTR(SEISMIC_BUFFER_GUESSES), SEISMIC_GUESSES_STRIDE_0,
        SEISMIC_GUESSES_STRIDE_1, uint(SEISMIC_DIM_T));
}
