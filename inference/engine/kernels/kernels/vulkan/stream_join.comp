// stream_join (contract and portable body in streams.seismic): four contiguous
// columns of a row per invocation, joining the F32 output into the streams
// through the output entries' join (`join_scatter4` / `join_scatter`: the
// inject values and, when the inject row carries one, their comb), or adding
// it to the one stream (IN = 0). As CUDA's.
#include <seismic/element.glsl>
#include "lib/projection/join.glsl"

void stream_join() {
    const uint64_t h = SEISMIC_DIM_H;
    const uint64_t vecs_per_row = (h + 3ul) >> 2u;
    const uint64_t count = SEISMIC_DIM_M * vecs_per_row;
    for (seismic_walk at = seismic_walk_grid(count, u64vec3(1ul, 1ul, vecs_per_row)); at.index < count; seismic_walk_next(at)) {
        const uint64_t row = at.axes.x, column = at.axes.w * 4ul;
        const uint64_t y_row = SEISMIC_PTR(SEISMIC_BUFFER_Y) + row * SEISMIC_Y_STRIDE_0 * 4ul;
        const Out result = out_offset(SEISMIC_RESULT_0_OUT, row * SEISMIC_RESULT_0_STRIDE_0);
        const uint64_t residual = SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL) + row * SEISMIC_RESIDUAL_STRIDE_0 * 4ul;
        if (column + 4ul <= h) {
            const vec4 y = join_detail_load4(
                y_row, SEISMIC_Y_STRIDE_1, column, SEISMIC_Y_STRIDE_1 == 1ul && ((y_row + column * 4ul) & 15ul) == 0ul);
            if (SEISMIC_DIM_IN == 0) {
                const vec4 base = join_detail_load4(residual, SEISMIC_RESIDUAL_STRIDE_1, column,
                    SEISMIC_RESIDUAL_STRIDE_1 == 1ul && ((residual + column * 4ul) & 15ul) == 0ul);
                join_detail_put4(result, SEISMIC_RESULT_0_STRIDE_1, column, base + y);
            } else {
                join_scatter4(result, SEISMIC_RESULT_0_STRIDE_1, residual, SEISMIC_RESIDUAL_STRIDE_1,
                    SEISMIC_PTR(SEISMIC_BUFFER_INJECT) + row * SEISMIC_INJECT_STRIDE_0 * 4ul, uint(SEISMIC_DIM_SN), uint(h),
                    SEISMIC_DIM_IN > SEISMIC_DIM_SN, column, y);
            }
            continue;
        }
        for (uint64_t c = column; c < h; ++c) {
            const float y = element_f32_at(y_row + c * SEISMIC_Y_STRIDE_1 * 4ul);
            if (SEISMIC_DIM_IN == 0) {
                out_put(result, c * SEISMIC_RESULT_0_STRIDE_1,
                    element_f32_at(residual + c * SEISMIC_RESIDUAL_STRIDE_1 * 4ul) + y);
            } else {
                join_scatter(result, SEISMIC_RESULT_0_STRIDE_1, residual, SEISMIC_RESIDUAL_STRIDE_1,
                    SEISMIC_PTR(SEISMIC_BUFFER_INJECT) + row * SEISMIC_INJECT_STRIDE_0 * 4ul, uint(SEISMIC_DIM_SN),
                    uint(h), SEISMIC_DIM_IN > SEISMIC_DIM_SN, c, y);
            }
        }
    }
}
