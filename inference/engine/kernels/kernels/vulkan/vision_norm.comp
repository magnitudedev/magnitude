// vision_norm: one workgroup per result row r = cell * G + member, which
// normalizes source row r (or order[r] when NO = 1) and publishes it to Y at
// member * H (side by side) or, with `interleave`, channel by channel at
// stride G. Body in lib/vision/vision.glsl.
#include "lib/vision/vision.glsl"


#define WEIGHT_KIND ELEMENT_OF(SEISMIC_WEIGHT)

#define BIAS_KIND ELEMENT_OF(SEISMIC_BIAS)

void vision_norm() {
    const uint g = uint(SEISMIC_DIM_G), h = uint(SEISMIC_DIM_H);
    const uint cell = gl_WorkGroupID.y, member = gl_WorkGroupID.x;
    const uint64_t row = uint64_t(cell) * g + member;
    const uint64_t from = SEISMIC_DIM_NO == 1
        ? uint64_t(uint(element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_ORDER) + row * 4ul)))
        : row;
    const bool interleave = int(SEISMIC_PARAM_INTERLEAVE) != 0;
    const uint64_t first = uint64_t(cell) * SEISMIC_RESULT_0_STRIDE_0 + (interleave ? member : uint64_t(member) * h);
    const int centered_code = int(SEISMIC_PARAM_CENTERED);
    const int activation = int(SEISMIC_PARAM_ACTIVATION);
    if (centered_code < 0) {
        Out out_ = out_offset(SEISMIC_RESULT_0_OUT, first);
        const uint64_t stride = interleave ? uint64_t(g) : 1ul;
        const uint64_t src = SEISMIC_PTR(SEISMIC_BUFFER_SOURCE) + from * h * 4ul;
        for (uint i = SEISMIC_THREAD; i < h; i += gl_WorkGroupSize.x) {
            const float v = element_f32_at(src + uint64_t(i) * 4ul);
            out_put(out_, uint64_t(i) * stride, activation != 0 ? vision_activate(activation, v) : v);
        }
        return;
    }
    vision_row_norm(SEISMIC_PTR(SEISMIC_BUFFER_SOURCE) + from * h * 4ul,
        out_offset(SEISMIC_RESULT_0_OUT, first), interleave ? uint64_t(g) : 1ul,
        SEISMIC_DIM_NW == 1, SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), WEIGHT_KIND, SEISMIC_DIM_NB == 1,
        SEISMIC_PTR(SEISMIC_BUFFER_BIAS), BIAS_KIND, h, centered_code != 0,
        element_word_f32(SEISMIC_PARAM_EPSILON), activation);
}
