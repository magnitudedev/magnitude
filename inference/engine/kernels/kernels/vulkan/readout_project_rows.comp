// readout_project_rows: the draft head's readout, the vocabulary projection of
// feature rows that are already normalized into F32 logits, scaled by a
// present `weight_scale` and softcapped. The Vulkan form of
// `metal/readout_project_rows.metal`: where I is 0 the `dense` projection
// (`lib/projection/operator.glsl`) over the weight's first S rows; where I is
// 1 the routed projection's `choice` over the S rows each feature row
// selects (`gather_choice`), a selection past the vocabulary -inf.
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_WEIGHT
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_WS != 0
#define PROJECTION_SCALED
#endif
// A selection past the vocabulary reads row 0 (`projection_weights_row`).
#define PROJECTION_TABLE_ROWS SEISMIC_DIM_V
#include "lib/projection/projection.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "readout_project_rows requires a bf16 or f16 activation"
#endif
#define HEAD_ACT ACTIVATION_A
// The weight's operand rows (the feature rows, or NVFP4 operands): the GEMV
// forms them while staging, the stage launch into the scratch the GEMM reads.
#if PACKETS_OPERANDS_NVFP4(SEISMIC_WEIGHT)
#define HEAD_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define HEAD_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif

#define HEAD_K uint(SEISMIC_DIM_D)

#define PROJECTION_SINGLE
#define PROJECTION_M uint(SEISMIC_DIM_O)
#define PROJECTION_N uint(SEISMIC_DIM_S)
#define PROJECTION_K HEAD_K
#define PROJECTION_G 1
#define PROJECTION_NORM PROJECTION_NORM_NONE
#define PROJECTION_STAGED SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED)
#define PROJECTION_SPLIT SEISMIC_TUNE_SPLIT
#define PROJECTION_PARTIALS SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS)

// Feature row `row` onward, as the weight's operands.
projection_prologue feature_rows(uint64_t row) {
    return projection_operands(projection_plain(HEAD_ACT,
        SEISMIC_PTR(SEISMIC_BUFFER_FEATURES) + row * SEISMIC_FEATURES_STRIDE_0 * uint64_t(ELEMENT_BYTES(HEAD_ACT)),
        SEISMIC_FEATURES_STRIDE_0, SEISMIC_FEATURES_STRIDE_1, HEAD_K, 0ul), HEAD_OPERANDS);
}

// The logits from those at `at`, scaled, then softcapped.
projection_epilogue logits_at(Out at) {
    return projection_scaled(projection_logits(at, SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1,
        element_word_f32(SEISMIC_PARAM_SOFTCAP)),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT_SCALE), SEISMIC_DIM_WS, 0ul, 0ul), 1.0);
}

projection_prologue projected_input(uint g) { return feature_rows(0ul); }

// The rows the GEMM reads: the feature rows, or the operands the stage
// launch formed.
projection_prologue projected_rows(uint g) {
#if PACKETS_OPERANDS_NVFP4(SEISMIC_WEIGHT)
    return projection_plain(HEAD_ACT, PROJECTION_STAGED, uint64_t(HEAD_K), 1ul, HEAD_K, 0ul);
#else
    return projection_plain(HEAD_ACT, SEISMIC_PTR(SEISMIC_BUFFER_FEATURES), SEISMIC_FEATURES_STRIDE_0,
        SEISMIC_FEATURES_STRIDE_1, HEAD_K, 0ul);
#endif
}

projection_epilogue projected_output(uint g) { return logits_at(SEISMIC_RESULT_0_OUT); }

// The weight's first S rows.
projection_weights projected_weight(uint g) {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), PACKETS_W0_ROWS, HEAD_K, 0ul, 1ul, 0u);
}

#include "lib/projection/operator.glsl"

// The `dense` projection's launches (`lib/projection/operator.glsl`).
void readout_project_rows_stage() { projection_dense_stage(); }
void readout_project_rows_gemv1() { projection_single_gemv(1u); }
void readout_project_rows_gemv2() { projection_single_gemv(2u); }
void readout_project_rows_gemv4() { projection_single_gemv(4u); }
void readout_project_rows_gemv8() { projection_single_gemv(8u); }
void readout_project_rows_gemm() { projection_single_gemm(); }
void readout_project_rows_finalize() { projection_single_finalize(); }

// The routed projection's `choice` over row m's selected rows (choice y % I):
// workgroup x a tile of SUBGROUPS x ROWS selected rows, the K1 GEMV of the
// feature row against them. Each row's logit is published by the lane that
// holds its sum (`projection_gemv`'s epilogue lane), -inf for a selection
// past the vocabulary, so one invocation stores each logit.
void readout_project_rows_gather_choice() {
    const uint r_rows = SEISMIC_TUNE_GATHER_ROWS;
    const uint tile = gl_WorkGroupID.x, s = uint(SEISMIC_DIM_S);
    uint64_t m, choice;
    seismic_split(gl_WorkGroupID.y, SEISMIC_DIM_I, m, choice);
    const uint64_t selected = SEISMIC_PTR(SEISMIC_BUFFER_TOKEN_ROWS)
        + (m * SEISMIC_TOKEN_ROWS_STRIDE_0 + choice * SEISMIC_TOKEN_ROWS_STRIDE_1) * 4ul;
    const Out row = out_offset(SEISMIC_RESULT_0_OUT, m * SEISMIC_RESULT_0_STRIDE_0);
    const projection_weights w = projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), PACKETS_W0_ROWS, HEAD_K,
        selected, SEISMIC_TOKEN_ROWS_STRIDE_2, 0u);
    float totals[PROJECTION_GEMV_SUMS], totals2[PROJECTION_GEMV_SUMS];
    projection_gemv_sums(PACKETS_W0, PACKETS_W0, false, r_rows, 32u, 1u, false, false, PROJECTION_NORM_NONE,
        feature_rows(m), w, w, 1u, s, HEAD_K, tile, totals, totals2);
    const uint first_row = projection_gemv_first_row(r_rows, 32u, tile);
    [[unroll]] for (uint r = 0u; r < r_rows; ++r) {
        const uint n = first_row + r;
        if (SEISMIC_LANE == r && n < s) {
            const int token = element_i32_at(selected + uint64_t(n) * SEISMIC_TOKEN_ROWS_STRIDE_2 * 4ul);
            if (token < 0 || uint64_t(token) >= SEISMIC_DIM_V)
                out_put(row, uint64_t(n) * SEISMIC_RESULT_0_STRIDE_1, uintBitsToFloat(0xff800000u));
            else
                projection_put(logits_at(row), 0u, n, totals[r * PROJECTION_GEMV_MAX_M]);
        }
    }
}
