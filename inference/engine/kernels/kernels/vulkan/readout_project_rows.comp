// readout_project_rows: the draft head's readout, the vocabulary projection of
// feature rows that are already normalized (K1 projection without a
// prologue). The Vulkan form of `metal/readout_project_rows.metal`.
#define KERNEL_W0 SEISMIC_WEIGHT
#include "lib/core/activation.glsl"
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define HEAD_ACT ELEMENT_ACT
#else
#error "readout_project_rows requires a bf16 or f16 activation"
#endif


#define HEAD_K uint(SEISMIC_DIM_D)

projection_prologue prepared_input() {
    const uint64_t row = uint64_t(gl_WorkGroupID.y);
    return projection_plain(HEAD_ACT, SEISMIC_PTR(SEISMIC_BUFFER_FEATURES) + row * SEISMIC_FEATURES_STRIDE_0 * 2ul,
        SEISMIC_FEATURES_STRIDE_0, SEISMIC_FEATURES_STRIDE_1, HEAD_K, 0ul);
}
projection_epilogue prepared_output() {
    const uint64_t column = SEISMIC_DIM_I == 0 ? 0ul : uint64_t(gl_WorkGroupID.x);
    return projection_scaled(projection_logits(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER) +
        (uint64_t(gl_WorkGroupID.y) * SEISMIC_RESULT_0_STRIDE_0 + column * SEISMIC_RESULT_0_STRIDE_1) * 4ul, SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, element_word_f32(SEISMIC_PARAM_SOFTCAP)),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT_SCALE), SEISMIC_DIM_WS, 0ul, 0ul), 1.0);
}
void readout_project_rows_gemv() {
    const uint64_t table = SEISMIC_DIM_I == 0 ? 0ul : SEISMIC_PTR(SEISMIC_BUFFER_TOKEN_ROWS) +
        (uint64_t(gl_WorkGroupID.y) * SEISMIC_TOKEN_ROWS_STRIDE_0 + uint64_t(gl_WorkGroupID.x) * SEISMIC_TOKEN_ROWS_STRIDE_2) * 4ul;
    if (SEISMIC_DIM_I == 1) {
        const int token = element_i32_at(table);
        if (token < 0 || uint64_t(token) >= SEISMIC_DIM_V) {
            if (gl_LocalInvocationIndex == 0u)
                element_f32_put(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER) +
                    (uint64_t(gl_WorkGroupID.y) * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(gl_WorkGroupID.x) * SEISMIC_RESULT_0_STRIDE_1) * 4ul, uintBitsToFloat(0xff800000u));
            return;
        }
    }
    const projection_weights w = projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), PACKETS_W0_ROWS,
        HEAD_K, table, SEISMIC_TOKEN_ROWS_STRIDE_2);
    projection_gemv(PACKETS_W0, PACKETS_W0, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, 1u, PROJECTION_NORM_NONE,
        prepared_input(), prepared_output(), w, w, 1u, SEISMIC_DIM_I == 1 ? 1u : uint(SEISMIC_DIM_S), HEAD_K, SEISMIC_DIM_I == 1 ? 0u : gl_WorkGroupID.x);
}
