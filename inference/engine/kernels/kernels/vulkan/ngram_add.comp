// ngram_add (contract and portable body in ngram.seismic): each stream's
// gated value row added into its streams. The Vulkan form of
// `cuda/ngram_add.cu`: an invocation owns one channel, and the y grid visits
// the rows with a stride.
#include <seismic/element.glsl>

void ngram_add() {
    const uint64_t channel = uint64_t(gl_WorkGroupID.x) * gl_WorkGroupSize.x + gl_LocalInvocationIndex;
    if (channel >= SEISMIC_DIM_S * SEISMIC_DIM_H)
        return;
    const uint64_t stream = channel / SEISMIC_DIM_H;
    const uint64_t column = channel % SEISMIC_DIM_H;
    for (uint64_t row = gl_WorkGroupID.y; row < SEISMIC_DIM_M; row += gl_NumWorkGroups.y) {
        const float gated = seismic_mul_rn(
            element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_SCALES)
                + (row * SEISMIC_SCALES_STRIDE_0 + stream * SEISMIC_SCALES_STRIDE_1) * 4ul),
            element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_VALUE)
                + (row * SEISMIC_VALUE_STRIDE_0 + column * SEISMIC_VALUE_STRIDE_1) * 4ul));
        const float residual = element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN)
            + (row * SEISMIC_HIDDEN_STRIDE_0 + channel * SEISMIC_HIDDEN_STRIDE_1) * 4ul);
        element_f32_put(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER)
            + (row * SEISMIC_RESULT_0_STRIDE_0 + channel * SEISMIC_RESULT_0_STRIDE_1) * 4ul,
            seismic_add_rn(residual, gated));
    }
}
