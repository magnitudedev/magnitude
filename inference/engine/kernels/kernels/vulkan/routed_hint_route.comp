// Ahead-of-step expert hints (`routed_hint_route`) on the `dense` projection
// operator, segmented over `(next_router, after_router)` in the CPU 8-lane
// reference order; segment 1 is zeroed when `AHEAD < 2`.
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_NEXT_ROUTER
#define KERNEL_W1 SEISMIC_AFTER_ROUTER
#include "lib/core/activation.glsl"
#include "lib/projection/projection.glsl"
#define ROUTE_E uint(SEISMIC_DIM_EN)
#define ROUTE_STRIDE uint(SEISMIC_DIM_EN)
#define ROUTE_K uint(SEISMIC_DIM_K)
#define ROUTE_PER_LANE ((ROUTE_E + 31u) / 32u)
#include "lib/routed/ranked.glsl"
ROUTE_DEFINE_RANK_AT
#include "lib/streaming/control.glsl"
#include "../streaming/hint.hpp"

#define HINT_NORM ELEMENT_OF(SEISMIC_NEXT_NORM)

#define HINT_H uint(SEISMIC_DIM_H)

projection_prologue hint_segment_input(const uint s) {
    const uint64_t norm_ptr = s == 0u ? SEISMIC_PTR(SEISMIC_BUFFER_NEXT_NORM) : SEISMIC_PTR(SEISMIC_BUFFER_AFTER_NORM);
    const uint64_t norm_s0 = s == 0u ? SEISMIC_NEXT_NORM_STRIDE_0 : SEISMIC_AFTER_NORM_STRIDE_0;
    return projection_ordered_input(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL),
        SEISMIC_RESIDUAL_STRIDE_0, SEISMIC_RESIDUAL_STRIDE_1, norm_ptr, norm_s0, HINT_NORM,
        element_word_f32(SEISMIC_PARAM_EPS), HINT_H, 0ul, uint(SEISMIC_DIM_NM), uint(SEISMIC_DIM_PT));
}

projection_prologue projected_input(uint g) { return hint_segment_input(0u); }
projection_prologue projected_rows(uint g) { return hint_segment_input(0u); }

#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_K HINT_H
#define PROJECTION_NORM PROJECTION_NORM_SHARED
#define PROJECTION_ZEROED(s) ((s) == 1 && SEISMIC_DIM_AHEAD < 2ul)
#define PROJECTION_SEGMENT_INPUT(s) hint_segment_input(uint(s))
#define PROJECTION_N0 uint(SEISMIC_DIM_EN)
#define PROJECTION_N1 uint(SEISMIC_DIM_EN)
#define PROJECTION_WEIGHT0 projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_NEXT_ROUTER), PACKETS_W0_ROWS, HINT_H, 0ul, 1ul, 0u)
#define PROJECTION_WEIGHT1 projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_AFTER_ROUTER), PACKETS_W1_ROWS, HINT_H, 0ul, 1ul, 0u)
#define PROJECTION_OUTPUT0 projection_store(out_over_scratch(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS)), SEISMIC_DIM_EN, 1ul, 0ul)
#define PROJECTION_OUTPUT1 projection_store(out_over_scratch(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS) + SEISMIC_DIM_M * SEISMIC_DIM_EN * 4ul), SEISMIC_DIM_EN, 1ul, 0ul)
#include "lib/projection/ordered.glsl"

void routed_hint_route_ordered_gemv() { projection_segmented_ordered_gemv_all(); }

void routed_hint_route_publish() {
    const uint lead = gl_WorkGroupID.y;
    const uint64_t plane = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS)
        + uint64_t(lead) * SEISMIC_DIM_M * SEISMIC_DIM_EN * 4ul;
    // Steered while a logical subgroup holds a row: one past the rows on a
    // 64-lane hardware subgroup ranks the last row again and stores nothing.
    bool live;
    for (uint64_t placed = SEISMIC_SUBGROUP; seismic_steer(live, placed < SEISMIC_DIM_M);
         placed += SEISMIC_SUBGROUPS) {
        const uint64_t row = live ? placed : SEISMIC_DIM_M - 1ul;
        float chosen[ROUTE_K];
        int winners[ROUTE_K];
        route_rank_at(plane, row, chosen, winners);
        if (live && SEISMIC_LANE == 0u)
            for (uint r = 0u; r < ROUTE_K; ++r) {
                seismic_shared_i32[uint(STREAMING_HINT_CHOSEN(uint(row))) + r] = winners[r];
                seismic_shared_i32[uint(STREAMING_HINT_WEIGHT(uint(SEISMIC_DIM_M), uint(row))) + r] =
                    floatBitsToInt(chosen[r]);
            }
    }
    streaming_hint(uint(SEISMIC_DIM_M), SEISMIC_PTR(SEISMIC_BUFFER_RINGS) + uint64_t(lead) * SEISMIC_RINGS_STRIDE_0 * 4ul,
        SEISMIC_RINGS_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_STEP), SEISMIC_STEP_STRIDE_0,
        0u, SEISMIC_THREAD, gl_WorkGroupSize.x);
}
