// short_conv_project: RMS prologue over every residual row, then one
// segmented projection: the u segment pairs the B and X streams into
// u = B * X (F32, columns 0..CH), the C segment stores C (F32, columns
// CH..2CH). The Vulkan form of `metal/short_conv_project.metal`.
#define KERNEL_W0 SEISMIC_B_WEIGHT
#define KERNEL_W1 SEISMIC_C_WEIGHT
#define KERNEL_W2 SEISMIC_X_WEIGHT
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_BS != 0 || SEISMIC_STATIC_CS != 0 || SEISMIC_STATIC_XS != 0
#define PROJECTION_SCALED
#endif
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define CONV_ACT ELEMENT_ACT
#else
#error "short_conv_project requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define CONV_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define CONV_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define CONV_NORM ELEMENT_BF16
#else
#error "short_conv_project requires a dense norm"
#endif
// The rows the three weights take (the normalized rows, or NVFP4 operands):
// the GEMV forms them while staging, the stage launch into the GEMM's
// scratch.
#if defined(SEISMIC_B_WEIGHT_OPERANDS_NVFP4)
#define CONV_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define CONV_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif




#define CONV_H uint(SEISMIC_DIM_H)
#define CONV_CH uint(SEISMIC_DIM_CH)

projection_prologue short_conv_project_input() {
    return projection_operands(projection_rms(CONV_ACT, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL),
        SEISMIC_RESIDUAL_STRIDE_0, SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_0,
        CONV_NORM, element_word_f32(SEISMIC_PARAM_EPS), CONV_H, 0ul), CONV_OPERANDS);
}

projection_epilogue short_conv_project_u() {
    return projection_scaled(projection_mul(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_B_SCALE), SEISMIC_DIM_BS, 0ul, 0ul),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_X_SCALE), SEISMIC_DIM_XS, 0ul, 0ul));
}

projection_epilogue short_conv_project_c() {
    return projection_scaled(projection_store(ELEMENT_F32, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, SEISMIC_DIM_CH),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_C_SCALE), SEISMIC_DIM_CS, 0ul, 0ul), 1.0);
}

projection_weights short_conv_project_b() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_B_WEIGHT), PACKETS_W0_ROWS, CONV_H, 0ul, 1ul);
}
projection_weights short_conv_project_x() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_X_WEIGHT), PACKETS_W2_ROWS, CONV_H, 0ul, 1ul);
}
projection_weights short_conv_project_cw() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_C_WEIGHT), PACKETS_W1_ROWS, CONV_H, 0ul, 1ul);
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void short_conv_project_gemv_bounded(const uint maxm) {
    const uint per = projection_gemv_rows(SEISMIC_TUNE_SIMDGROUPS, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES);
    const uint rows = uint(SEISMIC_DIM_M), tile = gl_WorkGroupID.x, segment = (CONV_CH + per - 1u) / per;
    const projection_prologue x = short_conv_project_input();
    if (tile < segment) {
        projection_gemv(PACKETS_W0, PACKETS_W2, true, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_SHARED, x,
            short_conv_project_u(), short_conv_project_b(), short_conv_project_x(), rows, CONV_CH, CONV_H, tile);
    } else {
        const projection_weights w = short_conv_project_cw();
        projection_gemv(PACKETS_W1, PACKETS_W1, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_SHARED, x,
            short_conv_project_c(), w, w, rows, CONV_CH, CONV_H, tile - segment);
    }
}

void short_conv_project_gemv1() { short_conv_project_gemv_bounded(1u); }
void short_conv_project_gemv2() { short_conv_project_gemv_bounded(2u); }
void short_conv_project_gemv4() { short_conv_project_gemv_bounded(4u); }
void short_conv_project_gemv8() { short_conv_project_gemv_bounded(8u); }

void short_conv_project_stage() {
    projection_stage(short_conv_project_input(), gl_WorkGroupID.x, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        CONV_H);
}

// Workgroup column n < S (the u segment's TILE_N / 2-feature tiles) runs the
// paired GEMM, the rest the C segment's TILE_N-feature tiles.
void short_conv_project_gemm() {
    const projection_prologue x = projection_plain(CONV_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        SEISMIC_DIM_H, 1ul, CONV_H, 0ul);
    const uint half_tile = SEISMIC_TUNE_TILE_N / 2u, segment = (CONV_CH + half_tile - 1u) / half_tile;
    const uint m = uint(SEISMIC_DIM_M), n = gl_WorkGroupID.x;
    if (n < segment)
        projection_gemm_paired(PACKETS_W0, PACKETS_W2, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M,
            SEISMIC_TUNE_SUB_N, x, short_conv_project_u(), short_conv_project_b(), short_conv_project_x(), m,
            CONV_CH, CONV_H, gl_WorkGroupID.y, n, 0xffffffffu);
    else
        projection_gemm(PACKETS_W1, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N, x,
            short_conv_project_c(), short_conv_project_cw(), m, CONV_CH, CONV_H, gl_WorkGroupID.y, n - segment,
            0xffffffffu);
}
