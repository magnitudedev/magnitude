#include <seismic/element.glsl>
void place_logits_fill() {
    const uint64_t scores = SEISMIC_PTR(SEISMIC_BUFFER_SCORES), token_rows = SEISMIC_PTR(SEISMIC_BUFFER_TOKEN_ROWS), logits = SEISMIC_PTR(SEISMIC_BUFFER_LOGITS);
    const uint64_t stride = uint64_t(gl_NumWorkGroups.x) * gl_WorkGroupSize.x;
    for (uint64_t index = gl_GlobalInvocationID.x; index < SEISMIC_DIM_M * SEISMIC_DIM_V; index += stride) {
        const uint64_t row = index / SEISMIC_DIM_V, col = index % SEISMIC_DIM_V;
        element_f32_put(logits + (row * SEISMIC_LOGITS_STRIDE_0 + col * SEISMIC_LOGITS_STRIDE_1) * 4ul, -uintBitsToFloat(0x7f800000u));
    }
}
void place_logits_rows() {
    const uint64_t scores = SEISMIC_PTR(SEISMIC_BUFFER_SCORES), token_rows = SEISMIC_PTR(SEISMIC_BUFFER_TOKEN_ROWS), logits = SEISMIC_PTR(SEISMIC_BUFFER_LOGITS);
    const uint64_t stride = uint64_t(gl_NumWorkGroups.x) * gl_WorkGroupSize.x;
    for (uint64_t index = gl_GlobalInvocationID.x; index < SEISMIC_DIM_M * SEISMIC_DIM_S; index += stride) {
        const uint64_t row = index / SEISMIC_DIM_S, col = index % SEISMIC_DIM_S;
        const int token = element_i32_at(token_rows + (row * SEISMIC_TOKEN_ROWS_STRIDE_0 + col * SEISMIC_TOKEN_ROWS_STRIDE_1) * 4ul);
        if (token >= 0 && uint64_t(token) < SEISMIC_DIM_V)
            element_f32_put(logits + (row * SEISMIC_LOGITS_STRIDE_0 + uint64_t(token) * SEISMIC_LOGITS_STRIDE_1) * 4ul, element_f32_at(scores + (row * SEISMIC_SCORES_STRIDE_0 + col * SEISMIC_SCORES_STRIDE_1) * 4ul));
    }
}
