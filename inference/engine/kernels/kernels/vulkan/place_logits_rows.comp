#include <seismic/element.glsl>
void place_logits_fill() {
    const Out logits = SEISMIC_OUT_LOGITS;
    for (seismic_walk at = seismic_walk_grid(SEISMIC_DIM_M * SEISMIC_DIM_V, u64vec3(1ul, 1ul, SEISMIC_DIM_V));
            at.index < SEISMIC_DIM_M * SEISMIC_DIM_V; seismic_walk_next(at)) {
        const uint64_t row = at.axes.x, col = at.axes.w;
        out_put(logits, row * SEISMIC_LOGITS_STRIDE_0 + col * SEISMIC_LOGITS_STRIDE_1, -uintBitsToFloat(0x7f800000u));
    }
}
void place_logits_rows() {
    const uint64_t scores = SEISMIC_PTR(SEISMIC_BUFFER_SCORES), token_rows = SEISMIC_PTR(SEISMIC_BUFFER_TOKEN_ROWS);
    const Out logits = SEISMIC_OUT_LOGITS;
    for (seismic_walk at = seismic_walk_grid(SEISMIC_DIM_M * SEISMIC_DIM_S, u64vec3(1ul, 1ul, SEISMIC_DIM_S));
            at.index < SEISMIC_DIM_M * SEISMIC_DIM_S; seismic_walk_next(at)) {
        const uint64_t row = at.axes.x, col = at.axes.w;
        const int token = element_i32_at(token_rows + (row * SEISMIC_TOKEN_ROWS_STRIDE_0 + col * SEISMIC_TOKEN_ROWS_STRIDE_1) * 4ul);
        if (token >= 0 && uint64_t(token) < SEISMIC_DIM_V)
            out_put(logits, row * SEISMIC_LOGITS_STRIDE_0 + uint64_t(token) * SEISMIC_LOGITS_STRIDE_1, element_f32_at(scores + (row * SEISMIC_SCORES_STRIDE_0 + col * SEISMIC_SCORES_STRIDE_1) * 4ul));
    }
}
