// Exact GGUF -> resident conversion (the Seismic registry's registered
// `repack`) into `rows16` storage, the Vulkan resident layout (spec §10.1).
// E is the GGUF source, U the resident (representation, layout); the entry
// sees every weight as a [B, N, K] view. The placement of each row tile is
// <seismic/repack.glsl>'s, the one expert streaming's slots are written by.
//
// Each workgroup (32 invocations) places one row tile: 16 rows x one unit of
// the span's columns (`resident_tile_columns`), an invocation a row. The grid
// holds a workgroup per unit; those past the row's units place nothing. The
// result is a record port (bank records, chunked, import through it): matrix
// b is written from its own record's base.
#include <seismic/slab.glsl>
#include <seismic/repack.glsl>

#if !defined(SEISMIC_ELEMENT_E_KIND_EXTERNAL) || !REPACK_ROWS16(SEISMIC_ELEMENT_U)
#error "repack_weight converts an external GGUF source into rows16 resident storage"
#endif

#if !defined(SEISMIC_CONVERSION_E_U)
#error "repack_weight binding is not a registered GGUF-to-resident conversion"
#endif

// The binding: the result is rows16 storage (above) of exactly the source's
// groups, so every stored tile holds source packets.
REPACK_TILE(resident, SEISMIC_CONVERSION_E_U, SEISMIC_ELEMENT_E, SEISMIC_RESULT_0)

// A planar source (`ExternalPacketLayout::planes`): each matrix holds its
// rows' packets' codes, then the grid of its tiles' scales, byte-packed
// (`REPACK_PLANAR_SOURCE`, the matrix's extents the binding's). Any other
// source holds its packets alone.
REPACK_PLANAR_SOURCE(source, SEISMIC_ELEMENT_E, SEISMIC_DIM_N, SEISMIC_DIM_K)

// The codes of source packet `index` of row `n` of matrix `b`.
uint64_t source_packet(uint64_t source, uint64_t b, uint64_t n, uint64_t index) {
    if (REPACK_PLANAR(SEISMIC_ELEMENT_E))
        return source + b * source_matrix_bytes() + source_code_at(n, index);
    return source
        + (b * SEISMIC_SOURCE_STRIDE_0 + n * SEISMIC_SOURCE_STRIDE_1 + index * SEISMIC_SOURCE_STRIDE_2)
        * uint64_t(REPACK_PACKET_BYTES(SEISMIC_ELEMENT_E));
}

// The scale of the tile holding that packet (none beside a plain source's).
uint64_t source_scale(uint64_t source, uint64_t b, uint64_t n, uint64_t index) {
    if (REPACK_PLANAR(SEISMIC_ELEMENT_E))
        return source + b * source_matrix_bytes() + source_scale_at(n, index);
    return 0ul;
}

// Start of stored row `n` of matrix `b`, from its record's base in the
// result's record table.
uint64_t row_base(uint64_t destination, uint64_t b, uint64_t n) {
    return slab_region(destination, b) + n * SEISMIC_RESULT_0_STRIDE_1 * REPACK_ROW_BYTES(SEISMIC_RESULT_0);
}

void repack_weight() {
    const uint64_t source = SEISMIC_PTR(SEISMIC_BUFFER_SOURCE);
    const uint64_t destination = SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER);
    const uint lane = gl_LocalInvocationID.x;
    const uint64_t b = gl_WorkGroupID.z;
    const uint64_t n = uint64_t(gl_WorkGroupID.y) * REPACK_TILE_ROWS + lane;
    const uint column0 = gl_WorkGroupID.x * resident_tile_columns();
    const uint64_t stored_columns = REPACK_ROW_GROUPS(SEISMIC_RESULT_0) * uint64_t(REPACK_GROUP(SEISMIC_ELEMENT_E));
    if (lane >= REPACK_TILE_ROWS || n >= SEISMIC_DIM_N || column0 >= stored_columns)
        return;
    const uint64_t index = column0 / uint(REPACK_GROUP(SEISMIC_ELEMENT_E));
    resident_place(source_packet(source, b, n, index), source_scale(source, b, n, index), row_base(destination, b, n),
        column0);
}
