// Decode expansion of gated experts (M <= VERIFY_ROWS): a K1 paired GEMV
// over the feature tile `x` of a chosen expert's gate and up rows (its
// source's record, `routed_expert_matrix`: a bank record, or a host tier
// record read in place; none for a choice with no record,
// `routed_decode_source`) with the activation-generic Glu epilogue. The
// Vulkan form of `metal/routed_gate_up.metal`; lane groups are whole
// subgroups. Two forms, which tuning admits between (GATHERED):
// - `routed_gate_up_choice` (per choice): workgroup row y = choice (m, k),
//   over its activation row.
// - `routed_gate_up_gathered*` (CUDA's gathered form): `routed_gate_up_gather`
//   writes each choice's table (`routed_gather`); workgroup row y = choice y
//   computes only where it is the first choice reading its record, over the
//   activation rows of every choice reading it, each publishing into its
//   choice's product, so each chosen record is read once a step (a choice
//   reading no record zeroes its own product). One launch per activation-row
//   bound (`projection_gemv`: one bound per pipeline).
// A choice's gate and up accumulators carry its expert's `gate_scale` /
// `up_scale` entries where those ports are present (static GS, US).
// The expansion's limit as its F32 bits LB (0: none), which the Glu epilogue
// clamps at.
#if SEISMIC_STATIC_LB != 0
#define PROJECTION_GLU_LIMIT SEISMIC_STATIC_LB
#endif
#if SEISMIC_STATIC_GS + SEISMIC_STATIC_US != 0
#define PROJECTION_SCALED
#endif
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_EXPERT_GATE
#define KERNEL_W1 SEISMIC_EXPERT_UP
#include "lib/core/activation.glsl"
#include "lib/routed/routed.glsl"

#define ROUTED_GATE_UP_PRODUCT SEISMIC_RESULT_0_OUT
#define ROUTED_GATE_UP_PRODUCT_STRIDE_0 SEISMIC_RESULT_0_STRIDE_0
#define ROUTED_GATE_UP_PRODUCT_STRIDE_1 SEISMIC_RESULT_0_STRIDE_1
#define ROUTED_GATE_UP_PRODUCT_STRIDE_2 SEISMIC_RESULT_0_STRIDE_2
#define ROUTED_GATE_UP_SOURCE_ROWS SEISMIC_DIM_XS
#include "lib/routed/gate_up.glsl"

void routed_gate_up_choice() { routed_gate_up_rows(gl_WorkGroupID.y, 0ul, 0ul, 1u, 1u); }

void routed_gate_up_gather() {
    const uint per_group = SEISMIC_TUNE_SIMDGROUPS * SEISMIC_TUNE_ROWS;
    const uint x_groups = (uint(SEISMIC_DIM_F) + per_group - 1u) / per_group;
    routed_build_worklist(SEISMIC_PTR(SEISMIC_BUFFER_ROUTES), SEISMIC_ROUTES_STRIDE_0, SEISMIC_ROUTES_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_SOURCES), SEISMIC_DIM_XS,
        SEISMIC_SOURCES_STRIDE_0, SEISMIC_SOURCES_STRIDE_1, SEISMIC_SOURCES_STRIDE_2,
        uint(SEISMIC_DIM_M), uint(SEISMIC_DIM_K), ROUTED_GATE_UP_PRODUCT_STRIDE_0, ROUTED_GATE_UP_PRODUCT_STRIDE_1,
        0u, x_groups, 0u, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_WORKLIST),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_GATHER_GRID));
}

void routed_gate_up_gathered2() { routed_gate_up_gathered_bounded(2u); }
void routed_gate_up_gathered4() { routed_gate_up_gathered_bounded(4u); }
void routed_gate_up_gathered8() { routed_gate_up_gathered_bounded(8u); }
