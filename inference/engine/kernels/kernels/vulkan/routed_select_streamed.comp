// Each lead's router GEMV (workgroup row y: 0 one layer ahead, 1 two).
void hint_routed_select_gemv() {
    if (gl_WorkGroupID.y == 0u)
        hint_select_gemv();
    else
        after_select_gemv();
}

// Each lead's ranking and hints (workgroup row y), into the lead's ring row.
void routed_select_hint() {
    const uint lead = gl_WorkGroupID.y;
    const uint64_t row = SEISMIC_SUBGROUP;
    if (row < SEISMIC_DIM_M) {
        float chosen[SELECT_K];
        int winners[SELECT_K];
        if (lead == 0u)
            hint_select_rank(row, chosen, winners);
        else
            after_select_rank(row, chosen, winners);
        if (SEISMIC_LANE == 0u)
            for (uint rank = 0u; rank < SELECT_K; ++rank)
                seismic_shared_i32[uint(row) * SELECT_K + rank] = winners[SELECT_K - 1u - rank];
    }
    routed_hint_publish(lead);
}
