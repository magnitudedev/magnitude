// gated_delta_project: RMS prologue over the F32 residual, then one
// segmented projection qkv | z | alpha | beta, each segment with its own
// representation, into one activation row per input row. The Vulkan form of
// `metal/gated_delta_project.metal` over `lib/projection/projection.glsl`.
#define KERNEL_W0 SEISMIC_QKV_WEIGHT
#define KERNEL_W1 SEISMIC_GATE_WEIGHT
#define KERNEL_W2 SEISMIC_ALPHA_WEIGHT
#define KERNEL_W3 SEISMIC_BETA_WEIGHT
#include "lib/core/activation.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define PROJECT_ACT ELEMENT_ACT
#else
#error "gated_delta_project requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_INPUT_NORM_REPRESENTATION_F32)
#define PROJECT_NORM ELEMENT_F32
#elif defined(SEISMIC_INPUT_NORM_REPRESENTATION_F16)
#define PROJECT_NORM ELEMENT_F16
#elif defined(SEISMIC_INPUT_NORM_REPRESENTATION_BF16)
#define PROJECT_NORM ELEMENT_BF16
#else
#error "gated_delta_project requires a dense input_norm"
#endif
// The rows every weight takes (the normalized rows, or NVFP4 operands): the
// GEMV forms them while staging, the stage launch into the GEMM's scratch.
#if defined(SEISMIC_QKV_WEIGHT_OPERANDS_NVFP4)
#define PROJECT_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define PROJECT_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif





#include "lib/projection/projection.glsl"

#define PROJECT_K uint(SEISMIC_DIM_H)
#define PROJECT_QKV_ROWS uint((2ul * SEISMIC_DIM_NK + SEISMIC_DIM_NV) * SEISMIC_DIM_W)
#define PROJECT_GATE_ROWS uint(SEISMIC_DIM_NV * SEISMIC_DIM_W)
#define PROJECT_HEAD_ROWS uint(SEISMIC_DIM_NV)

projection_prologue recurrent_project_input() {
    return projection_operands(projection_input(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN),
        SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_INPUT_NORM),
        SEISMIC_INPUT_NORM_STRIDE_0, PROJECT_NORM, element_word_f32(SEISMIC_PARAM_EPSILON), PROJECT_K, 0ul,
        uint(SEISMIC_DIM_NM), uint(SEISMIC_DIM_PT)), PROJECT_OPERANDS);
}

// Every segment writes its columns of the one result row.
projection_epilogue recurrent_project_out(uint column) {
    return projection_store(PROJECT_ACT, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, uint64_t(column));
}

projection_weights recurrent_project_weight(uint64_t base, packets_rows16 geometry) {
    return projection_weights(base, geometry, PROJECT_K, 0ul, 1ul);
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void gated_delta_project_gemv_bounded(const uint maxm) {
    const uint per = projection_gemv_rows(SEISMIC_TUNE_SIMDGROUPS, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES);
    const uint rows = uint(SEISMIC_DIM_M), tile = gl_WorkGroupID.x;
    const uint t0 = (PROJECT_QKV_ROWS + per - 1u) / per, t1 = (PROJECT_GATE_ROWS + per - 1u) / per;
    const uint t2 = (PROJECT_HEAD_ROWS + per - 1u) / per;
    const projection_prologue x = recurrent_project_input();
    if (tile < t0) {
        const projection_weights w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_QKV_WEIGHT), PACKETS_W0_ROWS);
        projection_gemv(PACKETS_W0, PACKETS_W0, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_SHARED,
            x, recurrent_project_out(0u), w, w, rows, PROJECT_QKV_ROWS, PROJECT_K, tile);
    } else if (tile < t0 + t1) {
        const projection_weights w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_GATE_WEIGHT), PACKETS_W1_ROWS);
        projection_gemv(PACKETS_W1, PACKETS_W1, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm,
            PROJECTION_NORM_SHARED, x, recurrent_project_out(PROJECT_QKV_ROWS), w, w, rows, PROJECT_GATE_ROWS,
            PROJECT_K, tile - t0);
    } else if (tile < t0 + t1 + t2) {
        const projection_weights w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_ALPHA_WEIGHT), PACKETS_W2_ROWS);
        projection_gemv(PACKETS_W2, PACKETS_W2, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm,
            PROJECTION_NORM_SHARED, x, recurrent_project_out(PROJECT_QKV_ROWS + PROJECT_GATE_ROWS), w, w, rows,
            PROJECT_HEAD_ROWS, PROJECT_K, tile - t0 - t1);
    } else {
        const projection_weights w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_BETA_WEIGHT), PACKETS_W3_ROWS);
        projection_gemv(PACKETS_W3, PACKETS_W3, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm,
            PROJECTION_NORM_SHARED, x, recurrent_project_out(PROJECT_QKV_ROWS + PROJECT_GATE_ROWS + PROJECT_HEAD_ROWS),
            w, w, rows, PROJECT_HEAD_ROWS, PROJECT_K, tile - t0 - t1 - t2);
    }
}

void gated_delta_project_gemv1() { gated_delta_project_gemv_bounded(1u); }
void gated_delta_project_gemv2() { gated_delta_project_gemv_bounded(2u); }
void gated_delta_project_gemv4() { gated_delta_project_gemv_bounded(4u); }
void gated_delta_project_gemv8() { gated_delta_project_gemv_bounded(8u); }

void gated_delta_project_stage() {
    projection_stage(recurrent_project_input(), gl_WorkGroupID.x, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        PROJECT_K);
}

// Workgroup column n belongs to the segment whose tiles hold it; the GEMM
// body runs once with that segment's kind, weights and destination columns.
void gated_delta_project_gemm() {
    const uint tn = SEISMIC_TUNE_TILE_N;
    const projection_prologue x = projection_plain(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        uint64_t(PROJECT_K), 1ul, PROJECT_K, 0ul);
    const uint m = uint(SEISMIC_DIM_M), n = gl_WorkGroupID.x, tm_index = gl_WorkGroupID.y;
    const uint t0 = (PROJECT_QKV_ROWS + tn - 1u) / tn, t1 = (PROJECT_GATE_ROWS + tn - 1u) / tn;
    const uint t2 = (PROJECT_HEAD_ROWS + tn - 1u) / tn;
    int kind;
    projection_weights w;
    uint rows, column, tile;
    if (n < t0) {
        kind = PACKETS_W0;
        w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_QKV_WEIGHT), PACKETS_W0_ROWS);
        rows = PROJECT_QKV_ROWS;
        column = 0u;
        tile = n;
    } else if (n < t0 + t1) {
        kind = PACKETS_W1;
        w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_GATE_WEIGHT), PACKETS_W1_ROWS);
        rows = PROJECT_GATE_ROWS;
        column = PROJECT_QKV_ROWS;
        tile = n - t0;
    } else if (n < t0 + t1 + t2) {
        kind = PACKETS_W2;
        w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_ALPHA_WEIGHT), PACKETS_W2_ROWS);
        rows = PROJECT_HEAD_ROWS;
        column = PROJECT_QKV_ROWS + PROJECT_GATE_ROWS;
        tile = n - t0 - t1;
    } else {
        kind = PACKETS_W3;
        w = recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_BETA_WEIGHT), PACKETS_W3_ROWS);
        rows = PROJECT_HEAD_ROWS;
        column = PROJECT_QKV_ROWS + PROJECT_GATE_ROWS + PROJECT_HEAD_ROWS;
        tile = n - t0 - t1 - t2;
    }
    projection_gemm(kind, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N, x,
        recurrent_project_out(column), w, m, rows, PROJECT_K, tm_index, tile, 0xffffffffu);
}
