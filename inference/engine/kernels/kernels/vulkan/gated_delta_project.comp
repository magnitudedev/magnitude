// gated_delta_project: RMS prologue over the F32 residual, then one
// segmented projection qkv | z | alpha | beta, each segment with its own
// representation, into one activation row per input row. The Vulkan form of
// `metal/gated_delta_project.metal` on the `dense` projection (`lib/projection/operator.glsl`).
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_QKV_WEIGHT
#define KERNEL_W1 SEISMIC_GATE_WEIGHT
#define KERNEL_W2 SEISMIC_ALPHA_WEIGHT
#define KERNEL_W3 SEISMIC_BETA_WEIGHT
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "gated_delta_project requires a bf16 or f16 activation"
#endif
#define PROJECT_ACT ACTIVATION_A
#define PROJECT_NORM ELEMENT_OF(SEISMIC_INPUT_NORM)
#include "lib/projection/projection.glsl"
// The rows every weight takes (the normalized rows, or NVFP4 operands): the
// GEMV forms them while staging, the stage launch into the GEMM's scratch.
#if PACKETS_OPERANDS_NVFP4(SEISMIC_QKV_WEIGHT)
#define PROJECT_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define PROJECT_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif

#define PROJECT_K uint(SEISMIC_DIM_H)
#define PROJECT_QKV_ROWS uint((2ul * SEISMIC_DIM_NK + SEISMIC_DIM_NV) * SEISMIC_DIM_W)
#define PROJECT_GATE_ROWS uint(SEISMIC_DIM_NV * SEISMIC_DIM_W)
#define PROJECT_HEAD_ROWS uint(SEISMIC_DIM_NV)

projection_prologue projected_input(uint g) {
    return projection_operands(projection_input(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN),
        SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_INPUT_NORM),
        SEISMIC_INPUT_NORM_STRIDE_0, PROJECT_NORM, element_word_f32(SEISMIC_PARAM_EPSILON), PROJECT_K, 0ul,
        uint(SEISMIC_DIM_NM), uint(SEISMIC_DIM_PT)), PROJECT_OPERANDS);
}

// Every segment writes its columns of the one result row.
projection_epilogue recurrent_project_out(uint column) {
    return projection_store(SEISMIC_RESULT_0_OUT, SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, uint64_t(column));
}

projection_weights recurrent_project_weight(uint64_t base, packets_rows16 geometry) {
    return projection_weights(base, geometry, PROJECT_K, 0ul, 1ul, 0u);
}

#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_K PROJECT_K
#define PROJECTION_NORM PROJECTION_NORM_SHARED
#define PROJECTION_STAGED SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED)
#define PROJECTION_N0 PROJECT_QKV_ROWS
#define PROJECTION_N1 PROJECT_GATE_ROWS
#define PROJECTION_N2 PROJECT_HEAD_ROWS
#define PROJECTION_N3 PROJECT_HEAD_ROWS
#define PROJECTION_WEIGHT0 recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_QKV_WEIGHT), PACKETS_W0_ROWS)
#define PROJECTION_WEIGHT1 recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_GATE_WEIGHT), PACKETS_W1_ROWS)
#define PROJECTION_WEIGHT2 recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_ALPHA_WEIGHT), PACKETS_W2_ROWS)
#define PROJECTION_WEIGHT3 recurrent_project_weight(SEISMIC_PTR(SEISMIC_BUFFER_BETA_WEIGHT), PACKETS_W3_ROWS)
#define PROJECTION_OUTPUT0 recurrent_project_out(0u)
#define PROJECTION_OUTPUT1 recurrent_project_out(PROJECT_QKV_ROWS)
#define PROJECTION_OUTPUT2 recurrent_project_out(PROJECT_QKV_ROWS + PROJECT_GATE_ROWS)
#define PROJECTION_OUTPUT3 recurrent_project_out(PROJECT_QKV_ROWS + PROJECT_GATE_ROWS + PROJECT_HEAD_ROWS)

// The normalized rows the stage launch formed.
projection_prologue projected_rows(uint g) {
    return projection_plain(PROJECT_ACT, PROJECTION_STAGED, uint64_t(PROJECT_K), 1ul, PROJECT_K, 0ul);
}

#include "lib/projection/operator.glsl"

// The `dense` projection's launches (`lib/projection/operator.glsl`).
void gated_delta_project_stage() { projection_dense_stage(); }
void gated_delta_project_gemv1() { projection_segmented_gemv(1u); }
void gated_delta_project_gemv2() { projection_segmented_gemv(2u); }
void gated_delta_project_gemv4() { projection_segmented_gemv(4u); }
void gated_delta_project_gemv8() { projection_segmented_gemv(8u); }
void gated_delta_project_gemm() { projection_segmented_gemm(); }
