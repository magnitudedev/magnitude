// draft_gated_rows: result = A(silu(gate) * up); one invocation per element
// over a grid-stride loop. The Vulkan form of `metal/draft_gated_rows.metal`.
#include "lib/core/activation.glsl"

void draft_gated_rows() {
    const uint64_t gate = SEISMIC_PTR(SEISMIC_BUFFER_GATE);
    const uint64_t up = SEISMIC_PTR(SEISMIC_BUFFER_UP);
    const uint64_t result = SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER);
    const uint64_t width = SEISMIC_DIM_F;
    const uint64_t count = SEISMIC_DIM_M * width;
    const uint64_t step = uint64_t(gl_NumWorkGroups.x) * gl_WorkGroupSize.x;
    for (uint64_t index = gl_GlobalInvocationID.x; index < count; index += step) {
        const uint64_t row = index / width, column = index % width;
        const float a = element_at(ELEMENT_ACT, gate, row * SEISMIC_GATE_STRIDE_0 + column * SEISMIC_GATE_STRIDE_1);
        const float b = element_at(ELEMENT_ACT, up, row * SEISMIC_UP_STRIDE_0 + column * SEISMIC_UP_STRIDE_1);
        element_put(ELEMENT_ACT, result, row * SEISMIC_RESULT_0_STRIDE_0 + column * SEISMIC_RESULT_0_STRIDE_1,
            a / (1.0 + exp(-a)) * b);
    }
}
