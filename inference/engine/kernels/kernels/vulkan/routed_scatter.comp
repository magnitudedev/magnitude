// Prefill output of the general routed feed-forward: the grouped expert
// outputs of each row unpermuted and weighted in slot order, published as
// base + selected in R. The Vulkan form of `metal/routed_scatter.metal`: an
// invocation owns 8 consecutive columns of one row.
#include "lib/core/activation.glsl"
#include "lib/routed/routed.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define ROUTED_ACT ELEMENT_ACT
#else
#error "routed_scatter requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_ELEMENT_R_REPRESENTATION_F32)
#define ROUTED_PUBLISHED ELEMENT_F32
#elif defined(SEISMIC_ELEMENT_R_REPRESENTATION_BF16)
#define ROUTED_PUBLISHED ELEMENT_BF16
#elif defined(SEISMIC_ELEMENT_R_REPRESENTATION_F16)
#define ROUTED_PUBLISHED ELEMENT_F16
#else
#error "routed_scatter requires a dense published element"
#endif

#define SCATTER_THREADS 256u

void routed_scatter() {
    const uint64_t m = gl_WorkGroupID.y;
    const uint n = 8u * (gl_WorkGroupID.x * SCATTER_THREADS + gl_LocalInvocationIndex);
    const uint columns = uint(SEISMIC_DIM_H);
    if (n >= columns)
        return;
    const uint valid = min(8u, columns - n);
    const bool vector = SEISMIC_EXPERT_OUTPUT_STRIDE_2 == 1ul && (SEISMIC_EXPERT_OUTPUT_STRIDE_1 & 7ul) == 0ul
        && (SEISMIC_EXPERT_OUTPUT_STRIDE_0 & 7ul) == 0ul;
    vec4 selected_even = vec4(0.0), selected_odd = vec4(0.0);
    for (uint64_t k = 0ul; k < SEISMIC_DIM_K; ++k) {
        const uint64_t position = uint64_t(element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_INVERSE)
            + (m * SEISMIC_INVERSE_STRIDE_0 + k * SEISMIC_INVERSE_STRIDE_1) * 4ul));
        const float weight = element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHTS)
            + (m * SEISMIC_WEIGHTS_STRIDE_0 + k * SEISMIC_WEIGHTS_STRIDE_1) * 4ul);
        const uint64_t row = (position / SEISMIC_DIM_T) * SEISMIC_EXPERT_OUTPUT_STRIDE_0
            + (position % SEISMIC_DIM_T) * SEISMIC_EXPERT_OUTPUT_STRIDE_1;
        vec4 even, odd;
        projection_load8_strided(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_OUTPUT),
            row + uint64_t(n) * SEISMIC_EXPERT_OUTPUT_STRIDE_2, SEISMIC_EXPERT_OUTPUT_STRIDE_2, valid, vector, even, odd);
        [[unroll]] for (uint i = 0u; i < 4u; ++i) {
            selected_even[i] = seismic_fma_rn(weight, even[i], selected_even[i]);
            selected_odd[i] = seismic_fma_rn(weight, odd[i], selected_odd[i]);
        }
    }
    [[unroll]] for (uint i = 0u; i < 8u; ++i) {
        if (i < valid) {
            const uint64_t column = uint64_t(n + i);
            const float selected = (i & 1u) != 0u ? selected_odd[i >> 1] : selected_even[i >> 1];
            element_put(ROUTED_PUBLISHED, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
                m * SEISMIC_RESULT_0_STRIDE_0 + column * SEISMIC_RESULT_0_STRIDE_1,
                element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_BASE)
                    + (m * SEISMIC_BASE_STRIDE_0 + column * SEISMIC_BASE_STRIDE_1) * 4ul) + selected);
        }
    }
}
