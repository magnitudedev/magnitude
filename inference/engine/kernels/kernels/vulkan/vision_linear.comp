// vision_linear: one 64 x 64 GEMM tile of y = x . transpose(weight) over the
// projection library with the Linear epilogue (`lib/vision/vision.glsl`): the
// bias, the clamp, then the activation, the gate or the F32 residual.
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_WEIGHT
#include "lib/core/activation.glsl"
#include "lib/vision/vision.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "vision_linear requires a bf16 or f16 activation"
#endif


#define BIAS_KIND ELEMENT_OF(SEISMIC_BIAS)


void vision_linear() {
    const uint n = uint(SEISMIC_DIM_N), k = uint(SEISMIC_DIM_K);
    const projection_prologue in_ = projection_plain(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_X), SEISMIC_X_STRIDE_0, 1ul,
        k, 0ul);
    const bool clamped = SEISMIC_DIM_NC == 1;
    const vision_epilogue out_ = vision_linear_epilogue(ACTIVATION_A, int(SEISMIC_PARAM_ACTIVATION),
        SEISMIC_RESULT_0_OUT, SEISMIC_RESULT_0_STRIDE_0, SEISMIC_DIM_NB == 1,
        SEISMIC_PTR(SEISMIC_BUFFER_BIAS), BIAS_KIND, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL),
        SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_GATE),
        SEISMIC_GATE_STRIDE_1, clamped,
        clamped ? element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_MINIMUM)) : 0.0,
        clamped ? element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_MAXIMUM)) : 0.0);
    const projection_weights w = vision_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), PACKETS_W0_ROWS, k);
    vision_gemm(PACKETS_W0, in_, out_, w, uint(SEISMIC_DIM_M), n, k, gl_WorkGroupID.y, gl_WorkGroupID.x);
}
