// Decode expansion (M <= VERIFY_ROWS): the K selected experts' gate/up projections and
// the shared expert's, each with the SiluMul epilogue, in one launch. The
// Vulkan form of `metal/routed_expand.metal`. Workgroup row y < M * K is
// choice (m, k): a K1 paired GEMV over the feature tile `x` of expert
// routes[m, k]'s gate and up rows. Row y = M * K is the shared expert, whose
// weights feed all M activation rows. Lane groups are whole subgroups. Two
// forms of the choices, which tuning admits between (GATHERED), as
// `routed_gate_up`'s: per choice (`routed_expand_choice*`), or gathered
// (`routed_expand_gather`, then `routed_expand_gathered*`: each chosen
// expert's first choice over the activation rows of every choice of the
// expert). One launch per activation-row bound (`projection_gemv`: one bound
// per pipeline) of the gathered choices and the shared expert.
// A choice's gate and up accumulators carry its expert's `gate_scale` /
// `up_scale` entries where those ports are present (static GS, US); the
// shared expert's scales stay one.
#if SEISMIC_STATIC_GS + SEISMIC_STATIC_US != 0
#define PROJECTION_SCALED
#endif
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_EXPERT_GATE
#define KERNEL_W1 SEISMIC_EXPERT_UP
#define KERNEL_W2 SEISMIC_SHARED_GATE
#define KERNEL_W3 SEISMIC_SHARED_UP
#include "lib/core/activation.glsl"
#include "lib/routed/routed.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "routed_expand requires a bf16 or f16 activation"
#endif
#define ROUTED_ACT ACTIVATION_A
// The rows the experts' and the shared expert's weights take (the
// normalized rows, or NVFP4 operands), each pair's own, formed while its
// GEMV stages them.
#if PACKETS_OPERANDS_NVFP4(SEISMIC_EXPERT_GATE)
#define EXPERT_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define EXPERT_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif
#if PACKETS_OPERANDS_NVFP4(SEISMIC_SHARED_GATE)
#define SHARED_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define SHARED_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif





// The GEMV over the gate and up rows of choice `choice`'s expert for `count`
// activation rows: GEMV row r reads activation row `rows[r]` (0: the
// choice's own row) and publishes at `outputs[r]` (0: the choice's
// product), at activation-row bound `maxm`.
void routed_expand_choices(const uint64_t choice, uint64_t rows, uint64_t outputs, uint count, const uint maxm) {
    const uint rows_per_tile = SEISMIC_SUBGROUPS * SEISMIC_TUNE_ROWS;
    const uint tile = gl_WorkGroupID.x;
    if (uint64_t(tile) * rows_per_tile >= SEISMIC_DIM_F)
        return;
    const uint hidden = uint(SEISMIC_DIM_H);
    uint64_t m, k;
    seismic_split(uint(choice), SEISMIC_DIM_K, m, k);
    const uint64_t expert = uint64_t(element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_ROUTES)
        + (m * SEISMIC_ROUTES_STRIDE_0 + k * SEISMIC_ROUTES_STRIDE_1) * 4ul));
    const uint bytes = ELEMENT_BYTES(ROUTED_ACT);
    const uint64_t own = rows == 0ul ? m * SEISMIC_NORMALIZED_STRIDE_0 * uint64_t(bytes) : 0ul;
    const projection_prologue x = projection_operands(projection_plain(ROUTED_ACT,
        SEISMIC_PTR(SEISMIC_BUFFER_NORMALIZED) + own, SEISMIC_NORMALIZED_STRIDE_0, SEISMIC_NORMALIZED_STRIDE_1, hidden,
        rows), EXPERT_OPERANDS);
    const uint64_t product = outputs == 0ul ? m * SEISMIC_RESULT_0_STRIDE_0 + k * SEISMIC_RESULT_0_STRIDE_1 : 0ul;
    const projection_weights gate = routed_record_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_GATE), expert,
        PACKETS_W0_STACKED_ROWS, hidden);
    const projection_weights up = routed_record_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_UP), expert,
        PACKETS_W1_STACKED_ROWS, hidden);
    const projection_epilogue out_ = projection_scaled(projection_gathered(projection_silu_mul(ROUTED_ACT,
            out_offset(SEISMIC_RESULT_0_OUT, product), 0ul, SEISMIC_RESULT_0_STRIDE_2), outputs),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_GATE_SCALE), SEISMIC_DIM_GS, SEISMIC_GATE_SCALE_STRIDE_0, expert),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_UP_SCALE), SEISMIC_DIM_US, SEISMIC_UP_SCALE_STRIDE_0, expert));
    projection_gemv(PACKETS_W0, PACKETS_W1, true, SEISMIC_TUNE_ROWS, 32u, maxm, false, false,
        PROJECTION_NORM_NONE, x, out_, gate, up, count, uint(SEISMIC_DIM_F), hidden, tile);
}

// The shared expert's GEMV over all M activation rows, at activation-row
// bound `maxm`.
void routed_expand_shared(const uint maxm) {
    const uint rows_per_tile = SEISMIC_SUBGROUPS * SEISMIC_TUNE_ROWS;
    const uint tile = gl_WorkGroupID.x;
    if (uint64_t(tile) * rows_per_tile >= SEISMIC_DIM_S)
        return;
    const uint hidden = uint(SEISMIC_DIM_H);
    const projection_prologue x = projection_operands(projection_plain(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_NORMALIZED),
        SEISMIC_NORMALIZED_STRIDE_0, SEISMIC_NORMALIZED_STRIDE_1, hidden, 0ul), SHARED_OPERANDS);
    const projection_weights gate = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_GATE), PACKETS_W2_ROWS, 0ul, hidden);
    const projection_weights up = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_UP), PACKETS_W3_ROWS, 0ul, hidden);
    const projection_epilogue out_ = projection_silu_mul(ROUTED_ACT, SEISMIC_RESULT_1_OUT,
        SEISMIC_RESULT_1_STRIDE_0, SEISMIC_RESULT_1_STRIDE_1);
    projection_gemv(PACKETS_W2, PACKETS_W3, true, SEISMIC_TUNE_ROWS, 32u, maxm, false, false,
        PROJECTION_NORM_NONE, x, out_, gate, up, uint(SEISMIC_DIM_M), uint(SEISMIC_DIM_S), hidden, tile);
}

// The per-choice form with the shared expert's activation-row bound `maxm`:
// each choice over its own row.
void routed_expand_choice_bounded(const uint maxm) {
    if (uint64_t(gl_WorkGroupID.y) < SEISMIC_DIM_M * SEISMIC_DIM_K)
        routed_expand_choices(gl_WorkGroupID.y, 0ul, 0ul, 1u, 1u);
    else
        routed_expand_shared(maxm);
}

void routed_expand_choice() { routed_expand_choice_bounded(1u); }
void routed_expand_choice2() { routed_expand_choice_bounded(2u); }
void routed_expand_choice4() { routed_expand_choice_bounded(4u); }
void routed_expand_choice8() { routed_expand_choice_bounded(8u); }

void routed_expand_gather() {
    const uint max_n = uint(SEISMIC_DIM_F) > uint(SEISMIC_DIM_S) ? uint(SEISMIC_DIM_F) : uint(SEISMIC_DIM_S);
    const uint per_group = SEISMIC_TUNE_SIMDGROUPS * SEISMIC_TUNE_ROWS;
    const uint x_groups = (max_n + per_group - 1u) / per_group;
    routed_build_worklist(SEISMIC_PTR(SEISMIC_BUFFER_ROUTES), SEISMIC_ROUTES_STRIDE_0, SEISMIC_ROUTES_STRIDE_1,
        uint(SEISMIC_DIM_M), uint(SEISMIC_DIM_K), SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, 0u,
        x_groups, 1u, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_WORKLIST),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_GATHER_GRID));
}

// The gathered form at activation-row bound `maxm`: workgroup `(tile, u)`
// projects unique expert `u < count` across all its choices in one weight pass,
// or the shared expert at `u == count` across all M rows.
void routed_expand_gathered_bounded(const uint maxm) {
    const uint64_t worklist = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_WORKLIST);
    if (gl_WorkGroupID.y >= routed_worklist_count(worklist)) {
        routed_expand_shared(maxm);
        return;
    }
    const uint rows_per_tile = SEISMIC_SUBGROUPS * SEISMIC_TUNE_ROWS;
    const uint tile = gl_WorkGroupID.x;
    if (uint64_t(tile) * rows_per_tile >= SEISMIC_DIM_F)
        return;
    const routed_work_entry entry = routed_worklist_entry(worklist, gl_WorkGroupID.y);
    const uint hidden = uint(SEISMIC_DIM_H);
    const uint64_t expert = uint64_t(entry.expert);
    const projection_prologue x = projection_operands(projection_plain(ROUTED_ACT,
        SEISMIC_PTR(SEISMIC_BUFFER_NORMALIZED), SEISMIC_NORMALIZED_STRIDE_0, SEISMIC_NORMALIZED_STRIDE_1, hidden,
        entry.rows), EXPERT_OPERANDS);
    const projection_weights gate = routed_record_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_GATE), expert,
        PACKETS_W0_STACKED_ROWS, hidden);
    const projection_weights up = routed_record_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_UP), expert,
        PACKETS_W1_STACKED_ROWS, hidden);
    const projection_epilogue out_ = projection_scaled(projection_gathered(projection_silu_mul(ROUTED_ACT,
            SEISMIC_RESULT_0_OUT, 0ul, SEISMIC_RESULT_0_STRIDE_2), entry.outputs),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_GATE_SCALE), SEISMIC_DIM_GS, SEISMIC_GATE_SCALE_STRIDE_0, expert),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_UP_SCALE), SEISMIC_DIM_US, SEISMIC_UP_SCALE_STRIDE_0, expert));
    projection_gemv(PACKETS_W0, PACKETS_W1, true, SEISMIC_TUNE_ROWS, 32u, maxm, false, false,
        PROJECTION_NORM_NONE, x, out_, gate, up, entry.count, uint(SEISMIC_DIM_F), hidden, tile);
}

void routed_expand_gathered2() { routed_expand_gathered_bounded(2u); }
void routed_expand_gathered4() { routed_expand_gathered_bounded(4u); }
void routed_expand_gathered8() { routed_expand_gathered_bounded(8u); }
