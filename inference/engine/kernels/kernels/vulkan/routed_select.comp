// General expert selection for M rows in four launches. The Vulkan form of
// `metal/routed_select.metal`.
//   routed_select_stage (M > 8, one workgroup per row): the row's RMS, the
//     normalized row (norm) published and the router input row (router_norm)
//     into scratch.
//   routed_select_gemv (M <= 8): one subgroup per logit column reads the
//     column's weights once and dots them with every row, forming the router
//     input on the fly from RMS partials shared across the workgroup (in the
//     stage launch's sum order); workgroup 0 publishes the normalized rows.
//   routed_select_gemm (M > 8): 32 rows x 32 columns per workgroup over
//     staged F32 tiles of the router input, each invocation 8 outputs in
//     ascending-K FMAs.
//   routed_select_select (one subgroup per row): scores, biased ranking,
//     single-pass top-K (`lib/routed/select.glsl`), normalization, scales.
// Every logit accumulates over the hidden axis in the same order for every
// expert, so experts with equal router rows tie exactly.
#include "lib/core/activation.glsl"
#include "lib/core/reduce.glsl"
#include <seismic/packets.glsl>

#define SELECT_P (uint(SEISMIC_DIM_E) / 32u)
#include "lib/routed/select.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16) \
    || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F32)
#define SELECT_ACT ELEMENT_ACT
#else
#error "routed activation must be dense"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define SELECT_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define SELECT_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define SELECT_NORM ELEMENT_BF16
#else
#error "routed norm must be dense"
#endif
#if defined(SEISMIC_ROUTER_NORM_REPRESENTATION_F32)
#define SELECT_ROUTER_NORM ELEMENT_F32
#elif defined(SEISMIC_ROUTER_NORM_REPRESENTATION_F16)
#define SELECT_ROUTER_NORM ELEMENT_F16
#elif defined(SEISMIC_ROUTER_NORM_REPRESENTATION_BF16)
#define SELECT_ROUTER_NORM ELEMENT_BF16
#else
#error "routed router norm must be dense"
#endif
#if defined(SEISMIC_ROUTER_REPRESENTATION_F32)
#define SELECT_PACKED 0
#define SELECT_ROUTER ELEMENT_F32
#elif defined(SEISMIC_ROUTER_REPRESENTATION_F16)
#define SELECT_PACKED 0
#define SELECT_ROUTER ELEMENT_F16
#elif defined(SEISMIC_ROUTER_REPRESENTATION_BF16)
#define SELECT_PACKED 0
#define SELECT_ROUTER ELEMENT_BF16
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q4K)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q4K
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_Q4K(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q5K)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q5K
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_HIGH(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q6K)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q6K
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_HIGH(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q8G32S)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q8
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_Q8(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_IQ4G32)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_IQ4
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_C4(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q4G32S)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q4G32S
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_C4(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_MXFP4G32)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_MXFP4
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_C4(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_NVFP4G16)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_NVFP4
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_C4(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q5G32S)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q5G32S
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_Q5(SEISMIC_ROUTER)
#elif defined(SEISMIC_ROUTER_REPRESENTATION_Q5G32)
#define SELECT_PACKED 1
#define SELECT_ROUTER_KIND PACKETS_Q5G32
#define SELECT_ROUTER_LAYOUT PACKETS_ROWS16_Q5(SEISMIC_ROUTER)
#else
#error "unsupported routed router representation"
#endif
#if SELECT_PACKED && !defined(SEISMIC_ROUTER_LAYOUT_ROWS16)
#error "packed routed router requires rows16"
#endif

#define SELECT_THREADS 256u
#define SELECT_SUBGROUPS 8u
#define SELECT_E uint(SEISMIC_DIM_E)
#define SELECT_K uint(SEISMIC_DIM_K)

float select_residual(uint64_t row, uint source) {
    return element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL)
        + (row * SEISMIC_RESIDUAL_STRIDE_0 + uint64_t(source) * SEISMIC_RESIDUAL_STRIDE_1) * 4ul);
}

float select_norm(uint source) {
    return element_at(SELECT_NORM, SEISMIC_PTR(SEISMIC_BUFFER_NORM), uint64_t(source) * SEISMIC_NORM_STRIDE_0);
}

float select_router_norm(uint source) {
    return element_at(SELECT_ROUTER_NORM, SEISMIC_PTR(SEISMIC_BUFFER_ROUTER_NORM),
        uint64_t(source) * SEISMIC_ROUTER_NORM_STRIDE_0);
}

void select_publish(uint64_t row, uint source, float value) {
    element_put(SELECT_ACT, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        row * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(source) * SEISMIC_RESULT_0_STRIDE_1, value);
}

// The router logits scratch is [M, E].
uint64_t select_logit(uint64_t row, uint expert) {
    return SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS) + (row * SELECT_E + expert) * 4ul;
}

// The router input rows scratch is [M, H] in A.
uint64_t select_router_rows() {
    return SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_ROUTER_ROWS);
}

#if !SELECT_PACKED
float select_column_weight(uint expert, uint source) {
    return element_at(SELECT_ROUTER, SEISMIC_PTR(SEISMIC_BUFFER_ROUTER),
        uint64_t(expert) * SEISMIC_ROUTER_STRIDE_0 + uint64_t(source) * SEISMIC_ROUTER_STRIDE_1);
}
#endif

// Shared: one partial per subgroup.
void routed_select_stage() {
    const uint64_t row = gl_WorkGroupID.x;
    const uint thread = gl_LocalInvocationIndex;
    const uint hidden = uint(SEISMIC_DIM_H);
    const float eps = element_word_f32(SEISMIC_PARAM_EPSILON);
    float squares = 0.0;
    for (uint source = thread; source < hidden; source += SELECT_THREADS) {
        const float value = select_residual(row, source);
        squares = seismic_fma_rn(value, value, squares);
    }
    const float inverse = inversesqrt(seismic_div_rn(reduce_group_sum(squares, 0u), float(hidden)) + eps);
    for (uint source = thread; source < hidden; source += SELECT_THREADS) {
        const float scaled = select_residual(row, source) * inverse;
        select_publish(row, source, element_round(SELECT_ACT, scaled * select_norm(source)));
        element_put(SELECT_ACT, select_router_rows(), row * uint64_t(hidden) + source,
            element_round(SELECT_ACT, scaled * select_router_norm(source)));
    }
}

// M <= 8, one launch before the selection. Shared floats: parts [8][8], then
// the rows' inverses [8].
void routed_select_gemv() {
    const uint rows = uint(SEISMIC_DIM_M), hidden = uint(SEISMIC_DIM_H);
    const uint sg = SEISMIC_SUBGROUP, lane = SEISMIC_LANE, thread = gl_LocalInvocationIndex;
    const float eps = element_word_f32(SEISMIC_PARAM_EPSILON);
    const uint inverses = 64u;
    for (uint item = sg; item < rows * SELECT_SUBGROUPS; item += SEISMIC_SUBGROUPS) {
        const uint row = item / SELECT_SUBGROUPS, part = item % SELECT_SUBGROUPS;
        float squares = 0.0;
        for (uint source = part * 32u + lane; source < hidden; source += SELECT_THREADS) {
            const float value = select_residual(row, source);
            squares = seismic_fma_rn(value, value, squares);
        }
        squares = seismic_subgroup_sum_f32(squares);
        if (lane == 0u)
            seismic_shared_f32[row * SELECT_SUBGROUPS + part] = squares;
    }
    barrier();
    if (thread < rows) {
        float total = 0.0;
        for (uint part = 0u; part < SELECT_SUBGROUPS; ++part)
            total += seismic_shared_f32[thread * SELECT_SUBGROUPS + part];
        seismic_shared_f32[inverses + thread] = inversesqrt(seismic_div_rn(total, float(hidden)) + eps);
    }
    barrier();
    if (gl_WorkGroupID.x == 0u) {
        for (uint item = thread; item < rows * hidden; item += gl_WorkGroupSize.x) {
            const uint row = item / hidden, source = item % hidden;
            select_publish(row, source,
                element_round(SELECT_ACT, select_residual(row, source) * seismic_shared_f32[inverses + row] * select_norm(source)));
        }
    }
    const uint expert = gl_WorkGroupID.x * SEISMIC_SUBGROUPS + sg;
    if (expert >= SELECT_E)
        return;
    float sums[8];
    [[unroll]] for (uint row = 0u; row < 8u; ++row)
        sums[row] = 0.0;
#if SELECT_PACKED
    const packets_rows16 router_layout = SELECT_ROUTER_LAYOUT;
    const uint64_t router = SEISMIC_PTR(SEISMIC_BUFFER_ROUTER);
    for (uint p = lane; p < hidden / 32u; p += 32u) {
        const packets_packet packet = packets_load(SELECT_ROUTER_KIND,
            router + uint64_t(expert) * router_layout.stride, router_layout, p, hidden);
        [[unroll]] for (uint step = 0u; step < 4u; ++step) {
            vec4 even, odd;
            packets_codes(SELECT_ROUTER_KIND, packet, step, even, odd);
            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                const uint source = 32u * p + 8u * step + i;
                const float code = (i & 1u) != 0u ? odd[i >> 1] : even[i >> 1];
                const float weight = packets_value(SELECT_ROUTER_KIND, packet, step, code);
                const float scale = select_router_norm(source);
                [[unroll]] for (uint row = 0u; row < 8u; ++row)
                    if (row < rows)
                        sums[row] = seismic_fma_rn(element_round(SELECT_ACT,
                            select_residual(row, source) * seismic_shared_f32[inverses + row] * scale),
                            weight, sums[row]);
            }
        }
    }
#else
    for (uint base = 4u * lane; base < hidden; base += 128u) {
        float weight[4], scale[4];
        [[unroll]] for (uint j = 0u; j < 4u; ++j) {
            weight[j] = select_column_weight(expert, base + j);
            scale[j] = select_router_norm(base + j);
        }
        [[unroll]] for (uint row = 0u; row < 8u; ++row) {
            if (row < rows) {
                const float inverse = seismic_shared_f32[inverses + row];
                [[unroll]] for (uint j = 0u; j < 4u; ++j)
                    sums[row] = seismic_fma_rn(element_round(SELECT_ACT, select_residual(row, base + j) * inverse * scale[j]),
                        weight[j], sums[row]);
            }
        }
    }
#endif
    [[unroll]] for (uint row = 0u; row < 8u; ++row) {
        if (row < rows) {
            const float sum = seismic_subgroup_sum_f32(sums[row]);
            if (lane == 0u)
                element_f32_put(select_logit(row, expert), sum);
        }
    }
}

// M > 8: 32 rows x 32 logit columns per workgroup of 128 invocations; each
// invocation owns row t / 4 and columns 8 (t % 4) .., accumulated in
// ascending hidden order. Shared floats: the row tile [32][36], then the
// column tile [32][36] (k-major).
#define SELECT_TILE 32u
#define SELECT_PITCH 36u

void routed_select_gemm() {
    const uint thread = gl_LocalInvocationIndex;
    const uint hidden = uint(SEISMIC_DIM_H);
    const uint expert0 = gl_WorkGroupID.x * SELECT_TILE;
    const uint64_t row0 = uint64_t(gl_WorkGroupID.y) * SELECT_TILE;
    const uint columns_tile = SELECT_TILE * SELECT_PITCH;
    const uint r = thread / 4u, e0 = 8u * (thread % 4u);
    float acc[8];
    [[unroll]] for (uint j = 0u; j < 8u; ++j)
        acc[j] = 0.0;
    for (uint k0 = 0u; k0 < hidden; k0 += SELECT_TILE) {
        barrier();
        for (uint item = thread; item < SELECT_TILE * SELECT_TILE; item += gl_WorkGroupSize.x) {
            const uint i = item / SELECT_TILE, k = item % SELECT_TILE;
            const uint64_t row = row0 + i;
            seismic_shared_f32[i * SELECT_PITCH + k] = row < SEISMIC_DIM_M
                ? element_at(SELECT_ACT, select_router_rows(), row * uint64_t(hidden) + uint64_t(k0 + k))
                : 0.0;
#if !SELECT_PACKED
            const uint expert = expert0 + i;
            seismic_shared_f32[columns_tile + k * SELECT_PITCH + i] = expert < SELECT_E ? select_column_weight(expert, k0 + k) : 0.0;
#endif
        }
#if SELECT_PACKED
        if (thread < SELECT_TILE) {
            const uint expert = expert0 + thread;
            if (expert < SELECT_E) {
                const packets_rows16 router_layout = SELECT_ROUTER_LAYOUT;
                const uint64_t row = SEISMIC_PTR(SEISMIC_BUFFER_ROUTER) + uint64_t(expert) * router_layout.stride;
                const packets_packet packet = packets_load(SELECT_ROUTER_KIND, row, router_layout, k0 / 32u, hidden);
                [[unroll]] for (uint step = 0u; step < 4u; ++step) {
                    vec4 even, odd;
                    packets_codes(SELECT_ROUTER_KIND, packet, step, even, odd);
                    [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                        const float code = (i & 1u) != 0u ? odd[i >> 1] : even[i >> 1];
                        seismic_shared_f32[columns_tile + (8u * step + i) * SELECT_PITCH + thread] =
                            packets_value(SELECT_ROUTER_KIND, packet, step, code);
                    }
                }
            } else {
                for (uint k = 0u; k < SELECT_TILE; ++k)
                    seismic_shared_f32[columns_tile + k * SELECT_PITCH + thread] = 0.0;
            }
        }
#endif
        barrier();
        for (uint k = 0u; k < SELECT_TILE; ++k) {
            const float a = seismic_shared_f32[r * SELECT_PITCH + k];
            [[unroll]] for (uint j = 0u; j < 8u; ++j)
                acc[j] = seismic_fma_rn(a, seismic_shared_f32[columns_tile + k * SELECT_PITCH + e0 + j], acc[j]);
        }
    }
    const uint64_t row = row0 + r;
    [[unroll]] for (uint j = 0u; j < 8u; ++j)
        if (row < SEISMIC_DIM_M && expert0 + e0 + j < SELECT_E)
            element_f32_put(select_logit(row, expert0 + e0 + j), acc[j]);
}

void routed_select_select() {
    const uint lane = SEISMIC_LANE;
    const uint64_t row = uint64_t(gl_WorkGroupID.x) * SEISMIC_SUBGROUPS + SEISMIC_SUBGROUP;
    if (row >= SEISMIC_DIM_M)
        return;
    float score[SELECT_P], ranked[SELECT_P];
    int expert[SELECT_P];
    [[unroll]] for (uint i = 0u; i < SELECT_P; ++i) {
        expert[i] = int(lane + 32u * i);
        score[i] = element_f32_at(select_logit(row, lane + 32u * i));
    }
    select_scores(int(SEISMIC_PARAM_SCORE), score);
    [[unroll]] for (uint i = 0u; i < SELECT_P; ++i)
        ranked[i] = score[i] + element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_BIAS)
            + uint64_t(expert[i]) * SEISMIC_BIAS_STRIDE_0 * 4ul);
    select_sort(ranked, score, expert);

    float chosen[SELECT_K];
    int winners[SELECT_K];
    for (uint rank = 0u; rank < SELECT_K; ++rank) {
        float best;
        const int winner = reduce_argmax(ranked[0], expert[0], REDUCE_HIGHER_INDEX, best);
        // The winner's unbiased score, from its lane.
        const float winner_score = seismic_shuffle(score[0], uint(winner) % 32u);
        if (expert[0] == winner)
            select_pop(ranked, score, expert);
        chosen[SELECT_K - 1u - rank] = winner_score;
        winners[SELECT_K - 1u - rank] = winner;
    }
    // The slot-order sum: slot s holds rank K - 1 - s.
    float denominator = 0.0;
    for (uint slot = 0u; slot < SELECT_K; ++slot)
        denominator += chosen[slot];
    if (lane == 0u) {
        const int normalization = int(SEISMIC_PARAM_NORMALIZATION);
        const float scale = element_word_f32(SEISMIC_PARAM_SCALE);
        const float epsilon = element_word_f32(SEISMIC_PARAM_NORMALIZATION_EPSILON);
        for (uint slot = 0u; slot < SELECT_K; ++slot) {
            const float weight = select_normalized(normalization, chosen[slot], denominator, epsilon);
            element_i32_put(SEISMIC_PTR(SEISMIC_BUFFER_ROUTES)
                + (row * SEISMIC_ROUTES_STRIDE_0 + uint64_t(slot) * SEISMIC_ROUTES_STRIDE_1) * 4ul, winners[slot]);
            element_f32_put(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHTS)
                    + (row * SEISMIC_WEIGHTS_STRIDE_0 + uint64_t(slot) * SEISMIC_WEIGHTS_STRIDE_1) * 4ul,
                weight * scale * element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_SCALE)
                    + uint64_t(winners[slot]) * SEISMIC_EXPERT_SCALE_STRIDE_0 * 4ul));
        }
    }
}
