// General expert selection (`routed_select`) on the `dense` projection
// operator, single over `router` in the CPU 8-lane reference order; `norm` and
// `router_norm` share the row's RMS inverse.
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_ROUTER
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"
#include "lib/projection/projection.glsl"
#define SELECT_E uint(SEISMIC_DIM_E)
#include "lib/routed/selection.glsl"

#define SELECT_NORM ELEMENT_OF(SEISMIC_NORM)
#define SELECT_ROUTER_NORM ELEMENT_OF(SEISMIC_ROUTER_NORM)

#define SELECT_H uint(SEISMIC_DIM_H)

projection_prologue projected_input(uint g) {
    return projection_ordered_rms(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL),
        SEISMIC_RESIDUAL_STRIDE_0, SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_ROUTER_NORM),
        SEISMIC_ROUTER_NORM_STRIDE_0, SELECT_ROUTER_NORM, element_word_f32(SEISMIC_PARAM_EPSILON), SELECT_H, 0ul);
}

projection_prologue select_norm_input() {
    return projection_ordered_rms(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL),
        SEISMIC_RESIDUAL_STRIDE_0, SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM),
        SEISMIC_NORM_STRIDE_0, SELECT_NORM, element_word_f32(SEISMIC_PARAM_EPSILON), SELECT_H, 0ul);
}

projection_prologue projected_rows(uint g) {
    return projection_plain(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED),
        SELECT_H, 1ul, SELECT_H, 0ul);
}

projection_weights projected_weight(uint g) {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_ROUTER), PACKETS_W0_ROWS, SELECT_H, 0ul, 1ul, 0u);
}

projection_epilogue projected_output(uint g) {
    return projection_store(out_over_scratch(ELEMENT_F32, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS)),
        SEISMIC_DIM_E, 1ul, 0ul);
}

vec4 select_load_norm4(const int kind, uint64_t base, uint col) {
    if (kind == ELEMENT_F32)
        return element_vec4_at(base + uint64_t(col) * 4ul);
    const uvec2 w = element_uvec2_at(base + uint64_t(col) * 2ul);
    return vec4(element_unpack2(kind, w.x), element_unpack2(kind, w.y));
}

bool select_norm4_aligned(const int kind, uint64_t base) {
    return kind == ELEMENT_F32 ? (base & 15ul) == 0ul : (base & 7ul) == 0ul;
}

void select_publish_decode_rows() {
    const projection_prologue norm_in = select_norm_input();
    const uint m = uint(SEISMIC_DIM_M);
    const uint h = SELECT_H;
    const uint h4 = h & ~3u;
    const bool vec_fast = norm_in.x1 == 1ul
        && ((norm_in.x0 & 3ul) == 0ul || m == 1u)
        && stored_aligned16(norm_in.x)
        && norm_in.norm_stride == 1ul
        && select_norm4_aligned(norm_in.norm_kind, norm_in.norm)
        && SEISMIC_RESULT_0_STRIDE_1 == 1ul;
    if (vec_fast) {
        const uint vecs = h >> 2u;
        for (uint idx = SEISMIC_THREAD; idx < m * vecs; idx += PROJECTION_THREADS) {
            const uint r = m == 1u ? 0u : (idx / vecs);
            const uint c = (m == 1u ? idx : (idx - r * vecs)) << 2u;
            const vec4 x = stored_vec4_at(norm_in.x, uint64_t(r) * norm_in.x0 + uint64_t(c));
            const vec4 nw = select_load_norm4(norm_in.norm_kind, norm_in.norm, c);
            const vec4 y = (x * seismic_shared_f32[r]) * nw;
            const uint64_t dst = uint64_t(r) * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(c);
            out_put2(SEISMIC_RESULT_0_OUT, dst, y.x, y.y);
            out_put2(SEISMIC_RESULT_0_OUT, dst + 2ul, y.z, y.w);
        }
        const uint tail = h - h4;
        if (tail != 0u) {
            for (uint idx = SEISMIC_THREAD; idx < m * tail; idx += PROJECTION_THREADS) {
                const uint r = m == 1u ? 0u : (idx / tail);
                const uint c = h4 + (m == 1u ? idx : (idx - r * tail));
                out_put(SEISMIC_RESULT_0_OUT,
                    uint64_t(r) * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(c),
                    projection_ordered_at(norm_in, r, c, seismic_shared_f32[r]));
            }
        }
    } else {
        for (uint idx = SEISMIC_THREAD; idx < m * h; idx += PROJECTION_THREADS) {
            const uint r = m == 1u ? 0u : (idx / h);
            const uint c = m == 1u ? idx : (idx - r * h);
            out_put(SEISMIC_RESULT_0_OUT,
                uint64_t(r) * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(c) * SEISMIC_RESULT_0_STRIDE_1,
                projection_ordered_at(norm_in, r, c, seismic_shared_f32[r]));
        }
    }
}

#define PROJECTION_SINGLE
#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_N SELECT_E
#define PROJECTION_K SELECT_H
#define PROJECTION_NORM PROJECTION_NORM_SHARED
#define PROJECTION_ORDERED_FIRST_TILE() select_publish_decode_rows();
#include "lib/projection/ordered.glsl"

void routed_select_ordered_stage() {
    const uint row = gl_WorkGroupID.x;
    const projection_prologue router_in = projected_input(0u);
    const projection_prologue norm_in = select_norm_input();
    projection_ordered_inverses(router_in, 1u, 0u, 1u, row, true, 4u);
    const float inv = seismic_shared_f32[0];
    const Out staged = out_over_scratch(ACTIVATION_A, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED));
    const uint h = SELECT_H;
    const uint h4 = h & ~3u;
    const uint64_t res_row = uint64_t(row) * router_in.x0;
    const uint64_t staged_row = uint64_t(row) * uint64_t(h);
    const uint64_t norm_row = uint64_t(row) * SEISMIC_RESULT_0_STRIDE_0;
    const bool vec_fast = router_in.x1 == 1ul
        && (res_row & 3ul) == 0ul
        && stored_aligned16(router_in.x)
        && router_in.norm_stride == 1ul
        && select_norm4_aligned(router_in.norm_kind, router_in.norm)
        && norm_in.norm_stride == 1ul
        && select_norm4_aligned(norm_in.norm_kind, norm_in.norm)
        && SEISMIC_RESULT_0_STRIDE_1 == 1ul;
    if (vec_fast) {
        for (uint c = SEISMIC_THREAD << 2u; c < h4; c += PROJECTION_THREADS << 2u) {
            const vec4 scaled = stored_vec4_at(router_in.x, res_row + uint64_t(c)) * inv;
            const vec4 ry = scaled * select_load_norm4(router_in.norm_kind, router_in.norm, c);
            const vec4 ny = scaled * select_load_norm4(norm_in.norm_kind, norm_in.norm, c);
            const uint64_t s_dst = staged_row + uint64_t(c);
            out_put2(staged, s_dst, ry.x, ry.y);
            out_put2(staged, s_dst + 2ul, ry.z, ry.w);
            const uint64_t n_dst = norm_row + uint64_t(c);
            out_put2(SEISMIC_RESULT_0_OUT, n_dst, ny.x, ny.y);
            out_put2(SEISMIC_RESULT_0_OUT, n_dst + 2ul, ny.z, ny.w);
        }
        for (uint c = h4 + SEISMIC_THREAD; c < h; c += PROJECTION_THREADS) {
            const float scaled = stored_at(router_in.x, res_row + uint64_t(c)) * inv;
            const float rnw = element_at(router_in.norm_kind, router_in.norm, uint64_t(c));
            const float nnw = element_at(norm_in.norm_kind, norm_in.norm, uint64_t(c));
            out_put(staged, staged_row + uint64_t(c), scaled * rnw);
            out_put(SEISMIC_RESULT_0_OUT, norm_row + uint64_t(c), scaled * nnw);
        }
    } else {
        for (uint c = SEISMIC_THREAD; c < h; c += PROJECTION_THREADS) {
            const float scaled = stored_at(router_in.x, res_row + uint64_t(c) * router_in.x1) * inv;
            const float rnw = element_at(router_in.norm_kind, router_in.norm, uint64_t(c) * router_in.norm_stride);
            const float nnw = element_at(norm_in.norm_kind, norm_in.norm, uint64_t(c) * norm_in.norm_stride);
            out_put(staged, staged_row + uint64_t(c), scaled * rnw);
            out_put(SEISMIC_RESULT_0_OUT, norm_row + uint64_t(c) * SEISMIC_RESULT_0_STRIDE_1, scaled * nnw);
        }
    }
}

void routed_select_ordered_gemv() { projection_single_ordered_gemv(); }
void routed_select_ordered_gemm() { projection_single_ordered_gemm(); }

void routed_select_select() {
    // A hardware subgroup without a row leaves; a logical subgroup past the
    // rows on a 64-lane one ranks the last row again and stores nothing.
    const uint64_t placed = uint64_t(gl_WorkGroupID.x) * SEISMIC_SUBGROUPS + uint64_t(SEISMIC_SUBGROUP);
    bool live;
    if (!seismic_steer(live, placed < SEISMIC_DIM_M))
        return;
    select_select_row(SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_LOGITS), live ? placed : SEISMIC_DIM_M - 1ul, live);
}
