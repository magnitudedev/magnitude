// project_rows: the plain projection of the A rows `source`, published in Y.
// The Vulkan form of `metal/project_rows.metal` over
// `lib/projection/projection.glsl`; the GEMM class may split K. A grouped
// weight (G > 1) runs group g at grid z (z = g in the GEMV and finalize
// launches, z = g * SPLIT + part in the GEMM) over its K source columns, its
// N weight rows and output columns, and its own G-th of the split partials.
#define KERNEL_W0 SEISMIC_WEIGHT
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_WS != 0
#define PROJECTION_SCALED
#endif
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define PROJECT_ACT ELEMENT_ACT
#else
#error "project_rows requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_ELEMENT_Y_REPRESENTATION_F32)
#define PROJECT_PUBLISHED ELEMENT_F32
#elif defined(SEISMIC_ELEMENT_Y_REPRESENTATION_BF16)
#define PROJECT_PUBLISHED ELEMENT_BF16
#elif defined(SEISMIC_ELEMENT_Y_REPRESENTATION_F16)
#define PROJECT_PUBLISHED ELEMENT_F16
#else
#error "project_rows requires a dense published element"
#endif
// The weight's operand rows (the source rows, or NVFP4 operands): the GEMV
// forms them while staging, the stage launch into the scratch the GEMM reads.
#if defined(SEISMIC_WEIGHT_OPERANDS_NVFP4)
#define PROJECT_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define PROJECT_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif


// The group a launch's grid z names: literally 0 at G = 1 (G is static), so
// every ungrouped address and split part compiles to its ungrouped form.
#define PROJECT_ROWS_GROUP(z) (SEISMIC_DIM_G == 1 ? 0u : uint(z))

// Group `g`'s source rows: its K columns of each row.
projection_prologue project_rows_source(uint g) {
    return projection_plain(PROJECT_ACT,
        SEISMIC_PTR(SEISMIC_BUFFER_SOURCE)
            + uint64_t(g) * SEISMIC_DIM_K * SEISMIC_SOURCE_STRIDE_1 * uint64_t(ELEMENT_BYTES(PROJECT_ACT)),
        SEISMIC_SOURCE_STRIDE_0, SEISMIC_SOURCE_STRIDE_1, uint(SEISMIC_DIM_K), 0ul);
}

// Group `g`'s source rows as the weight's operands.
projection_prologue project_rows_input(uint g) { return projection_operands(project_rows_source(g), PROJECT_OPERANDS); }

// The rows the GEMM reads: the source rows, or the operands the stage launch
// formed (one group).
projection_prologue project_rows_rows(uint g) {
#if defined(SEISMIC_WEIGHT_OPERANDS_NVFP4)
    return projection_plain(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED), SEISMIC_DIM_K, 1ul,
        uint(SEISMIC_DIM_K), 0ul);
#else
    return project_rows_source(g);
#endif
}

// Group `g`'s output columns.
projection_epilogue project_rows_output(uint g) {
    return projection_scaled(projection_store(PROJECT_PUBLISHED, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, uint64_t(g) * SEISMIC_DIM_N),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT_SCALE), SEISMIC_DIM_WS, 0ul, 0ul), 1.0);
}

// Group `g`'s N weight rows.
projection_weights project_rows_weight(uint g) {
    projection_weights w =
        projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), PACKETS_W0_ROWS, uint(SEISMIC_DIM_K), 0ul, 1ul, 0u);
    w.base += uint64_t(g) * SEISMIC_DIM_N * w.geometry.stride;
    return w;
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void project_rows_gemv_bounded(const uint maxm) {
    const uint g = PROJECT_ROWS_GROUP(gl_WorkGroupID.z);
    const projection_weights w = project_rows_weight(g);
    projection_gemv(PACKETS_W0, PACKETS_W0, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_NONE,
        project_rows_input(g), project_rows_output(g), w, w, uint(SEISMIC_DIM_M), uint(SEISMIC_DIM_N),
        uint(SEISMIC_DIM_K), gl_WorkGroupID.x);
}

void project_rows_gemv1() { project_rows_gemv_bounded(1u); }
void project_rows_gemv2() { project_rows_gemv_bounded(2u); }
void project_rows_gemv4() { project_rows_gemv_bounded(4u); }
void project_rows_gemv8() { project_rows_gemv_bounded(8u); }

// The source rows as NVFP4 operands into `staged`, one row a workgroup (one
// group).
void project_rows_stage() {
    projection_stage(project_rows_input(0u), gl_WorkGroupID.x, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED),
        uint(SEISMIC_DIM_K));
}

// Group `g`'s G-th of the split partials.
uint64_t project_rows_partials(uint g) {
    return SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS)
        + uint64_t(g) * SEISMIC_TUNE_SPLIT * SEISMIC_DIM_M * SEISMIC_DIM_N * 4ul;
}

void project_rows_gemm() {
    const uint m = uint(SEISMIC_DIM_M), n = uint(SEISMIC_DIM_N);
    const uint g = PROJECT_ROWS_GROUP(gl_WorkGroupID.z / SEISMIC_TUNE_SPLIT);
#if SEISMIC_TUNE_SPLIT == 1
    projection_gemm(PACKETS_W0, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N,
        project_rows_rows(g), project_rows_output(g), project_rows_weight(g), m, n, uint(SEISMIC_DIM_K),
        gl_WorkGroupID.y, gl_WorkGroupID.x, 0xffffffffu);
#else
    projection_gemm_part(PACKETS_W0, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N,
        project_rows_rows(g), project_rows_partials(g), project_rows_weight(g), m, n, uint(SEISMIC_DIM_K),
        SEISMIC_TUNE_SPLIT, gl_WorkGroupID.z % SEISMIC_TUNE_SPLIT, gl_WorkGroupID.y, gl_WorkGroupID.x);
#endif
}

void project_rows_finalize() {
    const uint g = PROJECT_ROWS_GROUP(gl_WorkGroupID.z);
    projection_gemm_finalize(project_rows_output(g), project_rows_partials(g), uint(SEISMIC_DIM_M),
        uint(SEISMIC_DIM_N), SEISMIC_TUNE_SPLIT, gl_GlobalInvocationID.x);
}
