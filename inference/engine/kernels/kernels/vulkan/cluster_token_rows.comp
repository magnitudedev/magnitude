#include <seismic/element.glsl>
void cluster_token_rows() {
    const uint64_t selected = SEISMIC_PTR(SEISMIC_BUFFER_SELECTED), ordering = SEISMIC_PTR(SEISMIC_BUFFER_TOKEN_ORDER), rows = SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER);
    for (seismic_walk at = seismic_walk_grid(SEISMIC_DIM_M * SEISMIC_DIM_K * SEISMIC_DIM_B, u64vec3(1ul, SEISMIC_DIM_K, SEISMIC_DIM_B));
            at.index < SEISMIC_DIM_M * SEISMIC_DIM_K * SEISMIC_DIM_B; seismic_walk_next(at)) {
        const uint64_t row = at.axes.x, pick = at.axes.z, within = at.axes.w;
        const uint64_t col = pick * SEISMIC_DIM_B + within;
        const int cluster = element_i32_at(selected + (row * SEISMIC_SELECTED_STRIDE_0 + pick * SEISMIC_SELECTED_STRIDE_1) * 4ul);
        const int token = cluster >= 0 && uint64_t(cluster) < SEISMIC_DIM_C ? element_i32_at(ordering + (uint64_t(cluster) * SEISMIC_TOKEN_ORDER_STRIDE_0 + within * SEISMIC_TOKEN_ORDER_STRIDE_1) * 4ul) : -1;
        element_i32_put(rows + (row * SEISMIC_RESULT_0_STRIDE_0 + col * SEISMIC_RESULT_0_STRIDE_1) * 4ul, token);
    }
}
