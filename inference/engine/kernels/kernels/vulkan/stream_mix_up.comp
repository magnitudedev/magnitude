// stream_mix_up: the low-rank rows through `up`, each output column the gate
// of its stream's column, publishing the per-stream partials (`Mix`). The
// Vulkan form of `metal/stream_mix_up.metal` on the `dense` projection
// (`lib/projection/operator.glsl`).
#define KERNEL_W0 SEISMIC_UP_WEIGHT
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_STAGED_TABLES 1
#include "lib/core/activation.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define MIX_ACT ELEMENT_ACT
#else
#error "stream_mix_up requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define MIX_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define MIX_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define MIX_NORM ELEMENT_BF16
#else
#error "stream_mix_up requires a dense norm"
#endif


#include "lib/projection/projection.glsl"

#define PROJECTION_SINGLE
#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_N uint(SEISMIC_DIM_S * SEISMIC_DIM_H)
#define PROJECTION_K uint(SEISMIC_DIM_LR)
#define PROJECTION_G 1
#define PROJECTION_NORM PROJECTION_NORM_NONE
#define PROJECTION_STAGED SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED)
#define PROJECTION_SPLIT SEISMIC_TUNE_SPLIT
#define PROJECTION_PARTIALS SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS)

// The low-rank rows, read in place (the up weight takes no NVFP4 operands).
projection_prologue projected_input(uint g) {
    return projection_plain(MIX_ACT, SEISMIC_PTR(SEISMIC_BUFFER_LOW), SEISMIC_LOW_STRIDE_0, SEISMIC_LOW_STRIDE_1,
        PROJECTION_K, 0ul);
}

projection_prologue projected_rows(uint g) { return projected_input(g); }

projection_epilogue projected_output(uint g) {
    return projection_mix(SEISMIC_RESULT_0_OUT, SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN), SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_2,
        SEISMIC_PTR(SEISMIC_BUFFER_INVERSE), SEISMIC_INVERSE_STRIDE_0, SEISMIC_PTR(SEISMIC_BUFFER_NORM), MIX_NORM,
        uint(SEISMIC_DIM_S), uint(SEISMIC_DIM_H));
}

projection_weights projected_weight(uint g) {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_UP_WEIGHT), PACKETS_W0_ROWS, PROJECTION_K, 0ul, 1ul, 0u);
}

#include "lib/projection/operator.glsl"

// The `dense` projection's launches (`lib/projection/operator.glsl`).
void stream_mix_up_stage() { projection_dense_stage(); }
void stream_mix_up_gemv1() { projection_single_gemv(1u); }
void stream_mix_up_gemv2() { projection_single_gemv(2u); }
void stream_mix_up_gemv4() { projection_single_gemv(4u); }
void stream_mix_up_gemv8() { projection_single_gemv(8u); }
void stream_mix_up_gemm() { projection_single_gemm(); }
void stream_mix_up_finalize() { projection_single_finalize(); }
