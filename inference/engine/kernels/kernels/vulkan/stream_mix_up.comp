// stream_mix_up: the low-rank rows through `up`, each output column the gate
// of its stream's column, publishing the per-stream partials (`Mix`). The
// Vulkan form of `metal/stream_mix_up.metal` over
// `lib/projection/projection.glsl`.
#define KERNEL_W0 SEISMIC_UP_WEIGHT
#include "lib/core/activation.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define MIX_ACT ELEMENT_ACT
#else
#error "stream_mix_up requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define MIX_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define MIX_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define MIX_NORM ELEMENT_BF16
#else
#error "stream_mix_up requires a dense norm"
#endif


#include "lib/projection/projection.glsl"

#define MIX_K uint(SEISMIC_DIM_LR)
#define MIX_N uint(SEISMIC_DIM_S * SEISMIC_DIM_H)

projection_prologue stream_mix_up_input() {
    return projection_plain(MIX_ACT, SEISMIC_PTR(SEISMIC_BUFFER_LOW), SEISMIC_LOW_STRIDE_0, SEISMIC_LOW_STRIDE_1,
        MIX_K, 0ul);
}

projection_weights stream_mix_up_weight() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_UP_WEIGHT), PACKETS_W0_ROWS, MIX_K, 0ul, 1ul);
}

projection_epilogue stream_mix_up_out() {
    return projection_mix(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1,
        SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN), SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_2,
        SEISMIC_PTR(SEISMIC_BUFFER_INVERSE), SEISMIC_INVERSE_STRIDE_0, SEISMIC_PTR(SEISMIC_BUFFER_NORM), MIX_NORM,
        uint(SEISMIC_DIM_S), uint(SEISMIC_DIM_H));
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void stream_mix_up_gemv_bounded(const uint maxm) {
    const projection_weights w = stream_mix_up_weight();
    projection_gemv(PACKETS_W0, PACKETS_W0, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_NONE,
        stream_mix_up_input(), stream_mix_up_out(), w, w, uint(SEISMIC_DIM_M), MIX_N, MIX_K, gl_WorkGroupID.x);
}

void stream_mix_up_gemv1() { stream_mix_up_gemv_bounded(1u); }
void stream_mix_up_gemv2() { stream_mix_up_gemv_bounded(2u); }
void stream_mix_up_gemv4() { stream_mix_up_gemv_bounded(4u); }
void stream_mix_up_gemv8() { stream_mix_up_gemv_bounded(8u); }

void stream_mix_up_gemm() {
    projection_gemm(PACKETS_W0, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N,
        stream_mix_up_input(), stream_mix_up_out(), stream_mix_up_weight(), uint(SEISMIC_DIM_M), MIX_N, MIX_K,
        gl_WorkGroupID.y, gl_WorkGroupID.x, 0xffffffffu);
}
