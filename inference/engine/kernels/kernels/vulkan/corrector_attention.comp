// corrector_attention: one workgroup of 256 invocations per (node, head).
// Each logical subgroup caches its lanes' biased query columns in registers
// and scores keys subgroup, subgroup + SEISMIC_SUBGROUPS, ... against the
// biased key, scaled by 1/sqrt(W) plus the head's additive bias, kept in
// shared memory. The workgroup reduces the scores' maximum and softmax
// denominator in parallel, writing the weights back to shared memory, then
// each invocation owns columns of the head, accumulates the weighted biased
// values in key order, multiplies by the inverse total and publishes the head
// rounded once to A. Mirrors `cpu/corrector_attention.rs`.
#define KERNEL_A SEISMIC_ELEMENT_A
#include "lib/core/activation.glsl"
#include "lib/core/reduce.glsl"

// Shared: one partial per subgroup (floats 0..31), then the N scores/weights
// from float 32.
#define ATTENTION_SCORES 32u

void corrector_attention() {
    const uint ATTENTION_Q_REG_CAP = 16u;
    const uint ATTENTION_FULL_CHUNKS = (uint(SEISMIC_DIM_W) + 31u) >> 5;
    const uint ATTENTION_Q_CHUNKS = ATTENTION_FULL_CHUNKS < ATTENTION_Q_REG_CAP ? ATTENTION_FULL_CHUNKS : ATTENTION_Q_REG_CAP;
    const uint ATTENTION_Q_ARRAY_LEN = ATTENTION_Q_CHUNKS > 0u ? ATTENTION_Q_CHUNKS : 1u;

    const uint64_t qkv = SEISMIC_PTR(SEISMIC_BUFFER_QKV);
    const uint64_t input_bias = SEISMIC_PTR(SEISMIC_BUFFER_INPUT_BIAS);
    const uint64_t bias = SEISMIC_PTR(SEISMIC_BUFFER_BIAS);
    const Out result = SEISMIC_RESULT_0_OUT;
    const uint64_t nodes = SEISMIC_DIM_N, width = SEISMIC_DIM_W;
    const uint64_t head = gl_WorkGroupID.y;
    uint64_t block, query;
    seismic_split(gl_WorkGroupID.x, nodes, block, query);
    const float scale = seismic_div_rn(1.0, seismic_sqrt_rn(float(width)));

    // Row (block, node, part, head) of qkv and of the input bias.
    const uint64_t query_row = block * SEISMIC_QKV_STRIDE_0 + query * SEISMIC_QKV_STRIDE_1 + head * SEISMIC_QKV_STRIDE_3;
    const uint64_t query_bias = head * SEISMIC_INPUT_BIAS_STRIDE_1;
    const uint64_t key_bias = SEISMIC_INPUT_BIAS_STRIDE_0 + head * SEISMIC_INPUT_BIAS_STRIDE_1;
    const uint64_t value_bias = 2ul * SEISMIC_INPUT_BIAS_STRIDE_0 + head * SEISMIC_INPUT_BIAS_STRIDE_1;

    // Cache this lane's biased query columns in registers across all keys.
    float q_reg[ATTENTION_Q_ARRAY_LEN];
    [[unroll]] for (uint t = 0u; t < ATTENTION_Q_CHUNKS; ++t) {
        const uint64_t c = uint64_t(SEISMIC_LANE) + uint64_t(t) * 32ul;
        if (c < width)
            q_reg[t] = element_f32_at(qkv + (query_row + c * SEISMIC_QKV_STRIDE_4) * 4ul)
                + element_f32_at(input_bias + (query_bias + c * SEISMIC_INPUT_BIAS_STRIDE_2) * 4ul);
    }

    // One key a logical subgroup, steered while a logical subgroup holds a
    // key: a logical subgroup past the keys on a 64-lane hardware subgroup
    // scores the last key again and stores nothing.
    bool held;
    for (uint64_t key = SEISMIC_SUBGROUP; seismic_steer(held, key < nodes); key += SEISMIC_SUBGROUPS) {
        const uint64_t key_row = block * SEISMIC_QKV_STRIDE_0 + (held ? key : nodes - 1ul) * SEISMIC_QKV_STRIDE_1
            + SEISMIC_QKV_STRIDE_2 + head * SEISMIC_QKV_STRIDE_3;
        float partial = 0.0;
        [[unroll]] for (uint t = 0u; t < ATTENTION_Q_CHUNKS; ++t) {
            const uint64_t c = uint64_t(SEISMIC_LANE) + uint64_t(t) * 32ul;
            if (c < width) {
                const float k = element_f32_at(qkv + (key_row + c * SEISMIC_QKV_STRIDE_4) * 4ul)
                    + element_f32_at(input_bias + (key_bias + c * SEISMIC_INPUT_BIAS_STRIDE_2) * 4ul);
                partial = seismic_fma_rn(q_reg[t], k, partial);
            }
        }
        if (uint64_t(ATTENTION_Q_CHUNKS) * 32ul < width) {
            seismic_strided_from(uint64_t, c, uint64_t(ATTENTION_Q_CHUNKS) * 32ul, uint64_t(SEISMIC_LANE), width, 32ul) {
                const float q = element_f32_at(qkv + (query_row + c * SEISMIC_QKV_STRIDE_4) * 4ul)
                    + element_f32_at(input_bias + (query_bias + c * SEISMIC_INPUT_BIAS_STRIDE_2) * 4ul);
                const float k = element_f32_at(qkv + (key_row + c * SEISMIC_QKV_STRIDE_4) * 4ul)
                    + element_f32_at(input_bias + (key_bias + c * SEISMIC_INPUT_BIAS_STRIDE_2) * 4ul);
                partial = seismic_fma_rn(q, k, partial);
            }
        }
        const float dot = seismic_subgroup_sum_f32(partial);
        if (held && SEISMIC_LANE == 0u)
            seismic_shared_f32[ATTENTION_SCORES + uint(key)] = dot * scale
                + element_f32_at(bias + (head * SEISMIC_BIAS_STRIDE_0 + query * SEISMIC_BIAS_STRIDE_1
                    + key * SEISMIC_BIAS_STRIDE_2) * 4ul);
    }
    barrier();

    const uint64_t thread = uint64_t(SEISMIC_THREAD);
    const uint64_t threads = uint64_t(gl_WorkGroupSize.x);
    float local_max = -uintBitsToFloat(0x7f800000u);
    seismic_strided(uint64_t, key, thread, nodes, threads)
        local_max = max(local_max, seismic_shared_f32[ATTENTION_SCORES + uint(key)]);
    const float maximum = reduce_group_max(local_max, 0u);

    float local_sum = 0.0;
    seismic_strided(uint64_t, key, thread, nodes, threads) {
        const float weight = exp(seismic_shared_f32[ATTENTION_SCORES + uint(key)] - maximum);
        seismic_shared_f32[ATTENTION_SCORES + uint(key)] = weight;
        local_sum += weight;
    }
    // The sum's barriers also publish every weight to the workgroup.
    const float total = reduce_group_sum(local_sum, 0u);
    const float inv = total > 0.0 ? seismic_div_rn(1.0, total) : 0.0;

    const uint64_t values_base = block * SEISMIC_QKV_STRIDE_0 + 2ul * SEISMIC_QKV_STRIDE_2 + head * SEISMIC_QKV_STRIDE_3;
    const uint64_t out_base = block * SEISMIC_RESULT_0_STRIDE_0 + query * SEISMIC_RESULT_0_STRIDE_1
        + head * SEISMIC_RESULT_0_STRIDE_2;
    for (uint64_t c = thread; c < width; c += threads) {
        const float b = element_f32_at(input_bias + (value_bias + c * SEISMIC_INPUT_BIAS_STRIDE_2) * 4ul);
        const uint64_t v_col = qkv + (values_base + c * SEISMIC_QKV_STRIDE_4) * 4ul;
        float out_value = 0.0;
        for (uint64_t key = 0ul; key < nodes; ++key) {
            const float v = element_f32_at(v_col + key * SEISMIC_QKV_STRIDE_1 * 4ul);
            out_value = seismic_fma_rn(seismic_shared_f32[ATTENTION_SCORES + uint(key)], v + b, out_value);
        }
        out_put(result, out_base + c * SEISMIC_RESULT_0_STRIDE_3, out_value * inv);
    }
}
