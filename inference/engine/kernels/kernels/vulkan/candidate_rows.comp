// candidate_rows on Vulkan (contract and portable body in indexer.seismic), as
// CUDA's and Metal's (`cuda/candidate_rows.cu`):
//
// A workgroup of 256 invocations per row; no invocation walks the row's picks
// or spans alone. The picks are `rows_topk`'s: ascending, then -1, so the
// first `valid` are the picked blocks. With the fill F = min(K, c) - pooled
// (0 when the pool holds min(K, c) units), the fill takes the F lowest
// unpicked units, so the taken units are exactly [0, X) and the picked
// blocks, X the unit after the F-th unpicked one (0 without a fill). Then:
// - the span offsets are scanned into scratch (as `rows_topk`), and the
//   picks' count and pooled units summed;
// - X is placed by a scan of the gaps before each pick and after the last
//   (the invocation whose gap holds the F-th unpicked unit);
// - the taken units are owned as ranges in unit order: [0, X) by invocation
//   0, then each picked block's units at or past X by its pick's invocation
//   (a contiguous share of the picks). A range is preceded by a taken unit
//   when it starts at X > 0 or right after the previous pick's block, and
//   followed by one when the next pick's block starts at its end (for
//   [0, X): the pick whose block starts at X);
// - each range is cut where a list span starts; a piece opens an entry at a
//   span's start or a range start not preceded, and closes it at a span's
//   end or a range end not followed. A scan of each invocation's opened
//   entries places them, so each entry's start and end are each stored once,
//   by the piece that opens or closes it. The rest of the row's B + R spans
//   are [-1, -1].
//
// The workgroup scans are `reduce_group_exclusive_add`. Group memory (u32):
// the scans' 8 subgroup sums, then X and whether unit X is taken [2], then
// the span offsets [R + 1] (R <= 64 by the contract): every search and
// advance reads them there, each written once by the scan.
#include <seismic/element.glsl>
#include "lib/core/reduce.glsl"
#include "lib/indexer/indexer.glsl"

#define CANDIDATE_THREADS 256u
#define CANDIDATE_SCAN 0u
#define CANDIDATE_FILL 8u
#define CANDIDATE_FIRST 10u

// The row's views: its spans, picks and result, and its units.
uint64_t candidate_spans;
uint64_t candidate_picks;
uint64_t candidate_result;
uint candidate_units;

int candidate_pick(uint s) {
    return element_i32_at(candidate_picks + uint64_t(s) * SEISMIC_BLOCKS_STRIDE_1 * 4ul);
}

// Pick s's block's units [first, end), clipped to the row's.
uint candidate_first_unit(uint s) {
    return min(candidate_units, uint(candidate_pick(s)) * uint(SEISMIC_DIM_BU));
}

uint candidate_end_unit(uint s) {
    return min(candidate_units, (uint(candidate_pick(s)) + 1u) * uint(SEISMIC_DIM_BU));
}

// The units before span `span` (span R: the row's).
uint candidate_offset(uint span) {
    return seismic_shared_u32[CANDIDATE_FIRST + span];
}

// Each piece of the range [a, e) in unit order, cut where a list span
// starts: it opens an entry at a span's start or a range start not
// preceded, and closes it at a span's end or a range end not followed.
// Counting, it adds the entries it opens to `entry`; writing, it stores
// each opened entry's start at `entry` and each closed entry's end at
// `entry - 1`, advancing `entry` past the ones it opens.
void candidate_pieces(uint a, uint e, bool preceded, bool followed, bool write, inout uint entry) {
    const uint r = uint(SEISMIC_DIM_R);
    const uint capacity = uint(SEISMIC_DIM_B) + r;
    // The span holding `a` (a < units): the last whose offset is at most it,
    // which holds units.
    uint span = 0u;
    for (uint high = r - 1u; span < high;) {
        const uint middle = (span + high + 1u) / 2u;
        if (candidate_offset(middle) <= a)
            span = middle;
        else
            high = middle - 1u;
    }
    for (uint at = a; at < e;) {
        while (at >= candidate_offset(span + 1u))
            ++span;
        const uint offset = candidate_offset(span);
        const uint span_end = candidate_offset(span + 1u);
        const uint stop = min(e, span_end);
        const bool opens = at == offset || (at == a && !preceded);
        const bool closes = stop == span_end || !followed;
        if (!write) {
            entry += opens ? 1u : 0u;
        } else {
            const int row_lo = element_i32_at(candidate_spans + uint64_t(span) * SEISMIC_SPANS_STRIDE_1 * 4ul);
            if (opens) {
                if (entry < capacity)
                    element_i32_put(candidate_result + uint64_t(entry) * SEISMIC_RESULT_0_STRIDE_1 * 4ul,
                        row_lo + int(at - offset));
                ++entry;
            }
            if (closes && entry - 1u < capacity)
                element_i32_put(candidate_result + (uint64_t(entry - 1u) * SEISMIC_RESULT_0_STRIDE_1
                    + SEISMIC_RESULT_0_STRIDE_2) * 4ul, row_lo + int(stop - offset));
        }
        at = stop;
    }
}

// Every range of invocation `thread` (picks [lo, hi), and for invocation 0
// first [0, X)) in unit order, through `candidate_pieces`.
void candidate_ranges(uint thread, uint lo, uint hi, uint valid, uint x, bool x_followed, bool write,
    inout uint entry) {
    if (thread == 0u && x > 0u)
        candidate_pieces(0u, x, false, x_followed, write, entry);
    for (uint s = lo; s < hi; ++s) {
        const uint first = candidate_first_unit(s);
        const uint a = max(first, x);
        const uint e = candidate_end_unit(s);
        if (a >= e)
            continue;
        const bool preceded = (a == x && x > 0u) || (s > 0u && candidate_pick(s - 1u) + 1 == candidate_pick(s));
        const bool followed = e < candidate_units && s + 1u < valid && candidate_pick(s + 1u) == candidate_pick(s) + 1;
        candidate_pieces(a, e, preceded, followed, write, entry);
    }
}

void candidate_rows() {
    const uint64_t row = gl_WorkGroupID.x;
    const uint thread = SEISMIC_SUBGROUP * 32u + SEISMIC_LANE;
    const uint r = uint(SEISMIC_DIM_R);
    const uint b = uint(SEISMIC_DIM_B);
    const uint k = uint(SEISMIC_DIM_K);
    const uint capacity = b + r;
    candidate_spans = SEISMIC_PTR(SEISMIC_BUFFER_SPANS) + row * SEISMIC_SPANS_STRIDE_0 * 4ul;
    candidate_picks = SEISMIC_PTR(SEISMIC_BUFFER_BLOCKS) + row * SEISMIC_BLOCKS_STRIDE_0 * 4ul;
    candidate_result = SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER) + row * SEISMIC_RESULT_0_STRIDE_0 * 4ul;
    uint total = 0u;

    // The span offsets [R + 1]: the units before each span, then the row's.
    uint units = 0u;
    for (uint base = 0u; base < r; base += CANDIDATE_THREADS) {
        const uint span = base + thread;
        const uint length = span < r
            ? indexer_span_length_at(candidate_spans, SEISMIC_SPANS_STRIDE_1, SEISMIC_SPANS_STRIDE_2, span)
            : 0u;
        uint chunk;
        const uint before = reduce_group_exclusive_add(length, CANDIDATE_SCAN, chunk);
        if (span < r)
            seismic_shared_u32[CANDIDATE_FIRST + span] = units + before;
        units += chunk;
    }
    candidate_units = units;
    if (thread == 0u) {
        seismic_shared_u32[CANDIDATE_FIRST + r] = units;
        seismic_shared_u32[CANDIDATE_FILL] = 0u;
        seismic_shared_u32[CANDIDATE_FILL + 1u] = 0u;
    }

    uint valid;
    uint pooled;
    {
        uint count = 0u, sum = 0u;
        for (uint s = thread; s < b; s += CANDIDATE_THREADS)
            if (candidate_pick(s) >= 0) {
                ++count;
                sum += candidate_end_unit(s) - candidate_first_unit(s);
            }
        reduce_group_exclusive_add(count, CANDIDATE_SCAN, valid);
        reduce_group_exclusive_add(sum, CANDIDATE_SCAN, pooled);
    }
    const uint wanted = min(k, units);
    const uint fill = wanted > pooled ? wanted - pooled : 0u;

    // X: the gap of slot s (s <= valid) is the units between the previous
    // pick's block (or 0) and pick s's block (or, for s == valid, the row's
    // end); the F-th unpicked unit lies in the gap whose scan holds F.
    if (fill > 0u) {
        const uint slots = valid + 1u;
        const uint share = (slots + CANDIDATE_THREADS - 1u) / CANDIDATE_THREADS;
        const uint lo = min(thread * share, slots);
        const uint hi = min(lo + share, slots);
        uint gaps = 0u;
        for (uint s = lo; s < hi; ++s)
            gaps += (s == valid ? units : candidate_first_unit(s)) - (s == 0u ? 0u : candidate_end_unit(s - 1u));
        uint before = reduce_group_exclusive_add(gaps, CANDIDATE_SCAN, total);
        for (uint s = lo; s < hi; ++s) {
            const uint first = s == 0u ? 0u : candidate_end_unit(s - 1u);
            const uint end = s == valid ? units : candidate_first_unit(s);
            if (before < fill && fill <= before + end - first) {
                const uint x = first + (fill - before);
                seismic_shared_u32[CANDIDATE_FILL] = x;
                seismic_shared_u32[CANDIDATE_FILL + 1u] = x == end && s < valid && x < units ? 1u : 0u;
            }
            before += end - first;
        }
    }
    barrier();
    const uint x = seismic_shared_u32[CANDIDATE_FILL];
    const bool x_followed = seismic_shared_u32[CANDIDATE_FILL + 1u] != 0u;

    // This invocation's picks [lo, hi) and their ranges.
    const uint share = (valid + CANDIDATE_THREADS - 1u) / CANDIDATE_THREADS;
    const uint lo = min(thread * share, valid);
    const uint hi = min(lo + share, valid);
    uint opened = 0u;
    candidate_ranges(thread, lo, hi, valid, x, x_followed, false, opened);
    uint count;
    uint entry = reduce_group_exclusive_add(opened, CANDIDATE_SCAN, count);
    candidate_ranges(thread, lo, hi, valid, x, x_followed, true, entry);
    for (uint pad = count + thread; pad < capacity; pad += CANDIDATE_THREADS) {
        const uint64_t target = candidate_result + uint64_t(pad) * SEISMIC_RESULT_0_STRIDE_1 * 4ul;
        element_i32_put(target, -1);
        element_i32_put(target + SEISMIC_RESULT_0_STRIDE_2 * 4ul, -1);
    }
}
