// The representation ladder of a mix site's `up_weight` (`stream_mix_up`):
// UP_KIND (a PACKETS_* kind) and UP_GEOMETRY (its rows16 geometry), as
// `down_weight.glsl` selects the down weight's.

#if defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q4K)
#define UP_KIND PACKETS_Q4K
#define UP_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q5K)
#define UP_KIND PACKETS_Q5K
#define UP_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q6K)
#define UP_KIND PACKETS_Q6K
#define UP_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q8G32S)
#define UP_KIND PACKETS_Q8
#define UP_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_IQ4G32)
#define UP_KIND PACKETS_IQ4
#define UP_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q4G32S)
#define UP_KIND PACKETS_Q4G32S
#define UP_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_IQ4G32S)
#define UP_KIND PACKETS_IQ4S
#define UP_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_MXFP4G32)
#define UP_KIND PACKETS_MXFP4
#define UP_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_NVFP4G16)
#define UP_KIND PACKETS_NVFP4
#define UP_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q5G32S)
#define UP_KIND PACKETS_Q5G32S
#define UP_GEOMETRY PACKETS_ROWS16_Q5(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_Q5G32)
#define UP_KIND PACKETS_Q5G32
#define UP_GEOMETRY PACKETS_ROWS16_Q5(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_IQ2XS)
#define UP_KIND PACKETS_IQ2XS
#define UP_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_IQ3XXS)
#define UP_KIND PACKETS_IQ3XXS
#define UP_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_IQ2XXS)
#define UP_KIND PACKETS_IQ2XXS
#define UP_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_UP_WEIGHT)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_BF16)
#define UP_KIND PACKETS_BF16
#define UP_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_UP_WEIGHT, 2)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_F16)
#define UP_KIND PACKETS_F16
#define UP_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_UP_WEIGHT, 2)
#elif defined(SEISMIC_UP_WEIGHT_REPRESENTATION_F32)
#define UP_KIND PACKETS_F32
#define UP_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_UP_WEIGHT, 4)
#else
#error "unsupported stream_mix_up up_weight representation"
#endif
#if defined(SEISMIC_UP_WEIGHT_KIND_PACKED) && !defined(SEISMIC_UP_WEIGHT_LAYOUT_ROWS16)
#error "stream_mix_up requires the rows16 layout for up_weight"
#endif
