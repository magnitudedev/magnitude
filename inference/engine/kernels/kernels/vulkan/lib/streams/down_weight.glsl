// The representation ladder of a mix site's `down_weight` (`stream_mix_down`):
// DOWN_KIND (a PACKETS_* kind) and DOWN_GEOMETRY (its rows16 geometry). GLSL
// has no templates, so the kind is selected here once; Metal and CUDA bind it
// through their `packets` slots.

#if defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q4K)
#define DOWN_KIND PACKETS_Q4K
#define DOWN_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q5K)
#define DOWN_KIND PACKETS_Q5K
#define DOWN_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q6K)
#define DOWN_KIND PACKETS_Q6K
#define DOWN_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q8G32S)
#define DOWN_KIND PACKETS_Q8
#define DOWN_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_IQ4G32)
#define DOWN_KIND PACKETS_IQ4
#define DOWN_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q4G32S)
#define DOWN_KIND PACKETS_Q4G32S
#define DOWN_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_MXFP4G32)
#define DOWN_KIND PACKETS_MXFP4
#define DOWN_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_NVFP4G16)
#define DOWN_KIND PACKETS_NVFP4
#define DOWN_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q5G32S)
#define DOWN_KIND PACKETS_Q5G32S
#define DOWN_GEOMETRY PACKETS_ROWS16_Q5(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_Q5G32)
#define DOWN_KIND PACKETS_Q5G32
#define DOWN_GEOMETRY PACKETS_ROWS16_Q5(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_IQ2XS)
#define DOWN_KIND PACKETS_IQ2XS
#define DOWN_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_IQ3XXS)
#define DOWN_KIND PACKETS_IQ3XXS
#define DOWN_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_DOWN_WEIGHT)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_BF16)
#define DOWN_KIND PACKETS_BF16
#define DOWN_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_DOWN_WEIGHT, 2)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_F16)
#define DOWN_KIND PACKETS_F16
#define DOWN_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_DOWN_WEIGHT, 2)
#elif defined(SEISMIC_DOWN_WEIGHT_REPRESENTATION_F32)
#define DOWN_KIND PACKETS_F32
#define DOWN_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_DOWN_WEIGHT, 4)
#else
#error "unsupported stream_mix_down down_weight representation"
#endif
#if defined(SEISMIC_DOWN_WEIGHT_KIND_PACKED) && !defined(SEISMIC_DOWN_WEIGHT_LAYOUT_ROWS16)
#error "stream_mix_down requires the rows16 layout for down_weight"
#endif
