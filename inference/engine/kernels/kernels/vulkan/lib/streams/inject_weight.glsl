// The representation ladder of a mix site's `inject_weight`
// (`stream_mix_down`): INJECT_KIND (a PACKETS_* kind) and INJECT_GEOMETRY (its
// rows16 geometry), as `down_weight.glsl` selects the down weight's.

#if defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q4K)
#define INJECT_KIND PACKETS_Q4K
#define INJECT_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q5K)
#define INJECT_KIND PACKETS_Q5K
#define INJECT_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q6K)
#define INJECT_KIND PACKETS_Q6K
#define INJECT_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q8G32S)
#define INJECT_KIND PACKETS_Q8
#define INJECT_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_IQ4G32)
#define INJECT_KIND PACKETS_IQ4
#define INJECT_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q4G32S)
#define INJECT_KIND PACKETS_Q4G32S
#define INJECT_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_IQ4G32S)
#define INJECT_KIND PACKETS_IQ4S
#define INJECT_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_MXFP4G32)
#define INJECT_KIND PACKETS_MXFP4
#define INJECT_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_NVFP4G16)
#define INJECT_KIND PACKETS_NVFP4
#define INJECT_GEOMETRY PACKETS_ROWS16_C4(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q5G32S)
#define INJECT_KIND PACKETS_Q5G32S
#define INJECT_GEOMETRY PACKETS_ROWS16_Q5(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_Q5G32)
#define INJECT_KIND PACKETS_Q5G32
#define INJECT_GEOMETRY PACKETS_ROWS16_Q5(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_IQ2XS)
#define INJECT_KIND PACKETS_IQ2XS
#define INJECT_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_IQ3XXS)
#define INJECT_KIND PACKETS_IQ3XXS
#define INJECT_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_IQ2XXS)
#define INJECT_KIND PACKETS_IQ2XXS
#define INJECT_GEOMETRY PACKETS_ROWS16_GRID(SEISMIC_INJECT_WEIGHT)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_BF16)
#define INJECT_KIND PACKETS_BF16
#define INJECT_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_INJECT_WEIGHT, 2)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_F16)
#define INJECT_KIND PACKETS_F16
#define INJECT_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_INJECT_WEIGHT, 2)
#elif defined(SEISMIC_INJECT_WEIGHT_REPRESENTATION_F32)
#define INJECT_KIND PACKETS_F32
#define INJECT_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_INJECT_WEIGHT, 4)
#else
#error "unsupported stream_mix_down inject_weight representation"
#endif
#if defined(SEISMIC_INJECT_WEIGHT_KIND_PACKED) && !defined(SEISMIC_INJECT_WEIGHT_LAYOUT_ROWS16)
#error "stream_mix_down requires the rows16 layout for inject_weight"
#endif
