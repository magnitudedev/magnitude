// message_gate_mix_norm: fused cross-pass message gate + RMSNorm to A:
//   y[m, h]   = (1 - tanh(forget)) * dest + tanh(gain) * msg
//   inv[m]    = rsqrt(mean_h(y[m, h]^2) + epsilon)
//   out[m, h] = A((y[m, h] * inv[m]) * norm[h])
// One 256-thread workgroup per row.
#define KERNEL_A SEISMIC_ELEMENT_A
#include "lib/core/activation.glsl"
#include "lib/core/precise.glsl"
#include "lib/core/reduce.glsl"

#define GATE_NORM ELEMENT_OF(SEISMIC_NORM)

void message_gate_mix_norm() {
    const uint64_t row = uint64_t(gl_WorkGroupID.x);
    const uint64_t H = SEISMIC_DIM_H;
    const uint thread = SEISMIC_THREAD;
    const float eps = element_word_f32(SEISMIC_PARAM_EPSILON);
    const uint64_t dr = SEISMIC_PTR(SEISMIC_BUFFER_DEST) + row * SEISMIC_DEST_STRIDE_0 * 4ul;
    const uint64_t mr = SEISMIC_PTR(SEISMIC_BUFFER_MSG) + row * SEISMIC_MSG_STRIDE_0 * 4ul;
    const uint64_t gr = SEISMIC_PTR(SEISMIC_BUFFER_GAIN) + row * SEISMIC_GAIN_STRIDE_0 * 4ul;
    const uint64_t fr = SEISMIC_PTR(SEISMIC_BUFFER_FORGET) + row * SEISMIC_FORGET_STRIDE_0 * 4ul;
    const uint64_t norm = SEISMIC_PTR(SEISMIC_BUFFER_NORM);
    const Out result = out_offset(SEISMIC_RESULT_0_OUT, row * SEISMIC_RESULT_0_STRIDE_0);

    const bool can_cache = H <= 8192ul;
    float cached[32];
    float sq = 0.0;

    if (can_cache) {
        for (uint slot = 0u; slot < 32u; ++slot) {
            const uint64_t i = uint64_t(thread) + uint64_t(slot) * uint64_t(gl_WorkGroupSize.x);
            if (i < H) {
                const float d = element_f32_at(dr + i * SEISMIC_DEST_STRIDE_1 * 4ul);
                const float m = element_f32_at(mr + i * SEISMIC_MSG_STRIDE_1 * 4ul);
                const float g = element_f32_at(gr + i * SEISMIC_GAIN_STRIDE_1 * 4ul);
                const float f = element_f32_at(fr + i * SEISMIC_FORGET_STRIDE_1 * 4ul);
                const float tf = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * f)) - 1.0;
                const float tg = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * g)) - 1.0;
                const float y = (1.0 - tf) * d + tg * m;
                cached[slot] = y;
                sq = seismic_fma_rn(y, y, sq);
            }
        }
        const float inv = inversesqrt(seismic_div_rn(reduce_group_sum(sq, 0u), float(H)) + eps);
        for (uint slot = 0u; slot < 32u; ++slot) {
            const uint64_t i = uint64_t(thread) + uint64_t(slot) * uint64_t(gl_WorkGroupSize.x);
            if (i < H) {
                const float nv = element_at(GATE_NORM, norm, i * SEISMIC_NORM_STRIDE_0);
                out_put(result, i * SEISMIC_RESULT_0_STRIDE_1, (cached[slot] * inv) * nv);
            }
        }
    } else {
        seismic_strided(uint64_t, i, thread, H, gl_WorkGroupSize.x) {
            const float d = element_f32_at(dr + i * SEISMIC_DEST_STRIDE_1 * 4ul);
            const float m = element_f32_at(mr + i * SEISMIC_MSG_STRIDE_1 * 4ul);
            const float g = element_f32_at(gr + i * SEISMIC_GAIN_STRIDE_1 * 4ul);
            const float f = element_f32_at(fr + i * SEISMIC_FORGET_STRIDE_1 * 4ul);
            const float tf = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * f)) - 1.0;
            const float tg = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * g)) - 1.0;
            const float y = (1.0 - tf) * d + tg * m;
            sq = seismic_fma_rn(y, y, sq);
        }
        const float inv = inversesqrt(seismic_div_rn(reduce_group_sum(sq, 0u), float(H)) + eps);
        seismic_strided(uint64_t, i, thread, H, gl_WorkGroupSize.x) {
            const float d = element_f32_at(dr + i * SEISMIC_DEST_STRIDE_1 * 4ul);
            const float m = element_f32_at(mr + i * SEISMIC_MSG_STRIDE_1 * 4ul);
            const float g = element_f32_at(gr + i * SEISMIC_GAIN_STRIDE_1 * 4ul);
            const float f = element_f32_at(fr + i * SEISMIC_FORGET_STRIDE_1 * 4ul);
            const float tf = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * f)) - 1.0;
            const float tg = seismic_div_rn(2.0, 1.0 + precise_exp(-2.0 * g)) - 1.0;
            const float y = (1.0 - tf) * d + tg * m;
            const float nv = element_at(GATE_NORM, norm, i * SEISMIC_NORM_STRIDE_0);
            out_put(result, i * SEISMIC_RESULT_0_STRIDE_1, (y * inv) * nv);
        }
    }
}
