// readout_selected_rows: the head projection restricted to the `selected`
// vocabulary rows (a weight-row gather inside the same K1 projection). The
// Vulkan form of `metal/readout_selected_rows.metal` over
// `lib/projection/projection.glsl`.
#define KERNEL_W0 SEISMIC_WEIGHT
#include "lib/core/activation.glsl"
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define HEAD_ACT ELEMENT_ACT
#else
#error "readout_selected_rows requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define HEAD_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define HEAD_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define HEAD_NORM ELEMENT_BF16
#else
#error "readout_selected_rows requires a dense norm"
#endif
// The weight's operand rows (the normalized rows, or NVFP4 operands): the
// GEMV forms them while staging, the stage launch into the GEMM's scratch.
#if defined(SEISMIC_WEIGHT_OPERANDS_NVFP4)
#define HEAD_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define HEAD_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif


#define HEAD_K uint(SEISMIC_DIM_D)

projection_prologue selected_rows_input() {
    return projection_operands(projection_input(HEAD_ACT, SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN),
        SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_0,
        HEAD_NORM, element_word_f32(SEISMIC_PARAM_EPSILON), HEAD_K, SEISMIC_PTR(SEISMIC_BUFFER_OUT_ROWS),
        uint(SEISMIC_DIM_NM), uint(SEISMIC_DIM_PT)), HEAD_OPERANDS);
}

projection_epilogue selected_rows_output() {
    return projection_logits(SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, element_word_f32(SEISMIC_PARAM_SOFTCAP));
}

// Weight row n is vocabulary row selected[n] (a unit-stride i32 table).
projection_weights selected_rows_weight() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), PACKETS_W0_ROWS, HEAD_K,
        SEISMIC_PTR(SEISMIC_BUFFER_SELECTED), 1ul);
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void readout_selected_rows_gemv_bounded(const uint maxm) {
    const projection_weights w = selected_rows_weight();
    projection_gemv(PACKETS_W0, PACKETS_W0, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_SHARED,
        selected_rows_input(), selected_rows_output(), w, w, uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_SV), HEAD_K,
        gl_WorkGroupID.x);
}

void readout_selected_rows_gemv1() { readout_selected_rows_gemv_bounded(1u); }
void readout_selected_rows_gemv2() { readout_selected_rows_gemv_bounded(2u); }
void readout_selected_rows_gemv4() { readout_selected_rows_gemv_bounded(4u); }
void readout_selected_rows_gemv8() { readout_selected_rows_gemv_bounded(8u); }

void readout_selected_rows_stage() {
    projection_stage(selected_rows_input(), gl_WorkGroupID.x, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED), HEAD_K);
}

void readout_selected_rows_gemm() {
    const projection_prologue x = projection_plain(HEAD_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        uint64_t(HEAD_K), 1ul, HEAD_K, 0ul);
    projection_gemm(PACKETS_W0, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N, x, selected_rows_output(),
        selected_rows_weight(), uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_SV), HEAD_K, gl_WorkGroupID.y,
        gl_WorkGroupID.x, 0xffffffffu);
}
