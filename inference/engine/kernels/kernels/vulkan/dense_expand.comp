// dense_expand: RMS prologue over the `out_rows` residual rows, the
// paired gate/up projection, and SiLU(gate)·up. The Vulkan form of
// `metal/dense_expand.metal` over `lib/projection/projection.glsl`.
#define KERNEL_W0 SEISMIC_GATE_WEIGHT
#define KERNEL_W1 SEISMIC_UP_WEIGHT
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_GS != 0 || SEISMIC_STATIC_US != 0
#define PROJECTION_SCALED
#endif
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define DENSE_ACT ELEMENT_ACT
#else
#error "dense_expand requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_NORM_REPRESENTATION_F32)
#define DENSE_NORM ELEMENT_F32
#elif defined(SEISMIC_NORM_REPRESENTATION_F16)
#define DENSE_NORM ELEMENT_F16
#elif defined(SEISMIC_NORM_REPRESENTATION_BF16)
#define DENSE_NORM ELEMENT_BF16
#else
#error "dense_expand requires a dense norm"
#endif
// The rows both weights take (the normalized rows, or NVFP4 operands): the
// GEMV forms them while staging, the stage launch into the GEMM's scratch.
#if defined(SEISMIC_GATE_WEIGHT_OPERANDS_NVFP4)
#define DENSE_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define DENSE_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif



projection_prologue dense_expand_input() {
    return projection_operands(projection_rms(DENSE_ACT, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL), SEISMIC_RESIDUAL_STRIDE_0,
        SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_NORM), SEISMIC_NORM_STRIDE_0, DENSE_NORM,
        element_word_f32(SEISMIC_PARAM_EPS), uint(SEISMIC_DIM_H), SEISMIC_PTR(SEISMIC_BUFFER_OUT_ROWS)),
        DENSE_OPERANDS);
}

projection_epilogue dense_expand_output() {
    return projection_scaled(projection_glu(DENSE_ACT, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, int(SEISMIC_PARAM_ACTIVATION)),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_GATE_SCALE), SEISMIC_DIM_GS, 0ul, 0ul),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_UP_SCALE), SEISMIC_DIM_US, 0ul, 0ul));
}

projection_weights dense_expand_gate() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_GATE_WEIGHT), PACKETS_W0_ROWS, uint(SEISMIC_DIM_H), 0ul, 1ul);
}

projection_weights dense_expand_up() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_UP_WEIGHT), PACKETS_W1_ROWS, uint(SEISMIC_DIM_H), 0ul, 1ul);
}

// The GEMV with the activation-row bound `maxm` (`projection_gemv`: one bound
// per pipeline, so one entry per bound).
void dense_expand_gemv_bounded(const uint maxm) {
    projection_gemv(PACKETS_W0, PACKETS_W1, true, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, maxm, PROJECTION_NORM_SHARED,
        dense_expand_input(), dense_expand_output(), dense_expand_gate(), dense_expand_up(), uint(SEISMIC_DIM_O),
        uint(SEISMIC_DIM_F), uint(SEISMIC_DIM_H), gl_WorkGroupID.x);
}

void dense_expand_gemv1() { dense_expand_gemv_bounded(1u); }
void dense_expand_gemv2() { dense_expand_gemv_bounded(2u); }
void dense_expand_gemv4() { dense_expand_gemv_bounded(4u); }
void dense_expand_gemv8() { dense_expand_gemv_bounded(8u); }

void dense_expand_stage() {
    projection_stage(dense_expand_input(), gl_WorkGroupID.x, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        uint(SEISMIC_DIM_H));
}

void dense_expand_gemm() {
    const projection_prologue x = projection_plain(DENSE_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        SEISMIC_DIM_H, 1ul, uint(SEISMIC_DIM_H), 0ul);
    projection_gemm_paired(PACKETS_W0, PACKETS_W1, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M,
        SEISMIC_TUNE_SUB_N, x, dense_expand_output(), dense_expand_gate(), dense_expand_up(), uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_F), uint(SEISMIC_DIM_H),
        gl_WorkGroupID.y, gl_WorkGroupID.x, 0xffffffffu);
}
