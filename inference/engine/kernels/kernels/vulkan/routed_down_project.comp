// The device's share of a streamed layer's general decode combine
// (`routed_down_project` in routed.seismic): `routed_down`'s projections
// (`lib/routed/down.glsl`), each choice's projection published in A for
// `routed_down_sited`. The Vulkan form of `metal/routed_down_project.metal`.
#define ROUTED_SOURCE_ROWS SEISMIC_CONST_SOURCE_ROWS
#define ROUTED_PROJECTED_PUT(m, k, n, value) out_put(SEISMIC_OUT_PUBLISHED, \
    (m) * SEISMIC_PUBLISHED_STRIDE_0 + (k) * SEISMIC_PUBLISHED_STRIDE_1 + (n) * SEISMIC_PUBLISHED_STRIDE_2, value)
#define KERNEL_A SEISMIC_ELEMENT_A
#define ROUTED_DOWN_MODE int(SEISMIC_PARAM_MODE)
#include "lib/streaming/control.glsl"
#define ROUTED_CHOICE_ACTIVE(c, source)                                                                         \
    (ROUTED_DOWN_MODE == 0 || ROUTED_DOWN_MODE == 1                                                             \
        || (ROUTED_DOWN_MODE == 2 && !slab_source_none(source))                                                 \
        || (ROUTED_DOWN_MODE == 3 && !slab_source_none(source)                                                  \
            && streaming_left_absent(SEISMIC_PTR(SEISMIC_BUFFER_STEP), SEISMIC_STEP_STRIDE_0,                   \
                SEISMIC_PTR(SEISMIC_BUFFER_ROUTING), SEISMIC_ROUTING_STRIDE_0, SEISMIC_ROUTING_STRIDE_1,        \
                uint(SEISMIC_DIM_FLIGHT), uint(SEISMIC_DIM_P), (c))))
#include "lib/routed/down.glsl"

void routed_down_project_summed() { routed_down_publish(); }
void routed_down_project_gather() { routed_down_gather_worklist(); }
void routed_down_project_gathered2() { routed_down_gathered_bounded(2u); }
void routed_down_project_gathered4() { routed_down_gathered_bounded(4u); }
void routed_down_project_gathered8() { routed_down_gathered_bounded(8u); }
