// token_confidence in two launches. The Vulkan form of
// `metal/token_confidence.metal`: token_confidence_partition reduces each of
// CONFIDENCE_PARTS contiguous slices of a selection's logits row to (maximum,
// sum of exp(logit - maximum)); token_confidence_merge, one invocation per
// selection, combines them and publishes the probability of the selected
// token (0 when its selection failed).
#include <seismic/element.glsl>
#include "lib/core/reduce.glsl"

#define CONFIDENCE_PARTS 64ul

// Shared: one partial per subgroup (reduce_group_* at float 0).
void token_confidence_partition() {
    const uint64_t logits = SEISMIC_PTR(SEISMIC_BUFFER_LOGITS);
    const uint64_t partials = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS);
    const uint64_t part = gl_WorkGroupID.x, row = gl_WorkGroupID.y;
    const uint64_t lane = gl_LocalInvocationIndex, threads = gl_WorkGroupSize.x;
    const uint64_t vocabulary = SEISMIC_DIM_V;
    const uint64_t span = (vocabulary + CONFIDENCE_PARTS - 1ul) / CONFIDENCE_PARTS;
    const uint64_t begin = min(part * span, vocabulary), end = min(begin + span, vocabulary);
    const uint64_t line = logits
        + uint64_t(element_i32_index(SEISMIC_PTR(SEISMIC_BUFFER_ROWS), row * SEISMIC_ROWS_STRIDE_0))
            * SEISMIC_LOGITS_STRIDE_0 * 4ul;
    float local = -uintBitsToFloat(0x7f800000u);
    for (uint64_t v = begin + lane; v < end; v += threads)
        local = max(local, element_f32_at(line + v * SEISMIC_LOGITS_STRIDE_1 * 4ul));
    const float maximum = reduce_group_max(local, 0u);
    float partial = 0.0;
    for (uint64_t v = begin + lane; v < end; v += threads)
        partial += exp(element_f32_at(line + v * SEISMIC_LOGITS_STRIDE_1 * 4ul) - maximum);
    const float total = reduce_group_sum(partial, 0u);
    if (lane != 0ul) return;
    const uint64_t slot = partials + (row * CONFIDENCE_PARTS + part) * 8ul;
    element_f32_put(slot, maximum);
    element_f32_put(slot + 4ul, total);
}

void token_confidence_merge() {
    const uint64_t logits = SEISMIC_PTR(SEISMIC_BUFFER_LOGITS);
    const uint64_t selection = SEISMIC_PTR(SEISMIC_BUFFER_SELECTION);
    const uint64_t partials = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS);
    const uint64_t confidence = SEISMIC_PTR(SEISMIC_BUFFER_CONFIDENCE);
    const uint64_t row = gl_GlobalInvocationID.x;
    if (row >= SEISMIC_DIM_M)
        return;
    const uint64_t pairs = partials + row * CONFIDENCE_PARTS * 8ul;
    float maximum = -uintBitsToFloat(0x7f800000u);
    for (uint64_t part = 0ul; part < CONFIDENCE_PARTS; ++part)
        maximum = max(maximum, element_f32_at(pairs + part * 8ul));
    float total = 0.0;
    for (uint64_t part = 0ul; part < CONFIDENCE_PARTS; ++part) {
        const float sum = element_f32_at(pairs + part * 8ul + 4ul);
        if (sum > 0.0)
            total += sum * exp(element_f32_at(pairs + part * 8ul) - maximum);
    }
    const uint64_t line = logits
        + uint64_t(element_i32_index(SEISMIC_PTR(SEISMIC_BUFFER_ROWS), row * SEISMIC_ROWS_STRIDE_0))
            * SEISMIC_LOGITS_STRIDE_0 * 4ul;
    const uint64_t selected = row * SEISMIC_SELECTION_STRIDE_0;
    const int token = element_i32_index(selection, selected);
    const float probability = element_i32_index(selection, selected + SEISMIC_SELECTION_STRIDE_1) == 0
        ? exp(element_f32_at(line + uint64_t(token) * SEISMIC_LOGITS_STRIDE_1 * 4ul) - maximum) / total
        : 0.0;
    element_f32_put(confidence + row * SEISMIC_CONFIDENCE_STRIDE_0 * 4ul, probability);
}
