// token_confidence in two launches. The Vulkan form of
// `metal/token_confidence.metal` and `cuda/token_confidence.cu`:
// token_confidence_partition reduces each of CONFIDENCE_PARTS contiguous slices
// of a selection's logits row in a single pass to (maximum, sum of
// exp(logit - maximum)); token_confidence_merge, one invocation per selection,
// combines them and publishes the probability of the selected token (0 when its
// selection failed).
#include <seismic/element.glsl>

#define CONFIDENCE_PARTS 64ul
REQUIRE_DIVISOR_BELOW_2_16(confidence_parts_below_2_16, CONFIDENCE_PARTS);

// Single-pass online softmax update: empty state is {-inf, 0}; -inf inputs
// never produce NaN, while NaN inputs propagate through `local_sum`.
void confidence_add(float x, inout float local_max, inout float local_sum) {
    if (x > local_max) {
        local_sum = (local_sum != 0.0 ? local_sum * exp(local_max - x) : 0.0) + 1.0;
        local_max = x;
    } else if (x != -uintBitsToFloat(0x7f800000u)) {
        local_sum += exp(x - local_max);
    }
}

// Shared: SEISMIC_SUBGROUPS subgroup maxima at 0..SEISMIC_SUBGROUPS-1 and
// subgroup sums at SEISMIC_SUBGROUPS..2*SEISMIC_SUBGROUPS-1 (16 floats for
// 256 threads; shared_bytes (128) = 32 floats).
void token_confidence_partition() {
    const uint64_t logits = SEISMIC_PTR(SEISMIC_BUFFER_LOGITS);
    const uint64_t partials = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS);
    const uint64_t part = uint64_t(gl_WorkGroupID.x), row = uint64_t(gl_WorkGroupID.y);
    const uint64_t tid = uint64_t(SEISMIC_THREAD), threads = uint64_t(gl_WorkGroupSize.x);
    const uint64_t vocabulary = SEISMIC_DIM_V;
    const uint64_t span = seismic_quotient(vocabulary + CONFIDENCE_PARTS - 1ul, uint(CONFIDENCE_PARTS));
    const uint64_t begin = min(part * span, vocabulary), end = min(begin + span, vocabulary);
    const uint64_t line = logits
        + uint64_t(element_i32_index(SEISMIC_PTR(SEISMIC_BUFFER_ROWS), row * SEISMIC_ROWS_STRIDE_0))
            * SEISMIC_LOGITS_STRIDE_0 * 4ul;
    // Numbered by `SEISMIC_THREAD`: the partials reach the subgroup reductions.
    float local_max = -uintBitsToFloat(0x7f800000u);
    float local_sum = 0.0;
    const uint64_t count = end - begin;
    const uint64_t slice = line + begin * 4ul;
    if (SEISMIC_LOGITS_STRIDE_1 == 1ul && (slice & 3ul) == 0ul) {
        const uint64_t misalign = (slice & 15ul) >> 2u;
        const uint64_t head = misalign == 0ul ? 0ul : min(4ul - misalign, count);
        if (tid < head)
            confidence_add(element_f32_at(slice + tid * 4ul), local_max, local_sum);
        const uint64_t aligned = slice + head * 4ul;
        const uint64_t vecs = (count - head) >> 2u;
        seismic_strided(uint64_t, i, tid, vecs, threads) {
            const vec4 v = element_vec4_at(aligned + i * 16ul);
            confidence_add(v.x, local_max, local_sum);
            confidence_add(v.y, local_max, local_sum);
            confidence_add(v.z, local_max, local_sum);
            confidence_add(v.w, local_max, local_sum);
        }
        const uint64_t tail = head + (vecs << 2u);
        if (tid < count - tail)
            confidence_add(element_f32_at(slice + (tail + tid) * 4ul), local_max, local_sum);
    } else {
        seismic_strided_from(uint64_t, v, begin, tid, end, threads)
            confidence_add(element_f32_at(line + v * SEISMIC_LOGITS_STRIDE_1 * 4ul), local_max, local_sum);
    }
    const float sg_max = seismic_subgroup_max(local_max);
    const float sg_sum = seismic_subgroup_sum_f32(
        local_sum != 0.0 ? local_sum * exp(local_max - sg_max) : 0.0);
    if (SEISMIC_LANE == 0u) {
        seismic_shared_f32[SEISMIC_SUBGROUP] = sg_max;
        seismic_shared_f32[SEISMIC_SUBGROUPS + SEISMIC_SUBGROUP] = sg_sum;
    }
    barrier();
    if (SEISMIC_THREAD != 0u)
        return;
    float maximum = seismic_shared_f32[0u];
    for (uint s = 1u; s < SEISMIC_SUBGROUPS; ++s)
        maximum = max(maximum, seismic_shared_f32[s]);
    float total = 0.0;
    for (uint s = 0u; s < SEISMIC_SUBGROUPS; ++s) {
        const float sum = seismic_shared_f32[SEISMIC_SUBGROUPS + s];
        if (sum != 0.0)
            total += sum * exp(seismic_shared_f32[s] - maximum);
    }
    const uint64_t slot = partials + (row * CONFIDENCE_PARTS + part) * 8ul;
    element_f32_put(slot, maximum);
    element_f32_put(slot + 4ul, total);
}

void token_confidence_merge() {
    const uint64_t logits = SEISMIC_PTR(SEISMIC_BUFFER_LOGITS);
    const uint64_t selection = SEISMIC_PTR(SEISMIC_BUFFER_SELECTION);
    const uint64_t partials = SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS);
    const Out confidence = SEISMIC_OUT_CONFIDENCE;
    const uint64_t row = gl_GlobalInvocationID.x;
    if (row >= SEISMIC_DIM_M)
        return;
    const uint64_t pairs = partials + row * CONFIDENCE_PARTS * 8ul;
    float maximum = -uintBitsToFloat(0x7f800000u);
    for (uint64_t part = 0ul; part < CONFIDENCE_PARTS; ++part)
        maximum = max(maximum, element_f32_at(pairs + part * 8ul));
    float total = 0.0;
    for (uint64_t part = 0ul; part < CONFIDENCE_PARTS; ++part) {
        const float sum = element_f32_at(pairs + part * 8ul + 4ul);
        if (sum != 0.0)
            total += sum * exp(element_f32_at(pairs + part * 8ul) - maximum);
    }
    const uint64_t line = logits
        + uint64_t(element_i32_index(SEISMIC_PTR(SEISMIC_BUFFER_ROWS), row * SEISMIC_ROWS_STRIDE_0))
            * SEISMIC_LOGITS_STRIDE_0 * 4ul;
    const uint64_t selected = row * SEISMIC_SELECTION_STRIDE_0;
    const int token = element_i32_index(selection, selected);
    const float probability = element_i32_index(selection, selected + SEISMIC_SELECTION_STRIDE_1) == 0 && total != 0.0
        ? seismic_div_rn(exp(element_f32_at(line + uint64_t(token) * SEISMIC_LOGITS_STRIDE_1 * 4ul) - maximum), total)
        : 0.0;
    out_put(confidence, row * SEISMIC_CONFIDENCE_STRIDE_0, probability);
}
