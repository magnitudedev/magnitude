// copy_rows: rows[to[item], head, :] = rows[from[item], head, :] for dense state
// planes of one element type; one invocation per 16-byte chunk along W, over a
// grid-stride loop (the grid is capped below the 65535-group floor). Rows
// outside the plane (including -1) are skipped. Every plane is copied bit for
// bit: a floating plane's owner-written elements move as stored, an integer
// plane's as 16-byte words when unit-strided and aligned (else whole elements).
#include <seismic/element.glsl>
#include <seismic/slab.glsl>
#include <seismic/repack.glsl>

#if !defined(SEISMIC_ROWS_KIND_DENSE)
#error "copy_rows supports dense state planes only"
#endif

void copy_rows() {
    const uint elem_bytes = uint(REPACK_PACKET_BYTES(SEISMIC_ROWS));
    const uint vec = elem_bytes >= 16u ? 1u : (16u / elem_bytes);
    const uint vec_shift = vec == 16u ? 4u : vec == 8u ? 3u : vec == 4u ? 2u : vec == 2u ? 1u : 0u;
    const uint64_t from = SEISMIC_PTR(SEISMIC_BUFFER_FROM);
    const uint64_t to = SEISMIC_PTR(SEISMIC_BUFFER_TO);
    const uint64_t chunks_per_head = (SEISMIC_DIM_W + uint64_t(vec - 1u)) >> vec_shift;
    const uint64_t count = SEISMIC_DIM_N * SEISMIC_DIM_KV * chunks_per_head;
    const uint slab_rows = uint(SEISMIC_PARAM_SLAB_ROWS);
#if defined(SEISMIC_OUT_ROWS)
    const SlabOut rows = SEISMIC_OUT_ROWS;
#else
    const uint64_t rows = SEISMIC_PTR(SEISMIC_BUFFER_ROWS);
    const uint64_t row_bytes = SEISMIC_ROWS_STRIDE_0 * uint64_t(elem_bytes);
#endif
    for (seismic_walk walk = seismic_walk_grid(count, u64vec3(1ul, SEISMIC_DIM_KV, chunks_per_head));
         walk.index < count; seismic_walk_next(walk)) {
        const uint64_t item = walk.axes.x;
        const uint64_t head = walk.axes.z;
        const uint64_t column = walk.axes.w << vec_shift;
        const int source_row = element_i32_index(from, item * SEISMIC_FROM_STRIDE_0);
        const int destination_row = element_i32_index(to, item * SEISMIC_TO_STRIDE_0);
        if (source_row < 0 || destination_row < 0 || uint64_t(source_row) >= SEISMIC_DIM_T
            || uint64_t(destination_row) >= SEISMIC_DIM_T)
            continue;
        const uint chunk = uint(min(SEISMIC_DIM_W - column, uint64_t(vec)));
        const uint64_t at = head * SEISMIC_ROWS_STRIDE_1 + column * SEISMIC_ROWS_STRIDE_2;
#if defined(SEISMIC_OUT_ROWS)
        // A floating plane: its owner-written elements move as stored.
        const Out source = slab_out_row(rows, uint(source_row), slab_rows, SEISMIC_ROWS_STRIDE_0);
        const Out destination = slab_out_row(rows, uint(destination_row), slab_rows, SEISMIC_ROWS_STRIDE_0);
        if (SEISMIC_ROWS_STRIDE_2 == 1ul) {
            out_move_stored(destination, at, source, at, uint64_t(chunk));
        } else {
            for (uint i = 0u; i < chunk; ++i) {
                const uint64_t offset = at + uint64_t(i) * SEISMIC_ROWS_STRIDE_2;
                out_move_stored(destination, offset, source, offset, 1ul);
            }
        }
#else
        // An integer plane: 16-byte word moves when unit-strided and aligned,
        // else whole words of the element's size.
        const uint64_t src_row = slab_row(rows, uint(source_row), slab_rows, row_bytes);
        const uint64_t dst_row = slab_row(rows, uint(destination_row), slab_rows, row_bytes);
        if (SEISMIC_ROWS_STRIDE_2 == 1ul) {
            const uint64_t src = src_row + at * uint64_t(elem_bytes);
            const uint64_t dst = dst_row + at * uint64_t(elem_bytes);
            if (chunk * elem_bytes == 16u && ((src | dst) & 15ul) == 0ul) {
                element_uvec4_put(dst, element_uvec4_at(src));
            } else {
                for (uint i = 0u; i < chunk; ++i) {
                    const uint64_t offset = uint64_t(i) * uint64_t(elem_bytes);
                    ELEMENT_COPY(uint(REPACK_PACKET_BYTES(SEISMIC_ROWS)), dst + offset, src + offset);
                }
            }
        } else {
            for (uint i = 0u; i < chunk; ++i) {
                const uint64_t offset = (at + uint64_t(i) * SEISMIC_ROWS_STRIDE_2) * uint64_t(elem_bytes);
                ELEMENT_COPY(uint(REPACK_PACKET_BYTES(SEISMIC_ROWS)), dst_row + offset, src_row + offset);
            }
        }
#endif
    }
}
