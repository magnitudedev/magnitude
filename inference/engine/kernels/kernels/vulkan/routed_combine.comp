// Prefill combine. The Vulkan form of `metal/routed_combine.metal`.
// L1 (`routed_combine_expand`): the K1 paired GEMM of the shared
// expert's gate/up over all M rows with SiluMul into the `product`
// scratch. L2 (`routed_combine_down`): the K1 GEMM of the shared down
// projection into the `shared_output` scratch [M, H], in A. L3
// (`routed_combine`): the grouped expert outputs of each row unpermuted
// in slot order, published as
//     residual + selected + shared * coefficient.
// An L3 invocation owns 8 consecutive columns of one row: it reads each
// choice's position and score once and the choice's 8 expert outputs as one
// 16-byte load, so the gather moves whole rows of expert output.
// The grouped projection's GEMMs stage their weights' tables (`packets.glsl`).
#define KERNEL_A SEISMIC_ELEMENT_A
#define PACKETS_CONFIG_STAGED_TABLES 1
#define KERNEL_W0 SEISMIC_SHARED_GATE
#define KERNEL_W1 SEISMIC_SHARED_UP
#define KERNEL_W2 SEISMIC_SHARED_DOWN
#include "lib/core/activation.glsl"
#include "lib/routed/routed.glsl"

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "routed_combine requires a bf16 or f16 activation"
#endif
#define ROUTED_ACT ACTIVATION_A
// The shared expert's GEMMs: the declaration's tuned tile and sub-tile.
#define PROJECTION_GEMM_TM SEISMIC_TUNE_TILE_M
#define PROJECTION_GEMM_TN SEISMIC_TUNE_TILE_N
#define PROJECTION_GEMM_WM SEISMIC_TUNE_SUB_M
#define PROJECTION_GEMM_WN SEISMIC_TUNE_SUB_N
#include "lib/projection/gemm.glsl"




// Invocations of an L3 workgroup (8 columns each).
#define COMBINE_THREADS 256u

void routed_combine_expand() {
    packets_stage_tables();
    const uint hidden = uint(SEISMIC_DIM_H);
    const projection_prologue x = projection_plain(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_NORMALIZED),
        SEISMIC_NORMALIZED_STRIDE_0, SEISMIC_NORMALIZED_STRIDE_1, hidden, 0ul);
    const projection_weights gate = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_GATE), PACKETS_W0_ROWS, 0ul, hidden);
    const projection_weights up = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_UP), PACKETS_W1_ROWS, 0ul, hidden);
    const projection_epilogue out_ = projection_silu_mul(ROUTED_ACT, out_over_scratch(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PRODUCT)),
        SEISMIC_DIM_S, 1ul);
    projection_gemm_paired(PACKETS_W0, PACKETS_W1, x, out_, gate, up,
        uint(SEISMIC_DIM_M), uint(SEISMIC_DIM_S), hidden, gl_WorkGroupID.y, gl_WorkGroupID.x, 0xffffffffu);
}

void routed_combine_down() {
    packets_stage_tables();
    const uint shared_features = uint(SEISMIC_DIM_S);
    const projection_prologue x = projection_plain(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PRODUCT),
        SEISMIC_DIM_S, 1ul, shared_features, 0ul);
    const projection_weights down = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_SHARED_DOWN), PACKETS_W2_ROWS, 0ul,
        shared_features);
    const projection_epilogue out_ = projection_store(
        out_over_scratch(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_SHARED_OUTPUT)), SEISMIC_DIM_H, 1ul, 0ul);
    projection_gemm(PACKETS_W2, x, out_, down, uint(SEISMIC_DIM_M),
        uint(SEISMIC_DIM_H), shared_features, gl_WorkGroupID.y, gl_WorkGroupID.x, 0xffffffffu);
}

// Exact unsigned 32-bit divmod by a runtime-invariant divisor >= 1:
// shift/mask for powers of two (`magic == 0`), Granlund-Montgomery
// `umulExtended` reciprocal otherwise.
struct FastDiv32 {
    uint d;
    uint magic;
    uint shift;
};

FastDiv32 fast_div32_make(uint divisor) {
    const uint s = uint(findMSB(divisor));
    if ((divisor & (divisor - 1u)) == 0u)
        return FastDiv32(divisor, 0u, s);
    uint64_t rem = ((1ul << (s + 1u)) - uint64_t(divisor)) << 32;
    const uint m = seismic_narrow_divide(rem, uint64_t(divisor)) + 1u;
    return FastDiv32(divisor, m, s);
}

void fast_div32_divmod(FastDiv32 fd, uint n, out uint q, out uint r) {
    if (fd.magic == 0u) {
        q = n >> fd.shift;
        r = n & (fd.d - 1u);
    } else {
        uint t, lo;
        umulExtended(n, fd.magic, t, lo);
        q = (t + ((n - t) >> 1u)) >> fd.shift;
        r = n - q * fd.d;
    }
}

void routed_combine() {
    const uint64_t m = gl_WorkGroupID.y;
    const uint n = 8u * (gl_WorkGroupID.x * COMBINE_THREADS + gl_LocalInvocationIndex);
    const uint columns = uint(SEISMIC_DIM_H);
    if (n >= columns)
        return;
    const uint valid = min(8u, columns - n);
    const bool vector = SEISMIC_EXPERT_OUTPUT_STRIDE_2 == 1ul && (SEISMIC_EXPERT_OUTPUT_STRIDE_1 & 7ul) == 0ul
        && (SEISMIC_EXPERT_OUTPUT_STRIDE_0 & 7ul) == 0ul;
    const FastDiv32 tile_div = fast_div32_make(uint(SEISMIC_DIM_T));
    const uint64_t inverse_row = SEISMIC_PTR(SEISMIC_BUFFER_INVERSE) + m * SEISMIC_INVERSE_STRIDE_0 * 4ul;
    const uint64_t inverse_step = SEISMIC_INVERSE_STRIDE_1 * 4ul;
    const uint64_t scores_row = SEISMIC_PTR(SEISMIC_BUFFER_SCORES) + m * SEISMIC_SCORES_STRIDE_0 * 4ul;
    const uint64_t scores_step = SEISMIC_SCORES_STRIDE_1 * 4ul;
    const uint64_t expert_base = SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_OUTPUT);
    const uint64_t expert_col = uint64_t(n) * SEISMIC_EXPERT_OUTPUT_STRIDE_2;
    vec4 selected_even = vec4(0.0), selected_odd = vec4(0.0);
    // A 32-bit counter: see `streaming/contract.hpp`.
    for (uint k = 0u; k < uint(SEISMIC_DIM_K); ++k) {
        const uint position = uint(element_i32_at(inverse_row + uint64_t(k) * inverse_step));
        const float score = element_f32_at(scores_row + uint64_t(k) * scores_step);
        // Positions are 32-bit: the expert-ordered rows' count.
        uint tile_at, lane_at;
        fast_div32_divmod(tile_div, position, tile_at, lane_at);
        const uint64_t row = uint64_t(tile_at) * SEISMIC_EXPERT_OUTPUT_STRIDE_0
            + uint64_t(lane_at) * SEISMIC_EXPERT_OUTPUT_STRIDE_1;
        vec4 even, odd;
        projection_load8_strided(ROUTED_ACT, expert_base, row + expert_col,
            SEISMIC_EXPERT_OUTPUT_STRIDE_2, valid, vector, even, odd);
        [[unroll]] for (uint i = 0u; i < 4u; ++i) {
            selected_even[i] = seismic_fma_rn(score, even[i], selected_even[i]);
            selected_odd[i] = seismic_fma_rn(score, odd[i], selected_odd[i]);
        }
    }
    vec4 shared_even, shared_odd;
    projection_load8_strided(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_SHARED_OUTPUT), m * columns + n, 1ul, valid,
        (columns & 7u) == 0u, shared_even, shared_odd);
    const float c = element_f32_at(SEISMIC_PTR(SEISMIC_BUFFER_COEFFICIENT) + m * SEISMIC_COEFFICIENT_STRIDE_0 * 4ul);
    const vec4 scaled_even = shared_even * c;
    const vec4 scaled_odd = shared_odd * c;
    if (valid == 8u && SEISMIC_RESULT_0_STRIDE_1 == 1ul && SEISMIC_RESIDUAL_STRIDE_1 == 1ul) {
        const uint64_t out_base = m * SEISMIC_RESULT_0_STRIDE_0 + uint64_t(n);
        const uint64_t residual_base = SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL)
            + (m * SEISMIC_RESIDUAL_STRIDE_0 + uint64_t(n)) * 4ul;
        if (uint(SEISMIC_DIM_IN) == 0u) {
            if ((residual_base & 15ul) == 0ul && stored_aligned16(out_stored(SEISMIC_RESULT_0_OUT, out_base))) {
                const vec4 r0 = element_vec4_at(residual_base);
                const vec4 r1 = element_vec4_at(residual_base + 16ul);
                const vec4 res_even = vec4(r0.x, r0.z, r1.x, r1.z);
                const vec4 res_odd = vec4(r0.y, r0.w, r1.y, r1.w);
                out_put8(SEISMIC_RESULT_0_OUT, out_base,
                    (res_even + selected_even) + scaled_even,
                    (res_odd + selected_odd) + scaled_odd);
                return;
            }
        } else {
            const bool all_aligned = (residual_base & 15ul) == 0ul
                && stored_aligned16(out_stored(SEISMIC_RESULT_0_OUT, out_base))
                && (uint(SEISMIC_DIM_SN) == 1u
                    || ((columns & 3u) == 0u
                        && stored_aligned16(out_stored(SEISMIC_RESULT_0_OUT, out_base + uint64_t(columns)))));
            if (all_aligned) {
                const uint64_t inject_row = SEISMIC_PTR(SEISMIC_BUFFER_INJECT) + m * SEISMIC_INJECT_STRIDE_0 * 4ul;
                const vec4 total_even = selected_even + scaled_even;
                const vec4 total_odd = selected_odd + scaled_odd;
                for (uint s = 0u; s < uint(SEISMIC_DIM_SN); ++s) {
                    const float gain = element_f32_at(inject_row + uint64_t(s) * 4ul);
                    const uint64_t stream_off = uint64_t(s) * uint64_t(columns);
                    const uint64_t residual_at = residual_base + stream_off * 4ul;
                    const vec4 r0 = element_vec4_at(residual_at);
                    const vec4 r1 = element_vec4_at(residual_at + 16ul);
                    const vec4 res_even = vec4(r0.x, r0.z, r1.x, r1.z);
                    const vec4 res_odd = vec4(r0.y, r0.w, r1.y, r1.w);
                    out_put8(SEISMIC_RESULT_0_OUT, out_base + stream_off,
                        res_even + total_even * gain,
                        res_odd + total_odd * gain);
                }
                return;
            }
        }
    }
    [[unroll]] for (uint i = 0u; i < 8u; ++i) {
        if (i < valid) {
            const uint64_t column = uint64_t(n + i);
            const float selected = (i & 1u) != 0u ? selected_odd[i >> 1] : selected_even[i >> 1];
            const float projected = (i & 1u) != 0u ? scaled_odd[i >> 1] : scaled_even[i >> 1];
            projection_routed_join(SEISMIC_RESULT_0_OUT, SEISMIC_RESULT_0_STRIDE_0,
                SEISMIC_RESULT_0_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_RESIDUAL), SEISMIC_RESIDUAL_STRIDE_0,
                SEISMIC_RESIDUAL_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_INJECT), SEISMIC_INJECT_STRIDE_0,
                uint(SEISMIC_DIM_IN), uint(SEISMIC_DIM_SN), columns, m, column, selected, projected);
        }
    }
}
