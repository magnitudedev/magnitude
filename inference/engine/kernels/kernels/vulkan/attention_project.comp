// attention_project: RMS prologue over the F32 residual, then one
// segmented projection query | key | value into three results (a segment of
// zero rows has no tiles). The
// Vulkan form of `metal/attention_project.metal` on the `dense` projection
// (`lib/projection/operator.glsl`).
#define KERNEL_A SEISMIC_ELEMENT_A
#define KERNEL_W0 SEISMIC_QUERY_WEIGHT
#define KERNEL_W1 SEISMIC_GATE_WEIGHT
#define KERNEL_W2 SEISMIC_KEY_WEIGHT
#define KERNEL_W3 SEISMIC_VALUE_WEIGHT
// The projection's decoding launches stage their weights' tables (`packets.glsl`).
#define PACKETS_CONFIG_STAGED_TABLES 1
#include "lib/core/activation.glsl"
#if SEISMIC_STATIC_QS != 0 || SEISMIC_STATIC_GS != 0 || SEISMIC_STATIC_KS != 0 || SEISMIC_STATIC_VS != 0
#define PROJECTION_SCALED
#endif

#if ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_BF16 && ELEMENT_KIND(SEISMIC_ELEMENT_A) != ELEMENT_F16
#error "attention_project requires a bf16 or f16 activation"
#endif
#define PROJECT_ACT ACTIVATION_A
#define PROJECT_NORM ELEMENT_OF(SEISMIC_INPUT_NORM)
#include "lib/projection/projection.glsl"
// The rows every weight takes (the normalized rows, or NVFP4 operands): the
// GEMV forms them while staging, the stage launch into the GEMM's scratch.
#if PACKETS_OPERANDS_NVFP4(SEISMIC_QUERY_WEIGHT)
#define PROJECT_OPERANDS PROJECTION_OPERANDS_NVFP4
#else
#define PROJECT_OPERANDS PROJECTION_OPERANDS_ROUNDED
#endif

#define PROJECT_K uint(SEISMIC_DIM_D)
#define PROJECT_QUERY_ROWS uint(SEISMIC_DIM_Q)
#define PROJECT_GATE_ROWS uint(SEISMIC_DIM_GR)
#define PROJECT_KEY_ROWS uint(SEISMIC_DIM_K)
#define PROJECT_VALUE_ROWS uint(SEISMIC_DIM_V)

projection_prologue projected_input(uint g) {
    return projection_operands(projection_input(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN),
        SEISMIC_HIDDEN_STRIDE_0, SEISMIC_HIDDEN_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_INPUT_NORM),
        SEISMIC_INPUT_NORM_STRIDE_0, PROJECT_NORM, element_word_f32(SEISMIC_PARAM_EPSILON), PROJECT_K, 0ul,
        uint(SEISMIC_DIM_NM), uint(SEISMIC_DIM_PT)), PROJECT_OPERANDS);
}

projection_weights attention_project_query() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_QUERY_WEIGHT), PACKETS_W0_ROWS, PROJECT_K, 0ul, 1ul, 0u);
}
projection_weights attention_project_gate() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_GATE_WEIGHT), PACKETS_W1_ROWS, PROJECT_K, 0ul, 1ul, 0u);
}
projection_weights attention_project_key() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_KEY_WEIGHT), PACKETS_W2_ROWS, PROJECT_K, 0ul, 1ul, 0u);
}
projection_weights attention_project_value() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_VALUE_WEIGHT), PACKETS_W3_ROWS, PROJECT_K, 0ul, 1ul, 0u);
}

// Each segment's result, after its weight's second-level scale where it has
// one (an absent port's factor is 1).
projection_epilogue attention_project_query_out() {
    return projection_scaled(projection_store(SEISMIC_RESULT_0_OUT,
        SEISMIC_RESULT_0_STRIDE_0, SEISMIC_RESULT_0_STRIDE_1, 0ul),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_QUERY_SCALE), SEISMIC_DIM_QS, 0ul, 0ul), 1.0);
}
projection_epilogue attention_project_gate_out() {
    return projection_scaled(projection_store(SEISMIC_RESULT_1_OUT,
        SEISMIC_RESULT_1_STRIDE_0, SEISMIC_RESULT_1_STRIDE_1, 0ul),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_GATE_SCALE), SEISMIC_DIM_GS, 0ul, 0ul), 1.0);
}
projection_epilogue attention_project_key_out() {
    return projection_scaled(projection_store(SEISMIC_RESULT_2_OUT,
        SEISMIC_RESULT_2_STRIDE_0, SEISMIC_RESULT_2_STRIDE_1, 0ul),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_KEY_SCALE), SEISMIC_DIM_KS, 0ul, 0ul), 1.0);
}
projection_epilogue attention_project_value_out() {
    return projection_scaled(projection_store(SEISMIC_RESULT_3_OUT,
        SEISMIC_RESULT_3_STRIDE_0, SEISMIC_RESULT_3_STRIDE_1, 0ul),
        projection_scale_factor(SEISMIC_PTR(SEISMIC_BUFFER_VALUE_SCALE), SEISMIC_DIM_VS, 0ul, 0ul), 1.0);
}

#define PROJECTION_M uint(SEISMIC_DIM_M)
#define PROJECTION_K PROJECT_K
#define PROJECTION_NORM PROJECTION_NORM_SHARED
#define PROJECTION_STAGED SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STAGED)
#define PROJECTION_N0 PROJECT_QUERY_ROWS
#define PROJECTION_N1 PROJECT_GATE_ROWS
#define PROJECTION_N2 PROJECT_KEY_ROWS
#define PROJECTION_N3 PROJECT_VALUE_ROWS
#define PROJECTION_WEIGHT0 attention_project_query()
#define PROJECTION_WEIGHT1 attention_project_gate()
#define PROJECTION_WEIGHT2 attention_project_key()
#define PROJECTION_WEIGHT3 attention_project_value()
#define PROJECTION_OUTPUT0 attention_project_query_out()
#define PROJECTION_OUTPUT1 attention_project_gate_out()
#define PROJECTION_OUTPUT2 attention_project_key_out()
#define PROJECTION_OUTPUT3 attention_project_value_out()
// Mode 1 has no query or gate projection.
#define PROJECTION_ZEROED(s) (SEISMIC_PARAM_PROJECT_MODE != 0 && s < 2)

// The normalized rows the stage launch formed.
projection_prologue projected_rows(uint g) {
    return projection_plain(PROJECT_ACT, PROJECTION_STAGED, uint64_t(PROJECT_K), 1ul, PROJECT_K, 0ul);
}

#include "lib/projection/operator.glsl"

// The `dense` projection's launches (`lib/projection/operator.glsl`).
void attention_project_stage() { projection_dense_stage(); }
void attention_project_gemv1() { projection_segmented_gemv(1u); }
void attention_project_gemv2() { projection_segmented_gemv(2u); }
void attention_project_gemv4() { projection_segmented_gemv(4u); }
void attention_project_gemv8() { projection_segmented_gemv(8u); }
void attention_project_gemm() { projection_segmented_gemm(); }
