# Short convolution (LFM2 ShortConv) mixer: the gated causal depthwise
# convolution between the segmented input projection and the output
# projection.
#
# Projection column contract: `u (CH) | c (CH)` in F32, with u = B * X the
# product of the input projection's B and X segments and c its C segment.
# The product stays F32 into the convolution window, so it is not rounded
# before the tap sum.
#
# State contract: each short-convolution layer owns one arena,
# `window[S, C - 1 + T, CH] f32` (T >= 0, the planned speculative width).
# A bank holds the C - 1 rows of u before its state, then the rows of u of up
# to T rows past it; a version is (bank, j <= T): the bank advanced by its
# first j tape rows, whose window is rows [j, j + C - 1). The window rows are
# the whole tape: the layer has no other state. Slots, `stop` and the
# successor publication follow the gated-delta contract (recurrent.seismic):
# slot `b` reads version (`previous_bank[b]`, `previous_tape[b]`) and
# publishes to bank `following_bank[b]` the C - 1 rows before its first
# `stop[b]` rows' end, then the rows of the next t = min(T, rows - stop) rows
# (window rows past C - 1 + t are not written). An entry never writes a
# `previous_bank` row or bank 0, and successors are distinct.
#
# Output contract: `gated[M, CH] A` holds c * sum_tap w[ch, tap] u[row - (C -
# 1) + tap] per row, summed tap-ascending in F32 with no bias and no
# activation; rows outside every slot are zero. Every row is independent, so
# decode, verify and prefill are one computation.

fn short_conv_rows[M, B, S, CH, C, T](projection: &tensor[M, 2 * CH] f32,
    convolution: &tensor[CH, C] f32,
    segments: &tensor[B + 1, 2] i32, stop: &tensor[B] i32,
    previous_bank: &tensor[B] i32, previous_tape: &tensor[B] i32, following_bank: &tensor[B] i32,
    window: &slab mut tensor[S, C - 1 + T, CH] f32,
    slab_banks: u32) -> tensor[M, CH] A where T >= 0:
    let mut gated = tensor[M, CH] A
    for row in 0..M:
        for channel in 0..CH:
            gated[row, channel] = 0.0
    for slot in 0..B:
        let lo = segments[slot, 0]
        let hi = segments[slot, 1]
        let source = previous_bank[slot]
        let taped = previous_tape[slot]
        let target = following_bank[slot]
        let publish = lo + stop[slot]
        for row in 0..M:
            if row >= lo and row < hi:
                let local = row - lo
                for channel in 0..CH:
                    let mut sum = f32(0.0)
                    for tap in 0..C:
                        let mut value = f32(0.0)
                        if local + tap < C - 1:
                            value = window[source, taped + local + tap, channel]
                        else:
                            value = projection[lo + local + tap - (C - 1), channel]
                        sum = fma(convolution[channel, tap], value, sum)
                    gated[row, channel] = projection[row, CH + channel] * sum
        for tap in 0..C - 1 + T:
            if tap < C - 1 or publish + tap - (C - 1) < hi:
                for channel in 0..CH:
                    if stop[slot] + tap < C - 1:
                        window[target, tap, channel] = window[source, taped + stop[slot] + tap, channel]
                    else:
                        window[target, tap, channel] = projection[publish + tap - (C - 1), channel]
    return gated

# Metal: a thread per (channel, row) for grid y < M; grid y = M + b
# publishes slot b's successor window. The tap loop is the body's chain, so
# the bits match on every backend and row class.
native short_conv_rows for metal from "metal/short_conv_rows.metal":
    launch short_conv_rows:
        threadgroups (ceil_div(CH, 256), M + B, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA and Vulkan: the Metal items, visited by a grid-stride loop over y
# because both cap the y grid at 65535 groups.
native short_conv_rows for cuda from "cuda/short_conv_rows.cu":
    launch short_conv_rows:
        threadgroups (ceil_div(CH, 256), min(M + B, 65535), 1)
        threads_per_threadgroup (256, 1, 1)

native short_conv_rows for vulkan from "vulkan/short_conv_rows.comp":
    launch short_conv_rows:
        threadgroups (ceil_div(CH, 256), min(M + B, 65535), 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: work item r < M computes every channel of row r; work item M + b
# publishes slot b's successor window. Shared: the row's tap sums.
native short_conv_rows for cpu from "cpu/short_conv_rows.rs":
    launch short_conv_rows:
        threadgroups (M + B, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (CH * 4)

# LFM2's short-convolution input projection over every residual row: the RMS
# prologue, the B, C and X row ranges of `in_proj` (bound as three weights),
# and one F32 row per residual row, u = B ⊙ X in columns 0..CH and C in
# CH..2CH, both from the F32 accumulators (`short_conv_rows` consumes them
# unrounded).
fn short_conv_project[M, H, CH, BS, CS, XS](residual: &tensor[M, H] f32, norm: &tensor[H] NW,
    b_weight: &tensor[CH, H] BW, c_weight: &tensor[CH, H] CW,
    x_weight: &tensor[CH, H] XW, eps: f32, b_scale: &tensor[BS] f32,
    c_scale: &tensor[CS] f32, x_scale: &tensor[XS] f32) -> tensor[M, 2 * CH] f32 where BS >= 0 and CS >= 0 and XS >= 0 and BS <= 1 and CS <= 1 and XS <= 1 and operands(BW) == operands(CW) and operands(BW) == operands(XW):
    let mut normalized = tensor[M, H] A
    let mut b_sum = tensor[M, CH] f32
    let mut c_sum = tensor[M, CH] f32
    let mut x_sum = tensor[M, CH] f32
    let mut b = tensor[M, CH] f32
    let mut c = tensor[M, CH] f32
    let mut x = tensor[M, CH] f32
    let mut result = tensor[M, 2 * CH] f32
    rms_norm(residual, norm, normalized, eps)
    linear(normalized, b_weight, b_sum)
    linear(normalized, c_weight, c_sum)
    linear(normalized, x_weight, x_sum)
    scale_rows(b_sum, b_scale, b)
    scale_rows(c_sum, c_scale, c)
    scale_rows(x_sum, x_scale, x)
    parallel for row in 0..M:
        parallel for channel in 0..CH:
            result[row, channel] = b[row, channel] * x[row, channel]
            result[row, CH + channel] = c[row, channel]
    return result

# All backends: one segmented launch per row class, the u segment (the B and
# X streams paired, their F32 product) in the first threadgroups along x and
# the C segment (one stream, stored F32) after it; the CPU splits its row
# items the same way.
native short_conv_project for metal from "metal/short_conv_project.metal":
    static (H, CH, BS, CS, XS)
    params (arithmetic BATCH_FROM in [5, 3, 9, 2] default 5)
    where H > 0 and BS <= 1 and CS <= 1 and XS <= 1
    scratch normalized bytes (M * H * 2) when M > 16
    launch short_conv_project_normalize when M > 16:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch short_conv_project_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32] default 16, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32] default 16)
        threadgroups (2 * ceil_div(CH, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch short_conv_project_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32] default 8, BATCH_ROWS in [2, 1, 4] default 2)
        threadgroups (2 * ceil_div(CH, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch short_conv_project_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(CH, 32) + ceil_div(CH, 64), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch short_conv_project_gemm when M > 64:
        params (TILE_M in [64, 128, 32] default 64, TILE_N in [64, 128] default 64)
        threadgroups (ceil_div(CH, TILE_N / 2) + ceil_div(CH, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

native short_conv_project for vulkan from "vulkan/short_conv_project.comp":
    static (H, CH, BS, CS, XS)
    params (SIMDGROUPS in [16, 8, 4, 2, 32] default 16, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32] default 16,
            TILE_M in [128, 64, 32] default 64, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    let GEMV_GROUPS = 2 * ceil_div(CH, SIMDGROUPS * ROWS * 32 / LANES)
    let GEMV_THREADS = SIMDGROUPS * 32
    let GEMV_SHARED = 256 + 32 * operands(BW) + min(8 * ceil_div(H, 32), 288) * 72
    where H > 0 and SUB_M <= TILE_M and SUB_N <= TILE_N and BS <= 1 and CS <= 1 and XS <= 1
    scratch normalized bytes (M * H * 2) when M > 8
    launch short_conv_project_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch short_conv_project_gemv1 when M <= 1:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch short_conv_project_gemv2 when M == 2:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch short_conv_project_gemv4 when M >= 3 and M <= 4:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch short_conv_project_gemv8 when M >= 5 and M <= 8:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch short_conv_project_gemm when M > 8:
        threadgroups (ceil_div(CH, TILE_N / 2) + ceil_div(CH, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# `dense_expand`'s bands over two segments along x: u (the B and X streams
# paired) then C (one stream).
native short_conv_project for cuda from "cuda/short_conv_project.cu":
    static (H, CH, BS, CS, XS)
    params (arithmetic INT8 in [0, 1] default 0, arithmetic OPERAND in [0, 1] default 0)
    where H > 0 and H % 64 == 0 and BS <= 1 and CS <= 1 and XS <= 1 and (OPERAND == 0 or INT8 == 0) and (INT8 == 0 or (form(BW, INT8) == 1 and form(XW, INT8) == 1 and form(CW, INT8) == 1))
    scratch staged bytes (M * H * 2) when M > 1
    scratch groups bytes (M * H / 4) when INT8 == 1 and M > 16
    launch short_conv_project_stage when M > 1:
        reads (INT8, OPERAND)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch short_conv_project_gemv when M <= 8:
        params (arithmetic KSPLIT in [4, 2, 8] default 4)
        threadgroups (ceil_div(2 * ceil_div(CH, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, M - 1)) * H * 2)
    launch short_conv_project_gemv16 when M > 8 and M <= 16:
        params (arithmetic KSPLIT in [4, 2, 8] default 4)
        threadgroups (ceil_div(2 * ceil_div(CH, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch short_conv_project_gemm_small when M > 16 and M <= 64:
        reads (INT8, OPERAND)
        threadgroups (2 * ceil_div(ceil_div(CH, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 2 * 10240) + 2 * 2048)
    launch short_conv_project_gemm when M > 64:
        params (ROTATE in [2, 1, 4] default 2)
        reads (INT8, OPERAND)
        threadgroups (2 * ceil_div(ceil_div(CH, 16), 8), ceil_div(M, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 2 * 10240) + 2 * 2048)

native short_conv_project for cpu from "cpu/short_conv_project.rs":
    static (H, BS, CS, XS)
    params (ROWS in [8, 4, 2, 1] default 8, arithmetic form INT8 in [0, 1] default 0)
    where H > 0 and BS <= 1 and CS <= 1 and XS <= 1 and (INT8 == 0 or form(BW, INT8) == 1 or form(CW, INT8) == 1 or form(XW, INT8) == 1)
    scratch quantized bytes (M * ceil_div(H, Q8_VALUES) * Q8_BYTES)
    scratch normalized bytes (M * H * 4)
    launch short_conv_project_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch short_conv_project_rows:
        threadgroups (2 * ceil_div(CH, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
