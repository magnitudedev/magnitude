# Selected attention history (`HistoryReads::Selected`): the indexer of one
# attention layer keeps its raw keys and the keys of its finished blocks,
# scores each row's complete blocks and selects the rows attention reads.
#
# With W = 2P + S, H indexer heads and blocks of SB rows:
#   q[h]  = rotary(rms(query[h]) * query_norm, coordinates(row))
#   K[b]  = rotary(rms(mean(raw keys of block b)) * key_norm,
#                  coordinates(first row of b))
#   s[b]  = sum_h relu(q[h] . K[b]) / sqrt(W), heads ascending
# `rotary` turns half-split pairs over the leading 2P columns (`head_rotary`
# at `half_split`, RA = RT = 0); admission refuses a selected read of any other layout.
# The projected query and raw key arrive in the activation element A, as
# every projection's outputs do; from them on everything is F32 (the stored
# raw and block keys, the prepared queries, the scores) and nothing is
# rounded, as the F32 reference computes it.
# A row at position t has n = (t + 1) / SB complete blocks. While n <= K
# (`selected`) it reads every visible row (dense); past it the K best-scoring
# complete blocks (ties select the lower block) and its tail, the rows
# [n SB, t].
#
# State contract: the raw keys, each with its row's rotary coordinates, live
# in a Window(SB - 1) history domain (`window_keys`, `window_coordinates`),
# the finished block keys in a Block(SB) history domain (`block_keys`), all
# history slab planes of the layer. Every row appends its raw key and
# coordinates at `window_destinations[row]`. A row that completes a block
# (block_destinations[row] >= 0) reads its block's SB raw keys: the last
# SB - 1 rows of its window spans `window_visible[row]` (the raw keys of the
# SB - 1 positions before it, this launch's appended first), then its own.
# It appends the block key at `block_destinations[row]`, rotated at the
# coordinates stored with the block's first raw key.
#
# A row's complete blocks are the block rows of its spans
# `block_visible[row]`, in block order, its own block among them when it
# completes one: block b is the b-th of them (blocks completed by this
# launch's rows are read after they are appended).
# A row's keys are the rows of its attention spans `visible[row]`, then its
# fresh rows (which attention reads itself), in position order: key o is at
# position o, so block b holds keys [b SB, (b + 1) SB).
#
# Read forms. A class that scores (B > 0) emits each row's block bitmap over
# 32 B blocks: bit b of word b / 32 is set when the row reads block b's keys
# (a dense row reads every block, a selecting row its selected blocks and
# every block from its tail's on); every complete block of a row is one of
# the 32 B. The class without scoring (B = C = 0) only appends.
# - WorkList (prefill rows): the bitmap. The attention entry applies it as a
#   key mask and lists, per row group, the key tiles some row of the group
#   reads.
# - Segments (decode rows, C > 0 as well): the rows of the row's visible
#   spans it reads, as [start, end) runs in key order, each within one slab
#   of `slab_rows` rows, then empty runs. Attention reads its fresh rows
#   itself, so they must lie in the row's tail (a decode row's fresh rows
#   are itself alone; its launch's earlier rows are visible spans).
#   C >= K + 1 + R holds every run: the read blocks form at most K + 1 runs
#   of keys, split further only where a visible span ends (spans never
#   cross a slab edge).
# `block_slots`, `segment_slots` and `bitmap_words` hold no values: their
# extents are the rows of a block SB, a row's segments C and its bitmap
# words B.
fn indexer_select[M, TW, TB, H, P, S, SB, R, C, B](
    query: &tensor[M, H, 2 * P + S] A, key: &tensor[M, 2 * P + S] A,
    query_norm: &tensor[1, 2 * P + S] f32, key_norm: &tensor[1, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32, coordinates: &tensor[M, 4] i32,
    window_visible: &tensor[M, R, 2] i32, window_destinations: &tensor[M] i32,
    block_visible: &tensor[M, R, 2] i32, block_destinations: &tensor[M] i32,
    visible: &tensor[M, R, 2] i32,
    block_slots: &tensor[0, SB] i32, segment_slots: &tensor[0, C] i32,
    bitmap_words: &tensor[0, B] u32,
    window_keys: &mut tensor[TW, 2 * P + S] f32, window_coordinates: &mut tensor[TW, 4] i32,
    block_keys: &mut tensor[TB, 2 * P + S] f32,
    selected: i32, epsilon: f32, slab_rows: u32, window_slab_rows: u32, block_slab_rows: u32)
    -> (tensor[M, C, 2] i32, tensor[M, B] u32)
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and H >= 1 and SB >= 1 and C >= 0 and B >= 0:
    let half_split = tensor[0, 0, 0, 0] i32
    # Raw keys first: a completing row reads raw keys of earlier rows.
    for row in 0..M:
        if window_destinations[row] >= 0:
            for column in 0..2 * P + S:
                window_keys[window_destinations[row], column] = f32(key[row, column])
            window_coordinates[window_destinations[row]] = coordinates[row]
    # Finished blocks, before any row scores them.
    for row in 0..M:
        if block_destinations[row] >= 0:
            # The block's raw-key rows: the last SB - 1 window rows, then
            # the row's own.
            let mut members = tensor[SB] i32
            for member in 0..SB:
                members[member] = window_destinations[row]
            let mut earlier = 0
            for span in 0..R:
                if window_visible[row, span, 1] > window_visible[row, span, 0]:
                    earlier = earlier + window_visible[row, span, 1] - window_visible[row, span, 0]
            let mut ordinal = 0
            for span in 0..R:
                let first = window_visible[row, span, 0]
                let last = window_visible[row, span, 1]
                if first >= 0 and last >= first:
                    for window_row in first..last:
                        let member = ordinal - (earlier - (SB - 1))
                        if member >= 0 and member < SB - 1:
                            members[member] = i32(window_row)
                        ordinal = ordinal + 1
            let mut sum = tensor[2 * P + S] f32
            for column in 0..2 * P + S:
                sum[column] = 0.0
            for member in 0..SB:
                for column in 0..2 * P + S:
                    sum[column] = sum[column] + window_keys[members[member], column]
            let mut mean = tensor[2 * P + S] f32
            for column in 0..2 * P + S:
                mean[column] = sum[column] / f32(SB)
            let mut finished = tensor[2 * P + S] f32
            finished[:] = head_rotary(mean, key_norm, window_coordinates[members[0]],
                rotary_components, rotary_frequencies, rotary_amplitudes, half_split, epsilon)
            block_keys[block_destinations[row]] = finished
    let mut segments = tensor[M, C, 2] i32
    let mut selection = tensor[M, B] u32
    for row in 0..M:
        for entry in 0..C:
            segments[row, entry, 0] = 0
            segments[row, entry, 1] = 0
        for word in 0..B:
            selection[row, word] = u32(0)
    if B > 0:
        for row in 0..M:
            let mut prepared = tensor[H, 2 * P + S] f32
            for head in 0..H:
                prepared[head] = head_rotary(query[row, head], query_norm, coordinates[row],
                    rotary_components, rotary_frequencies, rotary_amplitudes, half_split, epsilon)
            # The row's complete blocks, in block order, scored.
            let mut complete = 0
            for span in 0..R:
                if block_visible[row, span, 1] > block_visible[row, span, 0]:
                    complete = complete + block_visible[row, span, 1] - block_visible[row, span, 0]
            let mut scores = tensor[32 * B] f32
            let mut physical = tensor[32 * B] i32
            for block in 0..32 * B:
                physical[block] = 0
            let mut ordinal = 0
            for span in 0..R:
                let first = block_visible[row, span, 0]
                let last = block_visible[row, span, 1]
                if first >= 0 and last >= first:
                    for block_row in first..last:
                        if ordinal >= 0 and ordinal < 32 * B:
                            physical[ordinal] = i32(block_row)
                        ordinal = ordinal + 1
            for block in 0..32 * B:
                scores[block] = 0.0
                if block < complete:
                    let mut score = f32(0.0)
                    for head in 0..H:
                        let mut dot = f32(0.0)
                        for column in 0..2 * P + S:
                            dot = fma(prepared[head, column],
                                block_keys[physical[block], column], dot)
                        score = score + max(dot, 0.0)
                    scores[block] = score / sqrt(f32(2 * P + S))
            # Read blocks: every block while dense, else the K best (score
            # descending, block ascending) and the tail's block.
            let mut reads = tensor[32 * B + 1] i32
            for block in 0..32 * B + 1:
                reads[block] = 1
            for block in 0..32 * B:
                if complete > selected and block < complete:
                    let mut better = 0
                    for other in 0..32 * B:
                        if other < complete:
                            if scores[other] > scores[block] or (scores[other] == scores[block] and other < block):
                                better = better + 1
                    if better >= selected:
                        reads[block] = 0
            for word in 0..B:
                for bit in 0..32:
                    let block = word * 32 + bit
                    if block > 32 * B:
                        selection[row, word] = selection[row, word] | (u32(1) << u32(bit))
                    else:
                        if reads[block] != 0:
                            selection[row, word] = selection[row, word] | (u32(1) << u32(bit))
            if C > 0:
                # The row's keys in position order, read where its blocks are.
                let mut count = 0
                let mut open = 0
                let mut start = 0
                let mut end = 0
                let mut position = 0
                for span in 0..R:
                    let lo = visible[row, span, 0]
                    let hi = visible[row, span, 1]
                    if lo >= 0 and hi >= lo:
                        for at in lo..hi:
                            let stored = i32(at)
                            let block = min(max(position, 0) / SB, 32 * B)
                            if reads[block] != 0:
                                if open == 1 and stored == end and stored % i32(slab_rows) != 0:
                                    end = end + 1
                                else:
                                    if open == 1 and count < C:
                                        segments[row, count, 0] = start
                                        segments[row, count, 1] = end
                                        count = count + 1
                                    open = 1
                                    start = stored
                                    end = stored + 1
                            else:
                                if open == 1 and count < C:
                                    segments[row, count, 0] = start
                                    segments[row, count, 1] = end
                                    count = count + 1
                                open = 0
                            position = position + 1
                if open == 1 and count < C:
                    segments[row, count, 0] = start
                    segments[row, count, 1] = end
    return segments, selection

# Metal, CUDA and Vulkan: `append` (a threadgroup per row), `complete` (a
# simdgroup per row that completes a block), then in a class that scores
# `score` (a threadgroup per 32 blocks of a row, so B of them, the row's
# query heads prepared in threadgroup memory, a simdgroup per 4 blocks with
# their key loads in flight together) and `select` (a
# threadgroup of 256 threads per row). `select` finds the K-th best score by
# a radix select over the scores' bits (which order as the non-negative
# scores do): each pass's histogram takes one atomic per distinct digit of a
# simdgroup, and the digit is found by a parallel scan of the bins. It marks
# the bitmap in block order (the equal scores ranked by a scan of each
# thread's count), then, for Segments, emits the runs: the row's span
# offsets are scanned into scratch, each thread counts the runs starting in
# its share of the keys, and a scan of the counts places each run.
# Threadgroup memory: the bins [256], the scans' 8 simdgroup sums and the
# select state [4].
# Scratch: the scores of every row's complete blocks and, for Segments, each
# row's span offsets [R + 1].
native indexer_select for metal from "metal/indexer_select.metal":
    static (H, P, S, SB)
    where (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and H <= 8
    scratch scores bytes (M * 32 * B * 4) when B > 0
    scratch spans bytes (M * (R + 1) * 4) when C > 0
    launch indexer_select_append:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (128, 1, 1)
    launch indexer_select_complete:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (32, 1, 1)
    launch indexer_select_score when B > 0:
        threadgroups (B, M, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (H * (2 * P + S) * 4)
    launch indexer_select_select when B > 0:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((256 + 8 + 4) * 4)

native indexer_select for cuda from "cuda/indexer_select.cu":
    static (H, P, S, SB)
    where (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and H <= 8
    scratch scores bytes (M * 32 * B * 4) when B > 0
    scratch spans bytes (M * (R + 1) * 4) when C > 0
    launch indexer_select_append:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (128, 1, 1)
    launch indexer_select_complete:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (32, 1, 1)
    launch indexer_select_score when B > 0:
        threadgroups (B, M, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (H * (2 * P + S) * 4)
    launch indexer_select_select when B > 0:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((256 + 8 + 4) * 4)

native indexer_select for vulkan from "vulkan/indexer_select.comp":
    static (H, P, S, SB)
    where (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and H <= 8
    scratch scores bytes (M * 32 * B * 4) when B > 0
    scratch spans bytes (M * (R + 1) * 4) when C > 0
    launch indexer_select_append:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (128, 1, 1)
    launch indexer_select_complete:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (32, 1, 1)
    launch indexer_select_score when B > 0:
        threadgroups (B, M, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (H * (2 * P + S) * 4)
    launch indexer_select_select when B > 0:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((256 + 8 + 4) * 4)

# CPU: `append` and `complete` per row, then `select` per row (prepare,
# score, select, emit) in a class that scores.
native indexer_select for cpu from "cpu/indexer_select.rs":
    scratch scores bytes (M * 32 * B * 4) when B > 0
    launch indexer_select_append:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch indexer_select_complete:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * P + 3 * (2 * P + S)) * 4)
    launch indexer_select_select when B > 0:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * P + (H + 1) * (2 * P + S)) * 4)

# The general indexer (`Selection::Own(Indexer)`), as three entries over the
# key plane of a pooled source: `indexer_keys` writes the keys of the rows a
# producer completes, `indexer_score` scores a row list, `rows_topk` selects
# from it. With W = 2P + S, H query heads and the rotary of the reading
# attention in its layout (RA, RT; `rotate_pairs`):
#   K[u]    = rounding(rotary(RMS(key[u]) * key_norm, coordinates(u)))
#   q[h]    = rounding(rotary(norm(query[h]), coordinates(t)))
#   s[t, j] = scale * sum_h relu(q[h] . K[row j]) * w[h], heads ascending
# with w[h] = head_weights[t, h] (HW = H) or 1 (HW = 0, Uniform), each dot an
# ascending F32 FMA chain. Everything from the projections on is F32; the
# rounding is the indexer's trained one (rounding.seismic's four scalars),
# from the norm and rotation held in A where it rounds (`rounded_head_rotary`).
# The key plane holds F32 keys: an unrounded indexer's keys (Qwen4's) are
# its F32 reference's, and a rounded one's codes are exact in it.

# The key of each row that completes a unit (`latent_rows[row] >= 0`, the
# key-plane row written: the pooled source's row, whose Block domain the key
# plane shares), from its projected key `key[row]` (the key projection of the
# producer's pre-rotary latent), normed by `key_norm`, rotated at
# `coordinates[row]` (those of the unit's first token) and rounded.
fn indexer_keys[M, TB, P, S, RA, RT](key: &tensor[M, 2 * P + S] A,
    key_norm: &tensor[1, 2 * P + S] f32, latent_rows: &tensor[M] i32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32, coordinates: &tensor[M, 4] i32,
    keys: &mut tensor[TB, 2 * P + S] f32, form: &host tensor[0, RA, RT] i32,
    epsilon: f32, block: i32, element: i32, scale: i32, amax_floor: f32, slab_rows: u32)
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and RA >= 0 and RA <= 1 and RT >= 0 and RT <= 1:
    let layout = tensor[0, RA, RT, 0] i32
    for row in 0..M:
        if latent_rows[row] >= 0:
            let mut prepared = tensor[2 * P + S] f32
            let mut held = tensor[2 * P + S] A
            prepared[:] = rounded_head_rotary(key[row], key_norm, coordinates[row],
                rotary_components, rotary_frequencies, rotary_amplitudes, layout, epsilon,
                block, element, scale, amax_floor, held)
            keys[latent_rows[row]] = prepared

# Each row's scores over its row list: score j is the j-th key-plane row of
# its spans `spans[row]` (in span order; S4's narrowed lists are row lists
# too), the rest of its N scores -inf. The query heads are normed with
# `query_norm` (NQ = 1, or none) before their rotary at the row's
# coordinates. `score_slots` holds no values: its extent is the scores N.
fn indexer_score[M, H, P, S, NQ, HW, TB, R, N, RA, RT](query: &tensor[M, H, 2 * P + S] A,
    query_norm: &tensor[NQ, 2 * P + S] f32, head_weights: &tensor[M, HW] A,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32, coordinates: &tensor[M, 4] i32,
    keys: &tensor[TB, 2 * P + S] f32, spans: &tensor[M, R, 2] i32,
    score_slots: &tensor[0, N] i32, form: &host tensor[0, RA, RT] i32,
    scale: f32, epsilon: f32, block: i32, element: i32, rounding_scale: i32, amax_floor: f32,
    slab_rows: u32) -> tensor[M, N] f32
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and H >= 1 and NQ >= 0 and NQ <= 1 and HW >= 0 and (HW == 0 or HW == H) and N >= 0 and RA >= 0 and RA <= 1 and RT >= 0 and RT <= 1:
    let layout = tensor[0, RA, RT, 0] i32
    let mut scores = tensor[M, N] f32
    for row in 0..M:
        for j in 0..N:
            scores[row, j] = -inf
        let mut prepared = tensor[H, 2 * P + S] f32
        let mut held = tensor[2 * P + S] A
        for head in 0..H:
            prepared[head] = rounded_head_rotary(query[row, head], query_norm, coordinates[row],
                rotary_components, rotary_frequencies, rotary_amplitudes, layout, epsilon,
                block, element, rounding_scale, amax_floor, held)
        let mut ordinal = 0
        for span in 0..R:
            let first = spans[row, span, 0]
            let last = spans[row, span, 1]
            if first >= 0 and last >= first:
                for at in first..last:
                    if ordinal < N:
                        let mut score = f32(0.0)
                        for head in 0..H:
                            let mut dot = f32(0.0)
                            for column in 0..2 * P + S:
                                dot = fma(prepared[head, column], keys[at, column], dot)
                            let mut weight = f32(1.0)
                            if HW > 0:
                                weight = f32(head_weights[row, head])
                            score = score + max(dot, 0.0) * weight
                        scores[row, ordinal] = scale * score
                    ordinal = ordinal + 1
    return scores

# Each row's picks from its scores: the key-plane rows (of its spans, as in
# `indexer_score`) it reads, ascending by position (span order), -1 padded.
# A row with `complete[row]` complete units at most K reads every row of its
# spans (the first K); past it, the K best of its scored rows, score
# descending with ties to the lower ordinal (the lower unit). A row's scored
# rows are the first min(N, rows of its spans). Rows are indexed by class
# row. `top_slots` holds no values: its extent is the picks K.
fn rows_topk[M, N, R, K](scores: &tensor[M, N] f32, complete: &tensor[M] i32,
    spans: &tensor[M, R, 2] i32, top_slots: &tensor[0, K] i32) -> tensor[M, K] i32
    where N >= 0 and K >= 0:
    let mut selected = tensor[M, K] i32
    for row in 0..M:
        for pick in 0..K:
            selected[row, pick] = -1
        let mut count = 0
        for span in 0..R:
            if spans[row, span, 1] > spans[row, span, 0]:
                count = count + spans[row, span, 1] - spans[row, span, 0]
        let scored = min(count, i32(N))
        let dense = complete[row] <= i32(K)
        let mut picks = 0
        let mut ordinal = 0
        for span in 0..R:
            let first = spans[row, span, 0]
            let last = spans[row, span, 1]
            if first >= 0 and last >= first:
                for at in first..last:
                    if ordinal < scored:
                        let mut read = 1
                        if not dense:
                            let mut better = 0
                            for other in 0..N:
                                if i32(other) < scored:
                                    if scores[row, other] > scores[row, ordinal] or (scores[row, other] == scores[row, ordinal] and i32(other) < ordinal):
                                        better = better + 1
                            if better >= i32(K):
                                read = 0
                        if read == 1 and picks < i32(K):
                            selected[row, picks] = i32(at)
                            picks = picks + 1
                    ordinal = ordinal + 1
    return selected

# Metal: a simdgroup per row, lane l holding columns [l E, (l + 1) E)
# (E = W / 32), normed, rotated and rounded across the simdgroup.
native indexer_keys for metal from "metal/indexer_keys.metal":
    static (P, S, RA, RT)
    where RA <= 1 and RT <= 1 and (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and (RA == 0 or (2 * P + S) % 64 == 0 or 2 * P + S == 32)
    launch indexer_keys:
        threadgroups (ceil_div(M, 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per row.
native indexer_keys for cpu from "cpu/indexer_keys.rs":
    static (P, S, RA, RT)
    where RA <= 1 and RT <= 1
    launch indexer_keys:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * P + 2 * (2 * P + S)) * 4)

# Metal: a threadgroup per (256 scores, row). Its simdgroups prepare the
# row's H query heads into threadgroup memory (as `indexer_keys` prepares a
# key), then each thread scores one row of the list, every head's dot an
# ascending FMA chain over the columns it streams once.
native indexer_score for metal from "metal/indexer_score.metal":
    static (H, P, S, NQ, HW, RA, RT)
    where RA <= 1 and RT <= 1 and NQ <= 1 and H <= 64 and H * (2 * P + S) <= 7168 and (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and (RA == 0 or (2 * P + S) % 64 == 0 or 2 * P + S == 32)
    launch indexer_score:
        threadgroups (ceil_div(N, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (H * (2 * P + S) * 4)

# CPU: one work item per (256 scores, row), each preparing the row's query
# heads.
native indexer_score for cpu from "cpu/indexer_score.rs":
    static (H, P, S, NQ, HW, RA, RT)
    where RA <= 1 and RT <= 1 and NQ <= 1
    launch indexer_score:
        threadgroups (ceil_div(N, 256), M, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * P + (H + 1) * (2 * P + S)) * 4)

# Metal: a threadgroup of 256 threads per row. A selecting row finds its
# K-th best score T by a radix select over the scores' order keys
# (`ordered_key`), takes every score above T and the first equal ones in
# ordinal order, then emits its picks in ordinal order: each thread counts
# the picks of its share of the ordinals, a scan places them, and a walk of
# the row's span offsets (scanned into scratch) maps each to its row.
# Threadgroup memory: the bins [256], the scans' 8 simdgroup sums and the
# select state [4].
native rows_topk for metal from "metal/rows_topk.metal":
    scratch spans bytes (M * (R + 1) * 4)
    launch rows_topk:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((256 + 8 + 4) * 4)

# CPU: one work item per row, a partial sort of its scored ordinals.
native rows_topk for cpu from "cpu/rows_topk.rs":
    launch rows_topk:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# The candidate pool (`Candidates::Produce`): per row, the blocks of BU
# consecutive units that a restricted indexer over the same rows scores
# (`Candidates::Restrict`), from the row's own scores over its list
# (`indexer_score`). A row's list over a Block read holds its c complete
# units in order (`complete[row]`), so ordinal j is unit j, and block b
# holds the units [b BU, (b + 1) BU):
#   score(b)           = max over b's units j < c of s[j]
#   score((c - 1) / BU) = +inf     (the newest block, which may be partial)
# then the B best blocks, ties to the lower block: `rows_topk` over each
# row's block list [0, ceil(c / BU)) with the row's complete units c (a row
# with c <= B takes every block). `candidate_rows` lists the picked blocks'
# rows.
#
# `candidate_blocks` scores the blocks: `blocks` [M, NB], -inf past the
# row's ceil(c / BU) blocks, and the row's block list [M, 1, 2],
# [0, ceil(c / BU)). `block_slots` holds no values: its extent is the
# blocks NB; `form` carries BU, which no tensor extent determines.
fn candidate_blocks[M, N, NB, BU](scores: &tensor[M, N] f32, complete: &tensor[M] i32,
    block_slots: &tensor[0, NB] i32, form: &host tensor[0, BU] i32)
    -> (tensor[M, NB] f32, tensor[M, 1, 2] i32)
    where BU >= 1 and NB >= 1 and NB * BU >= N:
    let mut blocks = tensor[M, NB] f32
    let mut lists = tensor[M, 1, 2] i32
    for row in 0..M:
        let units = max(min(complete[row], i32(N)), 0)
        let count = (units + i32(BU) - 1) / i32(BU)
        lists[row, 0, 0] = 0
        lists[row, 0, 1] = count
        for block in 0..NB:
            let mut score = -inf
            if i32(block) < count:
                for unit in block * BU..(block + 1) * BU:
                    if unit < N:
                        if i32(unit) < units:
                            score = max(score, scores[row, unit])
                if i32(block) == count - 1:
                    score = inf
            blocks[row, block] = score
    return blocks, lists

# The candidate rows of each row: the units of its picked blocks
# `blocks[row]` (`rows_topk`'s picks over its block list: ascending, -1
# padded) below its c listed units, and while those are fewer than
# min(K, c), the lowest other units up to min(K, c). A restricted indexer
# with top K masks every score outside the picked blocks to -inf and takes
# its K best, the equal ones by the lower unit, so a pool of fewer than K
# rows is filled with the lowest rows outside it; listing them makes its K
# best of the list exactly those. Units are the list's ordinals (its spans
# `spans[row]`, as in `indexer_score`), emitted as spans of the same plane
# rows in unit order: each maximal run of taken units within one span, then
# [-1, -1]. The picked blocks and the fill form at most B + 1 runs (the
# fill exists only when B blocks are picked: fewer take every unit), split
# further only where a list span ends, so B + R spans hold them. `form`
# carries BU and K, which no tensor extent determines.
fn candidate_rows[M, R, B, BU, K](blocks: &tensor[M, B] i32, spans: &tensor[M, R, 2] i32,
    form: &host tensor[0, BU, K] i32) -> tensor[M, B + R, 2] i32
    where BU >= 1:
    let mut pool = tensor[M, B + R, 2] i32
    for row in 0..M:
        for entry in 0..B + R:
            pool[row, entry, 0] = -1
            pool[row, entry, 1] = -1
        let mut units = 0
        for span in 0..R:
            if spans[row, span, 0] >= 0 and spans[row, span, 1] > spans[row, span, 0]:
                units = units + spans[row, span, 1] - spans[row, span, 0]
        let mut pooled = 0
        for pick in 0..B:
            let block = blocks[row, pick]
            if block >= 0:
                pooled = pooled + max(min(units, (block + 1) * i32(BU)) - block * i32(BU), 0)
        let fill = max(min(i32(K), units) - pooled, 0)
        let mut outside = 0
        let mut count = 0
        let mut ordinal = 0
        for span in 0..R:
            let first = spans[row, span, 0]
            let last = spans[row, span, 1]
            if first >= 0 and last >= first:
                let mut open = 0
                for at in first..last:
                    let mut taken = 0
                    for pick in 0..B:
                        if blocks[row, pick] >= 0 and blocks[row, pick] == ordinal / i32(BU):
                            taken = 1
                    if taken == 0:
                        if outside < fill:
                            taken = 1
                        outside = outside + 1
                    # At most B + R runs (above): the guards only bound
                    # the indices.
                    if taken == 1:
                        if open == 0:
                            if count >= 0 and count < B + R:
                                pool[row, count, 0] = i32(at)
                            count = count + 1
                            open = 1
                        if count >= 1 and count <= B + R:
                            pool[row, count - 1, 1] = i32(at) + 1
                    else:
                        open = 0
                    ordinal = ordinal + 1
    return pool

# CPU: one work item per row.
native candidate_blocks for cpu from "cpu/candidate_blocks.rs":
    launch candidate_blocks:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Metal: a threadgroup per (256 blocks, row), a thread per block.
native candidate_blocks for metal from "metal/candidate_blocks.metal":
    launch candidate_blocks:
        threadgroups (ceil_div(NB, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per row, walking its picked blocks and its spans once.
native candidate_rows for cpu from "cpu/candidate_rows.rs":
    launch candidate_rows:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Metal: a thread per row, walking its picked blocks and its spans once, as
# the CPU native does.
native candidate_rows for metal from "metal/candidate_rows.metal":
    launch candidate_rows:
        threadgroups (ceil_div(M, 64), 1, 1)
        threads_per_threadgroup (64, 1, 1)
