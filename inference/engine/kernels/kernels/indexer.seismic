# Vulkan: as Metal, a workgroup of 256 invocations per row; group memory the
# scans' subgroup sums, X and the row's span offsets, R + 1 of at most 65
# (the contract's bound on R, which Vulkan fixes when the kernel is prepared).
native candidate_rows for vulkan from "vulkan/candidate_rows.comp":
    launch candidate_rows:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((8 + 2 + 65) * 4)
