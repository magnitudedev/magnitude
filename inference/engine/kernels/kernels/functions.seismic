# Functions shared by entries. Natives evaluate the same expressions (the
# pointwise ones in `<backend>/lib/core/functions.*`).

# Feed-forward activation by code:
#   0  SiLU       a / (1 + exp(-a))
#   1  GELU-tanh  a / (1 + exp(-2u)), u = √(2/π) (a + 0.044715 a³): the stable
#                 form of 0.5 a (1 + tanh u), with no tanh primitive
#   2  ReLU²      max(a, 0)²
# The output dtype owns the publication.
fn activate[M, N](x: &tensor[M, N] T, result: &mut tensor[M, N] U, function: i32):
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            let a = f32(x[rows, cols])
            let mut value = a / (1.0 + exp(-a))
            if function == 1:
                let u = 0.7978845608028654 * (a + 0.044715 * (a * a * a))
                value = a / (1.0 + exp(-2.0 * u))
            if function == 2:
                let r = max(a, 0.0)
                value = r * r
            result[rows, cols] = value

# The gated expansion, the one formula of every gate/up pair (dense, routed
# and shared experts) and of its natives (the projection library's `Glu`
# epilogue): with `gate` and `up` the F32 accumulators times their scales,
# published in A, result = A(A(act(min(gate, L))) * clamp(up, -L, L))
# (`activate`'s codes; L = `limit`). The clamp is written `x > L ? L : x`
# (and `x < -L ? -L : x`), so a NaN stays NaN and L = inf is the identity,
# which every unclamped caller passes (DeepSeek V4.1's `swiglu_limit`: the
# gate above only, up on both sides, in F32 before the activation).
fn glu[M, N](gate: &tensor[M, N] A, up: &tensor[M, N] A, result: &mut tensor[M, N] A, function: i32,
    limit: f32):
    let mut clamped = tensor[M, N] f32
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            let mut g = f32(gate[rows, cols])
            if g > limit:
                g = limit
            clamped[rows, cols] = g
    activate(clamped, result, function)
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            let mut u = f32(up[rows, cols])
            if u > limit:
                u = limit
            if u < -limit:
                u = -limit
            result[rows, cols] = f32(result[rows, cols]) * u

# A projection entry's input rows, rounded to the result's element: the
# RMS-normalized residual (`N = H`, `P = 1`), or the sum in part order of the
# `P` per-stream partials a hyper-connection mix site publishes (`N = 0`, no
# norm). Natives form either in the projection library's prologue
# (`<backend>/lib/projection`).
fn form_input[M, H, P, N](hidden: &tensor[M, P * H] f32, norm: &tensor[N] T,
    result: &mut tensor[M, H] U, epsilon: f32) where N >= 0 and ((N == H and P == 1) or (N == 0 and P >= 1)):
    if N == 0:
        sum_parts(hidden, result)
    else:
        rms_norm(hidden[:, 0:H], norm[0:H], result, epsilon)

fn sum_parts[M, H, P](parts: &tensor[M, P * H] f32, result: &mut tensor[M, H] U):
    parallel for row in 0..M:
        parallel for column in 0..H:
            let mut sum = f32(0.0)
            for part in 0..P:
                sum = sum + parts[row, part * H + column]
            result[row, column] = sum

# A sublayer's output `y` joining the residual: `residual + y` (`IN = 0`, one
# stream), or `residual[s] + y · inject[s]` for each of the `SN`
# hyper-connection streams (`IN = SN`, the inject values of the sublayer's mix
# site), or `Σ_s comb[s, d] · residual[s] + y · inject[d]` (`IN = SN + SN²`:
# the inject values, then the site's `[SN, SN]` comb, source stream major).
# Absent, the comb is the identity. Natives apply it as the projection
# library's output epilogue.
fn scatter[M, D, SN, IN](residual: &tensor[M, SN * D] f32, y: &tensor[M, D] T,
    inject: &tensor[M, IN] f32, result: &mut tensor[M, SN * D] f32)
    where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1) or (IN == SN + SN * SN and SN >= 1)):
    # Every stream is written: stream s < IN scales `y` by its inject value
    # (`IN >= SN`); the one stream of `IN = 0` adds `y` itself.
    parallel for row in 0..M:
        parallel for stream in 0..SN:
            parallel for column in 0..D:
                let mut joined = f32(y[row, column])
                if stream < IN:
                    joined = joined * inject[row, stream]
                let mut mixed = residual[row, stream * D + column]
                if IN > SN:
                    mixed = f32(0.0)
                    for source in 0..SN:
                        mixed = mixed + inject[row, SN + source * SN + stream] * residual[row, source * D + column]
                result[row, stream * D + column] = mixed + joined

# A gated delta net's output gate on z, by code (natives in
# `<backend>/lib/core/functions.*`):
#   0  SiLU      z / (1 + exp(-z))
#   1  sigmoid   1 / (1 + exp(-z))
fn output_gate(z: f32, function: i32) -> f32:
    let mut value = z / (1.0 + exp(-z))
    if function == 1:
        value = 1.0 / (1.0 + exp(-z))
    return value

# A weight's second-level scale (NVFP4 `.scale`) on F32 projections, then
# published in U: result = x * scale[0] for a present port (S = 1), x
# unscaled for an absent one (S = 0). Every entry that reads packed weights
# takes one such port per weight (`<weight>_scale`, per tensor [S] or per
# expert [S, E]), applied to the accumulator before any epilogue.
fn scale_rows[M, N, S](x: &tensor[M, N] f32, scale: &tensor[S] f32, result: &mut tensor[M, N] U) where S >= 0 and S <= 1:
    let mut factor = f32(1.0)
    if S == 1:
        factor = scale[0]
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            result[rows, cols] = x[rows, cols] * factor

# The output-head transform. Bounds transform their two endpoints with this
# same monotone operation; exact survivors publish it before token selection.
fn cap_logit(z: f32, softcap: f32) -> f32:
    let mut result = z
    if softcap > 0.0:
        result = softcap * (2.0 / (1.0 + exp(-2.0 * z / softcap)) - 1.0)
    return result

# The order of every expert selection (`rank_choices` and `select_experts`):
# each row's values ranked, a NaN as -inf (in place), then its K distinct
# experts by descending ranked value with ties to the higher expert, rank r
# stored at slot K - 1 - r. Ranked values are totally ordered, so every rank
# names an expert, whatever the row holds.
fn rank_experts[M, E, K](values: &mut tensor[M, E] f32, routes: &mut tensor[M, K] i32):
    for row in 0..M:
        let mut open = tensor[E] f32
        let mut taken = tensor[E] i32
        for expert in 0..E:
            if values[row, expert] != values[row, expert]:
                values[row, expert] = -inf
            open[expert] = values[row, expert]
            taken[expert] = 0
        for rank in 0..K:
            # A taken expert holds -inf, so the maximum is an open expert's.
            let best = reduce(open, 0, max)
            let mut candidates = tensor[E] i32
            for expert in 0..E:
                candidates[expert] = -1
                if taken[expert] == 0 and open[expert] == best:
                    candidates[expert] = i32(expert)
            let winner = reduce(i32(candidates), 0, max)
            routes[row, K - 1 - rank] = winner
            for expert in 0..E:
                if i32(expert) == winner:
                    open[expert] = -inf
                    taken[expert] = 1

# Each row's K choices from its router logits: probabilities are the softmax
# over every expert, the winners ranked by `rank_experts`, each choice's
# score its ranked probability.
fn rank_choices[M, E, K](logits: &tensor[M, E] f32, routes: &mut tensor[M, K] i32,
    scores: &mut tensor[M, K] f32):
    let mut probabilities = tensor[M, E] f32
    for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let exponentials = exp(values - maximum)
        let total = reduce(exponentials, 0, sum)
        for expert in 0..E:
            probabilities[row, expert] = exponentials[expert] / total
    rank_experts(probabilities, routes)
    for row in 0..M:
        for choice in 0..K:
            scores[row, choice] = probabilities[row, routes[row, choice]]

# The general routed form's selection order (`routed_select` and its hints):
# each row's scores s[e] = score(logit[e]) into `scores` (0 softmax over all
# E, 1 sigmoid, 2 sqrt(softplus)), then its K choices ranked on s[e] + bias[e]
# (the selection-only bias; a family without one binds zeros) by
# `rank_experts`.
fn select_experts[M, E, K](logits: &tensor[M, E] f32, bias: &tensor[E] f32, score: i32,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, E] f32):
    let mut ranked = tensor[M, E] f32
    for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let exponentials = exp(values - maximum)
        let total = reduce(exponentials, 0, sum)
        for expert in 0..E:
            let logit = logits[row, expert]
            let mut s = exponentials[expert] / total
            if score == 1:
                s = 1.0 / (1.0 + exp(-logit))
            if score == 2:
                s = sqrt(max(logit, 0.0) + log(1.0 + exp(-abs(logit))))
            scores[row, expert] = s
            ranked[row, expert] = s + bias[expert]
    rank_experts(ranked, routes)

# Decode routing with the shared expert, the reference body of
# `routed_route_shared` and `routed_route_streamed` (routed.seismic): the
# normalized rows, each row's K choices (`rank_choices`) and their scores,
# normalized when `normalize` is set and scaled by `expert_scale` when
# ES > 0, the shared gate's coefficient, and the shared expert's SiLU `glu`.
fn route_shared[M, H, PT, NM, E, K, S, ES](residual: &tensor[M, PT * H] f32,
    norm: &tensor[NM] NW, router: &tensor[E, H] RW, shared_router: &tensor[H] f32,
    shared_gate: &tensor[S, H] SGW, shared_up: &tensor[S, H] SUW,
    eps: f32, normalize: i32, expert_scale: &tensor[ES] f32,
    routes: &mut tensor[M, K] i32, scores: &mut tensor[M, K] f32,
    normalized: &mut tensor[M, H] A, coefficient: &mut tensor[M] f32,
    shared_product: &mut tensor[M, S] A)
    where NM >= 0 and ((NM == H and PT == 1) or (NM == 0 and PT >= 1)) and ES >= 0 and (ES == 0 or ES == E) and operands(RW) == 0 and operands(SGW) == operands(SUW):
    let mut logits = tensor[M, E] f32
    let mut gates = tensor[M, S] A
    let mut ups = tensor[M, S] A
    form_input(residual, norm, normalized, eps)
    linear(normalized, router, logits)
    rank_choices(logits, routes, scores)
    for row in 0..M:
        if normalize != 0:
            let denominator = reduce(f32(scores[row]), 0, sum)
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] / denominator
        if ES > 0:
            for choice in 0..K:
                scores[row, choice] = scores[row, choice] * expert_scale[routes[row, choice]]
        let shared_logit = reduce(f32(normalized[row]) * f32(shared_router), 0, sum)
        coefficient[row] = 1.0 / (1.0 + exp(-shared_logit))
        let mut gate_row = tensor[H] f32
        let mut up_row = tensor[H] f32
        operand_row(normalized[row], operands(shared_gate), gate_row)
        operand_row(normalized[row], operands(shared_up), up_row)
        for feature in 0..S:
            let mut gate = f32(0.0)
            let mut up = f32(0.0)
            for source in 0..H:
                gate = fma(gate_row[source], f32(shared_gate[feature, source]), gate)
                up = fma(up_row[source], f32(shared_up[feature, source]), up)
            gates[row, feature] = gate
            ups[row, feature] = up
    glu(gates, ups, shared_product, 0, inf)
