# Metal, CUDA, Vulkan: one threadgroup of 256 threads per row reduces each
# candidate's rank-R score. CPU: one work item per row.
native draft_path_step for metal from "metal/draft_path_step.metal":
    launch draft_path_step:
        threadgroups (S, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_path_step for cuda from "cuda/draft_path_step.cu":
