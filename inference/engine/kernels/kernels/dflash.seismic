        threads_per_threadgroup (1, 1, 1)

native draft_gated_rows for metal from "metal/draft_gated_rows.metal":
    launch draft_gated_rows:
        threadgroups (ceil_div(M * F, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_gated_rows for cuda from "cuda/draft_gated_rows.cu":
