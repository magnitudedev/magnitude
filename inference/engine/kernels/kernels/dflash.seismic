# Metal, CUDA, Vulkan: one threadgroup of 256 threads per row, K rounds of a
# (value, token) arg-max reduction. CPU: one work item per row.
native draft_top_k for metal from "metal/draft_top_k.metal":
    launch draft_top_k:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_top_k for cuda from "cuda/draft_top_k.cu":
