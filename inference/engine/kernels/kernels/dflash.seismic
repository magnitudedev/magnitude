# Separate draft models (DFlash, DSpark). The draft's layers, its readout and
# its selection reuse the decoder's attention, feed-forward, readout and
# sampling entries; these entries own the only draft-specific equations.

# One tap of the target residual stream: the residual rows entering a tapped
# block (or leaving the last one), rounded to A, into the tap's column block
# `index[0]` of the concatenated draft input rows `[M, T·D]`. The readout
# fuses those rows with one projection (`project_rows`). The tap index is a
# run input, so tapped blocks of one shape share their sealed graphs.
fn tap_rows[M, D, T](residual: &tensor[M, D] f32, index: &tensor[1] i32,
    taps: &mut tensor[M, T * D] A):
    parallel for row in 0..M:
        for column in 0..D:
            taps[row, index[0] * D + column] = residual[row, column]

# Metal: one thread per copied element on a (column, row) grid; Apple GPUs
# emulate 64-bit division, which a flat index would need per element.
native tap_rows for metal from "metal/tap_rows.metal":
    launch tap_rows:
        threadgroups (ceil_div(D, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: one thread per copied element.
native tap_rows for cuda from "cuda/tap_rows.cu":
    launch tap_rows:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: a grid-stride loop over every element; the x grid is capped at the
# 65535-group floor (Vulkan spec §5.3).
native tap_rows for vulkan from "vulkan/tap_rows.comp":
    launch tap_rows:
        threadgroups (min(ceil_div(M * D, 256), 65535), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per row.
native tap_rows for cpu from "cpu/tap_rows.rs":
    launch tap_rows:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)


# The fused taps of the rows the readout publishes (`out_rows`), rounded to
# A: a separate draft's conditioning features. The draft normalizes them
# itself (its context projections read RMS(features) * fusion norm).
fn feature_rows[M, O, D](fused: &tensor[M, D] f32, out_rows: &tensor[O] i32) -> tensor[O, D] A:
    let mut features = tensor[O, D] A
    parallel for row in 0..O:
        parallel for column in 0..D:
            features[row, column] = fused[out_rows[row], column]
    return features

# Metal: one thread per copied element on a (column, row) grid (see
# `tap_rows`).
native feature_rows for metal from "metal/feature_rows.metal":
    launch feature_rows:
        threadgroups (ceil_div(D, 256), O, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: one thread per copied element.
native feature_rows for cuda from "cuda/feature_rows.cu":
    launch feature_rows:
        threadgroups (ceil_div(O * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: a grid-stride loop over every element; the x grid is capped at the
# 65535-group floor (Vulkan spec §5.3).
native feature_rows for vulkan from "vulkan/feature_rows.comp":
    launch feature_rows:
        threadgroups (min(ceil_div(O * D, 256), 65535), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per output row.
native feature_rows for cpu from "cpu/feature_rows.rs":
    launch feature_rows:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (1, 1, 1)


# Activation rows widened to F32: a prompt chunk's conditioning features,
# read on the device by the drafter entry drafted behind the chunk (the host
# path widens the same rounded rows).
fn widen_rows[M, D](rows: &tensor[M, D] A) -> tensor[M, D] f32:
    let mut widened = tensor[M, D] f32
    parallel for row in 0..M:
        parallel for column in 0..D:
            widened[row, column] = f32(rows[row, column])
    return widened

# Metal: one thread per element on a (column, row) grid (see `tap_rows`).
native widen_rows for metal from "metal/widen_rows.metal":
    launch widen_rows:
        threadgroups (ceil_div(D, 256), M, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: one thread per element.
native widen_rows for cuda from "cuda/widen_rows.cu":
    launch widen_rows:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: a grid-stride loop over every element; the x grid is capped at the
# 65535-group floor (Vulkan spec §5.3).
native widen_rows for vulkan from "vulkan/widen_rows.comp":
    launch widen_rows:
        threadgroups (min(ceil_div(M * D, 256), 65535), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per row.
native widen_rows for cpu from "cpu/widen_rows.rs":
    launch widen_rows:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)


# DSpark's confidence of one drafted slot per row:
# sigmoid(weight · [features ; memory] + bias), where `features` is the
# slot's output-normed row and `memory` the Markov embedding of the token the
# slot conditions on. A row whose confidence is below `threshold` declines
# its proposal: its selection status becomes 3 (its token stays, so a chained
# step still embeds it; the host keeps proposals up to the first nonzero
# status).
fn draft_confidence[S, D, R](features: &tensor[S, D] A, memory: &tensor[S, R] A,
    weight: &tensor[D + R] f32, bias: &tensor[1] f32, threshold: f32,
    selection: &mut tensor[S, 2] i32):
    parallel for row in 0..S:
        let hidden = sum_any_order(f32(features[row]) * weight[0 : D])
        let markov = sum_any_order(f32(memory[row]) * weight[D : D + R])
        let score = hidden + markov + bias[0]
        if 1.0 / (1.0 + exp(-score)) < threshold:
            selection[row, 1] = 3

# Metal, CUDA, Vulkan: one threadgroup of 256 threads per row reduces the
# dot product.
native draft_confidence for metal from "metal/draft_confidence.metal":
    launch draft_confidence:
        threadgroups (S, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_confidence for cuda from "cuda/draft_confidence.cu":
    launch draft_confidence:
        threadgroups (S, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_confidence for vulkan from "vulkan/draft_confidence.comp":
    launch draft_confidence:
        threadgroups (S, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)

# CPU: one work item per row.
native draft_confidence for cpu from "cpu/draft_confidence.rs":
    launch draft_confidence:
        threadgroups (S, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((D + R) * 4)


# DFlash2's grouped dynamic causal convolution over the rows of each draft
# block (`block` rows; a row's block position is `row % block`). The hidden
# width is G coefficient groups of C channels; a row's coefficient
# projection is viewed [2, K, G]. Half 0 convolves a sublayer's normed input
# rows:
#   out[r, g·C + c] = sum over o < K, o <= r % block of
#                     (base[0, o, g·C + c] + dynamic[r, 0, o, g]) · input[r − o, g·C + c]
fn draft_convolve_input[M, G, C, K](input: &tensor[M, G * C] A,
    dynamic: &tensor[M, 2, K, G] f32, base: &tensor[2, K, G * C] f32,
    block: u32) -> tensor[M, G * C] A:
    let mut result = tensor[M, G * C] A
    parallel for row in 0..M:
        parallel for group in 0..G:
            for lane in 0..C:
                let column = group * C + lane
                let position = row % block
                let mut sum = f32(0.0)
                for offset in 0..K:
                    if offset <= position and offset <= row:
                        let coefficient = base[0, offset, column] + dynamic[row, 0, offset, group]
                        sum = fma(coefficient, f32(input[row - offset, column]), sum)
                result[row, column] = sum
    return result

# Half 1 convolves the sublayer's F32 output rows with the same rows'
# second-half coefficients and adds the residual:
#   out[r, g·C + c] = residual[r, g·C + c] + sum over o < K, o <= r % block of
#                     (base[1, o, g·C + c] + dynamic[r, 1, o, g]) · output[r − o, g·C + c]
fn draft_convolve_residual[M, G, C, K](residual: &tensor[M, G * C] f32,
    output: &tensor[M, G * C] f32, dynamic: &tensor[M, 2, K, G] f32,
    base: &tensor[2, K, G * C] f32, block: u32) -> tensor[M, G * C] f32:
    let mut result = tensor[M, G * C] f32
    parallel for row in 0..M:
        parallel for group in 0..G:
            for lane in 0..C:
                let column = group * C + lane
                let position = row % block
                let mut sum = f32(0.0)
                for offset in 0..K:
                    if offset <= position and offset <= row:
                        let coefficient = base[1, offset, column] + dynamic[row, 1, offset, group]
                        sum = fma(coefficient, output[row - offset, column], sum)
                result[row, column] = residual[row, column] + sum
    return result

# A draft feed-forward's gated product silu(gate) · up of its projected rows,
# rounded once to A.
fn draft_gated_rows[M, F](gate: &tensor[M, F] A, up: &tensor[M, F] A) -> tensor[M, F] A:
    let mut result = tensor[M, F] A
    parallel for row in 0..M:
        parallel for column in 0..F:
            let a = f32(gate[row, column])
            result[row, column] = a / (1.0 + exp(-a)) * f32(up[row, column])
    return result

# DFlash2's candidates: each row's K highest logits in descending order (a tie
# keeps the lower token first), as (token, 0) rows `[M · K, 2]` an embedding
# gather reads directly, and their logits.
fn draft_top_k[M, V, K](logits: &tensor[M, V] f32, candidates: &mut tensor[M * K, 2] i32,
    unary: &mut tensor[M, K] f32):
    for row in 0..M:
        let mut remaining = tensor[V] f32
        for token in 0..V:
            remaining[token] = logits[row, token]
        for rank in 0..K:
            let best = reduce(remaining, 0, max)
            let mut chosen = i32(0)
            let mut found = i32(0)
            for token in 0..V:
                if found == 0 and remaining[token] == best:
                    chosen = i32(token)
                    found = 1
            candidates[row * K + rank, 0] = chosen
            candidates[row * K + rank, 1] = 0
            unary[row, rank] = best
            remaining[chosen] = -inf

# One ordered step of DFlash2's candidate path over S rows: each row selects
# the candidate k maximizing
#   unary[s, k] + sum_r predecessor[s, r] · hidden[s, r] · successor[s·K + k, r]
# (the first on ties), where `predecessor` embeds the token the row follows
# and `hidden` is the row's selector projection. The selection (token, 0)
# becomes the next step's predecessor.
fn draft_path_step[S, K, R](candidates: &tensor[S * K, 2] i32, unary: &tensor[S, K] f32,
    hidden: &tensor[S, R] A, predecessor: &tensor[S, R] A, successor: &tensor[S * K, R] A,
    selection: &mut tensor[S, 2] i32):
    parallel for row in 0..S:
        let mut best = -inf
        let mut chosen = candidates[row * K, 0]
        for candidate in 0..K:
            let mut score = f32(0.0)
            for rank in 0..R:
                let joint = f32(predecessor[row, rank]) * f32(hidden[row, rank])
                score = fma(joint, f32(successor[row * K + candidate, rank]), score)
            score = score + unary[row, candidate]
            if score > best:
                best = score
                chosen = candidates[row * K + candidate, 0]
        selection[row, 0] = chosen
        selection[row, 1] = 0

# Metal, CUDA: one thread per output element. Vulkan: a grid-stride loop over
# every element, the x grid capped at the 65535-group floor. CPU: one work
# item per row.
native draft_convolve_input for metal from "metal/draft_convolve_input.metal":
    launch draft_convolve_input:
        threadgroups (ceil_div(M * G * C, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_convolve_input for cuda from "cuda/draft_convolve_input.cu":
    launch draft_convolve_input:
        threadgroups (ceil_div(M * G * C, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_convolve_input for vulkan from "vulkan/draft_convolve_input.comp":
    launch draft_convolve_input:
        threadgroups (min(ceil_div(M * G * C, 256), 65535), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_convolve_input for cpu from "cpu/draft_convolve_input.rs":
    launch draft_convolve_input:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (G * C * 8)

native draft_convolve_residual for metal from "metal/draft_convolve_residual.metal":
    launch draft_convolve_residual:
        threadgroups (ceil_div(M * G * C, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_convolve_residual for cuda from "cuda/draft_convolve_residual.cu":
    launch draft_convolve_residual:
        threadgroups (ceil_div(M * G * C, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native draft_convolve_residual for vulkan from "vulkan/draft_convolve_residual.comp":
