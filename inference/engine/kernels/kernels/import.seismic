# Weight import over the [B, N, K] view of a weight: B leading matrices of N
# rows of K values (a rank-2 weight is [1, N, K], a rank-1 weight [1, 1, K]).

# Dense import between every qualified dense source/destination representation.
fn import_dense[B, N, K](source: &tensor[B, N, K] E) -> tensor[B, N, K] U:
    let mut destination = tensor[B, N, K] U
    parallel for b in 0..B:
        for n in 0..N:
            for k in 0..K:
                destination[b, n, k] = f32(source[b, n, k])
    return destination

native import_dense for metal from "metal/import_dense.metal":
    launch import_dense:
        threadgroups (ceil_div(B * N * K, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native import_dense for cuda from "cuda/import_dense.cu":
    launch import_dense:
        threadgroups (ceil_div(B * N * K, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)


# The packing bound of a resident [N, K] weight (`WeightPlan::bound`): per run
# of the K / R columns that share a scale, the largest sum over one row's run
# of (code - centre)^2, an exact integer held in F32. Codes are the
# registry's integer codes; a representation with negative codes is centred at
# zero, an unsigned one at half its code range. The packed projection forms
# certify their activation gains against it (`metal/lib/projection/packing.h`),
# which only Metal has.
fn packing_bound[N, K, R](weight: &tensor[N, K] W, bound: &mut tensor[R] f32) where R > 0 and K % R == 0:
    parallel for run in 0..R:
        let first = run * (K / R)
        let low = quantized_code_min(weight, 0, first)
        let mut centre = i32(0)
        if low >= 0:
            centre = (quantized_code_max(weight, 0, first) + 1) / 2
        let mut largest = i32(0)
        for n in 0..N:
            let mut squares = i32(0)
            for c in 0..K / R:
                let centred = quantized_code(weight, n, first + c) - centre
                squares = squares + centred * centred
            largest = max(largest, squares)
        bound[run] = f32(largest)

# Metal: the format's packed codes (`projection::packing_codes`), one
# threadgroup per 32-column block, its threads taking rows in turn; R is the
# block's runs per 32 columns.
native packing_bound for metal from "metal/packing_bound.metal":
    launch packing_bound:
        threadgroups (K / 32, 1, 1)
        threads_per_threadgroup (256, 1, 1)


# The registered exact conversion of an external GGUF source into resident
# storage U = (representation, layout); the grid covers every stored column
# of every k-quant packet. Each backend's launch below gives the tile one
# threadgroup converts.
fn repack_weight[B, N, K](source: &tensor[B, N, K] E) -> tensor[B, N, K] U:
    return repack[U = U](source)

# Metal: each threadgroup (32 threads) converts one 16-row by 32-column tile;
# the grid covers whole 32-row tiles, which `rows32` stores in full.
native repack_weight for metal from "metal/repack_weight.metal":
    launch repack_weight:
        threadgroups (ceil_div(K, 256) * 8, ceil_div(N, 32) * 2, B)
        threads_per_threadgroup (32, 1, 1)

# CUDA: each threadgroup, one warp, converts one 16-row by 32-column tile, a
# lane per row (the other 16 lanes help stage and store), so it runs one
# stream of compile-time record words.
native repack_weight for cuda from "cuda/repack_weight.cu":
    launch repack_weight:
        threadgroups (ceil_div(K, 256) * 8, ceil_div(N, 16), B)
        threads_per_threadgroup (32, 1, 1)

# CPU: each work item converts one eight-row tile within one [N, K]
# matrix. This tile is the physical write unit of interleaved rows8 storage.
native repack_weight for cpu from "cpu/repack_weight.rs":
    launch repack_weight:
        threadgroups (ceil_div(N, 8), B, 1)
        threads_per_threadgroup (1, 1, 1)

# Vulkan: a grid-stride loop over every element; the x grid is capped at the
# 65535-group floor (Vulkan spec §5.3).
native import_dense for vulkan from "vulkan/import_dense.comp":
    launch import_dense:
        threadgroups (min(ceil_div(B * N * K, 256), 65535), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: each work item decodes 16 source rows of the [B, N, K] view to F32
# (its private bytes) and stores them rounded to U.
native import_dense for cpu from "cpu/import_dense.rs":
    launch import_dense:
        threadgroups (ceil_div(B * N, 16), 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (K * 4)

# Vulkan: one workgroup converts one 16-row by 32-column tile into rows16 (the
# Vulkan resident layout). N / 16 stays below 65535 for every model weight
# (the largest, the 248320-row head, gives 15520).
native repack_weight for vulkan from "vulkan/repack_weight.comp":
    launch repack_weight:
        threadgroups (ceil_div(K, 256) * 8, ceil_div(N, 16), B)
        threads_per_threadgroup (32, 1, 1)
