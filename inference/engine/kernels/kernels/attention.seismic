# One head row in F32, RMS-normalized with weight row `wt[0]` when N = 1;
# N = 0 leaves it as is.
fn head_norm[W, N](x: &tensor[W] A, wt: &tensor[N, W] f32, epsilon: f32) -> tensor[W] f32
    where N >= 0:
    let xf = f32(x)
    let mut normalized = zeros_like(x, dtype=f32)
    for i in 0..W:
        normalized[i] = xf[i]
    for weight in 0..N:
        let inv = rsqrt(sum_any_order(xf * xf) / f32(W) + epsilon)
        for i in 0..W:
            normalized[i] = xf[i] * inv * wt[weight, i]
    return normalized

# One query or key head row in F32: `head_norm`, then its first 2P columns
# rotated by the rotary tables at the row's coordinates.
fn head_rotary[P, S, N](x: &tensor[2 * P + S] A, wt: &tensor[N, 2 * P + S] f32,
    coordinates: &tensor[4] i32, components: &tensor[P] i32,
    frequencies: &tensor[P] f32, amplitudes: &tensor[P] f32, epsilon: f32)
    -> tensor[2 * P + S] f32 where P >= 0 and S >= 0 and 2 * P + S >= 1 and N >= 0:
    let normalized = head_norm(x, wt, epsilon)
    let mut rotated = zeros_like(x, dtype=f32)
    for i in 0..2 * P + S:
        if i < 2 * P:
            let pair = i % P
            let angle = f32(coordinates[components[pair]]) * frequencies[pair]
            let c = cos(angle) * amplitudes[pair]
            let s = sin(angle) * amplitudes[pair]
            if i < P:
                rotated[i] = normalized[i] * c - normalized[i + P] * s
            else:
                rotated[i] = normalized[i] * c + normalized[i - P] * s
        else:
            rotated[i] = normalized[i]
    return rotated

# One output column times its gate: sigmoid (gate_function 0) or softplus (1)
# of the gate value.
fn gated_column(attended: f32, gate: f32, gate_function: i32) -> f32:
    let mut result = attended / (1.0 + exp(-gate))
    if gate_function != 0:
        result = attended * (max(gate, 0.0) + log(1.0 + exp(-abs(gate))))
    return result

# One query head's attended row times its output gates: its I interleaved
# gate values when I > 0, else its U separate ones; column c takes value c
# modulo their count. No gates pass the row through.
fn gate_row[W, I, U](attended: &tensor[W] f32, interleaved: &tensor[I] A,
    separate: &tensor[U] A, gate_function: i32) -> tensor[W] f32 where I >= 0 and U >= 0:
    let mut result = zeros_like(attended, dtype=f32)
    for column in 0..W:
        result[column] = attended[column]
    if I > 0:
        for column in 0..W:
            result[column] = gated_column(attended[column], f32(interleaved[column % I]),
                gate_function)
    else:
        if U > 0:
            for column in 0..W:
                result[column] = gated_column(attended[column], f32(separate[column % U]),
                    gate_function)
    return result

fn attention_rows[M, T, KV, G, P, S, I, U, F, N, NV, R](
    query: &tensor[M, KV * G, 2 * P + S + I] A, gate: &tensor[M, KV * G, U] A,
    key: &tensor[F, M, KV * (2 * P + S)] A, value: &tensor[F, M, KV * (2 * P + S)] A,
    query_norm: &tensor[N, 2 * P + S] f32, key_norm: &tensor[N, 2 * P + S] f32,
    value_norm: &tensor[NV, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    epsilon: f32, scale: f32, gate_function: i32) -> tensor[M, KV * G, 2 * P + S] A
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and I >= 0 and U >= 0 and F >= 0 and N >= 0 and NV >= 0:
    let mut fresh_key = tensor[F, M, KV, 2 * P + S] A
    let mut fresh_value = tensor[F, M, KV, 2 * P + S] A
    for layer in 0..F:
        for row in 0..M:
            for head in 0..KV:
                fresh_key[layer, row, head] = head_rotary(
                    key[layer, row, head * (2 * P + S) : (head + 1) * (2 * P + S)], key_norm,
                    coordinates[row], rotary_components, rotary_frequencies,
                    rotary_amplitudes, epsilon)
                fresh_value[layer, row, head] = head_norm(
                    value[layer, row, head * (2 * P + S) : (head + 1) * (2 * P + S)],
                    value_norm, epsilon)
    let mut result = tensor[M, KV * G, 2 * P + S] A
    for row in 0..M:
        for kv_head in 0..KV:
            let mut qt = tensor[G, 2 * P + S] A
            let mut maximum = tensor[G] f32
            let mut denominator = tensor[G] f32
            let mut accumulator = tensor[G, 2 * P + S] f32
            for head in 0..G:
                qt[head] = head_rotary(query[row, kv_head * G + head, 0 : 2 * P + S],
                    query_norm, coordinates[row], rotary_components, rotary_frequencies,
                    rotary_amplitudes, epsilon)
                maximum[head] = -inf
                denominator[head] = 0.0
                for column in 0..2 * P + S:
                    accumulator[head, column] = 0.0
            for span in 0..R:
                let lo = visible[row, span, 0]
                let hi = visible[row, span, 1]
                if hi > lo:
                    attention_update(qt, history_key[lo : hi, kv_head],
                        history_value[lo : hi, kv_head], maximum, denominator,
                        accumulator, scale)
            let fresh_lo = fresh[row, 0]
            let fresh_hi = fresh[row, 1]
            for layer in 0..F:
                if fresh_hi > fresh_lo:
                    attention_update(qt, fresh_key[layer, fresh_lo : fresh_hi, kv_head],
                        fresh_value[layer, fresh_lo : fresh_hi, kv_head], maximum,
                        denominator, accumulator, scale)
            for head in 0..G:
                let mut attended = tensor[2 * P + S] f32
                for column in 0..2 * P + S:
                    attended[column] = accumulator[head, column] / max(denominator[head], 1e-30)
                let gated = gate_row(attended,
                    query[row, kv_head * G + head, 2 * P + S : 2 * P + S + I],
                    gate[row, kv_head * G + head], gate_function)
                for column in 0..2 * P + S:
                    result[row, kv_head * G + head, column] = gated[column]
    for layer in 0..F:
        for row in 0..M:
            if destinations[row] >= 0:
                for head in 0..KV:
                    history_key[destinations[row], head] = fresh_key[layer, row, head]
                    history_value[destinations[row], head] = fresh_value[layer, row, head]
    return result

# Decode rows (M <= 8). L1: one threadgroup per (kv head, partition, row). A
# row's visible keys (spans in order, then its fresh span) split into
# consecutive partitions (with a SPAN minimum on Metal and Vulkan, so a short
# row still spreads over several partitions and a long one over all PARTS).
# The query group splits into SLICES slices; each simdgroup scans a
# contiguous sub-range of the partition for its slice's heads, so each K/V
# row is read once per slice. Partition 0 also appends the row's K/V. L2: per
# (query head, row), a fixed-order LSE merge of the row's partitions and the
# output gate.
fn attention_decode[M, T, KV, G, P, S, I, U, F, N, NV, R](
    query: &tensor[M, KV * G, 2 * P + S + I] A, gate: &tensor[M, KV * G, U] A,
    key: &tensor[F, M, KV * (2 * P + S)] A, value: &tensor[F, M, KV * (2 * P + S)] A,
    query_norm: &tensor[N, 2 * P + S] f32, key_norm: &tensor[N, 2 * P + S] f32,
    value_norm: &tensor[NV, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    epsilon: f32, scale: f32, gate_function: i32, slab_rows: u32)
    -> tensor[M, KV * G, 2 * P + S] A
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and I >= 0 and U >= 0 and F >= 0 and N >= 0 and NV >= 0:
    return attention_rows(query, gate, key, value, query_norm, key_norm, value_norm,
        rotary_components, rotary_frequencies, rotary_amplitudes, coordinates, visible,
        fresh, destinations, history_key, history_value, epsilon, scale, gate_function)

# Metal: partitions of max(SPAN, ceil(keys / PARTS)) keys; each simdgroup
# holds the G / SLICES query heads of its slice, W / 32 columns per lane.
# (CUDA: equal partitions.) MATRIX selects the grouped-query matrix form, as
# `attention_decode_k8v4`'s: keys enter the score product in the activation
# dtype, values the output product as F16.
native attention_decode for metal from "metal/attention_decode.metal":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic SPAN in [32, 64, 128, 256], arithmetic PARTS in [16, 8, 32, 64, 128, 256, 512],
        arithmetic SIMDS in [4, 8, 2, 16], arithmetic SLICES in [1, 2, 4, 8],
        arithmetic form MATRIX in [0, 1], arithmetic KEYS in [16, 8, 32], arithmetic TOKENS in [1, 2, 4, 8])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and G % SLICES == 0 and SIMDS % SLICES == 0 and (MATRIX == 1 or (KEYS == 16 and TOKENS == 1)) and (MATRIX == 1 or SIMDS * (G / SLICES) * 8 + max(SIMDS * (2 * P + S) * 4, G * (2 * P + S) * 2) <= 32768) and (MATRIX == 0 or SLICES == 1) and (MATRIX == 0 or ((2 * P + S) % max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128) == 0 and ((2 * P + S) / max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128)) % 32 == 0 and SIMDS % max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128) == 0 and ceil_div(TOKENS * G, 8) * 8 * (2 * P + S) * 2 + max(SIMDS * KEYS * (((2 * P + S) / max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128)) + 8) * 2 + min(1, max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128) - 1) * 2 * SIMDS * ceil_div(TOKENS * G, 8) * 8 * KEYS * 4, ceil_div(TOKENS * G, 8) * 8 * (2 * P + S) * 4) + SIMDS / max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128) * ceil_div(TOKENS * G, 8) * 8 * 8 <= 32768))
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch attention_decode_partial:
        threadgroups (KV, PARTS, ceil_div(M, TOKENS))
        threads_per_threadgroup (SIMDS * 32, 1, 1)
        shared_bytes ((1 - MATRIX) * (SIMDS * (G / SLICES) * 8 + max(SIMDS * (2 * P + S) * 4, G * (2 * P + S) * 2)) + MATRIX * (ceil_div(TOKENS * G, 8) * 8 * (2 * P + S) * 2 + max(SIMDS * KEYS * (((2 * P + S) / max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128)) + 8) * 2 + min(1, max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128) - 1) * 2 * SIMDS * ceil_div(TOKENS * G, 8) * 8 * KEYS * 4, ceil_div(TOKENS * G, 8) * 8 * (2 * P + S) * 4) + SIMDS / max(1, ceil_div(TOKENS * G, 8) * (2 * P + S) / 128) * ceil_div(TOKENS * G, 8) * 8 * 8))
    launch attention_decode_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: split-KV decode over PARTS equal partitions per (kv head, row); WARPS
# warps per block scan contiguous slices of the partition, a warp holding one
# head vector at W / 32 dimensions per lane. (Metal: partitions with a SPAN
# minimum.) MATRIX selects the grouped-query matrix form: the prefill's
# tensor-core body (`lib/attention/prefill.cuh`) over row tiles of WARPS * 16 / G
# rows, whose query heads are the rows of m16n8k16 products, COLUMNS warps per
# 16-row block sharing its scores and splitting its output columns (one pass
# for heads up to 256 COLUMNS wide); each partition
# takes an equal run of 32-key tiles (16 for heads wider than 256) through
# STAGES operand stages (few blocks per SM need deeper pipelines than
# prefill's two). Its threadgroup memory is the prefill's at STAGES stages
# plus a [WARPS * COLUMNS][W] F32 exchange for the in-block query and
# fresh-key preparation.
native attention_decode for cuda from "cuda/attention_decode.cu":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic PARTS in [12, 24, 48, 96], arithmetic WARPS in [4, 8, 1, 2],
        arithmetic SLICES in [1, 2, 4, 8], arithmetic form MATRIX in [0, 1],
        arithmetic STAGES in [2, 3, 4], arithmetic COLUMNS in [1, 2, 4])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0 and G % SLICES == 0 and WARPS % SLICES == 0 and (MATRIX == 1 or (WARPS >= 4 and STAGES == 2 and COLUMNS == 1)) and (MATRIX == 1 or (G + WARPS) * (2 * P + S) * 4 + WARPS * (G / SLICES) * 8 <= 98304) and (MATRIX == 0 or (SLICES == 1 and G <= WARPS * 16 and min((2 * P + S), 256 * COLUMNS) % (16 * COLUMNS) == 0 and ((2 * P + S) <= 256 or (2 * P + S) % 256 == 0) and (WARPS * 16 * (2 * P + S) + STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min((2 * P + S), 256) + min((2 * P + S), 256 * COLUMNS))) * 2 + WARPS * COLUMNS * (2 * P + S) * 4 <= 98304))
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch attention_decode_partial:
        threadgroups (KV, PARTS, (1 - MATRIX) * M + MATRIX * ceil_div(M, max(1, WARPS * 16 / G)))
        threads_per_threadgroup (COLUMNS * WARPS * 32, 1, 1)
        shared_bytes ((1 - MATRIX) * ((G + WARPS) * (2 * P + S) * 4 + WARPS * (G / SLICES) * 8) + MATRIX * ((WARPS * 16 * (2 * P + S) + STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min((2 * P + S), 256) + min((2 * P + S), 256 * COLUMNS))) * 2 + WARPS * COLUMNS * (2 * P + S) * 4 + (R + 1) * 16))
    launch attention_decode_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# Vulkan: the Metal form (`vulkan/lib/attention/attention.glsl`), the G query
# heads split into SLICES slices across subgroups. A lane owns W / 32
# contiguous columns, with a whole number of lanes per rotary half.
# MATRIX selects the grouped-query matrix form: the prefill's cooperative-matrix
# L2 (`vulkan/lib/attention/prefill.glsl` with PREFILL_DECODE) over row tiles of
# 16 * SIMDS / G rows, whose query heads are the matrix rows; each partition
# takes an equal run of 32-key tiles. Shared bytes: the prefill's, then the
# query tile [16 * SIMDS][W + 8] f16.
native attention_decode for vulkan from "vulkan/attention_decode.comp":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic SPAN in [32, 64, 128, 256], arithmetic PARTS in [16, 8, 32, 64, 128, 256, 512],
        arithmetic SIMDS in [4, 8, 1, 2], arithmetic SLICES in [1, 2, 4, 8],
        arithmetic form MATRIX in [0, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and G % SLICES == 0 and SIMDS % SLICES == 0 and (MATRIX == 1 or SIMDS >= 4) and (MATRIX == 1 or SIMDS * (G / SLICES) * 8 + max(SIMDS, ceil_div(G, 2)) * (2 * P + S) * 4 <= 32768) and (MATRIX == 0 or (SLICES == 1 and SPAN == 32 and G <= SIMDS * 16 and ((2 * P + S) <= 64 or (2 * P + S) % 64 == 0) and ((2 * P + S) <= 256 or (2 * P + S) % 256 == 0) and 64 * (min((2 * P + S), 256) + 8) + SIMDS * 2048 + SIMDS * 16 * ((2 * P + S) + 8) * 2 <= 32768))
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch attention_decode_partial:
        threadgroups (KV, PARTS, (1 - MATRIX) * M + MATRIX * ceil_div(M, max(1, SIMDS * 16 / G)))
        threads_per_threadgroup (SIMDS * 32, 1, 1)
        shared_bytes ((1 - MATRIX) * (SIMDS * (G / SLICES) * 8 + max(SIMDS, ceil_div(G, 2)) * (2 * P + S) * 4) + MATRIX * (64 * (min((2 * P + S), 256) + 8) + SIMDS * 2048 + SIMDS * 16 * ((2 * P + S) + 8) * 2))
    launch attention_decode_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CPU (`cpu/lib/attention/attention.rs`): `prepare` per row (queries, and the
# keys and values of a layer with fresh rows, into F32 scratch; the K/V
# append), `attend` per (kv head, partition, row) over partitions of max(128,
# ceil(keys / PARTS)) keys, `merge` per row (the fixed-order partition merge
# and the output gates).
native attention_decode for cpu from "cpu/attention_decode.rs":
    static (P, S, I, U, F, N, NV)
    params (arithmetic PARTS in [8, 4, 16, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1
    scratch queries bytes (M * KV * G * (2 * P + S) * 4)
    scratch keys bytes (M * KV * (2 * P + S) * 4)
    scratch values bytes (M * KV * (2 * P + S) * 4)
    scratch partials bytes (M * KV * PARTS * G * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * PARTS * G * 8)
    launch attention_decode_prepare:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (P * 8)
    launch attention_decode_attend:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((G * 32 + 2 * P + S) * 4)
    launch attention_decode_merge:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * P + S) * 4)


# Prefill rows (M >= 16). L1 prepares queries, and for a layer with fresh rows
# keys and values (activation dtype), into scratch and appends K/V at each
# row's destination; query rows are padded with zeros to whole query tiles.
# L2: streaming attention per (query tile, kv head, key partition); the tile's
# tokens x G query heads are the matrix rows. Each visible span, then the
# fresh span, is staged over the union of the tile rows' intervals in K/V
# tiles; per-row masks apply only to tiles outside the rows' common interval.
# Queries and probabilities enter the products in a 16-bit operand dtype;
# scores, the softmax state and the output are F32. The key tiles split into
# consecutive runs of at least 16 tiles over up to max(1, ceil(SPLIT_GROUPS /
# (tiles * KV))) partitions, so a long history fills the device and a short
# one runs unsplit. A tile served by one partition stores its gated output
# directly; otherwise L3 merges the partitions' (partial output, maximum,
# denominator) in partition order with the decode merge rule and applies the
# gate.
fn attention_prefill[M, T, KV, G, P, S, I, U, F, N, NV, R](
    query: &tensor[M, KV * G, 2 * P + S + I] A, gate: &tensor[M, KV * G, U] A,
    key: &tensor[F, M, KV * (2 * P + S)] A, value: &tensor[F, M, KV * (2 * P + S)] A,
    query_norm: &tensor[N, 2 * P + S] f32, key_norm: &tensor[N, 2 * P + S] f32,
    value_norm: &tensor[NV, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    epsilon: f32, scale: f32, gate_function: i32, slab_rows: u32)
    -> tensor[M, KV * G, 2 * P + S] A
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and I >= 0 and U >= 0 and F >= 0 and N >= 0 and NV >= 0:
    return attention_rows(query, gate, key, value, query_norm, key_norm, value_norm,
        rotary_components, rotary_frequencies, rotary_amplitudes, coordinates, visible,
        fresh, destinations, history_key, history_value, epsilon, scale, gate_function)

# Metal: tiles of 32 keys (16 for heads wider than 256, whose output
# accumulates in 256-column windows) on simdgroup matrices or tensor
# operations, a `merge` launch when a tile is split (3 launches).
native attention_prefill for metal from "metal/attention_prefill.metal":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic QT in [16, 8, 32], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0 and (2 * P + S <= 256 or (2 * P + S) % 256 == 0) and (32 - 16 * min(1, (2 * P + S) / 257)) * (2 * P + S + 8) * 2 + 64 * 16 <= 32768
    scratch queries bytes (ceil_div(M, QT) * QT * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, QT) * 4)
    launch attention_prefill_prepare:
        threadgroups (ceil_div(ceil_div(M, QT) * QT * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_prefill_attend:
        threadgroups (ceil_div(M, QT), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)))
        threads_per_threadgroup (QT * G * 4, 1, 1)
        shared_bytes ((32 - 16 * min(1, (2 * P + S) / 257)) * (2 * P + S + 8) * 2 + (R + 1) * 16)
    launch attention_prefill_merge when ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV) > 1:
        threadgroups (ceil_div(M, QT), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: flash attention on m16n8k16 tensor cores. A block owns WARPS * 16
# matrix rows (WARPS * 16 / G tokens x G query heads) of one kv head; K/V
# tiles of 32 keys are double-buffered next to the query tile in shared
# memory. A head wider than 256 takes 16-key tiles and one pass per 256-column
# output window, staging each key tile in 256-column pieces and the window's
# values with its last piece (WARPS = 4 fits W = 512). As on Metal, a query tile's key
# tiles split over up to SPLIT_GROUPS / (tiles x KV) partitions of at least
# 16 tiles (so long histories fill the device) and a merge launch combines
# them; SPLIT_GROUPS = 1 never splits.
native attention_prefill for cuda from "cuda/attention_prefill.cu":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic WARPS in [4, 2, 8, 1], arithmetic SPLIT_GROUPS in [1, 256, 512], arithmetic STAGES in [2, 3],
        arithmetic COLUMNS in [1, 2], QREG in [0, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0 and (2 * P + S <= 256 or (2 * P + S) % 256 == 0) and G <= WARPS * 16 and (QREG == 0 or 2 * P + S <= 256) and min(2 * P + S, 256 * COLUMNS) % (16 * COLUMNS) == 0 and ((1 - QREG) * (WARPS * 16 * (2 * P + S) + STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min(2 * P + S, 256) + min(2 * P + S, 256 * COLUMNS))) + QREG * max(WARPS * 16 * (2 * P + S), STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min(2 * P + S, 256) + min(2 * P + S, 256 * COLUMNS)))) * 2 <= 98304
    scratch queries bytes (M * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, WARPS * 16 / G) * 4)
    launch attention_prefill_prepare:
        threadgroups (ceil_div(M * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_prefill_attend:
        threadgroups (ceil_div(M, WARPS * 16 / G), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV)))
        threads_per_threadgroup (COLUMNS * WARPS * 32, 1, 1)
        shared_bytes (((1 - QREG) * (WARPS * 16 * (2 * P + S) + STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min(2 * P + S, 256) + min(2 * P + S, 256 * COLUMNS))) + QREG * max(WARPS * 16 * (2 * P + S), STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min(2 * P + S, 256) + min(2 * P + S, 256 * COLUMNS)))) * 2 + (R + 1) * 16)
