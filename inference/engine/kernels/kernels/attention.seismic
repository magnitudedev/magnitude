# Attention over projected rows: optional q/k norms and rotary tables,
# attention over each row's visible history spans plus its fresh span of this
# batch's rows, optional output gates, and the K/V append at `destinations`.
#
# The prepared query and key are published in the activation dtype; the key
# exactly as it is stored in history, so a fresh read and a later history read
# of the same key agree. A row with no visible key attends to zero.
# Destinations are freshly reserved history rows: no row of the batch sees one
# of them through `visible`, so the append is independent of every read.
#
# A block runs `attention_project` (normed Q / gate / K / V projection), then
# `attention_decode` or `_prefill` (or their `_k8v4` forms over affine
# history), then `attention_output` (output projection plus residual). The
# family's axes are described with `attention_project` below.

# Affine K8/V4 history (the `affine_k8_uniform_v4` KV codec). Every (history
# row, kv head) vector of W values is split into affine groups of 32
# consecutive values x, each stored as codes plus an F16 coefficient pair
# (scale, zero): zero = f16(min x), scale = f16((max x - min x) / L) and
# code = min(L, u32(fma(x - zero, 1 / scale, 0.5))) (0 when scale is 0),
# decoded as code * scale + zero. A vector's pairs are consecutive, group
# order (C = W / 16 halves). Keys use 8-bit codes (L = 255, four per u32
# word), values 4-bit codes (L = 15, eight per word); code i sits at bits
# B * (i % (32 / B)) of word i / (32 / B). The key encoded is the prepared key
# rounded to the activation dtype, the value the projected value. Fresh rows
# of the batch attend dense; only history is encoded.
fn affine_encode[W, N, C](x: &tensor[W] f32, codes: &mut tensor[N] u32,
    coefficients: &mut tensor[C] f16):
    let levels = (u32(1) << u32(32 * N / W)) - u32(1)
    for word in 0..N:
        codes[word] = u32(0)
    for group in 0..C / 2:
        let mut low = inf
        let mut high = -inf
        for i in group * (2 * W / C)..(group + 1) * (2 * W / C):
            if i < W:
                low = min(low, x[i])
                high = max(high, x[i])
        let zero = f16(low)
        let scale = f16((high - low) / f32(levels))
        let mut inverse = 0.0
        if f32(scale) > 0.0:
            inverse = 1.0 / f32(scale)
        for i in group * (2 * W / C)..(group + 1) * (2 * W / C):
            let word = i / (W / N)
            if word < N and i < W:
                let code = min(u32(fma(x[i] - f32(zero), inverse, 0.5)), levels)
                codes[word] = codes[word] | (code << (u32(i % (W / N)) * u32(32 * N / W)))
        coefficients[2 * group] = scale
        coefficients[2 * group + 1] = zero

fn affine_decode[W, N, C](codes: &tensor[N] u32, coefficients: &tensor[C] f16,
    x: &mut tensor[W] f32):
    let levels = (u32(1) << u32(32 * N / W)) - u32(1)
    for i in 0..W:
        let word = i / (W / N)
        let group = i / (2 * W / C)
        if word < N and group < C / 2:
            let code = (codes[word] >> (u32(i % (W / N)) * u32(32 * N / W))) & levels
            x[i] = fma(f32(code), f32(coefficients[2 * group]), f32(coefficients[2 * group + 1]))

# One decoded history key/value absorbed by the online softmax of G query
# heads (F32 scores and state).
fn attention_absorb[G, W](qt: &tensor[G, W] A, key: &tensor[W] f32,
    value: &tensor[W] f32, m: &mut tensor[G] f32, l: &mut tensor[G] f32,
    acc: &mut tensor[G, W] f32, scale: f32):
    for head in 0..G:
        let mut dot = 0.0
        for column in 0..W:
            dot = fma(f32(qt[head, column]), key[column], dot)
        let next = max(m[head], dot * scale)
        let p = exp(dot * scale - next)
        let carry = exp(m[head] - next)
        l[head] = fma(l[head], carry, p)
        for column in 0..W:
            acc[head, column] = fma(p, value[column], acc[head, column] * carry)
        m[head] = next

# The output projection of the Q = KV * G gated attention heads plus the F32
# residual. Both backends: the K1 projection library.
fn attention_output[M, D, Q, W](hidden: &tensor[M, D] f32,
    gated: &tensor[M, Q, W] A, output_weight: &tensor[D, Q * W] OW) -> tensor[M, D] f32:
    let mut projected = tensor[M, D] A
    let mut result = tensor[M, D] f32
    linear(reshape(gated, (M, Q * W)), output_weight, projected)
    add(hidden, projected, result)
    return result

# Metal: GEMV below BATCH_FROM rows, batched GEMV to 16, GEMM beyond with
# SPLIT-way split-K summed by `finalize`. The input needs no prologue, so
# there is no `stage`. (CUDA: GEMV to 16 rows, INT8 candidate on the GEMM.)
native attention_output for metal from "metal/attention_output.metal":
    static (D, Q, W)
    params (arithmetic BATCH_FROM in [5, 3, 9], arithmetic SPLIT in [1, 2, 4])
    scratch partials bytes (SPLIT * M * D * 4) when M > 64 and SPLIT > 1
    scratch small_partials bytes (4 * M * D * 4) when M > 16 and M <= 64
    launch attention_output_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(D, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(Q * W, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch attention_output_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div(D, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch attention_output_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(D, 64), ceil_div(M, 32), 4)
        threads_per_threadgroup (128, 1, 1)
    launch attention_output_finalize_small when M > 16 and M <= 64:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_output_gemm when M > 64:
        params (code TILE_M in [64, 128, 32], code TILE_N in [64, 128])
        threadgroups (ceil_div(D, TILE_N), ceil_div(M, TILE_M), SPLIT)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch attention_output_finalize when M > 64 and SPLIT > 1:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CUDA: GEMV to 8 rows, `gemv16` to 16, GEMM beyond in the K1 row bands
# (`gemm_small` to 64 rows with the INT8 candidate, `gemm` beyond), both split
# over K into 2 shares summed by `finalize` up to 128 rows (see
# `cuda_dense.seismic`); `stage_s8` forms q8_1 rows for the INT8 GEMM only.
# (Metal: batched GEMV class, no INT8 path.)
native attention_output for cuda from "cuda/attention_output.cu":
    static (D, Q, W)
    params (code arithmetic INT8 in [0, 1])
    where Q * W % 64 == 0
    scratch staged bytes (M * Q * W) when INT8 == 1 and M > 16 and M <= 64
    scratch groups bytes (M * Q * W / 4) when INT8 == 1 and M > 16 and M <= 64
    scratch partials bytes (2 * M * D * 4) when M > 16 and M <= 128
    launch attention_output_stage_s8 when INT8 == 1 and M > 16 and M <= 64:
        reads (INT8)
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_output_gemv when M <= 8:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(D, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_output_gemv16 when M > 8 and M <= 16:
        params (code arithmetic KSPLIT in [4, 2, 8])
        threadgroups (ceil_div(ceil_div(D, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_output_gemm_small when M > 16 and M <= 64:
        reads (INT8)
        threadgroups (ceil_div(ceil_div(D, 16), 8), 1, 1 + min(1, 128 / M))
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch attention_output_gemm when M > 64:
        params (code ROTATE in [2, 1, 4])
        threadgroups (ceil_div(ceil_div(D, 16), 8), ceil_div(M, 128), 1 + min(1, 128 / M))
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)
    launch attention_output_finalize when M > 16 and M <= 128:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the K1 projection (see `attention_project`): GEMV to 8 rows,
# GEMM beyond with SPLIT-way split-K summed in order by `finalize`.
native attention_output for vulkan from "vulkan/attention_output.comp":
    static (D, Q, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            TILE_M in [128, 64, 32], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64],
            arithmetic SPLIT in [1, 2, 4])
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch partials bytes (SPLIT * M * D * 4) when M > 8 and SPLIT > 1
    launch attention_output_gemv when M <= 8:
        threadgroups (ceil_div(D, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(Q * W, 32), 288) * 72)
    launch attention_output_gemm when M > 8:
        threadgroups (ceil_div(D, TILE_N), ceil_div(M, TILE_M), SPLIT)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch attention_output_finalize when M > 8 and SPLIT > 1:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: the CPU projection library (`cpu/lib/projection/projection.rs`). A
# stage launch writes each row's gated heads as one F32 row to scratch; the
# row launch gives each work item ROWS output weight rows, projected against
# every staged row and added to the hidden row.
native attention_output for cpu from "cpu/attention_output.rs":
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    scratch quantized bytes (M * ceil_div(Q * W, 256) * 292)
    scratch staged bytes (M * Q * W * 4)
    launch attention_output_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch attention_output_rows:
        threadgroups (ceil_div(D, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)


# ---------------------------------------------------------------------------
# The parameterized attention family (`attention_*`).
#
# One block runs `attention_project` (normed Q / K / V projection), then
# `attention_decode` or `_prefill` (or their `_k8v4` forms over affine
# history), then `attention_output`. Every structural axis is a shape
# dimension, so every native is specialized on it:
#
# - output gates: a query head's gate values are either interleaved with its
#   queries (query [M, KV * G, W + I], I = W gate columns after the W query
#   columns, as Qwen projects them) or a separate projection (gate
#   [M, KV * G, U], U = 1 per head or U = W per column); at most one of I and
#   U is nonzero, and both zero is ungated. Column c takes gate value c modulo
#   the head's gate count, through sigmoid (gate_function 0) or softplus (1).
# - key, value [F, M, KV * W]: F = 1 for a layer with its own keys and
#   values; F = 0 for a layer reading another layer's history, which has no
#   fresh keys and appends nothing (its visible spans cover the rows the
#   source layer appended for this batch).
# - query_norm, key_norm [N, W]: weighted RMS of each query and key head when
#   N = 1; N = 0 leaves them unnormalized (unit RMS is not the identity, so it
#   is skipped, not approximated). value_norm [NV, W] likewise normalizes
#   each value head before it is used and appended.
# - rotary tables [P]: pair p (columns p and p + P) rotates by the coordinate
#   on axis components[p] at frequencies[p], its cosine and sine scaled by
#   amplitudes[p]; columns 2P.. pass through. P = 0 is no rotation.
#
# W = 2P + S. The window of a sliding-window layer, the history domain of a
# layer and a non-causal fresh block are all expressed by the host-built
# `visible` and `fresh` spans; kernels never mask a key inside a span.
# ---------------------------------------------------------------------------

# RMS prologue over the F32 residual, then one segmented projection query |
# gate | key | value, each segment with its own representation (Q = KV * G *
# (W + I), GR = KV * G * U, K = V = KV * W). A segment of zero rows is
# skipped: GR = 0 without a separate gate, K = V = 0 for a layer without its
# own keys, V = 0 when the value is the raw key. Every backend runs its K1
# projection library (see `dense.seismic` for its launches); the segments
# enumerate their tile groups or block columns in segment order. Mode 1 is
# draft-history injection: Q/gate outputs are zero and only K/V is consumed.
# Native backends may omit the Q/gate projection work in that mode.
fn attention_project[M, D, Q, GR, K, V](hidden: &tensor[M, D] f32, input_norm: &tensor[D] NW,
    query_weight: &tensor[Q, D] QW, gate_weight: &tensor[GR, D] GW,
    key_weight: &tensor[K, D] KW, value_weight: &tensor[V, D] VW, epsilon: f32,
    project_mode: i32)
    -> (tensor[M, Q] A, tensor[M, GR] A, tensor[M, K] A, tensor[M, V] A)
    where GR >= 0 and K >= 0 and V >= 0:
    let mut normalized = tensor[M, D] A
    let mut query = tensor[M, Q] A
    let mut gate = tensor[M, GR] A
    let mut key = tensor[M, K] A
    let mut value = tensor[M, V] A
    rms_norm(hidden, input_norm, normalized, epsilon)
    if project_mode == 0:
        linear(normalized, query_weight, query)
    else:
        parallel for row in 0..M:
            parallel for column in 0..Q:
                query[row, column] = 0.0
    if GR > 0 and project_mode == 0:
        linear(normalized, gate_weight, gate)
    else:
        parallel for row in 0..M:
            parallel for column in 0..GR:
                gate[row, column] = 0.0
    if K > 0:
        linear(normalized, key_weight, key)
    if V > 0:
        linear(normalized, value_weight, value)
    return query, gate, key, value

native attention_project for metal from "metal/attention_project.metal":
    static (D, Q, GR, K, V)
    params (arithmetic BATCH_FROM in [5, 3, 9])
    scratch normalized bytes (M * D * 2) when M > 16
    launch attention_project_stage when M > 16:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_project_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(Q, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(GR, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(K, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(V, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(D, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch attention_project_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div(Q, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + ceil_div(GR, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + ceil_div(K, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + ceil_div(V, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch attention_project_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(Q, 64) + ceil_div(GR, 64) + ceil_div(K, 64) + ceil_div(V, 64),
            ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch attention_project_gemm when M > 64:
        params (code TILE_M in [64, 128, 32], code TILE_N in [64, 128])
        threadgroups (ceil_div(Q, TILE_N) + ceil_div(GR, TILE_N) + ceil_div(K, TILE_N)
            + ceil_div(V, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

