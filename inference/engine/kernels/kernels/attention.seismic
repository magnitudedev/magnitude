        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# Vulkan: the Metal form (`vulkan/lib/attention/history.glsl`): the dense
# decode's launches with corrected scores over the codes. W is a power of two.
# KEYWISE selects the key-parallel form: a lane scores one key of each 32-key
# batch against its slice's heads over the whole width (queries broadcast
# from shared memory, the codes corrected per group, no per-key subgroup
# reduction), one subgroup maximum and sum per head and batch, and each lane
# decodes its value columns as it accumulates them. History rows are read
# coalesced through a per-subgroup staging tile, so the form admits one and
# two subgroups. Its shared bytes, after the states: the queries [G][W]
# (F32), each subgroup's weights [32][G / SLICES] (F32), the query group sums
# [G][W / 32] (F32) and each subgroup's staging tile [32][max(min(W, 128) /
# 16, W / 32 + ceil(W / 128)) + 1] (uvec4), with 32 bytes of 16-byte
# alignment. MATRIX selects `attention_decode`'s matrix
# form, history tiles decoded to f16 as they are staged (as
# `attention_prefill_k8v4`).
native attention_decode_k8v4 for vulkan from "vulkan/attention_decode_k8v4.comp":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic SPAN in [32, 64, 128, 256], arithmetic PARTS in [16, 8, 32, 64, 128, 256, 512],
        arithmetic SIMDS in [4, 8, 1, 2], arithmetic SLICES in [1, 2, 4, 8],
        arithmetic form MATRIX in [0, 1], arithmetic form KEYWISE in [0, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256 or 2 * P + S == 512) and P % ((2 * P + S) / 32) == 0 and G % SLICES == 0 and SIMDS % SLICES == 0 and (MATRIX == 1 or KEYWISE == 1 or SIMDS >= 4) and (MATRIX == 0 or KEYWISE == 0) and (MATRIX == 1 or SIMDS * (G / SLICES) * 8 + (1 - KEYWISE) * max(SIMDS, ceil_div(G, 2)) * (2 * P + S) * 4 + KEYWISE * max(SIMDS * (2 * P + S) * 4, 32 + G * (2 * P + S) * 4 + SIMDS * (G / SLICES) * 128 + G * (2 * P + S) / 8 + SIMDS * 512 * (max(min((2 * P + S), 128) / 16, (2 * P + S) / 32 + ceil_div((2 * P + S), 128)) + 1)) <= 32768) and (MATRIX == 0 or (SLICES == 1 and SPAN == 32 and G <= SIMDS * 16 and ((2 * P + S) <= 64 or (2 * P + S) % 64 == 0) and ((2 * P + S) <= 256 or (2 * P + S) % 256 == 0) and 64 * (min((2 * P + S), 256) + 8) + SIMDS * 2048 + SIMDS * 16 * ((2 * P + S) + 8) * 2 <= 32768))
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch attention_decode_k8v4_partial:
        threadgroups (KV, PARTS, (1 - MATRIX) * M + MATRIX * ceil_div(M, max(1, SIMDS * 16 / G)))
        threads_per_threadgroup (SIMDS * 32, 1, 1)
        shared_bytes ((1 - MATRIX) * (SIMDS * (G / SLICES) * 8 + (1 - KEYWISE) * max(SIMDS, ceil_div(G, 2)) * (2 * P + S) * 4 + KEYWISE * max(SIMDS * (2 * P + S) * 4, 32 + G * (2 * P + S) * 4 + SIMDS * (G / SLICES) * 128 + G * (2 * P + S) / 8 + SIMDS * 512 * (max(min((2 * P + S), 128) / 16, (2 * P + S) / 32 + ceil_div((2 * P + S), 128)) + 1))) + MATRIX * (64 * (min((2 * P + S), 256) + 8) + SIMDS * 2048 + SIMDS * 16 * ((2 * P + S) + 8) * 2))
    launch attention_decode_k8v4_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CPU: the dense CPU decode's launches; `prepare` appends encoded rows and
# `attend` decodes history keys and values (F32) as it absorbs them. W is
# whole affine groups.
native attention_decode_k8v4 for cpu from "cpu/attention_decode_k8v4.rs":
    static (P, S, I, U, F, N, NV)
    params (arithmetic PARTS in [8, 4, 16, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0
    scratch queries bytes (M * KV * G * (2 * P + S) * 4)
    scratch keys bytes (M * KV * (2 * P + S) * 4)
    scratch values bytes (M * KV * (2 * P + S) * 4)
    scratch partials bytes (M * KV * PARTS * G * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * PARTS * G * 8)
    launch attention_decode_k8v4_prepare:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (P * 8)
    launch attention_decode_k8v4_attend:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((G * 32 + 2 * P + S) * 4)
    launch attention_decode_k8v4_merge:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * P + S) * 4)

native attention_prefill_k8v4 for metal from "metal/attention_prefill_k8v4.metal":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic QT in [16, 8, 32], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256 or 2 * P + S == 512) and P % ((2 * P + S) / 32) == 0
    scratch queries bytes (ceil_div(M, QT) * QT * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, QT) * 4)
    launch attention_prefill_k8v4_prepare:
        threadgroups (ceil_div(ceil_div(M, QT) * QT * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_prefill_k8v4_attend:
        threadgroups (ceil_div(M, QT), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)))
        threads_per_threadgroup (QT * G * 4, 1, 1)
        shared_bytes ((32 - 16 * min(1, (2 * P + S) / 257)) * (2 * P + S + 8) * 2 + (R + 1) * 16)
    launch attention_prefill_k8v4_merge when ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV) > 1:
        threadgroups (ceil_div(M, QT), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: `attention_prefill` over affine history: the attend launch adds
# PRODUCERS producer warps that load code tiles and store them decoded to F16
# operands while the MMA warps run the previous tile. A head wider than 256 is
# produced once per 256-column output window (whole keys, the window's
# values), as the dense entry stages it. PRODUCERS = 0 (heads of 128 to 256
# columns) has no producer warps: the MMA warps copy code tiles with
# `cp.async` into STAGES code stages (56 W bytes each) beside the operand
# stages and decode them there, keeping dense's register budget, so 8 MMA
# warps fit a 256-column head (a block's registers split evenly over its
# threads, so producer warps would spill the MMA warps' accumulators).
native attention_prefill_k8v4 for cuda from "cuda/attention_prefill_k8v4.cu":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic WARPS in [4, 2, 8], arithmetic SPLIT_GROUPS in [1, 256, 512], arithmetic STAGES in [2, 3],
        arithmetic COLUMNS in [1, 2], QREG in [0, 1], arithmetic PRODUCERS in [4, 0, 1, 2, 8])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256 or 2 * P + S == 512) and G <= WARPS * 16 and (QREG == 0 or 2 * P + S <= 256) and min(2 * P + S, 256 * COLUMNS) % (16 * COLUMNS) == 0 and (PRODUCERS > 0 or ((2 * P + S) >= 128 and (2 * P + S) <= 256)) and ((1 - QREG) * ((WARPS * 16 * (2 * P + S) * 2) + (STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min((2 * P + S), 256) + min((2 * P + S), 256 * COLUMNS)) * 2 + (max(1, PRODUCERS) - PRODUCERS) * STAGES * 56 * (2 * P + S))) + QREG * max((WARPS * 16 * (2 * P + S) * 2), (STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min((2 * P + S), 256) + min((2 * P + S), 256 * COLUMNS)) * 2 + (max(1, PRODUCERS) - PRODUCERS) * STAGES * 56 * (2 * P + S)))) <= 98304
    scratch queries bytes (M * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, WARPS * 16 / G) * 4)
    launch attention_prefill_k8v4_prepare:
        threadgroups (ceil_div(M * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_prefill_k8v4_attend:
        threadgroups (ceil_div(M, WARPS * 16 / G), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV)))
        threads_per_threadgroup ((COLUMNS * WARPS + PRODUCERS) * 32, 1, 1)
        shared_bytes (((1 - QREG) * ((WARPS * 16 * (2 * P + S) * 2) + (STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min((2 * P + S), 256) + min((2 * P + S), 256 * COLUMNS)) * 2 + (max(1, PRODUCERS) - PRODUCERS) * STAGES * 56 * (2 * P + S))) + QREG * max((WARPS * 16 * (2 * P + S) * 2), (STAGES * (32 - 16 * min(1, (2 * P + S) / 257)) * (min((2 * P + S), 256) + min((2 * P + S), 256 * COLUMNS)) * 2 + (max(1, PRODUCERS) - PRODUCERS) * STAGES * 56 * (2 * P + S)))) + (R + 1) * 16)
    launch attention_prefill_k8v4_merge when ceil_div(SPLIT_GROUPS, ceil_div(M, WARPS * 16 / G) * KV) > 1:
        threadgroups (ceil_div(M, WARPS * 16 / G), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# Vulkan: the dense prefill's launches (`vulkan/lib/attention/prefill.glsl`);
# the prepare launch appends encoded rows and history tiles decode (rounded to
# the f16 operand) as they are staged.
native attention_prefill_k8v4 for vulkan from "vulkan/attention_prefill_k8v4.comp":
    static (KV, G, P, S, I, U, F, N, NV)
    params (arithmetic ROWS in [64, 128], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256 or 2 * P + S == 512) and P % ((2 * P + S) / 32) == 0 and G <= ROWS and ROWS / G <= 32 and 64 * (min(2 * P + S, 256) + 8) + ROWS / 16 * 2048 <= 32768
    scratch queries bytes ((ceil_div(M, ROWS / G) * (ROWS / G) * KV * G + ROWS) * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, ROWS / G) * 4)
    launch attention_prefill_k8v4_prepare:
        threadgroups (ceil_div(ceil_div(M, ROWS / G) * (ROWS / G) * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_prefill_k8v4_attend:
        threadgroups (ceil_div(M, ROWS / G), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)))
        threads_per_threadgroup (ROWS * 2, 1, 1)
        shared_bytes (64 * (min(2 * P + S, 256) + 8) + ROWS / 16 * 2048)
    launch attention_prefill_k8v4_merge when SPLIT_GROUPS > ceil_div(M, ROWS / G) * KV:
        threadgroups (ceil_div(M, ROWS / G), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CPU: the dense CPU prefill's launches; `prepare` appends encoded rows and
# `attend` decodes history keys and values (F32) as it absorbs them. W is
# whole affine groups.
native attention_prefill_k8v4 for cpu from "cpu/attention_prefill_k8v4.rs":
    static (P, S, I, U, F, N, NV)
    where (I == 0 or I == 2 * P + S) and (U == 0 or U == 1 or U == 2 * P + S) and (I == 0 or U == 0) and F <= 1 and N <= 1 and NV <= 1 and (2 * P + S) % 32 == 0
    scratch queries bytes (M * KV * G * (2 * P + S) * 4)
    scratch keys bytes (M * KV * (2 * P + S) * 4)
    scratch values bytes (M * KV * (2 * P + S) * 4)
    launch attention_prefill_k8v4_prepare:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (P * 8)
    launch attention_prefill_k8v4_attend:
        threadgroups (M, KV, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes ((2 * G + G * (2 * P + S) + G * 32 + 2 * P + S) * 4)
