# The family over affine K8/V4 history (the `affine_k8_uniform_v4` codec;
# `affine_encode`, `affine_decode`): `attention_rows` with every history key
# and value decoded as it is absorbed and the fresh rows' prepared key (as
# rounded to the activation dtype) and value encoded at their destinations.
# Fresh rows of the batch attend dense.
fn attention_rows_k8v4[M, T, KV, G, P, S, I, U, F, N, NV, R](
    query: &tensor[M, KV * G, 2 * P + S + I] A, gate: &tensor[M, KV * G, U] A,
    key: &tensor[F, M, KV * (2 * P + S)] A, value: &tensor[F, M, KV * (2 * P + S)] A,
    query_norm: &tensor[N, 2 * P + S] f32, key_norm: &tensor[N, 2 * P + S] f32,
    value_norm: &tensor[NV, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key_codes: &mut tensor[T, KV, (2 * P + S) / 4] u32,
    history_key_coefficients: &mut tensor[T, KV, (2 * P + S) / 16] f16,
    history_value_codes: &mut tensor[T, KV, (2 * P + S) / 8] u32,
    history_value_coefficients: &mut tensor[T, KV, (2 * P + S) / 16] f16,
    epsilon: f32, scale: f32, gate_function: i32) -> tensor[M, KV * G, 2 * P + S] A
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and I >= 0 and U >= 0 and F >= 0 and N >= 0 and NV >= 0:
    let mut fresh_key = tensor[F, M, KV, 2 * P + S] A
    let mut fresh_value = tensor[F, M, KV, 2 * P + S] A
    for layer in 0..F:
        for row in 0..M:
            for head in 0..KV:
                fresh_key[layer, row, head] = head_rotary(
                    key[layer, row, head * (2 * P + S) : (head + 1) * (2 * P + S)], key_norm,
                    coordinates[row], rotary_components, rotary_frequencies,
                    rotary_amplitudes, epsilon)
                fresh_value[layer, row, head] = head_norm(
                    value[layer, row, head * (2 * P + S) : (head + 1) * (2 * P + S)],
                    value_norm, epsilon)
    let mut result = tensor[M, KV * G, 2 * P + S] A
    let mut decoded_key = tensor[2 * P + S] f32
    let mut decoded_value = tensor[2 * P + S] f32
    for column in 0..2 * P + S:
        decoded_key[column] = 0.0
        decoded_value[column] = 0.0
    for row in 0..M:
        for kv_head in 0..KV:
            let mut qt = tensor[G, 2 * P + S] A
            let mut maximum = tensor[G] f32
            let mut denominator = tensor[G] f32
            let mut accumulator = tensor[G, 2 * P + S] f32
            for head in 0..G:
                qt[head] = head_rotary(query[row, kv_head * G + head, 0 : 2 * P + S],
                    query_norm, coordinates[row], rotary_components, rotary_frequencies,
                    rotary_amplitudes, epsilon)
                maximum[head] = -inf
                denominator[head] = 0.0
                for column in 0..2 * P + S:
                    accumulator[head, column] = 0.0
            for span in 0..R:
                let lo = visible[row, span, 0]
                let hi = visible[row, span, 1]
                if lo >= 0 and hi > lo and (2 * P + S) / 16 >= 1 and (2 * P + S) / 8 >= 1 and (2 * P + S) / 4 >= 1:
                    for token in lo..hi:
                        affine_decode(history_key_codes[token, kv_head],
                            history_key_coefficients[token, kv_head], decoded_key)
                        affine_decode(history_value_codes[token, kv_head],
                            history_value_coefficients[token, kv_head], decoded_value)
                        attention_absorb(qt, decoded_key, decoded_value, maximum, denominator,
                            accumulator, scale)
            let fresh_lo = fresh[row, 0]
            let fresh_hi = fresh[row, 1]
            for layer in 0..F:
                if fresh_hi > fresh_lo:
                    attention_update(qt, fresh_key[layer, fresh_lo : fresh_hi, kv_head],
                        fresh_value[layer, fresh_lo : fresh_hi, kv_head], maximum,
                        denominator, accumulator, scale)
            for head in 0..G:
                let mut attended = tensor[2 * P + S] f32
                for column in 0..2 * P + S:
                    attended[column] = accumulator[head, column] / max(denominator[head], 1e-30)
                let gated = gate_row(attended,
                    query[row, kv_head * G + head, 2 * P + S : 2 * P + S + I],
                    gate[row, kv_head * G + head], gate_function)
                for column in 0..2 * P + S:
                    result[row, kv_head * G + head, column] = gated[column]
    for layer in 0..F:
        for row in 0..M:
            if destinations[row] >= 0 and (2 * P + S) / 16 >= 1 and (2 * P + S) / 8 >= 1 and (2 * P + S) / 4 >= 1:
                for head in 0..KV:
                    affine_encode(f32(fresh_key[layer, row, head]),
                        history_key_codes[destinations[row], head],
                        history_key_coefficients[destinations[row], head])
                    affine_encode(f32(fresh_value[layer, row, head]),
                        history_value_codes[destinations[row], head],
                        history_value_coefficients[destinations[row], head])
    return result

# Decode rows (M <= 8) over affine K8/V4 history: `attention_decode`'s
# partitioning and merge. Scores against history are corrected, not decoded:
# the sum over groups of scale * (q . code) + zero * sum(q); the value product
# accumulates (p * scale) * code and carries sum(p * zero) of each group
# through the online softmax as a bias added before the partition state is
# published. Partition 0 appends the row's key and value encoded.
fn attention_decode_k8v4[M, T, KV, G, P, S, I, U, F, N, NV, R](
    query: &tensor[M, KV * G, 2 * P + S + I] A, gate: &tensor[M, KV * G, U] A,
    key: &tensor[F, M, KV * (2 * P + S)] A, value: &tensor[F, M, KV * (2 * P + S)] A,
    query_norm: &tensor[N, 2 * P + S] f32, key_norm: &tensor[N, 2 * P + S] f32,
    value_norm: &tensor[NV, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key_codes: &mut tensor[T, KV, (2 * P + S) / 4] u32,
    history_key_coefficients: &mut tensor[T, KV, (2 * P + S) / 16] f16,
    history_value_codes: &mut tensor[T, KV, (2 * P + S) / 8] u32,
    history_value_coefficients: &mut tensor[T, KV, (2 * P + S) / 16] f16,
    epsilon: f32, scale: f32, gate_function: i32, slab_rows: u32)
    -> tensor[M, KV * G, 2 * P + S] A
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and I >= 0 and U >= 0 and F >= 0 and N >= 0 and NV >= 0:
    return attention_rows_k8v4(query, gate, key, value, query_norm, key_norm, value_norm,
        rotary_components, rotary_frequencies, rotary_amplitudes, coordinates, visible,
        fresh, destinations, history_key_codes, history_key_coefficients, history_value_codes,
        history_value_coefficients, epsilon, scale, gate_function)

# Prefill rows (M >= 16) over affine K8/V4 history: `attention_prefill`'s
# launches with the prepare launch appending encoded rows and every history
# K/V tile decoded (rounded to F16) as it is staged.
fn attention_prefill_k8v4[M, T, KV, G, P, S, I, U, F, N, NV, R](
    query: &tensor[M, KV * G, 2 * P + S + I] A, gate: &tensor[M, KV * G, U] A,
    key: &tensor[F, M, KV * (2 * P + S)] A, value: &tensor[F, M, KV * (2 * P + S)] A,
    query_norm: &tensor[N, 2 * P + S] f32, key_norm: &tensor[N, 2 * P + S] f32,
    value_norm: &tensor[NV, 2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    rotary_amplitudes: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key_codes: &mut tensor[T, KV, (2 * P + S) / 4] u32,
    history_key_coefficients: &mut tensor[T, KV, (2 * P + S) / 16] f16,
    history_value_codes: &mut tensor[T, KV, (2 * P + S) / 8] u32,
    history_value_coefficients: &mut tensor[T, KV, (2 * P + S) / 16] f16,
    epsilon: f32, scale: f32, gate_function: i32, slab_rows: u32)
    -> tensor[M, KV * G, 2 * P + S] A
    where P >= 0 and S >= 0 and 2 * P + S >= 1 and I >= 0 and U >= 0 and F >= 0 and N >= 0 and NV >= 0:
    return attention_rows_k8v4(query, gate, key, value, query_norm, key_norm, value_norm,
        rotary_components, rotary_frequencies, rotary_amplitudes, coordinates, visible,
        fresh, destinations, history_key_codes, history_key_coefficients, history_value_codes,
        history_value_coefficients, epsilon, scale, gate_function)

# A lane's W / 32 codes must be whole words or a power-of-two part of one, so
# W is a power of two. The query group splits into SLICES slices, as in
