# All backends: a stage launch rounds the hidden rows to A in scratch, then
# `project_rows`' row classes over them with the activated-product epilogue
# (the multiplier row is `inputs[m, layer]`).
native per_layer_gate for metal from "metal/per_layer_gate.metal":
    static (D, L, P, GS)
    params (arithmetic BATCH_FROM in [5, 3, 9])
    where GS <= 1
    scratch rounded bytes (M * D * 2)
    launch per_layer_gate_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch per_layer_gate_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(P, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(D, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch per_layer_gate_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div(P, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch per_layer_gate_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(P, 64), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch per_layer_gate_gemm when M > 64:
        params (code TILE_M in [64, 128, 32], code TILE_N in [64, 128])
        threadgroups (ceil_div(P, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

native per_layer_gate for vulkan from "vulkan/per_layer_gate.comp":
    static (D, L, P, GS)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            TILE_M in [128, 64, 32], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64])
    where SUB_M <= TILE_M and SUB_N <= TILE_N and GS <= 1
    scratch rounded bytes (M * D * 2)
    launch per_layer_gate_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch per_layer_gate_gemv when M <= 8:
        threadgroups (ceil_div(P, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(D, 32), 288) * 72)
    launch per_layer_gate_gemm when M > 8:
        threadgroups (ceil_div(P, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

native per_layer_gate for cpu from "cpu/per_layer_gate.rs":
    static (GS)
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    where GS <= 1
    scratch quantized bytes (M * ceil_div(D, 256) * 292)
    scratch staged bytes (M * D * 4)
    launch per_layer_gate_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch per_layer_gate_rows:
        threadgroups (ceil_div(P, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)

# A plain projection of A rows, published in Y: F32 where a row op consumes
# the projection before the residual (`post_norm_residual`'s projected rows:
# attention and feed-forward outputs of post-norm blocks, the per-layer
# input's projection back to the hidden width), A where it feeds another
# projection (Nemotron's latent down).
fn project_rows[M, K, N, WS](source: &tensor[M, K] A, weight: &tensor[N, K] W,
    weight_scale: &tensor[WS] f32) -> tensor[M, N] Y where WS >= 0 and WS <= 1:
    let mut sum = tensor[M, N] f32
    let mut result = tensor[M, N] Y
    linear(source, weight, sum)
    scale_rows(sum, weight_scale, result)
    return result

# Metal: the `attention_output` launch structure (GEMV below BATCH_FROM rows,
# batched GEMV to 16, the fixed small GEMM with its 4-way split to 64, tuned
# GEMM beyond with SPLIT-way split-K summed in order by `finalize`) with a
# store epilogue in Y.
native project_rows for metal from "metal/project_rows.metal":
    static (K, N, WS)
    params (arithmetic BATCH_FROM in [5, 3, 9], arithmetic SPLIT in [1, 2, 4])
    where WS <= 1
    scratch partials bytes (SPLIT * M * N * 4) when M > 64 and SPLIT > 1
    scratch small_partials bytes (4 * M * N * 4) when M > 16 and M <= 64
    launch project_rows_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32], code ROWS in [1, 2, 4], code arithmetic LANES in [16, 32])
        threadgroups (ceil_div(N, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(K, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch project_rows_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32], code BATCH_ROWS in [2, 1, 4])
        threadgroups (ceil_div(N, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch project_rows_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(N, 64), ceil_div(M, 32), 4)
        threads_per_threadgroup (128, 1, 1)
    launch project_rows_finalize_small when M > 16 and M <= 64:
        threadgroups (ceil_div(M * N, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch project_rows_gemm when M > 64:
        params (code TILE_M in [64, 128, 32], code TILE_N in [64, 128])
        threadgroups (ceil_div(N, TILE_N), ceil_div(M, TILE_M), SPLIT)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch project_rows_finalize when M > 64 and SPLIT > 1:
        threadgroups (ceil_div(M * N, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# Vulkan: the `attention_output` form (GEMV to 8 rows, GEMM beyond with
# SPLIT-way split-K summed in order by `finalize`).
native project_rows for vulkan from "vulkan/project_rows.comp":
    static (K, N, WS)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            TILE_M in [128, 64, 32], TILE_N in [128, 64], SUB_M in [32, 64], SUB_N in [32, 64],
            arithmetic SPLIT in [1, 2, 4])
    where SUB_M <= TILE_M and SUB_N <= TILE_N and WS <= 1
    scratch partials bytes (SPLIT * M * N * 4) when M > 8 and SPLIT > 1
    launch project_rows_gemv when M <= 8:
        threadgroups (ceil_div(N, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(K, 32), 288) * 72)
    launch project_rows_gemm when M > 8:
        threadgroups (ceil_div(N, TILE_N), ceil_div(M, TILE_M), SPLIT)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)
    launch project_rows_finalize when M > 8 and SPLIT > 1:
        threadgroups (ceil_div(M * N, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: the CPU projection library (`cpu/lib/projection/projection.rs`). A
# stage launch writes each normalized (expand) or product (output) row as F32
# to scratch; the row launch gives each work item ROWS weight rows, projected
# against every staged row through the weight representation's dot component.
native dense_expand for cpu from "cpu/dense_expand.rs":
    static (GS, US)
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    where GS <= 1 and US <= 1
    scratch quantized bytes (O * ceil_div(H, 256) * 292)
    scratch normalized bytes (O * H * 4)
    launch dense_expand_normalize:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch dense_expand_rows:
        threadgroups (ceil_div(F, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)

native dense_output for cpu from "cpu/dense_output.rs":
    static (DS)
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    where DS <= 1
    scratch quantized bytes (O * ceil_div(F, 256) * 292)
    scratch staged bytes (O * F * 4)
    launch dense_output_stage:
        threadgroups (O, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch dense_output_rows:
        threadgroups (ceil_div(H, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)

native project_rows for cpu from "cpu/project_rows.rs":
    static (WS)
    params (ROWS in [8, 4, 2, 1], arithmetic INT8 in [0, 1])
    where WS <= 1
    scratch quantized bytes (M * ceil_div(K, 256) * 292)
    scratch staged bytes (M * K * 4)
    launch project_rows_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch project_rows_rows:
        threadgroups (ceil_div(N, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
