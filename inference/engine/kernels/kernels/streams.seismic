# Hyper-connection residual streams. The residual is S streams of H values
# per row, one `[M, S * H]` F32 tensor (stream s at columns s * H ..). A
# sublayer reads it through a mix site and writes back through a scatter:
#   xn[s]  = rms(X[s]) * norm[s]                       (per-stream RMS norm)
#   low    = silu(down(xn) / S)                        (`stream_mix_down`)
#   inject = 2 sigmoid(inject(xn) / S)                 (`stream_mix_down`, C = 1)
#   p[s]   = sigmoid(up(low))[s] * xn[s] / S           (`stream_mix_up`)
# The sublayer's input row is the sum of the S partials p, formed by its
# consumer entry (`form_input` in functions.seismic, PT = S, NM = 0), and its
# output joins the streams through the output entry's `scatter` with the
# inject values (`functions.seismic`). The decoder's exit is a mix site
# without inject (C = 0) whose partials the readout sums. Under Sinkhorn
# mixing a site is one entry (`stream_mix_sinkhorn`) reading the previous
# site's pre, and the exit collapses the streams by the last site's pre
# (`stream_collapse`).
#
# The mix entries read the streams and their norm through `[M, S, H]` and
# `[S, H]` views of the row-major `[M, S * H]` and `[S * H]` tensors, which
# name S and H; their natives read a row's S * H values at the innermost
# stride.

# The per-stream RMS normalization of the streams, rounded to the result's
# element as rows of S * H, and each stream's inverse.
fn group_rms[M, H, S](x: &tensor[M, S, H] f32, norm: &tensor[S, H] T,
    y: &mut tensor[M, S * H] U, inverse: &mut tensor[M, S] f32, epsilon: f32):
    parallel for row in 0..M:
        parallel for stream in 0..S:
            let mut squares = f32(0.0)
            for column in 0..H:
                let v = x[row, stream, column]
                squares = squares + v * v
            let scale = rsqrt(squares / f32(H) + epsilon)
            inverse[row, stream] = scale
            for column in 0..H:
                y[row, stream * H + column] = x[row, stream, column] * scale * f32(norm[stream, column])

# A mix site's first stage: the per-stream normalized streams (rounded to A)
# through one segmented projection, down | inject. Results: the low-rank
# rows `silu(v / S)` in A, the inject values `2 sigmoid(v / S)` in F32 (C = 1;
# none for the exit site, C = 0), and the per-stream norm inverses the second
# stage reads.
fn stream_mix_down[M, H, S, LR, C](hidden: &tensor[M, S, H] f32, norm: &tensor[S, H] NW,
    down_weight: &tensor[LR, S * H] DW, inject_weight: &tensor[C * S, S * H] IW, epsilon: f32)
    -> (tensor[M, LR] A, tensor[M, C * S] f32, tensor[M, S] f32)
    where S >= 1 and LR >= 1 and C >= 0 and C <= 1 and operands(DW) == 0 and operands(IW) == 0:
    let mut normalized = tensor[M, S * H] A
    let mut inverse = tensor[M, S] f32
    let mut low_sum = tensor[M, LR] f32
    let mut low = tensor[M, LR] A
    let mut inject_sum = tensor[M, C * S] f32
    let mut inject = tensor[M, C * S] f32
    group_rms(hidden, norm, normalized, inverse, epsilon)
    linear(normalized, down_weight, low_sum)
    parallel for row in 0..M:
        parallel for column in 0..LR:
            let v = low_sum[row, column] / f32(S)
            low[row, column] = v / (1.0 + exp(-v))
    if C > 0:
        linear(normalized, inject_weight, inject_sum)
        parallel for row in 0..M:
            parallel for column in 0..C * S:
                inject[row, column] = 2.0 / (1.0 + exp(-inject_sum[row, column] / f32(S)))
    return low, inject, inverse

# A mix site's second stage: the low-rank rows through `up`, each output the
# gate of its stream's column, publishing the per-stream partials
# `sigmoid(v) * xn / S` in F32 (xn unrounded, from the first stage's
# inverses).
fn stream_mix_up[M, H, S, LR](low: &tensor[M, LR] A, up_weight: &tensor[S * H, LR] UW,
    hidden: &tensor[M, S, H] f32, inverse: &tensor[M, S] f32, norm: &tensor[S, H] NW)
    -> tensor[M, S * H] f32 where S >= 1 and LR >= 1 and operands(UW) == 0:
    # The rows are dense activations: staging them in A (an exact copy)
    # states that domain (`project_rows`).
    let mut rows = tensor[M, LR] A
    parallel for row in 0..M:
        rows[row] = low[row]
    let mut gate_sum = tensor[M, S * H] f32
    let mut partials = tensor[M, S * H] f32
    linear(rows, up_weight, gate_sum)
    parallel for row in 0..M:
        parallel for stream in 0..S:
            parallel for column in 0..H:
                let at = stream * H + column
                let gate = 1.0 / (1.0 + exp(-gate_sum[row, at]))
                let normalized = hidden[row, stream, column] * inverse[row, stream] * f32(norm[stream, column])
                partials[row, at] = gate * normalized / f32(S)
    return partials

# A Sinkhorn mix site (`SinkhornSite`, DeepSeek V4.1's single pass) over
# each row's streams X: one projection of the flattened S * H values by
# `function` under one RMS statistic of all of them,
#   m    = (function x) rsqrt(mean(x^2) + norm_epsilon)
#   pre  = sigmoid(m[0:S] scale[0] + base[0:S]) + epsilon
#   post = 2 sigmoid(m[S:2S] scale[1] + base[S:2S])
#   comb = rowsoftmax(m[2S:] scale[2] + base[2S:]) + epsilon      ([S, S], source major)
#   then `iterations` sweeps, each comb = comb / (rowsum + epsilon) (every
#   sweep but the first) and comb = comb / (colsum + epsilon)
# in F32. Results: the sublayer's input `sum_s previous[s] X[s]` (the
# previous site's pre, which its consumer normalizes: `form_input`, PT = 1),
# this site's pre (the next site's `previous`), and the join row
# post | comb its sublayer's output entry scatters with (`scatter`,
# IN = S + S * S). `iterations`, the model's Sinkhorn iteration count, is a
# runtime argument, as epsilon is; zero leaves comb at its softmax rows.
fn stream_mix_sinkhorn[M, H, S](hidden: &tensor[M, S, H] f32, previous: &tensor[M, S] f32,
    function: &tensor[(2 + S) * S, S * H] f32, base: &tensor[(2 + S) * S] f32, scale: &tensor[3] f32,
    epsilon: f32, norm_epsilon: f32, iterations: u32)
    -> (tensor[M, H] f32, tensor[M, S] f32, tensor[M, S + S * S] f32) where S >= 1:
    let mut flat = tensor[M, S * H] f32
    let mut mixes = tensor[M, (2 + S) * S] f32
    let mut input = tensor[M, H] f32
    let mut pre = tensor[M, S] f32
    let mut join = tensor[M, S + S * S] f32
    parallel for row in 0..M:
        parallel for stream in 0..S:
            parallel for column in 0..H:
                flat[row, stream * H + column] = hidden[row, stream, column]
    linear(flat, function, mixes)
    parallel for row in 0..M:
        let mut squares = f32(0.0)
        for at in 0..S * H:
            let v = flat[row, at]
            squares = squares + v * v
        let inverse = rsqrt(squares / f32(S * H) + norm_epsilon)
        for stream in 0..S:
            pre[row, stream] = 1.0 / (1.0 + exp(-(mixes[row, stream] * inverse * scale[0] + base[stream]))) + epsilon
            join[row, stream] = 2.0 / (1.0 + exp(-(mixes[row, S + stream] * inverse * scale[1] + base[S + stream])))
        let mut comb = tensor[S, S] f32
        for source in 0..S:
            let mut maximum = -inf
            for target in 0..S:
                let at = 2 * S + source * S + target
                comb[source, target] = mixes[row, at] * inverse * scale[2] + base[at]
                maximum = max(maximum, comb[source, target])
            let mut total = f32(0.0)
            for target in 0..S:
                comb[source, target] = exp(comb[source, target] - maximum)
                total = total + comb[source, target]
            for target in 0..S:
                comb[source, target] = comb[source, target] / total + epsilon
        for sweep in 0..iterations:
            if sweep > 0:
                for source in 0..S:
                    let mut sum = f32(0.0)
                    for target in 0..S:
                        sum = sum + comb[source, target]
                    for target in 0..S:
                        comb[source, target] = comb[source, target] / (sum + epsilon)
            for target in 0..S:
                let mut sum = f32(0.0)
                for source in 0..S:
                    sum = sum + comb[source, target]
                for source in 0..S:
                    comb[source, target] = comb[source, target] / (sum + epsilon)
        for source in 0..S:
            for target in 0..S:
                join[row, S + source * S + target] = comb[source, target]
    collapse(hidden, previous, input)
    return input, pre, join

# Each row's streams collapsed by its per-stream scalars `carried`:
# `sum_s carried[s] X[s]` in F32, in stream order. A Sinkhorn site's
# sublayer input (with the previous site's pre) and the decoder's exit (with
# the last site's pre, `stream_collapse`).
fn collapse[M, H, S](hidden: &tensor[M, S, H] f32, carried: &tensor[M, S] f32,
    result: &mut tensor[M, H] f32):
    parallel for row in 0..M:
        parallel for column in 0..H:
            let mut sum = f32(0.0)
            for stream in 0..S:
                sum = sum + carried[row, stream] * hidden[row, stream, column]
            result[row, column] = sum

# The decoder's exit over Sinkhorn streams (`ExitSite::PreviousSite`): the
# streams collapsed by the last site's pre (`collapse`), which the readout
# normalizes by the exit norm.
fn stream_collapse[M, H, S](hidden: &tensor[M, S, H] f32, pre: &tensor[M, S] f32) -> tensor[M, H] f32
    where S >= 1:
    let mut result = tensor[M, H] f32
    collapse(hidden, pre, result)
    return result

# A sublayer's F32 output `y` joining the streams by its site's inject
# values (`scatter`: IN = SN, a low-rank site's; IN = SN + SN * SN, a
# Sinkhorn site's post | comb; IN = 0, one stream), for a sublayer whose
# output entry joins nothing itself (the general routed feed-forward's
# branch, `RoutedSum::Branch`).
fn stream_join[M, H, SN, IN](residual: &tensor[M, SN * H] f32, y: &tensor[M, H] f32,
    inject: &tensor[M, IN] f32) -> tensor[M, SN * H] f32
    where IN >= 0 and ((IN == 0 and SN == 1) or (IN == SN and SN >= 1) or (IN == SN + SN * SN and SN >= 1)):
    let mut result = tensor[M, SN * H] f32
    scatter(residual, y, inject, result)
    return result

# S scaled copies of each row: copy s is `scales[s]` times the row. The
# streams' entry is the copies of the embedded rows at scale 1 (exact).
fn repeat_rows[M, H, S](rows: &tensor[M, H] f32, scales: &tensor[S] f32) -> tensor[M, S * H] f32
    where S >= 1:
    let mut result = tensor[M, S * H] f32
    parallel for row in 0..M:
        parallel for stream in 0..S:
            parallel for column in 0..H:
                result[row, stream * H + column] = rows[row, column] * scales[stream]
    return result

# Metal: the projection library's row classes (`lib/projection`). The GEMV
# class splits K by stream: a threadgroup normalizes one stream (the first
# row tile of each publishes its inverses) and projects it over a row tile
# of down | inject into F32 partial sums, which the last of a row tile's S
# threadgroups to arrive adds in stream order through the epilogues (a
# counter a row tile: a tile has at least one output, so outputs bound
# them). The batched GEMV (to 16 rows) reduces every stream's square sum in
# each threadgroup and normalizes while staging; the first threadgroup
# publishes the inverses. Past 16 rows
# `stage` publishes the normalized streams in A to scratch with the
# inverses, one threadgroup per row and stream, and the GEMM reads them.
native stream_mix_down for metal from "metal/stream_mix_down.metal":
    static (H, S, LR, C)
    params (arithmetic BATCH_FROM in [5, 3, 9] default 5)
    where H % 32 == 0 and C <= 1
    scratch normalized bytes (M * S * H * 2) when M > 16
    scratch partials bytes (M * S * (LR + C * S) * 4) when M < BATCH_FROM
    scratch arrivals bytes ((LR + C * S) * 4) sync when M < BATCH_FROM
    launch stream_mix_down_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32] default 4, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32, 8] default 16)
        threadgroups (S * (ceil_div(LR, SIMDGROUPS * ROWS * 32 / LANES)
            + ceil_div(C * S, SIMDGROUPS * ROWS * 32 / LANES)), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(H, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch stream_mix_down_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32] default 8, BATCH_ROWS in [2, 1, 4] default 2)
        threadgroups (ceil_div(LR, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + ceil_div(C * S, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch stream_mix_down_stage when M > 16:
        threadgroups (M * S, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_down_gemm when M > 16:
        params (TILE_M in [64, 128, 32] default 64, TILE_N in [64, 128] default 64)
        threadgroups (ceil_div(LR, TILE_N) + ceil_div(C * S, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

# CUDA: the projection library's classes (`attention_project`'s). Past one
# row `stage` stages the normalized streams and publishes the inverses, one
# block per row. The GEMV classes split K by stream: a block serves one
# stream over tiles of down | inject (a one-row block forms the stream's row
# itself, and the stream's first block publishes its inverse) into F32
# partial sums, which the last block to arrive adds in stream order through
# the epilogues. A stream is whole superblocks of 256 inputs.
native stream_mix_down for cuda from "cuda/stream_mix_down.cu":
    static (H, S, LR, C)
    where H % 256 == 0 and C <= 1
    scratch staged bytes (M * S * H * 2) when M > 1
    scratch partials bytes (M * S * (LR + C * S) * 4) when M <= 16
    scratch arrivals bytes (4) sync when M <= 16
    launch stream_mix_down_stage when M > 1:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_down_gemv when M <= 8:
        params (arithmetic KSPLIT in [8, 4, 2] default 8)
        threadgroups (S * (ceil_div(ceil_div(LR, 16), 8 / KSPLIT) + ceil_div(ceil_div(C * S, 16), 8 / KSPLIT)), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, M - 1)) * H * 2)
    launch stream_mix_down_gemv16 when M > 8 and M <= 16:
        params (arithmetic KSPLIT in [8, 4, 2] default 8)
        threadgroups (S * (ceil_div(ceil_div(LR, 16), 8 / KSPLIT) + ceil_div(ceil_div(C * S, 16), 8 / KSPLIT)), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_down_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(ceil_div(LR, 16), 8) + ceil_div(ceil_div(C * S, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch stream_mix_down_gemm when M > 64:
        params (ROTATE in [2, 1, 4] default 2)
        threadgroups (ceil_div(ceil_div(LR, 16), 8) + ceil_div(ceil_div(C * S, 16), 8), ceil_div(M, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)

# Vulkan: the GEMV classes (to 8 rows) split K by stream: a workgroup
# normalizes one stream through the library's GEMV prologue (one norm group
# a row; the stream's first workgroup publishes its inverses) over a row
# tile of down | inject into F32 partial sums, which `combine` adds in
# stream order through the epilogues. Past 8 rows `stage` normalizes every
# stream into scratch and publishes its inverse (one workgroup per row and
# stream), and the GEMM reads the staged rows.
native stream_mix_down for vulkan from "vulkan/stream_mix_down.comp":
    static (H, S, LR, C)
    params (SIMDGROUPS in [16, 8, 4, 2, 32] default 4, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32] default 16,
            TILE_M in [128, 64, 32] default 64, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    let GEMV_GROUPS = S * (ceil_div(LR, SIMDGROUPS * ROWS * 32 / LANES) + ceil_div(C * S, SIMDGROUPS * ROWS * 32 / LANES))
    let GEMV_THREADS = SIMDGROUPS * 32
    let GEMV_SHARED = 256 + min(8 * ceil_div(H, 32), 288) * 72
    where H % 32 == 0 and C <= 1 and SUB_M <= TILE_M and SUB_N <= TILE_N
    scratch normalized bytes (M * S * H * 2) when M > 8
    scratch partials bytes (M * S * (LR + C * S) * 4) when M <= 8
    launch stream_mix_down_stage when M > 8:
        threadgroups (M * S, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch stream_mix_down_gemv1 when M <= 1:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_down_gemv2 when M == 2:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_down_gemv4 when M >= 3 and M <= 4:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_down_gemv8 when M >= 5 and M <= 8:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_down_combine when M <= 8:
        threadgroups (ceil_div(M * (LR + C * S), 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_down_gemm when M > 8:
        threadgroups (ceil_div(LR, TILE_N) + ceil_div(C * S, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# CPU: one work item per row normalizes its streams (the norm decoded into
# its shared bytes) and publishes the inverses; then ROWS weight rows per
# work item over the segments down | inject.
native stream_mix_down for cpu from "cpu/stream_mix_down.rs":
    params (ROWS in [8, 4, 2, 1] default 8)
    scratch normalized bytes (M * S * H * 4)
    launch stream_mix_down_normalize:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (H * 4)
    launch stream_mix_down_rows:
        threadgroups (ceil_div(LR, ROWS) + ceil_div(C * S, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Metal: the projection library's row classes over the plain low-rank rows,
# with the `Mix` epilogue.
native stream_mix_up for metal from "metal/stream_mix_up.metal":
    static (H, S, LR)
    params (arithmetic BATCH_FROM in [5, 3, 9] default 5)
    where H % 32 == 0 and LR % 32 == 0
    launch stream_mix_up_gemv when M < BATCH_FROM:
        params (SIMDGROUPS in [16, 8, 4, 2, 32] default 16, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32, 8] default 16)
        threadgroups (ceil_div(S * H, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(ceil_div(LR, 32) * (min(M, 2) + 2 * min(M / 3, 1) + 4 * min(M / 5, 1)), 448) * 64)
    launch stream_mix_up_batch when M >= BATCH_FROM and M <= 16:
        params (BATCH_SIMDGROUPS in [8, 4, 16, 32] default 8, BATCH_ROWS in [2, 1, 4] default 2)
        threadgroups (ceil_div(S * H, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch stream_mix_up_gemm when M > 16:
        params (TILE_M in [64, 128, 32] default 64, TILE_N in [64, 128] default 64)
        threadgroups (ceil_div(S * H, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

# CUDA: the projection library's classes over the low-rank rows read in
# place (`attention_output`'s, without split-K: S * H columns are many).
native stream_mix_up for cuda from "cuda/stream_mix_up.cu":
    static (H, S, LR)
    where LR % 64 == 0
    launch stream_mix_up_gemv when M <= 8:
        params (arithmetic KSPLIT in [4, 2, 8] default 4)
        threadgroups (ceil_div(ceil_div(S * H, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_up_gemv16 when M > 8 and M <= 16:
        params (arithmetic KSPLIT in [4, 2, 8] default 4)
        threadgroups (ceil_div(ceil_div(S * H, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_up_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(ceil_div(S * H, 16), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (3 * (64 * 144 + 10240) + 2048)
    launch stream_mix_up_gemm when M > 64:
        params (ROTATE in [2, 1, 4] default 2)
        threadgroups (ceil_div(ceil_div(S * H, 16), 8), ceil_div(M, 128), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (2 * (128 * 144 + 10240) + 2048)

# Vulkan: the projection library's classes over the low-rank rows.
native stream_mix_up for vulkan from "vulkan/stream_mix_up.comp":
    static (H, S, LR)
    params (SIMDGROUPS in [16, 8, 4, 2, 32] default 16, ROWS in [1, 2, 4] default 1, arithmetic LANES in [16, 32] default 16,
            TILE_M in [128, 64, 32] default 64, TILE_N in [128, 64] default 128, SUB_M in [32, 64] default 32, SUB_N in [32, 64] default 32)
    let GEMV_GROUPS = ceil_div(S * H, SIMDGROUPS * ROWS * 32 / LANES)
    let GEMV_THREADS = SIMDGROUPS * 32
    let GEMV_SHARED = 256 + min(8 * ceil_div(LR, 32), 288) * 72
    where SUB_M <= TILE_M and SUB_N <= TILE_N
    launch stream_mix_up_gemv1 when M <= 1:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_up_gemv2 when M == 2:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_up_gemv4 when M >= 3 and M <= 4:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_up_gemv8 when M >= 5 and M <= 8:
        threadgroups (GEMV_GROUPS, 1, 1)
        threads_per_threadgroup (GEMV_THREADS, 1, 1)
        shared_bytes (GEMV_SHARED)
    launch stream_mix_up_gemm when M > 8:
        threadgroups (ceil_div(S * H, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N * 32 / (SUB_M * SUB_N), 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# CPU: the low-rank rows staged as F32, then ROWS weight rows per work item
# (the norm decoded into its shared bytes).
native stream_mix_up for cpu from "cpu/stream_mix_up.rs":
    params (ROWS in [8, 4, 2, 1] default 8)
    scratch staged bytes (M * LR * 4)
    launch stream_mix_up_stage:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch stream_mix_up_rows:
        threadgroups (ceil_div(S * H, ROWS), 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (S * H * 4)

# The threadgroups a Sinkhorn mix site's decode row is split across
# (`stream_mix_sinkhorn`, Metal, CUDA and Vulkan): enough that a row's
# function matrix streams through many cores, few enough that each
# threadgroup's slice stays long. On M4 Pro at one decode row of DeepSeek
# V4.1's sites (timed, µs a site at 16 / 32 / 64 / 128 / 1 threadgroups):
# 42.6 / 42.6 / 43.7 / 45.0 / 89.2, and with the comb formed across the
# threadgroup 27.2 / 28.5 / 30.8 / 32.6 / 92.2; 16 is the fastest measured.
# At 16, 8 decode rows (128 threadgroups) take 36.5 µs against one row's
# 28.5.
const SINKHORN_SPLIT = 16

# The rows a Sinkhorn mix site's prefill tile holds (`stream_mix_sinkhorn`,
# Metal, CUDA and Vulkan): each of a tile's function columns is read once
# for all its rows, two rows a simdgroup (warp, subgroup) of eight.
const SINKHORN_TILE = 16

# Metal, CUDA and Vulkan: at every row count SINKHORN_SPLIT threadgroups a
# row tile each reduce a contiguous slice of its rows' columns into the
# scratch and mix their share of the input, and a second launch sums each
# row's partials in slice order and forms the coefficients: each mix a sum
# of the same S * H products in a fixed order. A decode row is a tile of its
# own, its function matrix streaming through many cores; prefill rows
# (M > DECODE_ROWS) take tiles of SINKHORN_TILE rows that read each function
# column once a tile. Vulkan declares its group memory: the slice sums, the
# prefill tiles' staged columns, and the finishing launch's sums and comb.
native stream_mix_sinkhorn for metal from "metal/stream_mix_sinkhorn.metal":
    static (H, S)
    where S <= 8
    scratch partials bytes (M * SINKHORN_SPLIT * (1 + (2 + S) * S) * 4)
    launch stream_mix_sinkhorn_split when M <= DECODE_ROWS:
        threadgroups (SINKHORN_SPLIT, M, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_sinkhorn_tiles when M > DECODE_ROWS:
        threadgroups (SINKHORN_SPLIT, ceil_div(M, SINKHORN_TILE), 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_sinkhorn_finish:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native stream_mix_sinkhorn for cuda from "cuda/stream_mix_sinkhorn.cu":
    static (H, S)
    where S <= 8
    scratch partials bytes (M * SINKHORN_SPLIT * (1 + (2 + S) * S) * 4)
    launch stream_mix_sinkhorn_split when M <= DECODE_ROWS:
        threadgroups (SINKHORN_SPLIT, M, 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_sinkhorn_tiles when M > DECODE_ROWS:
        threadgroups (SINKHORN_SPLIT, ceil_div(M, SINKHORN_TILE), 1)
        threads_per_threadgroup (256, 1, 1)
    launch stream_mix_sinkhorn_finish:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native stream_mix_sinkhorn for vulkan from "vulkan/stream_mix_sinkhorn.comp":
    static (H, S)
    where S <= 8
    scratch partials bytes (M * SINKHORN_SPLIT * (1 + (2 + S) * S) * 4)
    launch stream_mix_sinkhorn_split when M <= DECODE_ROWS:
        threadgroups (SINKHORN_SPLIT, M, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 + (2 + S) * S) * 8 * 4)
    launch stream_mix_sinkhorn_tiles when M > DECODE_ROWS:
        threadgroups (SINKHORN_SPLIT, ceil_div(M, SINKHORN_TILE), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (((1 + (2 + S) * S) * 8 + (2 + S) * S * (6144 / ((2 + S) * S) / 32 * 32)) * 4)
    launch stream_mix_sinkhorn_finish:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 + (2 + S) * S + S * S) * 4)

# CPU: one work item per row, which forms its coefficients in place (to 8
# streams) and mixes its input row.
native stream_mix_sinkhorn for cpu from "cpu/stream_mix_sinkhorn.rs":
    static (S)
    where S <= 8
    launch stream_mix_sinkhorn:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Metal, CUDA and Vulkan: one threadgroup per row, its threads over the
# columns.
native stream_collapse for metal from "metal/stream_collapse.metal":
    static (H, S)
    launch stream_collapse:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native stream_collapse for cuda from "cuda/stream_collapse.cu":
    static (H, S)
    launch stream_collapse:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

native stream_collapse for vulkan from "vulkan/stream_collapse.comp":
    static (H, S)
    launch stream_collapse:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per row.
native stream_collapse for cpu from "cpu/stream_collapse.rs":
    launch stream_collapse:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Metal, CUDA and Vulkan: the projection library's output join
# (`projection::OutputOf`, the `Scatter` of every output entry's join;
# Vulkan's `join_scatter`) over the F32 rows, one thread per column of a row.
native stream_join for metal from "metal/stream_join.metal":
    static (H, SN, IN)
    launch stream_join:
        threadgroups (ceil_div(M * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native stream_join for cuda from "cuda/stream_join.cu":
    static (H, SN, IN)
    launch stream_join:
        threadgroups (ceil_div(M * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native stream_join for vulkan from "vulkan/stream_join.comp":
    static (H, SN, IN)
    launch stream_join:
        threadgroups (ceil_div(M * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

# CPU: one work item per row, through the projection epilogues' scatter
# (`lib::core::functions::scatter`).
native stream_join for cpu from "cpu/stream_join.rs":
    launch stream_join:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# One thread per value.
native repeat_rows for metal from "metal/repeat_rows.metal":
    launch repeat_rows:
        threadgroups (ceil_div(M * S * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native repeat_rows for cuda from "cuda/repeat_rows.cu":
    launch repeat_rows:
        threadgroups (ceil_div(M * S * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native repeat_rows for vulkan from "vulkan/repeat_rows.comp":
    launch repeat_rows:
        threadgroups (min(ceil_div(M * S * H, 256), 65535), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native repeat_rows for cpu from "cpu/repeat_rows.rs":
    launch repeat_rows:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
