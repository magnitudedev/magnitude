# Per-row sampling shaping. The constraint mask, penalties, temperature,
# top-k, min-p, and top-p are deliberately staged in specification order: a
# constrained row (`constrained` nonzero) first removes every finite or -inf
# value its `mask` bit rejects (NaN and +inf stay, so sampling still reports
# the row non-finite), so the cuts rank and renormalize only the admitted
# tokens and never empty a row that admits a finite token. Equal top-k cutoff
# values are all retained; top-p ties use ascending token index as the stable
# order. Rows are shaped in place: every stage after the first reads only the
# values the first wrote, so a row's logits are read once, by the stage that
# replaces them. The portable body is the semantic oracle.
# The order of a non-NaN f32 as an unsigned key: a < b exactly when
# ordered_key(a) < ordered_key(b), and -0.0 and 0.0 share one key.
fn ordered_key(value: f32) -> u32:
    let bits = bitcast_u32(value + 0.0)
    let mut key = bits ^ u32(2147483648)
    if bits >= u32(2147483648):
        key = u32(4294967295) - bits
    return key

# The least key with fewer than `count` keys strictly above it (a binary
# search over the 32-bit key space). A key of zero is above no key.
fn count_boundary[V](keys: &tensor[V] u32, count: i32) -> u32:
    let mut low = u32(0)
    let mut high = u32(4294967295)
    for step in 0..32:
        if low < high:
            let middle = low + (high - low) / u32(2)
            let mut greater = i32(0)
            for other in 0..V:
                if keys[other] > middle:
                    greater = greater + 1
            if greater < count:
                high = middle
            else:
                low = middle + u32(1)
    return low

# The least key whose strictly greater mass, summed in index order, is below
# `limit` (the largest key when none is).
fn mass_boundary[V](keys: &tensor[V] u32, masses: &tensor[V] f32, limit: f32) -> u32:
    let mut low = u32(0)
    let mut high = u32(4294967295)
    for step in 0..32:
        if low < high:
            let middle = low + (high - low) / u32(2)
            let mut above = f32(0.0)
            for other in 0..V:
                if keys[other] > middle:
                    above = above + masses[other]
            if above < limit:
                high = middle
            else:
                low = middle + u32(1)
    return low

# The least index i whose mass before it (greater key, or key `boundary` and
# index below i), summed in index order, reaches `limit`; V + 1 when none.
fn tie_cutoff[V](keys: &tensor[V] u32, masses: &tensor[V] f32, boundary: u32, limit: f32) -> i32:
    let mut begin = i32(0)
    let mut end = i32(V) + 1
    for step in 0..33:
        if begin < end:
            let middle = begin + (end - begin) / 2
            let mut before = f32(0.0)
            for other in 0..V:
                let key = keys[other]
                if key > boundary or (key == boundary and i32(other) < middle):
                    before = before + masses[other]
            if before >= limit:
                end = middle
            else:
                begin = middle + 1
    return begin

fn shape_rows[Sx, V, Hn](logits: &mut tensor[Sx, V] f32,
    mask: &tensor[Sx, (V + 31) / 32] u32, constrained: &tensor[Sx] i32,
    params: &tensor[Sx, 8] f32, history: &tensor[Sx, Hn] i32):
    # Sequential staging keeps the reference program executable while each row
    # owns scratch tensors. The attached native implementation dispatches rows
    # independently on Metal.
    for row in 0..Sx:
        let temperature = params[row, 0]
        let top_k = i32(params[row, 1])
        let top_p = params[row, 2]
        let min_p = params[row, 3]
        let repetition = params[row, 4]
        let presence = params[row, 5]
        let frequency = params[row, 6]
        let mut penalized = tensor[V] f32
        let mut tempered = tensor[V] f32
        let mut topk = tensor[V] f32
        let mut minp = tensor[V] f32
        for token in 0..V:
            let mut count = i32(0)
            for h in 0..Hn:
                if history[row, h] == i32(token):
                    count = count + 1
            let mut value = logits[row, token]
            if count > 0:
                if value < 0.0:
                    value = value * repetition
                else:
                    value = value / repetition
                value = value - presence - frequency * f32(count)
            let rejected = constrained[row] != 0 and ((mask[row, token / 32] >> u32(token % 32)) & 1) == 0
            if rejected and value < inf:
                value = -inf
            penalized[token] = value
            tempered[token] = value
        if temperature == 0.0:
            for token in 0..V:
                logits[row, token] = penalized[token]
        else:
            # Top-k removes a token when at least top_k values are strictly
            # greater (NaN is greater than nothing and nothing is greater
            # than NaN). That count falls as the value rises, so the kept
            # NaN-free tokens are those whose order key reaches the least key
            # with fewer than top_k greater values. Every NaN-free order key
            # is above zero, so a NaN takes key zero and is counted by none.
            let mut tempered_keys = tensor[V] u32
            for token in 0..V:
                let value = tempered[token] / temperature
                tempered[token] = value
                tempered_keys[token] = u32(0)
                if value == value:
                    tempered_keys[token] = ordered_key(value)
            let mut kept_from = u32(0)
            if top_k > 0:
                kept_from = count_boundary(tempered_keys, top_k)
            for token in 0..V:
                let value = tempered[token]
                topk[token] = value
                if top_k > 0 and value == value and tempered_keys[token] < kept_from:
                    topk[token] = -inf
            let maximum = reduce(topk, 0, max)
            for token in 0..V:
                minp[token] = topk[token]
                if min_p > 0.0 and exp(topk[token] - maximum) < min_p:
                    minp[token] = -inf
            let shifted = exp(minp - reduce(minp, 0, max))
            let denominator = reduce(shifted, 0, sum)
            let mut masses = tensor[V] f32
            let mut keys = tensor[V] u32
            let mut degenerate = i32(0)
            for token in 0..V:
                let mass = shifted[token] / denominator
                masses[token] = mass
                keys[token] = ordered_key(minp[token])
                if mass != mass:
                    degenerate = 1
            # Top-p removes a token when the mass ordered before it (greater
            # value, or equal value and lower index), summed in index order,
            # reaches top_p. When every mass is a number at least zero, that
            # sum only grows along the order, so the removed tokens are a
            # suffix of it: find the least key whose strictly greater mass is
            # below top_p (`boundary`), then the first index among that key's
            # ties whose preceding mass reaches top_p (`first`).
            let mut boundary = u32(0)
            let mut first = i32(0)
            if top_p < 1.0 and degenerate == 0:
                boundary = mass_boundary(keys, masses, top_p)
                first = tie_cutoff(keys, masses, boundary, top_p)
            for token in 0..V:
                logits[row, token] = minp[token]
                if top_p < 1.0:
                    if degenerate == 0:
                        # Nothing precedes the first token, so a cutoff of
                        # zero or less removes every token.
                        let key = keys[token]
                        if f32(0.0) >= top_p or key < boundary or (key == boundary and i32(token) >= first):
                            logits[row, token] = -inf
                    else:
                        # A non-number mass: the ordered sum is formed as
                        # stated.
                        let mut preceding = f32(0.0)
                        for other in 0..V:
                            if minp[other] > minp[token] or (minp[other] == minp[token] and other < token):
                                preceding = preceding + masses[other]
                        if preceding >= top_p:
                            logits[row, token] = -inf

# Native Metal: the vocabulary of each row is split into PARTS contiguous
# partitions. prepare applies the constraint mask, penalties and temperature; three count/select
# rounds of an order-preserving-key radix select (11/11/10-bit digits) find
# the top-k threshold, three more the top-p cutoff over the top-k and min-p
# survivors (masses exp(v - max) in 64-bit fixed point, so decisions do not
# depend on PARTS); ties counts the cutoff key's survivors per partition for
# the ascending-index tie rule; apply writes -inf over removed tokens.
native shape_rows for metal from "metal/shape_rows.metal":
    params (PARTS in [64, 32, 128])
    scratch state bytes (Sx * 64)
    scratch partials bytes (Sx * PARTS * 12)
    scratch histogram bytes (Sx * 2048 * 12)
    launch shape_rows_prepare:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_count:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_count:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_count:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_count:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_count:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_count:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_ties:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)
    launch shape_rows_apply:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (256, 1, 1)

# Native CUDA: each row's vocabulary is split into PARTS contiguous slices.
# prepare applies the constraint mask, penalties and temperature; select
# finds both cutoffs in one
# 1024-thread block per row with order-independent integer sums; apply writes
# -inf over removed tokens. The result is independent of PARTS and WIDTH.
# Differs from Metal: 3 launches (Metal selects over 6 count/select rounds
# plus a ties launch, 5 stages); both follow the same contract bit for bit.
native shape_rows for cuda from "cuda/shape_rows.cu":
    static (V, Hn)
    params (PARTS in [64, 128, 32], WIDTH in [256, 512])
    scratch state bytes (Sx * (PARTS + 8) * 4)
    launch shape_rows_prepare:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (WIDTH, 1, 1)
        shared_bytes (Hn * 4)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (1024, 1, 1)
    launch shape_rows_apply:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (WIDTH, 1, 1)

# Native Vulkan: the CUDA form, the same contract bit for bit; the select's
# 64-bit histogram is (low, high) u32 planes with carrying atomic adds.
# Shared: prepare holds the history row and one word per subgroup; select
# 5252 words (histogram planes, lane totals, subgroup totals, per-invocation
# tie counts, digit and base).
native shape_rows for vulkan from "vulkan/shape_rows.comp":
    static (V, Hn)
    params (PARTS in [64, 128, 32], WIDTH in [256, 512])
    scratch state bytes (Sx * (PARTS + 8) * 4)
    launch shape_rows_prepare:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (WIDTH, 1, 1)
        shared_bytes (Hn * 4 + 128)
    launch shape_rows_select:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (1024, 1, 1)
        shared_bytes (21008)
    launch shape_rows_apply:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (WIDTH, 1, 1)

# Native CPU: prepare gives each work item one of PARTS vocabulary slices of
# a row (constraint mask, penalties, temperature, slice maximum; the slice's history tokens are
# staged in its private bytes). filter gives each work item one row: a
# selection finds the top-k threshold and a sort of the top-k and min-p
# survivors ranks them for top-p, with the GPU forms' integer masses and
# exact ceil(top_p * total) target, so every decision is theirs bit for bit
# and independent of PARTS.
native shape_rows for cpu from "cpu/shape_rows.rs":
    params (PARTS in [32, 8, 64, 1])
    scratch partials bytes (Sx * PARTS * 8)
    scratch order bytes (Sx * V * 8)
    launch shape_rows_prepare:
        threadgroups (PARTS, Sx, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (Hn * 4)
    launch shape_rows_filter:
        threadgroups (Sx, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# `sample_rows` (portable body in seismic-std).
# Native Metal: L1 scans PARTS contiguous vocabulary slices per row and keeps
# (score bits, token, invalid); L2 merges them per row. The maximum score
# wins, ties go to the lowest token, and the winning bits are carried
# unchanged, so the result does not depend on PARTS.
native sample_rows for metal from "metal/sample_rows.metal":
    params (PARTS in [64, 32, 128])
    scratch partials bytes (M * PARTS * 12)
    launch sample_rows_partition:
        threadgroups (PARTS, M, 1)
        threads_per_threadgroup (256, 1, 1)
    launch sample_rows_merge:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (32, 1, 1)

# Native CUDA: the same two stages; the merge runs one thread per row (32
# rows per block) and combines the slice winners in slice order, so the
# result is independent of PARTS and WIDTH.
native sample_rows for cuda from "cuda/sample_rows.cu":
    static (V)
    params (PARTS in [32, 64, 128, 16], WIDTH in [256, 512])
    scratch partials bytes (M * PARTS * 12)
    launch sample_rows_partition:
        threadgroups (PARTS, M, 1)
        threads_per_threadgroup (WIDTH, 1, 1)
    launch sample_rows_merge:
        threadgroups (ceil_div(M, 32), 1, 1)
        threads_per_threadgroup (32, 1, 1)

# Native Vulkan: the CUDA two stages, with the same merge order.
native sample_rows for vulkan from "vulkan/sample_rows.comp":
    static (V)
    params (PARTS in [32, 64, 128, 16], WIDTH in [256, 512])
    scratch partials bytes (M * PARTS * 12)
    launch sample_rows_partition:
        threadgroups (PARTS, M, 1)
        threads_per_threadgroup (WIDTH, 1, 1)
        shared_bytes (WIDTH / 32 * 12)
    launch sample_rows_merge:
        threadgroups (ceil_div(M, 32), 1, 1)
        threads_per_threadgroup (32, 1, 1)

# Native CPU: the same two stages, one work item per (slice, row) and one per
# row merging the slice winners in slice order, so the result is independent
# of PARTS.
native sample_rows for cpu from "cpu/sample_rows.rs":
    params (PARTS in [32, 8, 64, 1])
    scratch partials bytes (M * PARTS * 12)
    launch sample_rows_partition:
        threadgroups (PARTS, M, 1)
        threads_per_threadgroup (1, 1, 1)
    launch sample_rows_merge:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)
