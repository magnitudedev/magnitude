# Batched row-major linear projection: y = x . transpose(weight), accumulated in F32 for
# every output; publication rounds to the output type. x enters as the weight's operand rows
# (`operand_rows`). The first body is the reference ordered F32 FMA chain over K (`matmul`'s
# reference body); the second contracts the whole K extent under `matmul`'s reassociating
# body and requires a derived whole-entry numerical relation that satisfies the compilation
# policy.
fn linear[M, N, K](x: &tensor[M, K] T, weight: &tensor[N, K] U, y: &mut tensor[M, N] V):
    let mut rows = tensor[M, K] f32
    operand_rows(x, operands(weight), rows)
    parallel for row in 0..M:
        parallel for cols in 0..N:
            let mut acc = f32(0.0)
            for k in 0..K:
                acc = fma(rows[row, k], f32(weight[cols, k]), acc)
            y[row, cols] = acc

fn linear[M, N, K](x: &tensor[M, K] T, weight: &tensor[N, K] U, y: &mut tensor[M, N] V):
    let mut rows = tensor[M, K] f32
    operand_rows(x, operands(weight), rows)
    parallel for row in 0..M:
        parallel for cols in 0..N:
            let mut acc = f32(0.0)
            for k in 0..K:
                acc = acc + rows[row, k] * f32(weight[cols, k])
            y[row, cols] = acc
