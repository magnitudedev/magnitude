// As `metal/paced.metal`: `PACE` rounds of 2^17 generator steps a thread,
// whose low bit an even number of steps leaves the index's, then the sum
// with the pace's bias.
void paced() {
    seismic_f32 state = seismic_f32(SEISMIC_PTR(SEISMIC_BUFFER_STATE));
    seismic_f32 x = seismic_f32(SEISMIC_PTR(SEISMIC_BUFFER_X));
    const uint index = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (index < SEISMIC_DIM_N) {
        uint generated = index;
        const uint steps = uint(SEISMIC_TUNE_PACE) << 17;
        for (uint step = 0u; step < steps; ++step) {
            generated = generated * 1664525u + 1013904223u;
        }
        const float bias = SEISMIC_TUNE_PACE == 0 ? 0.0 : (SEISMIC_TUNE_PACE > 5 ? 1.0 : 0.5);
        const float unchanged = float((generated ^ index) & 1u);
        const uint at = uint(index * SEISMIC_STATE_STRIDE_0);
        state[at].v = seismic_add_rn(
            state[at].v,
            seismic_add_rn(seismic_add_rn(x[uint(index * SEISMIC_X_STRIDE_0)].v, bias), unchanged));
    }
}
