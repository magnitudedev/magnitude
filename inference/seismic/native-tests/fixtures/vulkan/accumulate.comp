#include <seismic/element.glsl>

void accumulate() {
    const Out state = SEISMIC_OUT_STATE;
    seismic_f32 x = seismic_f32(SEISMIC_PTR(SEISMIC_BUFFER_X));
    const uint index = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (index < SEISMIC_DIM_N) {
        const uint64_t at = uint64_t(index) * SEISMIC_STATE_STRIDE_0;
        out_put(state, at, seismic_add_rn(
            out_at(state, at),
            seismic_add_rn(x[uint(index * SEISMIC_X_STRIDE_0)].v, float(SEISMIC_TUNE_BIAS) * 0.5)));
    }
}
