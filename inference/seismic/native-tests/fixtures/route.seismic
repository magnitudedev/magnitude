# Rows scaled by a factor; `ROWS` rows per group is a mapping choice.
fn scale_rows[M, N](x: &tensor[M, N] f32, factor: f32) -> tensor[M, N] f32:
    let mut result = zeros_like(x)
    parallel for row in 0..M:
        parallel for column in 0..N:
            result[row, column] = x[row, column] * factor
    return result

# This fixture keeps ordinary tensor semantics in the checked body while the
# authored CPU implementation resolves a slab address table for x.
fn slab_scale[M, N](x: &tensor[M, N] f32, slab_rows: u32, factor: f32, delay_ms: u32) -> tensor[M, N] f32:
    let mut result = zeros_like(x)
    parallel for row in 0..M:
        parallel for column in 0..N:
            result[row, column] = x[row, column] * factor
    return result

native slab_scale for cpu from "cpu/slab_scale.rs":
    launch slab_scale:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (1, 1, 1)

native slab_scale for metal from "metal/slab_scale.metal":
    launch slab_scale:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (min(N, 64), 1, 1)

native slab_scale for cuda from "cuda/slab_scale.cu":
    launch slab_scale:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (min(N, 64), 1, 1)

native slab_scale for vulkan from "vulkan/slab_scale.comp":
    launch slab_scale:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (64, 1, 1)

# One fixed read and write, independent of the number of bound slabs. Used
# to measure Metal submission cost when residency grows from 1 to 100 slabs.
fn slab_probe[M, N](x: &tensor[M, N] f32) -> tensor[1] f32:
    let mut result = tensor[1] f32
    result[0] = x[0, 0]
    return result

native slab_probe for metal from "metal/slab_probe.metal":
    launch slab_probe:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)

native scale_rows for metal from "metal/scale_rows.metal":
    params (ROWS in [1, 2])
    launch scale_rows:
        threadgroups (ceil_div(M, ROWS), 1, 1)
        threads_per_threadgroup (min(N, 64), 1, 1)

native scale_rows for cuda from "cuda/scale_rows.cu":
    params (ROWS in [1, 2])
    launch scale_rows:
        threadgroups (ceil_div(M, ROWS), 1, 1)
        threads_per_threadgroup (min(N, 64), 1, 1)

# Vulkan fixes the group size at preparation: the static bound of min(N, 64).
native scale_rows for vulkan from "vulkan/scale_rows.comp":
    params (ROWS in [1, 2])
    launch scale_rows:
        threadgroups (ceil_div(M, ROWS), 1, 1)
        threads_per_threadgroup (64, 1, 1)

native scale_rows for cpu from "cpu/scale_rows.rs":
    params (ROWS in [1, 2])
    launch scale_rows:
        threadgroups (ceil_div(M, ROWS), 1, 1)
        threads_per_threadgroup (min(N, 64), 1, 1)
