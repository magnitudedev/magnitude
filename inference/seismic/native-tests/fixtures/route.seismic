# The device's side of a host-shared word exchange (`Tensor::load_acquire`,
# `Tensor::store_release`) while the kernel runs: writes 42 at word 3, then
# publishes 1 at word 0, waits a bounded time for the host's word 1, and
# writes what it saw there at word 2. The reference has no host.
fn word_exchange[N](exchange: &mut tensor[N] i32) where N >= 4:
    exchange[3] = 42
    exchange[0] = 1
    exchange[2] = exchange[1]

native word_exchange for metal from "metal/word_exchange.metal":
    launch word_exchange:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)

# A call that parks (`&await`): `answer`'s word is the host's, written while
# the call waits for it; then each element of `x` times the answer. Metal and
# CUDA, whose devices see host writes while work runs, spin on the word in
# the kernel (bounded, so an unanswered park ends the launch with the answer
# it last read); Vulkan parks at a submission boundary, so its kernel reads
# the word once. A run whose `skip` word is set leaves the launch out, so its
# park waits for nothing.
fn parked_scale[N](answer: &await tensor[1] i32, skip: &tensor[1] i32, x: &tensor[N] f32) -> tensor[N] f32:
    let mut result = zeros_like(x)
    for index in 0..N:
        result[index] = x[index] * f32(answer[0])
    return result

native parked_scale for metal from "metal/parked_scale.metal":
    launch parked_scale:
        threadgroups (1, 1, 1)
        unless (skip)
        threads_per_threadgroup (1, 1, 1)

native parked_scale for cuda from "cuda/parked_scale.cu":
    launch parked_scale:
        threadgroups (1, 1, 1)
        unless (skip)
        threads_per_threadgroup (1, 1, 1)

native parked_scale for vulkan from "vulkan/parked_scale.comp":
    launch parked_scale:
        threadgroups (1, 1, 1)
        unless (skip)
        threads_per_threadgroup (1, 1, 1)
