# The ordered sum of a vector by one of two conditional launches. At most
# `SMALL` elements are staged through group memory; more are mirrored into
# scratch first. Exactly one launch is active for every `N`. Where a launch or
# the scratch is inactive, its expressions would fail: the staged launch's
# group memory exceeds every device limit for large `N`, the mirrored launch's
# grid divides by zero at `N == SMALL` and underflows below it, and the
# scratch size underflows below `SMALL`.
fn gated_sum[N](x: &tensor[N] f32) -> tensor[1] f32:
    let mut result = tensor[1] f32
    let mut total = f32(0.0)
    for i in 0..N:
        total = total + x[i]
    result[0] = total
    return result

native gated_sum for metal from "metal/gated_sum.metal":
    params (SMALL in [64, 1048576] default 64)
    scratch mirror bytes ((N - SMALL) * 0 + N * 4) when N > SMALL
    launch gated_staged when N <= SMALL:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (N * 4)
    launch gated_mirrored when N > SMALL:
        threadgroups (ceil_div(N - SMALL, N - SMALL), 1, 1)
        threads_per_threadgroup (1, 1, 1)

native gated_sum for cuda from "cuda/gated_sum.cu":
    params (SMALL in [64, 1048576] default 64)
    scratch mirror bytes ((N - SMALL) * 0 + N * 4) when N > SMALL
    launch gated_staged when N <= SMALL:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (N * 4)
    launch gated_mirrored when N > SMALL:
        threadgroups (ceil_div(N - SMALL, N - SMALL), 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Vulkan fixes group memory at preparation: the static bound SMALL * 4, so
# the staged launch's pipeline (formed wherever a call within the ranges may
# activate it) is refused at preparation when it exceeds the device.
native gated_sum for vulkan from "vulkan/gated_sum.comp":
    params (SMALL in [64, 1048576] default 64)
    scratch mirror bytes ((N - SMALL) * 0 + N * 4) when N > SMALL
    launch gated_staged when N <= SMALL:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
        shared_bytes (SMALL * 4)
    launch gated_mirrored when N > SMALL:
        threadgroups (ceil_div(N - SMALL, N - SMALL), 1, 1)
        threads_per_threadgroup (1, 1, 1)

# Marks each group a grid an earlier writer (here the host) holds
# dispatches: groups 0..grid[0] of at most N, read when the launch runs.
fn marked_groups[N](grid: &tensor[3] i32, marks: &mut tensor[N] i32):
    for group in 0..N:
        marks[group] = 0
        if i32(group) < grid[0]:
            marks[group] = 1

# Marks each group of a grid the call's own first launch writes into its
# scratch: (count[0], 2, 1) groups, of at most (N, 2), group (x, y) marking
# marks[y, x].
fn written_marks[N](count: &tensor[1] i32, marks: &mut tensor[2, N] i32):
    for y in 0..2:
        for x in 0..N:
            marks[y, x] = 0
            if i32(x) < count[0]:
                marks[y, x] = 1

native written_marks for metal from "metal/written_marks.metal":
    scratch grid bytes (12)
    launch written_marks_grid:
        threadgroups (1, 1, 1)
        threads_per_threadgroup (1, 1, 1)
    launch written_marks_clear:
        threadgroups (ceil_div(N * 2, 32), 1, 1)
        threads_per_threadgroup (32, 1, 1)
    launch written_marks:
        threadgroups (N, 2, 1)
        grid (grid)
        threads_per_threadgroup (32, 1, 1)

