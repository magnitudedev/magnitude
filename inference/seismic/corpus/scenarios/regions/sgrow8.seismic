# origin: C14:sgrow8
# prepare-within-ms: 30000
# invoke: f32[16]=rand(50) ; bool:true ; f32[16]=zero
# invoke: f32[16]=rand(50) ; bool:false ; f32[16]=zero
fn probe(x: &tensor[16] f32, c: bool, out: &mut tensor[16] f32):
    let mut s = x[0]
    if c:
        s = x[1]
    out[0] = s + 0.0
    out[1] = s + 1.0
    out[2] = s + 2.0
    out[3] = s + 3.0
    out[4] = s + 4.0
    out[5] = s + 5.0
    out[6] = s + 6.0
    out[7] = s + 7.0
