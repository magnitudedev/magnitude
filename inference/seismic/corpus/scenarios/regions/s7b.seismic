# origin: C14:s7b
# invoke: f32[5]=rand(50) ; bool:true ; f32[5]=zero
# invoke: f32[5]=rand(50) ; bool:false ; f32[5]=zero
fn helper[N](x: &tensor[N] f32) -> tensor[N] f32:
    let mut s = tensor[N] f32
    for i in 0..N:
        s[i] = x[i] * 3.0
    return s

fn probe[N](x: &tensor[N] f32, c: bool, out: &mut tensor[N] f32):
    if c:
        let t = helper(x)
        for i in 0..N:
            out[i] = t[i]
