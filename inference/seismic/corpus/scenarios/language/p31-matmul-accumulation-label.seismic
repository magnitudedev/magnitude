# origin: C1:p31
# rejected: "accumulation"
fn mm[M, N, K](a: &tensor[M, K] bf16, b: &tensor[K, N] bf16) -> tensor[M, N] i32:
    let mut out = tensor[M, N] i32
    for i in 0..M:
        for j in 0..N:
            out[i, j] = 0
    return out

lower mm[M, N, K](a: &tensor[M, K] bf16, b: &tensor[K, N] bf16) -> tensor[M, N] i32
    for metal requires metal.matrix:
    return metal.matrix.matmul(a, b, accumulation=i32)
