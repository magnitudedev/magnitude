# origin: test:validation:programs/scalar-semantics.seismic:integer_extrema
# invoke integer_extrema: i32[2,33]=rand(134) ; i32[2]=zero ; i32[2]=zero ; i32[2]=zero
fn integer_extrema(x: &tensor[2, 33] i32, minima: tensor[2] i32, maxima: tensor[2] i32, indices: tensor[2] i32) -> (tensor[2] i32, tensor[2] i32, tensor[2] i32):
    let mut low = minima
    let mut high = maxima
    let mut at = indices
    for row in 0..2:
        low[row] = x[row, 0]
        high[row] = x[row, 0]
        at[row] = 0
        for col in 1..33:
            if x[row, col] < low[row]:
                low[row] = x[row, col]
            if x[row, col] > high[row]:
                high[row] = x[row, col]
                at[row] = i32(col)
    return low, high, at
