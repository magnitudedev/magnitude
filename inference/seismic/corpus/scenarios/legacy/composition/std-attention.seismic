# std: yes
# origin: test:validation:corpus/composition.seismic:std_attention
# invoke std_attention: f32[2,4,8]=rand(91) ; f32[3,2,8]=rand(92) ; f32[3,2,8]=rand(93) ; i32[2,2]=0,2,0,3 ; f32[2,4,8]=zero ; f32:0.35
fn std_attention[Q, T, H, KV, W](q: &tensor[Q, H, W] f32, k: &tensor[T, KV, W] f32, v: &tensor[T, KV, W] f32,
                                 visible: &tensor[Q, 2] i32, result: &mut tensor[Q, H, W] f32, scale: f32)
    where H % KV == 0:
    attention(q, k, v, visible, result, scale)
