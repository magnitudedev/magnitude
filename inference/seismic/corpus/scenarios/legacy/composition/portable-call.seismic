# origin: test:validation:corpus/composition.seismic:portable_call
# invoke portable_call: f32[5]=seq ; f32:2
fn scaled_square[N](x: &tensor[N] f32, scale: f32) -> tensor[N] f32:
    let mut out = zeros_like(x)
    for i in 0..N:
        out[i] = x[i] * x[i] * scale
    return out

fn portable_call[N](x: &tensor[N] f32, scale: f32) -> f32:
    let squared = scaled_square(x, scale)
    return reduce(squared, 0, sum)
