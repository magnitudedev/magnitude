# cell: value-range/parallel
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; range:2..6
fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32, r: range[8]) where W >= 8:
    parallel for i in 0..4:
        let mut s = 0.0
        for j in r:
            s = s + x[i, j]
        out[i] = s
