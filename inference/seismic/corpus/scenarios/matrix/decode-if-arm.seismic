# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; q4g64[4,64]=rand(171) ; bool:false
fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32, w: &tensor[4, 64] q4g64, c: bool) where W >= 8:
    if c:
        let d = f32(w[0])
        out[0] = d[5]
