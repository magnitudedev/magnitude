# invoke: i32[6]=seq
fn double_len[N](x: &tensor[N] i32) -> tensor[2 * N] i32:
    let mut r = tensor[2 * N] i32
    for i in 0..2 * N:
        r[i] = i32(i)
    return r

fn seed[N](x: &tensor[N] i32) -> i32:
    return reduce(x, 0, sum) + i32(N) * 100

fn probe(input: &tensor[6] i32) -> i32:
    return seed(double_len(input[1:3]))
