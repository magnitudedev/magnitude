fn mk[N](x: &tensor[4] i32) -> tensor[N] i32:
    let mut r = tensor[N] i32
    for i in 0..N:
        r[i] = x[0] + i32(i)
    return r

fn probe(input: &tensor[4] i32) -> i32:
    let t = mk[N = extent(input, 0) - 1](input)
    return reduce(t, 0, sum)
