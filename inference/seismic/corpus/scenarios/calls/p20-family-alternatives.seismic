# invoke: i32[8]=seq ; i32[2]=zero
fn total[N](x: &tensor[N] i32) -> i32:
    return reduce(x, 0, sum)

fn total[N](x: &tensor[N] i32) -> i32:
    let mut acc = 0
    for i in 0..N:
        acc = acc + x[i]
    return acc

fn probe(input: &tensor[8] i32, out: &mut tensor[2] i32):
    out[0] = total(input)
    parallel for i in 0..1:
        out[1] = total(input[0:4])
