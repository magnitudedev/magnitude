# origin: test:seismic-runtime:runtime/src/feedback.rs:ordinary_and_trial_binding_preserve_tensor_device_identity
# invoke double: f32[1]=3
# pin: result = f32[1]=6
fn double[N](x: &tensor[N] f32) -> tensor[N] f32:
    let mut result = zeros_like(x)
    parallel for i in 0..N:
        result[i] = x[i] + x[i]
    return result
