# invoke cast_value: bf16:0x7fc5 ; f32[1]=zero
# invoke cast_value: bf16:0xffc5 ; f32[1]=zero
fn cast_value(a: bf16, dst: &mut tensor[1] f32) -> f32:
    let value = f32(a)
    dst[0] = value
    return value
