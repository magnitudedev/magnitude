fn main(out: &mut tensor[1] i32, divisor: i32):
    for i in 0..65536:
        let mut scratch = tensor[i+1] i32
        scratch[0] = 7
        out[0] = scratch[0]
        let quotient = 1 / divisor
        out[0] = quotient
