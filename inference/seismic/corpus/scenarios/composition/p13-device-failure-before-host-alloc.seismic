fn probe(idx: &tensor[1] i32, x: &tensor[4] f32, out: &mut tensor[1] f32, n: index[1099511627776]) -> f32:
    out[0] = x[idx[0] - 1]
    let mut t = tensor[n + 1] f32
    t[0] = 1.0
    return t[0]
