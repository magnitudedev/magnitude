{
  "defaults": {
    "root": "~/.cache/magnitude-evaluation",
    "models": "~/.magnitude/models"
  },
  "pools": {
    "gpu-pool": [
      "host-a",
      "host-b"
    ]
  },
  "hosts": {
    "host-a": {
      "root": "/path/to/scratch/magnitude-evaluation",
      "models": "/path/to/scratch/magnitude/models",
      "env": {
        "SEISMIC_NVRTC_DIRECTORY": "/path/to/nvrtc"
      }
    },
    "host-b": {
      "root": "/path/to/scratch/magnitude-evaluation",
      "models": "/path/to/scratch/magnitude/models"
    }
  }
}
