fn qwen_embedding[V, D](table: &tensor[V, D] EW, token: index[V])
    -> (tensor[1, D] A, tensor[1, D] f32):
    let mut embedded = tensor[1, D] A
    let mut result = tensor[1, D] f32
    embedding_row(table, token, embedded)
    cast_rows(embedded, result)
    return embedded, result


fn qwen_readout[V, D](hidden: &tensor[1, D] f32, norm: &tensor[D] NW,
    weight: &tensor[V, D] OW, epsilon: f32) -> (tensor[1, D] A, tensor[1, V] f32):
    let mut normalized = tensor[1, D] A
    let mut logits = tensor[1, V] f32
    rms_norm(hidden, norm, normalized, epsilon)
    linear(normalized, weight, logits)
    return normalized, logits
