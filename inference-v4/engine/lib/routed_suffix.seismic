# V3 stable ascending top-k: larger expert IDs win cutoff ties; selected routes
# are published in ascending (probability, ID) order.
fn route_topk[M, E, K](logits: &tensor[M, E] f32, routes: &mut tensor[M, K] i32,
                       scores: &mut tensor[M, K] f32, normalize: i32):
    parallel for row in 0..M:
        let values = f32(logits[row])
        let maximum = reduce(values, 0, max)
        let mut probabilities = exp(values - maximum)
        let total = reduce(probabilities, 0, sum)
        probabilities = probabilities / total
        let mut selected = tensor[K] f32
        let mut indices = tensor[K] i32
        for i in 0..K:
            selected[i] = 0.0
            indices[i] = 0
        for rank in 0..K:
            let best = reduce(probabilities, 0, max)
            let mut candidates = tensor[E] i32
            for i in 0..E:
                candidates[i] = -1
                if probabilities[i] == best:
                    candidates[i] = i
            let winner = reduce(i32(candidates), 0, max)
            for i in 0..K:
                if i == K - 1 - rank:
                    selected[i] = best
                    indices[i] = winner
            for i in 0..E:
                if i == winner:
                    probabilities[i] = -inf
        let mut denominator = f32(1.0)
        if normalize != 0:
            denominator = reduce(f32(selected), 0, sum)
        for i in 0..K:
            selected[i] = f32(selected[i]) / denominator
        routes[row] = indices
        scores[row] = selected


fn routed_input[M, E, K, H, F](x: &tensor[M, H] A, routes: &tensor[M, K] i32,
                               weight: &tensor[E, F, H] W, out: &mut tensor[M, K, F] A):
    parallel for row in 0..M:
        parallel for choice in 0..K:
            parallel for cols in 0..F:
                let xt = x[row:row + 1]
                let expert = routes[row, choice]
                let acc = matmul(
                    xt,
                    weight[expert, cols:cols + 1],
                    zeros_like(out[row, choice:choice + 1, cols:cols + 1], dtype=f32),
                )
                out[row, choice, cols] = acc[0, 0]


fn routed_activation[M, K, F](gate: &tensor[M, K, F] A, up: &tensor[M, K, F] A,
                              out: &mut tensor[M, K, F] A):
    parallel for row in 0..M:
        parallel for choice in 0..K:
            let g = f32(gate[row, choice])
            let u = f32(up[row, choice])
            out[row, choice] = (g / (1.0 + exp(-g))) * u


fn routed_output[M, E, K, H, F](x: &tensor[M, K, F] A, routes: &tensor[M, K] i32,
                                weight: &tensor[E, H, F] W, out: &mut tensor[M, K, H] A):
    parallel for row in 0..M:
        parallel for choice in 0..K:
            parallel for cols in 0..H:
                let expert = routes[row, choice]
                let acc = matmul(
                    x[row, choice:choice + 1],
                    weight[expert, cols:cols + 1],
                    zeros_like(out[row, choice:choice + 1, cols:cols + 1], dtype=f32),
                )
                out[row, choice, cols] = acc[0, 0]


fn shared_coefficient[M, H](x: &tensor[M, H] A, weight: &tensor[H] W,
                            out: &mut tensor[M, 1] A):
    parallel for row in 0..M:
        let dot = reduce(f32(x[row]) * f32(weight), 0, sum)
        out[row, 0] = 1.0 / (1.0 + exp(-dot))


fn routed_merge[M, K, H](experts: &tensor[M, K, H] A, scores: &tensor[M, K] f32,
                         shared: &tensor[M, H] A, coefficient: &tensor[M, 1] A,
                         residual: &tensor[M, H] f32, out: &mut tensor[M, H] f32):
    parallel for row in 0..M:
        let mut selected = tensor[H] f32
        for i in 0..H:
            selected[i] = 0.0
        for choice in 0..K:
            for i in 0..H:
                selected[i] = selected[i] + scores[row, choice] * f32(experts[row, choice, i])
        for i in 0..H:
            let gated_shared = f32(shared[row, i]) * f32(coefficient[row, 0])
            selected[i] = residual[row, i] + selected[i] + gated_shared
        out[row] = selected


fn qwen_routed_suffix[M, H, E, K, F, S](residual: &tensor[M, H] f32, norm: &tensor[H] NW,
    router: &tensor[E, H] RW, shared_router: &tensor[H] SRW,
    expert_gate: &tensor[E, F, H] EGW, expert_up: &tensor[E, F, H] EUW,
    expert_down: &tensor[E, H, F] EDW,
    shared_gate: &tensor[S, H] SGW, shared_up: &tensor[S, H] SUW,
    shared_down: &tensor[H, S] SDW, routes: &mut tensor[M, K] i32,
    scores: &mut tensor[M, K] f32, eps: f32, normalize: i32)
    -> (tensor[M, H] A, tensor[M, E] f32, tensor[M, K] i32, tensor[M, K] f32,
        tensor[M, K, F] A, tensor[M, K, F] A, tensor[M, K, F] A,
        tensor[M, K, H] A, tensor[M, S] A, tensor[M, S] A, tensor[M, S] A,
        tensor[M, S] A, tensor[M, H] A, tensor[M, 1] A, tensor[M, H] f32):
    let mut normalized = tensor[M, H] A
    let mut logits = tensor[M, E] f32
    let mut gate = tensor[M, K, F] A
    let mut up = tensor[M, K, F] A
    let mut product = tensor[M, K, F] A
    let mut projected = tensor[M, K, H] A
    let mut sg = tensor[M, S] A
    let mut su = tensor[M, S] A
    let mut sa = tensor[M, S] A
    let mut sp = tensor[M, S] A
    let mut shared = tensor[M, H] A
    let mut coefficient = tensor[M, 1] A
    let mut result = tensor[M, H] f32
    rms_norm(residual, norm, normalized, eps)
    linear(normalized, router, logits)
    route_topk(logits, routes, scores, normalize)
    routed_input(normalized, routes, expert_gate, gate)
    routed_input(normalized, routes, expert_up, up)
    routed_activation(gate, up, product)
    routed_output(product, routes, expert_down, projected)
    linear(normalized, shared_gate, sg)
    linear(normalized, shared_up, su)
    silu(sg, sa)
    multiply(sa, su, sp)
    linear(sp, shared_down, shared)
    shared_coefficient(normalized, shared_router, coefficient)
    routed_merge(projected, scores, shared, coefficient, residual, result)
    return normalized, logits, routes, scores, gate, up, product, projected, sg, su, sa, sp, shared, coefficient, result
