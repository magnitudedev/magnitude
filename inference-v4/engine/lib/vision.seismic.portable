# Processor patches are C/T/Y/X; MLX convolution kernels are T/Y/X/C.
fn qwen_vision_patch_order[M, C, T, P](pixels: tensor[M, C, T, P, P] f32,
    ordered: tensor[M, T, P, P, C] A):
  for row in parallel:
    source = load(pixels[row])
    target = tile[T, P, P, C] A
    for time, y, x, channel in owned(target): target[time, y, x, channel] = source[channel, time, y, x]
    store(target, ordered[row])

# Position interpolation preserves table-precision coefficient, product, and
# ordered-add publications before adding the projected patch.
fn qwen_vision_position_add[M, H, L](projected: tensor[M, H] A, table: tensor[L, H] A,
    indices: tensor[M, 4] i32, coefficients: tensor[M, 4] f32, out: tensor[M, H] A):
  for row in parallel:
    ids = load(indices[row])
    source_coefficients = load(coefficients[row])
    rounded_coefficients = tile[4] A
    for i in owned(rounded_coefficients): rounded_coefficients[i] = source_coefficients[i]
    p0 = load(table[ids[0]])
    p1 = load(table[ids[1]])
    p2 = load(table[ids[2]])
    p3 = load(table[ids[3]])
    a = tile[H] A
    b = tile[H] A
    c = tile[H] A
    d = tile[H] A
    sum = tile[H] A
    for i in owned(sum):
      a[i] = f32(p0[i]) * f32(rounded_coefficients[0])
      b[i] = f32(p1[i]) * f32(rounded_coefficients[1])
      c[i] = f32(p2[i]) * f32(rounded_coefficients[2])
      d[i] = f32(p3[i]) * f32(rounded_coefficients[3])
      sum[i] = f32(a[i]) + f32(b[i])
      sum[i] = f32(sum[i]) + f32(c[i])
      sum[i] = f32(sum[i]) + f32(d[i])
    residual = load(projected[row])
    for i in owned(sum): sum[i] = f32(residual[i]) + f32(sum[i])
    store(sum, out[row])

fn qwen_vision_stem[M, C, T, P, H, L](pixels: tensor[M, C * T * P * P] f32,
    weight: tensor[H, T * P * P * C] W, bias: tensor[H] B, table: tensor[L, H] A,
    indices: tensor[M, 4] i32, coefficients: tensor[M, 4] f32,
    ordered: tensor[M, T * P * P * C] A, projected: tensor[M, H] A, out: tensor[M, H] A):
  qwen_vision_patch_order(reshape(pixels, (M, C, T, P, P)), reshape(ordered, (M, T, P, P, C)))
  linear_bias(ordered, weight, bias, projected)
  qwen_vision_position_add(projected, table, indices, coefficients, out)

# Each spatial axis owns a quarter of each half. Head order is unchanged.
fn qwen_vision_rotate[P](source: tile[4 * P] A, coordinates: tile[2] i32,
    rotated: tile[4 * P] f32):
  for i in owned(rotated):
    pair = i % (2 * P)
    axis = pair / P
    frequency = pair % P
    angle = f32(coordinates[axis]) * exp(-log(10000.0) * f32(frequency) / f32(P))
    if i < 2 * P:
      rotated[i] = f32(source[i]) * cos(angle) - f32(source[i + 2 * P]) * sin(angle)
    else:
      rotated[i] = f32(source[i]) * cos(angle) + f32(source[i - 2 * P]) * sin(angle)

fn qwen_vision_qkv[M, H, P](projected: tensor[M, 3, H, 4 * P] A,
    coordinates: tensor[M, 2] i32, query: tensor[M, H, 4 * P] A,
    key: tensor[M, H, 4 * P] A, value: tensor[M, H, 4 * P] A):
  for row, head in parallel:
    q = load(projected[row, 0, head])
    k = load(projected[row, 1, head])
    v = load(projected[row, 2, head])
    coords = load(coordinates[row])
    rq = tile[4 * P] f32
    rk = tile[4 * P] f32
    qwen_vision_rotate[P = P](q, coords, rq)
    qwen_vision_rotate[P = P](k, coords, rk)
    store(rq, query[row, head])
    store(rk, key[row, head])
    store(v, value[row, head])

# One image is one complete bidirectional attention domain. It has no causal
# prefix restriction and cannot see rows belonging to another encoder input.
fn qwen_vision_full_attention[M, H, W](query: tensor[M, H, W] A,
    key: tensor[M, H, W] A, value: tensor[M, H, W] A, out: tensor[M, H, W] A):
  for row, head in parallel:
    q = load(query[row:row+1, head])
    k = load(key[0:M, head])
    v = load(value[0:M, head])
    maximum = tile[1] f32
    denominator = tile[1] f32
    acc = tile[1, W] f32
    for i in owned(maximum): maximum[i] = -inf; denominator[i] = 0.0
    for i, j in owned(acc): acc[i, j] = 0.0
    attention_update(q, k, v, maximum, denominator, acc, rsqrt(f32(W)))
    for i, j in owned(acc): acc[i, j] = acc[i, j] / denominator[i]
    store(acc, out[row:row+1, head])

fn qwen_vision_attention[M, H, P](projected: tensor[M, 3 * H * 4 * P] A,
    coordinates: tensor[M, 2] i32, query: tensor[M, H, 4 * P] A,
    key: tensor[M, H, 4 * P] A, value: tensor[M, H, 4 * P] A,
    out: tensor[M, H, 4 * P] A):
  qwen_vision_qkv[M = M, H = H, P = P](reshape(projected, (M, 3, H, 4 * P)), coordinates, query, key, value)
  qwen_vision_full_attention(query, key, value, out)

fn qwen_vision_block[M, H, P, F](hidden: tensor[M, H * 4 * P] A,
    coordinates: tensor[M, 2] i32,
    norm1_weight: tensor[H * 4 * P] NW, norm1_bias: tensor[H * 4 * P] NB,
    qkv_weight: tensor[3 * H * 4 * P, H * 4 * P] QW, qkv_bias: tensor[3 * H * 4 * P] QB,
    projection_weight: tensor[H * 4 * P, H * 4 * P] PW, projection_bias: tensor[H * 4 * P] PB,
    norm2_weight: tensor[H * 4 * P] NW, norm2_bias: tensor[H * 4 * P] NB,
    up_weight: tensor[F, H * 4 * P] UW, up_bias: tensor[F] UB,
    down_weight: tensor[H * 4 * P, F] DW, down_bias: tensor[H * 4 * P] DB,
    normalized: tensor[M, H * 4 * P] A, projected: tensor[M, 3 * H * 4 * P] A,
    query: tensor[M, H, 4 * P] A, key: tensor[M, H, 4 * P] A, value: tensor[M, H, 4 * P] A,
    attended: tensor[M, H, 4 * P] A, mixed: tensor[M, H * 4 * P] A,
    residual: tensor[M, H * 4 * P] A, normalized2: tensor[M, H * 4 * P] A,
    up: tensor[M, F] A, activated: tensor[M, F] A, down: tensor[M, H * 4 * P] A,
    out: tensor[M, H * 4 * P] A, epsilon: f32):
  layer_norm(hidden, norm1_weight, norm1_bias, normalized, epsilon)
  linear_bias(normalized, qkv_weight, qkv_bias, projected)
  qwen_vision_attention[M = M, H = H, P = P](projected, coordinates, query, key, value, attended)
  linear_bias(reshape(attended, (M, H * 4 * P)), projection_weight, projection_bias, mixed)
  add(hidden, mixed, residual)
  layer_norm(residual, norm2_weight, norm2_bias, normalized2, epsilon)
  linear_bias(normalized2, up_weight, up_bias, up)
  gelu_tanh(up, activated)
  linear_bias(activated, down_weight, down_bias, down)
  add(residual, down, out)

# The interpreter has already placed patches in spatial merge-group order.
# Normalize each patch separately and publish before concatenating the group.
# This is the pre-activation half of the merger; its output requires erf GELU.
fn qwen_vision_merger_up[M, G, H](hidden: tensor[M * G, H] A,
    norm_weight: tensor[H] NW, norm_bias: tensor[H] NB,
    up_weight: tensor[G * H, G * H] UW, up_bias: tensor[G * H] UB,
    normalized: tensor[M * G, H] A, up: tensor[M, G * H] A, epsilon: f32):
  layer_norm(hidden, norm_weight, norm_bias, normalized, epsilon)
  linear_bias(reshape(normalized, (M, G * H)), up_weight, up_bias, up)

fn qwen_vision_merger[M, G, H, D](hidden: tensor[M * G, H] A,
    norm_weight: tensor[H] NW, norm_bias: tensor[H] NB,
    up_weight: tensor[G * H, G * H] UW, up_bias: tensor[G * H] UB,
    down_weight: tensor[D, G * H] DW, down_bias: tensor[D] DB,
    normalized: tensor[M * G, H] A, up: tensor[M, G * H] A,
    activated: tensor[M, G * H] A, out: tensor[M, D] A, epsilon: f32):
  qwen_vision_merger_up[M = M, G = G, H = H](hidden, norm_weight, norm_bias, up_weight, up_bias, normalized, up, epsilon)
  gelu(up, activated)
  linear_bias(activated, down_weight, down_bias, out)

fn qwen_vision_feature_output[M, D](source: tensor[M, D] A, out: tensor[M, D] f32):
  for row in parallel:
    values = load(source[row])
    store(values, out[row])
