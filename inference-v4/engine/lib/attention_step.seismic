# V3 full-attention decode mixer and residual. Dense history is mutated explicitly;
# all proposal values are owned results whose physical destinations are compiler-owned.
fn qwen_attention_step[D, T, G, KV, P, S, SH, SW](hidden: &tensor[1, D] f32,
    input_norm: &tensor[D] NW, query_gate_weight: &tensor[KV * G * 2 * (2 * P + S), D] QW,
    key_weight: &tensor[KV * (2 * P + S), D] KW, value_weight: &tensor[KV * (2 * P + S), D] VW,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    output_weight: &tensor[D, KV * G * (2 * P + S)] OW, coordinates: &tensor[1, 4] i32,
    visible: &tensor[1, 2] i32, history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    destination: index[T], base: f32, epsilon: f32, scale: f32) -> tensor[1, D] f32:
    let mut normalized = tensor[1, D] A
    let mut query_gate = tensor[1, KV * G * 2 * (2 * P + S)] A
    let mut key = tensor[1, KV * (2 * P + S)] A
    let mut value = tensor[1, KV * (2 * P + S)] A
    let mut query = tensor[1, KV * G, 2 * P + S] A
    let mut prepared_key = tensor[1, KV, 2 * P + S] A
    let mut gate = tensor[1, KV * G * (2 * P + S)] A
    let mut attended = tensor[1, KV * G, 2 * P + S] A
    let mut activated = tensor[1, KV * G * (2 * P + S)] A
    let mut gated = tensor[1, KV * G * (2 * P + S)] A
    let mut projected = tensor[1, D] A
    let mut result = tensor[1, D] f32
    rms_norm(hidden, input_norm, normalized, epsilon)
    linear(normalized, query_gate_weight, query_gate)
    linear(normalized, key_weight, key)
    linear(normalized, value_weight, value)
    rotary_prepare[P = P, S = S, SH = SH, SW = SW](query_gate, key, query_norm, key_norm, coordinates, query, prepared_key, gate, base, epsilon)
    attention_decode[G = G](query, history_key, history_value, prepared_key, reshape(value, (1, KV, 2 * P + S)), visible, attended, scale)
    kv_append(prepared_key, reshape(value, (1, KV, 2 * P + S)), history_key, history_value, destination)
    sigmoid(gate, activated)
    multiply(reshape(attended, (1, KV * G * (2 * P + S))), activated, gated)
    linear(gated, output_weight, projected)
    add(hidden, projected, result)
    return result
