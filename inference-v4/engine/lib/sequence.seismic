# Logical multi-token equations. Temporal recurrence is ordered; projections and
# feedforward work span all rows. Owner domains and ordering are authored here;
# slice widths belong to selection.
fn qwen_embedding_rows[M, V, D](table: tensor[V, D] EW, tokens: tensor[M] i32,
    out embedded: tensor[M, D] A, out out: tensor[M, D] f32):
    parallel [rows] in 0..M:
        for row in rows:
            let values = load(table[tokens[row]])
            publish f32(values) to embedded[row]
    cast_rows(embedded, out)


fn qwen_readout_rows[M, V, D](hidden: tensor[M, D] f32, norm: tensor[D] NW,
    weight: tensor[V, D] OW, out last: tensor[1, D] f32,
    out normalized: tensor[1, D] A, out logits: tensor[1, V] f32, epsilon: f32):
    parallel [rows] in 0..1:
        for row in rows:
            let values = load(hidden[M - 1])
            publish values to last[row]
    rms_norm(last, norm, normalized, epsilon)
    linear(normalized, weight, logits)


# Project only caller-selected vocabulary rows, preserving their order and
# duplicates. Normalization publishes the same activation precision as full readout.
fn qwen_readout_selected[M, V, D, S](hidden: tensor[M, D] f32, norm: tensor[D] NW,
    weight: tensor[V, D] OW, selected: tensor[S] i32, out last: tensor[1, D] f32,
    out normalized: tensor[1, D] A, out logits: tensor[1, S] f32, epsilon: f32):
    parallel [rows] in 0..1:
        for row in rows:
            let values = load(hidden[M - 1])
            publish values to last[row]
    rms_norm(last, norm, normalized, epsilon)
    qwen_selected_projection(normalized, weight, selected, logits)


# The selected vocabulary row is decoded to F32 once per output; the contraction is
# the standard ordered F32 FMA chain over D.
fn qwen_selected_projection[V, D, S](normalized: tensor[1, D] A,
    weight: tensor[V, D] OW, selected: tensor[S] i32, out logits: tensor[1, S] f32):
    parallel [rows, cols] in (0..1, 0..S):
        for row in rows:
            let xt = load(normalized[row:row + 1])
            for col in cols:
                let mut acc = zeros_like(logits[row:row + 1, col:col + 1], dtype=f32)
                let token = selected[col]
                let wt = f32(weight[token:token + 1])
                matmul(xt, wt, into=acc)
                publish acc to logits[row:row + 1, col:col + 1]

# Rows are appended in token order within each head owner; a later row wins a
# repeated destination exactly as in sequential decoding.
fn qwen_append_rows[M, T, KV, W](key: tensor[M, KV, W] A, value: tensor[M, KV, W] A,
    inout history_key: tensor[T, KV, W] A, inout history_value: tensor[T, KV, W] A,
    destinations: tensor[M] i32):
    parallel [heads] in 0..KV:
        for head in heads:
            for row in 0..M:
                let kt = load(key[row, head])
                let vt = load(value[row, head])
                publish kt to history_key[destinations[row], head]
                publish vt to history_value[destinations[row], head]

# Ordered logical spans can be physically discontiguous or nonmonotonic. Carry
# the same online softmax state across all spans, then consume fresh causal rows.
# Empty spans do not expose unowned history or change the running normalization.
fn qwen_attention_rows[M, T, H, KV, W, R](q: tensor[M, H, W] A, k: tensor[T, KV, W] A,
    v: tensor[T, KV, W] A, fresh_key: tensor[M, KV, W] A, fresh_value: tensor[M, KV, W] A,
    visible: tensor[M, R, 2] i32, out out: tensor[M, H, W] A, scale: f32):
    parallel [rows, kv_heads] in (0..M, 0..KV):
        for row in rows:
            for kv_head in kv_heads:
                let qt = load(q[row, kv_head * (H / KV):(kv_head + 1) * (H / KV)])
                let mut m = tile[H / KV] f32
                let mut l = tile[H / KV] f32
                let mut acc = tile[H / KV, W] f32
                for i in owned(m):
                    m[i] = -inf
                    l[i] = 0.0
                for i, j in owned(acc):
                    acc[i, j] = 0.0
                for span in 0..R:
                    let lo = visible[row, span, 0]
                    let hi = visible[row, span, 1]
                    let kt = load(k[lo:hi, kv_head])
                    let vt = load(v[lo:hi, kv_head])
                    if extent(kt, 0) > 0:
                        attention_update(qt, kt, vt, m, l, acc, scale)
                let fresh_kt = load(fresh_key[0:row + 1, kv_head])
                let fresh_vt = load(fresh_value[0:row + 1, kv_head])
                attention_update(qt, fresh_kt, fresh_vt, m, l, acc, scale)
                let mut y = tile[H / KV, W] f32
                for i, j in owned(y):
                    y[i, j] = acc[i, j] / l[i]
                publish y to out[row, kv_head * (H / KV):(kv_head + 1) * (H / KV)]

# Multi-row recurrent preparation. The convolution window of row r is the C - 1
# inputs preceding it: accepted `window` rows first, then earlier rows of this
# batch. The successor window holds the last C - 1 inputs after all M rows.
fn qwen_recurrent_prepare_rows[M, NK, NV, W, C](projected: tensor[M, (2 * NK + NV) * W] A, conv: tensor[(2 * NK + NV) * W, C] CW,
                                   window: tensor[C - 1, (2 * NK + NV) * W] A,
                                   out next_window: tensor[C - 1, (2 * NK + NV) * W] A,
                                   alpha: tensor[M, NV] A, beta_in: tensor[M, NV] A,
                                   rate: tensor[NV] f32, dt_bias: tensor[NV] f32, eps: f32,
                                   out qkv: tensor[M, 2 * NK + NV, W] A, out beta: tensor[M, NV] A, out decay: tensor[M, NV] f32):
    parallel [rows, heads] in (0..M, 0..2 * NK + NV):
        for row in rows:
            for h in heads:
                let x = load(projected[row, h * W:(h + 1) * W])
                let win = load(window[0:C - 1, h * W:(h + 1) * W])
                let wt = load(conv[h * W:(h + 1) * W, 0:C])
                let mut y = tile[W] f32
                for i in owned(y):
                    let mut s = f32(wt[i, C - 1]) * f32(x[i])
                    for j in 0..C - 1:
                        let mut previous = f32(0.0)
                        if row + j < C - 1:
                            previous = f32(win[row + j, i])
                        else:
                            previous = f32(projected[row + j - (C - 1), h * W + coord(i)])
                        s = fma(f32(wt[i, j]), previous, s)
                    y[i] = s / (1.0 + exp(-s))
                let mut inv = f32(1.0)
                if h < 2 * NK:
                    let ss = sum_any_order(y * y)
                    inv = rsqrt(ss + eps)
                    if h < NK:
                        inv = inv * rsqrt(f32(W))
                publish y * inv to qkv[row, h]
    parallel [rows, value_heads] in (0..M, 0..NV):
        for row in rows:
            for hv in value_heads:
                let mut b = tile[1] f32
                let mut d = tile[1] f32
                for i in owned(b):
                    b[i] = 1.0 / (1.0 + exp(-f32(beta_in[row, hv])))
                for i in owned(d):
                    let sh = f32(alpha[row, hv]) + dt_bias[hv]
                    d[i] = exp(rate[hv] * (max(sh, 0.0) + log(1.0 + exp(-abs(sh)))))
                publish b to beta[row, hv:hv + 1]
                publish d to decay[row, hv:hv + 1]
    parallel [heads] in 0..2 * NK + NV:
        for h in heads:
            let mut nw = tile[C - 1, W] f32
            for j, i in owned(nw):
                if M + coord(j) < C - 1:
                    nw[j, i] = f32(window[M + coord(j), h * W + coord(i)])
                else:
                    nw[j, i] = f32(projected[M + coord(j) - (C - 1), h * W + coord(i)])
            publish nw to next_window[0:C - 1, h * W:(h + 1) * W]

# Gated delta rule over M tokens, one state row per owner. The token recurrence is
# ordered inside each (value head, state row) owner; owners are independent.
fn qwen_delta_rows[M, NK, GV, W](qkv: tensor[M, 2 * NK + NK * GV, W] A, beta: tensor[M, NK * GV] A, decay: tensor[M, NK * GV] f32,
                         state: tensor[NK * GV, W, W] f32, out next_state: tensor[NK * GV, W, W] f32, out out: tensor[M, NK * GV, W] A, grouped: bool):
    parallel [heads, state_rows] in (0..NK * GV, 0..W):
        for h in heads:
            let mut key_head = h % NK
            if grouped:
                key_head = h / GV
            for i in state_rows:
                let mut row = load(state[h, i])
                for t in 0..M:
                    let key = load(qkv[t, NK + key_head])
                    let query = load(qkv[t, key_head])
                    let mut p = tile[W] f32
                    for j in owned(p):
                        p[j] = row[j] * decay[t, h] * f32(key[j])
                    let remembered = sum_any_order(p)
                    let residual = (f32(qkv[t, 2 * NK + h, i]) - remembered) * f32(beta[t, h])
                    let mut nrow = tile[W] f32
                    for j in owned(nrow):
                        nrow[j] = fma(residual, f32(key[j]), row[j] * decay[t, h])
                    let mut pq = tile[W] f32
                    for j in owned(pq):
                        pq[j] = nrow[j] * f32(query[j])
                    let o = sum_any_order(pq)
                    let mut ot = tile[1] f32
                    for j in owned(ot):
                        ot[j] = o
                    publish ot to out[t, h, i:i + 1]
                    row = nrow
                publish row to next_state[h, i]

# The engine binds `hidden` and `out` to the same residual rows.
fn qwen_attention_sequence[M, D, T, H, KV, P, S, SH, SW, R](hidden: tensor[M, D] f32,
    input_norm: tensor[D] NW, query_gate_weight: tensor[H * 2 * (2 * P + S), D] QW,
    key_weight: tensor[KV * (2 * P + S), D] KW, value_weight: tensor[KV * (2 * P + S), D] VW,
    query_norm: tensor[2 * P + S] f32, key_norm: tensor[2 * P + S] f32,
    output_weight: tensor[D, H * (2 * P + S)] OW, coordinates: tensor[M, 4] i32,
    visible: tensor[M, R, 2] i32, inout history_key: tensor[T, KV, 2 * P + S] A,
    inout history_value: tensor[T, KV, 2 * P + S] A,
    out normalized: tensor[M, D] A, out query_gate: tensor[M, H * 2 * (2 * P + S)] A,
    out key: tensor[M, KV * (2 * P + S)] A, out value: tensor[M, KV * (2 * P + S)] A,
    out query: tensor[M, H, 2 * P + S] A, out prepared_key: tensor[M, KV, 2 * P + S] A,
    out gate: tensor[M, H * (2 * P + S)] A, out attended: tensor[M, H, 2 * P + S] A,
    out activated: tensor[M, H * (2 * P + S)] A, out gated: tensor[M, H * (2 * P + S)] A,
    out projected: tensor[M, D] A, out out: tensor[M, D] f32,
    destinations: tensor[M] i32, base: f32, epsilon: f32, scale: f32) alias(hidden, out):
    rms_norm(hidden, input_norm, normalized, epsilon)
    linear(normalized, query_gate_weight, query_gate)
    linear(normalized, key_weight, key)
    linear(normalized, value_weight, value)
    rotary_prepare[P = P, S = S, SH = SH, SW = SW](query_gate, key, query_norm, key_norm, coordinates, query, prepared_key, gate, base, epsilon)
    qwen_attention_rows(query, history_key, history_value, prepared_key, reshape(value, (M, KV, 2 * P + S)), visible, attended, scale)
    qwen_append_rows(prepared_key, reshape(value, (M, KV, 2 * P + S)), history_key, history_value, destinations)
    sigmoid(gate, activated)
    multiply(reshape(attended, (M, H * (2 * P + S))), activated, gated)
    linear(gated, output_weight, projected)
    add(hidden, projected, out)


# The engine binds `hidden` and `out` to the same residual rows.
fn qwen_recurrent_sequence[M, H, NK, GV, W, C](hidden: tensor[M, H] f32, input_norm: tensor[H] NW,
    qkv_weight: tensor[(2 * NK + NK * GV) * W, H] QW, gate_weight: tensor[NK * GV * W, H] GW,
    alpha_weight: tensor[NK * GV, H] AW, beta_weight: tensor[NK * GV, H] BW,
    convolution: tensor[(2 * NK + NK * GV) * W, C] f32,
    rate: tensor[NK * GV] f32, time_bias: tensor[NK * GV] f32,
    recurrent_norm: tensor[W] RN, output_weight: tensor[H, NK * GV * W] OW,
    window: tensor[C - 1, (2 * NK + NK * GV) * W] A, delta: tensor[NK * GV, W, W] f32,
    out next_window: tensor[C - 1, (2 * NK + NK * GV) * W] A, out next_delta: tensor[NK * GV, W, W] f32,
    out normalized: tensor[M, H] A, out projected: tensor[M, (2 * NK + NK * GV) * W] A,
    out gate: tensor[M, NK * GV * W] A, out alpha: tensor[M, NK * GV] A, out beta_input: tensor[M, NK * GV] A,
    out qkv: tensor[M, 2 * NK + NK * GV, W] A, out beta: tensor[M, NK * GV] A, out decay: tensor[M, NK * GV] f32,
    out mixed: tensor[M, NK * GV, W] A, out mixed_norm: tensor[M, NK * GV, W] A,
    out activated: tensor[M, NK * GV * W] A, out gated: tensor[M, NK * GV * W] A,
    out output_projection: tensor[M, H] A, out out: tensor[M, H] f32,
    epsilon: f32, preparation_epsilon: f32, grouped: bool) alias(hidden, out):
    rms_norm(hidden, input_norm, normalized, epsilon)
    linear(normalized, qkv_weight, projected)
    linear(normalized, gate_weight, gate)
    linear(normalized, alpha_weight, alpha)
    linear(normalized, beta_weight, beta_input)
    qwen_recurrent_prepare_rows(projected, convolution, window, next_window, alpha, beta_input, rate, time_bias, preparation_epsilon, qkv, beta, decay)
    qwen_delta_rows[NK = NK, GV = GV](qkv, beta, decay, delta, next_delta, mixed, grouped)
    rms_norm(reshape(mixed, (M * NK * GV, W)), recurrent_norm, reshape(mixed_norm, (M * NK * GV, W)), epsilon)
    silu(gate, activated)
    multiply(reshape(mixed_norm, (M, NK * GV * W)), activated, gated)
    linear(gated, output_weight, output_projection)
    add(hidden, output_projection, out)
