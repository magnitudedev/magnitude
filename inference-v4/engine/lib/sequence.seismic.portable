# Logical multi-token equations. Temporal recurrence is ordered; projections and
# feedforward work span all rows. Physical decomposition belongs to selection.
fn qwen_embedding_rows[M, V, D](table: tensor[V, D] EW, tokens: tensor[M] i32,
    embedded: tensor[M, D] A, out: tensor[M, D] f32):
  for row in parallel:
    values = load(table[tokens[row]])
    decoded = tile[D] f32
    for i in owned(decoded): decoded[i] = values[i]
    store(decoded, embedded[row])
  cast_rows(embedded, out)

fn qwen_readout_rows[M, V, D](hidden: tensor[M, D] f32, norm: tensor[D] NW,
    weight: tensor[V, D] OW, last: tensor[1, D] f32,
    normalized: tensor[1, D] A, logits: tensor[1, V] f32, epsilon: f32):
  for row in parallel:
    values = load(hidden[M - 1])
    store(values, last[row])
  rms_norm(last, norm, normalized, epsilon)
  linear(normalized, weight, logits)

# Project only caller-selected vocabulary rows, preserving their order and
# duplicates. Normalization publishes the same activation precision as full readout.
fn qwen_readout_selected[M, V, D, S](hidden: tensor[M, D] f32, norm: tensor[D] NW,
    weight: tensor[V, D] OW, selected: tensor[S] i32, last: tensor[1, D] f32,
    normalized: tensor[1, D] A, logits: tensor[1, S] f32, epsilon: f32):
  for row in parallel:
    values = load(hidden[M - 1])
    store(values, last[row])
  rms_norm(last, norm, normalized, epsilon)
  qwen_selected_projection(normalized, weight, selected, logits)

fn qwen_selected_projection[V, D, S](normalized: tensor[1, D] A,
    weight: tensor[V, D] OW, selected: tensor[S] i32, logits: tensor[1, S] f32):
  for row, col in parallel:
    acc = tile[1, 1] f32
    for i, j in owned(acc): acc[i, j] = 0.0
    xt = load(normalized[row:row+1])
    token = selected[col]
    values = load(weight[token])
    wt = tile[1, D] f32
    for i, j in owned(wt): wt[i, j] = values[j]
    matmul(xt, wt, acc)
    store(acc, logits[row:row+1, col:col+1])

fn qwen_append_rows[M, T, KV, W](key: tensor[M, KV, W] A, value: tensor[M, KV, W] A,
    history_key: tensor[T, KV, W] A, history_value: tensor[T, KV, W] A,
    destinations: tensor[M] i32):
  for head in parallel:
    for row in range(M):
      kt = load(key[row, head])
      vt = load(value[row, head])
      store(kt, history_key[destinations[row], head])
      store(vt, history_value[destinations[row], head])

# Ordered logical spans can be physically discontiguous or nonmonotonic. Carry
# the same online softmax state across all spans, then consume fresh causal rows.
# Empty spans do not expose unowned history or change the running normalization.
fn qwen_attention_rows[M, T, H, KV, W, R](q: tensor[M, H, W] A, k: tensor[T, KV, W] A,
    v: tensor[T, KV, W] A, fresh_key: tensor[M, KV, W] A, fresh_value: tensor[M, KV, W] A,
    visible: tensor[M, R, 2] i32, out: tensor[M, H, W] A, scale: f32):
  for row, kv_head in parallel:
    qt = load(q[row, kv_head * (H / KV):(kv_head + 1) * (H / KV)])
    m = tile[H / KV] f32
    l = tile[H / KV] f32
    acc = tile[H / KV, W] f32
    for i in owned(m): m[i] = -inf; l[i] = 0.0
    for i, j in owned(acc): acc[i, j] = 0.0
    for span in range(R):
      kt = load(k[visible[row, span, 0]:visible[row, span, 1], kv_head])
      vt = load(v[visible[row, span, 0]:visible[row, span, 1], kv_head])
      if extent(kt, 0) > 0:
        attention_update(qt, kt, vt, m, l, acc, scale)
    fresh_kt = load(fresh_key[0:row + 1, kv_head])
    fresh_vt = load(fresh_value[0:row + 1, kv_head])
    attention_update(qt, fresh_kt, fresh_vt, m, l, acc, scale)
    y = tile[H / KV, W] f32
    for i, j in owned(y): y[i, j] = acc[i, j] / l[i]
    store(y, out[row, kv_head * (H / KV):(kv_head + 1) * (H / KV)])

fn qwen_recurrent_prepare_rows[M, NK, NV, W, C](projected: tensor[M, (2 * NK + NV) * W] A, conv: tensor[(2 * NK + NV) * W, C] CW,
                                   window: tensor[C - 1, (2 * NK + NV) * W] A,
                                   next_window: tensor[C - 1, (2 * NK + NV) * W] A,
                                   alpha: tensor[M, NV] A, beta_in: tensor[M, NV] A,
                                   rate: tensor[NV] f32, dt_bias: tensor[NV] f32, eps: f32,
                                   qkv: tensor[M, 2 * NK + NV, W] A, beta: tensor[M, NV] A, decay: tensor[M, NV] f32):
  for row, h in parallel:
    x = load(projected[row, h * W : (h + 1) * W])
    win = load(window[0 : C - 1, h * W : (h + 1) * W])
    wt = load(conv[h * W : (h + 1) * W, 0 : C])
    y = tile[W] f32
    for i in owned(y):
      s = f32(wt[i, C - 1]) * f32(x[i])
      for j in range(C - 1):
        previous = 0.0
        if row + j < C - 1:
          previous = f32(win[row + j, i])
        else:
          previous = f32(projected[row + j - (C - 1), h * W + i])
        s = fma(f32(wt[i, j]), previous, s)
      y[i] = s / (1.0 + exp(-s))
    inv = 1.0
    if h < 2 * NK:
      sq = tile[W] f32
      for i in owned(sq): sq[i] = y[i] * y[i]
      ss = reduce(sq, 0, sum)
      inv = rsqrt(ss + eps)
      if h < NK:
        inv = inv * rsqrt(f32(W))
    z = tile[W] f32
    for i in owned(z): z[i] = y[i] * inv
    store(z, qkv[row, h])
  for row, hv in parallel:
    b = tile[1] f32
    d = tile[1] f32
    for i in owned(b):
      b[i] = 1.0 / (1.0 + exp(-f32(beta_in[row, hv])))
    for i in owned(d):
      sh = f32(alpha[row, hv]) + dt_bias[hv]
      d[i] = exp(rate[hv] * (max(sh, 0.0) + log(1.0 + exp(-abs(sh)))))
    store(b, beta[row, hv : hv + 1])
    store(d, decay[row, hv : hv + 1])
  for h in parallel:
    nw = tile[C - 1, W] f32
    for j, i in owned(nw):
      if M + j < C - 1:
        nw[j, i] = f32(window[M + j, h * W + i])
      else:
        nw[j, i] = f32(projected[M + j - (C - 1), h * W + i])
    store(nw, next_window[0:C - 1, h * W:(h + 1) * W])

fn qwen_delta_rows[M, NK, GV, W](qkv: tensor[M, 2 * NK + NK * GV, W] A, beta: tensor[M, NK * GV] A, decay: tensor[M, NK * GV] f32,
                         state: tensor[NK * GV, W, W] f32, next_state: tensor[NK * GV, W, W] f32, out: tensor[M, NK * GV, W] A, grouped: bool):
  for h, i in parallel:
    row = load(state[h, i])
    key_head = h % NK
    if grouped: key_head = h / GV
    for t in range(M):
      key = load(qkv[t, NK + key_head])
      query = load(qkv[t, key_head])
      p = tile[W] f32
      for j in owned(p): p[j] = row[j] * decay[t, h] * f32(key[j])
      remembered = reduce(p, 0, sum)
      residual = (f32(qkv[t, 2 * NK + h, i]) - remembered) * f32(beta[t, h])
      nrow = tile[W] f32
      for j in owned(nrow): nrow[j] = fma(residual, f32(key[j]), row[j] * decay[t, h])
      pq = tile[W] f32
      for j in owned(pq): pq[j] = nrow[j] * f32(query[j])
      o = reduce(pq, 0, sum)
      ot = tile[1] f32
      for j in owned(ot): ot[j] = o
      store(ot, out[t, h, i : i + 1])
      row = nrow
    store(row, next_state[h, i])

fn qwen_attention_sequence[M, D, T, H, KV, P, S, SH, SW, R](hidden: tensor[M, D] f32,
    input_norm: tensor[D] NW, query_gate_weight: tensor[H * 2 * (2 * P + S), D] QW,
    key_weight: tensor[KV * (2 * P + S), D] KW, value_weight: tensor[KV * (2 * P + S), D] VW,
    query_norm: tensor[2 * P + S] f32, key_norm: tensor[2 * P + S] f32,
    output_weight: tensor[D, H * (2 * P + S)] OW, coordinates: tensor[M, 4] i32,
    visible: tensor[M, R, 2] i32, history_key: tensor[T, KV, 2 * P + S] A,
    history_value: tensor[T, KV, 2 * P + S] A,
    normalized: tensor[M, D] A, query_gate: tensor[M, H * 2 * (2 * P + S)] A,
    key: tensor[M, KV * (2 * P + S)] A, value: tensor[M, KV * (2 * P + S)] A,
    query: tensor[M, H, 2 * P + S] A, prepared_key: tensor[M, KV, 2 * P + S] A,
    gate: tensor[M, H * (2 * P + S)] A, attended: tensor[M, H, 2 * P + S] A,
    activated: tensor[M, H * (2 * P + S)] A, gated: tensor[M, H * (2 * P + S)] A,
    projected: tensor[M, D] A, out: tensor[M, D] f32,
    destinations: tensor[M] i32, base: f32, epsilon: f32, scale: f32):
  rms_norm(hidden, input_norm, normalized, epsilon)
  linear(normalized, query_gate_weight, query_gate)
  linear(normalized, key_weight, key)
  linear(normalized, value_weight, value)
  rotary_prepare[P = P, S = S, SH = SH, SW = SW](query_gate, key, query_norm, key_norm, coordinates, query, prepared_key, gate, base, epsilon)
  qwen_attention_rows(query, history_key, history_value, prepared_key, reshape(value, (M, KV, 2 * P + S)), visible, attended, scale)
  qwen_append_rows(prepared_key, reshape(value, (M, KV, 2 * P + S)), history_key, history_value, destinations)
  sigmoid(gate, activated)
  multiply(reshape(attended, (M, H * (2 * P + S))), activated, gated)
  linear(gated, output_weight, projected)
  add(hidden, projected, out)

fn qwen_recurrent_sequence[M, H, NK, GV, W, C](hidden: tensor[M, H] f32, input_norm: tensor[H] NW,
    qkv_weight: tensor[(2 * NK + NK * GV) * W, H] QW, gate_weight: tensor[NK * GV * W, H] GW,
    alpha_weight: tensor[NK * GV, H] AW, beta_weight: tensor[NK * GV, H] BW,
    convolution: tensor[(2 * NK + NK * GV) * W, C] f32,
    rate: tensor[NK * GV] f32, time_bias: tensor[NK * GV] f32,
    recurrent_norm: tensor[W] RN, output_weight: tensor[H, NK * GV * W] OW,
    window: tensor[C - 1, (2 * NK + NK * GV) * W] A, delta: tensor[NK * GV, W, W] f32,
    next_window: tensor[C - 1, (2 * NK + NK * GV) * W] A, next_delta: tensor[NK * GV, W, W] f32,
    normalized: tensor[M, H] A, projected: tensor[M, (2 * NK + NK * GV) * W] A,
    gate: tensor[M, NK * GV * W] A, alpha: tensor[M, NK * GV] A, beta_input: tensor[M, NK * GV] A,
    qkv: tensor[M, 2 * NK + NK * GV, W] A, beta: tensor[M, NK * GV] A, decay: tensor[M, NK * GV] f32,
    mixed: tensor[M, NK * GV, W] A, mixed_norm: tensor[M, NK * GV, W] A,
    activated: tensor[M, NK * GV * W] A, gated: tensor[M, NK * GV * W] A,
    output_projection: tensor[M, H] A, out: tensor[M, H] f32,
    epsilon: f32, preparation_epsilon: f32, grouped: bool):
  rms_norm(hidden, input_norm, normalized, epsilon)
  linear(normalized, qkv_weight, projected)
  linear(normalized, gate_weight, gate)
  linear(normalized, alpha_weight, alpha)
  linear(normalized, beta_weight, beta_input)
  qwen_recurrent_prepare_rows(projected, convolution, window, next_window, alpha, beta_input, rate, time_bias, preparation_epsilon, qkv, beta, decay)
  qwen_delta_rows[NK = NK, GV = GV](qkv, beta, decay, delta, next_delta, mixed, grouped)
  rms_norm(reshape(mixed, (M * NK * GV, W)), recurrent_norm, reshape(mixed_norm, (M * NK * GV, W)), epsilon)
  silu(gate, activated)
  multiply(reshape(mixed_norm, (M, NK * GV * W)), activated, gated)
  linear(gated, output_weight, output_projection)
  add(hidden, output_projection, out)
