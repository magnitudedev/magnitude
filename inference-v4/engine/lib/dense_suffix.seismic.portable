# V3 qwen35.block's dense feedforward suffix. Every intermediate is published
# at activation precision; the residual remains F32 throughout. The engine binds
# `residual` and `out` to the same hidden rows.
export fn qwen_dense_suffix[M, H, F](residual: tensor[M, H] f32, norm: tensor[H] NW,
                             gate_weight: tensor[F, H] GW, up_weight: tensor[F, H] UW,
                             down_weight: tensor[H, F] DW,
                             out normalized: tensor[M, H] A, out gate: tensor[M, F] A,
                             out up: tensor[M, F] A, out activated: tensor[M, F] A,
                             out product: tensor[M, F] A, out projected: tensor[M, H] A,
                             out out: tensor[M, H] f32, eps: f32) alias(residual, out):
    rms_norm(residual, norm, normalized, eps)
    linear(normalized, gate_weight, gate)
    linear(normalized, up_weight, up)
    silu(gate, activated)
    multiply(activated, up, product)
    linear(product, down_weight, projected)
    add(residual, projected, out)

lower qwen_dense_suffix for metal = portable
lower qwen_dense_suffix for cpu = portable
lower qwen_dense_suffix for cuda = portable
