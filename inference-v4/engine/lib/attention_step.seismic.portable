# V3 full-attention decode mixer and residual. This dense-history composition is
# the correctness baseline; codec-aware history implementations must preserve the
# distinct dense fresh-row input to attention and the later persistence operation.
fn qwen_attention_step[D, T, H, KV, P, S, SH, SW](hidden: tensor[1, D] f32,
    input_norm: tensor[D] NW, query_gate_weight: tensor[H * 2 * (2 * P + S), D] QW,
    key_weight: tensor[KV * (2 * P + S), D] KW, value_weight: tensor[KV * (2 * P + S), D] VW,
    query_norm: tensor[2 * P + S] f32, key_norm: tensor[2 * P + S] f32,
    output_weight: tensor[D, H * (2 * P + S)] OW, coordinates: tensor[1, 4] i32,
    visible: tensor[1, 2] i32, history_key: tensor[T, KV, 2 * P + S] A,
    history_value: tensor[T, KV, 2 * P + S] A,
    normalized: tensor[1, D] A, query_gate: tensor[1, H * 2 * (2 * P + S)] A,
    key: tensor[1, KV * (2 * P + S)] A, value: tensor[1, KV * (2 * P + S)] A,
    query: tensor[1, H, 2 * P + S] A, prepared_key: tensor[1, KV, 2 * P + S] A,
    gate: tensor[1, H * (2 * P + S)] A, attended: tensor[1, H, 2 * P + S] A,
    activated: tensor[1, H * (2 * P + S)] A, gated: tensor[1, H * (2 * P + S)] A,
    projected: tensor[1, D] A, out: tensor[1, D] f32,
    destination: index[T], base: f32, epsilon: f32, scale: f32):
  rms_norm(hidden, input_norm, normalized, epsilon)
  linear(normalized, query_gate_weight, query_gate)
  linear(normalized, key_weight, key)
  linear(normalized, value_weight, value)
  rotary_prepare[P = P, S = S, SH = SH, SW = SW](query_gate, key, query_norm, key_norm, coordinates, query, prepared_key, gate, base, epsilon)
  attention_decode(query, history_key, history_value, prepared_key, reshape(value, (1, KV, 2 * P + S)), visible, attended, scale)
  kv_append(prepared_key, reshape(value, (1, KV, 2 * P + S)), history_key, history_value, destination)
  sigmoid(gate, activated)
  multiply(reshape(attended, (1, H * (2 * P + S))), activated, gated)
  linear(gated, output_weight, projected)
  add(hidden, projected, out)
