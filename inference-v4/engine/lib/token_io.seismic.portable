fn qwen_embedding[V, D](table: tensor[V, D] EW, embedded: tensor[1, D] A, out: tensor[1, D] f32, token: index[V]):
  embedding_row(table, token, embedded)
  cast_rows(embedded, out)

fn qwen_readout[V, D](hidden: tensor[1, D] f32, norm: tensor[D] NW,
    weight: tensor[V, D] OW, normalized: tensor[1, D] A, logits: tensor[1, V] f32, epsilon: f32):
  rms_norm(hidden, norm, normalized, epsilon)
  linear(normalized, weight, logits)
