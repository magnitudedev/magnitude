# V3 recurrent mixer for one decode row, followed by its F32 residual addition.
# Accepted window/delta are read-only. Successor buffers receive the proposal;
# the engine accepts their ownership only after successful physical completion.
fn qwen_recurrent_step[H, NK, GV, W, C](hidden: tensor[1, H] f32, input_norm: tensor[H] NW,
    qkv_weight: tensor[(2 * NK + NK * GV) * W, H] QW, gate_weight: tensor[NK * GV * W, H] GW,
    alpha_weight: tensor[NK * GV, H] AW, beta_weight: tensor[NK * GV, H] BW,
    convolution: tensor[(2 * NK + NK * GV) * W, C] f32,
    rate: tensor[NK * GV] f32, time_bias: tensor[NK * GV] f32,
    recurrent_norm: tensor[W] RN, output_weight: tensor[H, NK * GV * W] OW,
    window: tensor[C - 1, (2 * NK + NK * GV) * W] A, delta: tensor[NK * GV, W, W] f32,
    out next_window: tensor[C - 1, (2 * NK + NK * GV) * W] A, out next_delta: tensor[NK * GV, W, W] f32,
    out normalized: tensor[1, H] A, out projected: tensor[1, (2 * NK + NK * GV) * W] A,
    out gate: tensor[1, NK * GV * W] A, out alpha: tensor[1, NK * GV] A, out beta_input: tensor[1, NK * GV] A,
    out qkv: tensor[2 * NK + NK * GV, W] A, out beta: tensor[NK * GV] A, out decay: tensor[NK * GV] f32,
    out mixed: tensor[NK * GV, W] A, out mixed_norm: tensor[NK * GV, W] A,
    out activated: tensor[1, NK * GV * W] A, out gated: tensor[1, NK * GV * W] A,
    out output_projection: tensor[1, H] A, out out: tensor[1, H] f32,
    epsilon: f32, preparation_epsilon: f32, grouped: bool):
    rms_norm(hidden, input_norm, normalized, epsilon)
    linear(normalized, qkv_weight, projected)
    linear(normalized, gate_weight, gate)
    linear(normalized, alpha_weight, alpha)
    linear(normalized, beta_weight, beta_input)
    recurrent_prepare(projected, convolution, window, next_window, alpha, beta_input, rate, time_bias, preparation_epsilon, qkv, beta, decay)
    delta_step[NK = NK, GV = GV](qkv, beta, decay, delta, next_delta, mixed, grouped)
    rms_norm(mixed, recurrent_norm, mixed_norm, epsilon)
    silu(gate, activated)
    multiply(reshape(mixed_norm, (1, NK * GV * W)), activated, gated)
    linear(gated, output_weight, output_projection)
    add(hidden, output_projection, out)
