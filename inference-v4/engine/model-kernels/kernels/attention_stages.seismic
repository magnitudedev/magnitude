# Attention projection stages around the gated attention entries of
# attention.seismic: the normed Q/K/V projection before, the output projection
# plus residual after.

# query_norm fixes W for the checked flattened KV*G*W projection shape; the
# projection does not read it. RMS prologue over the F32 residual, then one
# segmented projection query+gate | key | value, each segment with its own
# representation. Native Metal: the K1 projection library; M <= 2 runs the
# GEMV launch, 3..8 the batched launch, each normalizing its rows
# in-threadgroup; larger classes a pre-pass that writes the normalized rows
# to scratch, then the GEMM launch.
fn qwen_attention_project[M, D, KV, G, W](hidden: &tensor[M, D] f32,
    input_norm: &tensor[D] NW, query_norm: &tensor[W] f32,
    query_gate_weight: &tensor[KV * G * 2 * W, D] QW,
    key_weight: &tensor[KV * W, D] KW, value_weight: &tensor[KV * W, D] VW, epsilon: f32)
    -> (tensor[M, KV * G * 2 * W] A, tensor[M, KV * W] A, tensor[M, KV * W] A):
    let mut normalized = tensor[M, D] A
    let mut query_gate = tensor[M, KV * G * 2 * W] A
    let mut key = tensor[M, KV * W] A
    let mut value = tensor[M, KV * W] A
    rms_norm(hidden, input_norm, normalized, epsilon)
    linear(normalized, query_gate_weight, query_gate)
    linear(normalized, key_weight, key)
    linear(normalized, value_weight, value)
    return query_gate, key, value

native qwen_attention_project for metal from "metal/qwen_attention_project.metal":
    static (D, KV, G, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            arithmetic BATCH_FROM in [5, 3, 9], BATCH_SIMDGROUPS in [8, 4, 16, 32], BATCH_ROWS in [2, 1, 4],
            TILE_M in [64, 128, 32], TILE_N in [64, 128])
    scratch normalized bytes (min(M / 9, 1) * M * D * 2)
    launch qwen_attention_project_normalize:
        threadgroups (min(M / 9, 1) * M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_project_gemv:
        threadgroups ((1 - min(M / BATCH_FROM, 1)) * (ceil_div(KV * G * 2 * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(KV * W, SIMDGROUPS * ROWS * 32 / LANES)), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(M, 8) * min(ceil_div(D, 32), 288 / max(M, 1)) * 72)
    launch qwen_attention_project_batch:
        threadgroups (min(M / BATCH_FROM, 1) * (1 - min(M / 9, 1)) * (ceil_div(KV * G * 2 * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + 2 * ceil_div(KV * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8)), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16512)
    launch qwen_attention_project_gemm:
        threadgroups (min(M / 9, 1) * (ceil_div(KV * G * 2 * W, TILE_N) + 2 * ceil_div(KV * W, TILE_N)),
            ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)


# The output projection of the Q = KV * G gated attention heads plus the F32
# residual. Native Metal: the K1 projection library.
fn qwen_attention_output[M, D, Q, W](hidden: &tensor[M, D] f32,
    gated: &tensor[M, Q, W] A, output_weight: &tensor[D, Q * W] OW) -> tensor[M, D] f32:
    let mut projected = tensor[M, D] A
    let mut result = tensor[M, D] f32
    linear(reshape(gated, (M, Q * W)), output_weight, projected)
    add(hidden, projected, result)
    return result

native qwen_attention_output for metal from "metal/qwen_attention_output.metal":
    static (D, Q, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            arithmetic BATCH_FROM in [5, 3, 9], BATCH_SIMDGROUPS in [8, 4, 16, 32], BATCH_ROWS in [2, 1, 4],
            TILE_M in [64, 128, 32], TILE_N in [64, 128], arithmetic SPLIT in [1, 2, 4])
    scratch partials bytes (SPLIT * M * D * 4)
    launch qwen_attention_output_gemv:
        threadgroups ((1 - min(M / BATCH_FROM, 1)) * ceil_div(D, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(M, 8) * min(ceil_div(Q * W, 32), 288 / max(M, 1)) * 72)
    launch qwen_attention_output_batch:
        threadgroups (min(M / BATCH_FROM, 1) * (1 - min(M / 9, 1)) * ceil_div(D, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16512)
    launch qwen_attention_output_gemm:
        threadgroups (min(M / 9, 1) * ceil_div(D, TILE_N), ceil_div(M, TILE_M), SPLIT)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch qwen_attention_output_reduce:
        threadgroups (min(M / 9, 1) * (min(SPLIT, 2) - 1) * ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
