    where (2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256) and P % ((2 * P + S) / 32) == 0
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch qwen_attention_decode_k8v4_partial:
