native qwen_attention_prefill_k8v4 for vulkan from "vulkan/qwen_attention_prefill_k8v4.comp":
    static (KV, G, P, S)
    params (arithmetic ROWS in [64, 128], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where (2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256) and P % ((2 * P + S) / 32) == 0 and ROWS % G == 0 and ROWS / G <= 32 and 64 * (2 * P + S + 8) + ROWS / 16 * 2048 <= 32768
    scratch queries bytes (ceil_div(M, ROWS / G) * (ROWS / G) * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
