# Prefill rows (M >= 16) over affine K8/V4 history: `qwen_attention_prefill`
# with the prepare launch appending encoded rows and every history K/V tile
# decoded (code * scale + zero, rounded to the activation dtype) as it is
# staged, so the products are unchanged and read 2.6x fewer history bytes.
fn qwen_attention_prefill_k8v4[M, T, KV, G, P, S, R](
    query_gate: &tensor[M, KV * G * 2 * (2 * P + S)] A,
    key: &tensor[M, KV * (2 * P + S)] A, value: &tensor[M, KV * (2 * P + S)] A,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key_codes: &mut tensor[T, KV, (2 * P + S) / 4] u32,
    history_key_coefficients: &mut tensor[T, KV, 2] f16,
    history_value_codes: &mut tensor[T, KV, (2 * P + S) / 8] u32,
    history_value_coefficients: &mut tensor[T, KV, 2] f16,
    epsilon: f32, scale: f32) -> tensor[M, KV * G, 2 * P + S] A:
    return qwen_gated_attention_k8v4[G = G](query_gate, key, value, query_norm, key_norm,
        rotary_components, rotary_frequencies, coordinates, visible, fresh,
        destinations, history_key_codes, history_key_coefficients, history_value_codes,
        history_value_coefficients, epsilon, scale)

native qwen_attention_prefill_k8v4 for metal from "metal/qwen_attention_prefill_k8v4.metal":
    static (KV, G, P, S)
    params (arithmetic QT in [16, 8], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where 2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256
    scratch queries bytes (ceil_div(M, QT) * QT * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, QT) * 4)
    launch qwen_attention_prefill_k8v4_prepare:
        threadgroups (ceil_div(ceil_div(M, QT) * QT * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_prefill_k8v4_attend:
        threadgroups (ceil_div(M, QT), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)))
        threads_per_threadgroup (QT * G * 4, 1, 1)
        shared_bytes (32 * (2 * P + S + 8) * 2 + (R + 1) * 16)
    launch qwen_attention_prefill_k8v4_merge when ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV) > 1:
        threadgroups (ceil_div(M, QT), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: `qwen_attention_prefill` over affine history (2.6x fewer history
# bytes): the attend launch adds WARPS producer warps that load code tiles and
# store them as exact integer operands while the WARPS MMA warps run the
# previous tile; the codec applies around the products (scores scale * (q .
# code) + zero * sum(q); probabilities times the value scale, sum(p * zero)
# carried as a bias). Shared memory: the dense entry's, plus each stage's
# pairs. (Metal: decodes each staged tile to the activation dtype, keeps the
# dense products.)
native qwen_attention_prefill_k8v4 for cuda from "cuda/qwen_attention_prefill_k8v4.cu":
    static (KV, G, P, S)
    params (arithmetic WARPS in [4, 2])
    where (2 * P + S) % 32 == 0 and 256 % (2 * P + S) == 0 and 16 % G == 0
    scratch queries bytes (M * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 4)
    launch qwen_attention_prefill_k8v4_prepare:
        threadgroups (ceil_div(M * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_prefill_k8v4_attend:
        threadgroups (ceil_div(M * G, WARPS * 16), KV, 1)
        threads_per_threadgroup (WARPS * 64, 1, 1)
        shared_bytes ((WARPS * 16 + 4 * 32) * (2 * P + S) * 2 + 512 + (R + 1) * 16)

# Vulkan: the dense prefill's launches (`vulkan/common/prefill.glsl`); the
# prepare launch appends encoded rows and history tiles decode (rounded to A)
