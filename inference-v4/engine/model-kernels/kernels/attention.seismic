    params (arithmetic QT in [16, 8], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where 2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256
    scratch queries bytes (ceil_div(M, QT) * QT * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
