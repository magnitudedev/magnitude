# Qwen gated attention over projected rows: q/k RMS norms and partial M-RoPE,
# attention over each row's visible history spans plus its fresh span of this
# batch's rows, the sigmoid output gate, and the K/V append at `destinations`.
#
# The prepared query and key are published in the activation dtype; the key
# exactly as it is stored in history, so a fresh read and a later history read
# of the same key agree. A row with no visible key attends to zero.
# Destinations are freshly reserved history rows: no row of the batch sees one
# of them through `visible`, so the append is independent of every read.
#
# A block runs `qwen_attention_project` (normed Q/K/V projection), then
# `qwen_attention_decode` or `_prefill` (or their `_k8v4` forms over affine
# history), then `attention_output` (output projection plus residual).

# query_norm fixes W for the checked flattened KV*G*W projection shape; the
# projection does not read it. RMS prologue over the F32 residual, then one
# segmented projection query+gate | key | value, each segment with its own
# representation. Both backends run the K1 projection library (see
# `dense.seismic` for its launches; segments enumerate their tile groups or
# block columns in segment order).
fn qwen_attention_project[M, D, KV, G, W](hidden: &tensor[M, D] f32,
    input_norm: &tensor[D] NW, query_norm: &tensor[W] f32,
    query_gate_weight: &tensor[KV * G * 2 * W, D] QW,
    key_weight: &tensor[KV * W, D] KW, value_weight: &tensor[KV * W, D] VW, epsilon: f32)
    -> (tensor[M, KV * G * 2 * W] A, tensor[M, KV * W] A, tensor[M, KV * W] A):
    let mut normalized = tensor[M, D] A
    let mut query_gate = tensor[M, KV * G * 2 * W] A
    let mut key = tensor[M, KV * W] A
    let mut value = tensor[M, KV * W] A
    rms_norm(hidden, input_norm, normalized, epsilon)
    linear(normalized, query_gate_weight, query_gate)
    linear(normalized, key_weight, key)
    linear(normalized, value_weight, value)
    return query_gate, key, value

# Metal: GEMV below BATCH_FROM rows, batched GEMV to 16, each normalizing its
# rows in-threadgroup; larger classes stage the normalized rows, then the
# GEMM. (CUDA: GEMV to 16 rows, INT8 candidate on the GEMM.)
native qwen_attention_project for metal from "metal/qwen_attention_project.metal":
    static (D, KV, G, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            arithmetic BATCH_FROM in [5, 3, 9], BATCH_SIMDGROUPS in [8, 4, 16, 32], BATCH_ROWS in [2, 1, 4],
            TILE_M in [64, 128, 32], TILE_N in [64, 128])
    scratch normalized bytes (M * D * 2) when M > 16
    launch qwen_attention_project_stage when M > 16:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_project_gemv when M < BATCH_FROM:
        threadgroups (ceil_div(KV * G * 2 * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(KV * W, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (M * min(ceil_div(D, 32), 288 / max(M, 1)) * 72)
    launch qwen_attention_project_batch when M >= BATCH_FROM and M <= 16:
        threadgroups (ceil_div(KV * G * 2 * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8)
            + 2 * ceil_div(KV * W, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch qwen_attention_project_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(KV * G * 2 * W, 64) + 2 * ceil_div(KV * W, 64), ceil_div(M, 32), 1)
        threads_per_threadgroup (128, 1, 1)
    launch qwen_attention_project_gemm when M > 64:
        threadgroups (ceil_div(KV * G * 2 * W, TILE_N) + 2 * ceil_div(KV * W, TILE_N),
            ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)

# CUDA: `stage` forms the normalized rows (rows > 1; at one row the GEMV block
# forms it in shared memory), GEMV to 8 rows, `gemv16` (two 8-row column
# blocks) to 16, GEMM beyond with the INT8 candidate. (Metal: batched GEMV
# class, no INT8 path.)
native qwen_attention_project for cuda from "cuda/qwen_attention_project.cu":
    static (D, KV, G, W)
    params (arithmetic KSPLIT in [4, 2, 8], BM in [64, 128], arithmetic INT8 in [0, 1])
    where D % 64 == 0
    scratch staged bytes (M * D * 2) when M > 1
    scratch groups bytes (M * D / 4) when INT8 == 1 and M > 16
    launch qwen_attention_project_stage when M > 1:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_project_gemv when M <= 8:
        threadgroups (ceil_div(ceil_div(KV * G * 2 * W, 16) + 2 * ceil_div(KV * W, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - min(1, M - 1)) * D * 2)
    launch qwen_attention_project_gemv16 when M > 8 and M <= 16:
        threadgroups (ceil_div(ceil_div(KV * G * 2 * W, 16) + 2 * ceil_div(KV * W, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_project_gemm when M > 16:
        threadgroups (ceil_div(ceil_div(KV * G * 2 * W, 16), 8) + 2 * ceil_div(ceil_div(KV * W, 16), 8),
            ceil_div(M, BM), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((4 - BM / 64) * (BM * 144 + 10240) + 4096)

# Vulkan: the K1 projection library (`vulkan/common/projection.glsl`). Rows
# M <= 8 run the GEMV launch (SIMDGROUPS x ROWS lane groups of LANES lanes
# per workgroup, each owning weight rows; LANES sets the reduction order, so
# it is arithmetic) with the norm prologue in-workgroup; larger classes a
# stage launch writing the normalized rows to scratch, then the GEMM over
# TILE_M x TILE_N tiles (cooperative-matrix f16 multiplies under
# SEISMIC_HAS_MATRIX, F32 FMAs otherwise). (No batched GEMV class, no INT8.)
native qwen_attention_project for vulkan from "vulkan/qwen_attention_project.comp":
    static (D, KV, G, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            TILE_M in [64, 128, 32], TILE_N in [64, 128])
    scratch normalized bytes (M * D * 2) when M > 8
    launch qwen_attention_project_stage when M > 8:
        threadgroups (M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (128)
    launch qwen_attention_project_gemv when M <= 8:
        threadgroups (ceil_div(KV * G * 2 * W, SIMDGROUPS * ROWS * 32 / LANES)
            + 2 * ceil_div(KV * W, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (256 + min(8 * ceil_div(D, 32), 288) * 72)
    launch qwen_attention_project_gemm when M > 8:
        threadgroups (ceil_div(KV * G * 2 * W, TILE_N) + 2 * ceil_div(KV * W, TILE_N), ceil_div(M, TILE_M), 1)
        threads_per_threadgroup (TILE_M * TILE_N / 32, 1, 1)
        shared_bytes ((TILE_M + TILE_N) * 80)

# One head row RMS-normalized in F32, its first 2P columns rotated: pair p by
# the coordinate on axis components[p] at frequencies[p] (a static table the
# engine derives from the model's rotary base and sections).
fn qwen_norm_rotary[P, S](x: &tensor[2 * P + S] A, wt: &tensor[2 * P + S] f32,
    coordinates: &tensor[4] i32, components: &tensor[P] i32,
    frequencies: &tensor[P] f32, epsilon: f32) -> tensor[2 * P + S] f32:
    let xf = f32(x)
    let ss = sum_any_order(xf * xf)
    let inv = rsqrt(ss / f32(2 * P + S) + epsilon)
    let normalized = xf * inv * wt
    let mut rotated = zeros_like(x, dtype=f32)
    for i in 0..2 * P + S:
        if i < 2 * P:
            let pair = i % P
            let angle = f32(coordinates[components[pair]]) * frequencies[pair]
            if i < P:
                rotated[i] = normalized[i] * cos(angle) - normalized[i + P] * sin(angle)
            else:
                rotated[i] = normalized[i] * cos(angle) + normalized[i - P] * sin(angle)
        else:
            rotated[i] = normalized[i]
    return rotated

fn qwen_gated_attention[M, T, KV, G, P, S, R](
    query_gate: &tensor[M, KV * G * 2 * (2 * P + S)] A,
    key: &tensor[M, KV * (2 * P + S)] A, value: &tensor[M, KV * (2 * P + S)] A,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    epsilon: f32, scale: f32) -> tensor[M, KV * G, 2 * P + S] A:
    let mut prepared_key = tensor[M, KV, 2 * P + S] A
    for row in 0..M:
        for head in 0..KV:
            prepared_key[row, head] = qwen_norm_rotary(
                key[row, head * (2 * P + S) : (head + 1) * (2 * P + S)], key_norm,
                coordinates[row], rotary_components, rotary_frequencies, epsilon)
    let fresh_value = reshape(value, (M, KV, 2 * P + S))
    let mut gated = tensor[M, KV * G, 2 * P + S] A
    for row in 0..M:
        for kv_head in 0..KV:
            let mut qt = tensor[G, 2 * P + S] A
            let mut maximum = tensor[G] f32
            let mut denominator = tensor[G] f32
            let mut accumulator = tensor[G, 2 * P + S] f32
            for head in 0..G:
                let first = (kv_head * G + head) * 2 * (2 * P + S)
                qt[head] = qwen_norm_rotary(query_gate[row, first : first + (2 * P + S)],
                    query_norm, coordinates[row], rotary_components, rotary_frequencies,
                    epsilon)
                maximum[head] = -inf
                denominator[head] = 0.0
                for column in 0..2 * P + S:
                    accumulator[head, column] = 0.0
            for span in 0..R:
                let lo = visible[row, span, 0]
                let hi = visible[row, span, 1]
                if hi > lo:
                    attention_update(qt, history_key[lo : hi, kv_head],
                        history_value[lo : hi, kv_head], maximum, denominator,
                        accumulator, scale)
            let fresh_lo = fresh[row, 0]
            let fresh_hi = fresh[row, 1]
            if fresh_hi > fresh_lo:
                attention_update(qt, prepared_key[fresh_lo : fresh_hi, kv_head],
                    fresh_value[fresh_lo : fresh_hi, kv_head], maximum, denominator,
                    accumulator, scale)
            for head in 0..G:
                let gate_first = (kv_head * G + head) * 2 * (2 * P + S) + (2 * P + S)
                for column in 0..2 * P + S:
                    let gate = f32(query_gate[row, gate_first + column])
                    let attended = accumulator[head, column] / max(denominator[head], 1e-30)
                    gated[row, kv_head * G + head, column] = attended / (1.0 + exp(-gate))
    for row in 0..M:
        if destinations[row] >= 0:
            for head in 0..KV:
                history_key[destinations[row], head] = prepared_key[row, head]
                history_value[destinations[row], head] = fresh_value[row, head]
    return gated


# Decode rows (M <= 8). L1: one threadgroup per (kv head, partition, row). A
# row's visible keys (spans in order, then its fresh span) split into
# consecutive partitions of max(SPAN, ceil(keys / PARTS)) keys, so a short row
# still spreads over several partitions and a long one over all PARTS. The
# SIMDS simdgroups of a partition scan contiguous sub-ranges of it for all G
# query heads, so each K/V row is read once per kv head. Partition 0 also
# appends the row's K/V. L2: per (query head, row), a fixed-order LSE merge of
# the row's partitions and the sigmoid gate.
fn qwen_attention_decode[M, T, KV, G, P, S, R](
    query_gate: &tensor[M, KV * G * 2 * (2 * P + S)] A,
    key: &tensor[M, KV * (2 * P + S)] A, value: &tensor[M, KV * (2 * P + S)] A,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    epsilon: f32, scale: f32) -> tensor[M, KV * G, 2 * P + S] A:
    return qwen_gated_attention[G = G](query_gate, key, value, query_norm, key_norm,
        rotary_components, rotary_frequencies, coordinates, visible, fresh,
        destinations, history_key, history_value, epsilon, scale)

# Metal: partitions of max(SPAN, ceil(keys / PARTS)) keys. (CUDA: equal
# partitions.)
native qwen_attention_decode for metal from "metal/qwen_attention_decode.metal":
    static (KV, G, P, S)
    params (arithmetic SPAN in [32, 64, 128, 256], arithmetic PARTS in [16, 8, 32],
        arithmetic SIMDS in [4, 8])
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch qwen_attention_decode_partial:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (SIMDS * 32, 1, 1)
        shared_bytes ((G + SIMDS) * (2 * P + S) * 4 + SIMDS * G * 8)
    launch qwen_attention_decode_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: split-KV decode over PARTS equal partitions per (kv head, row), sized
# for the 48 SMs of GB10 (KV * PARTS blocks per row); WARPS warps per block
# scan contiguous slices of the partition. Head width 2 * P + S is a multiple
# of 32 up to 256: a warp holds one head vector at W / 32 dimensions per lane.
# (Metal: partitions with a SPAN minimum.)
native qwen_attention_decode for cuda from "cuda/qwen_attention_decode.cu":
    static (KV, G, P, S)
    params (arithmetic PARTS in [12, 24, 48], arithmetic WARPS in [4, 8])
    where (2 * P + S) % 32 == 0 and 2 * P + S <= 256
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch qwen_attention_decode_partial:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (WARPS * 32, 1, 1)
        shared_bytes ((G + WARPS) * (2 * P + S) * 4 + WARPS * G * 8)
    launch qwen_attention_decode_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# Vulkan: the Metal form (`vulkan/common/attention.glsl`): L1 workgroups (kv
# head, partition, row) of SIMDS subgroups scanning contiguous sub-ranges of
# the partition, L2 the fixed-order merge and gate. A lane owns W / 32
# contiguous columns, with a whole number of lanes per rotary half.
native qwen_attention_decode for vulkan from "vulkan/qwen_attention_decode.comp":
    static (KV, G, P, S)
    params (arithmetic SPAN in [32, 64, 128, 256], arithmetic PARTS in [16, 8, 32],
        arithmetic SIMDS in [4, 8])
    where (2 * P + S) % 32 == 0 and P % ((2 * P + S) / 32) == 0
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch qwen_attention_decode_partial:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (SIMDS * 32, 1, 1)
        shared_bytes ((G + SIMDS) * (2 * P + S) * 4 + SIMDS * G * 8)
    launch qwen_attention_decode_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)


# Prefill rows (M >= 16). L1: one simdgroup per (row, query or key head)
# prepares the query or the key (activation dtype) into scratch, copies the
# value beside it, and appends K/V at the row's destination; query rows are
# padded with zeros to whole QT tiles. L2: streaming attention per (QT-row
# tile, kv head, key partition); the tile's QT tokens x G query heads are the
# matrix rows. Each visible span, then the fresh span, is staged over the
# union of the tile rows' intervals in 32-key K/V tiles sharing one
# threadgroup buffer; per-row masks apply only to tiles outside the rows'
# common interval. Queries and probabilities enter the products in the
# activation dtype; scores, the softmax state and the output are F32. The key
# tiles split into consecutive runs of at least 16 tiles over up to
# max(1, ceil(SPLIT_GROUPS / (tiles * KV))) partitions, so a long history
# fills the device and a short one runs unsplit. A tile served by one
# partition stores its gated output directly (gate fused into the store);
# otherwise L3 merges the partitions' (partial output, maximum, denominator)
# in partition order with the decode merge rule and applies the gate.
fn qwen_attention_prefill[M, T, KV, G, P, S, R](
    query_gate: &tensor[M, KV * G * 2 * (2 * P + S)] A,
    key: &tensor[M, KV * (2 * P + S)] A, value: &tensor[M, KV * (2 * P + S)] A,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key: &mut tensor[T, KV, 2 * P + S] A,
    history_value: &mut tensor[T, KV, 2 * P + S] A,
    epsilon: f32, scale: f32) -> tensor[M, KV * G, 2 * P + S] A:
    return qwen_gated_attention[G = G](query_gate, key, value, query_norm, key_norm,
        rotary_components, rotary_frequencies, coordinates, visible, fresh,
        destinations, history_key, history_value, epsilon, scale)

# Metal: key partitions plus a `merge` launch when a tile is split (3
# launches). (CUDA: unsplit, 2 launches.)
native qwen_attention_prefill for metal from "metal/qwen_attention_prefill.metal":
    static (KV, G, P, S)
    params (arithmetic QT in [16, 8], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    scratch queries bytes (ceil_div(M, QT) * QT * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, QT) * 4)
    launch qwen_attention_prefill_prepare:
        threadgroups (ceil_div(ceil_div(M, QT) * QT * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_prefill_attend:
        threadgroups (ceil_div(M, QT), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV)))
        threads_per_threadgroup (QT * G * 4, 1, 1)
        shared_bytes (32 * (2 * P + S + 8) * 2 + (R + 1) * 16)
    launch qwen_attention_prefill_merge when ceil_div(SPLIT_GROUPS, ceil_div(M, QT) * KV) > 1:
        threadgroups (ceil_div(M, QT), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: flash attention on m16n8k16 tensor cores. A block owns WARPS * 16
# matrix rows (WARPS * 16 / G tokens x G query heads) of one kv head; K/V
# tiles of 32 keys are double-buffered next to the query tile in shared
# memory; prefill tiles are 16-bit rows of whole 16-byte chunks. (Metal: key
# partitions and a merge launch.)
native qwen_attention_prefill for cuda from "cuda/qwen_attention_prefill.cu":
    static (KV, G, P, S)
    params (arithmetic WARPS in [4, 2])
    where (2 * P + S) % 32 == 0 and 2 * P + S <= 256 and 16 % G == 0
    scratch queries bytes (M * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 4)
    launch qwen_attention_prefill_prepare:
        threadgroups (ceil_div(M * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_prefill_attend:
        threadgroups (ceil_div(M * G, WARPS * 16), KV, 1)
        threads_per_threadgroup (WARPS * 32, 1, 1)
        shared_bytes ((WARPS * 16 + 4 * 32) * (2 * P + S) * 2 + (R + 1) * 16)

# Vulkan (`vulkan/common/prefill.glsl`): L1 prepares queries/keys (f16
# scratch, queries [KV][rows][G][W]) and appends K/V; L2 streams 32-key K/V
# tiles per (tile of ROWS / G tokens x G query heads, kv head, key partition)
# in two passes (row maxima, then accumulation), 16 matrix rows per subgroup
# (cooperative matrices under SEISMIC_HAS_MATRIX, F32 FMAs otherwise); L3
# merges split tiles.
native qwen_attention_prefill for vulkan from "vulkan/qwen_attention_prefill.comp":
    static (KV, G, P, S)
    params (arithmetic ROWS in [64, 128], arithmetic SPLIT_GROUPS in [256, 128, 512, 1])
    where (2 * P + S) % 32 == 0 and (2 * P + S <= 64 or (2 * P + S) % 64 == 0) and P % ((2 * P + S) / 32) == 0 and ROWS % G == 0 and ROWS / G <= 32 and 64 * (2 * P + S + 8) + ROWS / 16 * 2048 <= 32768
    scratch queries bytes (ceil_div(M, ROWS / G) * (ROWS / G) * KV * G * (2 * P + S) * 2)
    scratch keys bytes (M * KV * (2 * P + S) * 2)
    scratch values bytes (M * KV * (2 * P + S) * 2)
    scratch partials bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)) * M * KV * G * (2 * P + S) * 4)
    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, ROWS / G) * 4)
    launch qwen_attention_prefill_prepare:
        threadgroups (ceil_div(ceil_div(M, ROWS / G) * (ROWS / G) * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_prefill_attend:
        threadgroups (ceil_div(M, ROWS / G), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)))
        threads_per_threadgroup (ROWS * 2, 1, 1)
        shared_bytes (64 * (2 * P + S + 8) + ROWS / 16 * 2048)
    launch qwen_attention_prefill_merge when SPLIT_GROUPS > ceil_div(M, ROWS / G) * KV:
        threadgroups (ceil_div(M, ROWS / G), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)


# Affine K8/V4 history (the `affine_k8_uniform_v4` KV codec). Every (history
# row, kv head) vector of W values x is one affine group stored as codes plus
# an F16 coefficient pair (scale, zero): zero = f16(min x), scale =
# f16((max x - min x) / L) and code = min(L, u32(fma(x - zero, 1 / scale,
# 0.5))) (0 when scale is 0), decoded as code * scale + zero. Keys use 8-bit
# codes (L = 255, four per u32 word), values 4-bit codes (L = 15, eight per
# word); code i sits at bits B * (i % (32 / B)) of word i / (32 / B). The key
# encoded is the prepared key rounded to the activation dtype, the value the
# projected value. Fresh rows of the batch attend dense; only history is
# encoded.
fn affine_encode[W, N](x: &tensor[W] f32, codes: &mut tensor[N] u32,
    coefficients: &mut tensor[2] f16):
    let levels = (u32(1) << u32(32 * N / W)) - u32(1)
    let low = reduce(x, 0, min)
    let high = reduce(x, 0, max)
    let zero = f16(low)
    let scale = f16((high - low) / f32(levels))
    let mut inverse = 0.0
    if f32(scale) > 0.0:
        inverse = 1.0 / f32(scale)
    for word in 0..N:
        codes[word] = u32(0)
    for i in 0..W:
        let word = i / (W / N)
        if word < N:
            let code = min(u32(fma(x[i] - f32(zero), inverse, 0.5)), levels)
            codes[word] = codes[word] | (code << (u32(i % (W / N)) * u32(32 * N / W)))
    coefficients[0] = scale
    coefficients[1] = zero

fn affine_decode[W, N](codes: &tensor[N] u32, coefficients: &tensor[2] f16,
    x: &mut tensor[W] f32):
    let levels = (u32(1) << u32(32 * N / W)) - u32(1)
    let scale = f32(coefficients[0])
    let zero = f32(coefficients[1])
    for i in 0..W:
        let word = i / (W / N)
        if word < N:
            let code = (codes[word] >> (u32(i % (W / N)) * u32(32 * N / W))) & levels
            x[i] = fma(f32(code), scale, zero)

# One decoded history key/value absorbed by the online softmax of G query
# heads (F32 scores and state).
fn attention_absorb[G, W](qt: &tensor[G, W] A, key: &tensor[W] f32,
    value: &tensor[W] f32, m: &mut tensor[G] f32, l: &mut tensor[G] f32,
    acc: &mut tensor[G, W] f32, scale: f32):
    for head in 0..G:
        let mut dot = 0.0
        for column in 0..W:
            dot = fma(f32(qt[head, column]), key[column], dot)
        let next = max(m[head], dot * scale)
        let p = exp(dot * scale - next)
        let carry = exp(m[head] - next)
        l[head] = fma(l[head], carry, p)
        for column in 0..W:
            acc[head, column] = fma(p, value[column], acc[head, column] * carry)
        m[head] = next

fn qwen_gated_attention_k8v4[M, T, KV, G, P, S, R](
    query_gate: &tensor[M, KV * G * 2 * (2 * P + S)] A,
    key: &tensor[M, KV * (2 * P + S)] A, value: &tensor[M, KV * (2 * P + S)] A,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key_codes: &mut tensor[T, KV, (2 * P + S) / 4] u32,
    history_key_coefficients: &mut tensor[T, KV, 2] f16,
    history_value_codes: &mut tensor[T, KV, (2 * P + S) / 8] u32,
    history_value_coefficients: &mut tensor[T, KV, 2] f16,
    epsilon: f32, scale: f32) -> tensor[M, KV * G, 2 * P + S] A:
    let mut prepared_key = tensor[M, KV, 2 * P + S] A
    for row in 0..M:
        for head in 0..KV:
            prepared_key[row, head] = qwen_norm_rotary(
                key[row, head * (2 * P + S) : (head + 1) * (2 * P + S)], key_norm,
                coordinates[row], rotary_components, rotary_frequencies, epsilon)
    let fresh_value = reshape(value, (M, KV, 2 * P + S))
    let mut gated = tensor[M, KV * G, 2 * P + S] A
    let mut decoded_key = tensor[2 * P + S] f32
    let mut decoded_value = tensor[2 * P + S] f32
    for column in 0..2 * P + S:
        decoded_key[column] = 0.0
        decoded_value[column] = 0.0
    for row in 0..M:
        for kv_head in 0..KV:
            let mut qt = tensor[G, 2 * P + S] A
            let mut maximum = tensor[G] f32
            let mut denominator = tensor[G] f32
            let mut accumulator = tensor[G, 2 * P + S] f32
            for head in 0..G:
                let first = (kv_head * G + head) * 2 * (2 * P + S)
                qt[head] = qwen_norm_rotary(query_gate[row, first : first + (2 * P + S)],
                    query_norm, coordinates[row], rotary_components, rotary_frequencies,
                    epsilon)
                maximum[head] = -inf
                denominator[head] = 0.0
                for column in 0..2 * P + S:
                    accumulator[head, column] = 0.0
            for span in 0..R:
                let lo = visible[row, span, 0]
                let hi = visible[row, span, 1]
                if lo >= 0 and hi > lo and (2 * P + S) / 8 >= 1 and (2 * P + S) / 4 >= 1:
                    for token in lo..hi:
                        affine_decode(history_key_codes[token, kv_head],
                            history_key_coefficients[token, kv_head], decoded_key)
                        affine_decode(history_value_codes[token, kv_head],
                            history_value_coefficients[token, kv_head], decoded_value)
                        attention_absorb(qt, decoded_key, decoded_value, maximum, denominator,
                            accumulator, scale)
            let fresh_lo = fresh[row, 0]
            let fresh_hi = fresh[row, 1]
            if fresh_hi > fresh_lo:
                attention_update(qt, prepared_key[fresh_lo : fresh_hi, kv_head],
                    fresh_value[fresh_lo : fresh_hi, kv_head], maximum, denominator,
                    accumulator, scale)
            for head in 0..G:
                let gate_first = (kv_head * G + head) * 2 * (2 * P + S) + (2 * P + S)
                for column in 0..2 * P + S:
                    let gate = f32(query_gate[row, gate_first + column])
                    let attended = accumulator[head, column] / max(denominator[head], 1e-30)
                    gated[row, kv_head * G + head, column] = attended / (1.0 + exp(-gate))
    for row in 0..M:
        if destinations[row] >= 0 and (2 * P + S) / 8 >= 1 and (2 * P + S) / 4 >= 1:
            for head in 0..KV:
                affine_encode(f32(prepared_key[row, head]),
                    history_key_codes[destinations[row], head],
                    history_key_coefficients[destinations[row], head])
                affine_encode(f32(fresh_value[row, head]),
                    history_value_codes[destinations[row], head],
                    history_value_coefficients[destinations[row], head])
    return gated


# Decode rows (M <= 8) over affine K8/V4 history: `qwen_attention_decode`'s
# partitioning and merge. Scores against history are corrected, not decoded:
# scale * (q . code) + zero * sum(q); the value product accumulates
# (p * scale) * code and carries sum(p * zero) through the online softmax as a
# per-head bias added before the partition state is published. Partition 0
# appends the row's key and value encoded.
fn qwen_attention_decode_k8v4[M, T, KV, G, P, S, R](
    query_gate: &tensor[M, KV * G * 2 * (2 * P + S)] A,
    key: &tensor[M, KV * (2 * P + S)] A, value: &tensor[M, KV * (2 * P + S)] A,
    query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    rotary_components: &tensor[P] i32, rotary_frequencies: &tensor[P] f32,
    coordinates: &tensor[M, 4] i32, visible: &tensor[M, R, 2] i32,
    fresh: &tensor[M, 2] i32, destinations: &tensor[M] i32,
    history_key_codes: &mut tensor[T, KV, (2 * P + S) / 4] u32,
    history_key_coefficients: &mut tensor[T, KV, 2] f16,
    history_value_codes: &mut tensor[T, KV, (2 * P + S) / 8] u32,
    history_value_coefficients: &mut tensor[T, KV, 2] f16,
    epsilon: f32, scale: f32) -> tensor[M, KV * G, 2 * P + S] A:
    return qwen_gated_attention_k8v4[G = G](query_gate, key, value, query_norm, key_norm,
        rotary_components, rotary_frequencies, coordinates, visible, fresh,
        destinations, history_key_codes, history_key_coefficients, history_value_codes,
        history_value_coefficients, epsilon, scale)

# A lane's W / 32 codes must be whole words or a power-of-two part of one, so
# W is a power of two.
native qwen_attention_decode_k8v4 for metal from "metal/qwen_attention_decode_k8v4.metal":
    static (KV, G, P, S)
    params (arithmetic SPAN in [32, 64, 128, 256], arithmetic PARTS in [16, 8, 32],
        arithmetic SIMDS in [4, 8])
    where 2 * P + S == 32 or 2 * P + S == 64 or 2 * P + S == 128 or 2 * P + S == 256
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch qwen_attention_decode_k8v4_partial:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (SIMDS * 32, 1, 1)
        shared_bytes ((G + SIMDS) * (2 * P + S) * 4 + SIMDS * G * 8)
    launch qwen_attention_decode_k8v4_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# CUDA: `qwen_attention_decode`'s equal split-KV partitioning; history keys
# score against raw codes (scale * (q . code) + zero * sum(q)) and values
# accumulate (p * scale) * code plus the carried bias sum(p * zero). W is a
# multiple of 32 dividing 256. (Metal: partitions with a SPAN minimum.)
native qwen_attention_decode_k8v4 for cuda from "cuda/qwen_attention_decode_k8v4.cu":
    static (KV, G, P, S)
    params (arithmetic PARTS in [12, 24, 48], arithmetic WARPS in [4, 8])
    where (2 * P + S) % 32 == 0 and 256 % (2 * P + S) == 0
    scratch partials bytes (M * KV * G * PARTS * (2 * P + S) * 4)
    scratch statistics bytes (M * KV * G * PARTS * 8)
    launch qwen_attention_decode_k8v4_partial:
        threadgroups (KV, PARTS, M)
        threads_per_threadgroup (WARPS * 32, 1, 1)
        shared_bytes ((G + WARPS) * (2 * P + S) * 4 + WARPS * G * 8)
    launch qwen_attention_decode_k8v4_merge:
        threadgroups (KV * G, M, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)

# Vulkan: the Metal form (`vulkan/common/history.glsl`): the dense decode's
