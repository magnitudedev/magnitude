    scratch statistics bytes (max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)) * M * KV * G * 8)
    scratch counts bytes (ceil_div(M, ROWS / G) * 4)
    launch qwen_attention_prefill_k8v4_prepare:
        threadgroups (ceil_div(ceil_div(M, ROWS / G) * (ROWS / G) * KV * (G + 1), 8), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_prefill_k8v4_attend:
        threadgroups (ceil_div(M, ROWS / G), KV, max(1, ceil_div(SPLIT_GROUPS, ceil_div(M, ROWS / G) * KV)))
        threads_per_threadgroup (ROWS * 2, 1, 1)
        shared_bytes (64 * (2 * P + S + 8) + ROWS / 16 * 2048)
    launch qwen_attention_prefill_k8v4_merge when SPLIT_GROUPS > ceil_div(M, ROWS / G) * KV:
        threadgroups (ceil_div(M, ROWS / G), KV * G, 1)
        threads_per_threadgroup (2 * P + S, 1, 1)


# The output projection of the Q = KV * G gated attention heads plus the F32
# residual. Both backends: the K1 projection library.
fn attention_output[M, D, Q, W](hidden: &tensor[M, D] f32,
    gated: &tensor[M, Q, W] A, output_weight: &tensor[D, Q * W] OW) -> tensor[M, D] f32:
    let mut projected = tensor[M, D] A
    let mut result = tensor[M, D] f32
    linear(reshape(gated, (M, Q * W)), output_weight, projected)
    add(hidden, projected, result)
    return result

# Metal: GEMV below BATCH_FROM rows, batched GEMV to 16, GEMM beyond with
# SPLIT-way split-K summed by `finalize`. The input needs no prologue, so
# there is no `stage`. (CUDA: GEMV to 16 rows, INT8 candidate on the GEMM.)
native attention_output for metal from "metal/attention_output.metal":
    static (D, Q, W)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            arithmetic BATCH_FROM in [5, 3, 9], BATCH_SIMDGROUPS in [8, 4, 16, 32], BATCH_ROWS in [2, 1, 4],
            TILE_M in [64, 128, 32], TILE_N in [64, 128], arithmetic SPLIT in [1, 2, 4])
    scratch partials bytes (SPLIT * M * D * 4) when M > 64 and SPLIT > 1
    scratch small_partials bytes (4 * M * D * 4) when M > 16 and M <= 64
    launch attention_output_gemv when M < BATCH_FROM:
        threadgroups (ceil_div(D, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (M * min(ceil_div(Q * W, 32), 288 / max(M, 1)) * 72)
    launch attention_output_batch when M >= BATCH_FROM and M <= 16:
        threadgroups (ceil_div(D, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16640)
    launch attention_output_gemm_small when M > 16 and M <= 64:
        threadgroups (ceil_div(D, 64), ceil_div(M, 32), 4)
        threads_per_threadgroup (128, 1, 1)
    launch attention_output_finalize_small when M > 16 and M <= 64:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch attention_output_gemm when M > 64:
        threadgroups (ceil_div(D, TILE_N), ceil_div(M, TILE_M), SPLIT)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
    launch attention_output_finalize when M > 64 and SPLIT > 1:
        threadgroups (ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

