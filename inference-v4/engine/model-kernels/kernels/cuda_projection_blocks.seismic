# CUDA implementations of the recurrent and attention projection entries
# (portable bodies in `recurrent_stages.seismic` and `attention_stages.seismic`)
# over the K1 library (`cuda/common/projection.cuh`); operand paths, launches
# and mapping as described in `cuda_dense.seismic`. Segmented projections
# enumerate each segment's tile groups (GEMV) or 128-row block columns (GEMM)
# in segment order.

native qwen_recurrent_project for cuda from "cuda/qwen_recurrent_project.cu":
    static (H, NK, NV, W)
    params (arithmetic KSPLIT in [4, 2, 8], BM in [64, 128], arithmetic INT8 in [0, 1])
    where H % 64 == 0
    scratch staged bytes (M * H * 2)
    scratch groups bytes (INT8 * M * H / 4)
    launch qwen_recurrent_project_stage:
        threadgroups (max(INT8, 1 - min(1, 16 / (M + 8))) * M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_recurrent_project_gemv:
        threadgroups (min(1, 16 / (M + 8)) * ceil_div(ceil_div((2 * NK + NV) * W, 16)
            + ceil_div(NV * W, 16) + 2 * ceil_div(NV, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - INT8) * min(M, 8) * H * 2)
    launch qwen_recurrent_project_gemm:
        threadgroups ((1 - min(1, 16 / (M + 8))) * (ceil_div(ceil_div((2 * NK + NV) * W, 16), 8)
            + ceil_div(ceil_div(NV * W, 16), 8) + 2 * ceil_div(ceil_div(NV, 16), 8)), ceil_div(M, BM), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((4 - BM / 64) * (BM * (144 - 48 * INT8) + 10240) + 4096)

native qwen_recurrent_output for cuda from "cuda/qwen_recurrent_output.cu":
    static (H, NK, NV, W)
    params (arithmetic KSPLIT in [4, 2, 8], BM in [64, 128], arithmetic INT8 in [0, 1],
            arithmetic SPLIT in [1, 2])
    where NV * W % 64 == 0
    scratch staged bytes (M * NV * W * 2)
    scratch groups bytes (INT8 * M * NV * W / 4)
    scratch partials bytes (min(SPLIT - 1, 1) * SPLIT * M * H * 4)
    launch qwen_recurrent_output_stage:
        threadgroups (max(INT8, 1 - min(1, 16 / (M + 8))) * M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_recurrent_output_gemv:
        threadgroups (min(1, 16 / (M + 8)) * ceil_div(ceil_div(H, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - INT8) * min(M, 8) * NV * W * 2)
    launch qwen_recurrent_output_gemm:
        threadgroups ((1 - min(1, 16 / (M + 8))) * ceil_div(ceil_div(H, 16), 8), ceil_div(M, BM), SPLIT)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((4 - BM / 64) * (BM * (144 - 48 * INT8) + 10240) + 4096)
    launch qwen_recurrent_output_finalize:
        threadgroups ((1 - min(1, 16 / (M + 8))) * min(SPLIT - 1, 1) * ceil_div(M * H, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)

native qwen_attention_project for cuda from "cuda/qwen_attention_project.cu":
    static (D, KV, G, W)
    params (arithmetic KSPLIT in [4, 2, 8], BM in [64, 128], arithmetic INT8 in [0, 1])
    where D % 64 == 0
    scratch staged bytes (M * D * 2)
    scratch groups bytes (INT8 * M * D / 4)
    launch qwen_attention_project_stage:
        threadgroups (max(INT8, 1 - min(1, 16 / (M + 8))) * M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_project_gemv:
        threadgroups (min(1, 16 / (M + 8)) * ceil_div(ceil_div(KV * G * 2 * W, 16)
            + 2 * ceil_div(KV * W, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((1 - INT8) * min(M, 8) * D * 2)
    launch qwen_attention_project_gemm:
        threadgroups ((1 - min(1, 16 / (M + 8))) * (ceil_div(ceil_div(KV * G * 2 * W, 16), 8)
            + 2 * ceil_div(ceil_div(KV * W, 16), 8)), ceil_div(M, BM), 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((4 - BM / 64) * (BM * (144 - 48 * INT8) + 10240) + 4096)

native qwen_attention_output for cuda from "cuda/qwen_attention_output.cu":
    static (D, Q, W)
    params (arithmetic KSPLIT in [4, 2, 8], BM in [64, 128], arithmetic INT8 in [0, 1],
            arithmetic SPLIT in [1, 2])
    where Q * W % 64 == 0
    scratch staged bytes (INT8 * M * Q * W)
    scratch groups bytes (INT8 * M * Q * W / 4)
    scratch partials bytes (min(SPLIT - 1, 1) * SPLIT * M * D * 4)
    launch qwen_attention_output_stage:
        threadgroups (INT8 * M, 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_output_gemv:
        threadgroups (min(1, 16 / (M + 8)) * ceil_div(ceil_div(D, 16), 8 / KSPLIT), 1, 1)
        threads_per_threadgroup (256, 1, 1)
    launch qwen_attention_output_gemm:
        threadgroups ((1 - min(1, 16 / (M + 8))) * ceil_div(ceil_div(D, 16), 8), ceil_div(M, BM), SPLIT)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes ((4 - BM / 64) * (BM * (144 - 48 * INT8) + 10240) + 4096)
    launch qwen_attention_output_finalize:
        threadgroups ((1 - min(1, 16 / (M + 8))) * min(SPLIT - 1, 1) * ceil_div(M * D, 256), 1, 1)
        threads_per_threadgroup (256, 1, 1)
