# Draft-head input publication. Attention, dense feed-forward, and final norm
# reuse the identical checked decoder entries; this entry owns the only
# head-specific equation: normalized successor embedding + normalized target
# feature followed by the 2D -> D combining projection.
fn qwen_draft_rows[M, V, D](tokens: &tensor[M] i32, table: &tensor[V, D] EW,
    conditioning: &tensor[M, D] A, embedding_norm: &tensor[D] EN,
    hidden_norm: &tensor[D] HN, combine: &tensor[D, 2 * D] CW,
    epsilon: f32) -> tensor[M, D] f32:
    let mut embedded = tensor[M, D] A
    let mut normalized_embedding = tensor[M, D] A
    let mut normalized_hidden = tensor[M, D] A
    let mut joined = tensor[M, 2 * D] A
    let mut result = tensor[M, D] f32
    for row in 0..M:
        for column in 0..2 * D:
            joined[row, column] = 0.0
        for column in 0..D:
            result[row, column] = 0.0
    parallel for row in 0..M:
        parallel for column in 0..D:
            embedded[row, column] = f32(table[tokens[row], column])
    rms_norm(embedded, embedding_norm, normalized_embedding, epsilon)
    rms_norm(conditioning, hidden_norm, normalized_hidden, epsilon)
    parallel for row in 0..M:
        parallel for column in 0..D:
            joined[row, column] = normalized_embedding[row, column]
            joined[row, D + column] = normalized_hidden[row, column]
    linear(joined, combine, result)
    return result

# Native Metal: one threadgroup per (32 outputs, row). The threadgroup forms
# the row's joined [2D] input in A in threadgroup memory (embedding rows and
# the combine weight decoded through the `rows16` packet library), then each
# simdgroup reduces four combine rows over it.
native qwen_draft_rows for metal from "metal/qwen_draft_rows.metal":
    launch qwen_draft_rows:
        threadgroups (ceil_div(D, 32), M, 1)
        threads_per_threadgroup (256, 1, 1)
        shared_bytes (4 * D + 64)


# The draft head's readout: the vocabulary projection of feature rows that
# are already normalized (K1 projection without a prologue).
fn head_logits_rows[O, V, D](features: &tensor[O, D] A,
    weight: &tensor[V, D] OW) -> tensor[O, V] f32:
    let mut logits = tensor[O, V] f32
    linear(features, weight, logits)
    return logits

native head_logits_rows for metal from "metal/head_logits_rows.metal":
    static (V, D)
    params (SIMDGROUPS in [16, 8, 4, 2, 32], ROWS in [1, 2, 4], arithmetic LANES in [16, 32],
            arithmetic BATCH_FROM in [5, 3, 9], BATCH_SIMDGROUPS in [8, 4, 16, 32], BATCH_ROWS in [2, 1, 4],
            TILE_M in [64, 128, 32], TILE_N in [64, 128])
    launch head_logits_rows_gemv:
        threadgroups ((1 - min(O / BATCH_FROM, 1)) * ceil_div(V, SIMDGROUPS * ROWS * 32 / LANES), 1, 1)
        threads_per_threadgroup (SIMDGROUPS * 32, 1, 1)
        shared_bytes (min(O, 8) * min(ceil_div(D, 32), 288 / max(O, 1)) * 72)
    launch head_logits_rows_batch:
        threadgroups (min(O / BATCH_FROM, 1) * (1 - min(O / 9, 1)) * ceil_div(V, BATCH_SIMDGROUPS * BATCH_ROWS * 8), 1, 1)
        threads_per_threadgroup (BATCH_SIMDGROUPS * 32, 1, 1)
        shared_bytes (16512)
    launch head_logits_rows_gemm:
        threadgroups (min(O / 9, 1) * ceil_div(V, TILE_N), ceil_div(O, TILE_M), 1)
        threads_per_threadgroup (max(TILE_M, 64) * TILE_N / 32, 1, 1)
