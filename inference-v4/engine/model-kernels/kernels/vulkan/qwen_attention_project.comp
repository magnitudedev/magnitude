// qwen_attention_project: RMS prologue over the F32 residual, then one
// segmented projection query+gate | key | value into three results. The
// Vulkan form of `metal/qwen_attention_project.metal` over
// `common/projection.glsl`.
#include "common/activation.glsl"
#include "common/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define PROJECT_ACT ELEMENT_ACT
#else
#error "qwen_attention_project requires a bf16 or f16 activation"
#endif
#if defined(SEISMIC_INPUT_NORM_REPRESENTATION_F32)
#define PROJECT_NORM ELEMENT_F32
#elif defined(SEISMIC_INPUT_NORM_REPRESENTATION_F16)
#define PROJECT_NORM ELEMENT_F16
#elif defined(SEISMIC_INPUT_NORM_REPRESENTATION_BF16)
#define PROJECT_NORM ELEMENT_BF16
#else
#error "qwen_attention_project requires a dense input_norm"
#endif

#if defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_Q4K)
#define QUERY_KIND PACKETS_Q4K
#define QUERY_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_QUERY_GATE_WEIGHT)
#elif defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_Q5K)
#define QUERY_KIND PACKETS_Q5K
#define QUERY_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_QUERY_GATE_WEIGHT)
#elif defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_Q6K)
#define QUERY_KIND PACKETS_Q6K
#define QUERY_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_QUERY_GATE_WEIGHT)
#elif defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_Q8G32S)
#define QUERY_KIND PACKETS_Q8
#define QUERY_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_QUERY_GATE_WEIGHT)
#elif defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_BF16)
#define QUERY_KIND PACKETS_BF16
#define QUERY_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_QUERY_GATE_WEIGHT, 2)
#elif defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_F16)
#define QUERY_KIND PACKETS_F16
#define QUERY_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_QUERY_GATE_WEIGHT, 2)
#elif defined(SEISMIC_QUERY_GATE_WEIGHT_REPRESENTATION_F32)
#define QUERY_KIND PACKETS_F32
#define QUERY_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_QUERY_GATE_WEIGHT, 4)
#else
#error "unsupported qwen_attention_project query_gate_weight representation"
#endif
#if defined(SEISMIC_QUERY_GATE_WEIGHT_KIND_PACKED) && !defined(SEISMIC_QUERY_GATE_WEIGHT_LAYOUT_ROWS16)
#error "qwen_attention_project requires the rows16 layout for query_gate_weight"
#endif

#if defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_Q4K)
#define KEY_KIND PACKETS_Q4K
#define KEY_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_KEY_WEIGHT)
#elif defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_Q5K)
#define KEY_KIND PACKETS_Q5K
#define KEY_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_KEY_WEIGHT)
#elif defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_Q6K)
#define KEY_KIND PACKETS_Q6K
#define KEY_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_KEY_WEIGHT)
#elif defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_Q8G32S)
#define KEY_KIND PACKETS_Q8
#define KEY_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_KEY_WEIGHT)
#elif defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_BF16)
#define KEY_KIND PACKETS_BF16
#define KEY_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_KEY_WEIGHT, 2)
#elif defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_F16)
#define KEY_KIND PACKETS_F16
#define KEY_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_KEY_WEIGHT, 2)
#elif defined(SEISMIC_KEY_WEIGHT_REPRESENTATION_F32)
#define KEY_KIND PACKETS_F32
#define KEY_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_KEY_WEIGHT, 4)
#else
#error "unsupported qwen_attention_project key_weight representation"
#endif
#if defined(SEISMIC_KEY_WEIGHT_KIND_PACKED) && !defined(SEISMIC_KEY_WEIGHT_LAYOUT_ROWS16)
#error "qwen_attention_project requires the rows16 layout for key_weight"
#endif

#if defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_Q4K)
#define VALUE_KIND PACKETS_Q4K
#define VALUE_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_VALUE_WEIGHT)
#elif defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_Q5K)
#define VALUE_KIND PACKETS_Q5K
#define VALUE_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_VALUE_WEIGHT)
#elif defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_Q6K)
#define VALUE_KIND PACKETS_Q6K
#define VALUE_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_VALUE_WEIGHT)
#elif defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_Q8G32S)
#define VALUE_KIND PACKETS_Q8
#define VALUE_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_VALUE_WEIGHT)
#elif defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_BF16)
#define VALUE_KIND PACKETS_BF16
#define VALUE_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_VALUE_WEIGHT, 2)
#elif defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_F16)
#define VALUE_KIND PACKETS_F16
#define VALUE_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_VALUE_WEIGHT, 2)
#elif defined(SEISMIC_VALUE_WEIGHT_REPRESENTATION_F32)
#define VALUE_KIND PACKETS_F32
#define VALUE_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_VALUE_WEIGHT, 4)
#else
#error "unsupported qwen_attention_project value_weight representation"
#endif
#if defined(SEISMIC_VALUE_WEIGHT_KIND_PACKED) && !defined(SEISMIC_VALUE_WEIGHT_LAYOUT_ROWS16)
#error "qwen_attention_project requires the rows16 layout for value_weight"
#endif

#define PROJECT_K uint(SEISMIC_DIM_D)
#define PROJECT_QUERY_ROWS uint(SEISMIC_DIM_KV * SEISMIC_DIM_G * 2ul * SEISMIC_DIM_W)
#define PROJECT_KV_ROWS uint(SEISMIC_DIM_KV * SEISMIC_DIM_W)

projection_prologue attention_project_input() {
    return projection_rms(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_HIDDEN), SEISMIC_HIDDEN_STRIDE_0,
        SEISMIC_HIDDEN_STRIDE_1, SEISMIC_PTR(SEISMIC_BUFFER_INPUT_NORM), SEISMIC_INPUT_NORM_STRIDE_0, PROJECT_NORM,
        element_word_f32(SEISMIC_PARAM_EPSILON), PROJECT_K, 0ul);
}

projection_weights attention_project_query() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_QUERY_GATE_WEIGHT), QUERY_GEOMETRY, PROJECT_K, 0ul);
}
projection_weights attention_project_key() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_KEY_WEIGHT), KEY_GEOMETRY, PROJECT_K, 0ul);
}
projection_weights attention_project_value() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_VALUE_WEIGHT), VALUE_GEOMETRY, PROJECT_K, 0ul);
}

projection_epilogue attention_project_query_out() {
    return projection_store(PROJECT_ACT, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, 0ul);
}
projection_epilogue attention_project_key_out() {
    return projection_store(PROJECT_ACT, SEISMIC_PTR(SEISMIC_RESULT_1_BUFFER), SEISMIC_RESULT_1_STRIDE_0,
        SEISMIC_RESULT_1_STRIDE_1, 0ul);
}
projection_epilogue attention_project_value_out() {
    return projection_store(PROJECT_ACT, SEISMIC_PTR(SEISMIC_RESULT_2_BUFFER), SEISMIC_RESULT_2_STRIDE_0,
        SEISMIC_RESULT_2_STRIDE_1, 0ul);
}

void qwen_attention_project_gemv() {
    const uint per = projection_gemv_rows(SEISMIC_TUNE_SIMDGROUPS, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES);
    const uint rows = uint(SEISMIC_DIM_M), tile = gl_WorkGroupID.x;
    const uint t0 = (PROJECT_QUERY_ROWS + per - 1u) / per, t1 = (PROJECT_KV_ROWS + per - 1u) / per;
    const projection_prologue x = attention_project_input();
    if (tile < t0) {
        const projection_weights w = attention_project_query();
        projection_gemv(QUERY_KIND, QUERY_KIND, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, PROJECTION_NORM_SHARED,
            x, attention_project_query_out(), w, w, rows, PROJECT_QUERY_ROWS, PROJECT_K, tile);
    } else if (tile < t0 + t1) {
        const projection_weights w = attention_project_key();
        projection_gemv(KEY_KIND, KEY_KIND, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, PROJECTION_NORM_SHARED,
            x, attention_project_key_out(), w, w, rows, PROJECT_KV_ROWS, PROJECT_K, tile - t0);
    } else {
        const projection_weights w = attention_project_value();
        projection_gemv(VALUE_KIND, VALUE_KIND, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, PROJECTION_NORM_SHARED,
            x, attention_project_value_out(), w, w, rows, PROJECT_KV_ROWS, PROJECT_K, tile - t0 - t1);
    }
}

void qwen_attention_project_stage() {
    projection_stage(attention_project_input(), gl_WorkGroupID.x,
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED), PROJECT_K);
}

void qwen_attention_project_gemm() {
    const uint tn = SEISMIC_TUNE_TILE_N;
    const projection_prologue x = projection_plain(PROJECT_ACT, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_NORMALIZED),
        uint64_t(PROJECT_K), 1ul, PROJECT_K, 0ul);
    const uint m = uint(SEISMIC_DIM_M), n = gl_WorkGroupID.x;
    const uint t0 = (PROJECT_QUERY_ROWS + tn - 1u) / tn, t1 = (PROJECT_KV_ROWS + tn - 1u) / tn;
    if (n < t0)
        projection_gemm(QUERY_KIND, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, x, attention_project_query_out(),
            attention_project_query(), m, PROJECT_QUERY_ROWS, PROJECT_K, gl_WorkGroupID.y, n, 0xffffffffu);
    else if (n < t0 + t1)
        projection_gemm(KEY_KIND, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, x, attention_project_key_out(),
            attention_project_key(), m, PROJECT_KV_ROWS, PROJECT_K, gl_WorkGroupID.y, n - t0, 0xffffffffu);
    else
        projection_gemm(VALUE_KIND, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, x, attention_project_value_out(),
            attention_project_value(), m, PROJECT_KV_ROWS, PROJECT_K, gl_WorkGroupID.y, n - t0 - t1, 0xffffffffu);
}
