// conditioning_overlay: out[row, column] = input[row, column] (F32); one
// invocation per element over a grid-stride loop (the grid is capped below
// the 65535-group floor).
#include "common/element.glsl"

void conditioning_overlay() {
    // `input` and `output` are reserved words in GLSL.
    const uint64_t source = SEISMIC_PTR(SEISMIC_BUFFER_INPUT);
    const uint64_t destination = SEISMIC_PTR(SEISMIC_BUFFER_OUT);
    const uint64_t count = SEISMIC_DIM_M * SEISMIC_DIM_D;
    const uint64_t step = uint64_t(gl_NumWorkGroups.x) * gl_WorkGroupSize.x;
    for (uint64_t index = gl_GlobalInvocationID.x; index < count; index += step) {
        const uint64_t row = index / SEISMIC_DIM_D;
        const uint64_t column = index % SEISMIC_DIM_D;
        element_f32_put(destination + (row * SEISMIC_OUT_STRIDE_0 + column * SEISMIC_OUT_STRIDE_1) * 4ul,
            element_f32_at(source + (row * SEISMIC_INPUT_STRIDE_0 + column * SEISMIC_INPUT_STRIDE_1) * 4ul));
    }
}
