// head_logits_rows: the draft head's readout, the vocabulary projection of
// feature rows that are already normalized (K1 projection without a
// prologue). The Vulkan form of `metal/head_logits_rows.metal`.
#include "lib/core/activation.glsl"
#include "lib/projection/projection.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define HEAD_ACT ELEMENT_ACT
#else
#error "head_logits_rows requires a bf16 or f16 activation"
#endif

#if defined(SEISMIC_WEIGHT_REPRESENTATION_Q4K)
#define HEAD_KIND PACKETS_Q4K
#define HEAD_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_WEIGHT)
#elif defined(SEISMIC_WEIGHT_REPRESENTATION_Q5K)
#define HEAD_KIND PACKETS_Q5K
#define HEAD_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_WEIGHT)
#elif defined(SEISMIC_WEIGHT_REPRESENTATION_Q6K)
#define HEAD_KIND PACKETS_Q6K
#define HEAD_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_WEIGHT)
#elif defined(SEISMIC_WEIGHT_REPRESENTATION_Q8G32S)
#define HEAD_KIND PACKETS_Q8
#define HEAD_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_WEIGHT)
#elif defined(SEISMIC_WEIGHT_REPRESENTATION_BF16)
#define HEAD_KIND PACKETS_BF16
#define HEAD_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_WEIGHT, 2)
#elif defined(SEISMIC_WEIGHT_REPRESENTATION_F16)
#define HEAD_KIND PACKETS_F16
#define HEAD_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_WEIGHT, 2)
#elif defined(SEISMIC_WEIGHT_REPRESENTATION_F32)
#define HEAD_KIND PACKETS_F32
#define HEAD_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_WEIGHT, 4)
#else
#error "unsupported head_logits_rows weight representation"
#endif
#if defined(SEISMIC_WEIGHT_KIND_PACKED) && !defined(SEISMIC_WEIGHT_LAYOUT_ROWS16)
#error "head_logits_rows requires the rows16 layout for weight"
#endif

#define HEAD_K uint(SEISMIC_DIM_D)

projection_prologue head_logits_input() {
    return projection_plain(HEAD_ACT, SEISMIC_PTR(SEISMIC_BUFFER_FEATURES), SEISMIC_FEATURES_STRIDE_0,
        SEISMIC_FEATURES_STRIDE_1, HEAD_K, 0ul);
}

projection_epilogue head_logits_output() {
    return projection_store(ELEMENT_F32, SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER), SEISMIC_RESULT_0_STRIDE_0,
        SEISMIC_RESULT_0_STRIDE_1, 0ul);
}

projection_weights head_logits_weight() {
    return projection_weights(SEISMIC_PTR(SEISMIC_BUFFER_WEIGHT), HEAD_GEOMETRY, HEAD_K, 0ul);
}

void head_logits_rows_gemv() {
    const projection_weights w = head_logits_weight();
    projection_gemv(HEAD_KIND, HEAD_KIND, false, SEISMIC_TUNE_ROWS, SEISMIC_TUNE_LANES, PROJECTION_NORM_NONE,
        head_logits_input(), head_logits_output(), w, w, uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_V), HEAD_K,
        gl_WorkGroupID.x);
}

void head_logits_rows_gemm() {
    projection_gemm(HEAD_KIND, SEISMIC_TUNE_TILE_M, SEISMIC_TUNE_TILE_N, SEISMIC_TUNE_SUB_M, SEISMIC_TUNE_SUB_N,
        head_logits_input(), head_logits_output(), head_logits_weight(), uint(SEISMIC_DIM_O), uint(SEISMIC_DIM_V), HEAD_K, gl_WorkGroupID.y, gl_WorkGroupID.x,
        0xffffffffu);
}
