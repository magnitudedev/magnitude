// gated_attention_decode_k8v4: split-KV decode attention over affine K8/V4
// history. The Vulkan form of `metal/gated_attention_decode_k8v4.metal`: the
// partitioning, subgroup walk and merge of `gated_attention_decode`.
//
// L1: workgroup (kv head, partition, row). History keys score as the sum over
// groups of scale * (q . code) + zero * sum(q) and values accumulate
// (p * scale) * code plus the carried bias sum(p * zero) of each lane's group
// (`history_absorb_affine`), so no history element is decoded. The fresh span stays dense; the bias is
// folded into the output before it. Partition 0 appends the row's key
// (prepared, rounded to A) and value encoded (`history_encode`).
//
// Shared floats: prepared queries [G][W], then the subgroup states
// [SIMDS][G][2] and merge columns [SIMDS][W].
#include "lib/attention/history.glsl"

void gated_attention_decode_k8v4_partial() {
    const uint64_t query_gate = SEISMIC_PTR(SEISMIC_BUFFER_QUERY_GATE);
    const uint64_t key = SEISMIC_PTR(SEISMIC_BUFFER_KEY);
    const uint64_t value = SEISMIC_PTR(SEISMIC_BUFFER_VALUE);
    const uint64_t query_norm = SEISMIC_PTR(SEISMIC_BUFFER_QUERY_NORM);
    const uint64_t key_norm = SEISMIC_PTR(SEISMIC_BUFFER_KEY_NORM);
    const uint64_t components = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_COMPONENTS);
    const uint64_t frequencies = SEISMIC_PTR(SEISMIC_BUFFER_ROTARY_FREQUENCIES);
    const uint64_t coordinates = SEISMIC_PTR(SEISMIC_BUFFER_COORDINATES);
    const uint64_t visible = SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE);
    const uint64_t fresh = SEISMIC_PTR(SEISMIC_BUFFER_FRESH);
    const uint64_t destinations = SEISMIC_PTR(SEISMIC_BUFFER_DESTINATIONS);
    const attention_history h = attention_affine_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY_CODES),
        SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY_COEFFICIENTS), SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE_CODES),
        SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE_COEFFICIENTS));
    const uint W = ATTENTION_W, E = ATTENTION_E, KV = ATTENTION_KV, G = ATTENTION_G;
    const uint simds = SEISMIC_SUBGROUPS, sg = SEISMIC_SUBGROUP, lane = SEISMIC_LANE;
    const uint64_t spans = SEISMIC_DIM_R;
    const uint kv_head = gl_WorkGroupID.x;
    const uint part = gl_WorkGroupID.y;
    const uint64_t row = gl_WorkGroupID.z;
    const float epsilon = element_word_f32(SEISMIC_PARAM_EPSILON);
    const float scale = element_word_f32(SEISMIC_PARAM_SCALE);
    const uint64_t row_coordinates = coordinates + row * 16ul;
    const uint key_words = history_row_words(HISTORY_KEY_BITS);
    const uint value_words = history_row_words(HISTORY_VALUE_BITS);

    if (part == 0u && sg < 2u) {
        const int destination = element_i32_at(destinations + row * 4ul);
        if (destination >= 0) {
            const uint64_t source = (row * KV + kv_head) * W;
            float x[ATTENTION_E];
            if (sg == 0u) {
                attention_prepare(key + source * uint64_t(ELEMENT_BYTES(ELEMENT_ACT)), key_norm, row_coordinates,
                    components, frequencies, epsilon, lane, x);
                [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
                    x[i] = element_round(ELEMENT_ACT, x[i]);
            } else {
                attention_load_row(value, source + uint64_t(lane) * E, x);
            }
            history_append(h, sg == 0u, destination, kv_head, lane, x);
        }
    }

    const uint total = attention_visible_total(visible, fresh, row, spans);
    const uint span_keys = attention_partition_span(total, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
    const uint partition_lo = part * span_keys;
    if (partition_lo >= total)
        return;
    const uint partition_hi = min(partition_lo + span_keys, total);

    const uint prepared = 0u;
    const uint states = G * W;
    const uint columns = states + simds * G * 2u;
    const float query_scale = scale * ATTENTION_LOG2E;
    for (uint g = sg; g < G; g += simds) {
        float x[ATTENTION_E];
        attention_prepare(query_gate + ((row * KV * G + kv_head * G + g) * 2ul * W) * uint64_t(ELEMENT_BYTES(ELEMENT_ACT)),
            query_norm, row_coordinates, components, frequencies, epsilon, lane, x);
        [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
            seismic_shared_f32[prepared + g * W + lane * E + i] = element_round(ELEMENT_ACT, x[i]) * query_scale;
    }
    barrier();
    float q[ATTENTION_G][ATTENTION_E];
    float qsum[ATTENTION_G];
    float maximum[ATTENTION_G];
    float denominator[ATTENTION_G];
    float result[ATTENTION_G][ATTENTION_E];
    float bias[ATTENTION_G];
    [[unroll]] for (uint g = 0u; g < ATTENTION_G; ++g) {
        float sum = 0.0;
        [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i) {
            q[g][i] = seismic_shared_f32[prepared + g * W + lane * E + i];
            sum += q[g][i];
            result[g][i] = 0.0;
        }
        qsum[g] = sum;
        maximum[g] = -ATTENTION_INF;
        denominator[g] = 0.0;
        bias[g] = 0.0;
    }

    const uint sub = (partition_hi - partition_lo + simds - 1u) / simds;
    const uint first = partition_lo + sg * sub;
    const uint last = min(first + sub, partition_hi);
    uint offset = 0u;
    for (uint64_t span = 0ul; span <= spans && offset < last; ++span) {
        const bool historical = span < spans;
        int lo, hi;
        attention_span(visible, fresh, row, spans, span, lo, hi);
        const uint length = uint(max(hi - lo, 0));
        const uint begin = max(first, offset);
        const uint end = min(last, offset + length);
        uint position = begin;
        if (historical) {
            while (position < end) {
                const uint n = min(HISTORY_BATCH, end - position);
                uint k[HISTORY_BATCH][2];
                uint v[HISTORY_BATCH][2];
                vec2 kc[HISTORY_BATCH];
                vec2 vc[HISTORY_BATCH];
                [[unroll]] for (uint j = 0u; j < HISTORY_BATCH; ++j) {
                    if (j < n) {
                        const uint64_t vector = (uint64_t(lo) + (position + j - offset)) * KV + kv_head;
                        history_lane_load(HISTORY_KEY_BITS, h.key + vector * key_words * 4ul, lane, k[j]);
                        history_lane_load(HISTORY_VALUE_BITS, h.value + vector * value_words * 4ul, lane, v[j]);
                        kc[j] = history_coefficients(h.key_coefficients, vector, lane / HISTORY_PAIR_LANES);
                        vc[j] = history_coefficients(h.value_coefficients, vector, lane / HISTORY_PAIR_LANES);
                    }
                }
                history_absorb_affine(n, q, qsum, k, kc, v, vc, maximum, denominator, result, bias);
                position += n;
            }
        } else {
            // The dense absorb carries only the output: fold the bias in first.
            [[unroll]] for (uint g = 0u; g < ATTENTION_G; ++g) {
                [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
                    result[g][i] += bias[g];
                bias[g] = 0.0;
            }
            for (; position < end; ++position) {
                const uint64_t token = uint64_t(lo) + (position - offset);
                const uint64_t at = (token * KV + kv_head) * W;
                float k[4][ATTENTION_E];
                float v[4][ATTENTION_E];
                attention_prepare(key + at * uint64_t(ELEMENT_BYTES(ELEMENT_ACT)), key_norm, coordinates + token * 16ul,
                    components, frequencies, epsilon, lane, k[0]);
                [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
                    k[0][i] = element_round(ELEMENT_ACT, k[0][i]);
                attention_load_row(value, at + lane * E, v[0]);
                attention_absorb(1u, q, k, v, maximum, denominator, result);
            }
        }
        offset += length;
    }
    [[unroll]] for (uint g = 0u; g < ATTENTION_G; ++g)
        [[unroll]] for (uint i = 0u; i < ATTENTION_E; ++i)
            result[g][i] += bias[g];

    attention_publish(maximum, denominator, result, states, columns, SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS), (row * KV + kv_head) * G * SEISMIC_TUNE_PARTS + part,
        SEISMIC_TUNE_PARTS);
}

// L2: workgroup (query head, row), one invocation per column: the
// fixed-order merge of the row's partitions and the sigmoid gate.
void gated_attention_decode_k8v4_merge() {
    attention_decode_gate(SEISMIC_PTR(SEISMIC_BUFFER_QUERY_GATE), SEISMIC_PTR(SEISMIC_BUFFER_VISIBLE),
        SEISMIC_PTR(SEISMIC_BUFFER_FRESH), SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER),
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PARTIALS), SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_STATISTICS), SEISMIC_DIM_R,
        gl_WorkGroupID.x, gl_WorkGroupID.y, gl_LocalInvocationIndex, SEISMIC_TUNE_SPAN, SEISMIC_TUNE_PARTS);
}
