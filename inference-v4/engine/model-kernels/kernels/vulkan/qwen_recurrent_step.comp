// qwen_recurrent_step (decode, MTP verify and small row classes): the
// row-sequential gated delta rule with its preparation fused. The Vulkan form
// of `cuda/qwen_recurrent_step.cu` over `common/recurrent.glsl`.
//
// One workgroup per (value head, state-row block, slot); slots are a grid
// axis. Each subgroup owns ROWS state rows (value coordinates), a lane W / 32
// columns (key coordinates) of each, held in registers for the whole slot.
// The state is read from bank previous_bank[slot] and published to
// following_bank[slot] after the slot's first stop[slot] rows; the window
// likewise. Grid z = B zeroes the mixed rows no slot covers. ROWS and WARPS
// never change result bits.
#include "common/recurrent.glsl"

#if SEISMIC_TUNE_ROWS > RECURRENT_MAX_ROWS
#error "qwen_recurrent_step holds at most RECURRENT_MAX_ROWS state rows per subgroup"
#endif

void qwen_recurrent_step() {
    recurrent_sequential(SEISMIC_TUNE_ROWS);
}
