// Prefill expert projections over the grouped tables of `qwen_routed_group`.
// The Vulkan form of `metal/qwen_routed_experts.metal`. Block b (T tile rows
// of expert blocks[b]) is covered by ceil(T / TM) GEMM row tiles; blocks of
// expert -1 exit.
//
// L1 (`qwen_routed_experts_expand`): K1 paired GEMM of the block's expert
// gate/up rows with the Grouped prologue (tile row t reads normalized row
// order[b, t]; padding rows read zeros) and the SiluMul epilogue into the
// `product` scratch [B * T, F].
// L2 (`qwen_routed_experts_down`): K1 GEMM of the block's products against
// the expert's down rows, published in A.
#include "common/activation.glsl"
#include "common/routed.glsl"

#if defined(SEISMIC_ELEMENT_A_REPRESENTATION_BF16) || defined(SEISMIC_ELEMENT_A_REPRESENTATION_F16)
#define ROUTED_ACT ELEMENT_ACT
#else
#error "qwen_routed_experts requires a bf16 or f16 activation"
#endif

#if defined(SEISMIC_EXPERT_GATE_REPRESENTATION_Q4K)
#define EG_KIND PACKETS_Q4K
#define EG_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_EXPERT_GATE)
#elif defined(SEISMIC_EXPERT_GATE_REPRESENTATION_Q5K)
#define EG_KIND PACKETS_Q5K
#define EG_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_EXPERT_GATE)
#elif defined(SEISMIC_EXPERT_GATE_REPRESENTATION_Q6K)
#define EG_KIND PACKETS_Q6K
#define EG_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_EXPERT_GATE)
#elif defined(SEISMIC_EXPERT_GATE_REPRESENTATION_Q8G32S)
#define EG_KIND PACKETS_Q8
#define EG_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_EXPERT_GATE)
#elif defined(SEISMIC_EXPERT_GATE_REPRESENTATION_BF16)
#define EG_KIND PACKETS_BF16
#define EG_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_GATE, 2)
#elif defined(SEISMIC_EXPERT_GATE_REPRESENTATION_F16)
#define EG_KIND PACKETS_F16
#define EG_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_GATE, 2)
#elif defined(SEISMIC_EXPERT_GATE_REPRESENTATION_F32)
#define EG_KIND PACKETS_F32
#define EG_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_GATE, 4)
#else
#error "unsupported qwen_routed_experts expert_gate representation"
#endif
#if defined(SEISMIC_EXPERT_GATE_KIND_PACKED) && !defined(SEISMIC_EXPERT_GATE_LAYOUT_ROWS16)
#error "qwen_routed_experts requires the rows16 layout for expert_gate"
#endif

#if defined(SEISMIC_EXPERT_UP_REPRESENTATION_Q4K)
#define EU_KIND PACKETS_Q4K
#define EU_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_EXPERT_UP)
#elif defined(SEISMIC_EXPERT_UP_REPRESENTATION_Q5K)
#define EU_KIND PACKETS_Q5K
#define EU_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_EXPERT_UP)
#elif defined(SEISMIC_EXPERT_UP_REPRESENTATION_Q6K)
#define EU_KIND PACKETS_Q6K
#define EU_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_EXPERT_UP)
#elif defined(SEISMIC_EXPERT_UP_REPRESENTATION_Q8G32S)
#define EU_KIND PACKETS_Q8
#define EU_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_EXPERT_UP)
#elif defined(SEISMIC_EXPERT_UP_REPRESENTATION_BF16)
#define EU_KIND PACKETS_BF16
#define EU_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_UP, 2)
#elif defined(SEISMIC_EXPERT_UP_REPRESENTATION_F16)
#define EU_KIND PACKETS_F16
#define EU_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_UP, 2)
#elif defined(SEISMIC_EXPERT_UP_REPRESENTATION_F32)
#define EU_KIND PACKETS_F32
#define EU_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_UP, 4)
#else
#error "unsupported qwen_routed_experts expert_up representation"
#endif
#if defined(SEISMIC_EXPERT_UP_KIND_PACKED) && !defined(SEISMIC_EXPERT_UP_LAYOUT_ROWS16)
#error "qwen_routed_experts requires the rows16 layout for expert_up"
#endif

#if defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_Q4K)
#define ED_KIND PACKETS_Q4K
#define ED_GEOMETRY PACKETS_ROWS16_Q4K(SEISMIC_EXPERT_DOWN)
#elif defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_Q5K)
#define ED_KIND PACKETS_Q5K
#define ED_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_EXPERT_DOWN)
#elif defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_Q6K)
#define ED_KIND PACKETS_Q6K
#define ED_GEOMETRY PACKETS_ROWS16_HIGH(SEISMIC_EXPERT_DOWN)
#elif defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_Q8G32S)
#define ED_KIND PACKETS_Q8
#define ED_GEOMETRY PACKETS_ROWS16_Q8(SEISMIC_EXPERT_DOWN)
#elif defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_BF16)
#define ED_KIND PACKETS_BF16
#define ED_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_DOWN, 2)
#elif defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_F16)
#define ED_KIND PACKETS_F16
#define ED_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_DOWN, 2)
#elif defined(SEISMIC_EXPERT_DOWN_REPRESENTATION_F32)
#define ED_KIND PACKETS_F32
#define ED_GEOMETRY PACKETS_ROWS16_DENSE(SEISMIC_EXPERT_DOWN, 4)
#else
#error "unsupported qwen_routed_experts expert_down representation"
#endif
#if defined(SEISMIC_EXPERT_DOWN_KIND_PACKED) && !defined(SEISMIC_EXPERT_DOWN_LAYOUT_ROWS16)
#error "qwen_routed_experts requires the rows16 layout for expert_down"
#endif

#define EXPERTS_TM SEISMIC_TUNE_TILE_M
#define EXPERTS_TN SEISMIC_TUNE_TILE_N

void qwen_routed_experts_expand() {
    const uint64_t tile_rows = SEISMIC_DIM_T;
    const uint64_t subtiles = (tile_rows + EXPERTS_TM - 1u) / EXPERTS_TM;
    const uint64_t block = gl_WorkGroupID.y / subtiles;
    const uint tm_index = uint(gl_WorkGroupID.y % subtiles);
    const int expert = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_BLOCKS) + block * SEISMIC_BLOCKS_STRIDE_0 * 4ul);
    if (expert < 0)
        return;
    const uint hidden = uint(SEISMIC_DIM_H);
    const uint64_t order = SEISMIC_PTR(SEISMIC_BUFFER_ORDER) + block * SEISMIC_ORDER_STRIDE_0 * 4ul;
    const projection_prologue x = projection_grouped(ROUTED_ACT, SEISMIC_PTR(SEISMIC_BUFFER_NORMALIZED),
        SEISMIC_NORMALIZED_STRIDE_0, SEISMIC_NORMALIZED_STRIDE_1, hidden, order, SEISMIC_ORDER_STRIDE_1);
    const projection_weights gate = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_GATE), EG_GEOMETRY,
        routed_expert_row(uint64_t(expert), SEISMIC_DIM_F), hidden);
    const projection_weights up = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_UP), EU_GEOMETRY,
        routed_expert_row(uint64_t(expert), SEISMIC_DIM_F), hidden);
    const projection_epilogue out_ = projection_silu_mul(ROUTED_ACT,
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PRODUCT) + block * tile_rows * SEISMIC_DIM_F * uint64_t(ELEMENT_BYTES(ROUTED_ACT)),
        SEISMIC_DIM_F, 1ul);
    const uint live = routed_block_rows(order, SEISMIC_ORDER_STRIDE_1, uint(tile_rows));
    projection_gemm_paired(EG_KIND, EU_KIND, EXPERTS_TM, EXPERTS_TN, x, out_, gate, up, uint(tile_rows),
        uint(SEISMIC_DIM_F), hidden, tm_index, gl_WorkGroupID.x, live);
}

void qwen_routed_experts_down() {
    const uint64_t tile_rows = SEISMIC_DIM_T;
    const uint64_t subtiles = (tile_rows + EXPERTS_TM - 1u) / EXPERTS_TM;
    const uint64_t block = gl_WorkGroupID.y / subtiles;
    const uint tm_index = uint(gl_WorkGroupID.y % subtiles);
    const int expert = element_i32_at(SEISMIC_PTR(SEISMIC_BUFFER_BLOCKS) + block * SEISMIC_BLOCKS_STRIDE_0 * 4ul);
    if (expert < 0)
        return;
    const uint features = uint(SEISMIC_DIM_F);
    const uint64_t bytes = uint64_t(ELEMENT_BYTES(ROUTED_ACT));
    const projection_prologue x = projection_plain(ROUTED_ACT,
        SEISMIC_PTR(SEISMIC_BUFFER_SCRATCH_PRODUCT) + block * tile_rows * SEISMIC_DIM_F * bytes, SEISMIC_DIM_F, 1ul,
        features, 0ul);
    const projection_weights down = routed_weights(SEISMIC_PTR(SEISMIC_BUFFER_EXPERT_DOWN), ED_GEOMETRY,
        routed_expert_row(uint64_t(expert), SEISMIC_DIM_H), features);
    const projection_epilogue out_ = projection_store(ROUTED_ACT,
        SEISMIC_PTR(SEISMIC_RESULT_0_BUFFER) + block * SEISMIC_RESULT_0_STRIDE_0 * bytes, SEISMIC_RESULT_0_STRIDE_1,
        SEISMIC_RESULT_0_STRIDE_2, 0ul);
    const uint live = routed_block_rows(SEISMIC_PTR(SEISMIC_BUFFER_ORDER) + block * SEISMIC_ORDER_STRIDE_0 * 4ul,
        SEISMIC_ORDER_STRIDE_1, uint(tile_rows));
    projection_gemm(ED_KIND, EXPERTS_TM, EXPERTS_TN, x, out_, down, uint(tile_rows), uint(SEISMIC_DIM_H), features,
        tm_index, gl_WorkGroupID.x, live);
}
