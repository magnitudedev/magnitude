// qwen_attention_prefill_k8v4: streaming attention for prefill rows over
// affine K8/V4 history. The body (three launches) is `common/prefill.glsl`:
// the prepare launch appends encoded rows and every history K/V tile decodes
// (code * scale + zero, rounded to A) as it is staged, so the products are
// those of the dense form over the decoded history.
#include "common/prefill.glsl"

attention_history prefill_history() {
    return attention_affine_history(SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY_CODES),
        SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_KEY_COEFFICIENTS), SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE_CODES),
        SEISMIC_PTR(SEISMIC_BUFFER_HISTORY_VALUE_COEFFICIENTS));
}

void qwen_attention_prefill_k8v4_prepare() { prefill_prepare(prefill_history()); }
void qwen_attention_prefill_k8v4_attend() { prefill_attend(prefill_history()); }
void qwen_attention_prefill_k8v4_merge() { prefill_merge(); }
