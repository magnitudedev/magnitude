# §20.2 Shape and layout.
#
# Entries here fix the symbolic-dimension, view and layout structures the compiler claims to
# support. The harness invokes every entry at boundary, non-power-of-two and (where the
# predicates admit it) zero extents.

# Symbolic dimensions with equality relationships: one symbol on several parameters binds
# once at invocation; the same two symbols in exchanged positions are a second relationship.
fn shared_dimensions[M, N](x: &tensor[M, N] f32, y: &tensor[N, M] f32, z: &mut tensor[M, N] f32):
    parallel for i in 0..M:
        parallel for j in 0..N:
            z[i, j] = x[i, j] + y[j, i]

# Derived extents: parameter axes are affine expressions of the shape symbols.
fn derived_extents[P, S](x: &tensor[2 * P + S] f32, pairs: &mut tensor[P] f32, tail: &mut tensor[S] f32):
    parallel for i in 0..P:
        pairs[i] = x[i] + x[i + P]
    parallel for i in 0..S:
        tail[i] = x[2 * P + i]

# Scalar broadcasting: a scalar combines with every element of a tile.
fn scalar_broadcast[M, N](x: &tensor[M, N] f32, y: &mut tensor[M, N] f32, scale: f32, bias: f32) where M >= 0 and N >= 0:
    parallel for r in 0..M:
        y[r] = x[r] * scale + bias

# Row broadcasting: a vector combines with every row of a matrix through the row loop.
fn row_broadcast[M, N](x: &tensor[M, N] f32, w: &tensor[N] f32, y: &mut tensor[M, N] f32):
    parallel for r in 0..M:
        y[r] = x[r] * w

# Reshape: a flat borrow is viewed as a matrix; element correspondence is proved from the
# symbolic product.
fn reshape_rows[M, N](x: &tensor[M * N] f32, y: &mut tensor[M, N] f32):
    let grid = reshape(x, (M, N))
    parallel for i in 0..M:
        y[i] = grid[i] * 2.0

# Transpose: `.T` exchanges the axes of a rank-two borrow; the rows of the transposed view
# are strided columns of the source.
fn transpose_rows[M, N](x: &tensor[M, N] f32, y: &mut tensor[N, M] f32):
    let xt = x.T
    parallel for i in 0..N:
        y[i] = xt[i]

# Non-contiguous strides: a column of a row-major matrix is a strided view.
fn column_view[M, N](x: &tensor[M, N] f32, y: &mut tensor[N] f32) where M >= 0:
    parallel for j in 0..N:
        y[j] = reduce(x[:, j], 0, sum)

# Static slices: constant bounds select a fixed window at a fixed offset.
fn static_slice[N](x: &tensor[N] f32, y: &mut tensor[3] f32) where N >= 5:
    y[:] = x[2:5]

# Dynamic slices from invocation scalars: `lo` and `hi` are call scalars whose ordering and
# bounds are invocation-known; the window extent is a runtime value that is never clamped.
fn dynamic_slice_sum[N](x: &tensor[N] f32, lo: i32, hi: i32) -> f32:
    let window = x[lo:hi]
    return reduce(window, 0, sum)

# Runtime-extent loop: bounds read from a tensor select a window whose extent is only known
# at execution; `extent` of that window drives an ordered loop.
fn runtime_extent_loop[N](x: &tensor[N] f32, bounds: &tensor[2] i32) -> f32:
    let lo = bounds[0]
    let hi = bounds[1]
    let window = x[lo:hi]
    let mut total = f32(0.0)
    for i in 0..extent(window, 0):
        total = total + window[i] * f32(i)
    return total

# Singleton axes: an axis of extent one is an ordinary axis.
fn singleton_axes[N](x: &tensor[1, N] f32, y: &mut tensor[N, 1] f32) where N >= 0:
    parallel for i in 0..N:
        y[i, 0] = x[0, i]

# Checked products: a flattened axis is the product of two symbols. The invocation check
# rejects products the target cannot address; the harness probes that boundary.
fn flat_product[M, N](x: &tensor[M, N] f32, y: &mut tensor[M * N] f32):
    parallel for i in 0..M:
        y[i * N : (i + 1) * N] = x[i]

# Aligned and unaligned windows: the same copy from offsets that are and are not multiples
# of a target's vector width.
fn aligned_window[W](x: &tensor[W + 4] f32, y: &mut tensor[W] f32):
    y[:] = x[4:W + 4]

fn unaligned_window[W](x: &tensor[W + 3] f32, y: &mut tensor[W] f32):
    y[:] = x[3:W + 3]
