# §20.4 Composition.
#
# Portable calls, backend helpers, nested standard-library calls, several portable bodies of
# one family, and lowering alternatives for Metal and CUDA.

# Portable calls: an entry composes a portable helper; shape symbols bind structurally from
# the arguments. `scaled_square` is itself an entry.
fn scaled_square[N](x: &tensor[N] f32, scale: f32) -> tensor[N] f32:
    let mut out = zeros_like(x)
    for i in 0..N:
        out[i] = x[i] * x[i] * scale
    return out

fn portable_call[N](x: &tensor[N] f32, scale: f32) -> f32:
    let squared = scaled_square(x, scale)
    return reduce(squared, 0, sum)

# A function family with two portable bodies: the reference ascending sum and a
# reassociating alternative that is selectable only under a policy accepting its evidence.
fn row_total[N](x: &tensor[N] f32) -> f32:
    return reduce(x, 0, sum)

fn row_total[N](x: &tensor[N] f32) -> f32:
    return reduce(x, 0, sum, unordered=true)

# Nested standard-library calls: the corpus entry is a thin caller, so the standard library's
# own bodies and lowerings are what the compiler plans.
fn std_rms_norm[R, W](x: &tensor[R, W] f32, weight: &tensor[W] f32, y: &mut tensor[R, W] f32, eps: f32):
    rms_norm(x, weight, y, eps)

fn std_rms_norm_bf16[R, W](x: &tensor[R, W] bf16, weight: &tensor[W] bf16, y: &mut tensor[R, W] bf16, eps: f32):
    rms_norm(x, weight, y, eps)

fn std_linear[M, N, K](x: &tensor[M, K] f32, weight: &tensor[N, K] f32, y: &mut tensor[M, N] f32):
    linear(x, weight, y)

fn std_linear_packed[M, N, K](x: &tensor[M, K] bf16, weight: &tensor[N, K] q4g64, y: &mut tensor[M, N] bf16) where K % 64 == 0:
    linear(x, weight, y)

fn std_matmul[M, N, K](a: &tensor[M, K] f32, b: &tensor[N, K] f32) -> tensor[M, N] f32:
    let mut seed = tensor[M, N] f32
    for i in 0..M:
        for j in 0..N:
            seed[i, j] = 0.0
    return matmul(a, b, seed)

fn std_attention[Q, T, H, KV, W](q: &tensor[Q, H, W] f32, k: &tensor[T, KV, W] f32, v: &tensor[T, KV, W] f32,
                                 visible: &tensor[Q, 2] i32, result: &mut tensor[Q, H, W] f32, scale: f32)
    where H % KV == 0:
    attention(q, k, v, visible, result, scale)

# Explicit backend intrinsic results, a backend helper, and lowering alternatives: the
# portable body is the reference; the Metal lowering calls a Metal helper that requires
# `metal.matrix`, and the CUDA lowering uses `cuda.matrix` directly. On each backend the
# portable body and that backend's lowering are the two applicable alternatives.
fn small_product[M, N, K](a: &tensor[M, K] f32, b: &tensor[K, N] f32) -> tensor[M, N] f32:
    let mut out = tensor[M, N] f32
    for i in 0..M:
        for j in 0..N:
            let mut s = f32(0.0)
            for k in 0..K:
                s = fma(a[i, k], b[k, j], s)
            out[i, j] = s
    return out

fn metal_product_helper[M, N, K](a: &tensor[M, K] f32, b: &tensor[K, N] f32) -> tensor[M, N] f32
    for metal requires metal.matrix:
    return metal.matrix.matmul(a, b, accumulation=f32)

lower small_product[M, N, K](a: &tensor[M, K] f32, b: &tensor[K, N] f32) -> tensor[M, N] f32
    for metal requires metal.matrix:
    return metal_product_helper(a, b)

lower small_product[M, N, K](a: &tensor[M, K] f32, b: &tensor[K, N] f32) -> tensor[M, N] f32
    for cuda requires cuda.matrix:
    return cuda.matrix.matmul(a, b, accumulation=f32)

# Portable-only implementation: no lowering exists, so every target plans the portable body.
fn portable_only[N](x: &tensor[N] f32, y: &mut tensor[N] f32):
    parallel for i in 0..N:
        y[i] = sqrt(abs(x[i]))
