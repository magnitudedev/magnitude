# §20.1 Values and representations.
#
# Every entry is a portable function family that exercises one independent structure of the
# language. Entry names are the coverage keys of README.md. Shape parameters are at least one
# unless a predicate states `>= 0`; entries that are meaningful at a zero extent say so.

# Scalar literals and scalar parameters: every scalar kind crosses the call boundary, and a
# literal adopts the dtype of the operand it combines with.
fn scalar_parameters(a: f32, b: i32, c: u32, flag: bool) -> (f32, i32, u32, bool):
    let x = a * 2.0 + 0.5
    let y = b * 3 - 1
    let z = c + 7
    let w = flag and x > 0.0
    return x, y, z, w

# Signed integer arithmetic: multiplication, truncating division and remainder by constants,
# shifts, and bitwise operations on the 32-bit pattern.
fn signed_arithmetic[N](x: &tensor[N] i32, y: &mut tensor[N] i32, k: i32) where N >= 0:
    parallel for i in 0..N:
        let v = x[i]
        let scaled = (v * 3 + k) / 2 - v % 4
        let bits = ((v & 15) | 1) ^ (v << 2)
        y[i] = scaled + bits + (v >> 1)

# Unsigned integer arithmetic: wrapping multiply-add and logical shifts.
fn unsigned_arithmetic[N](x: &tensor[N] u32, y: &mut tensor[N] u32, k: u32) where N >= 0:
    parallel for i in 0..N:
        let v = x[i]
        y[i] = (v * u32(2654435761) + k) ^ (v >> 3) ^ (v << 5)

# Index arithmetic: an `index[N]` parameter is a proven position; arithmetic on it is an
# ordinary integer that the checker proves back into bounds from `0 <= at < N`.
fn index_arithmetic[N](x: &tensor[N] f32, at: index[N]) -> (f32, f32, i32):
    let here = x[at]
    let mirrored = x[N - 1 - at]
    let doubled = at * 2 + 1
    return here, mirrored, doubled

# Floating conversions: f16 and bf16 elements widen exactly to f32 in arithmetic and round
# once when published; integers and floats convert explicitly in both directions.
fn float_conversions[N](h: &tensor[N] f16, b: &tensor[N] bf16, n: &tensor[N] i32,
                        wide: &mut tensor[N] f32, narrow: &mut tensor[N] bf16,
                        half: &mut tensor[N] f16, whole: &mut tensor[N] i32) where N >= 0:
    parallel for i in 0..N:
        let total = f32(h[i]) + f32(b[i]) + f32(n[i])
        wide[i] = total
        narrow[i] = bf16(total)
        half[i] = f16(total)
        whole[i] = i32(total * 4.0)

# Fixed-rank tensors: ranks one to four addressed by complete point indices.
fn rank_one[A](x: &tensor[A] f32, y: &mut tensor[A] f32) where A >= 0:
    parallel for a in 0..A:
        y[a] = x[a] + 1.0

fn rank_two[A, B](x: &tensor[A, B] f32, y: &mut tensor[A, B] f32) where A >= 0 and B >= 0:
    parallel for a in 0..A:
        parallel for b in 0..B:
            y[a, b] = x[a, b] + 1.0

fn rank_three[A, B, C](x: &tensor[A, B, C] f32, y: &mut tensor[A, B, C] f32):
    parallel for a in 0..A:
        parallel for b in 0..B:
            parallel for c in 0..C:
                y[a, b, c] = x[a, b, c] + 1.0

fn rank_four[A, B, C, D](x: &tensor[A, B, C, D] f32, y: &mut tensor[A, B, C, D] f32):
    parallel for a in 0..A:
        parallel for b in 0..B:
            parallel for c in 0..C:
                parallel for d in 0..D:
                    y[a, b, c, d] = x[a, b, c, d] + 1.0

# Packed representations as inputs: a packed row decodes as a whole into an f32 tile, and a
# packed element reads as its decoded f32 value. Packed rows are complete packet groups.
fn packed_q4_decode[R, K](w: &tensor[R, K] q4g64, y: &mut tensor[R, K] f32) where K % 64 == 0:
    parallel for r in 0..R:
        y[r] = f32(w[r])

fn packed_q8_dot[R, K](w: &tensor[R, K] q8g32, x: &tensor[K] f32, y: &mut tensor[R] f32) where K % 32 == 0:
    parallel for r in 0..R:
        let mut acc = f32(0.0)
        for k in 0..K:
            acc = fma(w[r, k], x[k], acc)
        y[r] = acc

# Computed tensor expressions: arithmetic, math and `select` over whole values form one
# computed tile that a single assignment publishes.
fn computed_expression[M, N](x: &tensor[M, N] f32, y: &tensor[M, N] f32, z: &mut tensor[M, N] f32, scale: f32):
    parallel for r in 0..M:
        let a = x[r]
        let b = y[r]
        z[r] = select(a > b, a * scale, exp(b) - 1.0)

# Immutable views: a shared slice of a shared borrow is read through its own binding, and a
# sub-view of a view narrows it further.
fn immutable_view[M, N](x: &tensor[M, N] f32, y: &mut tensor[M] f32):
    parallel for r in 0..M:
        let row = x[r]
        let tail = row[1:N]
        y[r] = reduce(tail, 0, sum) + row[0]

# Mutable views: an exclusive slice of an exclusive borrow is written through its binding;
# the borrow lives for one iteration and the next iteration borrows the next row.
fn mutable_view[N](x: &tensor[N] f32, y: &mut tensor[2, N] f32):
    for half in 0..2:
        let mut row = y[half]
        for i in 0..N:
            row[i] = x[i] + f32(half)

# Owned allocations: zero and one initialization from a shape source, and uninitialized
# storage completed by a full traversal before it is read.
fn owned_zero_init[N](x: &tensor[N] f32) -> tensor[N] f32:
    let mut acc = zeros_like(x)
    for i in 0..N:
        acc[i] = acc[i] + x[i]
    return acc

fn owned_one_init[M, N](x: &tensor[M, N] f32) -> tensor[M, N] f32:
    let mut scaled = ones_like(x)
    for i in 0..M:
        for j in 0..N:
            scaled[i, j] = scaled[i, j] * x[i, j]
    return scaled

fn owned_fill_init[N](x: &tensor[N] f32, value: f32) -> tensor[N] f32:
    let mut filled = tensor[N] f32
    for i in 0..N:
        filled[i] = value
    for i in 0..N:
        filled[i] = filled[i] * x[i]
    return filled

# Element parameters: one source body, bound to a concrete element representation when the
# kernel is prepared; arithmetic happens in f32 and publication rounds to the bound element.
fn element_parameter[N](x: &tensor[N] T, y: &mut tensor[N] T, scale: f32):
    parallel for i in 0..N:
        y[i] = f32(x[i]) * scale
