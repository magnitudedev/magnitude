# §20.3 Effects and ownership.
#
# Entries here fix the ownership, mutation, aliasing and control-flow structures. The
# rejected counterparts of the aliasing and ownership rules live in `invalid/`.

# Immutable inputs: shared borrows are read only.
fn immutable_inputs[N](x: &tensor[N] f32, y: &tensor[N] f32) -> f32 where N >= 0:
    let mut total = f32(0.0)
    for i in 0..N:
        total = fma(x[i], y[i], total)
    return total

# `let mut` scalar state carried across an ordered loop: an inclusive prefix sum, and a
# running maximum with its position.
fn carried_scalar[N](x: &tensor[N] f32, prefix: &mut tensor[N] f32) -> (f32, i32):
    let mut running = f32(0.0)
    let mut best = f32(-inf)
    let mut at = i32(0)
    for i in 0..N:
        running = running + x[i]
        prefix[i] = running
        if x[i] > best:
            best = x[i]
            at = i
    return best, at

# Mutable tensor outputs: an exclusive borrow is the only way a call mutates caller storage.
fn mutable_output[N](x: &tensor[N] f32, y: &mut tensor[N] f32) where N >= 0:
    parallel for i in 0..N:
        y[i] = x[i] * x[i]

# Owned parameters move: the caller's tensor is consumed, mutated in place, and returned.
fn owned_roundtrip[N](x: tensor[N] f32) -> tensor[N] f32:
    let mut y = x
    for i in 0..N:
        y[i] = y[i] + 1.0
    return y

# Explicit duplication: `clone` copies an owned tensor before the original is mutated.
fn clone_then_mutate[N](x: tensor[N] f32) -> (tensor[N] f32, tensor[N] f32):
    let snapshot = clone(x)
    let mut negated = x
    for i in 0..N:
        negated[i] = 0.0 - negated[i]
    return snapshot, negated

# Slice assignment with complete coverage: the whole output is one assignment.
fn slice_assign_complete[M, N](x: &tensor[M, N] f32, y: &mut tensor[M, N] f32):
    y[:] = x * 2.0

# Slice assignment with partial coverage: only the leading window changes; the rest of the
# output keeps the caller's contents.
fn slice_assign_prefix[N, W](x: &tensor[W] f32, y: &mut tensor[N] f32) where N - W >= 0:
    y[0:W] = x

fn slice_assign_middle[N](x: &tensor[2] f32, y: &mut tensor[N] f32) where N >= 4:
    y[1:3] = x

# Legal aliasing: two shared borrows of one tensor may coexist, lexically and across a call.
# The harness also passes one device tensor for both `a` and `b`.
fn shared_pair[N](a: &tensor[N] f32, b: &tensor[N] f32) -> f32:
    let mut total = f32(0.0)
    for i in 0..N:
        total = total + a[i] * b[i]
    return total

fn aliased_reads[N](x: &tensor[N] f32) -> f32:
    let front = x[:]
    let back = x[:]
    return shared_pair(front, back) + shared_pair(x, x)

# Branch results: a scalar and an owned tensor are produced on both arms and joined.
fn branch_result[N](x: &tensor[N] f32, choose: bool) -> (tensor[N] f32, f32):
    let mut out = zeros_like(x)
    let mut tag = f32(0.0)
    if choose:
        for i in 0..N:
            out[i] = x[i] + 1.0
        tag = 1.0
    else:
        for i in 0..N:
            out[i] = x[i] - 1.0
        tag = -1.0
    return out, tag

# Loop carries: an owned tensor is carried through a repeated loop and every iteration reads
# the previous iteration's values.
fn loop_carry[N](seed: &tensor[N] f32) -> tensor[N] f32:
    let mut state = to_owned(seed)
    for step in 0..4:
        for i in 0..N:
            state[i] = state[i] * 0.5 + seed[i]
    return state

# Nested branch/repeat composition: a branch inside a repeat inside a branch, with carried
# scalar state updated on some paths only.
fn nested_control[N](x: &tensor[N] f32, y: &mut tensor[N] f32, enabled: bool, limit: f32):
    let mut carried = f32(0.0)
    if enabled:
        for i in 0..N:
            if x[i] > limit:
                carried = carried + x[i]
                y[i] = carried
            else:
                y[i] = x[i]
    else:
        for i in 0..N:
            y[i] = limit

# Atomics: colliding visits of a `parallel for` update one place through `atomic`. Integer
# `add` and floating `max`/`min` are exact and order-independent.
fn atomic_histogram[N, E](routes: &tensor[N] i32, counts: &mut tensor[E] i32):
    parallel for i in 0..N:
        atomic(add, counts[routes[i]], 1)

fn atomic_unsigned_total[N, E](weights: &tensor[N] u32, routes: &tensor[N] i32, totals: &mut tensor[E] u32):
    parallel for i in 0..N:
        atomic(add, totals[routes[i]], weights[i])

fn atomic_extrema[N, E](values: &tensor[N] f32, routes: &tensor[N] i32, top: &mut tensor[E] f32, low: &mut tensor[E] f32):
    parallel for i in 0..N:
        atomic(max, top[routes[i]], values[i])
        atomic(min, low[routes[i]], values[i])

# Floating atomic add: the reference applies the rounded updates in visit order; a target
# that cannot reproduce that order bit-exactly may only satisfy a bounded policy.
fn atomic_float_sum[N, E](values: &tensor[N] f32, routes: &tensor[N] i32, sums: &mut tensor[E] f32):
    parallel for i in 0..N:
        atomic(add, sums[routes[i]], values[i])
