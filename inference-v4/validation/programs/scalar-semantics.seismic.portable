# Tile assignment copies values; later mutation cannot alter the source tile.
export fn tile_copy(x: tensor[4] f32, out out: tensor[4] f32):
    let t = load(x)
    var u = t
    for i in owned(u):
        u[i] = 0.0
    publish t to out

lower tile_copy for metal = portable
lower tile_copy for cpu = portable
lower tile_copy for cuda = portable

# A loop-carried tile retains its value while the next iteration allocates locals.
export fn loop_carried(out out: tensor[1] f32):
    var m = tile[1] f32
    var a = tile[1] f32
    for i in owned(m):
        m[i] = 1.0
        a[i] = 0.0
    for step in 0..3:
        var n = tile[1] f32
        for i in owned(n):
            n[i] = m[i] + 1.0
        for i in owned(a):
            a[i] = m[i] + n[i]
        m = n
    publish a to out

lower loop_carried for metal = portable
lower loop_carried for cpu = portable
lower loop_carried for cuda = portable

# Existing scalar bindings merge through control flow; branch locals do not escape.
export fn branch_merge(out out: tensor[1] f32, choose: bool):
    var value = f32(3.0)
    if choose:
        value = 7.0
    else:
        value = 11.0
    var y = tile[1] f32
    for i in owned(y):
        y[i] = value
    publish y to out

lower branch_merge for metal = portable
lower branch_merge for cpu = portable
lower branch_merge for cuda = portable

# BF16 arithmetic publishes a BF16 value even when the next expression widens it.
export fn bf16_rounding(x: tensor[1] bf16, out out: tensor[1] f32):
    let t = load(x)
    var y = tile[1] f32
    for i in owned(y):
        y[i] = f32(t[i] * t[i])
    publish y to out

lower bf16_rounding for metal = portable
lower bf16_rounding for cpu = portable
lower bf16_rounding for cuda = portable

# Producer substitution cannot move a read past mutation of its source tile.
export fn changed_source(x: tensor[4] f32, out out: tensor[4] f32):
    var t = load(x)
    var y = tile[4] f32
    for i in owned(y):
        y[i] = t[i] * 2.0
    for i in owned(t):
        t[i] = 0.0
    var z = tile[4] f32
    for i in owned(z):
        z[i] = y[i] + 1.0
    publish z to out

lower changed_source for metal = portable
lower changed_source for cpu = portable
lower changed_source for cuda = portable

export fn mixed_scalars(out out: tensor[1] f32, first: bool, a: f32, b: bf16, last: bool):
    var value = a + f32(b)
    if first:
        value = value + 10.0
    if last:
        value = value * 10.0
    var y = tile[1] f32
    for i in owned(y):
        y[i] = value
    publish y to out

lower mixed_scalars for metal = portable
lower mixed_scalars for cpu = portable
lower mixed_scalars for cuda = portable

# A loaded value remains a snapshot even when its tensor backing is overwritten.
export fn large_snapshot(inout x: tensor[65] f32, out out: tensor[65] f32):
    let t = load(x)
    var zero = tile[65] f32
    for i in owned(zero):
        zero[i] = 0.0
    publish zero to x
    var y = tile[65] f32
    for i in owned(y):
        y[i] = t[64 - coord(i)]
    publish y to out

lower large_snapshot for metal = portable
lower large_snapshot for cpu = portable
lower large_snapshot for cuda = portable

export fn snapshot_reduction(inout x: tensor[65] f32, out out: tensor[1] f32):
    let t = load(x)
    var zero = tile[65] f32
    for i in owned(zero):
        zero[i] = 0.0
    publish zero to x
    var acc = tile[1] f32
    for i in owned(acc):
        acc[i] = reduce(t, 0, sum)
    publish acc to out

lower snapshot_reduction for metal = portable
lower snapshot_reduction for cpu = portable
lower snapshot_reduction for cuda = portable

# Mutating a logical loaded tile does not mutate its source tensor.
export fn loaded_mutation(x: tensor[65] f32, out out: tensor[1] f32):
    var t = load(x)
    for i in owned(t):
        t[i] = 0.0
    var acc = tile[1] f32
    for i in owned(acc):
        acc[i] = reduce(t, 0, sum)
    publish acc to out

lower loaded_mutation for metal = portable
lower loaded_mutation for cpu = portable
lower loaded_mutation for cuda = portable

export fn half_rounding(x: tensor[1] f16, out out: tensor[1] f32, value: f16):
    let t = load(x)
    var y = tile[1] f32
    for i in owned(y):
        y[i] = f32(t[i] * value)
    publish y to out

lower half_rounding for metal = portable
lower half_rounding for cpu = portable
lower half_rounding for cuda = portable

export fn bounded_index(x: tensor[4] f32, pos: index[4], out out: tensor[1] f32):
    let t = load(x[pos:pos + 1])
    publish t to out

lower bounded_index for metal = portable
lower bounded_index for cpu = portable
lower bounded_index for cuda = portable

export fn reduction_extrema(x: tensor[3, 65] f32, out minima: tensor[3] f32, out maxima: tensor[3] f32, out indices: tensor[3] i32):
    let t = load(x)
    let low = reduce(t, 1, min)
    let high = reduce(t, 1, max)
    let at = reduce(t, 1, argmax)
    publish low to minima
    publish high to maxima
    publish at to indices

lower reduction_extrema for metal = portable
lower reduction_extrema for cpu = portable
lower reduction_extrema for cuda = portable

export fn argmax_lookup(x: tensor[65] f32, out out: tensor[1] f32, out index: tensor[1] i32):
    let t = load(x)
    let at = reduce(t, 0, argmax)
    var value = tile[1] f32
    var winner = tile[1] i32
    for i in owned(value):
        value[i] = t[at]
        winner[i] = at
    publish value to out
    publish winner to index

lower argmax_lookup for metal = portable
lower argmax_lookup for cpu = portable
lower argmax_lookup for cuda = portable

# Narrow accumulation is an explicit ascending chain in the input dtype: every
# addition rounds to BF16 / F16 before the next one.
export fn narrow_sum(x: tensor[4] bf16, h: tensor[4] f16, out out: tensor[2] f32):
    let t = load(x)
    let u = load(h)
    var s = bf16(0.0)
    for i in 0..4:
        s = s + t[i]
    var r = f16(0.0)
    for i in 0..4:
        r = r + u[i]
    var value = tile[2] f32
    for i in owned(value):
        if coord(i) == 0:
            value[i] = f32(s)
        else:
            value[i] = f32(r)
    publish value to out

lower narrow_sum for metal = portable
lower narrow_sum for cpu = portable
lower narrow_sum for cuda = portable

export fn integer_extrema(x: tensor[2, 33] i32, out minima: tensor[2] i32, out maxima: tensor[2] i32, out indices: tensor[2] i32):
    let t = load(x)
    let low = reduce(t, 1, min)
    let high = reduce(t, 1, max)
    let at = reduce(t, 1, argmax)
    publish low to minima
    publish high to maxima
    publish at to indices

lower integer_extrema for metal = portable
lower integer_extrema for cpu = portable
lower integer_extrema for cuda = portable

# Ordered sums are explicit ascending chains, each in its input dtype.
export fn ordered_large_sum(x: tensor[65] f32, b: tensor[65] bf16, h: tensor[65] f16, out out: tensor[3] f32):
    let xt = load(x)
    let bt = load(b)
    let ht = load(h)
    var xs = f32(0.0)
    for i in 0..65:
        xs = xs + xt[i]
    var bs = bf16(0.0)
    for i in 0..65:
        bs = bs + bt[i]
    var hs = f16(0.0)
    for i in 0..65:
        hs = hs + ht[i]
    var value = tile[3] f32
    for i in owned(value):
        if coord(i) == 0:
            value[i] = xs
        else:
            if coord(i) == 1:
                value[i] = f32(bs)
            else:
                value[i] = f32(hs)
    publish value to out

lower ordered_large_sum for metal = portable
lower ordered_large_sum for cpu = portable
lower ordered_large_sum for cuda = portable

export fn explicit_fma(x: tensor[3] f32, out out: tensor[2] f32):
    let t = load(x)
    var y = tile[2] f32
    for i in owned(y):
        if coord(i) == 0:
            y[i] = t[0] * t[1] + t[2]
        else:
            y[i] = fma(t[0], t[1], t[2])
    publish y to out

lower explicit_fma for metal = portable
lower explicit_fma for cpu = portable
lower explicit_fma for cuda = portable

# An empty logical reduction returns its identity; a logical window guard
# has no body effects for the empty domain, regardless of slice widths.
export fn empty_window(x: tensor[1] f32, out out: tensor[1] f32):
    let t = load(x[0:0])
    var acc = tile[1] f32
    for i in owned(acc):
        acc[i] = reduce(t, 0, sum)
    if extent(t, 0) > 0:
        acc[0] = acc[0] + 1.0
    publish acc to out

lower empty_window for metal = portable
lower empty_window for cpu = portable
lower empty_window for cuda = portable
