# Assignment copies owned values; later mutation cannot alter the source tensor.
fn tile_copy(x: &tensor[4] f32) -> tensor[4] f32:
    return to_owned(x)

fn loop_carried(result: tensor[1] f32) -> tensor[1] f32:
    let mut output = result
    let mut value = f32(1.0)
    for step in 0..3:
        let next = value + 1.0
        output[0] = value + next
        value = next
    return output

fn branch_merge(result: tensor[1] f32, choose: bool) -> tensor[1] f32:
    let mut output = result
    let mut value = f32(3.0)
    if choose:
        value = 7.0
    else:
        value = 11.0
    output[0] = value
    return output

fn bf16_rounding(x: &tensor[1] bf16, result: tensor[1] f32) -> tensor[1] f32:
    let mut output = result
    output[0] = f32(x[0] * x[0])
    return output

fn changed_source(x: tensor[4] f32, result: tensor[4] f32) -> tensor[4] f32:
    let snapshot = clone(x)
    let mut source = x
    let mut output = result
    for i in 0..4:
        output[i] = snapshot[i] * 2.0 + 1.0
        source[i] = 0.0
    return output

fn mixed_scalars(result: tensor[1] f32, first: bool, a: f32, b: bf16, last: bool) -> tensor[1] f32:
    let mut output = result
    let mut value = a + f32(b)
    if first:
        value = value + 10.0
    if last:
        value = value * 10.0
    output[0] = value
    return output

fn large_snapshot(x: tensor[65] f32, result: tensor[65] f32) -> (tensor[65] f32, tensor[65] f32):
    let snapshot = clone(x)
    let mut source = x
    let mut output = result
    for i in 0..65:
        source[i] = 0.0
        output[i] = snapshot[64 - i]
    return source, output

fn snapshot_reduction(x: tensor[65] f32, result: tensor[1] f32) -> (tensor[65] f32, tensor[1] f32):
    let snapshot = clone(x)
    let mut source = x
    let mut output = result
    let mut total = f32(0.0)
    for i in 0..65:
        source[i] = 0.0
        total = total + snapshot[i]
    output[0] = total
    return source, output

fn loaded_mutation(x: &tensor[65] f32, result: tensor[1] f32) -> tensor[1] f32:
    let mut snapshot = to_owned(x)
    let mut output = result
    for i in 0..65:
        snapshot[i] = 0.0
    let mut total = f32(0.0)
    for i in 0..65:
        total = total + snapshot[i]
    output[0] = total
    return output

fn half_rounding(x: &tensor[1] f16, result: tensor[1] f32, value: f16) -> tensor[1] f32:
    let mut output = result
    output[0] = f32(x[0] * value)
    return output

fn bounded_index(x: &tensor[4] f32, pos: index[4]) -> tensor[1] f32:
    return to_owned(x[pos:pos + 1])

fn reduction_extrema(x: &tensor[3, 65] f32, minima: tensor[3] f32, maxima: tensor[3] f32, indices: tensor[3] i32) -> (tensor[3] f32, tensor[3] f32, tensor[3] i32):
    let mut low = minima
    let mut high = maxima
    let mut at = indices
    for row in 0..3:
        low[row] = f32(inf)
        high[row] = f32(-inf)
        at[row] = 0
        for col in 0..65:
            let value = x[row, col]
            if value < low[row]:
                low[row] = value
            if value > high[row]:
                high[row] = value
                at[row] = col
    return low, high, at

fn argmax_lookup(x: &tensor[65] f32, value: tensor[1] f32, winner: tensor[1] i32) -> (tensor[1] f32, tensor[1] i32):
    let mut at = i32(0)
    let mut maximum = f32(-inf)
    for i in 0..65:
        if x[i] > maximum:
            maximum = x[i]
            at = i
    let mut output = value
    let mut index = winner
    output[0] = x[at]
    index[0] = at
    return output, index

fn narrow_sum(x: &tensor[4] bf16, h: &tensor[4] f16, result: tensor[2] f32) -> tensor[2] f32:
    let mut s = bf16(0.0)
    for i in 0..4:
        s = s + x[i]
    let mut r = f16(0.0)
    for i in 0..4:
        r = r + h[i]
    let mut output = result
    output[0] = f32(s)
    output[1] = f32(r)
    return output

fn integer_extrema(x: &tensor[2, 33] i32, minima: tensor[2] i32, maxima: tensor[2] i32, indices: tensor[2] i32) -> (tensor[2] i32, tensor[2] i32, tensor[2] i32):
    let mut low = minima
    let mut high = maxima
    let mut at = indices
    for row in 0..2:
        low[row] = x[row, 0]
        high[row] = x[row, 0]
        at[row] = 0
        for col in 1..33:
            if x[row, col] < low[row]:
                low[row] = x[row, col]
            if x[row, col] > high[row]:
                high[row] = x[row, col]
                at[row] = col
    return low, high, at

fn ordered_large_sum(x: &tensor[65] f32, b: &tensor[65] bf16, h: &tensor[65] f16, result: tensor[3] f32) -> tensor[3] f32:
    let mut xs = f32(0.0)
    let mut bs = bf16(0.0)
    let mut hs = f16(0.0)
    for i in 0..65:
        xs = xs + x[i]
        bs = bs + b[i]
        hs = hs + h[i]
    let mut output = result
    output[0] = xs
    output[1] = f32(bs)
    output[2] = f32(hs)
    return output

fn explicit_fma(x: &tensor[3] f32, result: tensor[2] f32) -> tensor[2] f32:
    let mut output = result
    output[0] = x[0] * x[1] + x[2]
    output[1] = fma(x[0], x[1], x[2])
    return output

fn empty_window(x: &tensor[1] f32, result: tensor[1] f32) -> tensor[1] f32:
    let mut output = result
    output[0] = 0.0
    return output
