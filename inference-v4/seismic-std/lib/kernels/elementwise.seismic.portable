# Explicit publication operations. Compositions retain separate calls wherever the
# model equations require intermediate rounding. Owners span rows and columns: the work is
# pointwise, so a single row still divides into independent column slices.
export fn silu[M, N](x: tensor[M, N] T, out out: tensor[M, N] U) alias(x, out):
    parallel [rows, cols] in (0..M, 0..N):
        let a = f32(x[rows, cols])
        publish a / (1.0 + exp(-a)) to out[rows, cols]

export fn multiply[M, N](x: tensor[M, N] T, y: tensor[M, N] U, out out: tensor[M, N] V) alias(x, out):
    parallel [rows, cols] in (0..M, 0..N):
        publish f32(x[rows, cols]) * f32(y[rows, cols]) to out[rows, cols]

export fn add[M, N](x: tensor[M, N] T, y: tensor[M, N] U, out out: tensor[M, N] V) alias(x, out):
    parallel [rows, cols] in (0..M, 0..N):
        publish f32(x[rows, cols]) + f32(y[rows, cols]) to out[rows, cols]

export fn sigmoid[M, N](x: tensor[M, N] T, out out: tensor[M, N] U) alias(x, out):
    parallel [rows, cols] in (0..M, 0..N):
        publish 1.0 / (1.0 + exp(-f32(x[rows, cols]))) to out[rows, cols]

# Tanh-form GELU used by Qwen vision blocks. The sigmoid identity avoids a
# separate tanh helper: tanh(z) = 2 / (1 + exp(-2*z)) - 1. Merger erf-GELU is a
# different operation and must not use this entry.
export fn gelu_tanh[M, N](x: tensor[M, N] T, out out: tensor[M, N] U):
    parallel [rows] in 0..M:
        let value = f32(x[rows])
        let argument = 0.7978845608028654 * (value + 0.044715 * value * value * value)
        let hyperbolic = 2.0 / (1.0 + exp(-2.0 * argument)) - 1.0
        publish 0.5 * value * (1.0 + hyperbolic) to out[rows]

lower silu for metal = portable
lower silu for cpu = portable
lower silu for cuda = portable
lower multiply for metal = portable
lower multiply for cpu = portable
lower multiply for cuda = portable
lower add for metal = portable
lower add for cpu = portable
lower add for cuda = portable
lower sigmoid for metal = portable
lower sigmoid for cpu = portable
lower sigmoid for cuda = portable
lower gelu_tanh for metal = portable
lower gelu_tanh for cpu = portable
lower gelu_tanh for cuda = portable
