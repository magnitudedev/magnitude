# Explicit publication operations. Compositions retain separate calls wherever the
# model equations require intermediate rounding.
fn silu[M, N](x: tensor[M, N] T, out: tensor[M, N] U):
  for row in parallel:
    a = load(x[row])
    y = tile[N] f32
    for i in owned(y): y[i] = f32(a[i]) / (1.0 + exp(-f32(a[i])))
    store(y, out[row])

fn multiply[M, N](x: tensor[M, N] T, y: tensor[M, N] U, out: tensor[M, N] V):
  for row in parallel:
    a = load(x[row])
    b = load(y[row])
    z = tile[N] f32
    for i in owned(z): z[i] = f32(a[i]) * f32(b[i])
    store(z, out[row])

fn add[M, N](x: tensor[M, N] T, y: tensor[M, N] U, out: tensor[M, N] V):
  for row in parallel:
    a = load(x[row])
    b = load(y[row])
    z = tile[N] f32
    for i in owned(z): z[i] = f32(a[i]) + f32(b[i])
    store(z, out[row])

fn sigmoid[M, N](x: tensor[M, N] T, out: tensor[M, N] U):
  for row in parallel:
    a = load(x[row])
    y = tile[N] f32
    for i in owned(y): y[i] = 1.0 / (1.0 + exp(-f32(a[i])))
    store(y, out[row])

# Tanh-form GELU used by Qwen vision blocks. The sigmoid identity avoids a
# separate tanh helper: tanh(z) = 2 / (1 + exp(-2*z)) - 1. Merger erf-GELU is a
# different operation and must not use this entry.
fn gelu_tanh[M, N](x: tensor[M, N] T, out: tensor[M, N] U):
  for row in parallel:
    source = load(x[row])
    result = tile[N] f32
    for i in owned(result):
      value = f32(source[i])
      argument = 0.7978845608028654 * (value + 0.044715 * value * value * value)
      hyperbolic = 2.0 / (1.0 + exp(-2.0 * argument)) - 1.0
      result[i] = 0.5 * value * (1.0 + hyperbolic)
    store(result, out[row])
