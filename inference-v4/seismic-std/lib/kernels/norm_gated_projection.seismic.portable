# The feed-forward norm folded into the SwiGLU gate and up projections of one activation
# row: out = silu(norm(x)·gate) * (norm(x)·up), with both dot products sharing the normalized activation.
# The inverse RMS scales the completed accumulators, never the input elements.
export fn norm_gated_projection[N, K](x: tensor[1, K] bf16, nw: tensor[1, K] bf16, gate: tensor[N, K] q4g64, up: tensor[N, K] q4g64, eps: f32, out out: tensor[1, N] bf16):
    parallel [cols] in 0..N:
        var g = zeros_like(out[:, cols], dtype=f32)
        var u = zeros_like(out[:, cols], dtype=f32)
        let xf = f32(x[0])
        let ss = reduce(xf * xf, 0, sum)
        ordered [k] in 0..K:
            let a = f32(x[:, k]) * f32(nw[:, k])
            matmul(a, load(gate[cols, k]), into=g)
            matmul(a, load(up[cols, k]), into=u)
        let inv = rsqrt(ss / f32(K) + eps)
        let gs = g * inv
        publish gs / (1.0 + exp(-gs)) * (u * inv) to out[:, cols]

lower norm_gated_projection for metal = portable
lower norm_gated_projection for cpu = portable
lower norm_gated_projection for cuda = portable
