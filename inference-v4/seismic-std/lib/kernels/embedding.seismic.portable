# One packed embedding row, decoded to the activation dtype.
export fn embedding[V, K](table: tensor[V, K] q4g64, token: index[V], out out: tensor[1, K] bf16):
    parallel [cols] in 0..K:
        publish f32(table[token, cols]) to out[0, cols]

lower embedding for metal = portable
lower embedding for cpu = portable
lower embedding for cuda = portable
