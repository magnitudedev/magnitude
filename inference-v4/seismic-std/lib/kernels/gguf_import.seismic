# GGUF block layouts are decoded into representation compact planes.
# Each output word owns all its bits, including codes crossing word boundaries.
# Byte `o` of the little-endian source is (data[o / 4] >> (8 * (o % 4))) & 255.
fn import_q4k[B](data: &tensor[(B * 144 + 3) / 4] u32, halves: &tensor[B * 72] f16, words: &mut tensor[B * 32] u32, coefficients: &mut tensor[B * 3] u32, scale_factor: &mut tensor[B] f16, bias_factor: &mut tensor[B] f16):
    parallel for blocks in 0..B:
        let mut packed = tensor[32] u32
        for w in 0..32:
            let mut word = u32(0)
            for bit in 0..32:
                let position = (w *32 + bit) / 4
                let code = (((data[(blocks * 144 + 16 + position / 64 * 32 + position % 32) / 4] >> u32(8 * ((blocks * 144 + 16 + position / 64 * 32 + position % 32) % 4))) & 255) >> u32(position % 64 / 32 * 4)) & 15
                word = word | (((code >> u32((w *32 + bit) % 4)) & 1) << u32(bit))
            packed[w] = word
        words[blocks * 32 : (blocks + 1) * 32] = packed
        let mut local_coefficients = tensor[3] u32
        for w in 0..3:
            let mut word = u32(0)
            for bit in 0..32:
                let field = (w *32 + bit) / 6
                let g = field / 2
                let low = (data[(blocks * 144 + 4 + (field % 2) * 4 + g % 4) / 4] >> u32(8 * ((blocks * 144 + 4 + (field % 2) * 4 + g % 4) % 4))) & 255
                let high = (data[(blocks * 144 + 12 + g % 4) / 4] >> u32(8 * ((blocks * 144 + 12 + g % 4) % 4))) & 255
                let mut local = low & 63
                if g >= 4:
                    local = ((high >> u32((field % 2) * 4)) & 15) | ((low >> 6) << 4)
                word = word | (((local >> u32((w *32 + bit) % 6)) & 1) << u32(bit))
            local_coefficients[w] = word
        coefficients[blocks * 3 : (blocks + 1) * 3] = local_coefficients
        let mut factor = tensor[1] f16
        for i in 0..1:
            factor[i] = halves[blocks * 72 + 0]
        scale_factor[blocks : blocks + 1] = factor
        let mut bias = tensor[1] f16
        for i in 0..1:
            bias[i] = halves[blocks * 72 + 1]
        bias_factor[blocks : blocks + 1] = bias

fn import_q5k[B](data: &tensor[(B * 176 + 3) / 4] u32, halves: &tensor[B * 88] f16, words: &mut tensor[B * 40] u32, coefficients: &mut tensor[B * 3] u32, scale_factor: &mut tensor[B] f16, bias_factor: &mut tensor[B] f16):
    parallel for blocks in 0..B:
        let mut packed = tensor[40] u32
        for w in 0..40:
            let mut word = u32(0)
            for bit in 0..32:
                let position = (w *32 + bit) / 5
                let mut code = (((data[(blocks * 176 + 48 + position / 64 * 32 + position % 32) / 4] >> u32(8 * ((blocks * 176 + 48 + position / 64 * 32 + position % 32) % 4))) & 255) >> u32(position % 64 / 32 * 4)) & 15
                code = code | (((((data[(blocks * 176 + 16 + position % 32) / 4] >> u32(8 * ((blocks * 176 + 16 + position % 32) % 4))) & 255) >> u32(position / 32)) & 1) << 4)
                word = word | (((code >> u32((w *32 + bit) % 5)) & 1) << u32(bit))
            packed[w] = word
        words[blocks * 40 : (blocks + 1) * 40] = packed
        let mut local_coefficients = tensor[3] u32
        for w in 0..3:
            let mut word = u32(0)
            for bit in 0..32:
                let field = (w *32 + bit) / 6
                let g = field / 2
                let low = (data[(blocks * 176 + 4 + (field % 2) * 4 + g % 4) / 4] >> u32(8 * ((blocks * 176 + 4 + (field % 2) * 4 + g % 4) % 4))) & 255
                let high = (data[(blocks * 176 + 12 + g % 4) / 4] >> u32(8 * ((blocks * 176 + 12 + g % 4) % 4))) & 255
                let mut local = low & 63
                if g >= 4:
                    local = ((high >> u32((field % 2) * 4)) & 15) | ((low >> 6) << 4)
                word = word | (((local >> u32((w *32 + bit) % 6)) & 1) << u32(bit))
            local_coefficients[w] = word
        coefficients[blocks * 3 : (blocks + 1) * 3] = local_coefficients
        let mut factor = tensor[1] f16
        for i in 0..1:
            factor[i] = halves[blocks * 88 + 0]
        scale_factor[blocks : blocks + 1] = factor
        let mut bias = tensor[1] f16
        for i in 0..1:
            bias[i] = halves[blocks * 88 + 1]
        bias_factor[blocks : blocks + 1] = bias

fn import_q6k[B](data: &tensor[(B * 210 + 3) / 4] u32, halves: &tensor[B * 105] f16, words: &mut tensor[B * 48] u32, coefficients: &mut tensor[B * 4] u32, scale_factor: &mut tensor[B] f16):
    parallel for blocks in 0..B:
        let mut packed = tensor[48] u32
        for w in 0..48:
            let mut word = u32(0)
            for bit in 0..32:
                let position = (w *32 + bit) / 6
                let mut code = (((data[(blocks * 210 + position / 128 * 64 + position % 64) / 4] >> u32(8 * ((blocks * 210 + position / 128 * 64 + position % 64) % 4))) & 255) >> u32(position % 128 / 64 * 4)) & 15
                code = code | (((((data[(blocks * 210 + 128 + position / 128 * 32 + position % 32) / 4] >> u32(8 * ((blocks * 210 + 128 + position / 128 * 32 + position % 32) % 4))) & 255) >> u32(position % 128 / 32 * 2)) & 3) << 4)
                word = word | (((code >> u32((w *32 + bit) % 6)) & 1) << u32(bit))
            packed[w] = word
        words[blocks * 48 : (blocks + 1) * 48] = packed
        let mut local_coefficients = tensor[4] u32
        for w in 0..4:
            let mut word = u32(0)
            for c in 0..4:
                let g = w *4 + c
                let local = (data[(blocks * 210 + 192 + g) / 4] >> u32(8 * ((blocks * 210 + 192 + g) % 4))) & 255
                word = word | (local << u32(8 * c))
            local_coefficients[w] = word
        coefficients[blocks * 4 : (blocks + 1) * 4] = local_coefficients
        let mut factor = tensor[1] f16
        for i in 0..1:
            factor[i] = halves[blocks * 105 + 104]
        scale_factor[blocks : blocks + 1] = factor

fn import_q8_0[B](data: &tensor[(B * 34 + 3) / 4] u32, halves: &tensor[B * 17] f16, words: &mut tensor[B * 8] u32, scale: &mut tensor[B * 1] f16):
    parallel for blocks in 0..B:
        let mut packed = tensor[8] u32
        for w in 0..8:
            let mut word = u32(0)
            for c in 0..4:
                let position = w *4 + c
                let code = (data[(blocks * 34 + 2 + position) / 4] >> u32(8 * ((blocks * 34 + 2 + position) % 4))) & 255
                word = word | (code << u32(8 * c))
            packed[w] = word
        words[blocks * 8 : (blocks + 1) * 8] = packed
        let mut scales = tensor[1] f16
        for g in 0..1:
            scales[g] = halves[blocks * 17]
        scale[blocks * 1 : (blocks + 1) * 1] = scales

fn import_iq4_xs[B](data: &tensor[(B * 136 + 3) / 4] u32, halves: &tensor[B * 68] f16, words: &mut tensor[B * 32] u32, scale: &mut tensor[B * 8] f32):
    parallel for blocks in 0..B:
        let mut packed = tensor[32] u32
        for w in 0..32:
            let mut word = u32(0)
            for c in 0..8:
                let position = w *8 + c
                let code = (((data[(blocks * 136 + 8 + position / 32 * 16 + position % 16) / 4] >> u32(8 * ((blocks * 136 + 8 + position / 32 * 16 + position % 16) % 4))) & 255) >> u32(position % 32 / 16 * 4)) & 15
                word = word | (code << u32(4 * c))
            packed[w] = word
        words[blocks * 32 : (blocks + 1) * 32] = packed
        let mut scales = tensor[8] f32
        for g in 0..8:
            let high = ((data[(blocks * 136 + 2) / 4] >> u32(8 * ((blocks * 136 + 2) % 4))) & 255) | (((data[(blocks * 136 + 3) / 4] >> u32(8 * ((blocks * 136 + 3) % 4))) & 255) << 8)
            let low = (((data[(blocks * 136 + 4 + g / 2) / 4] >> u32(8 * ((blocks * 136 + 4 + g / 2) % 4))) & 255) >> u32(g % 2 * 4)) & 15
            let local = i32(low | (((high >> u32(2 * g)) & 3) << 4)) - 32
            scales[g] = f32(halves[blocks * 68]) * f32(local)
        scale[blocks * 8 : (blocks + 1) * 8] = scales
