# Stored float values are decoded by their element type. Transforms write f32
# before the destination's explicit storage conversion.
fn import_weight[N](source: &tensor[N] T, result: &mut tensor[N] U):
    parallel for items in 0..N:
        result[items] = f32(source[items])

fn import_weight_negative_exp[N](source: &tensor[N] T, result: &mut tensor[N] U):
    parallel for items in 0..N:
        result[items] = -exp(f32(source[items]))
