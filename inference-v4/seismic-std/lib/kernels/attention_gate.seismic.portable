# Attention output gate: y = attended * sigmoid(gate), flattened over heads.
export fn attention_gate[H, W](attended: tensor[1, H, W] bf16, gate: tensor[1, H * W] bf16, out y: tensor[1, H * W] bf16):
    parallel [heads] in 0..H:
        for h in heads:
            let a = f32(attended[0, h])
            let g = f32(gate[0, h * W : (h + 1) * W])
            publish a / (1.0 + exp(-g)) to y[0, h * W : (h + 1) * W]

lower attention_gate for metal = portable
lower attention_gate for cpu = portable
lower attention_gate for cuda = portable
