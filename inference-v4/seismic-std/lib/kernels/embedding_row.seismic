# The compact embedding publication precedes the model's F32 residual cast.
fn embedding_row[V, K](table: &tensor[V, K] T, token: index[V], result: &mut tensor[1, K] A):
    parallel for cols in 0..K:
        result[0, cols] = f32(table[token, cols])

fn cast_rows[M, K](input: &tensor[M, K] T, result: &mut tensor[M, K] U):
    parallel for rows in 0..M:
        result[rows] = load(input[rows])
