# Online softmax update over one logical history span: the carried maximum `m`,
# normalization sum `l` and weighted-value accumulator `acc` absorb the span's scores in
# one step. The score tensor is local to the call; the caller authors which span it covers.
fn attention_update[M, K, W](qt: &tensor[M, W] A, kt: &tensor[K, W] A, vt: &tensor[K, W] A,
                             m: &mut tensor[M] f32, l: &mut tensor[M] f32, acc: &mut tensor[M, W] f32, scale: f32):
    let mut seed = tensor[M, K] f32
    for i in 0..M:
        for j in 0..K:
            seed[i, j] = 0.0
    let mut s = matmul(to_owned(qt), to_owned(kt), seed)
    let rowmax = reduce(f32(s), 1, max)
    let mut m2 = tensor[M] f32
    for i in 0..M:
        m2[i] = max(m[i], rowmax[i] * scale)
    for i in 0..M:
        for j in 0..K:
            s[i, j] = exp(s[i, j] * scale - m2[i])
    let mut a = tensor[M] f32
    for i in 0..M:
        a[i] = exp(m[i] - m2[i])
    let rowsum = reduce(f32(s), 1, sum)
    for i in 0..M:
        l[i] = fma(l[i], a[i], rowsum[i])
    for i in 0..M:
        for j in 0..W:
            acc[i, j] = acc[i, j] * a[i]
    # The value product is the `matmul` chain of every output (F32 FMA over ascending
    # history), visited history-major: each history row of `vt` is read once, in storage
    # order, by all outputs, instead of each output striding down a column of the borrow.
    for k in 0..K:
        for i in 0..M:
            for j in 0..W:
                acc[i, j] = fma(s[i, k], f32(vt[k, j]), acc[i, j])
    for i in 0..M:
        m[i] = m2[i]

# Causal attention over grouped query heads. Each visible range is a logical
# algorithmic window, independent of compiler partitioning. Empty history has no
# update effect; decoding consumes the fresh dense row before cache-codec rounding.
fn attention[Q, T, H, KV, W](q: &tensor[Q, H, W] A, k: &tensor[T, KV, W] A, v: &tensor[T, KV, W] A,
                                    visible: &tensor[Q, 2] i32, result: &mut tensor[Q, H, W] A, scale: f32):
    parallel for rows in 0..Q:
        parallel for kv_heads in 0..KV:
            let qt = load(q[rows, kv_heads * (H / KV) : (kv_heads + 1) * (H / KV)])
            let mut m = tensor[H / KV] f32
            let mut l = tensor[H / KV] f32
            let mut acc = tensor[H / KV, W] f32
            for i in 0..H / KV:
                m[i] = -inf
            for i in 0..H / KV:
                l[i] = 0.0
            for i in 0..H / KV:
                for j in 0..W:
                    acc[i, j] = 0.0
            let lo = visible[rows, 0]
            let hi = visible[rows, 1]
            let kt = load(k[lo : hi, kv_heads])
            let vt = load(v[lo : hi, kv_heads])
            if extent(kt, 0) > 0:
                attention_update(qt, kt, vt, m, l, acc, scale)
            let mut y = tensor[H / KV, W] f32
            for i in 0..H / KV:
                for j in 0..W:
                    y[i, j] = acc[i, j] / l[i]
            result[rows, kv_heads * (H / KV) : (kv_heads + 1) * (H / KV)] = y

# Decode attends to the previously visible history plus the new dense row. Fresh
# inputs do not acquire history-codec rounding before their first consumption.
fn attention_decode[T, G, KV, W](q: &tensor[1, KV * G, W] A, k: &tensor[T, KV, W] A,
    v: &tensor[T, KV, W] A, fresh_key: &tensor[1, KV, W] A, fresh_value: &tensor[1, KV, W] A,
    visible: &tensor[1, 2] i32, result: &mut tensor[1, KV * G, W] A, scale: f32):
    parallel for kv_heads in 0..KV:
        let qt = load(q[0, kv_heads * G : (kv_heads + 1) * G])
        let mut m = tensor[G] f32
        let mut l = tensor[G] f32
        let mut acc = tensor[G, W] f32
        for i in 0..G:
            m[i] = -inf
        for i in 0..G:
            l[i] = 0.0
        for i in 0..G:
            for j in 0..W:
                acc[i, j] = 0.0
        let lo = visible[0, 0]
        let hi = visible[0, 1]
        let kt = load(k[lo : hi, kv_heads])
        let vt = load(v[lo : hi, kv_heads])
        if extent(kt, 0) > 0:
            attention_update(qt, kt, vt, m, l, acc, scale)
        let fresh_kt = load(fresh_key[0 : 1, kv_heads])
        let fresh_vt = load(fresh_value[0 : 1, kv_heads])
        attention_update(qt, fresh_kt, fresh_vt, m, l, acc, scale)
        let mut y = tensor[G, W] f32
        for i in 0..G:
            for j in 0..W:
                y[i, j] = acc[i, j] / l[i]
        result[0, kv_heads * G : (kv_heads + 1) * G] = y
