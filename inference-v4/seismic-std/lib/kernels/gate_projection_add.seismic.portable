# The attention output gate folded into the output projection: one row x * sigmoid(gate)
# against a packed weight matrix, added to a residual row.
export fn gate_projection_add[N, K](x: tensor[1, K] bf16, gate: tensor[1, K] bf16, w: tensor[N, K] q4g64, residual: tensor[1, N] bf16, out out: tensor[1, N] bf16):
    parallel [cols] in 0..N:
        var acc = zeros_like(out[:, cols], dtype=f32)
        ordered [k] in 0..K:
            let a = f32(x[:, k]) / (1.0 + exp(-f32(gate[:, k])))
            matmul(a, load(w[cols, k]), into=acc)
        publish acc + f32(residual[:, cols]) to out[:, cols]

lower gate_projection_add for metal = portable
lower gate_projection_add for cpu = portable
lower gate_projection_add for cuda = portable
