fn rms_norm[R, W](x: tensor[R, W] T, weight: tensor[W] U, out: tensor[R, W] V, eps: f32):
  for row in parallel:
    t = load(x[row])
    sq = tile[W] f32
    for i in owned(sq): sq[i] = f32(t[i]) * f32(t[i])
    ss = reduce(sq, 0, sum)
    wt = load(weight)
    y = tile[W] f32
    for i in owned(y): y[i] = f32(t[i]) * rsqrt(ss / f32(W) + eps) * f32(wt[i])
    store(y, out[row])
