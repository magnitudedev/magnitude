# Two-pass centered FP32 statistics; affine output publishes exactly once at V.
# The caller supplies finite positive epsilon.
export fn layer_norm[R, W](x: tensor[R, W] T, weight: tensor[W] U, bias: tensor[W] B,
    out out: tensor[R, W] V, epsilon: f32):
    parallel [rows] in 0..R:
        let scale = f32(weight)
        let shift = f32(bias)
        for row in rows:
            let source = f32(x[row])
            let mean = reduce(source, 0, sum) / f32(W)
            let centered = source - mean
            let inverse = rsqrt(reduce(centered * centered, 0, sum) / f32(W) + epsilon)
            publish centered * inverse * scale + shift to out[row]

lower layer_norm for metal = portable
lower layer_norm for cpu = portable
lower layer_norm for cuda = portable
