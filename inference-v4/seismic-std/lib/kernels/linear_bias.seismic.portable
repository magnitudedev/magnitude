# Bias is applied to the FP32 accumulator before output publication. A separate
# compact linear result followed by add would introduce an extra rounding.
fn linear_bias[M, N, K](x: tensor[M, K] T, weight: tensor[N, K] U,
    bias: tensor[N] B, out: tensor[M, N] V):
  for row, col in parallel:
    acc = tile[1, 1] f32
    for i, j in owned(acc): acc[i, j] = 0.0
    xt = load(x[row:row+1])
    wt = load(weight[col:col+1])
    matmul(xt, wt, acc)
    shift = load(bias[col:col+1])
    for i, j in owned(acc): acc[i, j] = acc[i, j] + f32(shift[j])
    store(acc, out[row:row+1, col:col+1])
