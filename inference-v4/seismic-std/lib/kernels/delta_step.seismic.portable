# One step of the gated delta rule for every value head, one state row per work item:
# row *= decay; remembered = row . key; row += (value - remembered) * beta * key;
# out = row . query. Grouped value heads use key head h / GV; tiled heads use h % NK.
# The engine binds this semantic mapping from the artifact description.
fn delta_step[NK, GV, W](qkv: tensor[2 * NK + NK * GV, W] A, beta: tensor[NK * GV] A, decay: tensor[NK * GV] f32,
                         state: tensor[NK * GV, W, W] f32, next_state: tensor[NK * GV, W, W] f32, out: tensor[NK * GV, W] A, grouped: bool):
  for h, i in parallel:
    row = load(state[h, i])
    key_head = h % NK
    if grouped: key_head = h / GV
    key = load(qkv[NK + key_head])
    query = load(qkv[key_head])
    p = tile[W] f32
    for j in owned(p): p[j] = row[j] * decay[h] * f32(key[j])
    remembered = reduce(p, 0, sum)
    residual = (f32(qkv[2 * NK + h, i]) - remembered) * f32(beta[h])
    nrow = tile[W] f32
    for j in owned(nrow): nrow[j] = fma(residual, f32(key[j]), row[j] * decay[h])
    store(nrow, next_state[h, i])
    pq = tile[W] f32
    for j in owned(pq): pq[j] = nrow[j] * f32(query[j])
    o = reduce(pq, 0, sum)
    ot = tile[1] f32
    for j in owned(ot): ot[j] = o
    store(ot, out[h, i : i + 1])
