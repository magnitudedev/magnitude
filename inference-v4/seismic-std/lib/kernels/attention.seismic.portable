# Softmax update over a logical history domain. Its matrix contractions and
# reductions remain available for compiler-derived blocking and retained state.
fn attention_update[M, K, W](qt: tile[M, W] A, kt: tile[K, W] A, vt: tile[K, W] A,
                           m: tile[M] f32, l: tile[M] f32, acc: tile[M, W] f32, scale: f32):
  s = tile[M, K] f32
  for i, j in owned(s): s[i, j] = 0.0
  matmul(qt, kt, s)
  rowmax = reduce(s, 1, max)
  m2 = tile[M] f32
  for i in owned(m2): m2[i] = max(m[i], rowmax[i] * scale)
  for i, j in owned(s): s[i, j] = exp(s[i, j] * scale - m2[i])
  a = tile[M] f32
  for i in owned(a): a[i] = exp(m[i] - m2[i])
  rowsum = reduce(s, 1, sum)
  for i in owned(l): l[i] = fma(l[i], a[i], rowsum[i])
  for i, j in owned(acc): acc[i, j] = acc[i, j] * a[i]
  matmul(s, vt.T, acc)
  m = m2

# Causal attention over grouped query heads. Each visible range is a logical
# algorithmic window, independent of compiler partitioning. Empty history has no
# update effect; decoding consumes the fresh dense row before cache-codec rounding.
fn attention[Q, T, H, KV, W](q: tensor[Q, H, W] A, k: tensor[T, KV, W] A, v: tensor[T, KV, W] A,
                             visible: tensor[Q, 2] i32, out: tensor[Q, H, W] A, scale: f32):
  for row, kv_head in parallel:
    qt = load(q[row, kv_head * (H / KV) : (kv_head + 1) * (H / KV)])
    m = tile[H / KV] f32
    l = tile[H / KV] f32
    acc = tile[H / KV, W] f32
    for i in owned(m): m[i] = -inf; l[i] = 0.0
    for i, j in owned(acc): acc[i, j] = 0.0
    kt = load(k[visible[row, 0] : visible[row, 1], kv_head])
    vt = load(v[visible[row, 0] : visible[row, 1], kv_head])
    if extent(kt, 0) > 0:
      attention_update(qt, kt, vt, m, l, acc, scale)
    y = tile[H / KV, W] f32
    for i, j in owned(y): y[i, j] = acc[i, j] / l[i]
    store(y, out[row, kv_head * (H / KV) : (kv_head + 1) * (H / KV)])

# Decode attends to the previously visible history plus the new dense row. Fresh
# inputs do not acquire history-codec rounding before their first consumption.
fn attention_decode[T, H, KV, W](q: tensor[1, H, W] A, k: tensor[T, KV, W] A,
    v: tensor[T, KV, W] A, fresh_key: tensor[1, KV, W] A, fresh_value: tensor[1, KV, W] A,
    visible: tensor[1, 2] i32, out: tensor[1, H, W] A, scale: f32):
  for kv_head in parallel:
    qt = load(q[0, kv_head * (H / KV):(kv_head + 1) * (H / KV)])
    m = tile[H / KV] f32
    l = tile[H / KV] f32
    acc = tile[H / KV, W] f32
    for i in owned(m): m[i] = -inf; l[i] = 0.0
    for i, j in owned(acc): acc[i, j] = 0.0
    kt = load(k[visible[0, 0]:visible[0, 1], kv_head])
    vt = load(v[visible[0, 0]:visible[0, 1], kv_head])
    if extent(kt, 0) > 0:
      attention_update(qt, kt, vt, m, l, acc, scale)
    fresh_kt = load(fresh_key[0:1, kv_head])
    fresh_vt = load(fresh_value[0:1, kv_head])
    attention_update(qt, fresh_kt, fresh_vt, m, l, acc, scale)
    y = tile[H / KV, W] f32
    for i, j in owned(y): y[i, j] = acc[i, j] / l[i]
    store(y, out[0, kv_head * (H / KV):(kv_head + 1) * (H / KV)])
