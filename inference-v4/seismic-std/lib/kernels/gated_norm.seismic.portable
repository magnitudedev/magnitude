# Per-head RMS norm of the recurrence output, gated: y[h] = norm(out[h]) * w * silu(z[h]).
fn gated_norm[NV, W](out: tensor[NV, W] bf16, w: tensor[W] bf16, z: tensor[1, NV * W] bf16, eps: f32, y: tensor[1, NV * W] bf16):
  for h in parallel:
    x = load(out[h])
    wt = load(w)
    g = load(z[0, h * W : (h + 1) * W])
    sq = tile[W] f32
    for i in owned(sq): sq[i] = f32(x[i]) * f32(x[i])
    ss = reduce(sq, 0, sum)
    inv = rsqrt(ss / f32(W) + eps)
    r = tile[W] f32
    for i in owned(r): r[i] = f32(x[i]) * inv * f32(wt[i]) * (f32(g[i]) / (1.0 + exp(-f32(g[i]))))
    store(r, y[0, h * W : (h + 1) * W])
