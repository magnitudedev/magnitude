# Bias is applied to the FP32 accumulator before output publication. A separate
# compact linear result followed by add would introduce an extra rounding.
fn linear_bias[M, N, K](x: tensor[M, K] T, weight: tensor[N, K] U,
    bias: tensor[N] B, out out: tensor[M, N] V):
    parallel [rows, cols] in (0..M, 0..N):
        let mut acc = zeros_like(out[rows, cols], dtype=f32)
        ordered [k] in 0..K:
            matmul(load(x[rows, k]), load(weight[cols, k]), into=acc)
        let shift = load(bias[cols])
        for i, j in owned(acc):
            acc[i, j] = acc[i, j] + f32(shift[j])
        publish acc to out[rows, cols]
