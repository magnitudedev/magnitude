# One activation row against a packed weight matrix.
export fn projection[N, K](x: tensor[1, K] bf16, w: tensor[N, K] q4g64, out out: tensor[1, N] bf16):
    parallel [cols] in 0..N:
        var acc = zeros_like(out[:, cols], dtype=f32)
        ordered [k] in 0..K:
            matmul(load(x[:, k]), load(w[cols, k]), into=acc)
        publish acc to out[:, cols]

lower projection for metal = portable
lower projection for cpu = portable
lower projection for cuda = portable
