# Stored float values are decoded by their element type. Transforms publish f32
# before the destination's explicit storage conversion.
export fn import_weight[N](source: tensor[N] T, out out: tensor[N] U, negative_exp: bool):
    parallel [items] in 0..N:
        let y = f32(source[items])
        if negative_exp:
            publish -exp(y) to out[items]
        else:
            publish y to out[items]

lower import_weight for metal = portable
lower import_weight for cpu = portable
lower import_weight for cuda = portable
