# V3 selection semantics: Philox4x32-10 counters are token, output position,
# and draw domain; the request seed is the key. Partitioning never changes a draw:
# the token counter is the semantic vocabulary coordinate, never a slice-local offset.
# Output pairs are (token, status): 0 success, 1 empty, 2 nonfinite source.
fn sample_rows[M, V](logits: &tensor[M, V] f32, mask: &tensor[M, (V + 31) / 32] u32,
    draws: &tensor[M, 6] u32, result: &mut tensor[M, 2] i32):
    # Row-local reductions are whole-tensor intrinsics, which Seismic cannot
    # currently lower inside a parallel loop. The native Metal implementation
    # dispatches rows independently.
    for rows in 0..M:
        let mut scores = tensor[V] f32
        let mut invalid = tensor[V] i32
        for token in 0..V:
            let value = logits[rows, token]
            invalid[token] = 0
            if value != value or value == inf:
                invalid[token] = 1
        for token in 0..V:
            let mut value = logits[rows, token]
            scores[token] = -inf
            if ((mask[rows, token / 32] >> u32(token % 32)) & 1) != 0 and value > -inf and value < inf:
                if draws[rows, 0] == 1:
                    let mut c0 = u32(token)
                    let mut c1 = draws[rows, 3]
                    let mut c2 = draws[rows, 4]
                    let mut c3 = draws[rows, 5]
                    let mut k0 = draws[rows, 1]
                    let mut k1 = draws[rows, 2]
                    for round in 0..10:
                        let a0 = u32(3528531795)
                        let a1 = u32(3449720151)
                        let p00 = (a0 & 65535) * (c0 & 65535)
                        let p01 = (a0 >> 16) * (c0 & 65535)
                        let p02 = (a0 & 65535) * (c0 >> 16)
                        let p03 = (a0 >> 16) * (c0 >> 16)
                        let middle0 = (p00 >> 16) + (p01 & 65535) + (p02 & 65535)
                        let hi0 = p03 + (p01 >> 16) + (p02 >> 16) + (middle0 >> 16)
                        let lo0 = (middle0 << 16) | (p00 & 65535)
                        let p10 = (a1 & 65535) * (c2 & 65535)
                        let p11 = (a1 >> 16) * (c2 & 65535)
                        let p12 = (a1 & 65535) * (c2 >> 16)
                        let p13 = (a1 >> 16) * (c2 >> 16)
                        let middle1 = (p10 >> 16) + (p11 & 65535) + (p12 & 65535)
                        let hi1 = p13 + (p11 >> 16) + (p12 >> 16) + (middle1 >> 16)
                        let lo1 = (middle1 << 16) | (p10 & 65535)
                        let next0 = hi1 ^ c1 ^ k0
                        let next2 = hi0 ^ c3 ^ k1
                        c0 = next0
                        c1 = lo1
                        c2 = next2
                        c3 = lo0
                        k0 = k0 + u32(2654435769)
                        k1 = k1 + u32(3144134277)
                    let uniform = (f32(c0 >> 9) + 0.5) * 0.00000011920928955078125
                    value = value - log(-log(uniform))
                scores[token] = value
        let bad = reduce(invalid, 0, max)
        let maximum = reduce(scores, 0, max)
        let winner = reduce(scores, 0, argmax)
        let mut status = i32(0)
        if maximum == -inf:
            status = 1
        if bad != 0:
            status = 2
        let mut token = i32(-1)
        if status == 0:
            token = winner
        result[rows, 0] = token
        result[rows, 1] = status
