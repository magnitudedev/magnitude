# V3 selection semantics: Philox4x32-10 counters are token, output position,
# and draw domain; the request seed is the key. Partitioning never changes a draw:
# the token counter is the semantic vocabulary coordinate, never a slice-local offset.
# Output pairs are (token, status): 0 success, 1 empty, 2 nonfinite source.
export fn sample_rows[M, V](logits: tensor[M, V] f32, mask: tensor[M, (V + 31) / 32] u32,
    draws: tensor[M, 6] u32, out out: tensor[M, 2] i32):
    parallel [rows] in 0..M:
        for row in rows:
            var scores = tile[V] f32
            var invalid = tile[V] i32
            for token in owned(invalid):
                let value = logits[row, token]
                invalid[token] = 0
                if value != value or value == inf:
                    invalid[token] = 1
            for token in owned(scores):
                var value = logits[row, token]
                scores[token] = -inf
                if ((mask[row, token / 32] >> u32(token % 32)) & 1) != 0 and value > -inf and value < inf:
                    if draws[row, 0] == 1:
                        var c0 = u32(token)
                        var c1 = draws[row, 3]
                        var c2 = draws[row, 4]
                        var c3 = draws[row, 5]
                        var k0 = draws[row, 1]
                        var k1 = draws[row, 2]
                        for round in 0..10:
                            let a0 = u32(3528531795)
                            let a1 = u32(3449720151)
                            let p00 = (a0 & 65535) * (c0 & 65535)
                            let p01 = (a0 >> 16) * (c0 & 65535)
                            let p02 = (a0 & 65535) * (c0 >> 16)
                            let p03 = (a0 >> 16) * (c0 >> 16)
                            let middle0 = (p00 >> 16) + (p01 & 65535) + (p02 & 65535)
                            let hi0 = p03 + (p01 >> 16) + (p02 >> 16) + (middle0 >> 16)
                            let lo0 = (middle0 << 16) | (p00 & 65535)
                            let p10 = (a1 & 65535) * (c2 & 65535)
                            let p11 = (a1 >> 16) * (c2 & 65535)
                            let p12 = (a1 & 65535) * (c2 >> 16)
                            let p13 = (a1 >> 16) * (c2 >> 16)
                            let middle1 = (p10 >> 16) + (p11 & 65535) + (p12 & 65535)
                            let hi1 = p13 + (p11 >> 16) + (p12 >> 16) + (middle1 >> 16)
                            let lo1 = (middle1 << 16) | (p10 & 65535)
                            let next0 = hi1 ^ c1 ^ k0
                            let next2 = hi0 ^ c3 ^ k1
                            c0 = next0
                            c1 = lo1
                            c2 = next2
                            c3 = lo0
                            k0 = k0 + u32(2654435769)
                            k1 = k1 + u32(3144134277)
                        let uniform = (f32(c0 >> 9) + 0.5) * 0.00000011920928955078125
                        value = value - log(-log(uniform))
                    scores[token] = value
            let bad = reduce(invalid, 0, max)
            let maximum = reduce(scores, 0, max)
            let winner = reduce(scores, 0, argmax)
            var result = tile[2] i32
            for i in owned(result):
                var status = i32(0)
                if maximum == -inf:
                    status = 1
                if bad != 0:
                    status = 2
                result[i] = status
                if i == 0:
                    result[i] = -1
                    if status == 0:
                        result[i] = winner
            publish result to out[row]

lower sample_rows for metal = portable
lower sample_rows for cpu = portable
lower sample_rows for cuda = portable
