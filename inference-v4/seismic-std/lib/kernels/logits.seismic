# One activation row against a packed readout matrix, kept in f32 for sampling.
fn logits[N, K](x: &tensor[1, K] bf16, w: &tensor[N, K] q4g64, result: &mut tensor[1, N] f32):
    parallel for cols in 0..N:
        let mut acc = f32(0.0)
        for k in 0..K:
            acc = fma(f32(x[0, k]), f32(w[cols, k]), acc)
        result[0, cols] = acc
