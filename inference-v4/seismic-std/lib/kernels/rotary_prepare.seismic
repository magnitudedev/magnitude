# V3 Qwen attention preparation, including interleaved temporal/height/width
# rotary coordinates. Projection output is interleaved [head][query,gate][width].
# Normalization and rotation compute in F32 and publish compact query/key tensors.
# Shared tile equation; ordinary function composition, no new realization choice.
fn norm_rotary[P, S, SH, SW](x: tile[2 * P + S] A, wt: tile[2 * P + S] f32,
    coordinates: tile[4] i32, base: f32, epsilon: f32) -> tile[2 * P + S] f32:
    let xf = f32(x)
    let ss = sum_any_order(xf * xf)
    let inv = rsqrt(ss / f32(2 * P + S) + epsilon)
    let normalized = xf * inv * wt
    let mut rotated = tile[2 * P + S] f32
    for i in owned(rotated):
        if i < 2 * P:
            let pair = i % P
            let mut component = i32(0)
            if pair % 3 == 1 and pair < SH * 3:
                component = 1
            if pair % 3 == 2 and pair < SW * 3:
                component = 2
            let angle = f32(coordinates[component]) * exp(-log(base) * f32(2 * pair) / f32(2 * P))
            if i < P:
                rotated[i] = normalized[i] * cos(angle) - normalized[i + P] * sin(angle)
            else:
                rotated[i] = normalized[i] * cos(angle) + normalized[i - P] * sin(angle)
        else:
            rotated[i] = normalized[i]
    return rotated

fn rotary_prepare[Q, H, KV, P, S, SH, SW](query_gate: tensor[Q, H * 2 * (2 * P + S)] A,
    key: tensor[Q, KV * (2 * P + S)] A, query_norm: tensor[2 * P + S] f32, key_norm: tensor[2 * P + S] f32,
    coordinates: tensor[Q, 4] i32, out query: tensor[Q, H, 2 * P + S] A,
    out prepared_key: tensor[Q, KV, 2 * P + S] A, out gate: tensor[Q, H * (2 * P + S)] A,
    base: f32, epsilon: f32):
    parallel [rows, heads] in (0..Q, 0..H):
        let wt = load(query_norm)
        for row in rows:
            let coords = load(coordinates[row])
            for head in heads:
                let x = load(query_gate[row, head * 2 * (2 * P + S) : head * 2 * (2 * P + S) + (2 * P + S)])
                let rotated = norm_rotary[P = P, S = S, SH = SH, SW = SW](x, wt, coords, base, epsilon)
                publish rotated to query[row, head]
                publish load(query_gate[row, head * 2 * (2 * P + S) + (2 * P + S) : (head + 1) * 2 * (2 * P + S)]) to gate[row, head * (2 * P + S) : (head + 1) * (2 * P + S)]
    parallel [rows, heads] in (0..Q, 0..KV):
        let wt = load(key_norm)
        for row in rows:
            let coords = load(coordinates[row])
            for head in heads:
                let x = load(key[row, head * (2 * P + S) : (head + 1) * (2 * P + S)])
                let rotated = norm_rotary[P = P, S = S, SH = SH, SW = SW](x, wt, coords, base, epsilon)
                publish rotated to prepared_key[row, head]
