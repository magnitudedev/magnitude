# V3 Qwen attention preparation, including interleaved temporal/height/width
# rotary coordinates. Projection output is interleaved [head][query,gate][width].
# Normalization and rotation compute in F32 and write compact query/key tensors.
# Shared tensor equation; ordinary function composition, no new realization choice.
fn norm_rotary[P, S, SH, SW](x: &tensor[2 * P + S] A, wt: &tensor[2 * P + S] f32,
    coordinates: &tensor[4] i32, base: f32, epsilon: f32) -> tensor[2 * P + S] f32:
    let xf = f32(x)
    let ss = sum_any_order(to_owned(xf * xf))
    let inv = rsqrt(ss / f32(2 * P + S) + epsilon)
    let normalized = xf * inv * f32(wt)
    let mut rotated = zeros_like(x, dtype=f32)
    for i in 0..2 * P + S:
        if i < 2 * P:
            let pair = i % P
            let mut component = i32(0)
            if pair % 3 == 1 and pair < SH * 3:
                component = 1
            if pair % 3 == 2 and pair < SW * 3:
                component = 2
            let angle = f32(coordinates[component]) * exp(-log(base) * f32(2 * pair) / f32(2 * P))
            if i < P:
                rotated[i] = normalized[i] * cos(angle) - normalized[i + P] * sin(angle)
            else:
                rotated[i] = normalized[i] * cos(angle) + normalized[i - P] * sin(angle)
        else:
            rotated[i] = normalized[i]
    return rotated

fn rotary_prepare[Q, H, KV, P, S, SH, SW](query_gate: &tensor[Q, H * 2 * (2 * P + S)] A,
    key: &tensor[Q, KV * (2 * P + S)] A, query_norm: &tensor[2 * P + S] f32, key_norm: &tensor[2 * P + S] f32,
    coordinates: &tensor[Q, 4] i32, query: &mut tensor[Q, H, 2 * P + S] A,
    prepared_key: &mut tensor[Q, KV, 2 * P + S] A, gate: &mut tensor[Q, H * (2 * P + S)] A,
    base: f32, epsilon: f32):
    parallel for rows in 0..Q:
        parallel for heads in 0..H:
            let wt = load(query_norm)
            let coords = load(coordinates[rows])
            let x = load(query_gate[rows, heads * 2 * (2 * P + S) : heads * 2 * (2 * P + S) + (2 * P + S)])
            let rotated = norm_rotary[P = P, S = S, SH = SH, SW = SW](x, wt, coords, base, epsilon)
            query[rows, heads] = rotated
            gate[rows, heads * (2 * P + S) : (heads + 1) * (2 * P + S)] = load(query_gate[rows, heads * 2 * (2 * P + S) + (2 * P + S) : (heads + 1) * 2 * (2 * P + S)])
    parallel for rows in 0..Q:
        parallel for heads in 0..KV:
            let wt = load(key_norm)
            let coords = load(coordinates[rows])
            let x = load(key[rows, heads * (2 * P + S) : (heads + 1) * (2 * P + S)])
            let rotated = norm_rotary[P = P, S = S, SH = SH, SW = SW](x, wt, coords, base, epsilon)
            prepared_key[rows, heads] = rotated
