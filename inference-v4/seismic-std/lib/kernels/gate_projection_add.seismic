# The attention output gate folded into the output projection: one row x * sigmoid(gate)
# against a packed weight matrix, added to a residual row.
fn gate_projection_add[N, K](x: &tensor[1, K] bf16, gate: &tensor[1, K] bf16, w: &tensor[N, K] q4g64, residual: &tensor[1, N] bf16, result: &mut tensor[1, N] bf16):
    parallel for cols in 0..N:
        let mut acc = f32(0.0)
        for k in 0..K:
            let a = f32(x[0, k]) / (1.0 + exp(-f32(gate[0, k])))
            acc = fma(a, f32(w[cols, k]), acc)
        result[0, cols] = acc + f32(residual[0, cols])
