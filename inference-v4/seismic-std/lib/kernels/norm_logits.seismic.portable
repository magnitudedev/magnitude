# The final norm folded into the readout: one activation row, RMS-normalized on the fly,
# against the packed readout matrix, kept in f32 for sampling.
export fn norm_logits[N, K](x: tensor[1, K] bf16, nw: tensor[1, K] bf16, w: tensor[N, K] q4g64, eps: f32, out out: tensor[1, N] f32):
    parallel [cols] in 0..N:
        var acc = zeros_like(out[:, cols], dtype=f32)
        let xf = f32(x[0])
        let ss = reduce(xf * xf, 0, sum)
        ordered [k] in 0..K:
            let a = f32(x[:, k]) * f32(nw[:, k])
            matmul(a, load(w[cols, k]), into=acc)
        publish acc * rsqrt(ss / f32(K) + eps) to out[:, cols]

lower norm_logits for metal = portable
lower norm_logits for cpu = portable
lower norm_logits for cuda = portable
