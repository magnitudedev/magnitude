# SwiGLU gate and up projections of one activation row over packed weights, sharing the
# activation value: out = silu(x·gate) * (x·up). One input traversal feeds both F32
# accumulators; the activation window is loaded once per visit.
export fn gated_projection[N, K](x: tensor[1, K] bf16, gate: tensor[N, K] q4g64, up: tensor[N, K] q4g64, out out: tensor[1, N] bf16):
    parallel [cols] in 0..N:
        var g = zeros_like(out[:, cols], dtype=f32)
        var u = zeros_like(out[:, cols], dtype=f32)
        ordered [k] in 0..K:
            let xt = load(x[:, k])
            matmul(xt, load(gate[cols, k]), into=g)
            matmul(xt, load(up[cols, k]), into=u)
        publish g / (1.0 + exp(-g)) * u to out[:, cols]

lower gated_projection for metal = portable
lower gated_projection for cpu = portable
lower gated_projection for cuda = portable
