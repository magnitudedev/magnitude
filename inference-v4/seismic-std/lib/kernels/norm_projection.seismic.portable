# One activation row, RMS-normalized on the fly, against a packed weight matrix: the norm
# weight scales the activation, and the row's inverse RMS scales the result. The row
# statistic is authored inside the output scope, so it is produced once per output owner.
export fn norm_projection[N, K](x: tensor[1, K] bf16, nw: tensor[1, K] bf16, w: tensor[N, K] q4g64, eps: f32, out out: tensor[1, N] bf16):
    parallel [cols] in 0..N:
        var acc = zeros_like(out[:, cols], dtype=f32)
        let xf = f32(x[0])
        let ss = reduce(xf * xf, 0, sum)
        ordered [k] in 0..K:
            let a = f32(x[:, k]) * f32(nw[:, k])
            matmul(a, load(w[cols, k]), into=acc)
        publish acc * rsqrt(ss / f32(K) + eps) to out[:, cols]

lower norm_projection for metal = portable
lower norm_projection for cpu = portable
lower norm_projection for cuda = portable
