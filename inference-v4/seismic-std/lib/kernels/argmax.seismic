# Index of the largest value of a row, in two phases: block winners, then the winner of
# winners. Ties go to the smaller index. The winner pass reads what the block pass
# published, so `values` and `indices` are both written and read.
fn argmax_row[V, B](x: &tensor[1, V] f32, values: &mut tensor[V / B] f32, indices: &mut tensor[V / B] i32, result: &mut tensor[1] i32):
    parallel for blocks in 0..(V / B):
        let t = load(x[0, blocks * B : (blocks + 1) * B])
        let best = reduce(t, 0, argmax)
        let mut val = tensor[1] f32
        let mut idx = tensor[1] i32
        for i in 0..1:
            val[i] = t[best]
        for i in 0..1:
            idx[i] = best + blocks * B
        values[blocks : blocks + 1] = val
        indices[blocks : blocks + 1] = idx

    parallel for ones in 0..1:
        let vs = load(values)
        let ids = load(indices)
        let w = reduce(vs, 0, argmax)
        let mut r = tensor[1] i32
        for i in 0..1:
            r[i] = ids[w]
        result[ones : ones + 1] = r
