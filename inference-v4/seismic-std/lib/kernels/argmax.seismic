# Index of the largest value of a row, in two phases: block winners, then the winner of
# winners. Ties go to the smaller index. The winner stage reads what the block stage
# published, so `values` and `indices` are both written and read.
fn argmax_row[V, B](x: tensor[1, V] f32, inout values: tensor[V / B] f32, inout indices: tensor[V / B] i32, out out: tensor[1] i32):
    stage block_winners:
        parallel [blocks] in 0..(V / B):
            for b in blocks:
                let t = load(x[0, b * B : (b + 1) * B])
                let best = reduce(t, 0, argmax)
                let mut val = tile[1] f32
                let mut idx = tile[1] i32
                for i in owned(val):
                    val[i] = t[best]
                for i in owned(idx):
                    idx[i] = best + b * B
                publish val to values[b : b + 1]
                publish idx to indices[b : b + 1]

    stage winner:
        parallel [ones] in 0..1:
            for one in ones:
                let vs = load(values)
                let ids = load(indices)
                let w = reduce(vs, 0, argmax)
                let mut r = tile[1] i32
                for i in owned(r):
                    r[i] = ids[w]
                publish r to out[one : one + 1]
