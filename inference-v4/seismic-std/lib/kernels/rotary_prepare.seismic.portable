# V3 Qwen attention preparation, including interleaved temporal/height/width
# rotary coordinates. Projection output is interleaved [head][query,gate][width].
# Normalization and rotation compute in F32 and publish compact query/key tensors.
# Shared tile equation; ordinary function composition, no new realization choice.
fn norm_rotary[P, S, SH, SW](x: tile[2 * P + S] A, wt: tile[2 * P + S] f32,
    coordinates: tile[4] i32, rotated: tile[2 * P + S] f32, base: f32, epsilon: f32):
  squares = tile[2 * P + S] f32
  for i in owned(squares): squares[i] = f32(x[i]) * f32(x[i])
  sum = reduce(squares, 0, sum)
  inv = rsqrt(sum / f32(2 * P + S) + epsilon)
  normalized = tile[2 * P + S] f32
  for i in owned(normalized): normalized[i] = f32(x[i]) * inv * wt[i]
  for i in owned(rotated):
    if i < 2 * P:
      pair = i % (P)
      axis = 0
      if pair % 3 == 1 and pair < SH * 3: axis = 1
      if pair % 3 == 2 and pair < SW * 3: axis = 2
      angle = f32(coordinates[axis]) * exp(-log(base) * f32(2 * pair) / f32(2 * P))
      if i < P:
        rotated[i] = normalized[i] * cos(angle) - normalized[i + P] * sin(angle)
      else:
        rotated[i] = normalized[i] * cos(angle) + normalized[i - P] * sin(angle)
    else:
      rotated[i] = normalized[i]

fn rotary_prepare[Q, H, KV, P, S, SH, SW](query_gate: tensor[Q, H * 2 * (2 * P + S)] A,
    key: tensor[Q, KV * (2 * P + S)] A, query_norm: tensor[2 * P + S] f32, key_norm: tensor[2 * P + S] f32,
    coordinates: tensor[Q, 4] i32, query: tensor[Q, H, 2 * P + S] A,
    prepared_key: tensor[Q, KV, 2 * P + S] A, gate: tensor[Q, H * (2 * P + S)] A,
    base: f32, epsilon: f32):
  for row, head in parallel:
    x = load(query_gate[row, head * 2 * (2 * P + S):head * 2 * (2 * P + S) + (2 * P + S)])
    wt = load(query_norm)
    coords = load(coordinates[row])
    rotated = tile[2 * P + S] f32
    norm_rotary[P = P, S = S, SH = SH, SW = SW](x, wt, coords, rotated, base, epsilon)
    store(rotated, query[row, head])
    raw_gate = load(query_gate[row, head * 2 * (2 * P + S) + (2 * P + S):(head + 1) * 2 * (2 * P + S)])
    store(raw_gate, gate[row, head * (2 * P + S):(head + 1) * (2 * P + S)])
  for row, head in parallel:
    x = load(key[row, head * (2 * P + S):(head + 1) * (2 * P + S)])
    wt = load(key_norm)
    coords = load(coordinates[row])
    rotated = tile[2 * P + S] f32
    norm_rotary[P = P, S = S, SH = SH, SW = SW](x, wt, coords, rotated, base, epsilon)
    store(rotated, prepared_key[row, head])
