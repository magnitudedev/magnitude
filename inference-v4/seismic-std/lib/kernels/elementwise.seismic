# Explicit publication operations. Compositions retain separate calls wherever the
# model equations require intermediate rounding. Owners span rows and columns: the work is
# pointwise, so a single row still divides into independent column slices.
fn silu[M, N](x: &tensor[M, N] T, result: &mut tensor[M, N] U):
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            let a = f32(x[rows, cols])
            result[rows, cols] = a / (1.0 + exp(-a))

fn multiply[M, N](x: &tensor[M, N] T, y: &tensor[M, N] U, result: &mut tensor[M, N] V):
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            result[rows, cols] = f32(x[rows, cols]) * f32(y[rows, cols])

fn add[M, N](x: &tensor[M, N] T, y: &tensor[M, N] U, result: &mut tensor[M, N] V):
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            result[rows, cols] = f32(x[rows, cols]) + f32(y[rows, cols])

fn sigmoid[M, N](x: &tensor[M, N] T, result: &mut tensor[M, N] U):
    parallel for rows in 0..M:
        parallel for cols in 0..N:
            result[rows, cols] = 1.0 / (1.0 + exp(-f32(x[rows, cols])))

# Tanh-form GELU used by Qwen vision blocks. The sigmoid identity avoids a
# separate tanh helper: tanh(z) = 2 / (1 + exp(-2*z)) - 1. Merger erf-GELU is a
# different operation and must not use this entry.
fn gelu_tanh[M, N](x: &tensor[M, N] T, result: &mut tensor[M, N] U):
    parallel for rows in 0..M:
        let value = f32(x[rows])
        let argument = 0.7978845608028654 * (value + 0.044715 * value * value * value)
        let hyperbolic = 2.0 / (1.0 + exp(-2.0 * argument)) - 1.0
        result[rows] = 0.5 * value * (1.0 + hyperbolic)
