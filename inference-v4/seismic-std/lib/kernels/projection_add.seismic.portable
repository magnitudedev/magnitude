# One activation row against a packed weight matrix, added to a residual row.
export fn projection_add[N, K](x: tensor[1, K] bf16, w: tensor[N, K] q4g64, residual: tensor[1, N] bf16, out out: tensor[1, N] bf16):
    parallel [cols] in 0..N:
        var acc = zeros_like(out[:, cols], dtype=f32)
        ordered [k] in 0..K:
            matmul(load(x[:, k]), load(w[cols, k]), into=acc)
        publish acc + f32(residual[:, cols]) to out[:, cols]

lower projection_add for metal = portable
lower projection_add for cpu = portable
lower projection_add for cuda = portable
