# Full-attention preparation for one row at position `pos`: each query and key head of
# width R + S is RMS-normalized with its weight, its first R channels rotated (half split,
# angle pos * theta^(-2i/R)), the key and value appended to the history, and the output
# gate split off. The projection interleaves query and gate per head: [head][2][R + S].
# Only history row `pos` is written, so `k` and `v` are `inout`.
fn attention_prepare[H, G, R, S, T](qg: tensor[1, H * 2 * (R + S)] bf16, kin: tensor[1, G * (R + S)] bf16, vin: tensor[1, G * (R + S)] bf16,
                                           qw: tensor[R + S] bf16, kw: tensor[R + S] bf16, pos: index[T], theta: f32, eps: f32,
                                           out q: tensor[1, H, R + S] bf16, out gate: tensor[1, H * (R + S)] bf16,
                                           inout k: tensor[T, G, R + S] bf16, inout v: tensor[T, G, R + S] bf16):
    parallel [heads] in 0..H:
        let wt = f32(qw)
        for h in heads:
            let x = f32(qg[0, h * 2 * (R + S) : h * 2 * (R + S) + (R + S)])
            let ss = reduce(x * x, 0, sum)
            let inv = rsqrt(ss / f32(R + S) + eps)
            let n = x * inv * wt
            let mut y = tile[R + S] f32
            for i in owned(y):
                if i < R / 2:
                    let angle = f32(pos) * exp(-log(theta) * f32(2 * i) / f32(R))
                    y[i] = n[i] * cos(angle) - n[i + R / 2] * sin(angle)
                else:
                    if i < R:
                        let angle = f32(pos) * exp(-log(theta) * f32(2 * (i - R / 2)) / f32(R))
                        y[i] = n[i] * cos(angle) + n[i - R / 2] * sin(angle)
                    else:
                        y[i] = n[i]
            publish y to q[0, h]
            publish f32(qg[0, h * 2 * (R + S) + (R + S) : (h + 1) * 2 * (R + S)]) to gate[0, h * (R + S) : (h + 1) * (R + S)]
    parallel [groups] in 0..G:
        let wt = f32(kw)
        for g in groups:
            let x = f32(kin[0, g * (R + S) : (g + 1) * (R + S)])
            let ss = reduce(x * x, 0, sum)
            let inv = rsqrt(ss / f32(R + S) + eps)
            let n = x * inv * wt
            let mut y = tile[R + S] f32
            for i in owned(y):
                if i < R / 2:
                    let angle = f32(pos) * exp(-log(theta) * f32(2 * i) / f32(R))
                    y[i] = n[i] * cos(angle) - n[i + R / 2] * sin(angle)
                else:
                    if i < R:
                        let angle = f32(pos) * exp(-log(theta) * f32(2 * (i - R / 2)) / f32(R))
                        y[i] = n[i] * cos(angle) + n[i - R / 2] * sin(angle)
                    else:
                        y[i] = n[i]
            publish y to k[pos, g]
            publish f32(vin[0, g * (R + S) : (g + 1) * (R + S)]) to v[pos, g]
