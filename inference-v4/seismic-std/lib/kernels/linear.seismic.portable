# Batched row-major linear projection: y = x . transpose(weight), accumulated in F32 for
# every output; publication rounds to the output type. The family's numerical contract is
# admitted: the first body is the ordered F32 FMA chain over K (`matmul`); the second
# contracts the whole K extent under `matmul_any_order`, whose association is unspecified.
export admit fn linear[M, N, K](x: tensor[M, K] T, weight: tensor[N, K] U, out y: tensor[M, N] V):
    parallel [rows, cols] in (0..M, 0..N):
        var acc = zeros_like(y[rows, cols], dtype=f32)
        ordered [k] in 0..K:
            matmul(load(x[rows, k]), load(weight[cols, k]), into=acc)
        publish acc to y[rows, cols]

export admit fn linear[M, N, K](x: tensor[M, K] T, weight: tensor[N, K] U, out y: tensor[M, N] V):
    parallel [rows, cols] in (0..M, 0..N):
        var acc = zeros_like(y[rows, cols], dtype=f32)
        matmul_any_order(load(x[rows]), load(weight[cols]), into=acc)
        publish acc to y[rows, cols]

lower linear for metal = portable
lower linear for cpu = portable
lower linear for cuda = portable

# into[i, j] += sum over k of a[i, k] * b[j, k], accumulated in F32, under an admitted
# contract that is distinct from `matmul`: the association of the sum is unspecified, and the
# affine decode of a packed operand may be distributed over it (for one coefficient group,
# sum x * (q * scale + bias) = scale * sum(x * q) + bias * sum(x)). Every operand value is
# consumed at its declared precision. The reference body is the ascending F32 sum of
# products. Callers opt in by calling this contract instead of `matmul`; it is not a
# windowed chain, so a caller passes the whole contraction extent. Its Metal lowerings are
# beside those of `matmul` (constructs/matmul.seismic.metal).
admit fn matmul_any_order[M, N, K](a: tile[M, K] T, b: tile[N, K] U, inout into: tile[M, N] f32):
    for i, j in owned(into):
        var s = f32(0.0)
        for k in axis(a, 1):
            s = s + f32(a[i, k]) * f32(b[j, k])
        into[i, j] = into[i, j] + s
