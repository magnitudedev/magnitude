# Engine entries (`engine/model-kernels/kernels`) through the public API (design A9 §2.9.1,
# Tier 0; lines owned by A9). Every exported engine entry that is not also a std entry has
# at least one line. Shapes are small but non-degenerate; arguments follow parameter order
# and dimensions are inferred from shapes. Generic elements bind dense float representations
# (L11); `copy_rows` also moves an integer plane, which its slice store copies bit for bit.
# Where an entry has a native with a static shape condition (k8v4 attention: W in {32, 64,
# 128, 256}; recurrent step/chunk: W % 32 == 0), its line meets it so the native is admissible.

# attention.seismic: M = 2, T = 4, KV = 1, G = 2, P = 1, S = 2 (W = 2P + S = 4), R = 1. Both rows
# see history rows [0, 2); row 0's fresh span is batch row 0, row 1's rows 0..2; destinations
# are rows no row sees (-1 appends nothing).
norm_rotary_table[A=f32]: f32[4]=rand(300) ; f32[4]=rand(301) ; i32[4]=1,2,3,0 ; i32[1]=2 ; f32[1]=0.5 ; f32:0.000001
gated_attention[A=f32]: f32[2,16]=rand(302) ; f32[2,4]=rand(303) ; f32[2,4]=rand(304) ; f32[4]=rand(305) ; f32[4]=rand(306) ; i32[1]=1 ; f32[1]=0.5 ; i32[2,4]=0,0,0,0,1,1,2,0 ; i32[2,1,2]=0,2,0,2 ; i32[2,2]=0,1,0,2 ; i32[2]=2,3 ; f32[4,1,4]=rand(307) ; f32[4,1,4]=rand(308) ; f32:0.000001 ; f32:0.5
gated_attention_decode[A=f32]: f32[2,16]=rand(309) ; f32[2,4]=rand(310) ; f32[2,4]=rand(311) ; f32[4]=rand(312) ; f32[4]=rand(313) ; i32[1]=1 ; f32[1]=0.5 ; i32[2,4]=0,0,0,0,1,1,2,0 ; i32[2,1,2]=0,2,0,2 ; i32[2,2]=0,1,0,2 ; i32[2]=3,-1 ; f32[4,1,4]=rand(314) ; f32[4,1,4]=rand(315) ; f32:0.000001 ; f32:0.5
gated_attention_prefill[A=f32]: f32[2,16]=rand(316) ; f32[2,4]=rand(317) ; f32[2,4]=rand(318) ; f32[4]=rand(319) ; f32[4]=rand(320) ; i32[1]=1 ; f32[1]=0.5 ; i32[2,4]=0,0,0,0,1,1,2,0 ; i32[2,1,2]=0,2,0,2 ; i32[2,2]=0,1,0,2 ; i32[2]=2,3 ; f32[4,1,4]=rand(321) ; f32[4,1,4]=rand(322) ; f32:0.000001 ; f32:0.5
# Affine K8/V4 codec: W = 8 with 8-bit codes (N = 2 words) and 4-bit codes (N = 1 word).
affine_encode: f32[8]=rand(323) ; u32[2]=zero ; f16[2]=zero
affine_encode: f32[8]=rand(324) ; u32[1]=zero ; f16[2]=zero
