affine_decode: u32[1]=bits(326) ; f16[2]=0.125,-1 ; f32[8]=zero
# One absorbed key/value over G = 2 heads, W = 4, from a running softmax state.
attention_absorb[A=f32]: f32[2,4]=rand(327) ; f32[4]=rand(328) ; f32[4]=rand(329) ; f32[2]=0.5,-0.25 ; f32[2]=1.5,2 ; f32[2,4]=rand(330) ; f32:0.5
