# Standard-library entries through the public API (design A10 §2.8; lines owned by A10).
# Every exported std entry has at least one line. Shapes are small but non-degenerate:
# every free dimension is at least 2, and every packed operand holds at least one packet
# (q4g64: 64 values; q4g32, q8g32, q8g32s: 32; q4k, q5k, q6k, iq4g32: 256; nvfp4: 16) along
# its packed last axis. Arguments follow parameter order; dimensions are inferred from shapes.

# argmax.seismic: V = 8; the second line ties at 1 and 2 (the smaller index wins).
argmax_row: f32[1,8]=rand(1) ; i32[1]=zero
argmax_row: f32[1,4]=1,3,3,2 ; i32[1]=zero

# attention.seismic
# attention_update: M = 2, K = 3, W = 4. The first line is a fresh carry (m = -inf, l = 0).
attention_update[A=f32]: f32[2,4]=rand(10) ; f32[3,4]=rand(11) ; f32[3,4]=rand(12) ; f32[2]=-inf,-inf ; f32[2]=zero ; f32[2,4]=zero ; f32:0.5
attention_update[A=bf16]: bf16[2,4]=rand(13) ; bf16[3,4]=rand(14) ; bf16[3,4]=rand(15) ; f32[2]=rand(16) ; f32[2]=1,2 ; f32[2,4]=rand(17) ; f32:0.5
# attention: Q = 2, T = 4, H = 4, KV = 2, W = 4. The second line has an empty window on row 1.
attention[A=f32]: f32[2,4,4]=rand(20) ; f32[4,2,4]=rand(21) ; f32[4,2,4]=rand(22) ; i32[2,2]=0,3,1,4 ; f32[2,4,4]=zero ; f32:0.5
attention[A=bf16]: bf16[2,4,4]=rand(23) ; bf16[4,2,4]=rand(24) ; bf16[4,2,4]=rand(25) ; i32[2,2]=0,4,2,2 ; bf16[2,4,4]=zero ; f32:0.5
# attention_append: M = 2, T = 4, KV = 2, G = 2, W = 4, R = 2. Each line has an empty span.
attention_append[A=f32]: f32[2,4,4]=rand(30) ; f32[4,2,4]=rand(31) ; f32[4,2,4]=rand(32) ; f32[2,2,4]=rand(33) ; f32[2,2,4]=rand(34) ; i32[2,2,2]=0,2,2,3,0,4,3,3 ; f32[2,4,4]=zero ; f32:0.5
attention_append[A=bf16]: bf16[2,4,4]=rand(35) ; bf16[4,2,4]=rand(36) ; bf16[4,2,4]=rand(37) ; bf16[2,2,4]=rand(38) ; bf16[2,2,4]=rand(39) ; i32[2,2,2]=0,1,1,4,2,2,0,4 ; bf16[2,4,4]=zero ; f32:0.5

# attention_gate.seismic: H = 2, W = 4.
attention_gate: bf16[1,2,4]=rand(40) ; bf16[1,8]=rand(41) ; bf16[1,8]=zero

# delta_step.seismic: NK = 2, GV = 2 (NK * GV = 4, 2 * NK + NK * GV = 8), W = 4; both head mappings.
delta_steps[A=f32]: f32[2,8,4]=rand(50) ; f32[2,4]=rand(51) ; f32[2,4]=rand(52) ; f32[4,4,4]=rand(53) ; f32[4,4,4]=zero ; f32[2,4,4]=zero ; bool:true
delta_steps[A=bf16]: bf16[2,8,4]=rand(54) ; bf16[2,4]=rand(55) ; f32[2,4]=rand(56) ; f32[4,4,4]=rand(57) ; f32[4,4,4]=zero ; bf16[2,4,4]=zero ; bool:false
delta_step[A=f32]: f32[8,4]=rand(58) ; f32[4]=rand(59) ; f32[4]=rand(60) ; f32[4,4,4]=rand(61) ; f32[4,4,4]=zero ; f32[4,4]=zero ; bool:false
