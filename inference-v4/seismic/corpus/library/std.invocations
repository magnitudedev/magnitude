# recurrent_prepare.seismic: NK = 2, NV = 2 (2 * NK + NV = 6), W = 4 (channels 24), C = 4.
# M = 2 < C - 1 reads the carried window in every row; M = 5 >= C - 1 also publishes a window
# taken wholly from this call's rows.
recurrent_prepare_rows[A=bf16,CW=bf16]: bf16[2,24]=rand(260) ; bf16[24,4]=rand(261) ; bf16[3,24]=rand(262) ; bf16[3,24]=zero ; bf16[2,2]=rand(263) ; bf16[2,2]=rand(264) ; f32[2]=-0.5,-1 ; f32[2]=rand(265) ; f32:0.000001 ; bf16[2,6,4]=zero ; bf16[2,2]=zero ; f32[2,2]=zero
recurrent_prepare_rows[A=f32,CW=f32]: f32[5,24]=rand(266) ; f32[24,4]=rand(267) ; f32[3,24]=rand(268) ; f32[3,24]=zero ; f32[5,2]=rand(269) ; f32[5,2]=rand(270) ; f32[2]=-0.5,-1 ; f32[2]=rand(271) ; f32:0.000001 ; f32[5,6,4]=zero ; f32[5,2]=zero ; f32[5,2]=zero
recurrent_prepare[A=bf16,CW=f32]: bf16[1,24]=rand(272) ; f32[24,4]=rand(273) ; bf16[3,24]=rand(274) ; bf16[3,24]=zero ; bf16[1,2]=rand(275) ; bf16[1,2]=rand(276) ; f32[2]=-0.5,-1 ; f32[2]=rand(277) ; f32:0.000001 ; bf16[6,4]=zero ; bf16[2]=zero ; f32[2]=zero

