gated_norm: bf16[2,8]=rand(110) ; bf16[8]=rand(111) ; bf16[1,16]=rand(112) ; f32:0.000001 ; bf16[1,16]=zero

# gated_projection.seismic: N = 4, K = 128.
gated_projection: bf16[1,128]=rand(120) ; q4g64[4,128]=rand(121) ; q4g64[4,128]=rand(122) ; bf16[1,4]=zero

# gelu.seismic. erf_values: the second line reaches every piece (tiny, |x| < 0.84375,
# < 1.25, < 2.857, < 6, saturation), signed zero, NaN and infinities; the third covers bit patterns.
erf_values: f32[16]=rand(130)
erf_values: f32[16]=0,-0,0.000000001,0.5,-0.84375,1,1.25,-2.5,2.857142925262451,3,5.99,6,-7,nan,inf,-inf
erf_values: f32[64]=bits(131)
gelu[T=f32,U=f32]: f32[2,8]=rand(132) ; f32[2,8]=zero
gelu[T=bf16,U=bf16]: bf16[2,8]=rand(133) ; bf16[2,8]=zero

