# sampling.seismic: M = 2. V = 40 (mask words (V + 31) / 32 = 2): row 0 sampled with
# Philox draws, row 1 greedy; then a masked-out row (status 1) beside a partial mask;
# then an unconstrained row whose all-zero mask is ignored beside a constrained row.
# V = 2: a non-finite row (status 2) beside a row whose -inf token is excluded.
sample_rows: f32[2,40]=rand(310) ; u32[2,2]=0xffffffff,0xff,0xffffffff,0xff ; i32[2]=1,1 ; u32[2,6]=1,7,11,0,3,0,0,0,0,0,0,0 ; i32[2,2]=zero
sample_rows: f32[2,40]=rand(311) ; u32[2,2]=0,0,0x0f0f0f0f,0x0f ; i32[2]=1,1 ; u32[2,6]=1,5,6,4,1,2,1,9,8,4,0,1 ; i32[2,2]=zero
sample_rows: f32[2,40]=rand(312) ; u32[2,2]=0,0,0x0f0f0f0f,0x0f ; i32[2]=0,1 ; u32[2,6]=1,5,6,4,1,2,1,9,8,4,0,1 ; i32[2,2]=zero
sample_rows: f32[2,2]=nan,1,0.5,-inf ; u32[2,1]=3,3 ; i32[2]=1,1 ; u32[2,6]=zero ; i32[2,2]=zero

