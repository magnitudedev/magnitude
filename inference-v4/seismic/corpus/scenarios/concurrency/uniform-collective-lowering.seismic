# origin: C17:simd_backend_fn_uniform C17:lane_uniform
# invoke lane_uniform: f32[64]=rand(67) ; f32[64]=zero
# invoke lane_uniform: f32[40]=rand(67) ; f32[40]=zero
fn lane_uniform[N](x: &tensor[N] f32, out: &mut tensor[N] f32):
    parallel for i in 0..N:
        out[i] = x[i]

lower lane_uniform[N](x: &tensor[N] f32, out: &mut tensor[N] f32) for metal requires metal.subgroup:
    parallel for i in 0..N:
        out[i] = metal.subgroup.simd_max(x[i])
