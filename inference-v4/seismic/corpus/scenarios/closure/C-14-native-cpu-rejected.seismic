# origin: X2:R6-X2-3 X3:R6-X3-5 X5:R6-X5-4
# rejected: "backend `cpu` has no direct native route"
fn probe[N](x: &tensor[N] f32, factor: f32, out: &mut tensor[N] f32):
    # A native declaration exists only for a backend with a direct native
    # route (Metal). This checked-module invariant makes the runtime's
    # non-Metal native-prepare arm unreachable once A9-L9.7a checks the
    # declaration on the typed path (I-96, closure C-14).
    parallel for i in 0..N:
        out[i] = x[i] * factor

native probe for cpu from "probe.c":
    threadgroups (ceil_div(N, 256), 1, 1)
    threads_per_threadgroup (256, 1, 1)
