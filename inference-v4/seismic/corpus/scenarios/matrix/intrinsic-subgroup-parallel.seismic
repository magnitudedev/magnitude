# cell: intrinsic-subgroup/parallel
# backends: metal
# invoke: f32[64]=rand(176) ; f32[64]=zero
fn lane_max[N](x: &tensor[N] f32, out: &mut tensor[N] f32):
    parallel for i in 0..N:
        out[i] = x[i]

lower lane_max[N](x: &tensor[N] f32, out: &mut tensor[N] f32) for metal requires metal.subgroup:
    parallel for i in 0..N:
        out[i] = metal.subgroup.simd_max(x[i])

fn probe(x: &tensor[64] f32, out: &mut tensor[64] f32):
    lane_max(x, out)
