# cell: value-range/zero-trip
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; range:2..6 ; index:0
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; range:2..6 ; index:3
fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32, r: range[8], n: index[5]) where W >= 8:
    for i in 0..n:
        let mut s = 0.0
        for j in r:
            s = s + x[i, j]
        out[i] = s
