# cell: tuple-pack-get/after-failure
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; i32:2
# expect: returned
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; i32:0
# expect: failed
fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32, d: i32) where W >= 8:
    let q = 10 / d
    let p = (x[0, 0], x[0, 1])
    let (a, b) = p
    out[0] = a * b
