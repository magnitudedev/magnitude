# cell: assign-local-scalar/if-arm
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; bool:true
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; bool:false
fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32, c: bool) where W >= 8:
    if c:
        let mut v = 0.0
        v = x[0, 2] + 1.0
        out[0] = v
