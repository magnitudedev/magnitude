# cell: value-range/if-arm
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; range:2..6 ; bool:true
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero ; range:2..6 ; bool:false
fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32, r: range[8], c: bool) where W >= 8:
    if c:
        let mut s = 0.0
        for j in r:
            s = s + x[0, j]
        out[0] = s
