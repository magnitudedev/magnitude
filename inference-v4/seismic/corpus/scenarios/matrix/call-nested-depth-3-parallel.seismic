# cell: call-nested-depth-3/parallel
# invoke: f32[4,8]=rand(170) ; f32[4]=zero ; f32[4,8]=zero
fn inner3[V](r: &tensor[V] f32) -> f32:
    return r[0] + 1.0

fn middle3[V](r: &tensor[V] f32) -> f32:
    return inner3(r) * 2.0

fn outer3[V](r: &tensor[V] f32) -> f32:
    return middle3(r) - 1.0

fn probe[W](x: &tensor[4, W] f32, out: &mut tensor[4] f32, y: &mut tensor[4, W] f32) where W >= 8:
    parallel for i in 0..4:
        out[i] = outer3(x[i])
