# expect: failed
# invoke remainder: i32:20 ; i32:0 ; i32[1]=zero
# expect: failed
# invoke remainder: i32:-2147483648 ; i32:-1 ; i32[1]=zero
# expect: failed
# invoke lanes: i32[4]=2,0,4,0 ; i32[4]=zero
# expect: failed
# invoke shifts: i32[4]=1,32,3,-1 ; i32[4]=zero
# expect: failed
# invoke unused_tensor: i32[4]=2,0,4,0 ; i32[1]=zero
# expect: failed
# invoke unused_local_tensor: i32[4]=2,0,4,0 ; i32[4]=zero
