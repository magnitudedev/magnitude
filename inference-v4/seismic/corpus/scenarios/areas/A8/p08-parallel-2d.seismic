# invoke: i32[1]=seq ; i32[1]=seq ; i32[1,1]=zero
# expect: returned
# pin: o = i32[1,1]=0
# invoke: i32[33]=seq ; i32[1025]=seq ; i32[33,1025]=zero
# expect: returned
fn probe[M, N](a: &tensor[M] i32, b: &tensor[N] i32, o: &mut tensor[M, N] i32):
    # Two parallel axes linearized onto one launch dimension: every (row,
    # column) pair is written exactly once, whatever the chunking of claims.
    parallel for r in 0..M:
        parallel for c in 0..N:
            o[r, c] = a[r] * 1000 + b[c]
