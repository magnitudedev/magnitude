fn probe[M, N, K](x: &tensor[M, K] f32, weight: &tensor[N, K] f32, y: &mut tensor[M, N] f32):
    # std `linear` at edge-tile shapes: M and K straddle every tile width, so
    # each staged and fragment load of a partial tile is predicated. On Metal
    # this scenario also runs under shader validation
    # (`tests/metal_shader_validation.rs`), where an unpredicated load panics.
    linear(x, weight, y)
