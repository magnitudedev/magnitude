# origin: X1:R2-X1-1
# invoke guarded_divide: f32[1]=1 ; index:7 ; index:0 ; i32[1]=-1
# expect: returned
# pin: out = i32[1]=-1
# invoke guarded_divide: f32[1]=9 ; index:7 ; index:0 ; i32[1]=-1
# expect: failed
# pin: out = i32[1]=-1
# invoke guarded_divide: f32[1]=9 ; index:7 ; index:2 ; i32[1]=-1
# expect: returned
# pin: out = i32[1]=3
# invoke guarded_read: f32[4]=1,2,3,4 ; i32:9 ; f32[1]=-1
# expect: returned
# pin: out = f32[1]=-1
# invoke guarded_read: f32[4]=9,2,3,4 ; i32:9 ; f32[1]=-1
# expect: failed
# pin: out = f32[1]=-1
# invoke guarded_read: f32[4]=9,2,3,4 ; i32:2 ; f32[1]=-1
# expect: returned
# pin: out = f32[1]=3
# invoke prefix_then_read: f32[4]=1,2,3,4 ; i32:9 ; f32[1]=-1
# expect: failed
# pin: out = f32[1]=7
fn guarded_divide(x: &tensor[1] f32, n: index[1024], k: index[1024], out: &mut tensor[1] i32):
    # n04: the division's operands are host values, but it is reached only
    # when the device condition holds; it is checked in the kernel at its own
    # position, never hoisted ahead of the condition.
    if x[0] > 5.0:
        out[0] = i32(n / k)

fn guarded_read(x: &tensor[4] f32, m: i32, out: &mut tensor[1] f32):
    # n05: the bounds check of `x[m]` has host operands; under a false device
    # condition it neither fails nor performs the out-of-bounds load.
    if x[0] > 5.0:
        out[0] = x[m]

fn prefix_then_read(x: &tensor[4] f32, m: i32, out: &mut tensor[1] f32):
    # n03: the write before the failing check is part of the failure prefix,
    # and the failing lane never executes the out-of-bounds load.
    out[0] = 7.0
    out[0] = x[m]
