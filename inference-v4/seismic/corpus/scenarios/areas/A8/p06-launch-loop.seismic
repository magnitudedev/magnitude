# invoke per_step: i32[0]=zero
# expect: returned
fn accumulate[N, K](steps: &tensor[K] i32, out: &mut tensor[N] i32) where K >= 0:
    # One launch reached K times with a distinct word each time: argument
    # memory belongs to the submission, so no visit waits for an earlier one.
    for s in 0..K:
        parallel for i in 0..N:
            out[i] = out[i] + steps[s]

fn per_step[K](o: &mut tensor[K] i32) where K >= 0:
    for s in 0..K:
        o[s] = i32(s) * 3
