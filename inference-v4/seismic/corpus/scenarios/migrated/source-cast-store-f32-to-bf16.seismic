# invoke cast_value: f32:0x7fc12345 ; bf16[1]=zero
# invoke cast_value: f32:0xffc12345 ; bf16[1]=zero
fn cast_value(a: f32, dst: &mut tensor[1] bf16) -> bf16:
    let value = bf16(a)
    dst[0] = value
    return value
