# origin: test:seismic-runtime:runtime/src/feedback/failure_tests.rs:cpu_reached_branch_result_keeps_selected_instance_across_visits
# invoke: i32[4]=zero
# pin: out = i32[4]=7,1,7,1
fn probe(out: &mut tensor[4] i32):
    for i in 0..4:
        let mut selected = tensor[2] i32
        selected[:] = ones_like(selected)
        if i % 2 == 0:
            let mut replacement = tensor[2] i32
            replacement[:] = ones_like(replacement) * 7
            selected = replacement
        out[i] = selected[0]
