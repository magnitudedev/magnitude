# origin: test:seismic-runtime:runtime/src/feedback/packed_tests.rs:packed_reads
# invoke: nvfp4_e2m1_block16[16]=rand(140)
# invoke: nvfp4_e2m1_block16[16]=bits(141)
fn probe[N](x: &tensor[N] nvfp4_e2m1_block16) -> tensor[N] f32:
    let mut result = tensor[N] f32
    parallel for i in 0..N:
        result[i] = f32(x[i])
    return result
