# invoke cast_value: f16:0x7e55 ; f32[1]=zero
# invoke cast_value: f16:0xfe55 ; f32[1]=zero
fn cast_value(a: f16, dst: &mut tensor[1] f32) -> f32:
    let value = f32(a)
    dst[0] = value
    return value
