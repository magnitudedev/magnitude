fn identity(value: bf16) -> bf16:
    return value

fn scalar(value: bf16, alternate: bf16, choose: bool, times: range[3]) -> bf16:
    let mut result = identity(value)
    if choose:
        result = identity(alternate)
    for iteration in times:
        result = identity(result)
    return result

fn tensor(x: &tensor[8] bf16, y: &tensor[8] bf16, choose: bool, times: range[3]) -> (tensor[8] bf16, bf16):
    let mut result = zeros_like(x)
    parallel for i in 0..8:
        let mut value = identity(x[i])
        if choose:
            value = identity(y[i])
        for iteration in times:
            value = identity(value)
        result[i] = value
    return (result, identity(result[0]))
