# rejected: "`three`"
fn three[N](x: &tensor[N] i32) -> i32 where N >= 3:
    return x[2]

fn probe(input: &tensor[8] i32, bounds: &tensor[2] i32) -> i32:
    let lo = bounds[0]
    let hi = bounds[1]
    let mut r = 0
    if hi >= lo + 3:
        r = three(input[lo:hi])
    return r
