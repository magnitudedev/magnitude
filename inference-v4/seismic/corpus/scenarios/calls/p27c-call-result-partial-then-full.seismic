# origin: C13:p27c
# invoke: i32[6]=seq
fn halves(x: &tensor[2] i32) -> tensor[4] i32:
    let mut r = tensor[4] i32
    for i in 0..2:
        r[i] = x[i]
        r[2 + i] = x[i]
    return r

fn seed[N](x: &tensor[N] i32) -> i32:
    return reduce(x, 0, sum) + i32(N) * 100

fn probe(input: &tensor[6] i32) -> i32:
    return seed(halves(input[1:3]))
