# origin: test:validation:corpus/planning.seismic:evidence_sum
# invoke evidence_sum: f32[3,16]=rand(112) ; f32[3]=zero
fn row_total[N](x: &tensor[N] f32) -> f32:
    return reduce(x, 0, sum)

fn row_total[N](x: &tensor[N] f32) -> f32:
    return reduce(x, 0, sum, unordered=true)

fn evidence_sum[M, N](x: &tensor[M, N] f32, y: &mut tensor[M] f32):
    parallel for r in 0..M:
        y[r] = row_total(x[r])
