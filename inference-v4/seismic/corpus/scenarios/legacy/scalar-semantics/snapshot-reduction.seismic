# origin: test:validation:programs/scalar-semantics.seismic:snapshot_reduction
# invoke snapshot_reduction: f32[65]=seq ; f32[1]=zero
fn snapshot_reduction(x: tensor[65] f32, result: tensor[1] f32) -> (tensor[65] f32, tensor[1] f32):
    let snapshot = to_owned(x)
    let mut source = x
    let mut output = result
    let mut total = f32(0.0)
    for i in 0..65:
        source[i] = 0.0
        total = total + snapshot[i]
    output[0] = total
    return source, output
