# origin: test:validation:corpus/effects.seismic:atomic_float_sum
# invoke atomic_float_sum: f32[6]=rand(104) ; i32[6]=0,1,0,2,1,0 ; f32[3]=zero
fn atomic_float_sum[N, E](values: &tensor[N] f32, routes: &tensor[N] i32, sums: &mut tensor[E] f32):
    parallel for i in 0..N:
        atomic(add, sums[routes[i]], values[i])
