# origin: A1:G-IF3-new-1
# invoke w: f32[8]=1,2,3,4,5,6,7,1 ; f32[8]=zero
fn w(x: &tensor[8] f32, out: &mut tensor[8] f32):
    for i in 0..8:
        for t in 0..8:
            let mut j = i
            if x[t] > 3.0:
                j = t
            for k in 0..j:
                out[k] = out[k] + 1.0
