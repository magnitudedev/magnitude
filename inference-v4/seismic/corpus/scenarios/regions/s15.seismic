# origin: C14:s15
# invoke: f32[5]=rand(50) ; bool:true ; f32[5]=zero
# invoke: f32[5]=rand(50) ; bool:false ; f32[5]=zero
fn probe[N](x: &tensor[N] f32, c: bool, out: &mut tensor[N] f32):
    let mut t = tensor[N] f32
    for i in 0..N:
        t[i] = x[i]
    if c:
        let mut u = tensor[N] f32
        for i in 0..N:
            u[i] = x[i] * x[i]
        t = u
    for i in 0..N:
        out[i] = t[i] + 1.0
