# origin: X1:r3-t20
# invoke: f32[2,4]=1,2,3,4,5,6,7,1 ; f32[2]=zero ; index:6
# pin: out = f32[2]=10,19
fn probe[R, N](x: &tensor[R, N] f32, out: &mut tensor[R] f32, n: index[64]):
    parallel for r in 0..R:
        let mut acc = 0.0
        for j in 0..n:
            let w = f32(2) * 0.5
            if j < N:
                acc = acc + x[r, j] * w
        out[r] = acc
