# origin: X1:r2-i01
# invoke: f32[4]=1,2,3,4 ; f32[8]=1,2,3,4,5,6,7,1 ; f32[8]=zero
# pin: out = f32[8]=10,11,12,13,14,15,16,10
fn probe[N](x: &tensor[N] f32, s: &tensor[8] f32, out: &mut tensor[8] f32):
    for i in 0..8:
        let mut t = to_owned(x)
        t[0] = s[i]
        out[i] = reduce(t, 0, sum)
