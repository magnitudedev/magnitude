fn bump[N](v: &mut tensor[N] f32):
    v[0] = v[0] + 100.0
fn probe[R](x: &tensor[R, 4] f32, out: &mut tensor[R] f32):
    parallel for r in 0..R:
        let mut y = x[r] * 2.0
        y[0] = 5.0
        bump(y)
        out[r] = y[0] + y[1]
