fn probe[R](x: &tensor[R, 4] f32, out: &mut tensor[R] f32):
    parallel for r in 0..R:
        let mut y = x[r] * 1.0
        for i in 0..2:
            y[0] = y[0] + 1.0
            y = y * 2.0
        out[r] = y[0] + y[3]
