fn seed[N](x: &tensor[N] f32) -> f32 where N >= 0:
    let mut t = tensor[N] f32
    for i in 0..N:
        t[i] = x[i]
    return reduce(t, 0, sum)
fn probe[N](x: &tensor[N] f32, bounds: &tensor[2] i32) -> f32:
    let lo = bounds[0]
    let hi = bounds[1]
    return seed(x[lo:hi])
