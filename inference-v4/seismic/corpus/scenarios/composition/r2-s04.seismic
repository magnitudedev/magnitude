# origin: X1:r2-s04
# invoke: f32[2,4]=1,2,3,4,5,6,7,1 ; f32[2,4]=zero
fn twice[N](x: &tensor[N] f32) -> tensor[N] f32:
    return x + x
fn probe[R](a: &mut tensor[R, 4] f32, out: &mut tensor[R, 4] f32):
    parallel for r in 0..R:
        let c = twice(a[r])
        a[r, 0] = 7.0
        out[r] = c
