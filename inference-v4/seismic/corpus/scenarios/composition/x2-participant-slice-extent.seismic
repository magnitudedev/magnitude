# origin: X2:R-X2-28
# cell: alloc-participant-extent/parallel
# invoke: f32[4,8]=rand(40) ; i32[4,2]=0,3,2,2,1,8,5,6 ; f32[4]=zero
fn probe[R, C](x: &tensor[R, C] f32, b: &tensor[R, 2] i32, out: &mut tensor[R] f32):
    parallel for i in 0..R:
        let lo = b[i, 0]
        let hi = b[i, 1]
        let t = to_owned(x[i, lo:hi])
        out[i] = reduce(t, 0, sum)
