fn probe[M, N, K](a: &tensor[M, K] f32, b: &tensor[N, K] f32, sel: &tensor[N] i32, bias: &tensor[4] f32, y: &mut tensor[M, N] f32):
    parallel for i in 0..M:
        parallel for j in 0..N:
            let mut acc = bias[sel[j]]
            for k in 0..K:
                acc = fma(a[i, k], b[j, k], acc)
            y[i, j] = acc
