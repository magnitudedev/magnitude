# origin: X1:P22
# undecided: reassociated
# invoke: i32[8]=1,2,3,4,5,6,7,1 ; f32[8]=1,2,3,4,5,6,7,1 ; i32[4]=1,2,3,4
# pin: hist = i32[4]=2,5,5,6
fn probe[N](x: &tensor[N] i32, y: &tensor[N] f32, hist: &mut tensor[4] i32) -> f32:
    parallel for i in 0..N:
        atomic(add, hist[x[i] % 4], 1)
    return reduce(y, 0, sum, unordered=true)
