# origin: X1:r2-c03
# invoke: f32[2,2,2]=1,2,3,4,5,6,7,1 ; f32[2]=zero
# pin: out = f32[2]=22,66
fn probe[R](x: &tensor[R, 2, 2] f32, out: &mut tensor[R] f32):
    parallel for r in 0..R:
        let mut y = to_owned(x[r].T)
        let mut z = to_owned(x[r])
        for i in 0..3:
            let t = y
            y = z.T
            z = t
        out[r] = y[0, 1] * 10.0 + z[0, 1]
