{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "paths": {
      "@magnitudedev/sdk": [
        "../packages/sdk/src"
      ],
      "@magnitudedev/sdk/*": [
        "../packages/sdk/src/*"
      ],
      "@magnitudedev/web/*": [
        "../web/src/*"
      ],
      "@/*": [
        "../web/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
